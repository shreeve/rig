#!/usr/bin/env python3
"""Time the built-in Map and HashMap against the fastest hash
tables in Zig, Rust, C++, and Go.

usage: bench/hash/bench-hash [options]
   or, to time on a quiet machine:
       bench/hash/bench-hash --out D --build-only
       bench/hash/bench-hash --out D --time-only

  --variants a,b  what to build and time (default: rig-safe,zig-safe):
                    rig-safe   bench/hash/map.rig, rig build --release (Zig's safe mode)
                    rig-fast   the same, rig build --release=fast
                    rig-hash   map.rig with its Map aliases made `HashMap`, the
                               unordered built-in, rig build --release=fast
                    rig-hash-safe the same, rig build --release
                    zig-safe   bench/hash/map.zig, -OReleaseSafe
                    zig-fast   the same, -OReleaseFast
                    zig-foa    map.zig on bench/hash/foa.zig, a port of boost's
                               unordered_flat_map, with Rig's Int hash
                    zig-dense  map.zig on bench/hash/dense.zig, a port of ankerl's
                               unordered_dense, with Rig's Int hash
                    zig-hash   map.zig on bench/hash/hash.zig: the design Rig's
                               unordered HashMap will take, grown from zig-foa
                    zig-ordered map.zig on bench/hash/ordered.zig: the design
                               Rig's ordered Map will take
                    zig-hash-checked, zig-ordered-checked
                               the same with the bounds tests safe Rig keeps
                               put back (`.checked = true`)
                    rust       bench/hash/map.rs, rustc -C opt-level=3: hashbrown,
                               with FxHasher; the sized rows only
                    rust-mix   the same with Rig's Int hash (one full multiply,
                               folded) for FxHasher, so keys land where
                               std.hash puts them
                    hashbrown  bench/hash/rust, the hashbrown crate with foldhash
                    indexmap   the same, the indexmap crate (insertion-ordered)
                    absl       bench/hash/map.cc, absl::flat_hash_map, absl::Hash
                    boost      the same, boost::unordered_flat_map, boost::hash
                    dense      the same, ankerl::unordered_dense::map, its wyhash
                    go         bench/hash/map.go, Go's built-in map, its own hash
                  and each but go with `-mix` (`absl-mix` ...): its table with
                  Rig's Int hash, so the tables race on the same hash. All
                  but rig-* and zig-* time the sized rows only.
                  The C++ ones need bench/hash/fetch-deps run once.
                  A variant may name an allocator after a colon, to race
                  allocators under one table (`zig-foa:smp`):
                    :malloc    libc's malloc, what every Zig variant uses
                    :smp       Zig's std.heap.smp_allocator
                    :rig       Rig's release allocator, src/alloc.zig
                    :arena     an ArenaAllocator over page_allocator, freed
                               after each row
                    :mimalloc  mimalloc, pinned by fetch-deps
                  (those for zig-* only), and for any variant
                    :thp       the same program run with
                               GLIBC_TUNABLES=glibc.malloc.hugetlb=1, so
                               glibc's malloc asks for transparent huge pages
  --all           every variant above but the safe ones
  --mem           also each variant's peak memory per entry for one map
                  of 4,000,000 Int keys (with --reps 0, only that)
  --reps N        runs per variant, interleaved across variants; the
                  fastest of each operation counts (default 9)
  --spread PCT    also list each row whose runs of one variant spread more
                  than PCT% ((slowest - fastest) / fastest), to run again
  --out DIR       keep the builds in DIR and reuse them; with
  --build-only    build and stop, and later
  --time-only     time what DIR holds

Each program first times Int keys at sizes 16, 1,000, 100,000, and
4,000,000 (`int16` ...): insert puts the keys into empty maps (a million
keys a batch, so 62,500 maps of 16), remove takes them back out, hit and
miss look keys up in one map of that size, and iterate walks it, each
row 4,000,000 operations and reported per operation; `rnd16` ... time
the same on random 64-bit keys, looked up in shuffled order. Then each puts a million keys into an empty map (insert), looks each
up (hit), looks up a million keys it does not hold (miss), and walks
the map (iterate), for Int keys (scattered by a multiply) and String
keys ("key" and a number), and, with no walk, for keys of two words
(two type ids in one word and a tag in the other). The Rig program also writes a value under
N keys whether or not each is new, three ways (`ensure`, `ensure_with`,
`edit` then `put`), on misses and on hits; Zig has no such rows. It
prints `KEYS OP NS CHECK` per operation; the checksums must agree. The report compares each variant with the
first Zig one (or --base V), as "N% faster" or "N% slower", and names
the fastest.
"""
import argparse, os, platform, re, shutil, subprocess, sys, tempfile, time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
RIG = os.environ.get("RIG", os.path.join(ROOT, "bin", "rig"))
ZIG = os.environ.get("ZIG", "zig")
RUSTC = os.environ.get("RUSTC", "rustc")
CARGO = os.environ.get("CARGO", "cargo")
CXX = os.environ.get("CXX", "clang++")
GO = os.environ.get("GO", "go")
UP = os.path.join(HERE, "upstream")
CXX_TABLES = {"absl": "ABSL", "boost": "BOOST", "dense": "DENSE"}
# Every contestant builds for the CPU it runs on, as `rig` and `zig`
# build by default, so none races with fewer instructions than another.
ARM = platform.machine() in ("arm64", "aarch64")
CXX_NATIVE = ["-mcpu=native"] if ARM else ["-march=native"]
RUST_NATIVE = ["-C", "target-cpu=native"]
GO_NATIVE = {"GOARM64": "v8.5"} if ARM else {"GOAMD64": "v3"}
ALL = ["rig-fast", "rig-hash", "zig-fast", "rust", "rust-mix", "hashbrown", "hashbrown-mix",
       "indexmap", "indexmap-mix", "absl", "absl-mix", "boost", "boost-mix", "dense", "dense-mix", "go"]
# The Zig ports race once their sources are there.
ALL += [v for v, f in (("zig-foa", "foa.zig"), ("zig-dense", "dense.zig"), ("zig-hash", "hash.zig"),
                       ("zig-hash-checked", "hash.zig"), ("zig-ordered", "ordered.zig"),
                       ("zig-ordered-checked", "ordered.zig")) if os.path.exists(os.path.join(HERE, f))]
N = 1_000_000
# The allocators a Zig variant can name after a colon: the module `alloc`
# map.zig allocates from.
ZIG_ALLOCS = {"malloc": os.path.join(HERE, "alloc", "malloc.zig"), "smp": os.path.join(HERE, "alloc", "smp.zig"),
              "rig": os.path.join(ROOT, "src", "alloc.zig"), "arena": os.path.join(HERE, "alloc", "arena.zig"),
              "mimalloc": os.path.join(HERE, "alloc", "mimalloc.zig")}
# What a `:thp` variant runs with: glibc's malloc madvises its heap and
# its mmapped blocks MADV_HUGEPAGE (glibc 2.35 or later), for THP in
# madvise mode.
THP_ENV = {"GLIBC_TUNABLES": "glibc.malloc.hugetlb=1"}


def split(v):
    """A variant's program and its allocator (None: the program's own)."""
    base, _, a = v.partition(":")
    if a and a != "thp" and (a not in ZIG_ALLOCS or not base.startswith("zig-")):
        sys.exit(f"{v}: :{a} is not an allocator bench-hash knows for {base}")
    return base, a or None


def exe_of(v, out):
    """The program a variant runs: a `:thp` variant runs its base's."""
    base, a = split(v)
    return os.path.join(out, base if a == "thp" else v)


def env_of(v):
    return dict(os.environ, **THP_ENV) if split(v)[1] == "thp" else None


def build(v, out):
    base, a = split(v)
    if a == "thp":
        return build(base, out)
    exe = os.path.join(out, v)
    if os.path.exists(exe):
        return exe
    tmp = exe + ".new"
    v = base
    if v.startswith("rig-"):
        env = dict(os.environ, RIG_OUT_DIR=os.path.join(out, "rig-out-" + v))
        flag = "--release" if v.endswith("-safe") else "--release=fast"
        src = os.path.join(HERE, "map.rig")
        if v.startswith("rig-hash"):
            # The same program with each `type X = Map[...]` alias made
            # `HashMap[...]`, so every row times the unordered HashMap.
            text = re.sub(r"^type (\w+) = Map\[", r"type \1 = HashMap[", open(src).read(), flags=re.M)
            src = os.path.join(out, "map-hash.rig")
            with open(src, "w") as f:
                f.write(text)
        subprocess.run([RIG, "build", flag, "-o", tmp, src], check=True, env=env)
    elif v in ("rust", "rust-mix"):
        cfg = ["--cfg", "mix"] if v == "rust-mix" else []
        subprocess.run([RUSTC, "-C", "opt-level=3", *RUST_NATIVE, *cfg, "-o", tmp, os.path.join(HERE, "map.rs")], check=True)
    elif v.split("-")[0] in ("hashbrown", "indexmap"):
        feats = [f for f in ("indexmap" if v.startswith("indexmap") else None, "mix" if v.endswith("-mix") else None) if f]
        target = os.path.join(out, "cargo-" + v)
        subprocess.run([CARGO, "build", "-q", "--release", "--locked", *(["--features", ",".join(feats)] if feats else [])],
                       check=True, cwd=os.path.join(HERE, "rust"), env=dict(os.environ, CARGO_TARGET_DIR=target, RUSTFLAGS=" ".join(RUST_NATIVE)))
        shutil.copy(os.path.join(target, "release", "map"), tmp)
    elif v.split("-")[0] in CXX_TABLES:
        if not os.path.exists(os.path.join(UP, "libabsl.a")):
            sys.exit(f"{v}: run bench/hash/fetch-deps first")
        inc = [os.path.join(UP, "unordered_dense", "include"), os.path.join(UP, "abseil-cpp")]
        boost = os.path.join(UP, "boost")
        inc += [os.path.join(boost, m, "include") for m in sorted(os.listdir(boost))]
        defs = ["-DTABLE_" + CXX_TABLES[v.split("-")[0]]] + (["-DMIX"] if v.endswith("-mix") else [])
        libs = ["-framework", "CoreFoundation"] if sys.platform == "darwin" else ["-lpthread"]
        subprocess.run([CXX, "-std=c++20", "-O3", "-DNDEBUG", *CXX_NATIVE, *defs, *("-I" + i for i in inc),
                        os.path.join(HERE, "map.cc"), os.path.join(UP, "libabsl.a"), *libs, "-o", tmp], check=True)
    elif v == "go":
        subprocess.run([GO, "build", "-o", tmp, "map.go"], check=True, cwd=HERE,
                       env=dict(os.environ, GOCACHE=os.path.join(out, "go-cache"), **GO_NATIVE))
    else:
        # map.zig times the table its module `table` names: Zig's own
        # HashMap, or a port.
        table = {"zig-foa": "table_foa.zig", "zig-dense": "table_dense.zig", "zig-hash": "table_hash.zig",
                 "zig-ordered": "table_ordered.zig", "zig-hash-checked": "table_hash_checked.zig",
                 "zig-ordered-checked": "table_ordered_checked.zig"}.get(v, "table_std.zig")
        mode = "-OReleaseSafe" if v == "zig-safe" else "-OReleaseFast"
        # The allocator is the module `alloc`, which map.zig and the
        # table both import; mimalloc's C is built into it, optimized as
        # its CMake release build is.
        c = []
        if a == "mimalloc":
            mi = os.path.join(UP, "mimalloc")
            if not os.path.exists(mi):
                sys.exit(f"{v}:mimalloc: run bench/hash/fetch-deps first")
            c = ["-cflags", "-O3", "-DNDEBUG", "--", "-I", os.path.join(mi, "include"), os.path.join(mi, "src", "static.c")]
        subprocess.run([ZIG, "build-exe", mode, "--dep", "table", "--dep", "alloc", "-Mroot=" + os.path.join(HERE, "map.zig"),
                        "--dep", "alloc", "-Mtable=" + os.path.join(HERE, table), *c, "-Malloc=" + ZIG_ALLOCS[a or "malloc"],
                        "-lc", "-femit-bin=" + tmp, "--cache-dir", os.path.join(out, "zig-cache")], check=True)
    os.rename(tmp, exe)
    return exe


# A variant whose first run takes longer runs only once: Zig's HashMap
# takes minutes on the churn rows, where its tombstones pile up.
SLOW = 60


def run(exe, env=None):
    p = subprocess.run([exe], check=True, capture_output=True, text=True, env=env)
    rows = {}
    for line in (p.stdout + p.stderr).splitlines():
        keys, op, ns, check = line.split()
        rows[(keys, op)] = (int(ns), check)
    return rows


def peak(exe, arg, env=None):
    """The peak resident memory, in bytes, of `exe arg`."""
    p = subprocess.Popen([exe, arg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    _, status, use = os.wait4(p.pid, 0)
    if status != 0:
        sys.exit(f"{exe} {arg}: exit status {status}")
    return use.ru_maxrss * (1 if sys.platform == "darwin" else 1024)


def memory(variants, exes, reps):
    """Each variant's peak bytes per entry for one map of 4,000,000 Int
    keys, above the array of keys (`mem` less `mem0`), the least of
    `reps` runs, smallest first."""
    n = 4_000_000
    least = {}
    for _ in range(max(reps, 1)):
        for v in variants:
            b = (peak(exes[v], "mem", env_of(v)) - peak(exes[v], "mem0", env_of(v))) / n
            least[v] = min(b, least.get(v, b))
    print(f"\nmemory: peak bytes per entry, one map of {n:,} Int keys (16 bytes of key and value)")
    for v in sorted(variants, key=least.get):
        print(f"  {v:15} {least[v]:7.1f}")


def scoreboard(variants, best):
    """First places by variant over the rows every variant times, less
    the `int` rows, whose strided keys favour a multiplying hash."""
    rows = [k for k in best[variants[0]] if not k[0].startswith("int") and all(k in best[v] for v in variants)]
    wins = {v: 0 for v in variants}
    for k in rows:
        wins[min(variants, key=lambda v: best[v][k])] += 1
    print(f"\nfirst places over {len(rows)} rows every variant times (the int rows left out):")
    for v in sorted(variants, key=lambda v: -wins[v]):
        if wins[v]:
            print(f"  {v:15} {wins[v]:4}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--variants", default="rig-safe,zig-safe")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--base")
    ap.add_argument("--reps", type=int, default=9)
    ap.add_argument("--out")
    ap.add_argument("--build-only", action="store_true")
    ap.add_argument("--time-only", action="store_true")
    ap.add_argument("--mem", action="store_true")
    ap.add_argument("--spread", type=float)
    a = ap.parse_args()
    variants = ALL if a.all else a.variants.split(",")
    out = a.out or tempfile.mkdtemp(prefix="bench-hash.")
    os.makedirs(out, exist_ok=True)
    try:
        exes = {v: (exe_of(v, out) if a.time_only else build(v, out)) for v in variants}
        if a.build_only:
            return
        if a.reps == 0:
            if a.mem:
                memory(variants, exes, 1)
            return
        best = {v: {} for v in variants}
        worst = {v: {} for v in variants}
        checks = {}
        slow = set()
        for rep in range(a.reps):
            for v in variants:
                if v in slow:
                    continue
                began = time.monotonic()
                for k, (ns, check) in run(exes[v], env_of(v)).items():
                    if checks.setdefault(k, check) != check:
                        sys.exit(f"{v}: {k[0]} {k[1]} checksum {check}, expected {checks[k]}")
                    best[v][k] = min(ns, best[v].get(k, ns))
                    worst[v][k] = max(ns, worst[v].get(k, ns))
                if rep == 0 and time.monotonic() - began > SLOW:
                    slow.add(v)
        base = a.base or next((v for v in variants if v.startswith("zig-")), variants[0])
        w = max(15, *(len(v) + 1 for v in variants))
        print(f"{'keys':10} {'op':20} " + " ".join(f"{v:>{w}}" for v in variants) + f"   {'fastest':14} vs {base} (ns/op)")
        # Every row any variant prints, in the order they were met; a row
        # only Rig times (the write rows) shows `-` for Zig.
        rows = list(dict.fromkeys(k for v in variants for k in best[v]))
        for k in rows:
            cols = " ".join(f"{best[v][k] / N:{w}.2f}" if k in best[v] else f"{'-':>{w}}" for v in variants)
            fastest = min((v for v in variants if k in best[v]), key=lambda v: best[v][k])
            notes = []
            for v in variants:
                if v == base or k not in best[base] or k not in best[v]:
                    continue
                r = best[base][k] / best[v][k]
                notes.append(f"{v} {abs(r - 1) * 100:.1f}% {'faster' if r >= 1 else 'slower'}")
            print(f"{k[0]:10} {k[1]:20} {cols}   {fastest:14} {', '.join(notes)}")
        for v in sorted(slow):
            print(f"\n{v} ran once: its first run took over {SLOW} s")
        if len(variants) > 1:
            scoreboard(variants, best)
        if a.spread is not None:
            wide = [(v, k, (worst[v][k] - best[v][k]) / max(best[v][k], 1) * 100)
                    for v in variants if v not in slow for k in best[v]]
            wide = [x for x in wide if x[2] > a.spread]
            print(f"\nruns that spread more than {a.spread:g}% (of {a.reps}): {len(wide)}")
            for v, k, pct in wide:
                print(f"  {v:15} {k[0]:12} {k[1]:10} {best[v][k] / N:8.2f} {worst[v][k] / N:8.2f}  {pct:5.1f}%")
        if a.mem:
            memory(variants, exes, a.reps)
    finally:
        if not a.out:
            shutil.rmtree(out, ignore_errors=True)


main()
