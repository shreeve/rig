#!/usr/bin/env python3
"""Time std.terminal against Ghostty's terminal on generated output.

usage: bench/terminal/bench-terminal [options]

  --files a,b       corpora (default: text,scroll,sgr,tui,utf8,utf8-2027,rgb),
                    each about 4 MB, written once into OUT/data:
                      text     lines of words, CR LF between them, as `cat` of a log
                      scroll   short lines, so nearly every byte or two scrolls
                      sgr      colored words and resets, a line break now and then
                      tui      full-screen frames: CUP, SGR, a run of text, EL
                      utf8     lines of words in accented Latin, Greek, Cyrillic,
                               CJK, kana, Hangul, and emoji among ASCII ones
                      utf8-2027  utf8 with mode 2027 (grapheme clustering) on
                      rgb      a truecolor word after word: a new RGB color each,
                               so styles number in the thousands
  --variants a,b    what to build and time (default: all but experiments):
                      rig-safe        bench.rig, rig build --release (Zig's safe
                                      mode), with std.terminal's default
                                      scrollback, 10,000 rows
                      rig-fast        the same, rig build --release=fast
                      ghostty         libghostty-vt (tools/terminal_ghostty.zig,
                                      ReleaseFast, without its C++ SIMD paths),
                                      no scrollback
                      ghostty-scroll  the same with 10 MB of scrollback, Ghostty's
                                      default, about as much as std.terminal's
                                      10,000 rows of 120 columns
                      ghostty-simd    ghostty with its C++ SIMD paths (simdutf,
                                      Highway); only when $GHOSTTY_SDK names a
                                      macOS SDK Zig 0.16's libc++ builds against
                      dispatch        Dispatch's engine (Term, Swift, swiftc -O
                                      -wmo), no scrollback and mode 2027 off, as
                                      Ghostty's; only when $DISPATCH names a
                                      Dispatch checkout (bench/terminal/dispatch.swift)
                    and an experiment, only when named:
                      rig-nocheck     rig-fast with Rig's index, slice, and read
                                      bounds checks removed from its runtime (as
                                      bench/json's): sizes what they cost
                      rig-noscroll    rig-fast with no scrollback: sizes what
                                      keeping history costs
  --size COLSxROWS  the terminal (default 120x40)
  --ms N            aim each timed run at about N ms (default 300)
  --reps N          timed runs per variant, interleaved (default 5)
  --out D           keep builds and data here (default .zig-cache/terminal-bench)

Each program prints `<ns> <check>` for N feeds of the file into new
terminals; MB/s is bytes times N over the time, with MB = 10^6, and each
variant's fastest run counts. The check is a hash of the final screen and
cursor: every variant must give the same, or the run fails, so the
benchmark compares the terminals on these large inputs too. Ghostty is
built as tools/terminal_ghostty.py builds it, and needs what it needs.
"""
import argparse, os, random, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, os.path.join(ROOT, "tools"))
import terminal_ghostty  # noqa: E402

FILES = ["text", "scroll", "sgr", "tui", "utf8", "utf8-2027", "rgb"]
VARIANTS = (["rig-safe", "rig-fast", "ghostty", "ghostty-scroll"] + (["ghostty-simd"] if os.environ.get("GHOSTTY_SDK") else [])
            + (["dispatch"] if os.environ.get("DISPATCH") else []))
SIZE = 4_000_000


def words(rng):
    return ["".join(rng.choice("abcdefghijklmnopqrstuvwxyz") for _ in range(rng.randint(2, 9))) for _ in range(500)]


# The letters of the utf8 corpus's scripts, and how often a word is in
# each; CJK, kana, Hangul, and emoji are two columns wide.
SCRIPTS = [
    ("abcdefghijklmnopqrstuvwxyz", 4),
    ("aeiouéèêàâçñöüßøåæœ" + "abcdefghijklmnopqrstuvwxyz", 3),
    ("".join(chr(c) for c in range(0x3B1, 0x3CA)), 2),
    ("".join(chr(c) for c in range(0x430, 0x450)), 2),
    ("".join(chr(c) for c in range(0x4E00, 0x4E00 + 3000)), 3),
    ("".join(chr(c) for c in range(0x3041, 0x3094)), 1),
    ("".join(chr(c) for c in range(0xAC00, 0xAC00 + 2000)), 1),
    ("".join(chr(c) for c in range(0x1F600, 0x1F650)), 1),
]


def utf8_words(rng):
    out = []
    for letters, weight in SCRIPTS:
        wide = ord(letters[0]) >= 0x1100
        for _ in range(100 * weight):
            out.append("".join(rng.choice(letters) for _ in range(rng.randint(1, 4) if wide else rng.randint(2, 9))))
    return out


def corpus(name, cols, rows):
    if name == "utf8-2027":
        return b"\x1b[?2027h" + corpus("utf8", cols, rows)
    rng = random.Random(name)
    w = utf8_words(rng) if name == "utf8" else words(rng)
    out, n = [], 0
    while n < SIZE:
        if name == "rgb":
            s = "\x1b[38;2;%d;%d;%dm%s " % (rng.randrange(256), rng.randrange(256), rng.randrange(256), rng.choice(w))
            if rng.random() < 0.08:
                s += "\r\n"
        elif name in ("text", "utf8"):
            s = " ".join(rng.choice(w) for _ in range(rng.randint(3, 14))) + "\r\n"
        elif name == "scroll":
            s = rng.choice(w)[: rng.randint(1, 9)] + "\r\n"
        elif name == "sgr":
            s = "\x1b[%d;%dm%s\x1b[0m " % (rng.choice([0, 1, 4]), rng.randint(30, 37), rng.choice(w))
            if rng.random() < 0.1:
                s += "\r\n"
        else:
            s = "\x1b[H" + ("\x1b[2J" if rng.random() < 0.02 else "")
            for _ in range(rng.randint(3, 12)):
                text = " ".join(rng.choice(w) for _ in range(rng.randint(1, 5)))[: cols - 1]
                s += "\x1b[%d;%dH\x1b[%d;3%dm%s\x1b[0m\x1b[K" % (rng.randint(1, rows), rng.randint(1, cols // 2), rng.choice([0, 1, 7]), rng.randint(0, 7), text)
        s = s.encode()
        out.append(s)
        n += len(s)
    return b"".join(out)


def build(variant, out):
    if variant.startswith("ghostty"):
        return [terminal_ghostty.bench_exe(variant == "ghostty-simd")]
    if variant == "dispatch":
        return [build_dispatch(out)]
    exe = os.path.join(out, variant)
    flag = "--release" if variant == "rig-safe" else "--release=fast"
    emitted = os.path.join(out, variant + ".out")
    env = dict(os.environ, RIG_OUT_DIR=emitted)
    r = subprocess.run([os.path.join(ROOT, "bin", "rig"), "build", flag, "-o", exe, os.path.join(ROOT, "bench", "terminal", "bench.rig")], capture_output=True, text=True, env=env)
    if r.returncode != 0:
        sys.exit("bench-terminal: building %s failed:\n%s" % (variant, r.stderr))
    if variant == "rig-nocheck":
        bench_json().unchecked_runtime(os.path.join(emitted, "rig", "runtime.zig"))
        r = subprocess.run(["zig", "build-exe", "-OReleaseFast", "--cache-dir", os.path.join(emitted, ".zc"), "-femit-bin=" + exe, os.path.join(emitted, "__rig_main.zig")], cwd=emitted, capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("bench-terminal: building rig-nocheck failed:\n%s" % r.stderr)
    return [exe]


def build_dispatch(out):
    """bench/terminal/dispatch.swift compiled into Term, Dispatch's engine, from $DISPATCH."""
    src = os.path.join(os.environ.get("DISPATCH", ""), "Vendor", "Term", "Sources", "Term")
    if not os.path.isdir(src):
        sys.exit("bench-terminal: set DISPATCH to a Dispatch checkout (it has Vendor/Term/Sources/Term)")
    build = os.path.join(out, "dispatch.build")
    os.makedirs(build, exist_ok=True)
    main = os.path.join(build, "main.swift")
    with open(os.path.join(ROOT, "bench", "terminal", "dispatch.swift")) as f, open(main, "w") as g:
        g.write(f.read())
    exe = os.path.join(out, "dispatch")
    sources = sorted(os.path.join(src, f) for f in os.listdir(src) if f.endswith(".swift"))
    r = subprocess.run(["swiftc", "-O", "-wmo", "-module-name", "Term", "-o", exe] + sources + [main], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("bench-terminal: building dispatch failed:\n%s" % r.stderr[-2000:])
    return exe


def bench_json():
    """bench/json/bench-json's unchecked_runtime, taken from its source
    alone (the script runs when imported), so the patch has one copy."""
    import ast, re
    path = os.path.join(ROOT, "bench", "json", "bench-json")
    tree = ast.parse(open(path).read())
    fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "unchecked_runtime")
    space = {"re": re, "sys": sys}
    exec(compile(ast.Module(body=[fn], type_ignores=[]), path, "exec"), space)
    return argparse.Namespace(unchecked_runtime=space["unchecked_runtime"])


def time_it(cmd, variant, path, n, cols, rows):
    if variant.startswith("ghostty"):
        args = cmd + ["bench", path, str(n), str(cols), str(rows), "10000000" if variant == "ghostty-scroll" else "0"]
    elif variant == "dispatch":
        args = cmd + [path, str(n), str(cols), str(rows), "0"]
    else:
        args = cmd + [path, str(n), str(cols), str(rows)] + (["0"] if variant == "rig-noscroll" else [])
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("bench-terminal: %s failed on %s: %s" % (variant, path, r.stderr.strip()[-400:]))
    ns, check = r.stdout.split()
    return int(ns), check


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--files", default=",".join(FILES))
    ap.add_argument("--variants", default=",".join(VARIANTS))
    ap.add_argument("--size", default="120x40")
    ap.add_argument("--ms", type=int, default=300)
    ap.add_argument("--reps", type=int, default=5)
    ap.add_argument("--out", default=os.path.join(ROOT, ".zig-cache", "terminal-bench"))
    a = ap.parse_args()
    cols, rows = (int(x) for x in a.size.split("x"))
    os.makedirs(os.path.join(a.out, "data"), exist_ok=True)
    files = a.files.split(",")
    variants = a.variants.split(",")
    paths = {}
    for f in files:
        p = os.path.join(a.out, "data", "%s-%dx%d.txt" % (f, cols, rows))
        if not os.path.exists(p):
            with open(p, "wb") as fh:
                fh.write(corpus(f, cols, rows))
        paths[f] = p
    cmds = {v: build(v, a.out) for v in variants}
    print("%-8s %10s" % ("file", "MB") + "".join("%16s" % v for v in variants))
    failed = False
    for f in files:
        size = os.path.getsize(paths[f])
        reps = {}
        for v in variants:
            ns, _ = time_it(cmds[v], v, paths[f], 1, cols, rows)
            reps[v] = max(1, int(a.ms * 1e6 / max(ns, 1)))
        best, checks = {}, {}
        for _ in range(a.reps):
            for v in variants:
                ns, check = time_it(cmds[v], v, paths[f], reps[v], cols, rows)
                rate = size * reps[v] * 1e3 / ns
                best[v] = max(best.get(v, 0), rate)
                checks[v] = check
        print("%-8s %10.1f" % (f, size / 1e6) + "".join("%11.1f MB/s" % best[v] for v in variants))
        if len(set(checks.values())) > 1:
            failed = True
            print("  the screens differ: " + ", ".join("%s %s" % (v, checks[v]) for v in variants))
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
