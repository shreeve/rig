#!/usr/bin/env python3
"""Times `text.find` built by two rigs: bench/text/time.rig, built with
`--release` by BASE and by NEW, run in turns ROUNDS times on FILE, each
case's fastest time kept. With `--rivals`, times std.text built by one
rig (`--release`) against the memchr crate
(rust/: `memmem::find`, and a `memmem::Finder` built once per case) and
Go's `bytes.Index` (find.go), the same cases, all in turns.

usage: bench/text/bench-text BASE_RIG NEW_RIG FILE [ROUNDS]
       bench/text/bench-text --rivals RIG FILE [ROUNDS]

FILE is a text of 8 KiB or more (lib.dom.d.ts from TypeScript's lib
files, 2.4 MB, for the numbers in README.md). Run it through tools/low
on a quiet machine.
"""
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))


def build(rig, out, name):
    exe = os.path.join(out, name)
    env = dict(os.environ, RIG_OUT_DIR=os.path.join(out, name + "-out"))
    subprocess.run([rig, "build", "--release", "-o", exe, os.path.join(HERE, "time.rig")], check=True, env=env)
    return exe


def run(exe, path, *args):
    out = subprocess.run([exe, path, *args], capture_output=True, text=True, check=True).stdout
    times = {}
    for line in out.splitlines():
        size, k, kind, ns, found = line.split()
        times[size, k, kind] = float(ns)
        FOUND.setdefault((size, k, kind), {})[exe, *args] = found
    return times


# Where each program found each case's needle, which must agree.
FOUND = {}


def check_found():
    for key, seen in FOUND.items():
        if len(set(seen.values())) > 1:
            sys.exit("bench-text: the programs disagree on %s: %s" % (" ".join(key), seen))


# The rivals: each a program and the arguments after FILE.
RIVALS = ("rig-safe", "memchr", "memchr-finder", "go")


def build_rivals(rig, out):
    exes = {"rig-safe": (build(rig, out, "rig-safe"), ())}
    target = os.path.join(out, "cargo")
    native = os.environ.get("RUSTFLAGS", "-C target-cpu=native")
    subprocess.run(["cargo", "build", "-q", "--release", "--locked", "--offline"], check=True,
                   cwd=os.path.join(HERE, "rust"), env=dict(os.environ, CARGO_TARGET_DIR=target, RUSTFLAGS=native))
    rust = os.path.join(out, "find-rust")
    shutil.copy(os.path.join(target, "release", "find"), rust)
    exes["memchr"] = (rust, ())
    exes["memchr-finder"] = (rust, ("finder",))
    go = os.path.join(out, "find-go")
    arm = os.uname().machine in ("arm64", "aarch64")
    goenv = {"GOARM64": "v8.5"} if arm else {"GOAMD64": "v3"}
    subprocess.run(["go", "build", "-o", go, "find.go"], check=True, cwd=HERE,
                   env=dict(os.environ, GOCACHE=os.path.join(out, "go-cache"), **goenv))
    exes["go"] = (go, ())
    return exes


def rivals(rig, path, rounds):
    with tempfile.TemporaryDirectory() as out:
        exes = build_rivals(rig, out)
        best = {v: {} for v in RIVALS}
        for r in range(rounds):
            # Each round in another order, so no program always runs first.
            order = RIVALS[r % len(RIVALS):] + RIVALS[:r % len(RIVALS)]
            for v in order:
                exe, args = exes[v]
                for key, ns in run(exe, path, *args).items():
                    best[v][key] = min(ns, best[v].get(key, ns))
        check_found()
    size_of = os.path.getsize(path)
    print("%-8s %3s %-6s" % ("text", "pat", "case") + "".join("%14s" % v for v in RIVALS) + "  std against the fastest rival")
    for key in best["rig-safe"]:
        size, k, kind = key
        row = [best[v][key] for v in RIVALS]
        std = row[0]
        rival = min(range(1, len(RIVALS)), key=lambda i: row[i])
        r = row[rival]
        word = "faster" if std <= r else "slower"
        pct = (r / std - 1) * 100 if std <= r else (std / r - 1) * 100
        label = "whole" if int(size) == size_of else size + " B"
        print("%-8s %3s %-6s" % (label, k, kind) + "".join("%14.1f" % x for x in row) +
              "  %.1f%% %s than %s" % (pct, word, RIVALS[rival]))


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--rivals":
        if len(sys.argv) < 4:
            sys.exit(__doc__.strip())
        rivals(sys.argv[2], sys.argv[3], int(sys.argv[4]) if len(sys.argv) > 4 else 5)
        return
    if len(sys.argv) < 4:
        sys.exit(__doc__.strip())
    base_rig, new_rig, path = sys.argv[1:4]
    rounds = int(sys.argv[4]) if len(sys.argv) > 4 else 5
    with tempfile.TemporaryDirectory() as out:
        exes = [build(base_rig, out, "base"), build(new_rig, out, "new")]
        best = [{}, {}]
        for r in range(rounds):
            for j in ((0, 1) if r % 2 == 0 else (1, 0)):
                for key, ns in run(exes[j], path).items():
                    best[j][key] = min(ns, best[j].get(key, ns))
    size_of = os.path.getsize(path)
    print("%-8s %3s %-6s %12s %12s  %s" % ("text", "pat", "case", "base ns", "new ns", "change"))
    for key in best[0]:
        size, k, kind = key
        b, n = best[0][key], best[1][key]
        word = "faster" if n <= b else "slower"
        pct = (b / n - 1) * 100 if n <= b else (n / b - 1) * 100
        label = "whole" if int(size) == size_of else size + " B"
        print("%-8s %3s %-6s %12.1f %12.1f  %.1f%% %s" % (label, k, kind, b, n, pct, word))


main()
