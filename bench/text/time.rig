# `time FILE`: the nanoseconds of one `text.find` for each case, the
# fastest of 5 runs of a loop long enough to time. A case searches a
# window of FILE (the whole of it, or a short one from its middle) for a
# needle cut from it at 1/16 of the way (an early hit) or 15/16 (a late
# one), or for that late needle with a middle byte made 0x01 (a miss,
# whose first and last bytes still meet candidates). bench/text/bench-text
# runs it built by two rigs, in turns.

use std.file
use std.hint
use std.os
use std.text
use std.time

called fun case_ns(s: ?String, pat: ?String, reps: Int) -> Int
  best = 1 << 62
  sum = 0
  for _ in 0..5
    t0 = time.now()
    for _ in 0..reps
      hint.keep(?s)  # so no search is moved out of the loop
      sum += text.find(s, pat) ?? 7
    ns = t0.elapsed()
    best = ns if ns < best else best
  print("") if sum == -1
  best

sub main()
  args = os.args()
  if args.len < 2
    print("usage: time FILE")
    return
  all = file.read(args[1]) catch none ?? String()
  if all.len < 8192
    print("time: the file is shorter than 8 KiB")
    return
  for size in [8, 16, 32, 64, 1024, 4096, all.len]
    start = 0 if size == all.len else all.len / 2 + 17
    s = ?all[start..start + size]
    for k in [1, 3, 12, 40]
      if k <= size
        for kind in ["early", "late", "miss"]
          at = s.len / 16 if kind == "early" else (s.len - k) * 15 / 16
          pat = String()
          for j in 0..k
            !pat.push(1 if kind == "miss" and j == k / 2 else s[at + j])
          work = (text.find(s, pat) ?? s.len) + 64
          reps = 100000000 / work
          reps = 16 if reps < 16 else reps
          ns = case_ns(s, pat, reps)
          print(size, k, kind, Float(ns) / Float(reps))
