# Correctness driver for std.json (bench/json/check/compare.py generates the
# program from this template: the cases become a table of string
# literals, and main loops over them). Prints each parse as the
# canonical dump that bench/json/check/README.md describes.
use std.json
use std.text

HEX = "0123456789abcdef"

sub put_line(out: !String, tag: ?String)
  !out.add(tag, "\n")

sub put_string(out: !String, s: ?String)
  !out.add("s ")
  for b in s
    if b == 0x5C
      !out.add("\\\\")
    else if b < 0x20 or b == 0x7F
      !out.add("\\x")
      !out.push(HEX[Int(b >> 4)])
      !out.push(HEX[Int(b & 15)])
    else
      !out.push(b)
  !out.push(0x0A)

sub dump(d: ?json.Doc, out: !String)
  for i in 0..d.len
    match d.kind(i)
      .null => put_line(!out, "null")
      .bool => put_line(!out, "true" if d.bool(i) else "false")
      .int => !out.add("i ", d.int(i), "\n")
      .float => !out.add("f ", d.float(i).to_bits(), "\n")
      .string => put_string(!out, d.string(i))
      .array => put_line(!out, "[")
      .array_end => put_line(!out, "]")
      .object => put_line(!out, "{")
      .object_end => put_line(!out, "}")

# The case is copied into a String, as a program's input would be.
sub run(name: Static, data: Static)
  src = String(data)
  d = json.Doc()
  out = String("=== ", name, "\n")
  failed = String()
  (!d).load(?src) catch |e| (!failed).add(String(e))
  if failed.len == 0
    dump(?d, !out)
  else
    # `JsonError.eof(at: 5)` as `error eof 5`.
    open = text.find(?failed, "(") ?? 0
    !out.add("error ", failed[10..open], " ", failed[open + 5..failed.len - 1], "\n")
  print(out)

@CASES@

sub main()
@MAIN@
