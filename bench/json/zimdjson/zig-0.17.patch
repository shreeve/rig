diff --git a/src/parsers/number/BigInt.zig b/src/parsers/number/BigInt.zig
index 323cb9c..84b984d 100644
--- a/src/parsers/number/BigInt.zig
+++ b/src/parsers/number/BigInt.zig
@@ -5,7 +5,51 @@ pub const Limb = usize;
 pub const limb_bits = @sizeOf(Limb) * 8;
 const Self = @This();
 const capacity = 58; // ceil(log2(10 ** (max_big_digits + -min_pow10)) / 64)
-const Limbs = std.BoundedArray(Limb, capacity);
+const Limbs = BoundedArray(Limb, capacity);
+
+/// The subset of std.BoundedArray (removed in Zig 0.15) that this file uses.
+fn BoundedArray(comptime T: type, comptime cap: usize) type {
+    return struct {
+        const B = @This();
+        buffer: [cap]T = undefined,
+        len: usize = 0,
+
+        pub fn init(n: usize) error{Overflow}!B {
+            if (n > cap) return error.Overflow;
+            return .{ .len = n };
+        }
+        pub fn fromSlice(m: []const T) error{Overflow}!B {
+            var b = try B.init(m.len);
+            @memcpy(b.buffer[0..m.len], m);
+            return b;
+        }
+        pub fn slice(b: *const B) []T {
+            return @constCast(b).buffer[0..b.len];
+        }
+        pub fn capacity(_: B) usize {
+            return cap;
+        }
+        pub fn get(b: B, i: usize) T {
+            return b.buffer[i];
+        }
+        pub fn resize(b: *B, n: usize) error{Overflow}!void {
+            if (n > cap) return error.Overflow;
+            b.len = n;
+        }
+        pub fn append(b: *B, x: T) error{Overflow}!void {
+            if (b.len >= cap) return error.Overflow;
+            b.appendAssumeCapacity(x);
+        }
+        pub fn appendAssumeCapacity(b: *B, x: T) void {
+            b.buffer[b.len] = x;
+            b.len += 1;
+        }
+        pub fn appendSliceAssumeCapacity(b: *B, m: []const T) void {
+            @memcpy(b.buffer[b.len..][0..m.len], m);
+            b.len += m.len;
+        }
+    };
+}
 
 limbs: Limbs,
 
