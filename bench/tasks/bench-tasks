#!/usr/bin/env python3
"""Time Rig's tasks against Tokio's and Go's (bench/tasks/README.md).

usage: bench/tasks/bench-tasks [options]

  --variants a,b  what to build and time (default: rig-fast,tokio,go):
                    rig-fast   bench/tasks/tasks.rig, rig build --release=fast
                    rig-safe   the same, rig build --release (Zig's safe mode)
                    tokio      bench/tasks/tokio, cargo build --release, on
                               Tokio's multi-threaded runtime
                    go         bench/tasks/go, go build
  --reps N        runs per variant, interleaved across variants; the
                  fastest of each benchmark counts (default 5)
  --out DIR       keep the builds in DIR and reuse them; with
  --build-only    build and stop, and later
  --time-only     time what DIR holds
  --tokio DIR     the Tokio source to build against (default: the
                  repository's misc/tokio clone, if it has one; else
                  the crates.io release Cargo resolves)
  --record NOTE   append the Rig variants' rows to bench/tasks/PROGRESS.md,
                  dated, with NOTE (say, "#348: fibers on one worker")

Each program prints `NAME NS CHECK` per benchmark; the checks must
agree. The report gives each benchmark's time per operation, the
memory each live task takes (`memory`: the peak memory of a run that
holds MANY sleeping tasks at once, less that of a run that holds none,
over MANY), and how each variant compares with Tokio.
"""
import argparse, os, shutil, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
RIG = os.environ.get("RIG", os.path.join(ROOT, "bin", "rig"))

# What one operation of each benchmark is, and how many there are
# (the constants every program shares).
OPS = {
    "spawn": ("task", 100 * 1000),
    "chain": ("task", 10000),
    "fanout": ("run", 1),
    "yield": ("yield", 100 * 10000),
    "hog": ("step", 50),
}


def tokio_source(given):
    if given:
        return given
    common = subprocess.run(["git", "rev-parse", "--git-common-dir"], cwd=HERE, capture_output=True, text=True).stdout.strip()
    clone = os.path.join(os.path.dirname(os.path.abspath(os.path.join(HERE, common))), "misc", "tokio", "tokio")
    return clone if os.path.isfile(os.path.join(clone, "Cargo.toml")) else None


def build(v, out, tokio):
    exe = os.path.join(out, v)
    if os.path.exists(exe):
        return exe
    tmp = exe + ".new"
    if v.startswith("rig-"):
        env = dict(os.environ, RIG_OUT_DIR=os.path.join(out, "rig-out-" + v))
        flag = "--release" if v == "rig-safe" else "--release=fast"
        subprocess.run([RIG, "build", flag, "-o", tmp, os.path.join(HERE, "tasks.rig")], check=True, env=env)
    elif v == "tokio":
        target = os.path.join(out, "cargo")
        cmd = ["cargo", "build", "--release", "-q", "--target-dir", target]
        if tokio:
            cmd += ["--config", 'patch.crates-io.tokio.path="%s"' % tokio]
            print("tokio: built from %s" % tokio, file=sys.stderr)
        subprocess.run(cmd, check=True, cwd=os.path.join(HERE, "tokio"))
        shutil.copy(os.path.join(target, "release", "tasks-tokio"), tmp)
    elif v == "go":
        subprocess.run(["go", "build", "-o", tmp, "."], check=True, cwd=os.path.join(HERE, "go"))
    else:
        sys.exit("bench-tasks: no variant `%s`" % v)
    os.rename(tmp, exe)
    return exe


def run(exe):
    p = subprocess.run([exe], check=True, capture_output=True, text=True)
    rows = {}
    for line in p.stdout.splitlines():
        name, ns, check = line.split()
        rows[name] = (int(ns), check)
    return rows


# How many tasks `exe many` holds at once (the programs' MANY).
MANY = 10000


def peak(exe, mode):
    """`exe mode`'s output and its peak resident memory, in bytes. On
    macOS, the child's `ru_maxrss`. On Linux, that counts this process's
    memory too, copied at the fork, so the driver reads the program's own
    high-water mark (`VmHWM`) while it runs, which both modes keep it
    doing for 200 ms."""
    p = subprocess.Popen([exe, mode], stdout=subprocess.PIPE, text=True)
    hwm = 0
    if sys.platform != "darwin":
        import time
        while p.poll() is None:
            try:
                with open("/proc/%d/status" % p.pid) as f:
                    for line in f:
                        if line.startswith("VmHWM:"):
                            hwm = max(hwm, int(line.split()[1]) * 1024)
            except (OSError, ValueError):
                pass
            time.sleep(0.005)
        out = p.stdout.read()
    else:
        out = p.stdout.read()
        _, status, usage = os.wait4(p.pid, 0)
        p.returncode = os.waitstatus_to_exitcode(status)
        hwm = usage.ru_maxrss
    if p.returncode != 0:
        sys.exit("bench-tasks: `%s %s` exited %d" % (exe, mode, p.returncode))
    return out, hwm


def memory(exe):
    """The memory one live task takes, in bytes, and the run's check."""
    out, many = peak(exe, "many")
    _, idle = peak(exe, "idle")
    name, _, check = out.split()
    return max(1, many - idle) / MANY, check


def size(b):
    if b >= 1024 * 1024:
        return "%.1f MiB" % (b / 1024 / 1024)
    if b >= 1024:
        return "%.1f KiB" % (b / 1024)
    return "%.0f B" % b


def per_op(name, ns):
    unit, count = OPS[name]
    v = ns / count
    if v >= 1e6:
        return "%.1f ms/%s" % (v / 1e6, unit)
    if v >= 1e3:
        return "%.2f us/%s" % (v / 1e3, unit)
    return "%.0f ns/%s" % (v, unit)


def cell(name, ns):
    """A table cell: the time per operation, in the unit it reads best in."""
    return per_op(name, ns).split("/")[0]


def record(note, variants, best):
    """Append each Rig variant's row to PROGRESS.md: the date, the note,
    the variant, and each benchmark's time per operation."""
    import datetime
    path = os.path.join(HERE, "PROGRESS.md")
    day = datetime.date.today().isoformat()
    with open(path, "a") as f:
        for v in variants:
            if v.startswith("rig-"):
                cells = [cell(n, best[v][n]) for n in OPS] + [size(best[v]["memory"])]
                f.write("| %s | %s | %s | %s |\n" % (day, note, v, " | ".join(cells)))
    print("bench-tasks: recorded in %s" % path, file=sys.stderr)


def compare(ns, base):
    if ns >= base:
        return "%.1fx slower" % (ns / base)
    return "%.1fx faster" % (base / ns)


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--variants", default="rig-fast,tokio,go")
    ap.add_argument("--reps", type=int, default=5)
    ap.add_argument("--out")
    ap.add_argument("--build-only", action="store_true")
    ap.add_argument("--time-only", action="store_true")
    ap.add_argument("--tokio")
    ap.add_argument("--record")
    a = ap.parse_args()
    variants = a.variants.split(",")
    out = a.out or tempfile.mkdtemp(prefix="bench-tasks-")
    os.makedirs(out, exist_ok=True)
    tokio = tokio_source(a.tokio) if "tokio" in variants else None
    exes = {v: (os.path.join(out, v) if a.time_only else build(v, out, tokio)) for v in variants}
    if a.build_only:
        return
    best = {v: {} for v in variants}
    checks = {}
    for _ in range(a.reps):
        for v in variants:
            for name, (ns, check) in run(exes[v]).items():
                if name in checks and checks[name] != check:
                    sys.exit("bench-tasks: %s's %s check is %s, not %s" % (v, name, check, checks[name]))
                checks[name] = check
                best[v][name] = min(ns, best[v].get(name, ns))
            per_task, check = memory(exes[v])
            if checks.setdefault("many", check) != check:
                sys.exit("bench-tasks: %s's many check is %s, not %s" % (v, check, checks["many"]))
            best[v]["memory"] = min(per_task, best[v].get("memory", per_task))
    base = "tokio" if "tokio" in variants else variants[0]
    print("%-8s" % "" + "".join("%-18s" % v for v in variants) + "vs %s" % base)
    for name in OPS:
        cells = "".join("%-18s" % per_op(name, best[v][name]) for v in variants)
        ratios = ", ".join("%s %s" % (v, compare(best[v][name], best[base][name])) for v in variants if v != base)
        print("%-8s%s%s" % (name, cells, ratios))
    cells = "".join("%-18s" % (size(best[v]["memory"]) + "/task") for v in variants)
    ratios = ", ".join("%s %s" % (v, compare(best[v]["memory"], best[base]["memory"]).replace("slower", "more").replace("faster", "less")) for v in variants if v != base)
    print("%-8s%s%s" % ("memory", cells, ratios))
    if a.record:
        record(a.record, variants, best)
    if not a.out:
        shutil.rmtree(out, ignore_errors=True)


if __name__ == "__main__":
    main()
