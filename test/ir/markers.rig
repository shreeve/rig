# A function's marker fills the `mark` role of `fun` and `sub`.

inline fun twice(n: Int) -> Int
  n * 2

pub rarely sub warn(n: Int)
  print(n)

called fun thrice(n: Int) -> Int
  n * 3

obj Point
  x: Int

  inline fun get(?self) -> Int
    self.x

rarely fun Point.zero(?self) -> Bool
  self.x == 0

sub main()
  inline = twice(thrice(1))
  warn(inline)
  print(Point(x: inline).get(), Point(x: 0).zero())
