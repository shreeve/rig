# Drop glue nests: `Outer` owns an `Inner` value that owns a `*Noisy`
# handle, so dropping `o` at scope exit drops the Noisy (its drop body
# prints the id).

obj Noisy
  id: Int

  drop(!self)
    print(self.id)

obj Inner
  r: *Noisy

obj Outer
  inner: Inner

sub main()
  n = *Noisy(id: 5)
  i: Inner = Inner(r: <n)
  o: Outer = Outer(inner: <i)
  print("built")

# expect:
# built
# 5
