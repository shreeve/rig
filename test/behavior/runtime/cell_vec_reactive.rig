# A reactive counter without Signal: watchers are owned closures that
# each capture a shared `*Cell[List[Int]]` and push to it in one call.

obj Counter
  value: *Cell[Int]
  watchers: List[*sub(Int)]

  sub watch(!self, f: *sub(Int))
    !self.watchers.push(<f)

  sub bump(!self)
    !self.value.set(self.value.get() + 1)
    for w in ?self.watchers
      w(self.value.get())

sub main()
  log: *Cell[List[Int]] = *Cell(List())
  doubled: *Cell[List[Int]] = *Cell(List())
  c = Counter(value: *Cell(0), watchers: List())
  !c.watch(*|+log, n| !log.push(n))
  !c.watch(*|+doubled, n| !doubled.push(n * 2))
  !c.bump()
  !c.bump()
  !c.bump()
  print(log.len, log[0], log[2], (!doubled).pop(), doubled.len)

# expect:
# 3 1 3 6 2
