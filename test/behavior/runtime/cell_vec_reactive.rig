# A reactive counter without Signal: watchers are owned closures that
# each capture a shared `*Cell(Vec(Int))` and push to it in one call.

struct Counter
  value: Cell(Int)
  watchers: Vec(*sub(Int))

  sub watch(!self, f: *sub(Int))
    (!self.watchers).push(<f)

  sub bump(?self)
    self.value.set(self.value.get() + 1)
    for w in ?self.watchers
      w(self.value.get())

sub main()
  log: *Cell(Vec(Int)) = *Cell(value: Vec())
  doubled: *Cell(Vec(Int)) = *Cell(value: Vec())
  c = Counter(value: Cell(value: 0), watchers: Vec())
  (!c).watch(*|+log, n| log.push(n))
  (!c).watch(*|+doubled, n| doubled.push(n * 2))
  c.bump()
  c.bump()
  c.bump()
  print(log.len, log[0], log[2], doubled.pop(), doubled.len)

# expect:
# 3 1 3 6 2
