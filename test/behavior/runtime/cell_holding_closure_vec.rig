# `*Cell[List[*sub()]]`: a shared cell owning a list of closures.
# `replace` swaps the list out so it can be walked, then back in; the
# whole structure is freed when the cell's last handle drops.

sub main()
  count: *Cell[Int] = *Cell(0)
  bump: *sub() = *|+count| !count.set(count.get() + 1)
  v: List[*sub()] = List()
  !v.push(<bump)
  c: *Cell[List[*sub()]] = *Cell(<v)
  empty: List[*sub()] = List()
  current: List[*sub()] = (!c).replace(<empty)
  for cb in ?current
    cb()
  discarded: List[*sub()] = (!c).replace(<current)
  print(count.get())                # 1

# expect:
# 1
