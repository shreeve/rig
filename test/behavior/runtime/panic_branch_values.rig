# `panic` gives no value, so it stands for any: as a branch of a
# ternary, a match arm, the right side of `??`, a `catch` handler, and a
# destructuring fallback. The column counts runes: the `é` before the
# panic counts once.

error Bad
  no

fun half(n: Int) -> Int
  n / 2 if n % 2 == 0 else panic("odd:", n)

fun sign(n: Int) -> Static
  match n
    0 => "zero"
    _ => "é" if n > 0 else panic("negative", n)

fun get(n: Int) -> Int!
  return Bad.no if n < 0
  n

fun divmod(a: Int, b: Int) -> (Int, Int)?
  return none if b == 0
  return a / b, a % b

sub main()
  print(half(4), sign(0), sign(2))
  o: Int? = none
  print(o ?? 7, (o ?? 7) + 1)
  x = get(3) catch panic("no value")
  print(x)
  q, r = divmod(7, 2) ?? panic("divide by zero")
  print(q, r)
  print(sign(-1))

# release
# expect-panic: panic: negative -1
# expect:
# 2 zero é
# 7 8
# 3
# 3 1
# expect-stderr:
# panic_branch_values.rig:15:28: panic: negative -1
