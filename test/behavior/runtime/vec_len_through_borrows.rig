# `.len` of a Vec reads through a read or write borrow and a shared
# handle, like `.len` of an array.

fun count(v: ?Vec(Int)) -> Int
  v.len

sub grow(v: !Vec(Int))
  v.push(v.len * 10)

struct Bag
  items: Vec(Int)

sub main()
  v: Vec(Int) = Vec()
  grow(!v)
  grow(!v)
  print(count(?v), v.len, v[1])
  b = *Bag(items: Vec())
  print(b.items.len)
  for i in 0..v.len
    print(v[i])

# expect:
# 2 2 10
# 0
# 0
# 10
