# `*Closure1(Int)` is an owned closure taking one argument; each call
# passes the argument through to the body.

sub main()
  v: *Cell(Int) = *Cell(value: 0)
  cb: *Closure1(Int) = *Closure1(Int)(|+v| (a: Int) v.set(a))
  cb(7)
  print(v.get())            # 7
  cb(42)
  print(v.get())            # 42

# expect:
# 7
# 42
