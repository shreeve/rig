# `*sub(Int)` is an owned closure taking one argument; each call
# passes the argument through to the body. The parameter's type comes
# from the binding's annotation.

sub main()
  v: *Cell[Int] = *Cell(value: 0)
  cb: *sub(Int) = *|+v, a| v.set(a)
  cb(7)
  print(v.get())            # 7
  cb(42)
  print(v.get())            # 42

# expect:
# 7
# 42
