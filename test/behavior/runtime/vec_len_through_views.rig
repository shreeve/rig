# `.len` of a List reads through a read or write view and a shared
# handle, like `.len` of an array.

fun count(v: ?List[Int]) -> Int
  v.len

sub grow(v: !List[Int])
  !v.push(v.len * 10)

obj Bag
  items: List[Int]

sub main()
  v: List[Int] = List()
  grow(!v)
  grow(!v)
  print(count(?v), v.len, v[1])
  b = *Bag(items: List())
  print(b.items.len)
  for i in 0..v.len
    print(v[i])

# expect:
# 2 2 10
# 0
# 0
# 10
