# A `Cell[*Noisy]` has drop glue: when the last handle to it, `c`, leaves
# scope, it drops the handle it holds, which runs Noisy's drop body.

struct Noisy
  id: Int

  drop(!self)
    print(self.id)

sub main()
  u = *Noisy(id: 30)
  c: *Cell[*Noisy] = *Cell(<u)
  print("stored")

# expect:
# stored
# 30
