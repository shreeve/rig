# A stack-local `Cell[*Noisy]` has drop glue: when `c` leaves scope it
# drops the handle it holds, which runs Noisy's drop body.

struct Noisy
  id: Int

  drop(!self)
    print(self.id)

sub main()
  u = *Noisy(id: 30)
  c: Cell[*Noisy] = Cell(value: <u)
  print("stored")

# expect:
# stored
# 30
