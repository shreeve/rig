# `keep` on a List of Lists of String drops the inner Lists and their
# text, and works on an inner List lent as an element.
# release

fun row(k: Int) -> List[String]
  r: List[String] = List()
  for j in 0..k
    !r.push(String(k, ":", j))
  r

sub main()
  rows: List[List[String]] = List()
  for k in 0..5
    !rows.push(row(k))
  !rows.keep(rows.len)
  !rows.keep(4)
  print(rows)
  !rows[3].keep(1)
  !rows[2].keep(0)
  print(rows)
  !rows.keep(1)
  print(rows)
  !rows.keep(0)
  print(rows.len)

# expect:
# [[], ["1:0"], ["2:0", "2:1"], ["3:0", "3:1", "3:2"]]
# [[], ["1:0"], [], ["3:0"]]
# [[]]
# 0
