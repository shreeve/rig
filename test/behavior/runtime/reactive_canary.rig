# The reactive substrate end to end: a Cell shared by closures, stack and
# owned closures, a Vec of closures, and Signals with subscribers. A
# subscriber that reads its own Signal holds it weakly (`|~sig|`), so the
# Signal and its subscriber do not keep each other alive.

sub main()
  # Cell: interior mutability through a shared handle.
  count: *Cell[Int] = *Cell(value: 0)
  count.set(1)
  print(count.get())                # 1

  # A stack closure clone-captures the cell.
  bump = |+count| count.set(count.get() + 1)
  bump()
  bump()
  print(count.get())                # 3

  # An owned closure can be stored and passed around; this one takes an
  # argument, and the next returns a value.
  add: *sub(Int) = *|+count, n| count.set(count.get() + n)
  add(10)
  scaled: *fun(Int) -> Int = *|+count, n| count.get() * n
  print(count.get(), scaled(2))     # 13 26

  # A Signal calls every subscriber on `set`. This subscriber reads the
  # Signal it listens to, so it holds it weakly.
  sig: *Signal[Int] = *Signal(value: 0)
  sig.subscribe(*|~sig|
    if sig.upgrade() as s
      print("sig", s.get()))
  sig.set(7)                        # sig 7
  sig.set(99)                       # sig 99

  # A Vec of closures, walked by borrowed slot.
  notes: *Cell[Int] = *Cell(value: 0)
  steps: Vec[*sub()] = Vec()
  !steps.push(*|+notes| notes.set(notes.get() + 1))
  !steps.push(*|+notes| notes.set(notes.get() + 10))
  !steps.push(*|+notes| notes.set(notes.get() + 100))
  for step in ?steps
    step()
  print(notes.get())                # 111

  # Subscribers run in subscription order, each with its own captures.
  tally: *Cell[Int] = *Cell(value: 0)
  multi: *Signal[Int] = *Signal(value: 0)
  for weight in [1, 10, 100]
    multi.subscribe(*|+tally, +weight| tally.set(tally.get() * 2 + weight))
  multi.set(42)
  print(tally.get())                # ((0*2 + 1)*2 + 10)*2 + 100 = 124

# expect:
# 1
# 3
# 13 26
# sig 7
# sig 99
# 111
# 124
