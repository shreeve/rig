# The reactive substrate end to end: a Cell shared by closures, stack and
# owned closures, a Vec of closures, and Signals with subscribers. A
# subscriber that reads its own Signal holds it weakly (`|~sig|`), so the
# Signal and its subscriber do not keep each other alive.

# Print the Signal's value, if it is still alive.
sub report(sig: ?~Signal(Int))
  if sig.upgrade() as s
    print(s.get())

sub main()
  # Cell interior mutability through a shared handle.
  count: *Cell(Int) = *Cell(value: 0)
  count.set(1)
  print(count.get())                # 1

  # Stack closure clone-capturing the cell.
  bump = |+count|
    count.set(count.get() + 1)
  bump()
  bump()
  print(count.get())                # 3

  # Owned (escapable) closure.
  eff: *sub() = *|+count| count.set(count.get() + 10)
  eff()
  print(count.get())                # 13

  # Signal: `set` stores the value and calls every subscriber.
  sig: *Signal(Int) = *Signal(value: 0)
  log: *sub() = *|~sig| report(?sig)
  sig.subscribe(+log)
  sig.set(7)                        # 7
  sig.set(99)                       # 99

  # Walking a Vec of closures by borrowed slot.
  notes: *Cell(Int) = *Cell(value: 0)
  one:   *sub() = *|+notes| notes.set(notes.get() + 1)
  ten:   *sub() = *|+notes| notes.set(notes.get() + 10)
  cent:  *sub() = *|+notes| notes.set(notes.get() + 100)
  subs: Vec(*sub()) = Vec()
  (!subs).push(+one)
  (!subs).push(+ten)
  (!subs).push(+cent)
  for cb in ?subs
    cb()
  print(notes.get())                # 111 (1 + 10 + 100)

  # Signal with several subscribers, called in subscription order.
  tally: *Cell(Int) = *Cell(value: 0)
  add_a: *sub() = *|+tally| tally.set(tally.get() + 1)
  add_b: *sub() = *|+tally| tally.set(tally.get() + 10)
  add_c: *sub() = *|+tally| tally.set(tally.get() + 100)
  multi: *Signal(Int) = *Signal(value: 0)
  multi.subscribe(+add_a)
  multi.subscribe(+add_b)
  multi.subscribe(+add_c)
  multi.set(42)                     # tally 0 -> 111
  print(tally.get())                # 111

# expect:
# 1
# 3
# 13
# 7
# 99
# 111
# 111
