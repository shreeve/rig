# `*Closure2(Int, Int)` is an owned closure taking two arguments.

sub main()
  v: *Cell(Int) = *Cell(value: 0)
  cb: *Closure2(Int, Int) = *Closure2(Int, Int)(|+v| (a: Int, b: Int) v.set(a + b))
  cb(10, 20)
  print(v.get())            # 30
  cb(100, 1)
  print(v.get())            # 101

# expect:
# 30
# 101
