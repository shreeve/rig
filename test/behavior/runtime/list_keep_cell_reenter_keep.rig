# A drop body that calls `keep` or `clear` on the cell whose `keep` is
# dropping it: the inner call drops what is left past its own count, and
# the outer `keep`, finding the List already shorter, stops. Every
# element drops exactly once.
# release

obj Holder
  items: Cell[List[Item]]

obj Item
  id: Int
  clears: Bool
  h: ~Holder

  drop(!self)
    if *self.h as h
      print("drop", self.id, "sees", h.items.len)
      if self.id == 3
        if self.clears
          !h.items.clear()
        else
          !h.items.keep(0)

sub fill(h: *Holder, clears: Bool)
  for i in 1..5
    !h.items.push(Item(id: i, clears: clears, h: ~h))

sub main()
  a = *Holder(items: Cell(List()))
  fill(+a, false)
  !a.items.keep(2)
  print("after keep", a.items.len)

  b = *Holder(items: Cell(List()))
  fill(+b, true)
  !b.items.keep(1)
  print("after clear", b.items.len)

# expect:
# drop 4 sees 3
# drop 3 sees 2
# drop 2 sees 1
# drop 1 sees 0
# after keep 0
# drop 4 sees 3
# drop 3 sees 2
# drop 2 sees 0
# drop 1 sees 0
# after clear 0
