# Text printed on its own is written as it is. Text inside another value
# (a list, an object's field, a payload, an optional) is quoted and
# escaped, so it reads back as a Rig literal: `"` and `\` take a
# backslash; a newline, tab, and carriage return are `\n`, `\t`, `\r`;
# any other control byte and each byte of invalid UTF-8 is `\xHH`; a C1
# control and a bidirectional control are `\u{h}`; every other character
# is written as is. An object prints every field.

obj Note
  title: String
  tags: List[String]
  by: ?String

enum Ev
  said(text: ?String)
  quiet

sub main()
  print("a\"b\\c é")
  s = "a\"b\\c\nd\te\rf\x01g\x7fh\xffi\u{85}j\u{202e}k\u{e9}"
  print([s])
  print(["", "plain", "it's"])
  tags: List[String] = List()
  !tags.push(String("x\ny"))
  n = Note(title: String("t\t"), tags: <tags, by: "q\"")
  print(n)
  print(Ev.said(text: "tab\t"), Ev.quiet)
  o: Static? = "maybe"
  p: Static? = none
  print(o, [o, p])
  print(String([s]) == "[\"a\\\"b\\\\c\\nd\\te\\rf\\x01g\\x7fh\\xffi\\u{85}j\\u{202e}k\u{e9}\"]")

# release
# expect:
# a"b\c é
# ["a\"b\\c\nd\te\rf\x01g\x7fh\xffi\u{85}j\u{202e}ké"]
# ["", "plain", "it's"]
# Note(title: "t\t", tags: ["x\ny"], by: "q\"")
# .said(text: "tab\t") .quiet
# maybe ["maybe", none]
# true
