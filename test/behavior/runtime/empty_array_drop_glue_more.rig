obj Holder
  tag: String
  none: [0]String
  lists: [0]List[Int]
  shared: [0]*Int

fun take(a: []List[Int]) -> Int
  a.len

fun give() -> [0]List[Int]
  []

sub main()
  a: [0]List[Int] = []
  b = +a
  print(a)
  print(take(a))
  c = give()
  print(c.len)
  s: [0]*Int = []
  s2 = +s
  print(s2.len)
  h = Holder(tag: String("h"), none: [], lists: [], shared: [])
  print(h)
  h2 = +h
  print(h2.lists.len)
  nested: [0][0]String = []
  print(nested.len)
  o: [0]?String = []
  print(o.len)
  m: [2][0]String = [[], []]
  print(m.len)

# expect:
# []
# 0
# 0
# 0
# Holder(tag: "h", none: [], lists: [], shared: [])
# 0
# 0
# 0
# 2
