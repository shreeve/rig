# `!v.clear()` drops every element now, last first, leaving an empty
# List that can be reused; elements pushed afterwards are dropped with the
# List. A handle cloned into the List keeps its value alive past the clear.

obj B
  n: Int

  drop(!self)
    print("drop", self.n)

sub main()
  keep = *B(n: 1)
  v: List[*B] = List()
  !v.push(*B(n: 0))
  !v.push(+keep)
  !v.push(*B(n: 2))
  !v.clear()
  print("len", v.len)
  print("kept", keep.n)
  !v.push(*B(n: 9))
  print("len", v.len)

  w: List[Int] = List()
  !w.push(4)
  !w.clear()
  print("ints", w.len, w)

# expect:
# drop 2
# drop 0
# len 0
# kept 1
# len 1
# ints 0 []
# drop 9
# drop 1
