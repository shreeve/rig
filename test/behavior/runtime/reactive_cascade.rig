# Two reactive sources chained by a subscriber that reads one and sets
# the other (count -> total -> print). Subscribers hold their sources
# weakly (`|~count, ~total|`), so no source is kept alive by its own
# subscriber list.

struct IntSource
  value: *Cell(Int)
  subs: *Cell(Vec(*sub()))

  fun new(initial: Int) -> *IntSource
    val: *Cell(Int) = *Cell(value: initial)
    empty: Vec(*sub()) = Vec()
    subs_cell: *Cell(Vec(*sub())) = *Cell(value: <empty)
    *IntSource(value: <val, subs: <subs_cell)

  fun get(self: ?IntSource) -> Int
    self.value.get()

  # A Cell holding a Vec gives no borrowed access, so the list is swapped
  # out with `replace`, pushed to, and swapped back.
  sub subscribe(self: ?IntSource, cb: *sub())
    empty: Vec(*sub()) = Vec()
    current: Vec(*sub()) = self.subs.replace(<empty)
    (!current).push(+cb)
    discarded: Vec(*sub()) = self.subs.replace(<current)

  sub set(self: ?IntSource, v: Int)
    self.value.set(v)
    empty: Vec(*sub()) = Vec()
    current: Vec(*sub()) = self.subs.replace(<empty)
    for cb in ?current
      cb()
    discarded: Vec(*sub()) = self.subs.replace(<current)

# Copy `from` into `to`, scaled, if both are still alive.
sub relay(from: ?~IntSource, to: ?~IntSource)
  if from.upgrade() as f
    if to.upgrade() as t
      t.set(f.get() * 10)

# Print the source's value, if it is still alive.
sub report(source: ?~IntSource)
  if source.upgrade() as s
    print(s.get())

sub main()
  count = IntSource.new(0)
  total = IntSource.new(0)

  body_a: *sub() = *|~count, ~total| relay(?count, ?total)
  count.subscribe(+body_a)

  body_b: *sub() = *|~total| report(?total)
  total.subscribe(+body_b)

  count.set(1)        # total becomes 10, prints 10
  count.set(7)        # total becomes 70, prints 70
  print(total.get())  # 70

# expect:
# 10
# 70
# 70
