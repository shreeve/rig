# Two reactive sources chained by a subscriber that reads one and sets
# the other (count -> total -> print). Subscribers hold their sources
# weakly (`|~count, ~total|`), so no source is kept alive by its own
# subscriber list.

type Subscribers = List[*sub()]

obj IntSource
  value: Cell[Int]
  subs: Cell[Subscribers]

  fun new(initial: Int) -> *IntSource
    *IntSource(value: Cell(initial), subs: Cell(List()))

  fun get(self: ?IntSource) -> Int
    self.value.get()

  sub subscribe(self: !IntSource, cb: *sub())
    !self.subs.push(<cb)

  # A Cell lends no view of the List inside it, so the list is swapped
  # out to be walked, and swapped back.
  sub set(self: !IntSource, v: Int)
    !self.value.set(v)
    subs = (!self.subs).replace(List())
    for notify in ?subs
      notify()
    _ = !self.subs.replace(<subs)

sub main()
  count = IntSource.new(0)
  total = IntSource.new(0)

  !count.subscribe(*|~count, ~total|
    if *count as c
      if *total as t
        !t.set(c.get() * 10)
  )
  !total.subscribe(*|~total|
    if *total as t
      print(t.get())
  )

  !count.set(1)        # total becomes 10, prints 10
  !count.set(7)        # total becomes 70, prints 70
  print(total.get())  # 70

# expect:
# 10
# 70
# 70
