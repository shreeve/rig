# Subscribing to a signal from inside one of its subscribers panics: the
# subscriber list is being walked. Subscribers before the panic still ran.

sub main()
  sig: *Signal(Int) = *Signal(value: 0)
  sig.subscribe(*|~sig|
    print("notified")
    if sig.upgrade() as s
      s.subscribe(*|| print("late")))
  print("before")
  sig.set(1)
  print("unreachable")

# expect-panic: Signal.subscribe called while notifying subscribers

# expect:
# before
# notified
