# A write borrow moved into a closure (`|<w|`) writes through to the
# borrowed value, on every call; a moved read borrow reads it.

struct Box
  n: Int

sub main()
  b = Box(n: 1)
  if true
    w = !b
    f = |<w|
      w.n += 10
    f()
    f()
  print(b.n)
  if true
    v = !b
    g = |<v|
      v.n *= 2
    g()
    g()
  print(b.n)
  r = ?b
  k = |<r| r.n + 1
  print(k())

# expect:
# 21
# 84
# 85
