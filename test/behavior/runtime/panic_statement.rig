# `panic(a, b)` ends the program where it stands: what `print`
# buffered is written out, then stderr gets `file.rig:L:C: panic: ` and
# the line `print` would write, and the program exits 134 in every build
# mode. No drop, `defer`, or leak check runs.

obj Res
  name: ?String
  drop(!self)
    print("dropping", self.name)

fun pick(xs: []Int, i: Int) -> Int
  if i >= xs.len
    panic("index", i, "past", xs.len, ["é"])
  xs[i]

sub main()
  r = Res(name: "r")
  defer print("deferred")
  xs = [1, 2, 3]
  print("before", pick(?xs[..], 1))
  list: List[Int] = List()
  !list.push(1)
  print(pick(?xs[..], 5))
  print("after", r.name)

# release
# expect-panic: panic: index 5 past 3
# expect:
# before 2
# expect-stderr:
# panic_statement.rig:13:5: panic: index 5 past 3 ["é"]
