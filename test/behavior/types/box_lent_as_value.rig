# A box lent as its value (`?b` where a `?T` is expected, `!b` where a
# `!T` is) works wherever a view goes: a typed or rebound
# view local, an argument evaluated out of order, a generic result, a
# write view of the box read as the value.

obj R
  n: Int

  drop(!self)
    print("drop", self.n)

obj S
  b: ^Int

fun add(x: ?Int, y: Int) -> Int
  x + y

fun peek[T](b: ?^T) -> ?T
  ?b

fun rd(r: ?R) -> Int
  r.n

sub g(w: !^R)
  print(rd(w), rd(?w))

sub main()
  b = ^R(n: 1)
  c = ^R(n: 2)
  r: ?R = ?c
  print(r.n)
  r = ?b
  print(r.n)
  s = S(b: ^5)
  k: ?Int = ?s.b
  print(k + 1)
  n = 1
  print(add(y: n + 1, x: ?s.b), peek(?s.b))
  g(!b)

# expect:
# 2
# 1
# 6
# 7 5
# 1 1
# drop 2
# drop 1
