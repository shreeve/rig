# A generic method of a public generic type may use an instance of its
# own type at the method's own parameter (`Chain[Pair[T, U]]` in
# `zip[U]`): each call makes one instance, which does not nest further.

pub obj Pair[A, B]
  a: A
  b: B

pub obj Chain[T]
  items: List[T]

  fun zip[U](?self, other: ?Chain[U]) -> Chain[Pair[T, U]]
    out: List[Pair[T, U]] = List()
    i = 0
    while i < self.items.len and i < other.items.len
      !out.push(Pair(a: self.items[i], b: other.items[i]))
      i += 1
    Chain(items: <out)

sub main()
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  w: List[?String] = List()
  !w.push("a")
  !w.push("b")
  l = Chain(items: <v)
  m = Chain(items: <w)
  z = ?l.zip(?m)
  zz = ?z.zip(?l)
  print(zz.items[1].a.a, zz.items[1].a.b, zz.items[1].b)

# expect:
# 2 b 2
