# Fields and methods reach through every combination of boxes and
# shared handles: `Box[*S]`, `*Box[S]`, `Box[Box[S]]`, `Box[Box[*S]]`,
# and `Box[*Box[S]]`, read in place, lent to read, and matched. A Cell
# in the value changes in place through any of them, and `<b.unbox()`
# takes the handle out of its box.

enum K
  a(n: Int)
  b

struct S
  n: Int
  xs: Vec[Int]
  t: Text
  k: K
  c: Cell[Int]

  fun get(?self) -> Int
    self.n + self.xs[0]

fun mk(n: Int) -> S
  xs: Vec[Int] = Vec()
  !xs.push(n * 10)
  S(n: n, xs: <xs, t: Text("s", n), k: .a(n: n + 1), c: Cell(n))

fun first(v: ?Vec[Int]) -> Int
  v[0]

fun viewed(b: ?Box[*S]) -> Int
  b.n + b.get()

sub show(n: Int, get: Int, x0: Int, len: Int, t: ?Text, k: ?K, c: Int)
  match k
    .a(m) => print(n, get, x0, len, t, m, c)
    .b => pass

sub main
  bh: Box[*S] = Box(*mk(1))
  bh.c.set(bh.c.get() + 100)
  show(bh.n, bh.get(), first(?bh.xs), bh.xs.len, ?bh.t, ?bh.k, bh.c.get())
  print(viewed(?bh))
  hb: *Box[S] = *Box(mk(2))
  show(hb.n, hb.get(), first(?hb.xs), hb.xs.len, ?hb.t, ?hb.k, hb.c.get())
  bb: Box[Box[S]] = Box(Box(mk(3)))
  !bb.xs.push(1)
  bb.n = 30
  show(bb.n, bb.get(), first(?bb.xs), bb.xs.len, ?bb.t, ?bb.k, bb.c.get())
  bbh: Box[Box[*S]] = Box(Box(*mk(4)))
  show(bbh.n, bbh.get(), first(?bbh.xs), bbh.xs.len, ?bbh.t, ?bbh.k, bbh.c.get())
  bhb: Box[*Box[S]] = Box(*Box(mk(5)))
  show(bhb.n, bhb.get(), first(?bhb.xs), bhb.xs.len, ?bhb.t, ?bhb.k, bhb.c.get())
  for x in bhb.xs
    print(x)
  h = <bh.unbox()
  print(h.n)
  e: Box[*K] = Box(*K.a(n: 7))
  match e
    .a(n) => print(n)
    .b => pass

# expect:
# 1 11 10 1 s1 2 101
# 12
# 2 22 20 1 s2 3 2
# 30 60 30 2 s3 4 3
# 4 44 40 1 s4 5 4
# 5 55 50 1 s5 6 5
# 50
# 1
# 7
