# Fields and methods reach through a box and through a shared handle,
# read in place, lent to read, and matched. A shared Cell in the value
# changes through either, and `<b.unbox()` takes the value out of its
# box.

enum K
  a(n: Int)
  b

obj S
  n: Int
  xs: List[Int]
  t: String
  k: K
  c: *Cell[Int]

  fun get(?self) -> Int
    self.n + self.xs[0]

fun mk(n: Int) -> S
  xs: List[Int] = List()
  !xs.push(n * 10)
  S(n: n, xs: <xs, t: String("s", n), k: .a(n: n + 1), c: *Cell(n))

fun first(v: ?List[Int]) -> Int
  v[0]

fun viewed(b: ?^S) -> Int
  b.n + b.get()

sub show(n: Int, get: Int, x0: Int, len: Int, t: ?String, k: ?K, c: Int)
  match k
    .a(m) => print(n, get, x0, len, t, m, c)
    .b => pass

sub main()
  bh: ^S = ^mk(1)
  !bh.c.set(bh.c.get() + 100)
  show(bh.n, bh.get(), first(?bh.xs), bh.xs.len, ?bh.t, ?bh.k, bh.c.get())
  print(viewed(?bh))
  hb: *S = *mk(2)
  show(hb.n, hb.get(), first(?hb.xs), hb.xs.len, ?hb.t, ?hb.k, hb.c.get())
  bh.n = 30
  !bh.xs.push(1)
  show(bh.n, bh.get(), first(?bh.xs), bh.xs.len, ?bh.t, ?bh.k, bh.c.get())
  for x in bh.xs
    print(x)
  h = <bh.unbox()
  print(h.n)
  e: ^K = ^K.a(n: 7)
  match e
    .a(n) => print(n)
    .b => pass

# expect:
# 1 11 10 1 s1 2 101
# 12
# 2 22 20 1 s2 3 2
# 30 40 10 2 s1 2 101
# 10
# 1
# 30
# 7
