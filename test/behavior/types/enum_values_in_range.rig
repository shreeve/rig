# Explicit enum values are constant integers from 0 to 2^32 - 1; a
# variant without one takes the value after the previous variant's.

enum Status
  ok = 200
  created
  moved = 0x12D
  missing = 400 + 4
  big = 4294967295

sub main()
  s: Status = .created
  print(s, s == .created, s == .ok)
  print(Status.big)

# expect:
# .created true false
# .big
