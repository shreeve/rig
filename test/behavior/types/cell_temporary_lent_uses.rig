# A temporary that holds a Cell, lent to read in a header, to a call
# whose result views it, or to a `?self` method, lives until its
# statement (or header) ends: the view the call returns sees the change
# within the statement, and the temporary's `drop` sees it after. A type
# with no `drop` is held the same way.
# release

struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

  sub hit(?self)
    self.c.set(self.c.get() + 1)

struct C
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)
    print("hit", self.c.get())

fun mkd(n: Int) -> D
  D(c: Cell(n))

fun mkc(n: Int) -> C
  C(c: Cell(n))

fun touch(p: ?D) -> ?D
  p.c.set(p.c.get() + 10)
  p

fun touchc(p: ?C) -> ?C
  p.c.set(p.c.get() + 10)
  p

fun ok(p: ?D) -> Bool
  p.c.set(p.c.get() + 100)
  p.c.get() > 0

fun peek[T](p: ?T) -> ?T
  p

sub main()
  if ok(?mkd(1))
    print("if")
  match ok(?mkd(2))
    true => print("match")
    false => pass
  while ok(?mkd(3))
    print("while")
    break
  print(touch(?mkd(4)).c.get())
  n = touch(?mkd(5)).c.get() + 1
  print(n)
  mkd(6).hit()
  mkc(7).hit()
  print(touchc(?mkc(8)).c.get())
  print(peek(?mkd(9)).c.get())
  print(touch(peek(?mkd(10))).c.get())

# expect:
# drop 101
# if
# drop 102
# match
# drop 103
# while
# 14
# drop 14
# drop 15
# 16
# drop 7
# hit 8
# 18
# 9
# drop 9
# 20
# drop 20
