# A box holds a read view, of an owner too: `^?v` keeps `v` lent
# while the box is used, and the box reaches the viewed value as a
# view reaches it.

obj Point
  x: Int
  y: Int

fun size(b: ?^?List[Int]) -> Int
  b.len

sub main()
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  b = ^?v
  print(b.len, size(?b))
  p = Point(x: 3, y: 4)
  bp = ^?p
  print(bp.x + bp.y)
  t = String("hello")
  bt = ^?t
  print(bt.len, bt)
  moved = <b
  print(moved.len)
  boxes: List[^?List[Int]] = List()
  !boxes.push(^?v)
  !boxes.push(^?v)
  print(boxes[0].len + boxes[1].len)

# expect:
# 2 2
# 7
# 5 hello
# 2
# 4
