# Arithmetic on number literals is computed in the float type it takes,
# each literal and each operation rounded to it. Division by zero gives
# an infinity or NaN.

sub main()
  a: F32 = 0.1 * 3.0
  b: F32 = -0.1
  c: F32 = 0.1 + 1
  e: Float = 1.0 / 0.0
  f: Float = 5.5 % 0.0
  g: F32 = 1e30 * 1e8
  print(a, b, c, e, f, g)

# expect:
# 0.3 -0.1 1.1 inf nan 100000000000000000000000000000000000000.0
