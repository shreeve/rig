# A binding that already holds a write borrow (`x: !T`, `!self`, a local
# `w = !v`) calls a `!self` method directly; `!x.m()` is only needed
# on an owned binding.

struct Counter
  n: Int

  sub bump(!self)
    self.n += 1

  sub bump_twice(!self)
    self.bump()
    self.bump()

sub add_three(c: !Counter)
  c.bump()
  c.bump_twice()

sub fill(v: !Vec(Int))
  v.push(1)
  v.push(2)

sub main()
  c = Counter(n: 0)
  add_three(!c)
  !c.bump()
  w = !c
  w.bump()
  print(c.n)
  v: Vec(Int) = Vec()
  fill(!v)
  b = !v
  b.push(3)
  print(v.len, v[2])

# expect:
# 5
# 3 3
