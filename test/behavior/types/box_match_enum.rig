# `match` over a boxed enum, read or written through a borrow of the box.

enum Shape
  circle(r: Int)
  square(s: Int)

fun area(b: ?Box[Shape]) -> Int
  match b
    .circle(r) => 3 * r * r
    .square(s) => s * s

fun name(b: !Box[Shape]) -> String
  match b
    .circle(_) => "circle"
    .square(_) => "square"

sub main
  b = Box(Shape.circle(r: 2))
  match ?b
    .circle(r) => print("circle", r)
    .square(s) => print("square", s)
  print(area(?b), name(!b))
  b = Box(Shape.square(s: 3))
  print(b, area(?b))

# expect:
# circle 2
# 12 circle
# .square(s: 3) 9
