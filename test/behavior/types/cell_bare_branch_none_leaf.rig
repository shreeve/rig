# A Cell member called on a bare Cell that branches, in a loop: an
# optional leaf that is `none`, a name's optional, or a part of a value
# made there. The Cell is addressed at the leaf the value takes, never
# through the address of the branching expression, so the change lands
# in `o`'s Cell or in the made value's slot.
# release

struct WW
  t: Cell[Int]
  v: Cell[Vec[Int]]

fun mkww(n: Int) -> WW
  v: Vec[Int] = Vec()
  !v.push(n)
  WW(t: Cell(n), v: Cell(<v))

fun vec1(n: Int) -> Vec[Int]
  v: Vec[Int] = Vec()
  !v.push(n)
  v

sub go(k: Bool)
  o: Cell[Int]? = Cell(2)
  p: Cell[Vec[Int]]? = Cell(vec1(3))
  for _ in 0..2
    ((none if k else o) ?? mkww(5).t).set(77)
    ((o if k else none) ?? mkww(6).t).set(9)
    ((none if k else p) ?? mkww(7).v)[0] = 9
    ((p if k else none) ?? mkww(8).v).push(4)
  if o as x
    print(x.get())
  if p as y
    print(y.len, y[0])

sub main()
  go(true)
  go(false)

# expect:
# 9
# 3 3
# 77
# 1 9
