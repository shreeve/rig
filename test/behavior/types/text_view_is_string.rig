# The read view of a Text is its bytes, a String: one text view, whether
# written `?t`, bound by a loop or a pattern, passed through a generic
# `?T`, or captured. A `?String` written as a type is that String, so a
# literal goes where one is expected, and `+v` of a String makes a Text.

obj Item
  name: String

enum Slot
  full(item: String)
  empty

fun size(s: ?String) -> Int
  s.len

fun id[T](x: T) -> T
  x

fun first[T](xs: []T) -> T
  xs[0]

fun same[T](a: ?T, b: ?T) -> Bool
  a == b

fun label(s: ?String) -> ?String
  s

fun shout(s: ?String) -> String
  v = +s
  !v.add("!")
  v

sub main()
  t = String("hello")
  v = ?t
  print(size(v), size(?t), size(label("lit")))

  names: List[String] = List()
  !names.push(String("ab"))
  !names.push(String("cde"))
  for x in ?names
    print(size(?x), x == "ab")
  total = 0
  for x, i in ?names
    total += size(?x) + i
  print(total)

  o: String? = String("xyz")
  if ?o as p
    print(size(?p), p)

  slot = Slot.full(item: String("payload"))
  match ?slot
    .full(item) => print(size(?item), item)
    .empty => pass

  held = Item(name: String("held"))
  g: ?String = id(?held.name)
  print(g, same(?t, ?t), same(?t, ?held.name))

  show = |?t| print(t, size(?t))
  show()

  u = shout(v)
  print(u, u.len, v)
  print(v == "hello")
  own = *|+v| print(v, v.len)
  !t.add("?")
  print(t)
  own()

# expect:
# 5 5 3
# 2 true
# 3 false
# 6
# 3 xyz
# 7 payload
# held true false
# hello 5
# hello! 6 hello
# true
# hello?
# hello 5
