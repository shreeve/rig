# A generic declaration holds an owned closure, or a function, as a
# `T`, or in a `List[T]`; a `*T` of plain data is a handle as ever. (A `*T` or `~T` of a function type is rejected:
# test/reject/types/generic_handle_of_function_type.rig.)

fun inc(a: Int) -> Int
  a + 1

obj H[T]
  h: T

obj L[T]
  l: List[T]

obj S[T]
  s: *T

sub main()
  x = H(h: *|a: Int| a + 10)
  print(x.h(2))
  y = H(h: inc)
  print(y.h(2))
  l: L[*fun(Int) -> Int] = L(l: List())
  !l.l.push(*|a: Int| a - 1)
  print(l.l[0](2))
  m: L[fun(Int) -> Int] = L(l: List())
  !m.l.push(inc)
  print(m.l[0](5))
  s = S(s: *4)
  print(s.s)

# expect:
# 12
# 3
# 1
# 6
# 4
