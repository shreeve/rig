# `for x in !xs` writes `xs`, however `xs` was made: a copy, an index
# loop, a field, and a generic body's copy of a parameter.

struct Wrap
  items: [3]Int

fun inc[n: Int](xs: [n]Int) -> [n]Int
  out = xs
  for x in !out
    x += 1
  out

sub main()
  a = [1, 2]
  out = a
  for x in !out
    x += 1
  idx = a
  for x, i in !idx
    x += i * 10
  b = Wrap(items: [1, 2, 3])
  c = b
  for x in !c.items
    x *= 2
  print(a, out, idx, c.items, inc([5, 6, 7]))

# expect:
# [1, 2] [2, 3] [1, 12] [2, 4, 6] [6, 7, 8]
