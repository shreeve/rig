# A view of a Text lends its bytes where a String, or a `(?String)?`, is
# expected, whether written `?t` or returned by a call; a slice of such a
# view is a view without another `?`; `for b in ?t` walks its bytes;
# and a part of a temporary is read through it, as by `get`.

use std.text

obj S
  t: String

  fun get(?self) -> ?String
    ?self.t

obj E
  value: String

fun find(e: ?E, ok: Bool) -> (?String)?
  if ok
    return ?e.value
  none

fun n(p: ?String) -> Int
  text.trim(p).len + p[1..].len

obj W
  s: List[?String]

fun mkw() -> W
  s: List[?String] = List()
  !s.push("lit")
  W(s: <s)

sub main()
  s = S(t: String(" padded "))
  print(text.trim(s.get()), text.trim(s.get()[1..]), n(s.get()))
  e = E(value: String("v"))
  print(find(?e, true) ?? "none", find(?e, false) ?? "none")
  t = String("ab")
  for b in ?t
    print(b)
  bx = ^String("c")
  for b in ?bx
    print(b)
  print(mkw().s.get(0), mkw().s[0])

# expect:
# padded padded 13
# v none
# 97
# 98
# 99
# lit lit
