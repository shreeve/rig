# Vecs, arrays, and slices hold values that own resources, and drop
# each once (Core §5).

obj B
  n: Int

  drop(!self)
    print("drop", self.n)

obj A
  items: [2]C

obj C
  h: *Int

obj Bag
  items: List[Int]

fun total(s: []Bag) -> Int
  n = 0
  for b in s
    n += b.items.len
  n

sub main()
  a = *B(n: 1)
  xs = [<a]
  print(xs.len)
  holder = A(items: [C(h: *1), C(h: *2)])
  print(holder.items[0].h, holder.items[1].h)
  v: List[*B] = List()
  !v.push(*B(n: 2))
  print(v[0..1])
  rows: List[List[Int]] = List()
  bags: List[Bag] = List()
  b: List[Int] = List()
  !b.push(7)
  !bags.push(Bag(items: <b))
  print(rows.len, total(?bags[..]))
  ts = [String("x"), String("y")]
  for t in <ts
    print(t)

# expect:
# 1
# 1 2
# [B(n: 2)]
# 0 1
# x
# y
# drop 2
# drop 1
