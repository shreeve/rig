# The original language showcase: fallible functions return plain
# values, `?input` lends on a view parameter, a compile-time
# parameter specializes the function, and a user type may be named `Bytes`.

obj User
  name: ?String
  id: U64

obj Profile
  name: ?String

obj UserView
  user: ?User
  profile: ?Profile

enum ParseMode
  strict
  loose

obj Ast
  ok: Bool

obj Bytes
  data: Int

fun parseStrict(input: ?Bytes) -> Ast
  Ast(ok: input.data > 0)

fun parseLoose(input: ?Bytes) -> Ast
  Ast(ok: true)

fun add(a: Int, b: Int) -> Int
  a + b

fun loadUser(id: U64) -> User!
  User(name: "Steve", id: id)

fun loadProfile(id: U64) -> Profile!
  Profile(name: "Steve")

# Compile-time specialization: `[mode: ParseMode]` is Zig's `comptime`.
fun parse[mode: ParseMode](input: ?Bytes) -> Ast
  if mode == .strict
    parseStrict(?input)
  else
    parseLoose(?input)

obj Wrap[T]
  value: T

sub main()
  total = add(1, 2)
  print(total)

  user =! loadUser(1)!         # fixed binding of a propagated result
  print(user.name)

  other = <user                # a move: `user` is done

  u = loadUser(7)!
  p = loadProfile(u.id)!
  view = UserView(user: ?u, profile: ?p)
  print(view.user.id)

  bytes = Bytes(data: 0)
  ast = parse[.strict](?bytes)
  print(ast.ok)

  b: Wrap[Int] = Wrap(value: 5)
  print(b.value)

  print(other.id)              # `other` owns the user now

# expect:
# 3
# Steve
# 7
# false
# 5
# 1
