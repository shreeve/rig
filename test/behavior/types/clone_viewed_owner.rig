# Cloning through a view clones the value viewed: `+b` of a `?Bag`
# is a new `Bag`, whose List is a copy of the List `b` views.

obj Bag
  v: List[Int]

  fun n(<self) -> Int
    self.v.len

fun f(b: ?Bag) -> Int
  (+b).n()

sub main()
  v: List[Int] = List()
  !v.push(4)
  b = Bag(v: <v)
  print(f(?b), b.v)

# expect:
# 1 [4]
