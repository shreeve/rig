# A number literal lent where a read view of a number is expected
# (`?1` for a `?Int`) takes the viewed type, as `?"ab"` does for a
# `?String`.

struct Map[K]
  hash: fun(?K) -> U64

  fun slot(?self, k: ?K) -> U64
    self.hash(k) % 16

fun inc(k: ?Int) -> Int
  k + 1

fun mix(b: ?U8, x: ?Float) -> Float
  Float(b) + x

fun hash_int(k: ?Int) -> U64
  U64(k)

sub main()
  print(inc(?1), inc(?-3), mix(?200, ?1.5))
  m = Map[Int](hash: hash_int)
  print(m.slot(?21))

# expect:
# 2 -2 201.5
# 5
