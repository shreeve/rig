# A lane is read with `v[i]`, its index checked like an element's;
# `v.with(i, x)` is a copy with one lane changed, and `v.array()` the
# lanes as an array, which loops and slices take.

fun sum(v: ?Simd[I16, 8]) -> Int
  total = 0
  for x in v.array()
    total += Int(x)
  total

sub main()
  v = Simd[I16, 8]([10, -20, 30, -40, 50, -60, 70, -80])
  print(v[0], v[7])
  i = 3
  print(v[i], v[i + 1], v[U8(5)])
  w = v.with(0, 1).with(i, 4)
  print(w, v)
  print(sum(?v), sum(w))
  a = w.array()
  a[1] = 2
  print(a, Simd[I16, 8](a) == w)
  m = v > 0
  print(m[0], m[1], m.with(1, true).bits())
  k = 2
  for j in 0..4
    k = Int(v.with(j, I16(j))[j]) + k
  print(k)

# expect:
# 10 -80
# -40 50 -60
# [1, -20, 30, 4, 50, -60, 70, -80] [10, -20, 30, -40, 50, -60, 70, -80]
# -40 -5
# [1, 2, 30, 4, 50, -60, 70, -80] [true, false, true, true, true, true, true, true]
# true false 87
# 8
