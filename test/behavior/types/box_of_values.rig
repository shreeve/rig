# A box of a List, an array, or a String is lent as its value (`?b` as a
# `?List[Int]`, `!b` as a `!List[Int]`) and taken apart with `unbox`. It
# prints as its value: a boxed String bare at the top, quoted inside.

sub fill(v: !List[Int])
  !v.push(1)
  !v.push(2)

fun total(v: ?List[Int]) -> Int
  s = 0
  for x in v
    s += x
  s

fun first(a: ?[4]Int) -> Int
  a[0]

sub main()
  b = ^List[Int]()
  fill(!b)
  print(total(?b), b)
  arr = ^[4 of 7]
  print(first(?arr))
  s = ^"hi"
  print(s)
  bs = List[^?String]()
  !bs.push(^"a")
  print(bs)
  v = <b.unbox()
  print(v.len)

# expect:
# 3 [1, 2]
# 7
# hi
# ["a"]
# 2
