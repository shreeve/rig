# A box of a Vec, an array, or a String is lent as its value (`?b` as a
# `?Vec[Int]`, `!b` as a `!Vec[Int]`) and taken apart with `unbox`.

sub fill(v: !Vec[Int])
  !v.push(1)
  !v.push(2)

fun total(v: ?Vec[Int]) -> Int
  s = 0
  for x in v
    s += x
  s

fun first(a: ?[4]Int) -> Int
  a[0]

sub main
  b = Box(Vec[Int]())
  fill(!b)
  print(total(?b), b)
  arr = Box([4 of 7])
  print(first(?arr))
  s = Box("hi")
  print(s)
  v = <b.unbox()
  print(v.len)

# expect:
# 3 [1, 2]
# 7
# "hi"
# 2
