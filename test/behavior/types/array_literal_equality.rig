# An array literal compared with an array takes its element type from
# the other operand, as a number literal does.

sub main()
  xs: [2]U8 = [1, 2]
  fs: [2]Float = [1.0, 2.0]
  grid: [2][2]I32 = [[1, 2], [3, 4]]
  print(xs == [1, 2], [1, 3] != xs, fs == [1, 2], grid == [[1, 2], [3, 4]], xs == [0; 2])

# expect:
# true true true true false
