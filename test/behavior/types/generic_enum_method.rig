# A generic enum can declare instance methods; `is_some` dispatches on
# `Option[Int]` values.

enum Option[T]
  some(value: T)
  nothing

  fun is_some(?self) -> Bool
    match self
      .some => true
      .nothing => false

sub main()
  o1: Option[Int] = .some(value: 1)
  o2: Option[Int] = .nothing
  print(o1.is_some())
  print(o2.is_some())

# expect:
# true
# false
