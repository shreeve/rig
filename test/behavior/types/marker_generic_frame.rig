# A function marked `inline` that is generic over a type has a frame for
# each instance, which the frames of the functions it is inlined into do
# not count: `near_limit` is under 13 MiB without `bump`'s 32 KB, and over
# with it, and runs.

inline fun bump[T](x: T, i: Int) -> T
  t = [4000 of x]
  t[i % 4000]

sub near_limit(i: Int)
  a = [850000 of 1]
  b = [850000 of 2]
  print(bump(7, i) + a[i] + b[i])

sub main()
  near_limit(3)

# expect:
# 10
