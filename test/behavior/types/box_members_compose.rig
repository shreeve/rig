# A box lends the views of its value (Core §4), so member access reaches
# through it: a struct's fields and methods, a List's and a Text's, and
# a Text through a shared handle.

obj S
  n: Int
  t: String

  sub bump(!self)
    self.n += 1

  fun get(?self) -> Int
    self.n

  sub eat(<self)
    print("eat", self.n)

fun read(b: ?^S) -> Int
  b.n + b.get()

sub main()
  b = ^S(n: 1, t: String("x"))
  b.n = 5
  !b.bump()
  !b.t.add("y")
  print(b.n, b.get(), read(?b), b.t)
  v: ^List[Int] = ^List()
  !v.push(3)
  !v.push(4)
  print(v.len)
  bt = ^String("q")
  print(bt.len, bt == "q")
  <b.eat()
  h = *String("abc")
  print(h.len, ?h == "abc")

# expect:
# 6 6 12 xy
# 2
# 1 true
# eat 6
# 3 true
