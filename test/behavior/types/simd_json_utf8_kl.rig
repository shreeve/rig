# std.json's UTF-8 check, Keiser-Lemire ("Validating UTF-8 in less than
# one instruction per byte", 2021), a 16-byte block at a time: three
# nibble lookups find the errors of each byte with the one before it, and
# two saturating subtracts the continuations a 3- or 4-byte lead needs.
type Block = Simd[U8, 16]

BYTE_1_HIGH = Block([0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x80, 0x80, 0x80, 0x80, 0x21, 0x01, 0x15, 0x49])
BYTE_1_LOW = Block([0xE7, 0xA3, 0x83, 0x83, 0x8B, 0xCB, 0xCB, 0xCB, 0xCB, 0xCB, 0xCB, 0xCB, 0xCB, 0xDB, 0xCB, 0xCB])
BYTE_2_HIGH = Block([0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0xE6, 0xAE, 0xBA, 0xBA, 0x01, 0x01, 0x01, 0x01])
# A block that ends the input may not end inside a sequence.
INCOMPLETE = Block([255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 0xEF, 0xDF, 0xBF])

# The 16 bytes of `s` from `at`, zeros past its end.
fun block(s: ?String, at: Int) -> Block
  return s.read[Block](at) if at + 16 <= s.len
  b = Block.splat(0)
  for k in 0..s.len - at
    b = b.with(k, s[at + k])
  b

fun valid(s: ?String) -> Bool
  prev = Block.splat(0)
  err = Block.splat(0)
  i = 0
  while i < s.len : i += 16
    cur = block(s, i)
    b1 = cur.lag[1](prev)
    special = BYTE_1_HIGH.lookup(b1 >> 4) & BYTE_1_LOW.lookup(b1 & 0x0F) & BYTE_2_HIGH.lookup(cur >> 4)
    must23 = ((cur.lag[2](prev) -| 0x60) | (cur.lag[3](prev) -| 0x70)) & 0x80
    err = err | (must23 ^ special)
    prev = cur
  return false if (err != 0).any()
  not (s.len > 0 and s.len % 16 == 0 and (prev > INCOMPLETE).any())

