# An in-place quicksort over a `![]Int`: each half is a reslice of the
# write borrow, passed on to the recursive call.

sub quicksort(s: ![]Int)
  if s.len < 2
    return
  last = s.len - 1
  pivot = s[last]
  i = 0
  j = 0
  while j < last : j += 1
    if s[j] < pivot
      t = s[i]
      s[i] = s[j]
      s[j] = t
      i += 1
  s[last] = s[i]
  s[i] = pivot
  quicksort(!s[..i])
  quicksort(!s[i + 1..])

sub main()
  a = [5, 3, 9, 1, 5, 8, -2, 7, 0, 3]
  quicksort(!a[..])
  print(a)
  v: Vec[Int] = Vec()
  for x in [4, 1, 3, 2]
    !v.push(x)
  quicksort(!v[1..])
  print(v)
  e = [7]
  quicksort(!e[..])
  quicksort(!e[1..])
  print(e)

# expect:
# [-2, 0, 1, 3, 3, 5, 5, 7, 8, 9]
# [4, 1, 2, 3]
# [7]
