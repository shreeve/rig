# `<<%` is a left shift that drops the high bits, as `+%`, `-%`, and `*%` wrap;
# `<<` panics where it would lose them. `<<%=` assigns.

fun shl8(x: U8, n: Int) -> U8
  x <<% n

sub main()
  a: U8 = 0b1100_0001
  print(a <<% 1, a <<% 7, a <<% 0)
  print(shl8(0xFF, 4), shl8(1, 7))
  b: U16 = 0xFFFF
  print(b <<% 8, b <<% 15)
  c: U32 = 0x8000_0001
  print(c <<% 1, c <<% 31)
  d: U64 = 0xFFFF_FFFF_FFFF_FFFF
  print(d <<% 63, d <<% 32)
  e: U128 = 0xFF
  print(e <<% 124)
  s: I8 = 0b0100_0001
  print(s <<% 1, s <<% 7)
  t: I16 = -1
  print(t <<% 15, t <<% 8)
  u: I32 = 0x4000_0000
  print(u <<% 1, u <<% 2)
  v: Int = 3
  print(v <<% 62, v <<% 63, (-1) <<% 63)
  w: I128 = 1
  print(w <<% 127, w <<% 126)
  print(1 <<% 3, 255 <<% 56)
  x: U8 = 0b1000_0001
  x <<%= 1
  print(x)
  x <<%= 7
  print(x)
  y: U16 = 0xABCD
  y <<%= 4
  print(y)
  n: Int = 4
  y <<%= n
  print(y)
  z: U32 = 0xFFFF_FFFF
  print((z <<% 4) >> 4, z <<% 1 + 1, 1 + 1 <<% 2)
  f: U8 = 1
  print(f <<% 1 <<% 1 <<% 1)

# release

