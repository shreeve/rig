# A float literal among the operands makes a literal division a float
# one, in the float type the context expects; integer literals beside it
# are floats.

sub main()
  b: Float = 7.0 / 2
  y: F32 = 1 / 3.0
  c: F32 = -7.0 / 2
  d: Float = 7.0 / 2 + 1
  k: Float =! 7 / 2.0
  print(b, y, c, d, k * 2)
  print(7.0 / 2 * 2)
  r: Float = 7.0 % 2
  print(r)
  print(7 / 2)

# expect:
# 3.5 0.33333334 -3.5 4.5 7.0
# 7.0
# 1.0
# 3
