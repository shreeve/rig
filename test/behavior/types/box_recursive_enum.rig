# A recursive enum holds its children in boxes. `match` reaches a boxed
# enum through a borrow of the box (`match ?e`, or a `?Box[E]`
# parameter), and a payload box is lent on as a borrow of its value.

enum Expr
  num(n: Int)
  add(l: Box[Expr], r: Box[Expr])
  neg(e: Box[Expr])

fun eval(e: ?Box[Expr]) -> Int
  match e
    .num(n) => n
    .add(l, r) => eval(?l) + eval(?r)
    .neg(x) => 0 - eval(?x)

sub main
  e = Box(value: Expr.add(l: Box(value: .num(n: 2)), r: Box(value: Expr.neg(e: Box(value: .num(n: 5))))))
  print(eval(?e))
  match ?e
    .add(l, _) => print("left", eval(?l))
    _ => print("other")

# expect:
# -3
# left 2
