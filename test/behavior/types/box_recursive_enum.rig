# A recursive enum holds its children in boxes. `match` reaches a boxed
# enum through a view of the box (`match ?e`, or a `?^E`
# parameter), and a payload box is lent on as a view of its value.

enum Expr
  num(n: Int)
  add(l: ^Expr, r: ^Expr)
  neg(e: ^Expr)

fun eval(e: ?^Expr) -> Int
  match e
    .num(n) => n
    .add(l, r) => eval(?l) + eval(?r)
    .neg(x) => 0 - eval(?x)

sub main()
  e = ^Expr.add(l: ^.num(n: 2), r: ^Expr.neg(e: ^.num(n: 5)))
  print(eval(?e))
  match ?e
    .add(l, _) => print("left", eval(?l))
    _ => print("other")

# expect:
# -3
# left 2
