# A boxed value holding a Cell changes through any path to it, and a
# Cell can hold a box.

struct C
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

fun peek(b: ?Box[C]) -> Int
  b.hit()
  b.hits.get()

sub main
  b = Box(value: C(hits: Cell(value: 0)))
  b.hit()
  print(peek(?b))
  cell: Cell[Box[C]] = Cell(value: Box(value: C(hits: Cell(value: 5))))
  old = cell.replace(Box(value: C(hits: Cell(value: 7))))
  print(old.hits.get())

# expect:
# 2
# 5
