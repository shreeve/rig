# A write call whose value is used, here a `Bool`, is written
# `(!s).add(x)`: in a binding, an argument, a return value, a body's
# value, a condition. The short form `!s.add(x)` stays for a call whose
# value is discarded: a statement, alone or under `!` or `catch`.

struct Set
  items: Vec[Int]
  fun insert(!self, k: Int) -> Bool
    for x in ?self.items
      return false if x == k
    !self.items.push(k)
    true
  fun checked(!self, k: Int) -> Bool!
    (!self).insert(k)

fun add(s: !Set, k: Int) -> Bool
  return (!s).insert(k)

fun again(s: !Set, k: Int) -> Bool
  (!s).insert(k)

fun fill(s: !Set) -> Int!
  added = (!s).checked(3)!
  !s.checked(5)!
  !s.checked(5) catch false
  1 if added else 0

sub main()
  set = Set(items: Vec())
  fresh = (!set).insert(1)
  print(fresh)
  print((!set).insert(1))
  print(add(!set, 2), again(!set, 2))
  print(fill(!set) catch 0)
  if (!set).insert(4) and not (!set).insert(4)
    print("long form")
  !set.insert(6)
  print(set.items.len)

# expect:
# true
# false
# true false
# 1
# long form
# 6
