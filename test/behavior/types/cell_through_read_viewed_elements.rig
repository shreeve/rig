# A shared Cell changes by a marked call through any path to it, a handle
# in an element of a write-viewed List, array, or slice included: through a field of the
# element, the element itself, an element of an element, and a field's
# List.
# release

obj C
  c: Cell[Int]

obj H
  cs: List[*C]

sub bump(a: ![2]*C, s: ![]*C, v: !List[*C], w: !List[*Cell[Int]], m: !List[List[*C]], h: !H)
  !a[0].c.set(10)
  !s[0].c.set(20)
  !v[0].c.set(30)
  !w[0].set(40)
  !m[0][0].c.set(50)
  !h.cs[0].c.set(60)

sub main()
  a = [*C(c: Cell(1)), *C(c: Cell(2))]
  v: List[*C] = List()
  !v.push(*C(c: Cell(3)))
  sl: List[*C] = List()
  !sl.push(*C(c: Cell(4)))
  w: List[*Cell[Int]] = List()
  !w.push(*Cell(5))
  m: List[List[*C]] = List()
  row: List[*C] = List()
  !row.push(*C(c: Cell(6)))
  !m.push(<row)
  hs: List[*C] = List()
  !hs.push(*C(c: Cell(7)))
  h = H(cs: <hs)
  bump(!a, !sl[..], !v, !w, !m, !h)
  print(a[0].c.get(), sl[0].c.get(), v[0].c.get(), w[0].get(), m[0][0].c.get(), h.cs[0].c.get())

# expect:
# 10 20 30 40 50 60
