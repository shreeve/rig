# `Cell[T]`, `Signal[T]`, and `Vec[T]` hold plain data: a struct, an
# enum, an optional, or an array that owns nothing; `get` returns a
# copy.

struct Point
  x: Int
  y: Int

enum Color
  red
  green

enum Shape
  dot
  circle(r: Int)

sub main()
  p: *Cell[Point] = *Cell(Point(x: 1, y: 2))
  q = p.get()
  p.set(Point(x: q.x + 10, y: q.y))
  print(p.get().x, q.x)
  old = p.replace(Point(x: 0, y: 0))
  print(old.x, p.get().y)

  c: *Cell[Color] = *Cell(Color.red)
  d = +c
  d.set(.green)
  print(c.get() == .green)

  sh: *Cell[Shape] = *Cell(Shape.circle(r: 3))
  match sh.get()
    .circle(r) => print("circle", r)
    .dot => print("dot")

  o: *Cell[Int?] = *Cell(none)
  print(o.get())
  o.set(4)
  print(o.get() ?? 0)

  a: *Cell[[3]Int] = *Cell([1, 2, 3])
  arr = a.get()
  a.set([arr[2], arr[1], arr[0]])
  print(a.get()[0], arr[0])

  vs: Vec[[2]Int] = Vec()
  !vs.push([1, 2])
  print(vs[0][1], vs.get(1) == none)

  sig: *Signal[Point] = *Signal(Point(x: 0, y: 0))
  sig.subscribe(*|~sig|
    if sig.upgrade() as s
      print("moved to", s.get().x, s.get().y)
  )
  sig.set(Point(x: 5, y: 6))
  mode: *Signal[Color?] = *Signal(none)
  mode.set(Color.red)
  print(mode.get() == Color.red)

# expect:
# 11 1
# 11 0
# true
# circle 3
# none
# 4
# 3 1
# 2 true
# moved to 5 6
# true
