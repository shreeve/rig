# An owned closure takes and returns plain data (Core sentence 9): a
# plain struct, an array, or an optional of one, as it does a number.

struct P
  x: Int
  y: Int

fun px(o: P?) -> Int
  if o as p
    return p.x
  0

sub main()
  swap = *|p: P| P(x: p.y, y: p.x)
  q = swap(P(x: 1, y: 2))
  print(q.x, q.y)
  k: *fun([2]Int, P?) -> [2]Int = *|a, o| [a[1], px(o)]
  print(k([5, 6], none), k([7, 8], P(x: 9, y: 0)))
  make = *|| P(x: 4, y: 5)
  c = *Cell(make())
  print(c.get().y)

# expect:
# 2 1
# [6, 0] [8, 9]
# 5
