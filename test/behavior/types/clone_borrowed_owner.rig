# Cloning through a borrow clones the value borrowed: `+b` of a `?Bag`
# is a new `Bag`, whose Vec is a copy of the Vec `b` views.

struct Bag
  v: Vec[Int]

  fun n(<self) -> Int
    self.v.len

fun f(b: ?Bag) -> Int
  (+b).n()

sub main()
  v: Vec[Int] = Vec()
  !v.push(4)
  b = Bag(v: <v)
  print(f(?b), b.v)

# expect:
# 1 [4]
