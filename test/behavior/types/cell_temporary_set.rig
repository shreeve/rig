# A Cell member called on a temporary's Cell, or on a Cell that is a
# temporary (`set`, `replace`, `c[i] = e`, `push`, `pop`, `clear`),
# changes it where the temporary is held, as a `?self` method does: the
# statement's slot keeps the temporary, the change lands there, and the
# temporary's `drop` sees it when the statement ends. A value moved out
# with `<` and changed there is a temporary too.
# That holds when the call's arguments run first, and for a value whose
# every branch is made here; a branching value that may be a name's
# changes the Cell where the leaf it takes is.
# release

struct D
  hits: Cell[Int]
  log: Cell[Vec[Int]]

  drop(!self)
    print("drop", self.hits.get(), self.log.len, self.first())

  fun first(?self) -> Int
    self.log.get(0) ?? -1

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

struct H
  d: D

fun made(n: Int) -> D
  D(hits: Cell(n), log: Cell(Vec()))

fun mkh(n: Int) -> H
  H(d: made(n))

fun fresh() -> Cell[Int]
  Cell(3)

fun freshv() -> Cell[Vec[Int]]
  Cell(Vec())

fun logged(n: Int) -> D
  d = made(n)
  d.log.push(0)
  d

fun side(n: Int) -> Int
  print("side", n)
  n

sub direct()
  made(1).hits.set(4)
  print(made(2).hits.replace(5))
  made(3).log.push(7)
  print(made(4).log.pop())
  made(5).log.clear()
  mkh(6).d.hits.set(8)
  made(9).hits.set(side(10))
  fresh().set(4)
  print(fresh().replace(6))
  freshv().push(1)
  logged(12).log[0] = 13
  logged(14).log[side(0)] = side(15)
  b = made(16)
  (<b).hits.set(17)

sub branches(c: Bool)
  a = made(20)
  (a if c else made(21)).hits.set(22)
  (a if not c else made(23)).hits.set(24)
  (made(25) if c else made(26)).hits.set(27)
  (mkh(30) if c else mkh(31)).d.hit()
  print(a.hits.get())

sub main()
  direct()
  branches(true)

# expect:
# drop 4 0 -1
# 2
# drop 5 0 -1
# drop 3 1 7
# none
# drop 4 0 -1
# drop 5 0 -1
# drop 8 0 -1
# side 10
# drop 10 0 -1
# 3
# drop 12 1 13
# side 15
# side 0
# drop 14 1 15
# drop 17 0 -1
# drop 24 0 -1
# drop 27 0 -1
# drop 31 0 -1
# 22
# drop 22 0 -1
