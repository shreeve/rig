# A consuming method of a boxed value takes the value out of the box,
# which is freed: `<b.eat()` on a binding, or on a box a call returns.

obj R
  n: Int

  drop(!self)
    print("drop", self.n)

  sub eat(<self)
    print("eat", self.n)

fun mk() -> ^R
  ^R(n: 2)

sub main()
  b = ^R(n: 1)
  <b.eat()
  mk().eat()

# expect:
# eat 1
# drop 1
# eat 2
# drop 2
