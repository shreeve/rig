# A payload variant may be named through its enum: `Shape.circle(r: 2)`.

enum Shape
  circle(r: Int)
  rect(w: Int, h: Int)
  dot

fun area(s: Shape) -> Int
  match s
    .circle(r) => 3 * r * r
    .rect(w, h) => w * h
    .dot => 0

sub main()
  a = Shape.circle(r: 2)
  b = Shape.rect(w: 2, h: 5)
  c = Shape.dot
  print(area(a), area(b), area(c))

# expect:
# 12 10 0
