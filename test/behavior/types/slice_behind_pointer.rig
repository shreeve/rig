# An array behind a pointer (a write-borrowed parameter, a Vec's buffer)
# is not the function's copy, so a slice of it can be returned.

struct S
  arr: [3]Int

fun head(xs: ![3]Int) -> []Int
  ?xs[0..2]

fun second(v: ?Vec(S)) -> Int
  s = ?v[0].arr[0..2]
  s[1]

fun tail(v: ?Vec(S)) -> []Int
  ?v[0].arr[1..3]

sub main()
  a = [1, 2, 3]
  print(head(!a))
  v: Vec(S) = Vec()
  (!v).push(S(arr: [4, 5, 6]))
  (!v).push(S(arr: [7, 8, 9]))
  print(second(?v), tail(?v), ?v[1].arr[0..1])

# expect:
# [1, 2]
# 5 [5, 6] [7]
