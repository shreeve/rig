# A value may take up to 8 MiB, and a function may keep up to 16 MiB of
# values on its stack: an array local, a struct, and a module constant
# at the limit all run, and so does a function keeping 12 MiB.

BIG =! [1048576 of 7]
HALF =! [524288 of 1]

struct Frame
  a: [524288]Int
  b: [524288]Int

sub array_local(i: Int)
  a = [1048576 of 3]
  a[i] += BIG[i]
  print(a[i], a.len)

sub struct_local(i: Int)
  f = Frame(a: HALF, b: HALF)
  f.b[i] += f.a[i]
  print(f.b[i], f.a.len + f.b.len)

sub two_locals(i: Int)
  a = [786432 of 1]
  b = [786432 of 2]
  b[i] += a[i]
  print(b[i], a.len + b.len)

sub main()
  array_local(5)
  struct_local(1048575 - 524288)
  two_locals(786431)

# expect:
# 10 1048576
# 2 1048576
# 3 1572864
