# `==` and `!=` compare optionals of equatable types: two present values
# compare as the values do (Strings by contents), and `none` equals only
# `none`.

enum Color
  red
  green

fun find(key: Int) -> String?
  if key == 1
    return "one"
  none

fun pick(n: Int) -> Color?
  if n == 1
    return .green
  none

fun num(n: Int) -> Int?
  if n == 1
    return 5
  none

sub main()
  a = find(1)
  b = find(2)
  s = "one"
  print(a == "one", a == s, a != "two", a == none)
  print(b == none, b != none, b == "one", a == b, b == find(3))
  print(pick(1) == .green, pick(2) == none, pick(1) == pick(2), num(1) == 5, num(2) == num(3))

# expect:
# true true true false
# true false false false true
# true true false true true
