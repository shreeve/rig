# The forms the hints of test/reject/types/weak_in_box_upgrade_hint.rig
# suggest: a weak handle held in a box, or behind a handle, is lent out
# and upgraded.

struct S
  n: Int

fun f(a: ?Box[~S]) -> Int
  w: ?~S = ?a
  if w.upgrade() as s
    return s.n
  0

sub main
  h = *S(n: 1)
  a: Box[~S] = Box(~h)
  w: ?~S = ?a
  if w.upgrade() as s
    print(s.n)
  b: Box[Box[~S]] = Box(Box(~h))
  v: ?~S = ?b
  if v.upgrade() as s
    print(s.n + 1)
  c: *~S = *(~h)
  u: ?~S = ?c
  if u.upgrade() as s
    print(s.n + 2)
  print(f(?a))

# expect:
# 1
# 2
# 3
# 1
