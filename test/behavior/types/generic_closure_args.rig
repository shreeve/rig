# A closure literal passed to a generic function is checked after the
# other arguments: they bind `T`, the literal's parameters take the
# types that gives them, and a type parameter only the literal's result
# mentions (`U` in `map`) takes the type of its body. The callable is
# passed down a generic chain as it is. Inside a generic body, a literal
# may move in a `T`, dropped when the call returns, and a callable
# taking a `?T` is passed one.

struct Res
  id: Int

  drop(!self)
    print("drop", self.id)

fun sort[T](xs: ![]T, less: ?fun(?T, ?T) -> Bool)
  i = 1
  while i < xs.len : i += 1
    j = i
    while j > 0 and less(?xs[j], ?xs[j - 1]) : j -= 1
      !xs.swap(j, j - 1)

fun sort_by[T](xs: ![]T, less: ?fun(?T, ?T) -> Bool)
  sort(xs, less)

fun sort_twice[T](xs: ![]T, less: ?fun(?T, ?T) -> Bool)
  sort_by(xs, less)
  sort_by(xs, less)

fun map[T, U](xs: []T, f: ?fun(?T) -> U) -> Vec[U]
  out: Vec[U] = Vec()
  for x in xs
    !out.push(f(?x))
  out

fun map_view[T, U](xs: ?[]T, f: ?fun(?T) -> U) -> Vec[U]
  map(xs, f)

fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

fun hold[T](x: T) -> Int
  apply(|<x, a| a + 1, 1)

fun peek[T](x: ?T, f: ?fun(?T) -> Int) -> Int
  f(x)

fun look[T](x: T) -> Int
  n = peek(?x, |v| 7)
  n

sub main
  v: Vec[Int] = Vec()
  !v.push(3)
  !v.push(1)
  !v.push(2)
  sort(!v[..], |a, b| a < b)
  print(v)
  names = ["bob", "ada", "cy"]
  sort(!names[..], |a, b| a < b)
  print(names)
  calls = 0
  sort_twice(!names[..], |!calls, a, b|
    calls += 1
    a > b)
  print(names, calls > 0)
  lens = map(?names[..], |s| s.len * 10)
  print(lens)
  big = map(?v[..], |n| n > 1)
  print(big)
  s = ?v[..]
  halves = map_view(?s, |n| Float(n) / 2)
  print(halves)
  print(hold(Res(id: 1)), hold(5))
  print(look(Res(id: 2)))

# expect:
# [1, 2, 3]
# ["ada", "bob", "cy"]
# ["cy", "bob", "ada"] true
# [20, 30, 30]
# [false, true, true]
# [0.5, 1.0, 1.5]
# drop 1
# 2 2
# drop 2
# 7
