# A module constant may pick a branch on a constant condition, as a local
# `=!` constant may; it folds, so a type can use it as an array length.

N = 3
D = 4 if N > 2 else 2
S = "big" if N > 2 else "small"
F = 1.5 if N > 9 else 0.5 if N > 2 else 0.25

sub main()
  d: [D]Int = [D of 3]
  print(D, d.len, S, F)

# expect:
# 4 4 big 0.5
