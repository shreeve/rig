# A boxed value's data field named `unbox` (the box's
# own `unbox` is only called), and `match` on each boxed enum a loop
# walks by viewed slot.

obj R
  n: Int

obj P
  unbox: Int

enum Sh
  c(r: Int)
  s(k: Int)

sub main()
  b = ^P(unbox: 4)
  print(b.unbox)
  p = <b.unbox()
  print(p.unbox)
  v: List[^Sh] = List()
  !v.push(^Sh.s(k: 3))
  !v.push(^Sh.c(r: 2))
  for x in ?v
    match x
      .c(r) => print("c", r)
      .s(k) => print("s", k)

# expect:
# 4
# 4
# s 3
# c 2
