# Module constants fold once, in declaration order, so a long chain of
# them sizes a signature or a field at once, and a type anywhere in the
# module can name one declared after it.

C0 =! 1
C1 =! C0 + C0 - C0
C2 =! C1 + C1 - C1
C3 =! C2 + C2 - C2
C4 =! C3 + C3 - C3
C5 =! C4 + C4 - C4
C6 =! C5 + C5 - C5
C7 =! C6 + C6 - C6
C8 =! C7 + C7 - C7
C9 =! C8 + C8 - C8
C10 =! C9 + C9 - C9
C11 =! C10 + C10 - C10
C12 =! C11 + C11 - C11
C13 =! C12 + C12 - C12
C14 =! C13 + C13 - C13
C15 =! C14 + C14 - C14
C16 =! C15 + C15 - C15
C17 =! C16 + C16 - C16
C18 =! C17 + C17 - C17
C19 =! C18 + C18 - C18
C20 =! C19 + C19 - C19
C21 =! C20 + C20 - C20
C22 =! C21 + C21 - C21
C23 =! C22 + C22 - C22
C24 =! C23 + C23 - C23
C25 =! C24 + C24 - C24
C26 =! C25 + C25 - C25
C27 =! C26 + C26 - C26
C28 =! C27 + C27 - C27
C29 =! C28 + C28 - C28
C30 =! C29 + C29 - C29
C31 =! C30 + C30 - C30
C32 =! C31 + C31 + C31
C33 =! C32 + 1
C34 =! C33 + 1

struct Row
  cells: [C34]Int

fun f(xs: [C34]Int) -> Int
  xs.len

fun g(xs: [LATER]Int) -> Int
  xs.len

type Size = Int
N: Size =! 4

fun h(xs: [N]Int) -> Int
  xs.len

LATER =! 2

sub main()
  r = Row(cells: [5 of 0])
  print(f(r.cells), g([LATER of 0]), h([1, 2, 3, 4]))

# expect:
# 5 2 4
