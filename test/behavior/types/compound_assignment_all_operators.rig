# Every binary arithmetic, bitwise, and shift operator has a compound
# assignment `x op= e`, on names, fields, elements, and write-borrowed
# parameters. The place is evaluated once.

struct P
  n: Int

sub twiddle(c: !Int)
  c <<= 2
  c |= 1

fun pick(i: Int) -> Int
  print("pick", i)
  i

sub main()
  x = 100
  x %= 7
  print(x)
  x <<= 3
  print(x)
  x >>= 1
  print(x)
  x &= 12
  print(x)
  x |= 3
  print(x)
  x ^= 5
  print(x)
  x /= 2
  print(x)
  y = -7
  y %= 2
  print(y)
  f = 7.5
  f %= 2.0
  print(f)
  u: U8 = 200
  u >>= 3
  print(u)
  p = P(n: 6)
  p.n %= 4
  p.n <<= 4
  p.n ^= 1
  print(p.n)
  xs = [1, 2, 3]
  xs[pick(1)] <<= 3
  xs[pick(2)] %= 2
  print(xs)
  c = 3
  twiddle(!c)
  print(c)
  i = 0
  while i < 40 : i <<= 1
    i |= 1
    print(i)

# expect:
# 2
# 16
# 8
# 8
# 11
# 14
# 7
# -1
# 1.5
# 25
# 33
# pick 1
# pick 2
# [1, 16, 1]
# 13
# 1
# 3
# 7
# 15
# 31
