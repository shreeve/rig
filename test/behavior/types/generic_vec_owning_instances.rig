# `List[T]` in a generic type holds whatever each instance gives it.

struct Stack[T]
  items: List[T]

struct Owner
  h: *Int

sub main()
  s: Stack[List[Int]] = Stack(items: List())
  o: Stack[Owner] = Stack(items: List())
  !o.items.push(Owner(h: *3))
  print(s.items.len, o.items.len)

# expect:
# 0 1
