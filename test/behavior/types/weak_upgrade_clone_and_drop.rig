# The `*T?` from `upgrade()` is an owning handle: `+m` clones it, `drop m`
# drops it, and the clone keeps the value alive until it goes.

struct Noisy
  id: Int

  drop(!self)
    print(self.id)

sub main()
  rc = *Noisy(id: 1)
  w = ~rc
  m = w.upgrade()
  n = +m
  drop rc
  drop m
  print("n alive")
  drop w
  # scope exit drops `n`, the last strong handle: prints 1

# expect:
# n alive
# 1
