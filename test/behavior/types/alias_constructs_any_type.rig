# An alias names its type in every role: a call through an alias of a
# generic instance, of `List`, `Cell`, or `Signal`, constructs a
# value of it, as naming the instance does, and one through an alias of
# a number type converts to it. An alias of a float type names its
# limits, which a default value may be.

obj Wrap[T]
  v: T

  fun make(n: T) -> Wrap[T]
    Wrap(v: n)

enum Mode
  a
  b(n: Int)

type IW = Wrap[Int]
type IV = List[Int]
type IC = Cell[Int]
type IS = Signal[Int]
type M = Mode
type Real = F32
type Small = I8

obj D
  hi: Real = Real.max
  lo: Real = Real.min

fun low(x: Real = Real.min) -> Bool
  x < -3.0e38

sub main()
  w = IW(v: 3)
  u = IW.make(4)
  v = IV(capacity: 2)
  e: IV = IV()
  c = *IC(5)
  s = *IS(7)
  m = M.b(n: 8)
  print(w.v, u.v, v.len, e.len, c.get(), s.get())
  match m
    .b(n) => print(n, M.a == Mode.a)
    .a => print("a")
  d = D()
  print(d.hi > 3.0e38, d.lo < -3.0e38, low(), Real(2), Small(-5), Small.min)

# expect:
# 3 4 0 0 5 7
# 8 true
# true true true 2.0 -5 -128
