# A Cell change through a value that branches with a leaf a name holds
# reaches the leaf it takes: the name's value where it is, or a value made
# in the statement, which lives in the statement's slot. The made values
# here have no `drop` and constant fields, which Zig would otherwise keep
# in read-only memory; each change must land, and be seen within the
# statement and by the value's binding after it. Every branching kind:
# `if` either way round, `??`, `catch`, a part of a made value, a part of
# a branching value, and a bare Cell.
# release

struct C
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

  fun me(?self) -> ?C
    self.c.set(self.c.get() + 1)
    self

  fun bumped(?self) -> Int
    self.c.set(self.c.get() + 1)
    self.c.get()

struct W
  inner: C

struct P
  c: Cell[Int]
  pad: [16]Int

  fun me(?self) -> ?P
    self.c.set(self.c.get() + 1)
    self

error E
  bad

fun mkc(n: Int) -> C
  C(c: Cell(n))

fun mkf(n: Int) -> C!
  return E.bad if n < 0
  C(c: Cell(n))

fun mkp(n: Int) -> P
  P(c: Cell(n), pad: [16 of n])

fun both(x: ?P, y: ?P) -> Int
  x.c.get() * 1000 + x.pad[15] * 100 + y.c.get()

fun fresh(n: Int) -> Cell[Int]
  Cell(n)

fun gen[T](x: Cell[T], k: Bool, v: T, w: T) -> T
  (x if k else Cell(v)).set(w)
  x.get()

sub ifs(k: Bool)
  a = mkc(1)
  (a if k else C(c: Cell(2))).c.set(5)
  print((a if k else C(c: Cell(3))).c.replace(6))
  print((a if k else C(c: Cell(4))).bumped())
  print((a if k else mkc(5)).bumped())
  print((C(c: Cell(7)) if k else a).bumped())
  print((a if k else C(c: Cell(8))).me().c.get())
  print(a.c.get())

sub fallbacks(k: Bool)
  a = mkc(1)
  o: C? = none
  o = mkc(10) if k
  (o ?? C(c: Cell(2))).c.set(5)
  print((o ?? C(c: Cell(3))).bumped())
  (mkf(-1) catch C(c: Cell(4))).hit()
  print((mkf(-1) catch a).bumped(), (mkf(6) catch a).bumped())
  print(a.c.get())
  if o as x
    print(x.c.get())

sub parts(k: Bool)
  w = W(inner: C(c: Cell(1)))
  (w.inner if k else W(inner: C(c: Cell(4))).inner).c.set(6)
  (w if k else W(inner: C(c: Cell(4)))).inner.hit()
  print((w if k else W(inner: C(c: Cell(4)))).inner.bumped())
  print(w.inner.c.get())

sub views(k: Bool)
  a = mkp(1)
  b = mkp(2)
  print(both((a if k else mkp(5)).me(), (b if k else mkp(7)).me()))
  print((a if k else P(c: Cell(3), pad: [16 of 3])).me().c.get())

sub cells(k: Bool)
  x = Cell(1)
  (x if k else fresh(2)).set(5)
  print((x if k else fresh(3)).replace(6))
  (x if k else Cell(4)).set(7)
  print(x.get(), gen(Cell(1), k, 2, 3))

sub main()
  ifs(false)
  ifs(true)
  fallbacks(false)
  fallbacks(true)
  parts(false)
  parts(true)
  views(false)
  views(true)
  cells(false)
  cells(true)

