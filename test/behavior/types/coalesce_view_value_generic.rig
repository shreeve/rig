# A generic body's `m.get(k) ?? d`, with `d: T`, copies the `T` the view
# reaches out, so each instance's `T` must copy: `Int` and a plain
# object do.

use std.hash

obj P
  x: Int

fun lookup[T](m: ?hash.Map[String, T], k: ?String, d: T) -> T
  m.get(k) ?? d

fun first_or[T](v: ?List[T], d: T) -> T
  head(v) ?? d

fun head[T](v: ?List[T]) -> (?T)? from v
  return none if v.len == 0
  ?v[0]

sub main()
  m = hash.Map[String, Int]()
  !m.put(String("a"), 3)
  q = hash.Map[String, P]()
  !q.put(String("a"), P(x: 7))
  print(lookup(?m, "a", 0), lookup(?m, "b", 1), lookup(?q, "a", P(x: 0)).x, lookup(?q, "b", P(x: 9)).x)
  e: List[Int] = List()
  print(first_or(?e, 4))
  !e.push(5)
  print(first_or(?e, 4))

# expect:
# 3 1 7 9
# 4
# 5
