# A slice argument is lent to read the way its name is: `total(w[1..3])`
# is `total(?w[1..3])`, of an array, a Vec, a Text, a field, and a write
# view, where a `[]T`, a String, or an optional of one goes: a function,
# a method, a nested call, a closure, and a generic function. The slice
# keeps what it slices lent while its view is used, as `?w[1..3]` does.
# release

fun total(xs: []Int) -> Int
  n = 0
  for x in xs
    n += x
  n

fun count(xs: ([]Int)?) -> Int
  if xs as s
    s.len
  else
    -1

fun size(s: String) -> Int
  s.len

fun head(s: String?) -> String
  s ?? "none"

fun first[T](xs: []T) -> T
  xs[0]

fun echo[T](x: T) -> T
  x

fun keep(xs: []Int) -> []Int
  xs

struct Bag
  items: Vec[Int]
  name: Text

  fun sum(?self, xs: []Int) -> Int
    total(xs) + self.items.len

sub zero(v: !Vec[Int], w: ![]Int)
  print(total(v[1..]), total(w[..1]), count(w[1..]))
  !v.push(total(v[..]))
  w[0] = 0

sub main()
  a = [1, 2, 3, 4]
  v: Vec[Int] = Vec()
  !v.push(10)
  !v.push(20)
  t = Text("hello")
  b = Bag(items: Vec(), name: Text("bag"))
  !b.items.push(7)
  f = |xs: []Int| total(xs) * 2
  print(total(a[1..3]), total(v[..]), total(b.items[..]), count(a[..2]))
  print(size(t[1..]), head(t[..2]), size(b.name[1..]), echo(t[..3]))
  print(b.sum(a[2..]), total(keep(a[..2])), f(v[1..]), first(a[3..]))
  zero(!v, !a[1..])
  print(v, a)
  r = keep(a[..2])
  print(r)
  a[0] = 9
  print(a)

# expect:
# 5 30 7 2
# 4 he 2 hel
# 8 3 40 4
# 20 2 2
# [10, 20, 30] [1, 0, 3, 4]
# [1, 0]
# [9, 0, 3, 4]
