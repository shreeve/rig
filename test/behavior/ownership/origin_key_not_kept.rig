# A call's result carries the loans of only the arguments whose types
# could hold what it views (Core sentence 7): a key, an index, or a
# counter is free again after the call.

struct Item
  n: Int

struct Key
  id: Int

struct Table
  items: [4]Item

  fun get(?self, k: ?Int) -> ?Item
    ?self.items[k]

  fun find(?self, key: ?Key) -> (?Item)?
    for i in 0..4
      if self.items[i].n == key.id
        return ?self.items[i]
    none

fun at(v: ?[4]Item, k: !Int) -> ?Item
  k += 1
  ?v[k - 1]

sub main()
  t = Table(items: [Item(n: 3), Item(n: 5), Item(n: 7), Item(n: 9)])
  k = 1
  r = t.get(?k)
  k = 2
  print(r.n, k)
  key = Key(id: 7)
  if t.find(?key) as hit
    key.id = 0
    print(hit.n, key.id)
  a = [4 of Item(n: 5)]
  i = 0
  s = at(?a, !i)
  i = 3
  print(s.n, i)

# expect:
# 5 2
# 7 0
# 5 3
