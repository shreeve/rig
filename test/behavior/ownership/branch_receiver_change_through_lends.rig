# A method that changes its receiver, through a Cell or a `!self`, called
# on what each branch lends, changes the value the branch takes, also when
# its arguments are evaluated first.

struct Q
  c: Cell[Int]
  n: Int

  fun bump(?self) -> Int
    self.c.set(self.c.get() + 1)
    self.c.get()

  fun bump2(?self, j: Int, k: Int) -> Int
    self.c.set(self.c.get() + j)
    self.c.get()

struct H
  q: Q

struct P
  n: Int

  fun inc(!self) -> Int
    self.n += 1
    self.n

fun g(k: Int) -> Int
  k

sub main
  h1 = H(q: Q(c: Cell(1), n: 1))
  h2 = H(q: Q(c: Cell(10), n: 2))
  c = g(1) == 1
  print((?h1 if c else ?h2).q.bump())
  print((?h1 if c else ?h2).q.bump2(k: g(1), j: g(2)))
  print(h1.q.c.get(), h2.q.c.get())
  a = P(n: 1)
  b = P(n: 2)
  print((!a if c else !b).inc(), (!b if c else !a).inc())
  print(a.n, b.n)

# expect:
# 2
# 4
# 4 10
# 2 3
# 2 3
