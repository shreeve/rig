# A read view of a value that owns resources is held by pointer, so a
# struct, box, or closure holding the view never drops what it views.
# (Owned closures cannot capture views; stack closures can.)

obj Wrap
  v: List[Int]

obj View
  b: ?Wrap

obj Holder
  own: List[Int]
  b: ?Wrap

obj Tracked
  n: Int

  drop(!self)
    print("drop tracked", self.n)

sub main()
  x = Wrap(v: List())
  !x.v.push(41)
  s = *View(b: ?x)
  print(s.b.v[0])
  h = Holder(own: List(), b: ?x)
  print(h.b.v[0])
  vw = View(b: ?x)
  f = |<vw| print("closure", vw.b.v[0])
  f()
  r = ?x
  g = |<r| print("captured", r.v[0])
  g()
  t = *Tracked(n: 7)
  rt = ?t
  k = |<rt| print("handle", rt.n)
  k()
  <k
  print("after", t.n)

# expect:
# 41
# 41
# closure 41
# captured 41
# handle 7
# after 7
# drop tracked 7
