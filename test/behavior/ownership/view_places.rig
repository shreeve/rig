# Assigning a view to a local that holds one points it elsewhere;
# assigning a value writes through it (Core §6).

sub main()
  m = 1
  n = 2
  w = !m
  w = 5
  w = !n
  w = 6
  w2 = !m
  w = <w2
  w = 7
  print(m, n)
  a = [1, 2]
  b = [3, 4]
  s = !a
  s[0] = 9
  s = !b
  s[0] = 8
  print(a, b)

# expect:
# 7 6
# [9, 2] [8, 4]
