# A lent to read array parameter points at the caller's array, so a
# slice or element view of it, or of an array field of a lent to read
# struct, may be returned or stored in the caller's values: it views
# what the parameter views. A local read view of an array is a
# pointer too, so a slice of it may outlive the view.

struct View
  xs: []Int

struct S
  arr: [3]Int

  fun head(?self) -> []Int
    ?self.arr[0..2]

struct Pt
  x: Int

fun f(a: ?[3]Int) -> []Int
  ?a[0..2]

sub keep(v: !View, a: ?[3]Int)
  v.xs = ?a[1..3]

fun field(p: ?S) -> []Int
  ?p.arr[1..3]

fun pick(ps: ?[2]Pt) -> ?Pt
  ?ps[1]

sub main()
  a = [1, 2, 3]
  print(f(?a))
  view = View(xs: ?a[0..1])
  keep(!view, ?a)
  s = S(arr: [4, 5, 6])
  print(view.xs, field(?s), s.head())
  ps = [Pt(x: 7), Pt(x: 8)]
  p = pick(?ps)
  print(p.x)
  t = ?a[0..1]
  if a[0] == 1
    r = ?a
    t = ?r[1..3]
  print(t)

# expect:
# [1, 2]
# [2, 3] [5, 6] [4, 5]
# 8
# [2, 3]
