# A value stored through a `!T` field lands in what that field borrows,
# not further: `o.i = Inner(x: !v2)` writes `inn`, so `v2` needs to
# outlive only `inn`, not the `v` that `inn` borrowed before.

struct Inner
  x: !Vec[Int]

struct Outer
  i: !Inner

sub main
  v: Vec[Int] = Vec()
  if true
    v2: Vec[Int] = Vec()
    inn = Inner(x: !v)
    o = Outer(i: !inn)
    o.i = Inner(x: !v2)
    !o.i.x.push(1)
    !inn.x.push(2)
    print(inn.x)
  print(v.len)

# expect:
# [1, 2]
# 0
