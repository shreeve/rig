# A branching value of write views where the value they see is wanted
# reads that value in each branch (Core §4): a bare name binds it.
# Changing the copy changes neither viewed value.
# oracle: names accept

fun pick() -> Bool
  true

sub names()
  n = 1
  m = 2
  w = !n
  v = !m
  y = w if pick() else v
  y += 10
  print(y)
  print(n, m)

sub main()
  names()

# expect:
# 11
# 1 2
