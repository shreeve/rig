# A value copied out through a write parameter (`k.a = x.s`) views what
# the caller lent, but writes nothing: a view of a local stored in it
# later lands in it alone, not in the caller's value, for a `!H`
# parameter and for the write view a `(!H)?` parameter holds.

obj H
  s: ?String

obj K
  a: ?String
  b: ?String

  sub put(!self, v: ?String) keeps v
    self.b = v

sub plain(w: !H)
  d = String("local")
  k = K(a: w.s, b: "")
  !k.put(?d)
  l: List[?String] = List()
  !l.push(w.s)
  !l.push(?d)
  print(k.a, k.b, l)

sub optional(w: (!H)?)
  d = String("local")
  k = K(a: "", b: "")
  if w as r
    k.a = r.s
  !k.put(?d)
  x = <w ?? return
  l: List[?String] = List()
  !l.push(x.s)
  !l.push(?d)
  print(k.a, k.b, l)

sub main()
  t = String("outer")
  h = H(s: ?t)
  plain(!h)
  optional(!h)
  print(h.s)

# expect:
# outer local ["outer", "local"]
# outer local ["outer", "local"]
# outer
