# A part of a value made in a header that is plain data is read in the
# header, as any value is, and the made value is a temporary that ends
# with the header: literal patterns match it, a copy of it outlives the
# header, and the made value is dropped before the arms run.

struct Noisy
  n: Int

  drop(!self)
    print("drop", self.n)

enum E
  a(n: Int)
  b

struct H
  e: E
  z: Noisy

fun mkh(n: Int) -> H
  H(e: E.a(n: n), z: Noisy(n: n))

struct P
  x: Int
  y: Int

enum Q
  a(p: P, q: ?P)
  b

struct W
  q: Q

struct G
  n: Int

sub main()
  match [1, 2][0]
    1 => print("one")
    _ => print("other")
  match G(n: 3).n
    3 => print("three")
    _ => print("other")
  match mkh(4).e
    .a(n) => print("arm", n)
    .b => pass
  for k in [[5, 6], [7, 8]][1]
    print("k", k)
  base = P(x: 3, y: 4)
  saved = ?base
  match W(q: Q.a(p: P(x: 1, y: 2), q: ?base)).q
    .a(_, q) => saved = q
    .b => pass
  print(saved.x)
  print("end")

# expect:
# one
# three
# drop 4
# arm 4
# k 7
# k 8
# 3
# end
