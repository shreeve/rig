# `+p.a` clones the shared handle held in a field: the clone and the
# field each own a count, and the value is dropped once, when the last
# handle goes.

struct Wrap
  payload: Int

  drop(!self)
    print("drop")

struct Pair
  a: *Wrap

sub main()
  p = Pair(a: *Wrap(payload: 1))
  x = +p.a
  print(x.payload)

# expect:
# 1
# drop
