# A jump out of an assignment's value never reaches its target: the
# view the target reads may point at a local of the scope it leaves, so
# long as nothing uses the view after.
sub main()
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  k = 0
  @out match k
    0
      w[0] = match k
        0
          y: List[Int] = List()
          !y.push(1)
          w = !y[0..1]
          break @out
        _ => 3
    _ => pass
  print(v[0])

# expect:
# 7
