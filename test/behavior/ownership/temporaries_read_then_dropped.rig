# An owning temporary that is only read (a `print` or `String` argument,
# a view lent to a call that keeps none, an `==` operand) is dropped
# when its statement ends, also when the statement fails or leaves
# early; one in a loop's condition, a header, when the condition ends.
# A `match` takes a call's result and drops what its arms leave.

obj Noisy
  id: Int

  drop(!self)
    print("drop", self.id)

enum M
  a(t: String)
  b

error Bad
  no

fun mk() -> M
  M.a(t: String("in m"))

fun len(s: ?String) -> Int
  s.len

fun tlen(t: ?String) -> Int
  t.len

fun fails(x: Int) -> Int!
  if x > 0
    return Bad.no
  x

fun run(x: Int) -> Int!
  print(String("before ", x), fails(x)!)
  0

fun early(o: Int?) -> Int
  print(Noisy(id: 9), o ?? return -1)
  1

sub main()
  n = 3
  print(String("parsed ", n))
  print(len(?String("a", n)), tlen(?String("bc")))
  s = "a"
  print(String("a") == s, s == String("b"))
  match mk()
    .a(t) => print("got", t)
    .b => print("b")
  print(Noisy(id: 1), "x")
  print("after")
  i = 0
  while String(i) != "3"
    i += 1
  print(i)
  print(run(1) catch 7)
  print(early(none), early(2))
  print(List[Int](), *Cell(5), ^String("boxed"))

# expect:
# parsed 3
# 2 2
# true false
# got in m
# Noisy(id: 1) x
# drop 1
# after
# 3
# 7
# drop 9
# Noisy(id: 9) 2
# drop 9
# -1 1
# [] Cell(value: 5) boxed
