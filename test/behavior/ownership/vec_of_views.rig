# A Vec holds views: it holds the loans of every view pushed into it,
# until it is dropped.

struct Bag
  items: Vec[?Int]

sub keep(v: !Vec[?Int], x: ?Int)
  !v.push(x)

sub main()
  a = 1
  b = 2
  v: Vec[?Int] = Vec()
  !v.push(?a)
  keep(!v, ?b)
  print(v[0] + v[1], v)
  for x in v
    print(x)
  <v
  a = 5
  print(a)
  bag = Bag(items: Vec())
  !bag.items.push(?b)
  print(bag.items)
  e = 8
  if true
    !bag.items.push(?e)
  print(bag.items.len)
  s: Vec[[]Int] = Vec()
  arr = [1, 2, 3]
  !s.push(?arr[..2])
  print(s)

# expect:
# 3 [1, 2]
# 1
# 2
# 5
# [2]
# 2
# [[1, 2]]
