# A move in an `if` branch that ends in `return` does not affect the code
# after the `if`.

struct Wrap
  payload: Int

  drop(!self)
    print("drop")

sub eat(rc: *Wrap)
  print(rc.payload)

sub go(c: Bool)
  rc = *Wrap(payload: 1)
  if c
    eat(<rc)
    return
  print(rc.payload + 10)

sub main()
  go(true)
  go(false)

# expect:
# 1
# drop
# 11
# drop
