# A payload holding a write view can be written through under
# `match !h`, and the scrutinee is usable again once the payload binding
# is done. (A read match views the payload, `?Ed`, which only reads.)

struct Wrap
  v: Vec[Int]

struct Ed
  t: !Wrap

enum Hold
  none_
  has(e: Ed)

sub main()
  x = Wrap(v: Vec())
  h: Hold = .has(e: Ed(t: !x))
  match !h
    .has(a)
      !a.t.v.push(1)
      match !h
        .has(b) => !b.t.v.push(2)
        .none_ => print("none")
    .none_
      print("none")
  print(x.v.len)

# expect:
# 2
