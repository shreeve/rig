# Known bug (emit): the ownership checker accepts moving `rc` in a loop
# body and reassigning it before the next iteration, but emit declares
# `rc` as `const` because its reassignment scan does not look into nested
# blocks: "cannot assign to constant".

struct Box
  payload: Int

  drop self: !Box
    print(self.payload)

sub eat(rc: *Box)
  print(rc.payload + 100)

sub main()
  rc = *Box(payload: 1)
  i = 0
  while i < 2
    eat(<rc)
    rc = *Box(payload: i + 10)
    i += 1
  print("end")

# expect:
# 101
# 1
# 110
# 10
# end
# 11
