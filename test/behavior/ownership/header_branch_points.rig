# A header whose subject branches, each leaf a place, one reached through
# a statement temporary the header makes (an index), binds the place of
# the leaf it takes (`storage.headerPoints`): a write through the binding
# lands there, whichever branch is taken.
# release

struct S
  o: Text?

struct H
  f: Vec[S]

fun idx(s: String) -> Int
  s.len - 1

sub main()
  v: Vec[Text?] = Vec()
  !v.push(Text("q"))
  w: Text? = Text("w")
  c = v.len == 1
  if (!v[idx(?Text("a"))] if c else !w) as t
    !t.add("x")
  if (!w if c else !v[idx(?Text("a"))]) as t
    !t.add("x")
  n = 0
  while (!v[idx(?Text("a"))] if c else !w) as t
    !t.add("x")
    break
  h = H(f: Vec())
  !h.f.push(S(o: Text("q")))
  if (!h.f[idx(?Text("a"))].o if c else !w) as t
    !t.add("x")
  if (?v[idx(?Text("a"))] if c else ?w) as t
    print(t)
  arr: [1]Int? = [1]
  m: Int? = 2
  if (!arr[idx(?Text("a"))] if c else !m) as k
    k = 50
  print(v, w, h.f.len, arr, m, n)

# expect:
# qxx
# ["qxx"] wx 1 [50] 2 0
