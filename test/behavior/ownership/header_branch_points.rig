# A header whose subject branches, each leaf a place, one reached through
# a statement temporary the header makes (an index), binds the place of
# the leaf it takes (`storage.headerPoints`): a write through the binding
# lands there, whichever branch is taken.
# release

obj S
  o: String?

obj H
  f: List[S]

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[String?] = List()
  !v.push(String("q"))
  w: String? = String("w")
  c = v.len == 1
  if (!v[idx(?String("a"))] if c else !w) as t
    !t.add("x")
  if (!w if c else !v[idx(?String("a"))]) as t
    !t.add("x")
  n = 0
  while (!v[idx(?String("a"))] if c else !w) as t
    !t.add("x")
    break
  h = H(f: List())
  !h.f.push(S(o: String("q")))
  if (!h.f[idx(?String("a"))].o if c else !w) as t
    !t.add("x")
  if (?v[idx(?String("a"))] if c else ?w) as t
    print(t)
  arr: [1]Int? = [1]
  m: Int? = 2
  if (!arr[idx(?String("a"))] if c else !m) as k
    k = 50
  print(v, w, h.f.len, arr, m, n)

# expect:
# qxx
# ["qxx"] wx 1 [50] 2 0
