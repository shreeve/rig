# A `?self` method that returns a view of its receiver, called on a
# Cell-holding field of a temporary handle, runs on the field where its
# statement's slot keeps the temporary, so the view may be used until the
# statement ends.

obj Q
  c: Cell[Int]
  n: Int

  fun me(?self) -> ?Q
    self

obj H
  q: Q

fun mkh() -> *H
  *H(q: Q(c: Cell(1), n: 42))

sub main()
  print(mkh().q.me().n)

# expect:
# 42
