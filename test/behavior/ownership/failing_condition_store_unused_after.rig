# A condition part or guard may store a view of its binding in an
# outer value that is not used where the failing path goes on.

obj Big
  v: List[Int]

obj View
  b: ?Big

enum O
  some(x: Big)
  nothing

fun put(v: !View, t: ?Big) -> Bool keeps t
  v.b = t
  true

sub viaIf()
  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: Big? = Big(v: List())
  if <o as x and put(!vw, ?x)
    print(vw.b.v.len)
  print("if")

sub viaMatch()
  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: O = .some(x: Big(v: List()))
  match <o
    .some(x) if put(!vw, ?x) => print(vw.b.v.len)
    _ => print("other")
  print("match")

sub viaWhile()
  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: Big? = Big(v: List())
  while <o as x and put(!vw, ?x)
    print(vw.b.v.len)
    return
  print("while")

sub main()
  viaIf()
  viaMatch()
  viaWhile()

# expect:
# 0
# if
# 0
# match
# 0
