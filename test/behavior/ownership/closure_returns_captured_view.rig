# A stack closure may return a captured read view or a moved-in Copy
# value; the result views what the closure holds.

obj Wrap
  v: List[Int]

sub main()
  x = Wrap(v: List())
  !x.v.push(42)
  r = ?x
  s = |<r| r
  out = s()
  print(out.v[0])
  n = 7
  t = |<n| n
  print(t() + t())

# expect:
# 42
# 14
