# A held write view may be lent where a read view is expected. A read
# view of a scalar, or of an optional one, is a copy of the value, so
# the write view is read through there. (A written `!x` there only
# reads, and is rejected: test/reject/ownership/
# ignored_write_lend_read_view.rig.)

fun peek(m: ?(Int?)) -> Int
  m ?? 0

fun twice(n: ?Int) -> Int
  n * 2

sub main()
  x: Int? = 3
  n: Int = 4
  k: Int = 5
  wx = !x
  wn = !n
  wk = !k
  print(peek(wx), twice(wn))
  g: [2]?Int = [wn, wk]
  print(g[0], g[1])

# expect:
# 3 8
# 4 5
