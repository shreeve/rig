# An `if … as` or `while … as` header writes the value inside an
# optional through `!` on the header, takes it with `<`, or reads it
# bare.

struct P
  o: Int?

sub main()
  p = P(o: 3)
  if !p.o as v
    v += 1
  print(p.o ?? 0)
  if !p.o as v
    v += 10
  print(p.o ?? 0)
  while !p.o as v
    v += 1
    if v > 15
      break
  print(p.o ?? 0)
  if <p.o as v
    print(v)
  print(p.o ?? 0)
  o: Int? = 1
  if !o as v
    v += 1
  print(o ?? 0)
  q = P(o: 7)
  if q.o as v
    print(v)

# expect:
# 4
# 14
# 16
# 16
# 0
# 2
# 7
