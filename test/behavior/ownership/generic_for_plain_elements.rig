# A generic body may take the elements of a loop that does not consume
# its collection when each instance is plain data: they are copies.

fun last[T](v: ?List[T], d: T) -> T
  r = <d
  for x in v
    r = <x
  r

fun copyall[T](v: ?List[T]) -> List[T]
  out = List[T]()
  for x in v
    !out.push(<x)
  out

fun first[T](v: ?List[T], d: T) -> T
  for x in v
    return x
  <d

sub main()
  w = List[Int]()
  !w.push(1)
  !w.push(2)
  print(last(?w, 0), first(?w, 0))
  c = copyall(?w)
  print(c.len, c[1], w.len)

# expect:
# 2 1
# 2 2 2
