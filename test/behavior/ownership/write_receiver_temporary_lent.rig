# Each hint `test/reject/ownership/write_receiver_temporary.rig` gives,
# as written: `!` lends the temporary to write (Core sentence 4), which
# its statement keeps in a slot until it ends.

struct S
  n: Int
  inner: T

  sub bump(!self)
    self.n += 1

  fun next(!self) -> Int
    self.n += 1
    self.n

  fun at(!self) -> !Int
    !self.n

struct T
  k: Int

  sub bump(!self)
    self.k += 1

  fun next(!self) -> Int
    self.k += 1
    self.k

struct Wrap[V]
  v: V

  sub bump(!self)
    pass

  fun twice(?self) -> Wrap[V]
    Wrap(v: self.v)

  sub again(?self)
    !(self.twice()).bump()

fun mk() -> S
  S(n: 1, inner: T(k: 0))

sub main()
  c = mk().n == 1
  s = mk()
  !mk().bump()
  !S(n: 1, inner: T(k: 0)).bump()
  print((!mk()).next())
  !(mk() if c else S(n: 2, inner: T(k: 0))).bump()
  !(+s).bump()
  !mk().inner.bump()
  ![T(k: 1), T(k: 2)][0].bump()
  print((!mk()).at() + 1)
  Wrap(v: 1).again()
  print((!(mk() if c else S(n: 5, inner: T(k: 0)))).next(), (![T(k: 1), T(k: 2)][1]).next(), (!(+s)).next())
  print(s.n)

# expect:
# 2
# 2
# 2 3 2
# 1
