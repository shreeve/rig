# A `match` on a value made in its header takes it: a payload that holds
# a Cell is the arm's own, and changes where it is.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

enum E
  a(c: Counter, n: Int)
  b

sub main()
  match E.a(c: Counter(hits: Cell(1)), n: 2)
    .a(c, n)
      c.hit()
      c.hits.set(c.hits.get() + n)
      print(c.hits.get())
    .b => pass

# expect:
# 4
