# A String may view a Text, so a statement `-s` of a String, or of a
# struct or iterator holding Strings, ends the loan it carries: the
# Text may then change.

struct Split
  rest: String

  fun next(!self) -> String?
    return none if self.rest.len == 0
    part = self.rest[..1]
    self.rest = self.rest[1..]
    part

fun split(s: String) -> Split
  Split(rest: s)

struct Pair
  a: String
  b: Int

sub main()
  t = Text("abc")
  s = ?t[..2]
  print(s)
  -s
  !t.add("d")
  it = split(?t)
  if !it.next() as first
    print(first)
  -it
  !t.add("e")
  p = Pair(a: ?t[1..], b: 1)
  print(p.a, p.b)
  -p
  !t.clear()
  lit = "hi"
  -lit
  print(t.len)

# expect:
# ab
# a
# bcde 1
# 0
