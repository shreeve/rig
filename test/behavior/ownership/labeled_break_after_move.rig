# `break :outer` leaves both loops, so a value moved just before it is
# only unavailable after the outer loop, not after the inner one.

struct Box
  payload: Int

  drop(!self)
    print("drop", self.payload)

sub eat(b: *Box)
  print("eat", b.payload)

sub main()
  rc = *Box(payload: 1)
  i = 0
  :outer while i < 3
    j = 0
    while j < 3
      if j == 1
        eat(<rc)
        break :outer
      j += 1
    print(rc.payload)
    i += 1
  print("end")

# expect:
# eat 1
# drop 1
# end
