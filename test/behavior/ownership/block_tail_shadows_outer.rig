# The tail of a value block names the block's own binding, not an outer
# one of the same name: it moves out, and the outer binding stays.
struct R
  n: Int

  drop(!self)
    print("drop", self.n)

sub main()
  c = true
  r = R(n: 7)
  x = if c
    new r = R(n: 1)
    r
  else
    R(n: 2)
  print(x.n, r.n)

# expect:
# 1 7
# drop 1
# drop 7
