# A bare name or place only reads (Core sentence 1): a write view of a
# value that copies, whether a name, a field, or an element holds it,
# reads the value it sees where a value is taken, a plain struct as a
# number does. Changing the copy changes nothing else; assigning one
# write view's place from another writes the value through.

struct P
  x: Int
  y: Int

struct H
  w: !P

fun pick(a: !P, b: !P, first: Bool) -> P
  a if first else b

sub main()
  a = P(x: 1, y: 2)
  b = P(x: 10, y: 20)
  w = !a
  x = w
  x.x = 100
  h = H(w: !b)
  z = h.w
  z.y = 7
  ws: Vec[!P] = Vec()
  q = P(x: 9, y: 9)
  !ws.push(!q)
  e = ws[0]
  e.x = 3
  c = x.x > 0
  u = w if c else h.w
  print(x.x, z.y, e.x, u.y)
  h.w = w
  print(a.x, b.x, b.y, q.x)
  print(pick(!a, !q, false).x)

# expect:
# 100 7 3 2
# 1 1 2 9
# 9
