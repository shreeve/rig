# The forms the payload-view hint names run: a new owner of what a read
# match's payload holds (`+t`), kept in a name declared before the
# match, and a payload moved out (`<t`) of a subject the match takes
# (`match <e`) (`test/reject/ownership/match_payload_view_hint.rig`).

enum E
  a(t: String)
  b

sub main()
  e = E.a(t: String("abc"))
  r = String("x")
  match e
    .a(t) => r = +t
    .b => pass
  print(r)
  s = String("y")
  match <e
    .a(t) => s = <t
    .b => pass
  print(s)

# expect:
# abc
# abc
