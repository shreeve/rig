# release
# A write lend `!x` keeps its write view where the slot's type is one:
# a type spelled with `!T` (also as `(!T)?`), a parameter declared
# `!T`, a write receiver, and a value whose type it gives (an `if`, a
# loop's `break`s). A `?T` slot takes `?n`. Each write below reaches
# the value lent.

struct S
  n: Int

  sub bump(!self)
    self.n += 1

  fun get(!self) -> !Int
    !self.n

fun through[T](x: !T) -> !T
  x

sub add(x: !Int, k: Int)
  x += k

fun read(x: ?Int) -> Int
  x

sub main()
  n = 0
  o: (!Int)? = !n
  if <o as v
    v += 3
  print(n)
  g = through(!n)
  g += 10
  print(n)
  w = through(!n)
  w += 100
  add(!n, 1000)
  print(n, read(?n))
  s = S(n: 1)
  !s.bump()
  q = (!s).get()
  q += 1
  print(s.n)
  add(!n, 1)
  m = 0
  c = n > 0
  b = !n if c else !m
  b += 1
  print(n, m)
  h: !Int = !m
  h += 5
  print(m)
  l = while true
    break !m
  l += 10
  k = for i in 0..3
    break !n if i == 1
  else
    !m
  k += 1
  print(n, m)

# expect:
# 3
# 13
# 1113 1113
# 3
# 1115 0
# 5
# 1116 15
