# A read view held in a field or an element reached through a write view
# (`?Text`, `?Box[Text]`, `?*Text`) is sliced as a value: what it views
# cannot change while its loan lives, which the slice carries, so the
# field or element may be re-pointed while the slice is used.
# release

struct R
  f: ?Text

struct RB
  f: ?Box[Text]

struct RS
  f: ?*Text

sub field(w: !R, u: ?Text)
  s = w.f[1..]
  w.f = u
  print(s)

sub boxed(w: !RB, u: ?Box[Text])
  s = w.f[1..]
  w.f = u
  print(s)

sub shared(w: !RS, u: ?*Text)
  s = w.f[1..]
  w.f = u
  print(s)

sub element(w: !Vec[?Text], u: ?Text)
  s = w[0][1..]
  w[0] = u
  print(s)

sub main()
  t = Text("hello")
  u = Text("other")
  r = R(f: ?t)
  field(!r, ?u)
  print(r.f)
  b = Box(Text("boxed"))
  bu = Box(Text("other"))
  rb = RB(f: ?b)
  boxed(!rb, ?bu)
  h = *Text("shared")
  hu = *Text("other")
  rs = RS(f: ?h)
  shared(!rs, ?hu)
  v: Vec[?Text] = Vec()
  !v.push(?t)
  element(!v, ?u)
  r2 = R(f: ?t)
  w = !r2
  s = w.f[1..]
  w.f = ?u
  print(s, r2.f)

# oracle: field accept
# oracle: boxed accept
# oracle: shared accept
# oracle: element accept
# oracle: main accept
# expect:
# ello
# other
# oxed
# hared
# ello
# ello other
