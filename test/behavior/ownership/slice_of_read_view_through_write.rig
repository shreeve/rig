# A read view held in a field or an element reached through a write view
# (`?String`, `?^String`, `?*String`) is sliced as a value: what it views
# cannot change while its loan lives, which the slice carries, so the
# field or element may be re-pointed while the slice is used.
# release

obj R
  f: ?String

obj RB
  f: ?^String

obj RS
  f: ?*String

sub field(w: !R, u: ?String) keeps u
  s = w.f[1..]
  w.f = u
  print(s)

sub boxed(w: !RB, u: ?^String) keeps u
  s = w.f[1..]
  w.f = u
  print(s)

sub shared(w: !RS, u: ?*String) keeps u
  s = w.f[1..]
  w.f = u
  print(s)

sub element(w: !List[?String], u: ?String) keeps u
  s = w[0][1..]
  w[0] = u
  print(s)

sub main()
  t = String("hello")
  u = String("other")
  r = R(f: ?t)
  field(!r, ?u)
  print(r.f)
  b = ^String("boxed")
  bu = ^String("other")
  rb = RB(f: ?b)
  boxed(!rb, ?bu)
  h = *String("shared")
  hu = *String("other")
  rs = RS(f: ?h)
  shared(!rs, ?hu)
  v: List[?String] = List()
  !v.push(?t)
  element(!v, ?u)
  r2 = R(f: ?t)
  w = !r2
  s = w.f[1..]
  w.f = ?u
  print(s, r2.f)

# oracle: field accept
# oracle: boxed accept
# oracle: shared accept
# oracle: element accept
# oracle: main accept
# expect:
# ello
# other
# oxed
# hared
# ello
# ello other
