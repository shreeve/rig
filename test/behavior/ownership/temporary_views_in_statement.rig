# A view of a temporary, or a view made from one, may be used anywhere
# in its statement: the temporary lives until the statement ends. A
# header is its own statement: the temporaries of an `if` or `while`
# condition end with it, so a view the body uses is made from a Text
# bound to a name first.

use std.text

struct S
  n: Int

fun pick(s: ?S) -> ?Int
  ?s.n

sub main()
  print(text.trim(?Text("  padded  ")) == "padded")
  n = text.find(?Text("abc"), "b") ?? -1
  a = "x"
  b = "yz"
  if text.starts_with(?Text(a, b), "xy")
    print("starts", n)
  i = 0
  while text.find(?Text(i), "3") == none
    i += 1
  print(i, text.trim(?Text(" v ")), ?Text("abcdef")[2..4])
  print(pick(?S(n: 4)) + 1, ?[1, 2, 3][1..])
  kv_text = Text("k=v")
  if text.cut(?kv_text, "=") as kv
    print(kv.before, kv.after)
  j = 0
  while true
    pass_text = Text("pass=", j)
    kw = text.cut(?pass_text, "=") ?? break
    print(kw.after)
    j += 1
    if j == 2
      break

# expect:
# true
# starts 1
# 3 v cd
# 5 [2, 3]
# k v
# 0
# 1
