# Branches are checked independently: a move in the `then` branch does
# not make the value unusable in the `else` branch.

struct Packet
  payload: Int

sub send(p: Packet)
  print(p.payload)

sub run(cond: Bool)
  x = Packet(payload: 42)
  if cond
    send <x
  else
    print(x.payload + 1)

sub main()
  run(true)
  run(false)

# expect:
# 42
# 43
