# A consuming match that binds some fields by name owns them; every
# field it leaves out is dropped once, at the end of the arm, as a `_`
# field is. A read match's view of a field bound by name outlives the
# arm as a positional one does, and a write match writes it in place.
# release

obj B
  n: Int

  drop(!self)
    print("drop", self.n)

enum Bag
  three(a: *B, label: String, xs: List[Int])
  one(b: *B)
  empty

obj Res
  t: String

enum E
  pair(r: Res, k: Int)
  nothing

sub keep(b: *B)
  print("kept", b.n)

fun label(e: ?Bag, d: ?String) -> ?String from e, d
  match e
    .three(label: t) => ?t
    _ => d

fun res(e: ?E, d: ?Res) -> ?Res from e, d
  match e
    .pair(r: r) if r.t.len > 3 => ?r
    .pair(r: r) => r
    .nothing => d

fun take(e: E) -> Res
  match <e
    .pair(k: k) if k > 10 => Res(t: String("big"))
    .pair(r: r) => <r
    .nothing => Res(t: String("none"))

sub main()
  x: Bag = .three(a: *B(n: 1), label: String("one"), xs: List())
  match <x
    .three(a: a)
      keep(<a)
      print("arm end")
    _ => pass
  print("after 1")
  y: Bag = .three(a: *B(n: 2), label: String("two"), xs: List())
  match <y
    .three(xs: v, label: t)
      print(t, v.len)
      print("arm end")
    _ => pass
  print("after 2")
  z: Bag = .three(a: *B(n: 3), label: String("three"), xs: List())
  match <z
    .three(label: t) => print(t)
    _ => pass
  print("after 3")
  w: Bag = .three(a: *B(n: 4), label: String("four"), xs: List())
  match <w
    .three(label: t) if t.len > 9 => print("long")
    .three(xs: v) => print("xs", v.len)
    _ => pass
  print("after 4")
  # A read match's view of a field bound by name, past the arm.
  blank = String("")
  dr = Res(t: String(""))
  g: Bag = .three(a: *B(n: 5), label: String("five"), xs: List())
  print(label(?g, ?blank))
  e: E = .pair(r: Res(t: String("viewed")), k: 1)
  print(res(?e, ?dr).t)
  f: E = .pair(r: Res(t: String("abc")), k: 2)
  print(res(?f, ?dr).t)
  # A write match on owning fields, by name.
  match !g
    .three(label: t, a: a)
      t = String("changed")
      a = *B(n: 6)
    _ => pass
  print(label(?g, ?blank))
  print(take(.pair(r: Res(t: String("taken")), k: 1)).t, take(.pair(r: Res(t: String("x")), k: 20)).t, take(.nothing).t)
  print("end")

# expect:
# kept 1
# drop 1
# arm end
# after 1
# two 0
# arm end
# drop 2
# after 2
# three
# drop 3
# after 3
# xs 0
# drop 4
# after 4
# five
# viewed
# abc
# drop 5
# changed
# taken big none
# end
# drop 6
