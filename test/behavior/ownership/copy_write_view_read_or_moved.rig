# A bare write view of a Copy value is read where its context wants
# the value: a binding, a field or argument of the value's type, a
# `break` value of a loop whose value is read, or a branch of one.
# Where a `!T` goes, it is moved with `<w`.

struct H
  w: !Int

struct P
  x: Int

fun read(n: Int) -> Int
  n

sub copies(w2: !Int, w3: !Int, c: Bool)
  x = w2
  y: Int = w2 if c else w3
  new z = w3
  p = P(x: w2)
  p.x = w3 if c else w2
  u = while true
    break w2
  v = for _ in 0..3
    break w3 if c
  else
    w2
  x += 1
  y += 10
  z += 100
  u += 1000
  v += 1000
  print(x, y, z, p.x, u, v, read(w2), w2, w3)

sub moves(h: !H, w2: !Int, w3: !Int, c: Bool)
  h.w = <w2 if c else <w3
  h.w += 5

sub main
  n = 1
  m = 2
  copies(!n, !m, true)
  k = 0
  h = H(w: !k)
  moves(!h, !n, !m, false)
  print(h.w)

# expect:
# 2 11 102 2 1001 1002 1 1 2
# 7
