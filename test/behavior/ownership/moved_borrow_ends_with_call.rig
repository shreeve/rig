# The loans of a borrow moved into a call end when the call returns, so
# the next statement can write the root again.

struct Box
  v: Vec(Int)

sub show(a: ?Box)
  print(a.v.length())

sub main()
  x = Box(v: Vec())
  (!x.v).push(1)
  r = ?x
  show(<r)
  (!x.v).push(2)
  w = !x
  (!w.v).push(3)
  show(?x)

# expect:
# 1
# 3
