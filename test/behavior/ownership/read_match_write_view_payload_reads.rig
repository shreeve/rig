# A read `match` binds a payload field that is a write view as the read
# view of what it views: it reads through it, in the arm and in a guard,
# for a struct, an Int (copied out), a Vec, and a slice. A match of a
# value made there owns the write view its payload holds and may return
# it, and `match !e` writes through one.
# release

struct P
  t: Text
  n: Int

enum WP
  a(w: !P)
  b

enum WS
  a(s: ![]Int)
  b

enum WI
  a(w: !Int)
  b

enum WV
  a(w: !Vec[Int])
  b

fun wrap(x: !Int) -> WI from x
  .a(w: !x)

fun made(x: !Int, d: !Int) -> !Int from x, d
  match wrap(!x)
    .a(w) => w
    .b => d

fun written(o: !WI, d: !Int) -> !Int from o, d
  match !o
    .a(w) => w
    .b => d

sub main()
  p = P(t: Text("hello"), n: 3)
  e = WP.a(!p)
  match e
    .a(w)
      r = ?w
      s = ?w.t[1..]
      print(r.t, s, w.n, w.t.len)
    .b => pass
  a = [1, 2, 3]
  f = WS.a(!a[..])
  match f
    .a(s)
      print(s[0], s.len, ?s[1..])
      for x in s
        print(x)
    .b => pass
  n = 7
  g = WI.a(!n)
  match g
    .a(w) if w > 5 => print(w + 1)
    .a(w) => print(w)
    .b => pass
  match g
    .a(w)
      k = w + 1
      print(w, k)
    .b => pass
  xs: Vec[Int] = Vec()
  !xs.push(4)
  h = WV.a(!xs)
  match h
    .a(w) => print(w.len, w[0], ?w[..])
    .b => pass
  match !e
    .a(w) => w.n = 9
    .b => pass
  print(p.n)
  k = 1
  d = 2
  m = made(!k, !d)
  m += 10
  print(k)
  o = wrap(!d)
  q = 5
  z = written(!o, !q)
  z += 20
  print(d)

# expect:
# hello ello 3 5
# 1 3 [2, 3]
# 1
# 2
# 3
# 8
# 7 8
# 1 4 [4]
# 9
# 11
# 22
