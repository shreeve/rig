# A temporary array of owners lent as a `[]T` argument with no `?` is
# held and dropped in its statement's slot, as `?[...]` is: nothing
# leaks, also where a later argument runs first or the call is nested.

fun look(s: []String) -> Int
  s[0].len + s.len

fun next(i: !Int) -> Int
  i += 1
  i

fun both(s: []String, k: Int) -> Int
  s.len + k

fun lens(vs: []List[Int]) -> Int
  vs[1].len

fun mka() -> [1]String
  [String("xyz")]

sub main()
  print(look([String("abc")]))
  print(look(?[String("abc")]))
  i = 0
  print(both([String("a"), String("b")], next(!i)))
  print(look([String("ab")]) + look([String("c"), String("d")]))
  v: List[Int] = List()
  !v.push(1)
  print(lens([List(), <v]))
  print(look(mka()))

# expect:
# 4
# 4
# 3
# 6
# 1
# 4
