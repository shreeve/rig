# A loop over an array of values that hold a Cell views each element
# where it is: a change through the binding changes the element, and a
# change to the element shows through the binding.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

struct Wrap
  c: Counter

sub touch(c: ?Cell[Int])
  print(c.get())

fun count(s: []Counter) -> Int
  new t = 0
  for c in s
    c.hit()
    t += c.hits.get()
  t

sub main()
  cells: [2]Cell[Int] = [Cell(1), Cell(2)]
  for x in cells
    x.set(5)
    touch(?x)
  print(cells[0].get(), cells[1].get())
  counters = [Counter(hits: Cell(0)), Counter(hits: Cell(0))]
  for k in counters
    counters[1].hits.set(9)
    k.hit()
    print(k.hits.get())
  wrapped: [1]Wrap = [Wrap(c: Counter(hits: Cell(4)))]
  for w in ?wrapped
    w.c.hit()
    touch(?w.c.hits)
  print(count(?counters[..]), counters[0].hits.get(), counters[1].hits.get())

# expect:
# 5
# 5
# 5 5
# 1
# 10
# 5
# 13 2 11
