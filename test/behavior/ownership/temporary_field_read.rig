# A field that owns nothing is read from an owning temporary where it
# stands; the statement drops the temporary. A `for` over a call's
# result, and `as` over one, take its value.

obj User
  age: Int
  name: String

  drop(!self)
    print("drop user")

fun mv() -> List[Int]
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  v

fun mo() -> String?
  String("opt")

sub main()
  print(String("bye").len, (*User(age: 5, name: String("u"))).age)
  x = User(age: 1, name: String("n")).age
  print(x)
  for n in mv()
    print(n)
  if mo() as t
    print(t.len)
  print("end")

# expect:
# 3 5
# drop user
# drop user
# 1
# 1
# 2
# 3
# end
