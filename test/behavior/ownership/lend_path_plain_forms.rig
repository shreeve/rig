# release
# The forms a lend written as a path's base is written as: the path
# assigned bare (`arr[i] += 7`, `p.a[0] = 3`), the lend on the whole
# path (`if !o[0] as w`, `!qs[1].bump()`, `match !p.e`), for an array, a
# Vec, a field holding an array, a nested path, and a `!` parameter.
# Three forms keep their parentheses, being no lend of a place as a
# path's base: a lend as a method's receiver (`(!s).insert(k)`,
# `(!w).put[2](3)`, `(!t.pickw()).b += 1`), a value that branches,
# whose lends pick the place written (`(!a if c else !b)[0] = 5`), and a
# lend of a slice, which makes the view indexed (`(?t[..])[0]`). Each
# later read shows the write landed.

enum E
  a(n: Int)
  b

struct Set
  items: Vec[Int]

  fun insert(!self, k: Int) -> Bool
    for x in ?self.items
      return false if x == k
    !self.items.push(k)
    true

  sub put[k: Int](!self, x: Int)
    !self.items.push(x * k)

struct Q
  n: Int

  sub bump(!self)
    self.n += 1

struct P
  x: Int
  o: Int?
  e: E
  a: [2]Int
  qs: [2]Q
  s: Set

  fun pickw(!self) -> !Q
    !self.qs[1]

sub set(v: !Vec[Int], q: !P, xs: ![]Int)
  v[0] = 4
  v[0] += 1
  q.a[1] += 10
  q.qs[0].n = 7
  xs[1] *= 3

fun inc(n: !Int) -> Int
  n += 1
  n

sub main()
  arr = [1, 2]
  i = 1
  arr[0] = 7
  arr[i] += 7
  print(arr)
  v: Vec[Int] = Vec()
  !v.push(1)
  v[0] = 9
  v[0] += 1
  print(v)
  o: [2]Int? = [5, none]
  if !o[0] as w
    w += 1
  print(o[0])
  if <o[0] as m
    print(m)
  print(o[0])
  p = P(x: 1, o: 2, e: E.a(n: 1), a: [1, 2], qs: [Q(n: 1), Q(n: 2)], s: Set(items: Vec()))
  p.x = 5
  p.a[0] = 3
  p.qs[0].n += 4
  !p.qs[1].bump()
  print(inc(!p.a[0]), p.x, p.a, p.qs[0].n, p.qs[1].n)
  match !p.e
    .a(n) => n += 10
    .b => pass
  match p.e
    .a(n) => print(n)
    .b => pass
  if !p.o as k
    k += 1
  print(p.o)
  set(!v, !p, !arr)
  print(v, p.a, p.qs[0].n, arr)
  print((!p.s).insert(4), (!p.s).insert(4), p.s.items.len)
  (!p.s).put[2](3)
  (!p).pickw().n = 20
  (!p.pickw()).n += 1
  print(p.s.items, p.qs[1].n)
  a = [1, 2]
  b = [3, 4]
  c = p.x > 0
  (!a if c else !b)[0] = 5
  (!b if c else !a)[1] += 1
  print(a, b)
  r = P(x: 2, o: none, e: E.b, a: [0, 0], qs: [Q(n: 0), Q(n: 0)], s: Set(items: Vec()))
  (!p if c else !r).x += 1
  n = (?p if c else ?r).s.items.len
  print(p.x, r.x, n)
  t = Text("abc")
  print((?t[..])[0], (?arr[1..])[0], (?t[1..]).len)

# expect:
# [7, 9]
# [10]
# 6
# 6
# none
# 4 5 [4, 2] 5 3
# 11
# 3
# [5] [4, 12] 7 [7, 27]
# true false 1
# [4, 6] 21
# [5, 2] [3, 5]
# 6 2 2
# 97 27 2
