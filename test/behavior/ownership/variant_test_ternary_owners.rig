# Testing a branching value against a bare variant reads it, as any
# `==` operand: a name it may be is read where it is, never dropped.
enum Shape
  dot
  line(v: Vec[Int])

sub main
  p: Vec[Int] = Vec()
  !p.push(1)
  a = Shape.line(<p)
  b = Shape.dot
  c = true
  if (a if c else b) != .dot
    print("line")
  match ?a
    .line(v) => print(v[0])
    .dot => print("dot")


# expect:
# line
# 1
