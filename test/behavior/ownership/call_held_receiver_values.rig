# A temporary receiver, or a copy of a Cell-holding part of one, that a
# call holds while it runs: what the method returns that views nothing of
# it, and a view of it the statement discards, are fine.

struct S
  n: Int
  m: Int

  fun me(?self) -> ?S
    self

  fun sum(?self) -> Int
    self.n + self.m

struct Q
  c: Cell[Int]
  n: Int

  fun get(?self) -> Int
    self.c.get() + self.n

struct H
  q: Q

fun mk -> S
  S(n: 5, m: 6)

fun mkh -> H
  H(q: Q(c: Cell(1), n: 41))

sub main
  print(mk().sum())
  print(mkh().q.get())
  print(mk().me().n)
  s = mk()
  print(s.me().m)

# expect:
# 11
# 42
# 5
# 6
