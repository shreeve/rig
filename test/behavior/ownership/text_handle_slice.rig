# A Text reached through a handle is sliced in place: the
# String views the Text the handle shares, and the handle stays lent
# while it is used.

obj W
  t: *String

fun first(s: ?String) -> ?String
  s[0..1]

sub main()
  h = *String("hello")
  s = ?h[1..]
  g = +h
  print(s, first(?g[..]))
  w = W(t: +h)
  u = ?w.t[..2]
  vs: List[*String] = List()
  !vs.push(+h)
  v = ?vs[0][3..]
  print(u, v)
  <h
  print(g)

# expect:
# ello h
# he lo
# hello
