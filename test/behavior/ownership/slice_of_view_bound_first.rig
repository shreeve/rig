# The forms the slice-of-a-view hints write: a view a call returns,
# bound first, then sliced; and a branch of write views, each lent to
# read, then sliced. Each lends what it views until the slice's last use.
# release

fun keep(s: ?String) -> ?String
  s

obj H
  t: String

fun get(h: !H) -> !String
  !h.t

sub f(a: !String, b: !String, c: Bool)
  s = keep((?a if c else ?b)[1..])
  print(s)
  !a.add("x")
  print(a)

sub main()
  h = H(t: String("hello"))
  w = get(!h)
  s = keep(?w[1..])
  print(s)
  !h.t.add("x")
  print(h.t)
  x = String("hello")
  y = String("world")
  f(!x, !y, false)

# oracle: f accept
# oracle: main accept
# expect:
# ello
# hellox
# orld
# hellox
