# `+e` only reads `e`: a branching value's names are read in place, and a
# value made there is a temporary its statement drops.

sub main
  c = true
  t = Text("aa")
  u = Text("bbb")
  w = +(t if c else u)
  print(w, (+(u if c else t)).len)
  p = +Text("made")
  !p.add("!")
  print(p, t, u)

# expect:
# aa 3
# made! aa bbb
