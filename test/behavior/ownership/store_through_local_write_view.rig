# A call may store a view through a write view it is given: the
# store lands in the value the view leads to, which then holds it.

struct In
  n: Int

struct Wrap
  r: ?In

struct View
  b: ?In

sub fill(w: !View, b: ?In)
  w.b = b

sub fill_wrap(t: !Wrap, b: ?In)
  t.r = b

sub main()
  a = In(n: 1)
  y = In(n: 2)
  v = View(b: ?a)
  if true
    w = !v
    fill(!w, ?y)
  print(v.b.n)
  x = Wrap(r: ?a)
  fill_wrap(!x, ?y)
  print(x.r.n)

# expect:
# 2
# 2
