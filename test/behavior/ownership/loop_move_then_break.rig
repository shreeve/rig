# A move followed by `break` leaves the loop, so the rest of the loop
# body and later iterations still see the value.

struct Wrap
  payload: Int

  drop(!self)
    print("drop")

sub eat(rc: *Wrap)
  print(rc.payload)

sub main()
  rc = *Wrap(payload: 42)
  i = 0
  while i < 3
    if i == 1
      eat(<rc)
      break
    print(rc.payload + i)
    i += 1
  print("done")

# expect:
# 42
# 42
# drop
# done
