# `<` always leaves its source done. `<n` ends a local of any type, and
# assigning it makes it usable again; `<s.o` and `<v[i]` of an optional
# take the value and leave `none`, also through a write lend; a field or
# element that copies is copied by a plain read, with no `<`. A part of
# a value made in the statement is done with it, so `<mk().n` copies it
# out.
# oracle: main accept

struct S
  n: Int
  o: Int?

fun mk -> S
  S(n: 7, o: 8)

fun twice(n: Int) -> Int
  n * 2

sub main
  n = 21
  print(twice(<n))
  n = 4
  print(n)
  s = S(n: 1, o: 2)
  m = s.n
  o = <s.o
  print(m, o, s.n, s.o)
  s.o = 3
  t = <(!s).o
  print(t, s.o)
  v: Vec[Int?] = Vec()
  !v.push(5)
  e = <v[0]
  f = v[0]
  print(e, f, v.len)
  print(<mk().n, mk().o)

# expect:
# 42
# 4
# 1 2 1 none
# 3 none
# 5 none 1
# 7 8
