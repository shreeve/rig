# A read match binds a payload that holds a Cell as a view of the field:
# a change through it changes the matched value, in a plain, guarded, or
# lent match.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

enum E
  a(c: Counter, n: Int)
  b

fun make(n: Int) -> E
  .a(c: Counter(hits: Cell(n)), n: n)

sub main()
  e = make(3)
  match e
    .a(c, n) if n > 1 => c.hit()
    .a(c, _) => c.hits.set(0)
    .b => pass
  match ?e
    .a(c, _) => c.hit()
    .b => pass
  match e
    .a(c, n) => c.hits.set(c.hits.get() + n)
    .b => pass
  match make(7)
    .a(c, n) => print(c.hits.get(), n)
    .b => pass
  n = match e
    .a(c, _) => c.hits.get()
    .b => 0
  print(n)

# expect:
# 7 7
# 8
