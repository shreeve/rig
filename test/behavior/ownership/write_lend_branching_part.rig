# A field of a branching temporary (`if`, `??`, `catch`) lent to write
# is written in the statement's slot, never in a copy, whichever site
# lends it: `swap`, `replace`, a write slice of an array field, or a
# receiver whose call evaluates its arguments first (Core sentence 4).

use std.sort

struct K2
  n: Int

  sub put2(!self, a: Int, b: Int)
    self.n = a * 10 + b

struct S
  n: Int
  t: Text
  arr: [3]Int
  kk: K2

  drop(!self)
    print("drop", self.n, self.t, self.arr, self.kk.n)

error Bad
  no

fun f(n: Int) -> Int
  n

fun mk(n: Int) -> S
  S(n: n, t: Text("t", n), arr: [3, 2, 1], kk: K2(n: 0))

fun mko(n: Int) -> S?
  return none if n == 0
  mk(n)

fun mkf(n: Int) -> S!
  return Bad.no if n == 0
  mk(n)

sub main()
  c = f(1) == 1
  k = 30
  swap(!(mk(1) if c else mk(2)).n, !k)
  print(k)
  print(replace(!(mk(3) if c else mk(4)).n, 7))
  swap(!(mko(5) ?? mk(6)).n, !k)
  swap(!(mkf(0) catch mk(7)).n, !k)
  t = Text("mine")
  swap(!(mk(8) if c else mk(9)).t, !t)
  print(t)
  sort.sort(!(mk(10) if c else mk(11)).arr[..])
  sort.sort(!(mk(12) if c else mk(13)).arr[0..2])
  !(mk(14) if c else mk(15)).kk.put2(b: f(2), a: f(3))
  print(k)

# expect:
# drop 30 t1 [3, 2, 1] 0
# 1
# 3
# drop 7 t3 [3, 2, 1] 0
# drop 1 t5 [3, 2, 1] 0
# drop 5 t7 [3, 2, 1] 0
# drop 8 mine [3, 2, 1] 0
# t8
# drop 10 t10 [1, 2, 3] 0
# drop 12 t12 [2, 3, 1] 0
# drop 14 t14 [3, 2, 1] 32
# 7
