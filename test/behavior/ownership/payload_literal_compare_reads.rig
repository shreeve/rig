# `==` with a payload literal reads both operands: a name, or a name a
# branching value may be, is read where it is, and a value made there,
# the literal too, is a temporary the statement drops.
enum S
  dot
  line(v: String)

fun mk(t: ?String) -> S
  .line(v: String(t))

sub main()
  a: S = .line(v: String("a"))
  b: S = .dot
  c = true
  print(a == .line(v: String("a")), (a if c else b) == .line(v: String("a")))
  print(mk("x") == .line(v: String("x")), (b if c else mk("y")) != .line(v: String("y")))
  print(a, b)

# expect:
# true true
# true true
# .line(v: "a") .dot
