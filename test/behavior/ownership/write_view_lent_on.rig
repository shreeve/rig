# Passing a held write view on to a call lends it, written `!w`: the
# result writes through it.

fun id(t: !List[Int]) -> !List[Int]
  t

sub main()
  v: List[Int] = List()
  if true
    w = !v
    r = id(!w)
    !r.push(4)
    s = id(!r)
    !s.push(5)
    t = id(!s)
    !t.push(6)
  print(v.len, v[0], v[2])

# expect:
# 3 4 6
