# Moving a write view into a local moves the view: writes through the
# local reach the caller's value.

obj B
  n: Int

  drop(!self)
    print("drop", self.n)

obj C
  b: *B

sub rep(c: !C)
  x = <c
  x.b = *B(n: 2)

sub main()
  c = C(b: *B(n: 1))
  rep(!c)
  print("after", c.b.n)

# expect:
# drop 1
# after 2
# drop 2
