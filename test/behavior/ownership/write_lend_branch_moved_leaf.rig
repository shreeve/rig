# A value that branches, every leaf of which is made here, `<a` included,
# lent to write: the statement's slot keeps the value the branch takes,
# moved in, and the change lands there.

struct N
  c: Int

fun poke(x: !N) -> Int
  x.c += 100
  x.c

sub go(k: Bool)
  a = N(c: 1)
  print("v", poke(!((<a) if k else N(c: 5))))
  b = N(c: 2)
  print("v", poke(!(N(c: 7) if k else <b)))
  c = Vec[Int]()
  d = Vec[Int]()
  !(<c if k else <d).push(3)

sub main()
  go(true)
  go(false)

# expect:
# v 101
# v 107
# v 105
# v 102
