# An assignment is `{ __v = value; place op= __v }`: the value runs to
# the end, its nested statements included, before the target is found,
# so a store goes through the view as the value left it, for a name
# written through as for an element, a field, or a compound.
# release
struct P
  a: Int
  b: Int

fun grow(v: !Vec[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub name_repointed(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0]
  w = match k
    0
      w = !u[0]
      3
    _ => 4
  print(v[0], u[0])

sub name_repointed_grows_old(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0]
  w = match k
    0
      w = !u[0]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

sub name_compound(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0]
  w += match k
    0
      w = !u[0]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

sub elem_repointed_grows_old(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0..1]
  w[0] = match k
    0
      w = !u[0..1]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

sub field_repointed(k: Int)
  v: Vec[P] = Vec()
  !v.push(P(a: 1, b: 2))
  u: Vec[P] = Vec()
  !u.push(P(a: 3, b: 4))
  w = !v[0]
  w.a = if k == 0
    w = !u[0]
    9
  else
    0
  print(v[0].a, u[0].a)

sub swap(k: Int)
  p = P(a: 1, b: 2)
  p = match k
    0
      P(a: p.b, b: p.a)
    _ => P(a: 0, b: 0)
  print(p.a, p.b)
  v: Vec[P] = Vec()
  !v.push(P(a: 3, b: 4))
  w = !v[0]
  w = match k
    0
      P(a: w.b, b: w.a)
    _ => P(a: 0, b: 0)
  print(v[0].a, v[0].b)

sub last_line(k: Bool)
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  w[0] = 5
  if k
    u: Vec[Int] = Vec()
    !u.push(1)
    w = !u[0..1]
    w[0] = 3
  print(v[0])

sub main()
  name_repointed(0)
  name_repointed_grows_old(0)
  name_compound(0)
  elem_repointed_grows_old(0)
  field_repointed(0)
  swap(0)
  last_line(true)

# expect:
# 7 3
# 7 201 201
# 7 209 201
# 7 201 201
# 1 9
# 2 1
# 4 3
# 5
