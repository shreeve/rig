# `v[i] = e` evaluates `e`, then the index, then finds the element: a
# value or an index that grows the List leaves the store in the new buffer.

fun grow(v: !List[String]) -> String
  !v.push(String("x"))
  !v.push(String("y"))
  !v.push(String("z"))
  !v.push(String("w"))
  String("new")

fun at_end(v: !List[String]) -> Int
  !v.push(String("p"))
  !v.push(String("q"))
  !v.push(String("r"))
  !v.push(String("s"))
  0

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  v[0] = grow(!v)
  print(v)
  v[at_end(!v)] = String("n")
  print(v)

# expect:
# ["new", "x", "y", "z", "w"]
# ["n", "x", "y", "z", "w", "p", "q", "r", "s"]
