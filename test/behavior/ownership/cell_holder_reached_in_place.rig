# An element or field that holds a Cell is reached where it is, never
# through a copy: through a generic view of an array or a struct, and as
# the receiver of a `?self` method on a slice or array element.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

struct H[T]
  item: T
  n: Int

sub first[T](xs: ?[2]T, f: ?fun(?T) -> Int)
  _ = f(?xs[0])

fun field[T](h: ?H[T], f: ?fun(?T) -> Int) -> Int
  f(?h.item)

fun bump(c: ?Counter) -> Int
  c.hit()
  1

sub bumps(s: []Counter)
  i = 0
  s[i].hit()
  s[0].hits.set(s[0].hits.get() + 10)

sub bumpa(s: ?[1]Counter)
  s[0].hit()

sub main()
  a = [Counter(hits: Cell(0)), Counter(hits: Cell(0))]
  first(?a, bump)
  print(a[0].hits.get())
  h = H(item: Counter(hits: Cell(0)), n: 1)
  print(field(?h, bump), h.item.hits.get())
  bumps(?a[..])
  b = [Counter(hits: Cell(0))]
  bumpa(?b)
  print(a[0].hits.get(), b[0].hits.get())

# expect:
# 1
# 1 1
# 12 1
