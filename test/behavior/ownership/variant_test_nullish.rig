# Testing `o ?? d` against a bare variant reads it, as any `==` operand:
# the value `o` or `d` holds is read where it is, never dropped.
enum Shape
  dot
  line(v: Vec[Int])

sub main
  p: Vec[Int] = Vec()
  !p.push(1)
  o: Shape? = none
  d = Shape.line(<p)
  if (o ?? d) != .dot
    print("line")
  match ?d
    .line(v) => print(v[0])
    .dot => print("dot")


# expect:
# line
# 1
