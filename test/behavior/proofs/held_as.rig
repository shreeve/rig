# An `if ... as` over a part of a value the header makes holds that
# value before the test (`Header.held`): the held value is the `as`
# part's code, so a guard before the `if` proves `s[i]` in it and in the
# body.

obj Res
  n: Int

  drop(!self)
    print("drop", self.n)

obj Bag
  o: Res?

fun mk(c: U8) -> Bag
  Bag(o: Res(n: Int(c)))

fun pick(s: ?String, at: Int) -> Int
  i = at
  if i < s.len
    if mk(s[i]).o as r # proves: index upper
      return r.n + Int(s[i]) # proves: index upper
  0

sub main()
  print(pick("abc", 2))

# release
# expect:
# drop 99
# 198
