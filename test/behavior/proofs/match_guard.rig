# A guard that writes another binding.

fun bump(n: !Int) -> Bool
  n += 1
  false

fun pick(s: ?String, at: Int, k: Int) -> U8
  i = at
  j = 0
  if i < s.len
    match k
      1 if bump(!j) => print(1)
      _ => return s[i] # proves: index upper
  0

sub main()
  print(pick("abc", 2, 1))

# release
# expect:
# 99
