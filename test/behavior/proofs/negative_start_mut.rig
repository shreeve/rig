# Nothing shows `0 <= i` when `i` starts below 0: the read keeps its
# sign test.

fun count(s: ?String, at: Int) -> Int
  i = at
  n = 0
  while i + 8 <= s.len
    x = s.read[U64, .little](i) # keeps: read lower
    print(x)
    n += 1
    i += 8
  n

sub main()
  print(count("abcdefghij", -5))

# release
# expect-panic: byte read out of range
