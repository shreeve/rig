# Writing the bound `n` ends the guard `i < n`: the add keeps its test.
# (Its value cannot overflow: a later `n` does not change what the guard
# showed of `i`. Round 1 drops the fact all the same.)

fun step(s: ?String, at: Int) -> Int
  n = s.len
  i = at
  if i < n
    n -= 2
    return i + 1 + n # keeps: + no_overflow
  0

sub main()
  print(step("abcd", 3))

# release
# expect:
# 6
