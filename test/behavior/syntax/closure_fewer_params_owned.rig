# An argument passed for a parameter a closure leaves out is handled as
# one passed to `_`: an owned argument is dropped when the closure is
# called.

obj F
  n: Int

  drop(!self)
    print("drop", self.n)

sub feed(f: ?sub(F, F))
  f(F(n: 1), F(n: 2))

sub feed_owned(f: ?sub(String, F))
  f(String("a", 1), F(n: 3))

sub main()
  feed(|| print("none"))
  feed(|a| print("first", a.n))
  feed(|_, _| print("both ignored"))
  feed(|_| print("one ignored"))
  feed_owned(|| print("skip"))

# expect:
# none
# drop 2
# drop 1
# first 1
# drop 2
# drop 1
# both ignored
# drop 2
# drop 1
# one ignored
# drop 2
# drop 1
# skip
# drop 3
