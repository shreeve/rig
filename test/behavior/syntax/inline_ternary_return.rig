# `return a if c else b` returns the ternary's value.
# Known bug (A2): `else` stays an identifier, so this parses as
# `return 1 if c(else)(2)`; emit then drops the guard (A1), leaving `c`
# unused, and the emitted Zig fails to compile.

fun f(c: Bool) -> Int
  return 1 if c else 2

sub main()
  print(f(true))
  print(f(false))

# expect:
# 1
# 2
