# `if` names a member as every other keyword does: a field, a method,
# a payload field, and a keyword argument.

obj O
  if: Int
  b: Int

  fun else(?self) -> Int
    self.if + self.b

enum P
  pp(if: Int)
  qq

fun pv(p: P) -> Int
  match p
    .pp(if: x) => x
    .qq => 0

sub main()
  o = O(if: 1, b: 2)
  print(o.if, o.else(), o, pv(.pp(if: 7)), 3 if o.if > 0 else 4)

# expect:
# 1 3 O(if: 1, b: 2) 7 3
