# `inline`, `called`, and `rarely` mark a function before its `fun` or
# `sub`: a module's function, a public one, a method in its type's body or
# outside it, and a function with compile-time parameters. They ask for a
# speed and change no meaning, and anywhere else each word is a name. A
# `called` function, always a real call, may be passed as a value.

inline fun add(a: Int, b: Int) -> Int
  a + b

rarely sub report(what: ?String, n: Int)
  print(what, n)

pub inline fun double(x: Int) -> Int
  x * 2

pub rarely fun fallback(x: Int) -> Int
  x - 1

called fun triple(x: Int) -> Int
  x * 3

pub called sub note(n: Int)
  print("note", n)

fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

obj Counter
  n: Int
  inline: Int

  inline fun get(?self) -> Int
    self.n + self.inline

  rarely sub reset(!self)
    self.n = 0

  called fun total(?self) -> Int
    self.n * 100 + self.inline

  fun rarely(?self) -> Int
    self.inline * 10

inline fun Counter.bumped(?self, by: Int) -> Int
  self.n + by

rarely sub Counter.clear(!self)
  self.inline = 0

called fun Counter.half(?self) -> Int
  self.n / 2

obj Wrap[T]
  value: T

  inline fun get(?self) -> T
    self.value

rarely fun Wrap[T].peek(?self) -> T
  self.value

called fun Wrap[T].same(?self) -> T
  self.value

inline fun larger[T](a: T, b: T) -> T
  a if a > b else b

rarely fun scaled[k: Int](x: Int) -> Int
  x * k

called fun shifted[k: Int](x: Int) -> Int
  x + k

fun rarely(inline: Int) -> Int
  called = inline + 1
  called

sub main()
  inline = 3
  rare = rarely(inline)
  print(add(inline, rare), double(rare), fallback(rare))
  report("count", inline)
  print(triple(2), apply(triple, 5), apply(fallback, 3))
  note(1)
  c = Counter(n: 5, inline: 2)
  print(c.get(), c.rarely(), c.bumped(10), c.total(), c.half())
  !c.reset()
  !c.clear()
  print(c.get())
  w = Wrap[Int](value: 7)
  print(w.get(), w.peek(), w.same())
  print(larger(3, 9), larger("a", "b"), scaled[3](4), scaled[5](4), shifted[1](4), shifted[2](4))

# release

# expect:
# 7 8 3
# count 3
# 6 15 2
# note 1
# 7 20 15 502 2
# 0
# 7 7 7
# 9 b 12 20 5 6
