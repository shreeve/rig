# A closure may declare fewer parameters than the function type it is
# checked against; the trailing ones it leaves out are `_`. This holds
# for stack and owned closures, `sub` and `fun` types, and binding,
# parameter, and field types.

obj Event
  n: Int

obj Window
  id: Int

obj Cx
  tag: Int

obj Button
  on_click: *sub(Event, Window, Cx)

fun register(f: *sub(Event, Window, Cx)) -> Button
  Button(on_click: <f)

sub fire(b: ?Button)
  cx = Cx(tag: 5)
  b.on_click(Event(n: 7), Window(id: 3), cx)

sub twice(f: ?sub(Int, Int))
  f(1, 2)
  f(3, 4)

fun apply(f: ?fun(Int, Int) -> Int, a: Int, b: Int) -> Int
  f(a, b)

sub main()
  fire(?register(*|| print("zero")))
  fire(?register(*|e| print("event", e.n)))
  fire(?register(*|e, w| print(e.n, w.id)))
  fire(?register(*|e, w, cx| print(e.n, w.id, cx.tag)))
  fire(?register(*|_, w| print("window", w.id)))
  b = Button(on_click: *|| print("field"))
  fire(?b)
  twice(|| print("tick"))
  twice(|a| print(a))
  g: sub(Int, Int) = |a| print("typed", a)
  g(5, 6)
  print(apply(|a| a * 10, 4, 5))
  print(apply(|| 99, 4, 5))
  k = *|a: Int| print(a)
  k(8)

# expect:
# zero
# event 7
# 7 3
# 7 3 5
# window 3
# field
# tick
# tick
# 1
# 3
# typed 5
# 40
# 99
# 8
