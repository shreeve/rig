# The `?` before a `for` loop's source that is a method call reaches the
# call's receiver, as before any call (`?b.each()` is `(?b).each()`),
# and the loop holds the iterator the call makes, which keeps `b` lent
# to read for the loop. A method that writes its receiver is called
# with the `!` in parentheses, `(!b).drain()`, as any write call whose
# value is used is.

obj Cur
  xs: ?List[Int]
  i: Int

  fun next(!self) -> Int?
    return none if self.i >= self.xs.len
    self.i += 1
    self.xs[self.i - 1]

obj Count
  n: Int

  fun next(!self) -> Int?
    return none if self.n == 0
    self.n -= 1
    self.n

obj Bag
  xs: List[Int]

  fun drain(!self) -> Count
    n = self.xs.len
    !self.xs.clear()
    Count(n: n)

  fun each(?self) -> Cur from self
    Cur(xs: ?self.xs, i: 0)

obj Shelf
  bag: Bag

sub main()
  b = Bag(xs: List())
  !b.xs.push(4)
  !b.xs.push(5)
  for x in ?b.each()
    print(x)
  for x in ?b.each()
    print(x * 10)
    break
  !b.xs.push(6)
  for x in ?b.each()
    for y in ?b.each()
      print(x + y)
  s = Shelf(bag: <b)
  for x in ?s.bag.each()
    print(x)
  total = 0
  for x in ?s.bag.each()
    total += x
  print(total)
  !s.bag.xs.push(1)
  print(s.bag.xs)
  for x in (!s.bag).drain()
    print("drained", x)
  print(s.bag.xs.len)

# expect:
# 4
# 5
# 40
# 8
# 9
# 10
# 9
# 10
# 11
# 10
# 11
# 12
# 4
# 5
# 6
# 15
# [4, 5, 6, 1]
# drained 3
# drained 2
# drained 1
# drained 0
# 0
