# A bracket list of compile-time arguments may end with a comma, in a
# type and in an expression, as other lists may; a single argument too.

struct Pair[T, U]
  a: T
  b: U

sub show(p: Pair[Int, String,])
  print(p.a, p.b)

fun add[n: Int](x: Int) -> Int
  n + x

sub main()
  v = Vec[Int,]()
  !v.push(add[3,](1))
  print(v.len, v[0])
  p = Pair[
    Int,
    String,
  ](a: 1, b: "x")
  show(p)

# expect:
# 1 4
# 1 x
