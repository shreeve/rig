# Inside brackets a line break is whitespace, so a `??` whose jump
# starts the next line still takes the jump.

fun twice(n: Int) -> Int
  n * 2

fun pick(a: Int?) -> Int
  n = twice(a ??
    return -1)
  m = twice(a ?? \
    return -2)
  n + m

sub main()
  print(pick(3), pick(none))

# expect:
# 12 -1
