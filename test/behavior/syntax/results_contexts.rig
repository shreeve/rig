# A destructure stands wherever a statement does: a branch, an arm, a
# loop's body, a closure's last line, and `new` reads the names it
# shadows, as `new x = e` does.

fun divmod(a: Int, b: Int) -> (Int, Int)
  return a / b, a % b

fun maybe(a: Int, b: Int) -> (Int, Int)?
  return none if b == 0
  return a / b, a % b

sub main()
  n = 17
  new n, m = divmod(n, 5)
  print(n, m)
  q = 0
  r = 0
  match n
    3 => q, r = divmod(9, 2)
    _ => q, r = divmod(6, 4)
  print(q, r)
  f = |!q, !r|
    q, r = divmod(11, 3)
  f()
  print(q, r)
  if maybe(7, 2) as a, b
    _ = b
    print(a)

# expect:
# 3 2
# 4 1
# 3 2
# 3
