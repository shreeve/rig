# Owning by-value parameters are copied into locals under generated names,
# whatever they are called: Zig keywords, `_`, and names that look like the
# emitter's own.

obj B
  n: Int

  drop(!self)
    print("drop", self.n)

sub kw(var: List[Int])
  print(var.len)

sub ignore(_: List[Int], _: *B)
  print("ignored")

sub flags(alive_b: List[Int], b: *B)
  if alive_b.len > 0
    keep(<b)

sub keep(b: *B)
  print("keep", b.n)

obj S
  v: List[Int]

  sub consume(<self)
    f = || print("consume")
    f()

sub main()
  v: List[Int] = List()
  !v.push(1)
  kw(<v)
  w: List[Int] = List()
  ignore(<w, *B(n: 1))
  u: List[Int] = List()
  !u.push(2)
  flags(<u, *B(n: 2))
  s = S(v: List())
  <s.consume()

# expect:
# 1
# ignored
# drop 1
# keep 2
# drop 2
# consume
