# `!t.add(...)` reads every place that owns storage when it is called,
# after its later arguments ran, as `print` does: here a later argument
# replaces the Cell's Vec, which frees the old buffer.
# release
fun reset(c: ?Cell[Vec[Int]]) -> Int
  c.set(Vec())
  0

fun fill(c: ?Cell[Vec[Int]]) -> Int
  for i in 0..3
    c.push(i)
  3

sub main()
  c: *Cell[Vec[Int]] = *Cell(Vec())
  for i in 0..40
    c.push(i * 1000)
  t = Text()
  !t.add(c, reset(?c))
  print(t)
  !t.clear()
  !t.add(c, " ", fill(?c))
  print(t)

# expect:
# Cell(value: [])0
# Cell(value: [0, 1, 2]) 3
