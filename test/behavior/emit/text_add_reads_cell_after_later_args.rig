# `!t.add(...)` reads every place that owns storage when it is called,
# after its later arguments ran, as `print` does: here a later argument
# replaces the Cell's List, which frees the old buffer.
# release
fun reset(c: !Cell[List[Int]]) -> Int
  !c.set(List())
  0

fun fill(c: !Cell[List[Int]]) -> Int
  for i in 0..3
    !c.push(i)
  3

sub main()
  c: *Cell[List[Int]] = *Cell(List())
  for i in 0..40
    !c.push(i * 1000)
  t = String()
  d = +c
  !t.add(c, reset(!d))
  print(t)
  !t.clear()
  !t.add(c, " ", fill(!d))
  print(t)

# expect:
# Cell(value: [])0
# Cell(value: [0, 1, 2]) 3
