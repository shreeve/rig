# An index an assignment evaluates before its store, read through a
# write view (`k: !Int`), holds the value it reads.

fun bump(k: !Int) -> Int
  k += 1
  0

sub f(a: ![]Int, k: !Int)
  a[bump(!k)] = k
  print(a, k)

sub g(a: ![3][3]Int, k: !Int)
  a[k][bump(!k)] = 5
  print(a, k)

sub main()
  a: [3]Int = [0, 0, 0]
  k = 1
  f(!a[..], !k)
  b: [3][3]Int = [[0, 0, 0], [0, 0, 0], [0, 0, 0]]
  j = 1
  g(!b, !j)

# expect:
# [1, 0, 0] 2
# [[0, 0, 0], [5, 0, 0], [0, 0, 0]] 2
