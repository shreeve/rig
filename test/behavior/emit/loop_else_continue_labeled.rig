# A `continue :outer` in a nested loop's `else` goes through the outer
# loop's step.
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

fun fresh(n: Int) -> Vec[Int]
  a: Vec[Int] = Vec()
  !a.push(n)
  a

fun take(a: Vec[Int]) -> Int
  a[0]

sub main()
  v: Vec[Int] = Vec()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    while j < 2: j += 1
      k += 0
    else
      continue :outer
    k += 100
  print(k, i)

# expect:
# 21 5
