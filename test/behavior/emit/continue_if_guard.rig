# `continue if c` skips the rest of the body only when `c` holds.
# Known bug (A1): emit ignores the guard, so every iteration continues and
# the emitted Zig fails to compile (unreachable code after `continue`).

sub main()
  i = 0
  while i < 6
    i += 1
    continue if i < 4
    print(i)

# expect:
# 4
# 5
# 6
