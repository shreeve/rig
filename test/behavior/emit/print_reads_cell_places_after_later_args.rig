# `print` reads every place that owns storage when it is called, after
# its later arguments ran, however the shared Cell is reached: through
# a read or write view, a generic `?T`, an optional, or a closure's
# capture. Each later argument here grows the Cell's List
# through another handle, which moves its buffer.
# release
obj S
  c: Cell[List[Int]]

fun grow(c: !Cell[List[Int]]) -> Int
  for i in 0..8
    !c.push(i)
  c.len

fun grow_s(s: !S) -> Int
  grow(!s.c)

fun grow_opt(o: ?(*S)?) -> Int
  if o as s
    return grow(!s.c)
  0

sub read_param(c: ?Cell[List[Int]], o: !Cell[List[Int]])
  print(c, grow(!o))

sub write_param(c: ?*Cell[List[Int]], o: !*Cell[List[Int]])
  print(c, grow(!o))

sub generic[T](x: ?T, c: !Cell[List[Int]])
  print(x, grow(!c))

sub main()
  c: *Cell[List[Int]] = *Cell(List())
  d = +c
  read_param(c, !d)
  write_param(c, !d)
  generic(?c, !d)
  w = ?c
  print(w, grow(!d))
  o: (*S)? = *S(c: Cell(List()))
  print(o, grow_opt(?o))
  s0 = *S(c: Cell(List()))
  s1 = +s0
  print(s1, grow_s(!s0))
  e: *Cell[List[Int]] = *Cell(List())
  f = +e
  g = |+f| grow(!f)
  print(e, g())

# expect:
# Cell(value: [0, 1, 2, 3, 4, 5, 6, 7]) 8
# Cell(value: [0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7]) 16
# Cell(value: [0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7]) 24
# Cell(value: [0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3, 4, 5, 6, 7]) 32
# S(c: Cell(value: [0, 1, 2, 3, 4, 5, 6, 7])) 8
# S(c: Cell(value: [0, 1, 2, 3, 4, 5, 6, 7])) 8
# Cell(value: [0, 1, 2, 3, 4, 5, 6, 7]) 8
