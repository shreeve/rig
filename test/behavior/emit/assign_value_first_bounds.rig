# The right-hand side runs before the target's place is found: here it
# empties the List, so the store is out of bounds, and panics.

obj B
  xs: List[Int]

fun empty(b: !B) -> Int
  !b.xs.push(9)
  b.xs = List()
  3

sub main()
  b = B(xs: List())
  !b.xs.push(1)
  b.xs[0] = empty(!b)
  print(b.xs.len)

# expect-panic: index out of bounds
