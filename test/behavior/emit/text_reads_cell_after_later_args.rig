# `String(...)` reads every place that owns storage when it is called,
# after its later arguments ran, as `print` does: here a later argument
# grows the Cell's List, which moves its buffer, or replaces the List,
# which frees it.
# release
obj S
  c: Cell[List[Int]]

fun grow(c: !Cell[List[Int]]) -> Int
  for i in 0..1000
    !c.push(i)
  5

fun reset(c: !Cell[List[Int]]) -> Int
  !c.set(List())
  0

fun grow_s(s: !S) -> Int
  !s.c.push(9)
  1

sub main()
  c: *Cell[List[Int]] = *Cell(List())
  !c.push(42)
  e = +c
  t = String(c, grow(!e))
  print(t.len)
  d: *Cell[List[Int]] = *Cell(List())
  !d.push(7)
  f = +d
  u = String(d, reset(!f))
  print(u)
  s = *S(c: Cell(List()))
  s2 = +s
  w = String(s, " ", grow_s(!s2))
  print(w)

# expect:
# 4908
# Cell(value: [])0
# S(c: Cell(value: [9])) 1
