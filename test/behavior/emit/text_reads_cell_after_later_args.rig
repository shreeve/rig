# `Text(...)` reads every place that owns storage when it is called,
# after its later arguments ran, as `print` does: here a later argument
# grows the Cell's Vec, which moves its buffer, or replaces the Vec,
# which frees it.
# release
struct S
  c: Cell[Vec[Int]]

fun grow(c: !Cell[Vec[Int]]) -> Int
  for i in 0..1000
    !c.push(i)
  5

fun reset(c: !Cell[Vec[Int]]) -> Int
  !c.set(Vec())
  0

fun grow_s(s: !S) -> Int
  !s.c.push(9)
  1

sub main()
  c: *Cell[Vec[Int]] = *Cell(Vec())
  !c.push(42)
  e = +c
  t = Text(c, grow(!e))
  print(t.len)
  d: *Cell[Vec[Int]] = *Cell(Vec())
  !d.push(7)
  f = +d
  u = Text(d, reset(!f))
  print(u)
  s = *S(c: Cell(Vec()))
  s2 = +s
  w = Text(s, " ", grow_s(!s2))
  print(w)

# expect:
# 4908
# Cell(value: [])0
# S(c: Cell(value: [9])) 1
