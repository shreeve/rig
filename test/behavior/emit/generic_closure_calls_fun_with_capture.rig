# A generic closure calls a captured `fun(?T)` with a `|?w|` capture.

obj P
  n: Int
  t: String

  fun len(?self) -> Int
    self.t.len

fun gen[T](w: !T, f: fun(?T) -> Int) -> Int
  h = |?w, ?f| f(w) + f(w)
  h()

fun ln(p: ?P) -> Int
  p.len()

sub main()
  p = P(n: 1, t: String("ab"))
  print(gen(!p, ln))

# expect:
# 4
