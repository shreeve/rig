# `lo..hi` in a match arm is half-open, like every range: it matches
# `lo` up to, not including, `hi`. Bounds may be negative or named
# constants.

sub bucket(x: Int)
  lim =! 10
  match x
    -5..0 => print("negative")
    1..4 => print("low")
    4..7 => print("mid")
    7..lim => print("high")
    other => print("out", other)

sub main()
  bucket(-5)
  bucket(0)
  bucket(3)
  bucket(4)
  bucket(6)
  bucket(7)
  bucket(9)
  bucket(10)
  bucket(-6)

# expect:
# negative
# out 0
# low
# mid
# mid
# high
# high
# out 10
# out -6
