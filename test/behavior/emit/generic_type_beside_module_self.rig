# A module-level function named `Self` does not clash with the name a
# generic type uses for itself in the emitted Zig.

fun Self -> Int
  3

struct W[T]
  v: T

  fun get(?self) -> Int
    Self()

  fun same(?self) -> W[T]
    W(v: self.v)

sub main()
  w = W(v: 1)
  print(w.get(), w.same())

# expect:
# 3 W(v: 1)
