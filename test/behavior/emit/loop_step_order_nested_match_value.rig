# Steps, defers, and drops run in the same order for a joined outer loop
# and a `catch break` inner loop as for plain `while … as` loops, with a
# `continue :outer` from a `match` value in the inner body.
error E
  bad

struct S
  s: []Int

struct D
  n: Int
  drop(!self)
    print("drop", self.n)

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 4
    return S(s: ?v[..])
  none

fun mkf(v: ?Vec[Int], i: Int, bad: Int) -> S?!
  return E.bad if i == bad
  mk(v, i)

fun fresh(t: Int, n: Int) -> Vec[Int]
  print("step", t, n)
  a: Vec[Int] = Vec()
  !a.push(n)
  a

fun take(a: Vec[Int]) -> Int
  a[0]

fun odd(j: Int) -> Int?
  j if j % 2 == 1 else none

sub main()
  v: Vec[Int] = Vec()
  !v.push(5)
  a = fresh(0, 0)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and i >= 0: a = fresh(1, h.s[0] + i)
    i += 1
    defer print("odefer", i)
    x = D(n: i)
    k += take(<a)
    m = 0
    b = fresh(9, 0)
    :mid while (mkf(?v, m, 99) catch break) as g: b = fresh(2, g.s[0] + m)
      m += 1
      defer print("mdefer", i, m)
      y = D(n: 100 + m)
      k += take(<b)
      w = match m
        1 => 10
        2
          continue :outer if i % 2 == 0
          20
        _ => 30
      k += w
    print("after mid", i, m)
  print("end", k, i)

# expect:
# step 0 0
# step 9 0
# drop 101
# mdefer 1 1
# step 2 6
# drop 102
# mdefer 1 2
# step 2 7
# drop 103
# mdefer 1 3
# step 2 8
# drop 104
# mdefer 1 4
# step 2 9
# after mid 1 4
# drop 1
# odefer 1
# step 1 6
# step 9 0
# drop 101
# mdefer 2 1
# step 2 6
# drop 102
# mdefer 2 2
# drop 2
# odefer 2
# step 1 7
# step 9 0
# drop 101
# mdefer 3 1
# step 2 6
# drop 102
# mdefer 3 2
# step 2 7
# drop 103
# mdefer 3 3
# step 2 8
# drop 104
# mdefer 3 4
# step 2 9
# after mid 3 4
# drop 3
# odefer 3
# step 1 8
# step 9 0
# drop 101
# mdefer 4 1
# step 2 6
# drop 102
# mdefer 4 2
# drop 4
# odefer 4
# step 1 9
# end 275 4
