# A read view of a List element through a lent to read receiver reads
# the element in place.

obj P
  x: Int
  y: Int

obj Bag[T]
  items: List[T]

  fun first(?self) -> ?T
    ?self.items[0]

  fun at(?self, i: Int) -> ?T
    ?self.items[i]

sub main()
  a: Bag[Int] = Bag(items: List())
  !a.items.push(4)
  !a.items.push(5)
  print(a.first(), a.at(1))
  b: Bag[P] = Bag(items: List())
  !b.items.push(P(x: 1, y: 2))
  r = ?b.first()
  print(r.y)
  s: Bag[?String] = Bag(items: List())
  !s.items.push("hi")
  print(s.first())

# expect:
# 4 5
# 2
# hi
