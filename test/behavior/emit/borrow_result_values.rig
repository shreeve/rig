# A borrow of a Copy value that an expression yields (a call returning
# `!Int`, `!p.get()`) reads as the value wherever a value is expected:
# `not`, `and`/`or`, `??`, String and enum equality, compound
# assignment, bindings, arguments, returns, fields, payloads, array
# elements, indexes, ranges, slices, conversions, conditions, `if … as`,
# `?`, branches, loop values, and clones. The value read is a copy, so
# the borrow taken to reach it ends there.

enum Color
  red
  green

enum Shape
  dot
  box(w: Int)

struct P
  n: Int

  fun get(!self) -> !Int
    !self.n

fun wr(a: !Int) -> !Int
  a

fun wb(a: !Bool) -> !Bool
  a

fun ws(a: !String) -> !String
  a

fun wo(a: !Int?) -> !Int?
  a

fun wc(a: !Color) -> !Color
  a

fun take(n: Int) -> Int
  n

fun ret(a: !Int) -> Int
  return wr(!a)

fun tail(a: !Int) -> Int?
  wr(!a)

fun next(a: !Int?) -> Int?
  v = wo(!a)?
  v + 1

sub main()
  x = 6
  y = 2
  b = true
  s = "hi"
  o: Int? = 3
  n: Int? = none
  c = Color.red
  arr = [10, 20, 30]

  print(not wb(!b))
  print(wb(!b) and true, false or wb(!b))
  print(wo(!o) ?? 1, wo(!n) ?? 1)
  print(ws(!s) == "hi", ws(!s) != "ho")
  print(wc(!c) == .red, none == wo(!n))

  x += wr(!y)
  x <<= wr(!y)
  x /= wr(!y)
  x %= wr(!y)
  print(x)

  z: Int = wr(!y)
  u = wr(!y)
  v = wb(!b)
  y += 1
  print(z, u, not v, y)

  print(take(wr(!y)), ret(!y), tail(!y), next(!o), next(!n))
  p = P(n: wr(!y))
  sh = Shape.box(w: !p.get())
  match sh
    .box(w)
      print(p.n, w)
    _
      print(0)
  pair: [2]Int = [wr(!y), 0]
  print(pair[0], [!p.get(), 1][0])

  print(arr[wr(!u)], ws(!s)[0], ws(!s)[0..1], ws(!s).len)
  for i in 0..wr(!u)
    print(i)
  print(Float(wr(!y)), +wr(!y))

  if wb(!b)
    print("if")
  k = 0
  while wb(!b)
    k += 1
    b = k < 3
  print(k)
  if wo(!o) as got
    print(got)

  t = wr(!y) if not b else 0
  m = match y
    3
      wr(!y)
    _
      0
  l = while true
    break wr(!y)
  print(t, m, l)

# expect:
# false
# true true
# 3 1
# true true
# true true
# 0
# 2 2 false 3
# 3 3 3 4 none
# 3 3
# 3 3
# 30 104 h 2
# 0
# 1
# 3.0 3
# if
# 3
# 3
# 3 3 3
