# Moving a payload binding of `match <s` out is allowed: `s` was
# consumed by the match, so it is not dropped again.

struct Wrap
  payload: Int

  drop(!self)
    print("drop")

enum Slot
  full(b: *Wrap)
  empty

sub eat(rc: *Wrap)
  print(rc.payload)

sub main()
  rc = *Wrap(payload: 5)
  s: Slot = .full(b: <rc)
  match <s
    .full(b) => eat(<b)
    .empty => print(0)
  print("end")

# expect:
# 5
# drop
# end
