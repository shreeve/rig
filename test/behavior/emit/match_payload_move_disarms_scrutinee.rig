# Moving a match payload binding out of an owned local scrutinee is
# allowed; it consumes the scrutinee.

struct Wrap
  payload: Int

  drop(!self)
    print("drop")

enum Slot
  full(b: *Wrap)
  empty

sub eat(rc: *Wrap)
  print(rc.payload)

sub main()
  rc = *Wrap(payload: 5)
  s: Slot = .full(b: <rc)
  match s
    .full(b) => eat(<b)
    .empty => print(0)
  print("end")

# expect:
# 5
# drop
# end
