# A guarded match on an element of a List reached through a read view
# matches the element where it is: plain, Text, and Cell-holder
# payloads (the last behind a shared handle), through a parameter and
# through a field.

obj C
  c: Cell[Int]

enum E
  a(n: Int)
  b(n: Int)

enum T
  a(t: String)
  b

enum K
  a(x: C)
  b

obj H
  es: List[E]

fun plain(v: ?List[E]) -> Int
  match v[0]
    .a(n) if n > 1 => n
    .a(_) => 1
    .b(n) => n

fun text(v: ?List[T]) -> Int
  match v[0]
    .a(t) if t.len > 1 => t.len
    .a(_) => 1
    .b => 0

sub cell(v: ?List[*K])
  match v[0]
    .a(x) if x.c.get() == 0 => print("zero")
    .a(_) => print("set")
    .b => pass

fun field(h: ?H) -> Int
  match h.es[0]
    .a(n) if n > 1 => n
    _ => 0

sub main()
  e: List[E] = List()
  !e.push(E.a(n: 5))
  t: List[T] = List()
  !t.push(T.a(t: String("hello")))
  k: List[*K] = List()
  !k.push(*K.a(x: C(c: Cell(0))))
  cell(?k)
  es: List[E] = List()
  !es.push(E.a(n: 9))
  h = H(es: <es)
  print(plain(?e), text(?t), field(?h))
  match k[0]
    .a(x) => print(x.c.get())
    .b => pass

# expect:
# zero
# 5 5 9
# 0
