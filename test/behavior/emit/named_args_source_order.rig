# Arguments are evaluated in the order they are written and passed in
# the order the parameters are declared, so a name that a later-written
# argument changes is read after it, whatever view it is read as: a
# String's bytes, a slice, or a copy of a number. The checker walks the
# same order.
# release

obj Acc
  total: Int

  sub put(!self, s: ?String, n: Int)
    self.total += n + s.len

obj P
  x: Int
  y: Int

fun grow(t: !String) -> Int
  for _ in 0..200
    !t.add("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")
  1

fun fill(v: !List[Int]) -> Int
  for i in 0..300
    !v.push(i)
  1

fun bump(n: !Int) -> Int
  n += 10
  n

sub show(s: ?String, n: Int)
  print(s.len > 8000, n)

sub show_text(s: ?String, n: Int)
  print(s.len > 8000, n)

sub total(xs: []Int, n: Int)
  print(xs.len, n)

sub both(a: Int, b: Int)
  print(a, b)

fun pick[T](v: ?T, n: Int) -> Int
  n + 1

sub main()
  t = String("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJ")
  show(n: grow(!t), s: ?t)
  u = String("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJ")
  show_text(n: grow(!u), s: ?u)
  v: List[Int] = List()
  !v.push(1)
  total(n: fill(!v), xs: ?v)
  x = 1
  both(b: bump(!x), a: ?x)
  both(b: ?x, a: bump(!x))
  w = String("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJ")
  acc = Acc(total: 0)
  !acc.put(n: grow(!w), s: ?w)
  print(acc.total > 8000)
  z = String("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJ")
  print(pick(n: grow(!z), v: ?z))
  q = 1
  p = P(y: bump(!q), x: ?q)
  print(p.x, p.y)

# expect:
# true 1
# true 1
# 301 1
# 11 11
# 21 11
# true
# 2
# 11 11
