# A `match !p` whose subject is an element of a List, or a path through
# one, writes its payloads where the element is: the switch is on the
# place, never on a copy of the element.
# release

enum E
  a(n: Int, t: String)
  b

obj S
  e: E

obj H
  f: List[E]

sub bump(p: !List[E], i: Int)
  match !p[i]
    .a(n, t)
      n += 1
      !t.add("p")
    .b => pass

sub main()
  v: List[E] = List()
  !v.push(E.a(n: 1, t: String("v")))
  !v.push(E.b)
  i = 0
  match !v[i]
    .a(n, t)
      n += 10
      !t.add("x")
    .b => pass
  match !v[0]
    .a(n, _) => n += 100
    .b => pass
  bump(!v, i)
  s: List[S] = List()
  !s.push(S(e: E.a(n: 2, t: String("s"))))
  match !s[i].e
    .a(n, t)
      n += 20
      !t.add("y")
    .b => pass
  h = H(f: List())
  !h.f.push(E.a(n: 3, t: String("h")))
  match !h.f[i]
    .a(n, t)
      n += 30
      !t.add("z")
    .b => pass
  vv: List[List[E]] = List()
  w: List[E] = List()
  !w.push(E.a(n: 4, t: String("w")))
  !vv.push(<w)
  match !vv[0][i]
    .a(n, _) => n += 40
    .b => pass
  print(v[0], s[0].e, h.f[0], vv[0][0])

# expect:
# .a(n: 112, t: "vxp") .a(n: 22, t: "sy") .a(n: 33, t: "hz") .a(n: 44, t: "w")
