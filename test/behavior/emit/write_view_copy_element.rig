# A write view of a Copy value meets plain values as the value it
# reaches: an array element, an `if` branch, and a `match` arm read
# through it, whether the view is a name or a call's result. (A `!m`
# written there would be read, its `!` ignored, and is rejected:
# test/reject/ownership/ignored_write_lend.rig.)

struct S
  n: Int

  fun get(!self) -> !Int
    !self.n

sub main()
  m = 3
  q = !m
  a = [q, 4]
  b = if a[1] > 3
    q
  else
    0
  c = match a[0]
    3
      q
    _
      0
  print(a[0], a[1], b, c)

  s = S(n: 5)
  d = [q, (!s).get(), 6]
  e = if d[2] > 3
    (!s).get()
  else
    1
  f = match d[2]
    6
      q
    _
      2
  print(d[0], d[1], d[2], e, f)

# expect:
# 3 4 3 3
# 3 5 6 5 3
