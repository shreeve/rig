# Plain data is copied whole where it is read, so `print` shows a Cell
# of plain data, alone or in a struct, as it was when its argument ran,
# like any plain value a later argument changes (`print(p, bump(!p))`).
# The Cell holds the new value after the call.
struct K
  hits: Cell[Int]

fun bump(k: ?K) -> Int
  k.hits.set(99)
  1

fun bump2(c: ?Cell[Int]) -> Int
  c.set(7)
  2

sub main
  k = K(hits: Cell(1))
  print(k, bump(?k))
  print(k)
  c = Cell(1)
  print(c.get(), c, bump2(?c))
  print(c)

# expect:
# K(hits: Cell(value: 1)) 1
# K(hits: Cell(value: 99))
# 1 Cell(value: 1) 2
# Cell(value: 7)
