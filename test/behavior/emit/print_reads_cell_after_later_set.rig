# `print` reads a Cell when it is called: a later argument that replaces
# its List through another handle, dropping the old one, leaves the new List
# to print.
fun reset(c: !Cell[List[Int]]) -> Int
  !c.set(List())
  0

sub main()
  c: *Cell[List[Int]] = *Cell(List())
  for i in 0..50
    !c.push(i * 3)
  d = +c
  print(c, reset(!d))

# expect:
# Cell(value: []) 0
