# A read-borrow local of plain data rebound to a function's `?T`
# result: a local, a parameter, and a result hold a plain read borrow
# the same way.

struct Wrap
  n: Int

fun get(w: ?Wrap) -> ?Wrap
  w

sub main
  a = Wrap(n: 1)
  b = Wrap(n: 2)
  r = ?a
  r = get(?b)
  print(r.n)

# expect:
# 2
