# A callable held in a field, `s.cb(...)`, has no receiver: a call of it
# whose arguments are evaluated first fills its parameters from its first
# argument, so an owned argument is held as the value it is and dropped
# when a later argument fails.

error Bad
  no

struct Q
  c: Cell[Int]
  n: Int

struct H
  q: Q

struct S
  cb: fun(Text, ?Q, Int) -> Int

fun gf(k: Int) -> Int!
  if k > 1
    return Bad.no
  k

fun mkh(k: Int) -> H
  H(q: Q(c: Cell(k), n: k))

fun usq(t: Text, q: ?Q, n: Int) -> Int
  t.len + q.c.get() + n

fun run(s: ?S, k: Int) -> Int!
  s.cb(Text("a text long enough to live on the heap"), ?mkh(5).q, gf(k)!)

sub main
  s = S(cb: usq)
  print(run(?s, 2) catch -1)
  print(run(?s, 1) catch -1)

# expect:
# -1
# 44
