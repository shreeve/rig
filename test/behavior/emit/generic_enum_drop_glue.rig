# A generic enum instantiated with a handle (`Maybe[*Noisy]`) drops the
# handle it holds.

enum Maybe[T]
  some(value: T)
  nothing

obj Noisy
  id: Int

  drop(!self)
    print(self.id)

sub main()
  n = *Noisy(id: 6)
  m: Maybe[*Noisy] = .some(value: <n)
  match m
    .some => print("some")
    .nothing => print("none")

# expect:
# some
# 6
