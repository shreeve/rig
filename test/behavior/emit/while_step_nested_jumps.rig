# A `continue :outer` or `break :outer` from loops nested in the body of
# a `while` whose step reads its condition's binding, where the loop is
# written as nested `if`s in a `while (true)` (a joined condition, or a
# jump in the condition). A `continue :outer` runs the step, at any
# depth (an inner `while`, `while … as`, a `for`, a `match` arm, an
# inner step) and after the body's defers; a `break :outer` leaves
# without it. Here the step refills `a`, which the body moves.

error E
  bad

struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

fun mkf(v: ?Vec[Int], i: Int) -> S?!
  return E.bad if i > 70
  mk(v, i)

fun fresh(n: Int) -> Vec[Int]
  a: Vec[Int] = Vec()
  !a.push(n)
  a

fun take(a: Vec[Int]) -> Int
  a[0]

fun odd(j: Int) -> Int?
  j if j % 2 == 1 else none

sub joined()
  v: Vec[Int] = Vec()
  !v.push(5)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and h.s.len > 0: k += h.s[0]
    i += 1
    j = 0
    while j < 3: j += 1
      continue :outer if j == 2
    k += 100
  print(k, i)

sub joined_moves()
  v: Vec[Int] = Vec()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    continue if i > 200
    j = 0
    while j < 3: j += 1
      break :outer if i > 100
      continue :outer if j == 2
  print(k, i)

sub catch_break()
  v: Vec[Int] = Vec()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  :outer while (mkf(?v, i) catch break) as h: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    while j < 3: j += 1
      break :outer if i > 100
      continue :outer if j == 2
  print(k, i)

sub deep()
  v: Vec[Int] = Vec()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    defer k += 1000
    k += take(<a)
    match i % 3
      0
        for _ in 0..2
          while mk(?v, 0) as g
            continue :outer if g.s[0] > 0
      1
        j = 1
        while j < 4: j += odd(j) ?? continue :outer
          j += 1
      _
        j = 0
        while j < 3: j += 1
          continue :outer
  print(k, i)

sub leaves()
  v: Vec[Int] = Vec()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    defer k += 1000
    k += take(<a)
    j = 0
    while j < 3: j += 1
      break :outer if i == 3
      continue :outer
  print(k, i)

sub main()
  joined()
  joined_moves()
  catch_break()
  deep()
  leaves()

# expect:
# 25 5
# 21 5
# 21 5
# 5021 5
# 3011 3
