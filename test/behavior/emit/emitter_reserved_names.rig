# `os`, `rig`, and `std` name things in the emitted root module (a hook
# Zig's standard library looks up, the runtime, Zig's standard library),
# so Rig declarations and locals with those names are renamed in the Zig.

fun os(n: Int) -> Int
  n + 1

sub main()
  rig = os(1)
  std = rig * 10
  print(rig, std)

# expect:
# 2 20
