# Field reads and method calls through a struct's shared-handle field
# (`p.a.n`, `p.a.twice()`) auto-dereference the handle.

struct Wrap
  n: Int

  fun twice(self: ?Wrap) -> Int
    self.n * 2

struct Pair
  a: *Wrap

sub main()
  b = *Wrap(n: 4)
  p = Pair(a: <b)
  print(p.a.n)
  print(p.a.twice())

# expect:
# 4
# 8
