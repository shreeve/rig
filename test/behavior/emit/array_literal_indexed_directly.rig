# An array literal can be indexed where it is written, by a constant or
# a run-time index; its elements are evaluated once.

fun id(x: Int) -> Int
  print("id", x)
  x

sub main()
  print([id(1), 2][0], [3, 4][1], [5, 6].len)
  i = id(1)
  print([7, id(8)][i])

# expect:
# id 1
# 1 4 2
# id 1
# id 8
# 8
