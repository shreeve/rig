# Reassigning a binding, field, or `!T` parameter with a value that takes
# its type from context (`List()`, `.variant(...)`) works.

enum S
  one(k: Int)
  empty

obj H
  v: List[Int]

sub reset(v: !List[Int])
  v = List()

sub main()
  v: List[Int] = List()
  !v.push(1)
  v = List()
  print(v.len)
  h = H(v: List())
  h.v = List()
  reset(!v)
  s: S = .empty
  s = .one(k: 2)
  match s
    .one(k) => print(k)
    .empty => print(0)

# expect:
# 0
# 2
