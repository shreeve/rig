# An inner joined `:a` loop inside an outer `:a` loop: its `continue :a`
# goes through its own step.
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  q = 0
  m = 0
  :a while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    m = 0
    break :a if i > 50
    :a while mk(?v, m) as g and m >= 0: q += g.s[0]
      m += 1
      for _ in 0..2
        continue :a
  print("end", k, q, m)

# expect:
# end 3 9 3
