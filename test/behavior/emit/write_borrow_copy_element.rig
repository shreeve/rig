# A write borrow of a Copy value meets plain values as the value it
# reaches: an array element, an `if` branch, and a `match` arm read
# through it, whether the borrow is a name, `!m`, or a call's result.

struct S
  n: Int

  fun get(!self) -> !Int
    !self.n

sub main()
  m = 3
  q = !m
  a = [q, 4]
  b = if a[1] > 3
    q
  else
    0
  c = match a[0]
    3
      q
    else
      0
  print(a[0], a[1], b, c)

  s = S(n: 5)
  d = [!m, (!s).get(), 6]
  e = if d[2] > 3
    (!s).get()
  else
    1
  f = match d[2]
    6
      !m
    else
      2
  print(d[0], d[1], d[2], e, f)

# expect:
# 3 4 3 3
# 3 5 6 5 3
