# An array inside a Vec element is assignable, a nested array is too, and
# indexing a string a call returns evaluates the call once.

struct P
  a: [2]Int
  q: Q

struct Q
  z: Int

fun name() -> String
  print("called")
  "abc"

sub main()
  ps: Vec(P) = Vec()
  !ps.push(P(a: [1, 2], q: Q(z: 0)))
  ps[0].a[1] = 30
  ps[0].q.z = 5
  ps[0].a[0] += 7
  print(ps[0])
  grid = [[1, 2], [3, 4]]
  grid[1][0] = 9
  grid[0][1] += 1
  print(grid)
  i = [1][0]
  print(name()[i])

# expect:
# P(a: [8, 30], q: Q(z: 5))
# [[1, 3], [9, 4]]
# called
# 98
