# `print` reads a `Cell[*Vec[Int]]` when it is called: a later argument
# that drops the last handle the Cell held leaves the new one to print.
fun reset(c: ?Cell[*Vec[Int]]) -> Int
  c.set(*Vec[Int]())
  0

sub main
  v = Vec[Int]()
  for i in 0..40
    !v.push(i)
  c: Cell[*Vec[Int]] = Cell(*<v)
  print(c, reset(?c))

# expect:
# Cell(value: []) 0
