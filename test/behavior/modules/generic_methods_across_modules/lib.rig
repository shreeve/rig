pub fun same[T](x: T) -> T
  x

pub struct Tagger
  pub label: String

  pub sub show[T](?self, x: T)
    print(self.label, x)

fun local[T](x: T) -> T
  x

struct Inner
  n: Int

  pub fun same[U](?self, x: U) -> U
    x

pub struct Outer
  pub i: Inner

pub fun uses_local(n: Int) -> Int
  local(n)

pub fun make_outer(n: Int) -> Outer
  Outer(i: Inner(n: n))
