use util

pub obj Pair[T]
  pub a: T
  pub b: T

  pub fun twin(x: T) -> Pair[T]
    Pair(a: x, b: x)

pub type UP = util.Point
pub type US = util.Shade
pub type IP = Pair[Int]
pub type IV = List[Int]
pub type Real = F32

type R = F32

pub obj Limits
  pub hi: R = R.max
  pub lo: Real = Real.min
  pub small: util.Small = util.Small.min
  pub wide: util.Wide = util.Wide.max
