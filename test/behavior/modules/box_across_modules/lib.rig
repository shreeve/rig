pub obj Tree
  key: Int
  pub kids: List[^Tree]

  pub fun total(?self) -> Int
    t = self.key
    for k in ?self.kids
      t += k.total()
    t

pub fun leaf(key: Int) -> ^Tree
  ^Tree(key: key, kids: List())

pub obj Ticket
  n: Int

  pub fun redeem(<self) -> Int
    self.n

pub fun ticket(n: Int) -> ^Ticket
  ^Ticket(n: n)
