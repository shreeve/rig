# Every form a type argument of `@size`, `@align`, and `@name`
# can take: `Self`, an alias, an imported type, a builtin, and a type
# parameter.

use lib

struct P
  x: I64
  y: I64

  fun size(?self) -> Int
    @size(Self)

type P2 = P

struct Wrap[T]
  v: T

  fun size(?self) -> Int
    @size(T)

sub main()
  p = P(x: 1, y: 2)
  b: Wrap[U16] = Wrap(v: 7)
  print(@size(P2), p.size(), @size(lib.Q), @size(U8), b.size(), @name(Bool), @align(U16))

# expect:
# 16 16 8 1 2 Bool 2
