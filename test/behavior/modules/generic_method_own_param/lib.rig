pub obj Pair[A, B]
  pub a: A
  pub b: B

pub obj Chain[T]
  pub items: List[T]

  pub fun zip[U](?self, other: ?Chain[U]) -> Chain[Pair[T, U]]
    out: List[Pair[T, U]] = List()
    i = 0
    while i < self.items.len and i < other.items.len
      !out.push(Pair(a: self.items[i], b: other.items[i]))
      i += 1
    Chain(items: <out)

obj Wrap[T]
  v: T

  fun tag[U](?self, u: U) -> Wrap[Pair[T, U]]
    Wrap(v: Pair(a: self.v, b: u))

pub fun tagged[T](x: T) -> Int
  w = Wrap(v: x)
  t = w.tag(true)
  1 if t.v.b else 0
