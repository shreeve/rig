# Another module's public generics may use instances of their own types
# at a method's own parameter (`Chain[Pair[T, U]]` in `zip[U]`, and a
# private `Wrap[Pair[T, U]]` in `tag[U]`): these do not nest themselves.

use lib

sub main()
  a: List[Int] = List()
  !a.push(1)
  b: List[?String] = List()
  !b.push("x")
  l = lib.Chain(items: <a)
  m = lib.Chain(items: <b)
  z = ?l.zip(?m)
  print(z.items[0].a, z.items[0].b)
  print(lib.tagged(3))

# expect:
# 1 x
# 1
