# Imported resource types work in match payloads, List, and Cell, and
# each value is dropped once.

use lib

sub main()
  e = lib.mke(1)
  match e
    .one(b) => print("one", b.n)
    .two(k) => print(k)
  v: List[*lib.B] = List()
  !v.push(*lib.B(n: 2))
  c: *Cell[*lib.B] = *Cell(*lib.B(n: 3))

# expect:
# one 1
# drop 3
# drop 2
# drop 1
