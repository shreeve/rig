struct Wrap[T]
  pub v: T

  pub fun get(?self) -> T
    self.v

pub struct Holder
  pub b: Wrap[Int]

struct Slot[T]
  pub v: T

struct Q
  pub b: Slot[*Int]

pub struct P
  pub q: Q

  pub fun make() -> P
    P(q: Q(b: Slot(v: *41)))

struct Secret
  pub value: Int

pub struct Cover[T]
  pub inner: T

pub fun make(n: Int) -> Wrap[Int]
  Wrap(v: n)

pub fun holder() -> Holder
  Holder(b: Wrap(v: 4))

pub fun make_secret() -> Secret
  Secret(value: 42)

pub sub take_secret(s: Secret)
  print(s.value)

pub fun cover_secret(x: Int) -> Cover[Secret]
  Cover(inner: Secret(value: x))

pub fun uncover(w: Cover[Secret]) -> Int
  w.inner.value
