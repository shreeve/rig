pub fun zeros[n: Int] -> [n]Int
  [n of 0]

fun helper[m: Int] -> Int
  a = [m of 0]
  a.len

pub sub show[k: Int]
  print(helper[k]())

pub fun plain[k: Int] -> Int
  k

pub struct Maker
  x: Int

  fun zeros[n: Int] -> [n]Int
    [n of 0]

pub fun sum[n: Int](xs: [n]Int) -> Int
  t = 0
  for x in xs
    t += x
  t

pub struct Ring[T, n: Int]
  items: [n]T

  fun cap(?self) -> Int
    n
