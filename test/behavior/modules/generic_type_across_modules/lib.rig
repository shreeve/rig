pub obj Wrap[T]
  pub v: T
  pub count: Int = 1

  pub fun make(v: T) -> Self
    Wrap(v: v)

  pub fun get(?self) -> T
    self.v

  pub fun with[U](?self, u: U) -> Pair[T, U]
    Pair(first: self.v, second: u)

pub obj Pair[A, B]
  pub first: A
  pub second: B

pub enum Opt[T]
  some(value: T)
  nothing

  pub fun or(?self, d: T) -> T
    match self
      .some(value) => value
      .nothing => d
