# std.math's Float functions, from its Zig file.
use std.math

sub main()
  print(math.sqrt(16.0), math.sqrt(2.0) * math.sqrt(2.0) > 1.999)
  print(math.floor(-1.5), math.floor(2.0), math.ceil(1.2), math.ceil(-1.2))
  print(math.exp(0.0), math.ln(1.0), math.ln(math.exp(2.0)))
  print(math.sin(0.0), math.cos(0.0), math.sin(math.PI / 2.0))
  print(math.pow_f(2.0, 10.0), math.pow_f(4.0, 0.5))
  print(math.sqrt(-1.0) != math.sqrt(-1.0))

# expect:
# 4.0 true
# -2.0 2.0 2.0 -1.0
# 1.0 0.0 2.0
# 0.0 1.0 1.0
# 1024.0 2.0
# true
