# A Cell holds an `Rng`: `replace` hands back the old one, which moves.
use std.random

struct Game
  rng: random.Rng
  score: Int

sub main()
  c = Cell(random.Rng.seeded(1))
  r = c.replace(random.Rng.seeded(2))
  print(!r.next())
  g = Game(rng: random.Rng.seeded(7), score: 3)
  h = <g
  print(h.score, !h.rng.next() != 0)

# expect:
# 10451216379200822465
# 3 true
