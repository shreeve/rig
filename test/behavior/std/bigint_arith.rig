# BigInt's add, sub, mul, compare, and equals against Python's int:
# Go's sumZZ and prodZZ vectors, the values at limb boundaries paired
# every way, and random numbers of 1 to 9 limbs. Each line is a and b,
# then a + b, a - b, a * b, compare, and equals.
use std.bigint

sub show(x: ?String, y: ?String)!
  a = bigint.parse(x)!
  b = bigint.parse(y)!
  print(a.text(), b.text(), a.add(b).text(), a.sub(b).text(), a.mul(b).text(), a.compare(b), a.equals(b))

sub main()!
  # Go's sumZZ and prodZZ.
  show("0", "0")!
  show("1", "0")!
  show("123456789", "987654321")!
  show("-1", "0")!
  show("-123456789", "987654321")!
  show("-123456789", "-987654321")!
  show("991", "-991")!
  show("1234567890123456789", "-987654321")!
