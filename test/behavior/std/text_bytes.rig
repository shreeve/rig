# std.text's byte functions: ASCII classes and case, UTF-8 validity
# (`utf8.is_valid`), and `compare`, which orders Strings as `<` does.
use std.sort
use std.text
use std.utf8

sub classes(s: ?String)
  for b in s
    print(b, text.is_digit(b), text.is_alpha(b), text.is_space(b), text.to_upper(b), text.to_lower(b))

fun digits(s: ?String) -> Int
  n = 0
  for b in s
    if text.is_digit(b)
      n += 1
  n

sub main()
  # "0", "9", "/", ":", "a", "z", "A", "Z", "@", "[", "`", "{"
  classes("09/:azAZ@[`{")
  # space, tab, line feed, vertical tab, form feed, carriage return, and
  # the bytes either side of them
  classes(" \t\n\x0b\x0c\r\x08\x0e\x1f!")
  # the two bytes of "é", and 0xff
  classes("é\xff")
  print(digits("a1b22c333"), text.to_upper(text.to_lower(81)), text.to_lower(U8.max))

  ok = "h\xc3\xa9!"
  print(utf8.is_valid(ok), utf8.is_valid("h\xc3("), utf8.is_valid(""), utf8.is_valid("\xe2\x82"), utf8.is_valid("\xe2\x82\xac"))
  print(utf8.is_valid(ok[1..3]), utf8.is_valid(ok[2..]))
  print(utf8.is_valid("\xff"))

  print(text.compare("a", "b"), text.compare("b", "a"), text.compare("ab", "ab"), text.compare("", ""))
  print(text.compare("ab", "abc"), text.compare("abc", "ab"), text.compare("", "a"), text.compare("Z", "a"), text.compare("é", "z"))
  for pair in [["pear", "fig"], ["fig", "fig"], ["a", "ab"]]
    print((text.compare(pair[0], pair[1]) < 0) == (pair[0] < pair[1]))

  names = ["pear", "Fig", "apple", "fig", ""]
  sort.sort_by(!names, |a, b| text.compare(a, b) < 0)
  print(names)

# expect:
