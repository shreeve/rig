# An array holds `Rng`s, which are unique: a loop over a named array
# views or writes each in place, a loop over a made one owns each, and
# a discarded `Rng` is simply dropped.
use std.random

fun step(r: !random.Rng) -> U64
  !r.next()

sub show(r: ?random.Rng)
  print("view")

sub main()
  a: [2]random.Rng = [random.Rng.seeded(1), random.Rng.seeded(2)]
  for r in !a
    print(!r.next() != 0)
  for r in a
    show(r)
  random.Rng.seeded(3)
  _ = random.Rng.seeded(4)
  x = random.Rng.seeded(5)
  print(step(!x) != 0, step(!x) != 0)
  print(random.Rng.seeded(6).fork().int(1, 7) >= 1)
  for r in [random.Rng.seeded(7), random.Rng.seeded(8)]
    print(!r.int(1, 7) >= 1)
  b = <a
  print(!b[1].next() != 0)

# expect:
# true
# true
# view
# view
# true true
# true
# true
# true
# true
