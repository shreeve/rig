# BigInt's shl and shr against Python's << and >>, which rounds toward
# minus infinity as shr does, at and around every limb boundary, and
# pow against Python's **. Each line is the number, the shift, then
# a.shl(n) and a.shr(n); then the base, the power, and the result.
use std.bigint

sub main()!
  for x in ["0", "1", "-1", "5", "-5", "9223372036854775808", "18446744073709551615", "-18446744073709551615", "18446744073709551616", "-18446744073709551616", "-18446744073709551617", "340282366920938463463374607431768211455", "-340282366920938463463374607431768211455", "-340282366920938463463374607431768211456", "10000000000000000000000000000000000000003", "-10000000000000000000000000000000000000003"]
    a = bigint.parse(x)!
    for n in [0, 1, 37, 63, 64, 65, 127, 128, 129, 200]
      print(a.text(), n, a.shl(n).text(), a.shr(n).text())
  for b in ["-3", "-2", "-1", "0", "1", "2", "3", "7", "10", "18446744073709551615", "-9223372036854775808"]
    a = bigint.parse(b)!
    for e in [0, 1, 2, 3, 5, 10, 63, 64, 100]
      print(a.text(), e, a.pow(e).text())
  # Go's expTests without a modulus.
  print(bigint.parse("0x8000000000000000")!.pow(2).text())
  print(bigint.parse("0x8000000000000000")!.pow(3).text())
  print(bigint.parse("0x8000000000000000")!.pow(1000).bit_len())
  # Large powers: 2^100000 and 3^20000, by their size, low digits, and
  # nearest F64, which is infinite.
  big = bigint.from_int(2).pow(100000)
  print(big.bit_len(), big.sign(), big.to_f64(), big.text().len)
  three = bigint.from_int(-3).pow(20001)
  t = three.text()
  print(three.bit_len(), three.sign(), three.to_f64(), t.len, t[t.len - 10..])

