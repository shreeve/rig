# std.unicode's `is_space`: every value from -1 to 0x110000 is
# looked up, and the white space found is exactly the 25 runes of the
# White_Space property of Unicode 15.1 (PropList.txt), which Go's
# `unicode.IsSpace` reports. U+FEFF and U+180E, white space in some
# other definitions, are not.
# release
use std.text
use std.unicode

sub main()
  found = String()
  n = 0
  r = -1
  while r <= 0x110000 : r += 1
    if unicode.is_space(r)
      !found.add(",", text.format_int(r, 16))
      n += 1
  print(n)
  print(found)
  print(unicode.is_space(0xFEFF), unicode.is_space(0x180E), unicode.is_space(0x200B), unicode.is_space(Int.min))

# expect:
# 25
# ,9,a,b,c,d,20,85,a0,1680,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,200a,2028,2029,202f,205f,3000
# false false false false
