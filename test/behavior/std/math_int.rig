# std.math's integer helpers, written in Rig: `abs`, `min`, `max`, and
# `clamp` are generic over number types; `gcd`, `pow`, and `mod` take
# `Int`s.
use std.math

sub main()
  print(math.abs(-7), math.abs(7), math.abs(0), math.abs(-2.5), math.abs(I8(-3)))
  print(math.min(3, 9), math.max(3, 9), math.min(-1.5, 2.0), math.max("a", "b"))
  print(math.clamp(15, 0, 10), math.clamp(-3, 0, 10), math.clamp(4, 0, 10), math.clamp(0.5, 0.0, 0.25), math.clamp(5, 5, 5))
  print(math.gcd(12, 18), math.gcd(-12, 18), math.gcd(7, 0), math.gcd(0, 0))
  print(math.pow(3, 4), math.pow(-2, 3), math.pow(5, 0), math.pow(2, 62), math.pow(-2, 63))
  print(math.pow(2, -1), math.pow(1, -5), math.pow(-1, -3), math.pow(-1, -4))
  print(math.pow(1, Int.min), math.pow(-1, Int.min), math.pow(-1, Int.min + 1), math.pow(7, Int.min))
  print(math.mod(-7, 3), math.mod(7, -3), math.mod(-7, -3), math.mod(6, 3))
  print(math.PI, math.E)

# expect:
# 7 7 0 2.5 3
# 3 9 -1.5 b
# 10 0 4 0.25 5
# 6 6 7 0
# 81 -8 1 4611686018427387904 -9223372036854775808
# 0 1 -1 1
# 1 1 -1 0
# 2 -2 -1 0
# 3.141592653589793 2.718281828459045
