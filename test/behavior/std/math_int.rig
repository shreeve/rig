# std.math's integer helpers, written in Rig.
use std.math

sub main()
  print(math.abs(-7), math.abs(7), math.abs(0))
  print(math.clamp(15, 0, 10), math.clamp(-3, 0, 10), math.clamp(4, 0, 10))
  print(math.gcd(12, 18), math.gcd(-12, 18), math.gcd(7, 0), math.gcd(0, 0))
  print(math.pow(3, 4), math.pow(-2, 3), math.pow(5, 0), math.pow(2, 62))
  print(math.pow(2, -1), math.pow(1, -5), math.pow(-1, -3))
  print(math.mod(-7, 3), math.mod(7, -3), math.mod(-7, -3), math.mod(6, 3))
  print(math.PI, math.E)

# expect:
# 7 7 0
# 10 0 4
# 6 6 7 0
# 81 -8 1 4611686018427387904
# 0 1 -1
# 2 -2 -1 0
# 3.141592653589793 2.718281828459045
