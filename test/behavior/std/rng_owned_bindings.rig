# A binding an `Rng` moves into owns it and may write it: an `as`
# binding, a `match <e` payload, a binding of a moved parameter, and
# the value `Cell.replace` hands back.
use std.random

struct G
  r: random.Rng
  n: Int

enum Pick
  a(r: random.Rng)
  b

fun roll(r: random.Rng) -> U64
  g = <r
  !g.next()

sub main
  o: G? = G(r: random.Rng.seeded(1), n: 0)
  if <o as g
    g.n = 4
    print(!g.r.next() != 0, g.n)
  p: random.Rng? = random.Rng.seeded(1)
  if <p as r
    print(!r.next() != 0)
  print(roll(random.Rng.seeded(1)) != 0)
  e = Pick.a(r: random.Rng.seeded(2))
  match <e
    .a(r) => print(!r.next() != 0)
    .b => pass
  w = Cell(random.Rng.seeded(5))
  old = w.replace(random.Rng.seeded(6))
  print(!old.next() != 0)

# expect:
# true 4
# true
# true
# true
# true
