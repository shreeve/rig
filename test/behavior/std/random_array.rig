# An array holds `Random`s, which are unique: a loop over a named array
# views or writes each in place, a loop over a made one owns each, and
# a discarded `Random` is simply dropped.
use std.random

fun step(r: !random.Random) -> U64
  !r.next()

sub show(r: ?random.Random)
  print("view")

sub main()
  a: [2]random.Random = [random.Random.seeded(1), random.Random.seeded(2)]
  for r in !a
    print(!r.next() != 0)
  for r in a
    show(r)
  random.Random.seeded(3)
  _ = random.Random.seeded(4)
  x = random.Random.seeded(5)
  print(step(!x) != 0, step(!x) != 0)
  print(random.Random.seeded(6).fork().int(1, 7) >= 1)
  for r in [random.Random.seeded(7), random.Random.seeded(8)]
    print(!r.int(1, 7) >= 1)
  b = <a
  print(!b[1].next() != 0)

# expect:
# true
# true
# view
# view
# true true
# true
# true
# true
# true
