# UTF-16 surrogates: the two halves of a pair, the code point they make,
# and how many 16-bit units a code point takes.
use std.unicode

sub main()
  print(unicode.is_high_surrogate(0xD83D), unicode.is_low_surrogate(0xDE00))
  print(unicode.is_high_surrogate(0xD7FF), unicode.is_high_surrogate(0xDC00))
  print(unicode.is_low_surrogate(0xDBFF), unicode.is_low_surrogate(0xE000))
  print(unicode.surrogate_pair_to_code_point(0xD83D, 0xDE00) == 0x1F600)
  print(unicode.surrogate_pair_to_code_point(0xD800, 0xDC00) == 0x10000)
  print(unicode.surrogate_pair_to_code_point(0xDBFF, 0xDFFF) == 0x10FFFF)
  print(unicode.utf16_len(0x1F600), unicode.utf16_len(0xFFFF), unicode.utf16_len(0x61))
  print(unicode.utf16_len(0x10000), unicode.utf16_len(0x10FFFF), unicode.utf16_len(0xD800), unicode.utf16_len(0))

# expect:
# true true
# false false
# false false
# true
# true
# true
# 2 1 1
# 2 2 1 1
