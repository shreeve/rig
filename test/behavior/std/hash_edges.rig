# std.hash's Map, Set, and Symbols at the sizes where a table grows (one
# below, at, and one past each doubling), through takes before and
# after growth, `retain` rejecting one entry and many, `clear`, and
# `reserve`. After each step every key put is found or missing as it
# should be, and the walk and `at(i)` give the keys left in the order
# they were first put in, with `at(-1)` and `at(len)` none.

use std.hash

# Key `i` of a run: spread out, so neighbors do not share slots.
fun key(i: Int) -> Int
  i * 7919 + 3

# Whether `m` holds exactly key `x` for each `x` in `live`, in that
# order, with the value `x`, and no other key below `span`.
fun holds(m: ?hash.Map[Int, Int], live: ?List[Int], span: Int) -> Bool
  return false if m.len != live.len
  for x, n in ?live
    if m.get(key(x)) as v
      return false if v != x
    else
      return false
    if m.at(n) as k, v
      return false if k != key(x) or v != x
    else
      return false
  for i in [-1, live.len]
    if m.at(i) as k, v
      _ = k
      _ = v
      return false
  found = 0
  for x in 0..span
    found += 1 if m.has(key(x))
  return false if found != live.len
  n = 0
  for e in ?m.items()
    return false if n >= live.len or e.key != key(live[n])
    n += 1
  n == live.len

# Whether `s` holds exactly key `x` for each `x` in `live`, in that
# order, and no other key below `span`.
fun set_holds(s: ?hash.Set[Int], live: ?List[Int], span: Int) -> Bool
  return false if s.len != live.len
  found = 0
  for x in 0..span
    found += 1 if s.has(key(x))
  return false if found != live.len
  n = 0
  for k in ?s.items()
    return false if n >= live.len or k != key(live[n])
    n += 1
  n == live.len

# `live` without the keys `gone` is true for.
fun without(live: ?List[Int], gone: ?fun(Int) -> Bool) -> List[Int]
  out: List[Int] = List()
  for x in ?live
    !out.push(x) if not gone(x)
  out

fun third(x: Int) -> Bool
  x % 3 == 1

# One Map of `n` keys, through every edge; false at the first step that
# disagrees.
fun map_run(n: Int, reserve: Int) -> Bool
  m = hash.Map[Int, Int].new(capacity: reserve)
  live: List[Int] = List()
  return false if not holds(?m, ?live, 2 * n + 2)
  for i in 0..n
    !m.put(key(i), i)
    !live.push(i)
    return false if not holds(?m, ?live, 2 * n + 2)
  # Takes leave holes, which `at` counts past.
  for i in 0..n
    _ = (!m).take(key(i)) if third(i)
  live = without(?live, third)
  return false if not holds(?m, ?live, 2 * n + 2)
  return false if (!m).take(key(1)) != none
  # Puts past the size the Map had grow it, which drops the holes.
  for i in n..2 * n
    !m.put(key(i), i)
    !live.push(i)
  return false if not holds(?m, ?live, 2 * n + 2)
  # A key taken and put again goes to the end.
  if live.len > 0
    x = live[0]
    return false if (!m).take(key(x)) != x
    !m.put(key(x), x)
    live = without(?live, |+x, y| y == x)
    !live.push(x)
    return false if not holds(?m, ?live, 2 * n + 2)
  # `retain` rejecting one entry, then many.
  if live.len > 1
    y = live[live.len / 2]
    !m.retain(|+y, k, _| k != key(y))
    live = without(?live, |+y, z| z == y)
    return false if not holds(?m, ?live, 2 * n + 2)
  !m.retain(|k, _| k % 2 == 0)
  live = without(?live, |z| key(z) % 2 != 0)
  return false if not holds(?m, ?live, 2 * n + 2)
  # The table finds every key after the entries move down.
  for i in 2 * n..2 * n + 2
    !m.put(key(i), i)
    !live.push(i)
  return false if not holds(?m, ?live, 2 * n + 3)
  !m.clear()
  live = List()
  return false if not holds(?m, ?live, 2 * n + 3)
  for i in 0..n
    !m.put(key(i), i)
    !live.push(i)
  holds(?m, ?live, 2 * n + 3)

# One Set of `n` keys, through the same edges.
fun set_run(n: Int, reserve: Int) -> Bool
  s = hash.Set[Int].new(capacity: reserve)
  live: List[Int] = List()
  for i in 0..n
    return false if not (!s).add(key(i))
    !live.push(i)
    return false if not set_holds(?s, ?live, 2 * n)
  return false if n > 0 and (!s).add(key(0))
  for i in 0..n
    _ = (!s).take(key(i)) if third(i)
  live = without(?live, third)
  return false if not set_holds(?s, ?live, 2 * n)
  for i in n..2 * n
    _ = (!s).add(key(i))
    !live.push(i)
  return false if not set_holds(?s, ?live, 2 * n)
  if live.len > 1
    y = live[live.len / 2]
    !s.retain(|+y, k| k != key(y))
    live = without(?live, |+y, z| z == y)
    return false if not set_holds(?s, ?live, 2 * n)
  !s.retain(|k| k % 2 == 0)
  live = without(?live, |z| key(z) % 2 != 0)
  return false if not set_holds(?s, ?live, 2 * n)
  !s.clear()
  live = List()
  set_holds(?s, ?live, 2 * n)

# Symbols of `n` strings give ids 0 up, and find each again.
fun symbols_run(n: Int, reserve: Int) -> Bool
  t = hash.Symbols()
  !t.reserve(reserve) if reserve > 0
  for i in 0..n
    return false if (!t).intern(?String("s", i)) != U32(i)
    return false if (!t).intern(?String("s", i)) != U32(i)
  for i in 0..n
    return false if t.id(?String("s", i)) != U32(i)
    return false if t.text(U32(i)) != String("s", i)
  t.id("t") == none and t.len == n

sub main()
  sizes = [0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 64, 65, 300]
  maps: List[Bool] = List()
  sets: List[Bool] = List()
  syms: List[Bool] = List()
  for n in sizes
    !maps.push(map_run(n, 0) and map_run(n, n))
    !sets.push(set_run(n, 0) and set_run(n, n))
    !syms.push(symbols_run(n, 0) and symbols_run(n, n))
  print(maps)
  print(sets)
  print(syms)

# expect:
# [true, true, true, true, true, true, true, true, true, true, true, true, true, true]
# [true, true, true, true, true, true, true, true, true, true, true, true, true, true]
# [true, true, true, true, true, true, true, true, true, true, true, true, true, true]
