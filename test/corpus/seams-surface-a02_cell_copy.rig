struct Counter
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

sub via(c: Counter)
  !c.hit()
  !c.hit()
  print("param changed to", c.hits.get())

sub main()
  a = Counter(hits: Cell(0))
  b = <a
  b.hit()
  r = ?b
  r.hit()
  print(b.hits.get())
  via(<b)
  const f = Counter(hits: Cell(0))
  f.hit()
  print(f.hits.get())
