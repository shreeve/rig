obj S
  c: Cell[List[Int]]

obj O
  s: S

fun grow(s: !S) -> Int
  for i in 0..100
    !s.c.push(i)
  5

fun growc(c: !Cell[List[Int]]) -> Int
  for i in 0..100
    !c.push(i)
  5

sub x()
  pass

sub main()
  c = *Cell(List[Int]())
  c2 = +c
  print(c, growc(!c2))
  print(c if true else c, growc(!c2))
