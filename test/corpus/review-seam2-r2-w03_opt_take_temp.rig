# Review probe r2/w03_opt_take_temp.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
obj S
  n: Int
  items: List[Int]
  o: List[Int]?
  b: ^List[Int]

  drop(!self)
    print("drop", self.n, self.items, self.o)

fun mk(n: Int) -> S
  v: List[Int] = List()
  !v.push(n)
  w: List[Int] = List()
  !w.push(n * 10)
  S(n: n, items: <v, o: <w, b: ^List[Int]())

fun mkopt(n: Int) -> S?
  return none if n == 0
  mk(n)

fun f(n: Int) -> Int
  n

sub main()
  x = <(!mk(1)).o
  print(x)
  y = <(?mk(2)).o
  print(y)
