# A String sliced from a Text the holder owns, through `!self`, lends
# `self.src`: that field cannot change while the String is used, and the
# holder's other fields can (Core §5, "A field is a place of its own").

obj P
  src: String
  pos: Int

  fun word(!self) -> ?String
    w = ?self.src[..2]
    self.pos += 1
    w

sub main()
  p = P(src: String("abc"), pos: 0)
  a = (!p).word()
  print(a)
