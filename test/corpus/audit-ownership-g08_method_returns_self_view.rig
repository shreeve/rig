obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

obj Bag
  items: List[*Tok]

  fun first(?self) -> ?*Tok
    ?self.items[0]

sub main()
  b = Bag(items: List())
  !b.items.push(*Tok(n: 1))
  r = ?b.first()
  !b.items.clear()
  print(r.n)
