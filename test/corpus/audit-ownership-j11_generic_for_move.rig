struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun total[T](v: Vec[T], f: ?fun(?T) -> Int) -> Int
  s = 0
  for x in <v
    s += f(?x)
  s

fun score(t: ?*Tok) -> Int
  t.n

sub main()
  v: Vec[*Tok] = Vec()
  !v.push(*Tok(n: 1))
  !v.push(*Tok(n: 2))
  print(total(<v, score))
