struct Counter
  hits: Cell[Int] = Cell(0)

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

struct O
  k: Counter

sub each[T](x: ?T, n: Int, f: sub(?T))
  g = |?x, ?f| f(x)
  for i in 0..n
    g()

sub hitit(c: ?Counter)
  c.hit()

sub main()
  o = *O(k: Counter())
  each(?o.k, 3, hitit)
  print(o.k.hits.get())
