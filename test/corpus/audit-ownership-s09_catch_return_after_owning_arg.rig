struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

sub two(t: *Tok, n: Int)
  print("two", t.n, n)

fun run(k: Int) -> Int
  a = *Tok(n: 1)
  two(<a, fail(k) catch return -1)
  0

sub main()
  print(run(1))
  print(run(0))
