# subject vv[0][grow(!vv, ?Text("a"))]: the index grows the outer List while
# the element pointer of vv[0] may already be computed. Expect reject (or clean run).
fun grow(vv: !List[[2]Int?], s: ?String) -> Int
  for _ in 0..64
    !vv.push([1, 2])
  s.len - 1

sub main()
  vv: List[[2]Int?] = List()
  !vv.push([5, 6])
  if !vv[0][grow(!vv, ?String("a"))] as n
    n = 50
  print(vv[0], vv.len)
