# subject vv[0][grow(!vv, ?Text("a"))]: the index grows the outer Vec while
# the element pointer of vv[0] may already be computed. Expect reject (or clean run).
fun grow(vv: !Vec[[2]Int?], s: ?Text) -> Int
  for _ in 0..64
    !vv.push([1, 2])
  s.len - 1

sub main()
  vv: Vec[[2]Int?] = Vec()
  !vv.push([5, 6])
  if !vv[0][grow(!vv, ?Text("a"))] as n
    n = 50
  print(vv[0], vv.len)
