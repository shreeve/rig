obj Job
  id: Int
  drop(!self)
    print("free", self.id)

fun filter[T](xs: ?List[T], keep: ?fun(?T) -> Bool) -> List[T]
  out: List[T] = List()
  for x in xs
    if keep(?x)
      !out.push(x)
  out

fun largest[T](xs: ?List[T]) -> T?
  best: T? = none
  for x in xs
    if best as b
      best = x if x > b
    else
      best = x
  best

sub main()
  jobs: List[*Job] = List()
  !jobs.push(*Job(id: 1))
  !jobs.push(*Job(id: 2))
  keep = filter(?jobs, |j| j.id > 1)
  print(keep.len)
  print(largest(?jobs))
