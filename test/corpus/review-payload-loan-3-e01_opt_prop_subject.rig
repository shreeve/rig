obj P
  t: String

enum E
  a(w: !P)
  b

fun f(p: !P) -> Int?
  o: E? = E.a(!p)
  match o?
    .a(w)
      r = ?w.t[1..]
      if o as e2
        match !e2
          .a(k) => k.t = String("other")
          .b => pass
      w.t = String("x")
      print(r)
    .b => pass
  1

sub main()
  p = P(t: String("hello"))
  print(f(!p) ?? 0)
