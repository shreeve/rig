# H3: generic loop over ?List[T], body: if <x as y : take out of the T? loop binding
struct S
  t: Text

struct Holder[T]
  x: T?

fun grab[T](v: ?List[T?]) -> T?
  for x in v
    if <x as y
      return <y
  none

sub main()
  v: List[Text] = List()
  !v.push(Text("a"))
  !v.push(Text("b"))
  o: List[Text?] = List()
  !o.push(Text("q"))
  r = grab(?o)
  <o
  print(r)
