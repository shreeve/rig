# H3: generic loop over ?List[T], body: if <x as y : take out of the T? loop binding
obj S
  t: String

obj Holder[T]
  x: T?

fun grab[T](v: ?List[T?]) -> T?
  for x in v
    if <x as y
      return <y
  none

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  o: List[String?] = List()
  !o.push(String("q"))
  r = grab(?o)
  <o
  print(r)
