obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun pick(a: !E, b: !E, c: Bool) -> !E
  return a if c else b

sub main()
  e = mk(1)
  d = mk(2)
  match pick(!e, !d, false)
    .a(r)
      s = ?r.v[..]
      d = mk(9)
      print(s[0])
    .b => pass
