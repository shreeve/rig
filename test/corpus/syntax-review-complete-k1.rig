fun less(a: ?List[U8], b: ?List[U8]) -> Bool
  ?a[..] < ?b[..]

fun bytes(s: ?String) -> List[U8]
  v: List[U8] = List()
  for c in s
    !v.push(c)
  v

sub main()
  keys: List[^List[U8]] = List()
  !keys.push(^bytes("pear"))
  !keys.push(^bytes("apple"))
  for k in ?keys
    print(less(?k, ?k))
  a = bytes("a")
  b = bytes("b")
  print(less(?a, ?b), ?a[..] == ?b[..])
