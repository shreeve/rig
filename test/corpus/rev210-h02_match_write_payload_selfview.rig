# Reviewer probe for #210 (field loans): A `match !p.sl` payload given a
# view of `p.b`.

obj Holder
  t: ?String

enum Slot
  hold(h: Holder)
  empty

obj P
  hs: List[Holder]
  b: String
  sl: Slot
  o: Holder?

sub main()
  p = P(hs: List(), b: String("x"), sl: .hold(h: Holder(t: "")), o: Holder(t: ""))
  !p.hs.push(Holder(t: ""))
  match !p.sl
    .hold(h) => h.t = ?p.b
    .empty => pass
  p.b = String("zzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(p.sl)
