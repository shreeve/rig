# A write-view name target re-pointed inside the value, which then grows
# the old referent. The source stores through the new view (u[0]); the
# emitted `w.* = switch ...` takes `w` before the value runs.
fun grow(v: !Vec[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0]
  k = 0
  w = match k
    0
      w = !u[0]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

# expect:
# 7 201 201
