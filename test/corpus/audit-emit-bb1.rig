struct N
  id: Int
  drop(!self)
    print("drop N", self.id)

struct Reg
  log: Cell[Vec[Int]]
  cur: Cell[*N?]
  count: Cell[Int]

  sub note(?self, x: Int)
    self.log.push(x)
    self.count.set(self.count.get() + 1)

  sub swap_in(?self, n: *N)
    self.cur.set(<n)

fun peek(r: ?Reg) -> Int
  r.log[0] + r.log.len

struct Box2[T]
  c: Cell[T]

  sub put(?self, v: T)
    self.c.set(v)

  fun get(?self) -> T
    self.c.get()

sub main
  r = Reg(log: Cell(Vec()), cur: Cell(none), count: Cell(0))
  r.note(5)
  r.note(6)
  print(peek(?r), r.count.get())
  r.swap_in(*N(id: 1))
  r.swap_in(*N(id: 2))
  sh = *Reg(log: Cell(Vec()), cur: Cell(none), count: Cell(0))
  sh.note(9)
  sh2 = +sh
  sh2.note(10)
  print(sh.log.len, sh.log.pop(), sh.count.get())
  sh.log.clear()
  print(sh2.log.len)
  b = Box2(c: Cell(3))
  b.put(4)
  print(b.get())
  r.cur.set(none)
  print("end")
