# A take through a write lend of a shared handle, while another handle
# to the same box holds a view of the field.
obj S
  o: List[Int]?

fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

sub main()
  h = *S(o: mkv(1))
  h2 = +h
  x = <(!h).o
  print(x == none, h2.o == none)

# oracle: mkv accept
# oracle: main accept
