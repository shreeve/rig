struct Q
  n: Int

  sub bump(!self)
    self.n += 1

  fun get(?self) -> Int
    self.n

struct P
  x: Int
  o: Int?
  a: [2]Int
  v: Vec[Int]
  q: Q

fun mk() -> P
  P(x: 1, o: 3, a: [1, 2], v: Vec(), q: Q(n: 1))

fun id(n: Int) -> Int
  n

sub main()
  p = mk()
  r = P(x: (?p).x, o: none, a: (?p).a, v: Vec(), q: Q(n: (!p.a)[0]))
  print(r.x, r.a, r.q.n)
