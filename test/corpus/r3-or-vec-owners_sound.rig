# Containers of owners handed to generic code: a generic body that never
# copies a `T` serves a `T` that owns (SPEC "Generic bodies"), so
# `sort.sort_by` sorts a List of Texts, and `swap` exchanges owners
# (Core §5).
use std.sort

fun longer(a: ?String, b: ?String) -> Bool
  a.len > b.len

fun count[T](xs: ?List[T]) -> Int
  n = 0
  for x in xs
    n += 1
  n

fun last[T](xs: !List[T]) -> T?
  (!xs).pop()

obj Stack[T]
  items: List[T]

  sub push(!self, x: T)
    !self.items.push(<x)

  fun size(?self) -> Int
    self.items.len

sub sorted()
  v: List[String] = List()
  !v.push(String("ccc"))
  !v.push(String("a"))
  !v.push(String("bb"))
  sort.sort_by(!v, longer)
  print(v)
  !v.swap(0, 2)
  print(v, count(?v))
  if last(!v) as t
    print(t)

sub stacked()
  s: Stack[String] = Stack(items: List())
  !s.push(String("x"))
  !s.push(String("y"))
  print(s.size())

sub main()
  sorted()
  stacked()

# expect:
# ["ccc", "bb", "a"]
# ["a", "bb", "ccc"] 3
# ccc
# 2

# oracle: sorted accept
# oracle: stacked accept
# oracle: count accept
# oracle: last accept
