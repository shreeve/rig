pub error Bad
  neg

pub sub check(n: Int)!
  return Bad.neg if n < 0
  print("ok", n)

pub obj M
  v: Int

  sub bump(!self, k: Int)!
    return Bad.neg if k < 0
    self.v += k

pub obj W[T]
  item: T

pub obj Res
  items: List[Int]

pub obj D
  n: Int = 7

pub fun each(xs: []Int, f: ?sub(Int)!) -> Int!
  for x in xs
    f(x)!
  xs.len
