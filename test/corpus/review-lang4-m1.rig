obj Node
  items: List[Int]
  tag: *List[Int]

obj H
  w: !Node

  sub reset(!self, k: Int)
    fresh: List[Int] = List()
    !fresh.push(k)
    self.w = Node(items: <fresh, tag: *List())

  sub grow(!self)
    !self.w.items.push(1)

sub main()
  sh: *List[Int] = *List()
  node = Node(items: List(), tag: +sh)
  h = H(w: !node)
  i = 0
  while i < 5
    !h.reset(i)
    !h.grow()
    if i == 3
      break
    i += 1
  print(node.items)
