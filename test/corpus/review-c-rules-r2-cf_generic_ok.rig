# cf4e2c4b: a generic read result read in the same statement as the List.
obj Item
  n: Int

fun gfirst[T](v: !List[T]) -> ?T
  ?v[0]

fun count[T](v: ?List[T]) -> Int
  v.len

sub inner[T](v: !List[T])
  r = gfirst(!v)
  print(count(?v))
  print(count(?v), count(?v))
  _ = r

sub main()
  v: List[Item] = List()
  !v.push(Item(n: 7))
  print(gfirst(!v).n, v.len, count(?v))
  inner(!v)
