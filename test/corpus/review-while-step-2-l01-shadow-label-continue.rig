# A label repeating the enclosing one: the inner `:a for`'s `continue :a` targets the inner loop. The outer joined loop's body is wrapped in a block only when a continue targets it.
# Expected: accepted, prints `end 3 6` (k counts steps, j inner passes).
#
# oracle: mk accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  j = 0
  :a while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    break :a if i > 50
    :a for _ in 0..2
      j += 1
      continue :a
  print("end", k, j)
