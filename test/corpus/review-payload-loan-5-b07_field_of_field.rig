obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

obj GG
  g: G

obj G
  w: !E

sub f(h: !GG, k: !GG, c: Bool)
  match (h.g.w if c else k.g.w)
    .a(r0)
      s = ?r0.v[..]
      match !h.g.w
        .a(r)
          for i in 0..100
            !r.v.push(i)
        .b => pass
      print(s[0])
    .b => pass

sub main()
  e = mk(1)
  d = mk(2)
  h = GG(g: G(w: !e))
  k = GG(g: G(w: !d))
  f(!h, !k, true)
