obj Node
  key: Int
  left: ^Node?
  right: ^Node?

  drop(!self)
    print("drop", self.key)

sub insert(slot: !^Node?, key: Int)
  if !slot as n
    if key < n.key
      insert(!n.left, key)
    else
      insert(!n.right, key)
  else
    slot = ^Node(key: key, left: none, right: none)

sub walk(slot: ?^Node?)
  if slot as n
    walk(?n.left)
    print(n.key)
    walk(?n.right)

sub main()
  v: List[^Node] = List()
  !v.push(^Node(key: 1, left: none, right: none))
  for b in !v
    b.left = ^Node(key: 10, left: none, right: none)
    b = ^Node(key: 7, left: none, right: none)
  for b in ?v
    print("see", b.key, b.left == none)
