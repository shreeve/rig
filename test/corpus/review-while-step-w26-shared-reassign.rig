# A slice of a shared List; the body replaces the handle (the last one),
# freeing the List the step's slice views.
#
# oracle: all accept
# oracle: main reject C4
fun all(v: ?List[Int]) -> []Int
  ?v[..]

sub main()
  x = *List[Int]()
  s = all(?x)
  k = 0
  i = 0
  while i < 3: k += s.len
    x = *List[Int]()
    i += 1
  print(k)
