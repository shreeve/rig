error Bad
  oops

struct P
  x: Int

struct Q
  p: P
  n: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r


fun id[T](x: T, ok: Bool) -> T!
  return Bad.oops if not ok
  x

sub main
  a = P(x: 1)
  b = P(x: 2)
  v = id(?a, true) catch ?b
  u = id(?a, false) catch ?b
  n = 5
  m = 6
  i = id(?n, true) catch ?m
  print(v.x, u.x, i)
