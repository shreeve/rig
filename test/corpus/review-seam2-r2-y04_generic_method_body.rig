# Review probe r2/y04_generic_method_body.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.keep accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: mkh accept
# oracle: go reject C5
# oracle: main accept
obj S
  n: Int
  t: String

  drop(!self)
    print("dropS", self.n)

obj H
  rs: List[?String]

  sub keep(!self, r: ?String) keeps r
    !self.rs.push(r)

  drop(!self)
    print("dropH sees", self.rs)

fun mk(n: Int) -> S
  S(n: n, t: String("hello world, long enough to be on the heap"))

fun mkh() -> H
  H(rs: List())

sub go[T](x: T)
  !mkh().keep(?mk(1).t)

sub main()
  go(1)
  print("end")
