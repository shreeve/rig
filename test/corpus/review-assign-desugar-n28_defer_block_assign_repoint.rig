# A deferred block holding an assignment whose value's last arm
# re-points the target at the arm's local.
sub run(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  defer
    w[0] = match k
      1 => 4
      _
        u: Vec[Int] = Vec()
        !u.push(1)
        w = !u[0..1]
        3
  print(v[0])

sub main()
  run(0)
