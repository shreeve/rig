sub fill(v: !List[Int])
  !v.push(1)
  !v.push(2)

fun total(v: ?List[Int]) -> Int
  s = 0
  for x in v
    s += x
  s

fun first(a: ?[4]Int) -> Int
  a[0]

sub main()
  b = ^List[Int]()
  fill(!b)
  print(total(?b), b)
  arr = ^[4 of 7]
  print(first(?arr))
  s = ^"hi"
  print(s)
  v = <b.take()
  print(v.len)
