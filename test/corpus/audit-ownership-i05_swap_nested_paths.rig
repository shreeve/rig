struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct In
  t: *Tok

struct P
  a: In
  b: In

sub main
  p = P(a: In(t: *Tok(n: 1)), b: In(t: *Tok(n: 2)))
  swap(!p.a.t, !p.b.t)
  swap(!p.a, !p.b)
  print(p.a.t.n, p.b.t.n)
