obj S
  n: Int

fun get(s: ?S) -> Int
  s.n

fun first(s: ?String) -> ?String
  s[..1]

fun total(xs: []Int) -> Int
  t = 0
  for x in xs
    t += x
  t

fun maybe(s: (?S)?) -> Int
  if s as x
    return x.n
  -1

fun mname(s: (?String)?) -> ?String
  s ?? "none"

fun msl(xs: ([]Int)?) -> Int
  if xs as s
    return s.len
  -1

sub main()
  b3 = ^^^String("deep")
  print(first(b3))
  hb = *^S(n: 3)
  print(get(hb))
  ob: ^S? = ^S(n: 4)
  print(maybe(ob))
  oh: (*S)? = *S(n: 5)
  print(maybe(oh))
  ot: (*String)? = *String("ht")
  print(mname(ot))
  bo = ^String("bo")
  ob2: ^String? = <bo
  print(mname(ob2))
  hv = *^[1, 2, 3]
  print(total(hv))
  ov: ^List[Int]? = ^List()
  print(msl(ov))
  vv: List[Int] = List()
  !vv.push(2)
  bv = ^^<vv
  print(total(bv))
