# The value re-points the write-view name target; the store must go
# through the new view (u[0]), as for an element target (m23).
sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0]
  k = 0
  w = match k
    0
      w = !u[0]
      3
    _ => 4
  print(v[0], u[0])

# expect:
# 7 3
