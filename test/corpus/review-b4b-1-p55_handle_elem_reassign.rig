# read match through a handle element via temp index; arm replaces the element (dropping the last handle) then uses t. Expect reject.
enum E
  a(t: String)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  hs: List[*E] = List()
  !hs.push(*E.a(t: String("x")))
  match hs[idx(?String("a"))]
    .a(t)
      hs[0] = *E.b
      print(t)
    .b => pass
