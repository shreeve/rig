# Review probe c06_take_items.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
obj S
  n: Int
  items: List[Int]

  fun steal(!self) -> List[Int]
    replace(!self.items, List())

  fun into(<self) -> Int
    self.n

  fun at(!self) -> !Int
    !self.n

  fun rd(?self) -> Int
    self.n

  drop(!self)
    print("drop", self.n, self.items)

fun mk(n: Int) -> S
  s = S(n: n, items: List())
  !s.items.push(n)
  s

sub take(v: List[Int])
  print(v)

sub main()
  take(<!mk(1).items)
