obj S
  a: List[Int]
  b: Int

  fun count(?self, n: Int) -> Int
    self.a.len + n

fun grow(v: !List[Int]) -> Int
  !v.push(7)
  2

fun grows(s: !S) -> Int
  !s.a.push(7)
  2

fun growo(o: !List[Int]?) -> Int
  o = none
  2

sub main()
  s = S(a: List(), b: 1)
  print(s.count(grow(!s.a)))
  print(s.count(grows(!s)))
  !s.a.push(grow(!s.a))
  o: List[Int]? = List()
  print(o, growo(!o))
