# while-as: body re-points the view, then uses t, then moves old owner. Expect reject at the move or clean.
fun idx(s: ?String) -> Int
  s.len - 1

sub eat(v: List[String?])
  print(v.len)

sub main()
  a: List[String?] = List()
  !a.push(String("a"))
  b: List[String?] = List()
  !b.push(String("b"))
  r = ?a
  while r[idx(?String("a"))] as t
    r = ?b
    eat(<a)
    print(t)
    break
