use std.text

struct P
  t: Text
  n: Int

  fun get(?self) -> Int
    self.n

sub f(o: ?((!P)?), no: ?((!Int)?), so: ?((![]Int)?))
  if no as k
    m = match k
      5 => 1
      _ => 0
    print(m)

sub main()
  p = P(t: Text("hello"), n: 3)
  o: (!P)? = !p
  n = 5
  no: (!Int)? = !n
  a = [1, 2, 3]
  so: (![]Int)? = !a[..]
  f(?o, ?no, ?so)
