# The condition binds an owned List; the step reads it after the body.
# Emit: a native `while (c) |x| : (step)`; is `x` dropped before the
# step runs?
fun mk(i: Int) -> List[Int]?
  if i < 4
    v: List[Int] = List()
    !v.push(i + 10)
    !v.push(i + 20)
    return v
  none

sub main()
  k = 0
  i = 0
  while mk(i) as x: k += x[1]
    i += 1
    k += x[0]
  print(k, i)
