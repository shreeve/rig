# The fold: a String that views a Text slot (vec-store-assign): rejected where the Text changes or ends while it is used, or runs sanitizer-clean.
enum E
  full(t: String)
  empty

obj S
  name: ?String

obj H
  t: String

fun id[T](x: ?T) -> ?T from x
  x

fun first(v: ?List[String]) -> ?String from v
  ?v[0]

sub main()
  o = String("hello")
  vs: List[?String] = List()
  keep: ?String = ""
  !vs.push(?o)
  keep = vs[0]
  o = String("zzzz")
  print(keep)
