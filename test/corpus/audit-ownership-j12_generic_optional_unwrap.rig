struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun get[T](o: T?, d: T) -> T
  if <o as x
    return <x
  <d

sub main
  t = get(*Tok(n: 1), *Tok(n: 2))
  print(t.n)
  u = get(none, *Tok(n: 3))
  print(u.n)
