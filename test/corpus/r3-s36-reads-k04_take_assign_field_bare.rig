obj Bag
  n: Int
  v: List[Int]

  fun total(?self) -> Int
    self.n + self.v.len

fun mk(n: Int) -> Bag
  v: List[Int] = List()
  !v.push(n)
  Bag(n: n, v: <v)

fun size(b: ?Bag) -> Int
  b.n + b.v.len

sub eat(b: Bag)
  print(b.n)

obj Hold
  b: Bag

sub main()
  b = mk(1)
  h = Hold(b: mk(2))
  h.b = b
  print(h.b.n)
