obj Node[K, V]
  keys: List[K]
  vals: List[V]
  kids: List[^Node[K, V]]

  fun leaf() -> Self
    Node(keys: List(), vals: List(), kids: List())

  fun find(?self, k: K) -> V?
    i = 0
    while i < self.keys.len and self.keys[i] < k
      i += 1
    if i < self.keys.len and self.keys[i] == k
      return self.vals[i]
    return none if self.kids.len == 0
    j = 0
    for c in ?self.kids
      if j == i
        return c.find(k)
      j += 1
    none

sub main()
  n = Node[Int, ?String].leaf()
  !n.keys.push(3)
  !n.vals.push("three")
  print(n.find(3), n.find(4))
