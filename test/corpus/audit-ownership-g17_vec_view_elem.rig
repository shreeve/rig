obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

obj View
  b: ?Tok

sub main()
  x = Tok(n: 1)
  v: List[View] = List()
  !v.push(View(b: ?x))
  <x
  print(v.len)
