# A `defer` body is written at each exit it covers: one call of a helper
# the rule would inline there, at 1,200 exits, ran off the stack.
fun w(i: Int) -> Int
  t = [7000 of 0]
  for k in 0..7000
    t[k] = k + i
  t[i % 7000]

fun exits(i: Int) -> Int
  defer print(w(i))
  return 1 if i == 10001
  return 2 if i == 10002
  return 3 if i == 10003
