enum WV
  a(w: !List[String])
  b

obj H
  e: WV

fun mk(v: !List[String]) -> H from v
  H(e: WV.a(!v))

sub main()
  v: List[String] = List()
  !v.push(String("hello"))
  match mk(!v).e
    .a(w)
      r = ?w[0][1..]
      for _ in 0..50
        !w.push(String("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"))
      print(r)
    .b => pass
