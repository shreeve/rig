fun find(s: String, pat: String) -> Int?
  i = 0
  while i + pat.len <= s.len
    if s[i..i + pat.len] == pat
      return i
    i += 1
  none

struct Split
  rest: String
  sep: String
  done: Bool

  fun next(!self) -> String?
    return none if self.done
    at = find(self.rest, self.sep) ?? -1
    if at < 0
      self.done = true
      return self.rest
    part = self.rest[..at]
    self.rest = self.rest[at + self.sep.len..]
    part

struct Lines
  rest: String

  fun next(!self) -> String?
    return none if self.rest.len == 0
    end = find(self.rest, "\n") ?? -1
    if end < 0
      line = self.rest
      self.rest = ""
      return line
    line = self.rest[..end]
    self.rest = self.rest[end + 1..]
    strip_suffix(line, "\r") ?? line

struct Cut
  before: String
  after: String

fun strip_suffix(s: String, suffix: String) -> String?
  return none if suffix.len > s.len or s[s.len - suffix.len..] != suffix
  s[..s.len - suffix.len]

fun cut(s: String, sep: String) -> Cut?
  i = find(s, sep)?
  Cut(before: s[..i], after: s[i + sep.len..])

fun split(s: String, sep: String) -> Split
  Split(rest: s, sep: sep, done: false)

fun trim(s: String) -> String
  s

sub main()
  t = Text("a,b,c")
  it = split(?t, ",")
  a = !it.next()
  b = !it.next()
  print(a, b)
  while !it.next() as part
    print(part)
  c = cut(?t, ",")
  ls = Lines(rest: "x\r\ny")
  while !ls.next() as l
    print(l)
  w = trim(?t)
  print(c, w)
  !t.add("!")
  print(t)
