# The step grows `w` after the body's scope ends; a body `defer` reads a
# view of `w` taken in the body. The checker walks the defer before the
# step, so the view's loan has ended when the step grows `w`.
# Expected: accepted, prints `d 7` three times then `end`, sanitizer-clean.
#
# oracle: mk accept
# oracle: grow accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

fun grow(w: !Vec[Int]) -> Int
  for j in 0..64
    !w.push(j)
  0

sub main()
  v: Vec[Int] = Vec()
  !v.push(0)
  w: Vec[Int] = Vec()
  !w.push(7)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: k += h.s[0] + grow(!w)
    i += 1
    s = ?w[..]
    defer print("d", s[0])
  print("end", k, i, w.len)
