struct Res
  n: Int
  t: Text

enum E
  a(r: Res)
  b

sub f(a: !E, b: !E, c: Bool)
  match (a if c else b)
    .a(r)
      s = ?r.t[..]
      match !a
        .a(r2) => !r2.t.add("a much longer piece of text that forces the buffer to grow")
        .b => pass
      print(s)
    .b => pass

sub main()
  e = E.a(r: Res(n: 1, t: Text("x")))
  d = E.a(r: Res(n: 2, t: Text("y")))
  f(!e, !d, true)
