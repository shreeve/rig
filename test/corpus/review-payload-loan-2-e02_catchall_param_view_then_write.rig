obj P
  t: String

enum WP
  a(w: !P)
  b

sub put(e: !WP)
  match !e
    .a(w) => w.t = String("other")
    .b => pass

sub f(e: !WP)
  match e
    x
      r = ?x
      put(!e)
      match r
        .a(w) => print(w.t)
        .b => pass

sub main()
  p = P(t: String("hello"))
  e = WP.a(!p)
  f(!e)
