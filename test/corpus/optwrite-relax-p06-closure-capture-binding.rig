obj K
  a: ?String

  sub put(!self, v: ?String)
    self.a = v

enum E
  one(k: K)
  none

sub main()
  t = String("outer")
  e: E = .one(k: K(a: ?t))
  if true
    w = !e
    match !w
      .one(k: x)
        d = String("local")
        f = |!x, ?d| !x.put(d)
        f()
      .none => pass
  match e
    .one(k: y) => print(y.a)
    .none => pass
