# if v[idx(?Text("a"))] as c over Vec[C?]: header temporary + element subject; Cell change must land
struct C
  c: Cell[Int]

fun idx(s: String) -> Int
  s.len - 1

sub main
  v: Vec[C?] = Vec()
  !v.push(C(c: Cell(1)))
  if v[idx(?Text("a"))] as c
    c.c.set(5)
  if v[0] as c
    print(c.c.get())
