# if v[idx(?Text("a"))] as c over List[C?]: header temporary + element subject; Cell change must land
obj C
  c: Cell[Int]

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[C?] = List()
  !v.push(C(c: Cell(1)))
  if !v[idx(?String("a"))] as c
    !c.c.set(5)
  if v[0] as c
    print(c.c.get())
