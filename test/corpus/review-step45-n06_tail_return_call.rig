# fallible tail returned through return with owners live, errdefer
error Bad
  oops

fun g(n: Int) -> String!
  if n == 0
    return Bad.oops
  String("ok")

fun f(n: Int) -> String!
  t = String("held")
  errdefer print("errdefer", t)
  return g(n)

sub main()
  print(f(0) catch String("caught"))
  print(f(1) catch String("caught"))
