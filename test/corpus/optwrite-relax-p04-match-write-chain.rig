obj K
  a: ?String

  sub put(!self, v: ?String)
    self.a = v

enum E
  one(k: K)
  none

sub main()
  t = String("outer")
  e: E = .one(k: K(a: ?t))
  match !e
    .one(k: x)
      w = !x
      d = String("local")
      !w.put(?d)
    .none => pass
  match e
    .one(k: y) => print(y.a)
    .none => pass
