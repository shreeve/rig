obj Node
  n: Int

fun clear(ns: !List[*Node]) -> Int
  ns = List()
  0

fun reset(r: !*Node) -> Int
  r = *Node(n: 9)
  0

fun rebox(b: !^Int) -> Int
  b = ^5
  0

fun clears(ss: !List[?String]) -> Int
  ss = List()
  0

sub main()
  ns: List[*Node] = List()
  !ns.push(*Node(n: 1))
  rc = *Node(n: 1)
  print(rc, reset(!rc))
  b = ^3
  print(b, rebox(!b))
  ss: List[?String] = List()
  !ss.push("hi")
  print(ss[0], clears(!ss))
