# Review probe r2/w09_elem.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: mk accept
# oracle: mkopt accept
# oracle: f accept
# oracle: main reject C3
struct S
  n: Int
  items: Vec[Int]
  o: Vec[Int]?
  b: Box[Vec[Int]]

  drop(!self)
    print("drop", self.n, self.items, self.o)

fun mk(n: Int) -> S
  v: Vec[Int] = Vec()
  !v.push(n)
  w: Vec[Int] = Vec()
  !w.push(n * 10)
  S(n: n, items: <v, o: <w, b: Box(Vec[Int]()))

fun mkopt(n: Int) -> S?
  return none if n == 0
  mk(n)

fun f(n: Int) -> Int
  n

sub main()
  v: Vec[S] = Vec()
  !v.push(mk(1))
  x = <(!v)[0].items
  print(x)
  y = <(!v[0]).items
  print(y)
