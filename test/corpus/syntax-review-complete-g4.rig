struct Entry
  k: String
  v: Int

struct Map
  es: Vec[Entry]

  fun get(?self, k: String) -> (?Entry)?
    for e, i in self.es
      if e.k == k
        return ?self.es[i]
    none

fun lookup(m: ?Map, k: String) -> Int?
  m.get(k)?.v

sub main()
  m = Map(es: Vec())
  !m.es.push(Entry(k: "a", v: 1))
  print(lookup(?m, "a"), lookup(?m, "z"))
  print(m.get("a") != none)
