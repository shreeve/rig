obj H
  v: List[Int]

fun mk() -> List[Int]
  v: List[Int] = List()
  !v.push(3)
  v

sub walk(h: ?H, w: !List[Int])
  for x in h.v
    print(x)
  for x in w
    print(x)

sub main()
  h = H(v: List())
  !h.v.push(1)
  for x in ?h.v
    print(x)
  for i, x in ?h.v
    print(i, x)
  for x in mk()
    print(x)
  for x in h.v[..]
    print(x)
  sh: *H = *H(v: List())
  for x in sh.v
    print(x)
  walk(?h, !h.v)
