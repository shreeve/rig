# match on element whose payload holds a Cell: change must land in the element
obj C
  c: Cell[Int]

enum E
  a(x: C)
  b(n: Int)

sub main()
  v: List[E] = List()
  !v.push(E.a(x: C(c: Cell(1))))
  match !v[0]
    .a(x) if x.c.get() > 0 => (!x.c).set(7)
    .a(x) => (!x.c).set(9)
    .b(n) => print(n)
  match v[0]
    .a(x) => print(x.c.get())
    .b(n) => print(n)
