struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false
error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

sub main
  for j in 0..2
    v: Vec[*Tok] = Vec()
    for i in 0..3
      !v.push(*Tok(n: i + j * 10))
    :inner for t in <v
      continue if t.n == 0
      break
    print("j", j)
  print("end")
