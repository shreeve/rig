# read match through temp index, arm moves the owner then uses payload. Expect reject.
enum E
  a(t: Text)
  b(n: Int)

fun idx(s: ?Text) -> Int
  s.len - 1

sub eat(v: List[E])
  print(v.len)

sub main()
  v: List[E] = List()
  !v.push(E.a(t: Text("q")))
  match v[idx(?Text("a"))]
    .a(t)
      eat(<v)
      print(t)
    .b(n) => print(n)
