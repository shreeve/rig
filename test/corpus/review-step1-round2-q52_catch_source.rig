struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

error Bad
  oops

fun two(n: Int) -> ([2]Counter)!
  if n > 5
    return Bad.oops
  [Counter(hits: Cell(n)), Counter(hits: Cell(n))]

sub main()
  d = [Counter(hits: Cell(9)), Counter(hits: Cell(9))]
  for k in two(9) catch d
    k.hit()
  print(d[0].hits.get())
