# The fold: a String that views a Text slot (struct-store-assign): rejected where the Text changes or ends while it is used, or runs sanitizer-clean.
enum E
  full(t: Text)
  empty

struct S
  name: String

struct H
  t: Text

fun id[T](x: ?T) -> ?T from x
  x

fun first(v: ?List[Text]) -> ?Text from v
  ?v[0]

sub main()
  o = Text("hello")
  keep: String = ""
  s = S(name: ?o)
  keep = s.name
  o = Text("zzzz")
  print(keep)
