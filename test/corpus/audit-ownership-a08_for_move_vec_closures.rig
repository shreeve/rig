obj Bx
  c: Cell[Int]
  v: List[Int]

obj View
  b: ?Bx

sub main()
  outer: List[*sub()] = List()
  if true
    y = Bx(c: Cell(0), v: List())
    !y.v.push(42)
    vw = View(b: ?y)
    v: List[*sub()] = List()
    !v.push(*|<vw| print("read after free:", vw.b.v[0]))
    for f in <v
      !outer.push(<f)
  for g in ?outer
    g()
