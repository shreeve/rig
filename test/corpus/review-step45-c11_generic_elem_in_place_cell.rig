# generic body reading an element holding a Cell (T = C), calling a ?self method
struct C
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

sub each[T](v: ?Vec[T], f: ?sub(?T))
  for x in v
    f(x)

sub main
  v: Vec[C] = Vec()
  !v.push(C(c: Cell(1)))
  each(?v, |x| x.hit())
  print(v[0].c.get())
