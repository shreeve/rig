fun keep(s: String) -> String
  s

fun keepv(s: []Int) -> []Int
  s

enum E
  a(t: Text)
  b

sub main()
  e = E.a(Text("hello"))
  s = ""
  match !e
    .a(t) => s = keep(?t[1..])
    .b => pass
  match !e
    .a(t)
      for _ in 0..50
        !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    .b => pass
  print(s)
