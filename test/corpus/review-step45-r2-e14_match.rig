# H3: generic loop over ?List[T], body: match x on T? binding
struct S
  t: Text

struct Holder[T]
  x: T?

fun cnt[T](v: ?List[T?]) -> Int
  n = 0
  for x in v
    if x as y
      n += 1
  n

sub main()
  v: List[Text] = List()
  !v.push(Text("a"))
  !v.push(Text("b"))
  o: List[Text?] = List()
  !o.push(Text("q"))
  print(cnt(?o))
