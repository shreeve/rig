# H3: generic loop over ?List[T], body: match x on T? binding
obj S
  t: String

obj Holder[T]
  x: T?

fun cnt[T](v: ?List[T?]) -> Int
  n = 0
  for x in v
    if x as y
      n += 1
  n

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  o: List[String?] = List()
  !o.push(String("q"))
  print(cnt(?o))
