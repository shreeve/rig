# +l of a recursive Box list
enum Chain
  nil
  cons(head: Text, tail: ^Chain)

fun len(l: ?Chain) -> Int
  match l
    .nil => 0
    .cons(_, t) => 1 + len(?t)

sub main()
  l = List.cons(head: Text("a"), tail: ^List.cons(head: Text("b"), tail: ^List.nil))
  c = +l
  <l
  print(len(?c))
  match c
    .cons(h, _) => print(h)
    .nil => print("nil")
