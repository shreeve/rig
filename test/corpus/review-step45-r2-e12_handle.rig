# H3: generic loop over ?List[T], body: T = *S handle, return element (count)
obj S
  t: String

obj Holder[T]
  x: T?

fun first[T](v: ?List[T]) -> T?
  for x in v
    return x
  none

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  h: List[*S] = List()
  !h.push(*S(t: String("q")))
  r = first(?h)
  <h
  print(r)
