# H3: generic loop over ?List[T], body: T = *S handle, return element (count)
struct S
  t: Text

struct Holder[T]
  x: T?

fun first[T](v: ?List[T]) -> T?
  for x in v
    return x
  none

sub main()
  v: List[Text] = List()
  !v.push(Text("a"))
  !v.push(Text("b"))
  h: List[*S] = List()
  !h.push(*S(t: Text("q")))
  r = first(?h)
  <h
  print(r)
