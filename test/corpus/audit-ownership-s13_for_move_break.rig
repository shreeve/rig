obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

sub main()
  v: List[*Tok] = List()
  for i in 0..4
    !v.push(*Tok(n: i))
  for t in <v
    break if t.n == 1
    eat(<t)
  print("end")
