obj H
  name: String
  tags: List[Int]
  h: *Int
  o: ^String?

enum E
  a(t: String)
  b(n: Int)
  c

sub main()
  v: List[Int] = List()
  !v.push(1)
  w = +v
  !w.push(2)
  print(v.len, w.len)
  b = ^String("x")
  c = +b
  print(b, c)
  h = H(name: String("n"), tags: List(), h: *5, o: ^String("ob"))
  !h.tags.push(3)
  g = +h
  !g.tags.push(4)
  !g.name.add("!")
  print(h.name, h.tags, g.name, g.tags, g.h, g.o)
  vs: List[List[String]] = List()
  row: List[String] = List()
  !row.push(String("q"))
  !vs.push(<row)
  ws = +vs
  !ws[0][0].add("z")
  print(vs, ws, +vs[0])
  es: List[E] = List()
  !es.push(E.a(t: String("ea")))
  !es.push(E.b(n: 2))
  !es.push(.c)
  fs = +es
  print(fs.len)
  arr = [String("a1"), String("a2")]
  arr2 = +arr
  print(arr2)
  r = ?v
  print(+r)
