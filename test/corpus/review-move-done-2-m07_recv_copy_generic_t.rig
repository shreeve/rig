# Inside a generic body, a consuming receiver of type T itself.
obj P
  v: Int

  fun into(<self) -> Int
    self.v

obj HV
  v: List[Int]

  fun into(<self) -> Int
    self.v.len

fun twice[T](x: T) -> Int
  x.into() + x.into()

fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

sub main()
  print(twice(P(v: 1)))
  print(twice(HV(v: mkv(2))))

# oracle: P.into accept
# oracle: HV.into accept
# oracle: mkv accept
