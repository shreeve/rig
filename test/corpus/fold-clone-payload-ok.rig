# The fold: a String that views a Text slot (clone-payload-ok): rejected, or runs sanitizer-clean.
enum E
  full(t: String)
  empty

obj H
  t: String

sub main()
  e = E.full(t: String("hello"))
  keep = String("")
  match ?e
    .full(p) => keep = +p
    .empty => pass
  e = E.empty
  print(keep)
