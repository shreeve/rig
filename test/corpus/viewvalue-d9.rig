fun slot(v: !List[Int], i: Int) -> !Int from v
  !v[i]

fun sslot(v: !List[String], i: Int) -> !String from v
  !v[i]

sub apply(f: ?sub(!List[Int]), v: !List[Int])
  f(!v)

sub main()
  v: List[Int] = List()
  !v.push(1)
  bump = |w: !List[Int]|
    slot(!w, 0) += 41
  apply(?bump, !v)
  print(v)
  s: List[String] = List()
  !s.push(String("a"))
  if true
    defer sslot(!s, 0) = String("deferred")
    sslot(!s, 0) = String("body")
    print(s)
  print(s)
  for i in 0..3
    sslot(!s, 0) = String("loop", i)
    continue if i == 1
    slot(!v, 0) -= 1
  print(s, v)
