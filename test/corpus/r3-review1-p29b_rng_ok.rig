use std.random

struct Wrap[T]
  item: T

enum E
  a(r: random.Rng)
  b

sub main()
  w = Wrap(item: random.Rng.seeded(5))
  v = <w
  print(!v.item.next() % 10)
  e = E.a(r: random.Rng.seeded(5))
  match <e
    .a(r) => print(!r.next() % 10)
    .b => pass
  b = Box(random.Rng.seeded(5))
  print(!b.next() % 10)
  h = *random.Rng.seeded(5)
  g = +h
  print("h")
  o: random.Rng? = random.Rng.seeded(5)
  if !o as q
    print(!q.next() % 10)
  if <o as q
    print(!q.next() % 10)
  c = Cell(random.Rng.seeded(5))
  old = c.replace(random.Rng.seeded(6))
  print(!old.next() % 10)
