struct Node
  value: Int
  next: Box[Node]?

struct Stack
  top: Box[Node]?

  sub push(!self, v: Int)
    self.top = Box(value: Node(value: v, next: <self.top))

  fun pop(!self) -> Int?
    if <self.top as n
      self.top = <n.next
      return n.value
    none

  sub reverse(!self)
    cur = <self.top
    prev: Box[Node]? = none
    while <cur as n
      cur = <n.next
      n.next = <prev
      prev = <n
    self.top = <prev

sub main()
  s = Stack(top: none)
  i = 0
  while i < 300000 : i += 1
    !s.push(i)
  !s.reverse()
  print((!s).pop(), (!s).pop())
  j = 0
  while j < 1000 : j += 1
    _ = !s.pop()
  print((!s).pop())
