struct Random
  s: U64

  fun next(!self) -> U64
    self.s = self.s +% 0x9E3779B97F4A7C15
    z = self.s
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
    z ^ (z >> 31)

  fun below(!self, n: U64) -> U64
    !self.next() % n

sub main
  r = Random(s: 42)
  print(!r.below(100), !r.below(100))
