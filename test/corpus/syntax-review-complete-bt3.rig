obj Node
  keys: List[Int]
  kids: List[^Node]

sub main()
  root = Node(keys: List(), kids: List())
  !root.kids.push(^Node(keys: List(), kids: List()))
  !root.kids.insert(0, ^Node(keys: List(), kids: List()))
  x = (!root.kids).remove(0)
  !root.keys.push(3)
  !root.keys.insert(0, 1)
  print(root.keys)
