struct Node
  keys: Vec[Int]
  kids: Vec[Box[Node]]

sub main()
  root = Node(keys: Vec(), kids: Vec())
  !root.kids.push(Box(value: Node(keys: Vec(), kids: Vec())))
  !root.kids.insert(0, Box(value: Node(keys: Vec(), kids: Vec())))
  x = !root.kids.remove(0)
  !root.keys.push(3)
  !root.keys.insert(0, 1)
  print(root.keys)
