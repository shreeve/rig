# Review probe r2/w17_match_lends.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
struct S
  n: Int
  items: Vec[Int]
  o: Vec[Int]?
  b: Box[Vec[Int]]

  drop(!self)
    print("drop", self.n, self.items, self.o)

fun mk(n: Int) -> S
  v: Vec[Int] = Vec()
  !v.push(n)
  w: Vec[Int] = Vec()
  !w.push(n * 10)
  S(n: n, items: <v, o: <w, b: Box(Vec[Int]()))

fun mkopt(n: Int) -> S?
  return none if n == 0
  mk(n)

fun f(n: Int) -> Int
  n

sub main()
  s = mk(1)
  t = mk(2)
  k = f(1)
  x = <(match k
    1 => !s
    _ => !t).items
  print(x)
