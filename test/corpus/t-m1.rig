struct P
  x: Int
  y: Int

struct S
  a: Vec[Int]
  b: Int

  fun count(?self, n: Int) -> Int
    self.a.len + n

  sub add(!self, n: Int)
    !self.a.push(n)

fun grow(v: !Vec[Int]) -> Int
  !v.push(7)
  2

fun bump(p: !P) -> Int
  p.x += 1
  0

struct Q
  a: P
  b: Int

sub main()
  s = S(a: Vec(), b: 1)
  print(s.count(0), grow(!s.a), s.count(0))
  !s.add(s.count(0))
  !s.add(s.a.len)
  print(s.a)
  p = P(x: 1, y: 2)
  q = Q(a: p, b: bump(!p))
  print(q, p)
  o: Vec[Int]? = Vec()
  print(o, o)
