sub put[T](v: !List[T], x: T)
  (!v).push(<x)

obj Bag[T]
  items: List[T]

  sub add(!self, x: T)
    (!self).addraw(<x)

  sub addraw(!self, x: T)
    !self.items.push(<x)

  fun size(?self) -> Int
    (?self).count()

  fun count(?self) -> Int
    self.items.len

sub main()
  v = List[String]()
  put(!v, String("a"))
  b = Bag[String](items: List())
  (!b).add(String("x"))
  !b.add(String("y"))
  print(v.len, b.size())
