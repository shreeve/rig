sub put[T](v: !List[T], x: T)
  (!v).push(<x)

struct Bag[T]
  items: List[T]

  sub add(!self, x: T)
    (!self).addraw(<x)

  sub addraw(!self, x: T)
    !self.items.push(<x)

  fun size(?self) -> Int
    (?self).count()

  fun count(?self) -> Int
    self.items.len

sub main()
  v = List[Text]()
  put(!v, Text("a"))
  b = Bag[Text](items: List())
  (!b).add(Text("x"))
  !b.add(Text("y"))
  print(v.len, b.size())
