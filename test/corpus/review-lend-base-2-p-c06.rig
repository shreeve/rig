struct Q
  n: Int

  sub bump(!self)
    self.n += 1

  fun get(?self) -> Int
    self.n

struct P
  x: Int
  o: Int?
  a: [2]Int
  v: Vec[Int]
  q: Q

fun mk() -> P
  P(x: 1, o: 3, a: [1, 2], v: Vec(), q: Q(n: 1))

fun apply(f: ?fun(Int) -> Int, n: Int) -> Int
  f(n)

fun gapply[T](f: ?fun(T) -> T, n: T) -> T
  f(n)

sub run(f: ?sub(Int))
  f(1)

sub grun[T](f: ?sub(T), x: T)
  f(x)

sub main()
  p = mk()
  print(gapply(|?p, k|
    j = k
    (?p.a)[j]
  , 1))
