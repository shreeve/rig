# The fold: a String that views a Text slot (vec-store-drop): rejected where the Text changes or ends while it is used, or runs sanitizer-clean.
enum E
  full(t: Text)
  empty

struct S
  name: String

struct H
  t: Text

fun id[T](x: ?T) -> ?T from x
  x

fun first(v: ?Vec[Text]) -> ?Text from v
  ?v[0]

sub main()
  o = Text("hello")
  vs: Vec[String] = Vec()
  keep: String = ""
  !vs.push(?o)
  keep = vs[0]
  <o
  print(keep)
