struct Rec
  name: Text
  n: Int

sub main()
  v: List[Text] = List()
  t = Text("a")
  !v.push(<t)
  !v.push(Text("b"))
  print(v.len, v)
  rows: List[List[Int]] = List()
  r: List[Int] = List()
  !r.push(5)
  !rows.push(<r)
  print(rows.len)
  rs: List[Rec] = List()
  !rs.push(Rec(name: Text("x"), n: 1))
  print(rs.len)
  bs = [^1, ^2]
  print(bs)
  for x in v
    print(x)
  for b in bs
    print(b)
  if (!v).pop() as last
    print(last)
  print(v)
