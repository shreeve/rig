obj Rec
  name: String
  n: Int

sub main()
  v: List[String] = List()
  t = String("a")
  !v.push(<t)
  !v.push(String("b"))
  print(v.len, v)
  rows: List[List[Int]] = List()
  r: List[Int] = List()
  !r.push(5)
  !rows.push(<r)
  print(rows.len)
  rs: List[Rec] = List()
  !rs.push(Rec(name: String("x"), n: 1))
  print(rs.len)
  bs = [^1, ^2]
  print(bs)
  for x in v
    print(x)
  for b in bs
    print(b)
  if (!v).pop() as last
    print(last)
  print(v)
