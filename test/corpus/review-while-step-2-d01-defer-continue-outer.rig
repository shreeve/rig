# A defer cannot jump out of its scope. Expected: rejected.
#
# oracle: mk accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    for _ in 0..2
      defer continue :outer
  print(k)
