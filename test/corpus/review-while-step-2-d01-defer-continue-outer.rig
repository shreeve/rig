# A defer cannot jump out of its scope. Expected: rejected.
#
# oracle: mk accept
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  @outer while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    for _ in 0..2
      defer continue @outer
  print(k)
