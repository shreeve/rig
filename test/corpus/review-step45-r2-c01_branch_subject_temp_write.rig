# if (!v[idx(?Text("a"))] if c else !w) as t: branching subject, one leaf through a temp; grow t
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[String?] = List()
  !v.push(String("q"))
  w: String? = String("w")
  c = v.len == 1
  if (!v[idx(?String("a"))] if c else !w) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(v[0], w)
