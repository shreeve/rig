fun dbl(n: Int) -> Int
  n * 2

fun tpl(n: Int) -> Int
  n * 3

obj P
  x: Int
  items: List[Int]
  s: String
  f: fun(Int) -> Int

fun mk(n: Int) -> P
  v = List[Int]()
  !v.push(n)
  P(x: n, items: <v, s: String("hello"), f: dbl)

fun pick(p: ?P, ok: Bool) -> (?P)!
  return E.bad if not ok
  p

error E
  bad

sub main()
  a = [1, 2, 3]
  b = [4, 5, 6]
  p = mk(1)
  q = mk(2)
  v1 = List[Int]()
  !v1.push(7)
  !v1.push(8)
  v2 = List[Int]()
  !v2.push(9)
  !v2.push(10)
  t1 = String("abcdef")
  t2 = String("uvwxyz")
  c = true
  _ = c
  w = (!a if c else !b)
  (<w)[0] = 70
  print(a[0], a[2], b[1], b[2], p.x, q.x, p.items.len, q.items.len, v1.len, v2.len)
