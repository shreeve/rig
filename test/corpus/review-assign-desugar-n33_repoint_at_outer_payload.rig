# Valid: the value's last arm re-points the target at the payload of an
# outer value (`match !o`); the store lands there.
enum Bx
  has(v: Vec[Int])
  nothing

sub main()
  o = Bx.has(Vec())
  match !o
    .has(q) => !q.push(1)
    .nothing => pass
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  k = 0
  w[0] = match k
    1 => 4
    _
      match !o
        .has(p)
          w = !p[0..1]
          3
        .nothing => 5
  print(v[0])
  match o
    .has(p) => print(p[0])
    .nothing => pass

# expect:
# 7
# 3
