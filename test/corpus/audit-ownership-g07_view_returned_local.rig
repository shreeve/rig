struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct View
  b: ?Tok

fun mk() -> View
  x = Tok(n: 1)
  View(b: ?x)

sub main()
  v = mk()
  print(v.b.n)
