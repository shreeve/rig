obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

sub f(a: !List[Int], b: !List[Int], c: Bool)
  n = 0
  for x in (a if c else b)
    for i in 0..100
      !a.push(i)
    n += x
  print(n)

sub main()
  v: List[Int] = List()
  for i in 0..5
    !v.push(i + 1)
  u: List[Int] = List()
  f(!v, !u, true)
