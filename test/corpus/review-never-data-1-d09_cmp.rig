struct S
  c: Cell[Vec[Int]]

struct O
  s: S

fun grow(s: !S) -> Int
  for i in 0..100
    !s.c.push(i)
  5

fun growc(c: !Cell[Vec[Int]]) -> Int
  for i in 0..100
    !c.push(i)
  5

sub main()
  a = *O(s: S(c: Cell(Vec())))
  b = *O(s: S(c: Cell(Vec())))
  k = true
  _ = k
  !a.s.c.push(1)
  print(a.s.c.len == grow(!a.s))
