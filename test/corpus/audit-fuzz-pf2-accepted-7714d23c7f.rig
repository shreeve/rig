# Passing a held write view (a local or a view's field) on to a call
# or a constructor lends it, written `!w`: the result writes through it.

obj Ed
  t: !List[Int]

fun id(t: !List[Int]) -> !List[Int]
  t

sub main()
  v: List[Int] = List()
  if true
    w = !v
    r = id(!w)
    !r.push(4)
    e = Ed(t: <r)
    !e.t.push(5)
    f = Ed(t: !e.t)
    !f.t.push(6)
  print(v.len, v[0], v[2])

# expect:
# 3 4 6
