# write match on an optional element via a temp index (enum in an optional in a Vec). Expect accept, clean.
enum E
  a(t: Text)
  b

fun idx(s: ?Text) -> Int
  s.len - 1

sub main()
  v: Vec[E?] = Vec()
  !v.push(E.a(t: Text("x")))
  if !v[idx(?Text("a"))] as e
    match !e
      .a(t) => !t.add("y")
      .b => pass
  print(v)
