# write match on an optional element via a temp index (enum in an optional in a List). Expect accept, clean.
enum E
  a(t: String)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[E?] = List()
  !v.push(E.a(t: String("x")))
  if !v[idx(?String("a"))] as e
    match !e
      .a(t) => !t.add("y")
      .b => pass
  print(v)
