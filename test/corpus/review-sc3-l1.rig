struct Res
  id: Int

  drop(!self)
    print("drop", self.id)

fun make(k: Int) -> Res?
  Res(id: k) if k > 0 else none

sub main
  xs: Vec[Int] = Vec()
  for n in 1..5
    !xs.push(n)
  :outer while !xs.pop() as x and make(x) as r
    for j in 0..3
      continue :outer if j == 1 and x == 4
      break :outer if x == 2
      print(x, j, r.id)
  else
    print("else")
  print("done", xs.len)
