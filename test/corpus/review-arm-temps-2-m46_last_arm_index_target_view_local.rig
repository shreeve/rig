# The target's index reads a view the last arm re-points at an arm-local List.
sub main()
  v: List[Int] = List()
  !v.push(2)
  t: List[Int] = List()
  for _ in 0..5
    !t.push(0)
  w = ?v[0..1]
  k = 0
  t[w[0]] = match k
    1 => 4
    _
      u: List[Int] = List()
      !u.push(3)
      w = ?u[0..1]
      9
  print(t[2], t[3])
