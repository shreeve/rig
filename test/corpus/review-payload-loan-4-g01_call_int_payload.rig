obj P
  t: String

enum F
  a(n: Int)
  s(t: String)
  w(p: !P)
  v(xs: List[Int])
  b

fun getf(f: !F) -> !F
  f

sub main()
  f = F.a(5)
  match getf(!f)
    .a(n)
      n += 10
    _ => pass
  print(f)
  g = F.s(String("hi"))
  c = true
  match (!g if c else !f)
    .s(t) => !t.add(" there")
    _ => pass
  print(g)
  p = P(t: String("pp"))
  h = F.w(!p)
  match getf(!h)
    .w(q) => q.t = String("qq")
    _ => pass
  match h
    .w(q) => print(q.t)
    _ => pass
  vv: List[Int] = List()
  !vv.push(1)
  k = F.v(<vv)
  match getf(!k)
    .v(xs)
      xs[0] = 100
      !xs.push(3)
    _ => pass
  print(k)
