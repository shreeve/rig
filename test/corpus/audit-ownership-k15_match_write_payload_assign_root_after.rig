enum Tree
  leaf(v: Int)
  node(l: ^Tree, r: ^Tree)

sub prune(t: !Tree)
  match !t
    .node(l, _)
      print("x")
      t = .leaf(v: 5)
    .leaf(v) => v += 1

sub main()
  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.leaf(v: 3))
  prune(!t)
  match t
    .leaf(v) => print(v)
    _ => print("node")
