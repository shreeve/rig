error Bad
  neg

obj Node
  v: Int

obj Bag
  items: List[*Node]

  sub eat(<self, k: Int)!
    return Bad.neg if k < 0
    print("ate", self.items.len)

sub chk(n: Int)!
  return Bad.neg if n < 0

sub f(n: Int, keep: List[Int])!
  v = List[*Node]()
  !v.push(*Node(1))
  return Bad.neg if n < 0
  chk(n - 5)!
  print("f ok", v.len, keep.len)

sub main()
  k = List[Int]()
  !k.push(1)
  f(-1, <k) catch |e|
    print("e", e)
  k2 = List[Int]()
  f(1, <k2) catch |e|
    print("e", e)
  k3 = List[Int]()
  f(9, <k3)!
  b = Bag(List())
  !b.items.push(*Node(2))
  <b.eat(-1) catch |e|
    print("e", e)
  b2 = Bag(List())
  <b2.eat(1)!
  x = ^*Node(3)
  y = ^Bag(List())
  print(x, y)
