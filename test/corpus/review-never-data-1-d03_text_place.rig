obj S
  c: Cell[List[Int]]

obj O
  s: S

fun grow(s: !S) -> Int
  for i in 0..100
    !s.c.push(i)
  5

fun growc(c: !Cell[List[Int]]) -> Int
  for i in 0..100
    !c.push(i)
  5

sub main()
  a = *O(s: S(c: Cell(List())))
  b = *O(s: S(c: Cell(List())))
  k = true
  _ = k
  a2 = +a
  !a.s.c.push(1)
  print(String(a.s, grow(!a2.s)))
