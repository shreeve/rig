obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main()
  v: List[*Tok] = List()
  !v.push(*Tok(n: 1))
  !v.push(*Tok(n: 2))
  keep: List[*Tok] = List()
  while (!v).pop() as t
    !keep.push(<t)
  print(keep.len)
