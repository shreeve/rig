obj Player
  name: ?String
  scores: List[Int]

fun name_of(p: ?Player) -> ?String
  p.name

sub main()
  ps: List[^Player] = List()
  !ps.push(^Player(name: "a", scores: List()))
  print(name_of(?ps[0]))
  q = !ps[0]
  !q.scores.push(1)
  hs: List[*Player] = List()
  !hs.push(*Player(name: "b", scores: List()))
  h = +hs[0]
  print(h.name)
