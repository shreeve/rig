struct Player
  name: String
  scores: Vec[Int]

fun name_of(p: ?Player) -> String
  p.name

sub main()
  ps: Vec[^Player] = Vec()
  !ps.push(^Player(name: "a", scores: Vec()))
  print(name_of(?ps[0]))
  q = !ps[0]
  !q.scores.push(1)
  hs: Vec[*Player] = Vec()
  !hs.push(*Player(name: "b", scores: Vec()))
  h = +hs[0]
  print(h.name)
