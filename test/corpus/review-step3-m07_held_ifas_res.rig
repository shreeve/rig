obj Res
  n: Int
  t: String

  drop(!self)
    print("drop", self.n)

obj Bag
  o: Res?
  p: Res?

fun mk(n: Int) -> Bag
  Bag(o: Res(n: n, t: String("a")), p: none)

sub main()
  keep = Res(n: 0, t: String("k"))
  saved = ?keep
  if mk(1).o as r
    print("in", r.n)
    saved = r
  print(saved.n)
