struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct Ed
  t: !Tok

sub main
  x = Tok(n: 1)
  e = Ed(t: !x)
  e.t.n = 5
  print(x.n)
  e.t.n = 6
