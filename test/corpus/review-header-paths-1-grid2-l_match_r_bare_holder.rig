obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

obj Q
  e: E
  o: E?
  v: List[Int]

obj W
  e: E
  o: E?
  v: List[Int]
  q: Q?

  fun ge(?self) -> ?E
    ?self.e

  fun gv(?self) -> ?List[Int]
    ?self.v

  fun go(?self) -> ?(E?)
    ?self.o

  fun gew(!self) -> !E
    !self.e

  fun gvw(!self) -> !List[Int]
    !self.v

obj H
  w: !W

fun mkv(n: Int) -> List[Int]
  v: List[Int] = List()
  for i in 0..n
    !v.push(i + 1)
  v

fun mkw(n: Int) -> W
  W(e: mk(n), o: mk(n + 10), v: mkv(n), q: Q(e: mk(n + 20), o: mk(n + 30), v: mkv(n)))

fun id[T](x: T) -> T
  x

obj HB
  w: !E

fun f(h1: HB, h2: HB, c: Bool) -> Int?
  match ?(h1.w if c else h2.w)
    .a(r)
      s = ?r.v[..]
      h1.w = mk(99)
      print(s[0])
    .b => pass
  1

sub main()
  x: E = mk(3)
  y: E = mk(3)
  _ = f(HB(w: !x), HB(w: !y), true)
