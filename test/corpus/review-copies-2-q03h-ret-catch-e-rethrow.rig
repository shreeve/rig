error Bad
  oops

struct P
  x: Int

struct Q
  p: P
  n: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r

fun two(r: ?P, ok: Bool) -> (?P)!
  get(r, ok) catch |e| return e

sub main()
  a = P(x: 1)
  b = P(x: 2)
  v = two(?a, true) catch ?b
  u = two(?a, false) catch |e| (?b if e == Bad.oops else ?a)
  print(v.x, u.x)
