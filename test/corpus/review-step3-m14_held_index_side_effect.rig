struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

struct H
  arr: [2]Counter

fun idx(n: Int) -> Int
  print("idx", n)
  n

fun mk() -> H
  print("mk")
  H(arr: [Counter(hits: Cell(0)), Counter(hits: Cell(5))])

sub main
  match mk().arr[idx(1)].hits.get()
    5 => print("five")
    _ => print("other")
  for k in [mk().arr, mk().arr][idx(0)]
    k.hit()
    print(k.hits.get())
