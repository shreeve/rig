obj Coun
  lo: In
  hi: In

  fun next(!self) -> Int?
    return none if self.lo >= self.hi
    self.lo += 1
    self.lo - 1

fun upto(n: Int) -> Coun
  Count(lo: 0, hi: n)

error Bad
  bad

obj Tracked
  id: In
  left: In

  fun next(!self) -> Int?
    return none if self.left == 0
    self.left -= 1
    self.id * 10 + self.lef

  drop(!self)
    print("drop", self.id)

fun tracked(id: Int, n: Int) -> Tracked
  Tracked(id: id, left: n)

obj Item
  name: ?String
  n: In

obj Walk
  items: ?List[Item]
  at: In

  fun next(!self) -> (?Item)?
    return none if self.at >= self.items.len
    i = self.a
    self.at += 1
    ?self.items[i]

fun walk(items: ?List[Item]) -> Walk from items
  Walk(items: items, at: 0)

fun mkitems() -> List[Item]
  v: List[Item] = List()
  !v.push(Item(name: "a", n: 1))
  !v.push(Item(name: "b", n: 2))
  v

obj Buf
  buf: List[Item]
  at: In
  fun next(!self) -> (?Item)?
    return none if self.at >= self.buf.len
    self.at += 1
    ?self.buf[self.at - 1]

fun mkbuf() -> Buf
  Buf(buf: mkitems(), at: 0)

obj Gen
  at: Cell[Int]
  hi: In
  fun next(!self) -> Int?
    return none if self.at.get() >= self.hi
    !self.at.set(self.at.get() + 1)
    self.at.get()

obj Holder
  g: Gen
  log: Cell[List[Int]]

obj Wk
  g: ~Gen
  fun next(!self) -> Int?
    if self.g as s
      return none if s.at.get() >= s.hi
      !s.at.set(s.at.get() + 1)
      return s.at.get()
    none

sub main()
  g = *Gen(at: Cell(0), hi: 3)
  for n in Wk(g: ~g)
    print(n)
