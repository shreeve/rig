pub struct Wrap[T]
  v: T

  fun get(?self) -> T
    self.v

pub fun f0[T](a: T, b: T) -> Int
  if a > b
    1
  else
    0

pub fun g0[T](x: T) -> Wrap[T]
  Wrap(v: x)

pub fun f1[T](a: T, b: T) -> Int
  f0(a, b) + 1

pub fun g1[T](x: T) -> Wrap[T]
  Wrap(v: x)

