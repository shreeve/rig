# temp in a `defer` body, and a hoisted call (keyword arguments out of
# order) in a `defer` body with a Text temporary lent as `?String`.
fun g(k: Int) -> Int
  k

fun pick(s: ?String, n: Int) -> ?String
  s

sub main()
  defer print(pick(n: g(1), s: ?String("deferred text that is long enough for the heap")))
  defer print(pick(?String("deferred 2 text that is long enough for the heap"), 1))
  print("body")
