# A labeled block's break leaves a scope; a view of a var declared
# in it, stored into an outer var before the break, must be reported.
obj R
  n: Int
  drop(!self)
    print("drop", self.n)

obj V
  r: ?R

sub main()
  keep = R(n: 0)
  v = V(r: ?keep)
  @blk match 1
    1
      inner = R(n: 7)
      v = V(r: ?inner)
      break @blk
    _ => print("x")
  print(v.r.n)
