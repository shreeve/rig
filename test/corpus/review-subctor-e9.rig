obj Node
  v: Int

sub main()
  a: *Cell[*Node?] = *Cell(none)
  old = (!a).replace(*Node(3))
  print(old)
  w: *Cell[~Node?] = *Cell(none)
  c = Cell[List[Int]](List())
  print(c)
  d: Cell[List[Int]] = Cell(List())
  print(d)
  n = *Node(4)
  e = Cell(<n)
  f = Cell(e.replace(*Node(1)))
  print(f)
