struct Obj
  n: Int
  home: ~Cell[*Obj?]

  drop(!self)
    print("drop", self.n)
    if self.home.upgrade() as h
      !h.set(none)

sub main()
  c: *Cell[*Obj?] = *Cell(none)
  !c.set(*Obj(n: 1, home: ~c))
  !c.set(*Obj(n: 2, home: ~c))
  print("after set", (!c).replace(none) == none)
  print("end")
