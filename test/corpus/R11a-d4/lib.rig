error Oops
  bad

pub fun check[T](x: T, ok: Bool) -> T!
  if not ok
    <x
    return Oops.bad
  x

pub obj Bag[T]
  items: List[T]
  name: ?String = "bag"

  sub push(!self, x: T)
    !self.items.push(<x)

  fun take(!self) -> List[T]
    out = List[T]()
    while self.items.len > 0
      if (!self.items).pop() as x
        !out.push(<x)
    out

  fun size(?self) -> Int
    self.items.len

pub obj Holder[T]
  v: T

  fun done(self: Self) -> Int
    7
