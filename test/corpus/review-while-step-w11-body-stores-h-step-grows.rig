# oracle: mk accept
# oracle: main reject C4

struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 40
    return S(s: ?v[..])
  none

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  e: Vec[Int] = Vec()
  !e.push(0)
  last = S(s: ?e[..])
  k = 0
  i = 0
  while mk(?v, i) as h: !v.push(2)
    last = h
    i += 1
    k += last.s[0]
  print(k, last.s[0])
