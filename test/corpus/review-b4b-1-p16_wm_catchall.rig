# write match on List element with a catch-all binding the whole element, then assigning it. Expect accept, clean.
enum E
  a(n: Int, t: String)
  b

sub main()
  v: List[E] = List()
  !v.push(E.b)
  !v.push(E.a(n: 1, t: String("v")))
  i = 0
  match !v[i]
    .a(n, _) => n += 1
    x => x = E.a(n: 7, t: String("new"))
  match !v[1]
    x => x = E.b
  print(v[0], v[1])
