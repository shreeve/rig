# A `continue @a` in loop `@a`'s own `else`, which runs after the loop:
# the loop has ended, so the jump cannot target it. Expected: rejected,
# or `continue @a` must mean something the emitted code does.
#
# oracle: mk accept
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  for _ in 0..2
    i = 0
    @a while mk(?v, i) as h and i >= 0: k += h.s[0]
      i += 1
    else
      n += 1
      continue @a
    k += 100
  print("end", k, n)
