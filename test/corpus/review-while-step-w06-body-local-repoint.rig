# The body re-points an outer view at a body-local Vec, which drops
# at the body's end; the step then reads the view.
#
# oracle: main reject C5
sub main
  w: Vec[Int] = Vec()
  !w.push(7)
  s = ?w[..]
  k = 0
  i = 0
  while i < 3: k += s[0]
    local: Vec[Int] = Vec()
    !local.push(i)
    s = ?local[..]
    i += 1
  print(k)
