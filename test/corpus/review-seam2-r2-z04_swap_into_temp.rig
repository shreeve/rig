# Review probe r2/z04_swap_into_temp.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: mkh accept
# oracle: main reject C5
obj S
  n: Int
  t: String

  drop(!self)
    print("dropS", self.n)

obj H
  r: ?String

  sub set(!self, s: ?String) keeps s
    self.r = s

  drop(!self)
    print("dropH sees", self.r)

fun mk(n: Int) -> S
  S(n: n, t: String("hello world, long enough to be on the heap ", n))

fun mkh() -> H
  H(r: "init")

sub main()
  !mkh().set(?mk(1).t)
  print("end")
