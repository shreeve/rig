# Review probe r2/z04_swap_into_temp.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: mkh accept
# oracle: main reject C5
struct S
  n: Int
  t: Text

  drop(!self)
    print("dropS", self.n)

struct H
  r: String

  drop(!self)
    print("dropH sees", self.r)

fun mk(n: Int) -> S
  S(n: n, t: Text("hello world, long enough to be on the heap ", n))

fun mkh -> H
  H(r: "init")

sub main
  _ = replace(!mkh().r, ?mk(1).t)
  print("end")
