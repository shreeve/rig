obj Set
  items: List[Int]

  fun insert(!self, k: Int) -> Bool
    !self.items.push(k)
    true

  fun count(?self) -> Int
    self.items.len

  sub put[k: Int](!self, x: Int)
    !self.items.push(x * k)

obj Q
  n: Int

  sub bump(!self)
    self.n += 1

  fun get(?self) -> Int
    self.n

obj P
  x: Int
  o: Int?
  a: [2]Int
  v: List[Int]
  q: Q
  s: Set

fun mk() -> P
  P(x: 1, o: 3, a: [1, 2], v: List(), q: Q(n: 1), s: Set(items: List()))

sub main()
  q = Q(n: 1)
  (<(!q)).bump()
  print(q.n)
