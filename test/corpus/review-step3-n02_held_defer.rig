obj Noisy
  n: Int

  drop(!self)
    print("drop", self.n)

obj Counter
  hits: Cell[Int]

obj H
  arr: [2]Counter
  z: Noisy

enum E
  a(c: Counter, z: Noisy)
  b

obj HE
  e: E

fun mk(n: Int) -> H
  H(arr: [Counter(hits: Cell(n)), Counter(hits: Cell(n + 1))], z: Noisy(n: n))

fun mke(n: Int) -> HE
  HE(e: E.a(c: Counter(hits: Cell(n)), z: Noisy(n: n)))

sub main()
  for k in mk(0).arr
    defer
      print("defer", k.hits.get())
    if k.hits.get() == 1
      break
    print("body", k.hits.get())
  match mke(7).e
    .a(c, z)
      defer
        print("mdefer", c.hits.get(), z.n)
      print("arm", z.n)
    .b => pass
  print("end")
