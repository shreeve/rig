# A set nested in the value whose own target views the owner the outer
# value grows afterwards in the same arm.
fun grow(v: !Vec[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(1)
  w = !v[0..1]
  k = 0
  u[0] = match k
    0
      w[0] = match k
        0 => 5
        _ => 6
      grow(!v)
    _ => 3
  print(v[0], u[0])

# expect:
# 5 201
