enum Opt[T]
  some(v: T)
  nothing

obj W[T]
  o: Opt[T]
  p: T?

fun get[T](o: ?Opt[T]) -> ?Opt[T] from o
  o

fun getw[T](w: ?W[T]) -> ?W[T] from w
  w

fun nest[T](o: ?Opt[Opt[T]], d: T) -> T
  match get(o)
    .some(inner)
      match <inner
        .some(v) => v
        .nothing => <d
    .nothing => <d

sub main()
  o: Opt[Opt[String]] = .some(v: .some(v: String("x")))
  print(nest(?o, String("d")))
  match o
    .some(i)
      match i
        .some(v) => print(v)
        .nothing => pass
    .nothing => pass
