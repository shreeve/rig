# A Cell change through an element of a branching array value with a
# named leaf: the name's array must change where it is.
#
# oracle: C.hit accept
# oracle: mka accept
# oracle: side accept
# oracle: main accept
struct C
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

fun mka(n: Int) -> [2]C
  [C(c: Cell(n)), C(c: Cell(n + 1))]

fun side(n: Int) -> Int
  n

sub go(k: Bool)
  arr = mka(10)
  (arr if k else mka(20))[0].hit()
  (arr if k else [C(c: Cell(1)), C(c: Cell(2))])[1].c.set(50)
  (arr if k else mka(30))[0].c.set(side(100))
  (arr if k else mka(30))[side(1)].hit()
  print(arr[0].c.get(), arr[1].c.get())
  print((arr if k else mka(5))[1].c.replace(7), arr[1].c.get())

sub main()
  go(true)
  go(false)

# expect:
# 100 51
# 51 7
# 10 11
# 6 11
