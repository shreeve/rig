struct Counter
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

struct H[T]
  item: T
  n: Int

fun call[T](x: ?T, f: ?fun(?T) -> Int) -> Int
  f(x)

fun field[T](h: ?H[T], f: ?fun(?T) -> Int) -> Int
  f(?h.item)

fun bump(c: !Counter) -> Int
  !c.hit()
  1

sub main()
  a = Counter(hits: Cell(0))
  print(call(?a, bump))
  print(a.hits.get())
  h = H(item: Counter(hits: Cell(0)), n: 1)
  print(field(?h, bump))
  print(h.item.hits.get())
