# A generic loop over a `?Vec[T]` binds a copy of each element, which
# the iteration holds (SPEC "Generic bodies"): `?x` lends that copy, so
# a view of it may not outlive the iteration (Core s6); one used within
# the iteration is fine.

fun lastref[T](v: ?Vec[T]) -> ?T
  r = ?v[0]
  for x in v
    r = ?x
  r

sub look[T](r: ?T)
  pass

fun count[T](v: ?Vec[T]) -> Int
  n = 0
  for x in v
    r = ?x
    look(r)
    n += 1
  n

sub main()
  v: Vec[Text] = Vec()
  !v.push(Text("a"))
  print(count(?v))

# oracle: lastref reject C5
# oracle: look accept
# oracle: count accept
# oracle: main accept
