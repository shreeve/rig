# Review probe r2/w10_generic.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: mk accept
# oracle: mkopt accept
# oracle: f accept
# oracle: take reject C3
obj S
  n: Int
  items: List[Int]
  o: List[Int]?
  b: ^List[Int]

  drop(!self)
    print("drop", self.n, self.items, self.o)

fun mk(n: Int) -> S
  v: List[Int] = List()
  !v.push(n)
  w: List[Int] = List()
  !w.push(n * 10)
  S(n: n, items: <v, o: <w, b: ^List[Int]())

fun mkopt(n: Int) -> S?
  return none if n == 0
  mk(n)

fun f(n: Int) -> Int
  n

obj G[T]
  x: T

fun take[T](g: !G[T]) -> T
  <(!g).x

sub main()
  g = G(x: mk(1))
  print(take(!g).n)
