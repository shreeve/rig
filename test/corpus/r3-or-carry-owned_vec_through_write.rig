# An element of a List the holder owns, reached through `!self`, lends
# `self`: the holder cannot change while the view is used.

struct Tok
  kind: Int

struct P
  toks: List[Tok]
  pos: Int

  fun next(!self) -> ?Tok
    t = ?self.toks[self.pos]
    self.pos += 1
    t

sub main()
  p = P(toks: List(), pos: 0)
  !p.toks.push(Tok(kind: 1))
  a = (!p).next()
  print(a.kind)
