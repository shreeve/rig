# An element of a List the holder owns, reached through `!self`, lends
# `self.toks`: that field cannot change while the view is used, and the
# holder's other fields can (Core §5, "A field is a place of its own").

obj Tok
  kind: Int

obj P
  toks: List[Tok]
  pos: Int

  fun next(!self) -> ?Tok
    t = ?self.toks[self.pos]
    self.pos += 1
    t

sub main()
  p = P(toks: List(), pos: 0)
  !p.toks.push(Tok(kind: 1))
  a = (!p).next()
  print(a.kind)
