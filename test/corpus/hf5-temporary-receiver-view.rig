# A view a `?self` method returns of a temporary its statement does
# not keep otherwise (plain data, or a field holding a Cell), held past
# the statement: rejected.

obj P
  xs: [4]Int

  fun arr(?self) -> ?[4]Int
    ?self.xs

obj Q
  c: Cell[Int]
  n: Int

  fun me(?self) -> ?Q
    self

obj H
  q: Q

fun mk() -> P
  P(xs: [9, 9, 9, 9])

fun mkh() -> H
  H(q: Q(c: Cell(1), n: 42))

sub main()
  r = mk().arr()
  s = mkh().q.me()
  print(r, s.n)
