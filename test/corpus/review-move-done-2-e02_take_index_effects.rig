# A take whose index writes the List it takes from.
fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

fun grow(v: !List[List[Int]?]) -> Int
  for i in 0..100
    !v.push(mkv(i))
  0

sub main()
  v: List[List[Int]?] = List()
  !v.push(mkv(1))
  x = <v[grow(!v)]
  print(x == none, v.len)

# oracle: mkv accept
# oracle: grow accept
