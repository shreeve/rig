error Bad
  neg

type Cb = *sub(Int)!

struct Stack[T]
  items: Vec[T]

  sub push(!self, x: T, limit: Int = 2)!
    return Bad.neg if self.items.len >= limit
    !self.items.push(x)

sub zero()!
  print("zero")

sub go(f: ?sub()!)!
  f()!

sub main
  s = Stack[Int](Vec())
  !s.push(1)!
  !s.push(2)!
  !s.push(3) catch |e|
    print("e", e)
  !s.push(3, limit: 5)!
  print(s.items)
  go(zero)!
  cbs = Vec[Cb]()
  !cbs.push(*|x: Int|
    return Bad.neg if x < 0
    print("cb", x)
  )
  for c in ?cbs
    c(1)!
    c(-1) catch |e|
      print("e", e)
  h = Cell[Cb?](none)
  print(h.replace(none) == none)
