fun fal1084(ok: Bool) -> Int!
  return Err1084.bad if not ok
  (-9223372036854775808)

error Err1084
  bad

struct FA1084
  f: Int

sub t1084()
  fa1084 = FA1084(f: 0)
  fa1084.f = (fal1084(false) catch 191694661597162117)
  print(fa1084.f)

sub main()
  t1084()
