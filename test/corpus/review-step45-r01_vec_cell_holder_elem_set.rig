# Vec and array of Cell holders: set through an element, then read
struct C
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

sub main
  v: Vec[C] = Vec()
  !v.push(C(c: Cell(1)))
  v[0].c.set(5)
  v[0].hit()
  print(v[0].c.get())
  a = [C(c: Cell(1)), C(c: Cell(2))]
  a[1].c.set(9)
  a[1].hit()
  print(a[1].c.get())
