struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct R
  t: *Tok

  drop(!self)
    old = replace(!self.t, *Tok(n: 99))
    eat(<old)

sub main()
  r = R(t: *Tok(n: 1))
  print("x")
