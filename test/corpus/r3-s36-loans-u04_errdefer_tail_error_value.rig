# A tail that may be an error value runs the errdefers (failure exit);
# their effects must not reach the success exit's defers.
error E
  bad

sub eat(v: Vec[Int])
  print("eat", v.len)

fun f(ok: Bool) -> Int!
  x: Vec[Int] = Vec()
  !x.push(1)
  defer print("deferred", x[0])
  errdefer x = Vec()
  eat(<x)
  if ok
    1
  else
    E.bad

sub main()
  print(f(true) catch 0)
