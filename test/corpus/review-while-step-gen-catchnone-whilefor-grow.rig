# oracle: mk accept
# oracle: mkf accept
# oracle: grow accept
# oracle: main reject C4

error E
  bad

struct S
  s: []Int

fun mk(v: ?Vec[Int], n: Int) -> S?
  if n < 4
    return S(s: ?v[..])
  none

fun mkf(v: ?Vec[Int], n: Int) -> S?!
  return E.bad if n == 70
  mk(v, n)

sub grow(v: !Vec[Int])
  for i in 0..50
    !v.push(i)

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  n = 0
  :outer while (mkf(?v, n) catch none) as h: k += h.s[0]
    n += 1
    j = 0
    while j < 2: j += 1
      for _ in 0..1
        grow(!v)
        continue :outer
  print(k, n)
