# Takes through a write view held in a field, a read view held in a
# field, a Box, and a loop's write view; then the owner is read.
obj S
  o: List[Int]?
  v: List[Int]

obj K
  w: !S

obj KR
  r: ?S

fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

fun mks(n: Int) -> S
  S(o: mkv(n), v: mkv(n))

sub a()
  s = mks(1)
  k = K(w: !s)
  x = <k.w.o
  print(x == none)
  print(s.o == none)

sub b()
  s = mks(1)
  bx = ^mks(2)
  y = <bx.o
  print(y == none, bx.o == none, s.v.len)

sub c()
  v: List[S] = List()
  !v.push(mks(1))
  for e in !v
    z = <e.o
    print(z == none)
  print(v[0].o == none)

sub main()
  a()
  b()
  c()

# oracle: mkv accept
# oracle: mks accept
# oracle: b accept
# oracle: c accept
# oracle: main accept
