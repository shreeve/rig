struct P
  x: Int
  y: Int

sub inc(o: !Int?)
  if !o as v
    v += 1

sub setp(o: !P?)
  if !o as p
    p.x = 9
    p = P(x: p.x, y: 7)

fun rd(o: ?P?) -> Int
  if o as p
    p.x + p.y
  else
    0

sub main
  a: Int? = 1
  inc(!a)
  if !a as v
    v *= 10
  print(a)
  q: P? = P(x: 1, y: 2)
  setp(!q)
  print(q, rd(?q))
  s: String? = "hi"
  if !s as t
    t = "yo"
  print(s)
