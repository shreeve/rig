# a39, unguarded only: `match ?hs[idx(?String("a"))]` over `*E` handles,
# and over ^E, with a header temporary.
enum E
  a(xs: [4]Int)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  hs = [*E.a(xs: [7, 7, 7, 7]), *E.b]
  match ?hs[idx(?String("a"))]
    .a(xs) => print(xs[3])
    _ => print(0)
  bs = [^E.a(xs: [8, 8, 8, 8]), ^E.b]
  match ?bs[idx(?String("a"))]
    .a(xs) => print(xs[3])
    _ => print(0)
