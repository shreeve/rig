# h18 control: the same call to the function directly (not through a
# field callable) drops the Text when `gf(2)!` leaves.
error Bad
  no

obj Q
  c: Cell[Int]
  n: Int

obj H
  q: Q

obj S
  cb: fun(String, ?Q, Int) -> Int

fun gf(k: Int) -> Int!
  if k > 1
    return Bad.no
  k

fun mkh(k: Int) -> H
  H(q: Q(c: Cell(k), n: k))

fun usq(t: String, q: ?Q, n: Int) -> Int
  t.len + q.c.get() + n

fun run(s: ?S) -> Int!
  usq(String("a text long enough to live on the heap"), ?mkh(5).q, gf(2)!)

sub main()
  s = S(cb: usq)
  print(run(?s) catch -1)
