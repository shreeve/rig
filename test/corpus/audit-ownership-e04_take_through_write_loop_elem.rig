obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

obj H
  o: ^Tok?

sub main()
  v: List[^H] = List()
  !v.push(^H(o: ^Tok(n: 1)))
  for b in !v
    x = <b.o
    print(x == none)
  for b in ?v
    print(b.o == none)
