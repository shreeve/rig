obj S
  c: Cell[List[Int]]

  sub grow(!self)
    for i in 0..50
      !self.c.push(i)

obj O
  s: S

fun peek(o: ?O) -> ?S
  ?o.s

fun f(x: Int, s: ?S) -> Int
  x + s.c.len

sub main()
  a = *O(s: S(c: Cell(List())))
  b = *O(s: S(c: Cell(List())))
  k = a.s.c.len == 0
  !a.s.c.push(1)
  print(a.s.c.len, b.s.c.len, k, f(1, ?a.s))
