obj S
  v: List[Int]
  w: List[Int]
  arr: [2]List[Int]

fun mk() -> S
  v: List[Int] = List()
  !v.push(7)
  S(v: <v, w: List(), arr: [List(), List()])

sub main()
  a = mk()
  b = mk()
  c = a.v.len == 1
  for x in <(mk() if c else mk()).v
    print(x)
  print(a.v.len, b.v.len)
  print("end", c)

# oracle: mk accept
# oracle: main reject C3
