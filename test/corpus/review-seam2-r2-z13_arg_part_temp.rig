# Review probe r2/z13_arg_part_temp.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.me accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: mkh accept
# oracle: wrap accept
# oracle: put accept
# oracle: main reject C5
obj S
  n: Int
  t: String

  drop(!self)
    print("dropS", self.n)

obj H
  r: ?String
  rs: List[?String]

  fun me(!self) -> !H
    self

  drop(!self)
    print("dropH sees", self.r, self.rs)

fun mk(n: Int) -> S
  S(n: n, t: String("hello world, long enough to be on the heap ", n))

fun mkh() -> H
  H(r: "init", rs: List())

fun wrap(h: !H) -> !H
  h

sub put(v: !List[?String], r: ?String) keeps r
  !v.push(r)

sub main()
  put(!mkh().rs, ?mk(1).t)
  print("end")
