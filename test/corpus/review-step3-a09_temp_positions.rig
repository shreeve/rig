struct Bag
  n: Int

  drop(!self)
    print("drop", self.n)

error Bad
  boom

fun size(b: ?Bag) -> Int
  b.n

fun mk(n: Int) -> Bag
  Bag(n: n)

fun ret() -> Int
  return size(mk(1))

fun tail() -> Int
  size(mk(2))

fun fail(n: Int) -> Int!
  if n > 0
    return Bad.boom
  n

sub main
  print(ret(), tail())
  x = for i in 0..3
    if i == 1
      break size(mk(3))
  else
    0
  print(x)
  c = true
  y = if c
    size(mk(4))
  else
    0
  print(y)
  z = fail(1) catch size(mk(5))
  print(z)
  i = 0
  while i < 2 : i += size(mk(6)) - 5
    print("w", i)
  o: Int? = none
  w = o ?? size(mk(7))
  print(w)
