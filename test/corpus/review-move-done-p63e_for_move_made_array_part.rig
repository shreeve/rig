obj S
  v: List[Int]
  w: List[Int]
  arr: [2]List[Int]

fun mk() -> S
  v: List[Int] = List()
  !v.push(7)
  e: List[Int] = List()
  !e.push(1)
  f: List[Int] = List()
  !f.push(2)
  S(v: <v, w: List(), arr: [<e, <f])

sub main()
  a = mk()
  b = mk()
  c = a.v.len == 1
  for x in <mk().arr
    print(x.len)
  print(a.v.len, b.v.len)
  print("end", c)

# oracle: mk accept
# oracle: main reject C3
