# oracle: D.drop accept
# oracle: D.hit accept
# oracle: D.bumped accept
# oracle: D.me accept
# oracle: look accept
# oracle: main accept
error E
  bad

struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

  sub hit(!self)
    !self.c.set(self.c.get() + 1)

  fun bumped(!self) -> Int
    !self.c.set(self.c.get() + 1)
    self.c.get()

  fun me(!self) -> ?D
    !self.c.set(self.c.get() + 1)
    self

struct WW
  t: D

fun mk(n: Int) -> D
  D(c: Cell(n))

fun mkf(n: Int) -> D!
  return E.bad if n < 0
  mk(n)

fun mko(n: Int) -> D?
  return none if n < 0
  mk(n)

fun mkww(n: Int) -> WW
  WW(t: mk(n))

fun look(x: !D) -> Int
  !x.c.set(x.c.get() + 10)
  x.c.get()

sub go(k: Bool)
  a = mk(1)
  (mkf(-1 if k else 3) catch |e| (mk(5) if e == E.bad else a)).hit()
  print("a", a.c.get())

sub main()
  go(true)
  go(false)
