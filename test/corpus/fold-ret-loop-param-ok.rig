# The fold: a String that views a Text slot (ret-loop-param-ok): rejected, or runs sanitizer-clean.
enum E
  full(t: String)
  empty

obj H
  t: String

fun f(v: ?List[String]) -> ?String from v
  for x in ?v
    return ?x
  ""

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  print(f(?v))
