# a05 in a loop, guarded: the catch-all view `r` taken in pass 0 must
# read pass 0's element after the loop, 7 7, not a later pass's copy in
# `__rig_subject_N`. The guarded match holds the element's address, so
# it does (test/behavior/ownership/header_points_view_escapes.rig).
enum E
  a(xs: [4]Int)
  b

fun idx(s: ?Text, i: Int) -> Int
  s.len - 1 + i

sub main()
  v = [E.a(xs: [7, 7, 7, 7]), E.a(xs: [8, 8, 8, 8])]
  z = E.b
  r = ?z
  for i in 0..2
    match ?v[idx(?Text("a"), i)]
      x if i == 0 => r = x
      _ => print("skip")
  match r
    .a(xs) => print(xs[0], xs[3])
    .b => print("b")
