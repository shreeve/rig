# The arm re-points the target's write view, then grows its old referent:
# the store goes through the new view.
fun grow(v: !Vec[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0..1]
  k = 0
  w[0] = match k
    0
      w = !u[0..1]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

# expect:
# 7 201 201
