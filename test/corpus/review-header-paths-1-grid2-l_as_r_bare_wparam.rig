struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

struct Q
  e: E
  o: E?
  v: Vec[Int]

struct W
  e: E
  o: E?
  v: Vec[Int]
  q: Q?

  fun ge(?self) -> ?E
    ?self.e

  fun gv(?self) -> ?Vec[Int]
    ?self.v

  fun go(?self) -> ?(E?)
    ?self.o

  fun gew(!self) -> !E
    !self.e

  fun gvw(!self) -> !Vec[Int]
    !self.v

struct H
  w: !W

fun mkv(n: Int) -> Vec[Int]
  v: Vec[Int] = Vec()
  for i in 0..n
    !v.push(i + 1)
  v

fun mkw(n: Int) -> W
  W(e: mk(n), o: mk(n + 10), v: mkv(n), q: Q(e: mk(n + 20), o: mk(n + 30), v: mkv(n)))

fun id[T](x: T) -> T
  x

fun f(a: !(E?), b: !(E?), c: Bool) -> Int?
  if ?(a if c else b) as x
    match x
      .a(r)
        s = ?r.v[..]
        a = none
        print(s[0])
      .b => pass
  1

sub main()
  x: E? = mk(3)
  y: E? = mk(3)
  _ = f(!x, !y, true)
