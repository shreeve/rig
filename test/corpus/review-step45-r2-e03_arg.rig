# H3: generic loop over ?List[T], body: pass by value to a T param
obj S
  t: String

obj Holder[T]
  x: T?

fun eat[T](x: T) -> Int
  1

fun all[T](v: ?List[T]) -> Int
  n = 0
  for x in v
    n += eat(x)
  n

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(all(?v))
