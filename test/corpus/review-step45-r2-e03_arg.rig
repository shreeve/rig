# H3: generic loop over ?Vec[T], body: pass by value to a T param
struct S
  t: Text

struct Holder[T]
  x: T?

fun eat[T](x: T) -> Int
  1

fun all[T](v: ?Vec[T]) -> Int
  n = 0
  for x in v
    n += eat(x)
  n

sub main()
  v: Vec[Text] = Vec()
  !v.push(Text("a"))
  !v.push(Text("b"))
  print(all(?v))
