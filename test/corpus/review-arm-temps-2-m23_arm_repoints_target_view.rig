# The arm re-points the write view the target writes through; the store
# goes through the new view, as emit evaluates the target after the value.
sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  w = !v[0..1]
  k = 0
  w[0] = match k
    0
      w = !u[0..1]
      3
    _ => 4
  print(v[0], u[0])

# expect:
# 7 3
