error E
  bad

struct P
  n: Int
  fun plus(?self, k: Int) -> Int
    self.n + k

fun grow(c: ?*Cell[Vec[P]]) -> Int!
  for i in 0..10000
    c.push(P(n: i))
  1

fun run(c: ?*Cell[Vec[P]]) -> Int!
  c[0].plus(grow(c)!)

sub main()
  c = *Cell[Vec[P]](value: Vec())
  c.push(P(n: 41))
  print(run(?c) catch 0)
