error E
  bad

obj P
  n: Int
  fun plus(?self, k: Int) -> Int
    self.n + k

fun grow(c: !*Cell[List[P]]) -> Int!
  for i in 0..10000
    !c.push(P(n: i))
  1

fun run(c: ?*Cell[List[P]], d: !*Cell[List[P]]) -> Int!
  c[0].plus(grow(!d)!)

sub main()
  c = *Cell[List[P]](value: List())
  !c.push(P(n: 41))
  d = +c
  print(run(c, !d) catch 0)
