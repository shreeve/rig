struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main()
  v: Vec[*Tok] = Vec()
  !v.push(*Tok(n: 1))
  !v.push(*Tok(n: 5))
  !v.push(*Tok(n: 2))
  while !v.pop() as t and t.n < 5
    eat(<t)
  print("left", v.len)
