# UNSOUND on main: a `!` in the tail runs the errdefers on the failure
# exit, and their effects stay in the state the success exit's defers
# are checked against. The errdefer revives `x`; on success it does
# not run, so the defer reads the moved Vec.
error E
  bad

sub eat(v: Vec[Int])
  print("eat", v.len)

fun maybe(ok: Bool) -> Int!
  return E.bad if not ok
  1

fun f(ok: Bool) -> Int!
  x: Vec[Int] = Vec()
  !x.push(1)
  defer print("deferred", x[0])
  errdefer x = Vec()
  eat(<x)
  maybe(ok)!

sub main()
  print(f(true) catch 0)
