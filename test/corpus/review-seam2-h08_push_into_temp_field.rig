# Review probe h08_push_into_temp_field.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: mkh accept
# oracle: main reject C5
obj S
  n: Int
  t: String

  drop(!self)
    print("dropS", self.n)

obj H
  rs: List[?String]

  drop(!self)
    print("dropH sees", self.rs)

fun mk(n: Int) -> S
  S(n: n, t: String("hello world, long enough to be on the heap"))

fun mkh() -> H
  H(rs: List())

sub main()
  !mkh().rs.push(?mk(1).t)
  print("end")
