# The body re-points `h` at a List declared before the loop, then grows
# that List; the step reads `h`.
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: List[Int] = List()
  !v.push(1)
  w: List[Int] = List()
  !w.push(2)
  k = 0
  i = 0
  while mk(?v, i) as h: k += h.s[0]
    h = S(s: ?w[..])
    !w.push(3)
    i += 1
  print(k)
