# The body re-points `h` at a Vec declared before the loop, then grows
# that Vec; the step reads `h`.
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  w: Vec[Int] = Vec()
  !w.push(2)
  k = 0
  i = 0
  while mk(?v, i) as h: k += h.s[0]
    h = S(s: ?w[..])
    !w.push(3)
    i += 1
  print(k)
