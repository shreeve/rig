# match on vv[0][grow(!vv, ?Text)] with Text payloads. Expect reject (or clean).
enum E
  a(t: Text)
  b

fun grow(vv: !List[[1]E], s: ?Text) -> Int
  for _ in 0..64
    !vv.push([E.b])
  s.len - 1

sub main()
  vv: List[[1]E] = List()
  !vv.push([E.a(t: Text("x"))])
  match !vv[0][grow(!vv, ?Text("a"))]
    .a(t) => !t.add("y")
    .b => pass
  print(vv[0], vv.len)
