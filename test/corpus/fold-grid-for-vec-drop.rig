# The fold: a String that views a Text slot (for-vec-drop): rejected where the Text changes or ends while it is used, or runs sanitizer-clean.
enum E
  full(t: Text)
  empty

struct S
  name: String

struct H
  t: Text

fun id[T](x: ?T) -> ?T from x
  x

fun first(v: ?List[Text]) -> ?Text from v
  ?v[0]

sub main()
  o: List[Text] = List()
  !o.push(Text("hello"))
  keep: String = ""
  for x in ?o
    keep = ?x
  <o
  print(keep)
