struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun f(t: *Tok) -> Bool
  print("f", t.n)
  true

sub main()
  c = true
  if c or f(*Tok(n: 5))
    print("yes")
  print("end")
