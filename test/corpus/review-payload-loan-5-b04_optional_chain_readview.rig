struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

struct K
  o: G?

struct G
  w: !E

fun f(k: ?K) -> Int?
  match k.o?.w
    .a(r) => r.n = 5
    .b => pass
  1

sub main()
  e = mk(1)
  k = K(o: G(w: !e))
  _ = f(?k)
  print(k.o)
