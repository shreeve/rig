obj P
  arr: [4]Int
  v: List[Int]
  s: String

fun sum(xs: ?[]Int) -> Int
  t = 0
  for x in xs
    t += x
  t

sub main()
  arr = [1, 2, 3, 4]
  v = List[Int]()
  !v.push(5)
  !v.push(6)
  s = String("abcdef")
  p = P(arr: [1, 2, 3, 4], v: List[Int](), s: String("xyz"))
  y = (?arr)[0..2][1]
  print(y)
  print(arr[0], v.len, s, p.arr[0])
