obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

obj Node[T]
  v: T
  next: ^Node[T]?

obj Chain[T]
  head: ^Node[T]?

  sub push(!self, v: T)
    self.head = ^Node[T](v: <v, next: <self.head)

  fun pop(!self) -> T?
    if <self.head as n
      self.head = <n.next
      return <n.v
    none

sub main()
  l = Chain[*Tok](head: none)
  !l.push(*Tok(n: 1))
  !l.push(*Tok(n: 2))
  if (!l).pop() as t
    print("pop", t.n)
  print("end")
