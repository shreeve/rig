# while-as over Vec element via temp index; push then use t. Expect reject.
fun idx(s: ?Text) -> Int
  s.len - 1

sub main()
  v: Vec[Text?] = Vec()
  !v.push(Text("a"))
  k = 0
  while !v[idx(?Text("a"))] as t
    for _ in 0..64
      !v.push(Text("zzzzzzzzzzzzzzzzzzz"))
    !t.add("x")
    k += 1
    break if k > 2
  print(v[0], v.len)
