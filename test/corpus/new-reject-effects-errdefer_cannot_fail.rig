# `errdefer` runs only when its function fails, so a function, closure,
# or `drop` body that cannot fail takes `defer` instead.

fun next(x: Int) -> Int
  errdefer print("never")
  x + 1

sub show(x: Int)
  errdefer
    print("never")
  print(x)

struct D
  n: Int

  drop(!self)
    errdefer print("never")

fun later() -> Int!
  defer
    errdefer print("never")
  1

sub main()
  k = ||
    errdefer print("never")
  k()
  c: sub() = ||
    errdefer print("never")
  c()
  show(next(1))
  print(later()!)
  d = D(n: 1)
  print(d.n)

