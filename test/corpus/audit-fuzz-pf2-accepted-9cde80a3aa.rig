fun id_i8(x: I8) -> I8
  x

fun id_i16(x: I16) -> I16
  x

fun id_i32(x: I32) -> I32
  x

fun id_int(x: Int) -> Int
  x

fun id_i128(x: I128) -> I128
  x

fun id_u8(x: U8) -> U8
  x

fun id_u16(x: U16) -> U16
  x

fun id_u32(x: U32) -> U32
  x

fun id_u64(x: U64) -> U64

  x

fun id_u128(x: U128) -> U128
  x

fun id_float(x: Float) -> Float
  x

sub main
  print("before")
  v: Vec[I128] = Vec()
  !v.push((-170141183460469231731687303715884105728))
  x = v[id_int(1)]
  print("after", x)
