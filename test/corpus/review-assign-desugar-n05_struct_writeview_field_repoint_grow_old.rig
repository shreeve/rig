# The value re-points a write-view field at an outer List, then grows the
# old referent. The store goes through the new view (u[0]).
obj H
  r: !Int

fun grow(v: !List[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub main()
  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  h = H(r: !v[0])
  k = 0
  h.r = match k
    0
      h.r = !u[0]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

# expect:
# 7 201 201
