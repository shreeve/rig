obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

obj W
  e: E
  o: E?
  v: List[Int]

fun mkw(n: Int) -> W
  v: List[Int] = List()
  for i in 0..n
    !v.push(i + 1)
  W(e: mk(n), o: mk(n + 10), v: <v)

obj V
  ov: List[Int]?

fun f(a: !V, b: !V, c: Bool) -> Int?
  n = 0
  for x in (a if c else b).ov?
    for i in 0..100
      if a.ov as w
        pass
      a.ov = none
    n += x
  print(n)
  1

sub main()
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  x = V(ov: <v)
  y = V(ov: none)
  _ = f(!x, !y, true)
