# Parts of a value that branches between a name's leaf and one made
# there, lent or iterated rather than used as a `?self` receiver.
struct T
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

struct W
  t: T
  n: Int

fun mk(n: Int) -> W
  W(t: T(c: Cell(n)), n: n)

fun look(x: ?T) -> Int
  x.hit()
  x.c.get()

sub main()
  w = mk(1)
  for i in 0..4
    k = i % 2 == 0
    print(look(?(w if k else mk(50)).t))
  print(w.t.c.get())

# expect:
# 2
# 51
# 3
# 51
# 3

# oracle: T.hit accept
# oracle: look accept
