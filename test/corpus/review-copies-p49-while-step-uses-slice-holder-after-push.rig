# The step reads a slice the condition's binding holds, after the body
# grew the List it views (a reallocation frees the old buffer).
#
# oracle: mk accept
# oracle: main reject C4
obj S
  s: []Int

fun mk(v: ?List[Int]) -> S?
  if v.len < 40
    return S(s: ?v[..])
  none

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  while mk(?v) as h: k += h.s[0]
    !v.push(2)
  print(k, v.len)
