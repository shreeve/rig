# Pre-existing (main too): a `?self` method that changes a Cell[List] of a
# named local, in a loop. Debug is right; --release writes read-only
# memory (bus error on macOS) or loses the push. No temporary is involved.
#
# oracle: V.add accept
# oracle: build accept
# oracle: maybe accept
obj V
  c: Cell[List[Int]]

  fun add(!self, n: Int) -> Int
    !self.c.push(n)
    self.c.len

fun build(n: Int) -> List[Int]
  v: List[Int] = List()
  for i in 0..n
    !v.push(i)
  v

fun maybe(n: Int) -> Int?
  return none if n < 0
  n

sub main()
  for i in 0..3
    v = V(c: Cell(build(i)))
    print(v.add(maybe(i - 1) ?? 9))

# expect:
# 1
# 2
# 3
