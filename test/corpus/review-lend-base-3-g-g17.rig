obj K
  hits: Cell[Int]
  log: Cell[List[Int]]
  n: Int

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

obj N
  v: Int
  next: (~N)?

fun made() -> K
  K(hits: Cell(0), log: Cell(List[Int]()), n: 3)

sub main()
  k = made()
  h = *N(v: 1, next: none)
  wk = ~h
  s = String("abcdef")
  y = (?s[1..4])[1..2]
  print(y)
  print(k.hits.get(), k.log.len, k.n, h.v)
