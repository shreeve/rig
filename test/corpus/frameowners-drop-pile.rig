# A `drop` body is a frame owner: 1,300 calls of a helper the rule would
# inline there ran off the stack.
fun w(i: Int) -> Int
  t = [7000 of 0]
  for k in 0..7000
    t[k] = k + i
  t[i % 7000]

obj Res
