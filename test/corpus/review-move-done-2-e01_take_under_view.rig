# Taking an optional place while a view of its payload is live.
struct S
  o: Vec[Int]?

fun mkv(n: Int) -> Vec[Int]
  xs: Vec[Int] = Vec()
  !xs.push(n)
  xs

fun gw(s: !S) -> !S
  s

sub a()
  s = S(o: mkv(1))
  if ?s.o as y
    x = <s.o
    print(y[0], x == none)

sub b(q: !S)
  if !q.o as y
    x = <q.o
    print(y[0], x == none)

sub c()
  v: Vec[Vec[Int]?] = Vec()
  !v.push(mkv(1))
  for e in ?v
    x = <v[0]
    print(e == none, x == none)

sub d()
  s = S(o: mkv(1))
  w = gw(!s)
  r = ?w.o
  x = <w.o
  print(r == none, x == none)

sub e()
  s = S(o: mkv(1))
  g = |?s| s.o == none
  x = <s.o
  print(g(), x == none)

sub f()
  s = S(o: mkv(1))
  k = 1
  y = <(!s).o if k > 0 else mkv(2)
  print(y == none)

sub main()
  a()
  t = S(o: mkv(2))
  b(!t)
  c()
  d()
  e()
  f()

# oracle: mkv accept
# oracle: gw accept
# oracle: a reject C4
# oracle: b reject C4
# oracle: c reject C4
# oracle: d reject C4
# oracle: e reject C4
# oracle: f accept
# oracle: main accept
