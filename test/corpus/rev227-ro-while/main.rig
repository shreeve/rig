# A while header that lends a read-only field to write is rejected.

use lib

sub main()
  t = lib.Tally()
  !t.bump(3)
  while !t.last as l
    l = 2
    break
  print(t.tags, t.inner.n, t.shape, t.last)

# error: 8:12: cannot lend `t.last` to write: field `last` of `lib.Tally` is read-only outside module `lib`, which declares it `pub ?last`
# errors: 1
