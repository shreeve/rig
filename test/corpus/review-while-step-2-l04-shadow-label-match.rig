# A labeled `match` repeating the enclosing loop's label: its `break :a`
# leaves the match. The loop's label is used only by a `continue :a` in
# its body, which leaves the body's block. Expected: accepted, prints
# `end 3 3`.
#
# oracle: mk accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  j = 0
  :a while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    continue :a if i == 99
    :a match i
      1
        j += 1
        break :a
      _ => j += 1
  print("end", k, j)
