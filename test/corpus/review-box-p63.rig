obj R
  n: Int

  drop(!self)
    print("drop", self.n)

fun rd(r: ?R) -> Int
  r.n

fun rdb(r: ?^R) -> Int
  r.n

sub wr(r: !R)
  r = R(n: r.n + 100)

sub f(w: !R)
  print(rd(w))

sub g(w: !^R)
  print(rdb(w))
  print(rd(?w))

sub main()
  v: List[^R] = List()
  !v.push(^R(n: 1))
  for x in !v
    wr(x)
    wr(!x)
    g(x)
  for x in ?v
    print(rd(?x))
    print(rdb(?x))
  b = ^R(n: 3)
  f(!b)
