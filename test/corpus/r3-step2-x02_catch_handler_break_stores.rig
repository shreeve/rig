error E
  bad

fun mk(ok: Bool) -> Int!
  if not ok
    return E.bad
  1

obj H
  r: ?List[Int]

sub main()
  z: List[Int] = List()
  h = H(r: ?z)
  for i in 0..2
    n = mk(false) catch |_|
      inner: List[Int] = List()
      !inner.push(9)
      h.r = ?inner
      break
    print(n)
  print(h.r[0])
