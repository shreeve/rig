# Review probe q03_bool.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
obj Set
  xs: List[Int]

  fun insert(!self, x: Int) -> Bool
    !self.xs.push(x)
    true

fun mks() -> Set
  Set(xs: List())

sub main()
  if !mks().insert(1)
    print("a")
  if (!mks()).insert(2)
    print("b")
  print(!mks().insert(3))
