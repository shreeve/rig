# Assigning a new write view to a `!T` local re-points it: the local
# then holds the new loan only, so the old place is free again (Core §6
# "Borrow places"). A bare write view on the right is read as its value.

sub old_place_free
  m = 1
  n = 2
  w = !m
  w += 1
  w = !n
  print(m)
  w = 7
  print(n)

sub moved_in
  m = 1
  n = 2
  w = !m
  w2 = !n
  w = <w2
  w = 5
  print(m, n)

sub bare_value
  m = 1
  n = 2
  w = !m
  w3 = !n
  w = w3
  print(m, n)

sub main
  old_place_free()
  moved_in()
  bare_value()

# expect:
# 2
# 7
# 1 5
# 2 2

# oracle: old_place_free accept
# oracle: moved_in accept
# oracle: bare_value accept
