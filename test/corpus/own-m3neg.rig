enum Tree
  leaf(v: Int)
  node(l: ^Tree, r: ^Tree)

sub main()
  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.leaf(v: 3))
  match !t
    .node(l, _)
      t = .leaf(v: 4)
      l = ^Tree.leaf(v: 7)
    .leaf(v)
      t = .leaf(v: 9)
      v += 1
  match ?t
    .node(l, _)
      t = .leaf(v: 4)
      print(l)
    _ => print("x")
