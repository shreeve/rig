obj S
  t: String
  n: Int

  fun tail(!self) -> ?String
    self.n += 1
    ?self.t[1..]

  fun peek(?self) -> ?String
    ?self.t[1..]

  sub hold(!self)
    r = ?self.t[1..]
    print(r)
    self.t = String("other")
    q = ?self
    print(q.t)

sub main()
  s = S(t: String("hello"), n: 0)
  print((!s).tail(), s.peek())
  !s.hold()
