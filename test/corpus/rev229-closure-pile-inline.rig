# Second review of #229, as the reviewer wrote it: a closure calls an
# `inline` function `g` 300 times, and `g` calls a 56 KB helper the rule
# would inline, so each call of `g` lands the helper in the closure's
# frame, 16.8 MB in all. The closure is a frame owner of its own, and
# what the rule inlines through `g` is held to its account: the rule
# leaves the helper a call.

fun w(i: Int) -> Int
  t = [7000 of 0]
  for k in 0..7000
    t[k] = k + i
  t[i % 7000]

inline fun g(i: Int) -> Int
  w(i) + 1

fun near(i: Int) -> Int
  f = |+i|
    g(i + 0) + g(i + 1) + g(i + 2) + g(i + 3) + g(i + 4) + g(i + 5) + g(i + 6) + g(i + 7) + g(i + 8) + g(i + 9) + \
    g(i + 10) + g(i + 11) + g(i + 12) + g(i + 13) + g(i + 14) + g(i + 15) + g(i + 16) + g(i + 17) + g(i + 18) + g(i + 19) + \
    g(i + 20) + g(i + 21) + g(i + 22) + g(i + 23) + g(i + 24) + g(i + 25) + g(i + 26) + g(i + 27) + g(i + 28) + g(i + 29) + \
