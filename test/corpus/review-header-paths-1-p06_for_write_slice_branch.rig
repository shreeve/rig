obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

obj W
  e: E
  o: E?
  v: List[Int]

fun mkw(n: Int) -> W
  v: List[Int] = List()
  for i in 0..n
    !v.push(i + 1)
  W(e: mk(n), o: mk(n + 10), v: <v)

sub f(a: !List[Int], b: !List[Int], c: Bool)
  for x in ?(a if c else b)[0..2]
    for i in 0..100
      !a.push(i)
    print(x)

sub main()
  x: List[Int] = List()
  !x.push(1)
  !x.push(2)
  y: List[Int] = List()
  f(!x, !y, true)
