fun double(n: Int) -> Int
  n * 2

fun inc(n: Int) -> Int
  n + 1

fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

struct H
  f: fun(Int) -> Int

sub main()
  arr: [2]fun(Int) -> Int = [double, inc]
  g = ?arr[1]
  print(g(1))
  print(apply(?arr[0], 5))
  h = H(f: inc)
  print(apply(?h.f, 5))
  k = ?h.f
  print(k(7))
