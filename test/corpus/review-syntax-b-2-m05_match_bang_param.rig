fun keep(s: ?String) -> ?String
  s

fun keepv(s: []Int) -> []Int
  s

enum E
  a(t: String)
  b

sub f(e: !E)
  match !e
    .a(t)
      s = keep(?t[1..])
      for _ in 0..50
        !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => print("b")

sub main()
  x = E.a(String("hello"))
  f(!x)
