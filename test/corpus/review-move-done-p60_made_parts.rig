obj S
  v: List[Int]
  w: List[Int]

obj T
  o: S?

fun mk() -> S
  S(v: List(), w: List())

sub m1()
  a = mk()
  !a.v.push(1)
  x = <(<a).v
  print(x.len)

sub m2(c: Bool)
  a = mk()
  b = mk()
  x = <(<a if c else <b).v
  print(x.len)

sub m3()
  t = T(o: mk())
  x = <((<t.o) ?? mk()).v
  print(x.len)

sub m4()
  a: List[Int] = List()
  b: List[Int] = List()
  x = <[<a, <b][0]
  print(x.len)

sub m5(c: Bool)
  x = <(mk() if c else mk()).v
  print(x.len)

sub main()
  m1()

# oracle: mk accept
# oracle: m2 reject C3
# oracle: m3 reject C3
# oracle: m4 reject C3
# oracle: m5 reject C3
# oracle: main accept
