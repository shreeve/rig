obj K
  c: Cell[List[Int]]

  fun get(!self) -> Int
    self.c[reset(!self)]

fun reset(k: !K) -> Int
  n: List[Int] = List()
  for i in 0..100
    !n.push(i + 50)
  !k.c.set(<n)
  0

sub main()
  k = *K(c: Cell(List()))
  !k.c.push(7)
  print((!k).get())
  cc: *Cell[List[Int]] = *Cell(List())
  !cc.push(1)
  print(cc[reset2(!cc)])

fun reset2(c: !Cell[List[Int]]) -> Int
  n: List[Int] = List()
  !n.push(42)
  !c.set(<n)
  0

