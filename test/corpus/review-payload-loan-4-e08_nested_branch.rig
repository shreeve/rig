struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

sub main()
  e = mk(1)
  d = mk(2)
  g = mk(3)
  c = false
  k = true
  match (!e if c else (!d if k else !g))
    .a(r)
      !r.v.push(42)
      r.n = 100
    .b => pass
  print(e, d, g)
