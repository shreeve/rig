obj Meters
  value: Float

obj Wrap[T]
  item: T

obj Node
  key: Int
  next: ^Node?

sub main()
  b = ^5
  n = ^Node(key: 1, next: ^Node(key: 2, next: none))
  c = Cell(0)
  c.set(c.get() + 3)
  s = *Signal(7)
  sh: *Cell[Int] = *Cell(9)
  m = Meters(3.5)
  w = Wrap(4)
  w2 = Wrap[?String]("hi")
  named = ^6
  print(b, n, c.get(), s.get(), sh.get(), m, w, w2, named)
