# The value is a view (made in __v); the target's index then grows what
# it views. The loan of __v must be live across the index.
obj H
  r: ?Int

fun grow(v: !List[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  0

sub main()
  v: List[Int] = List()
  !v.push(7)
  t = 5
  hs: List[H] = List()
  !hs.push(H(r: ?t))
  hs[grow(!v)] = H(r: ?v[0])
  print(hs[0].r)
