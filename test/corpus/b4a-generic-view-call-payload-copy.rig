enum Opt[T]
  some(v: T)
  nothing

fun get[T](o: ?Opt[T]) -> ?Opt[T] from o
  o

fun peek3[T](o: ?Opt[T], d: T) -> T
  match get(o)
    .some(v) => v
    .nothing => d

fun peek1[T](o: ?Opt[T], d: T) -> T
  match o
    .some(v) => v
    .nothing => d

sub main()
  o: Opt[String] = .some(v: String("t"))
  print(peek3(?o, String("d")))
