obj R
  n: Int

  drop(!self)
    print("drop", self.n)

  sub bump(!self)
    self.n += 1

sub wr(r: !R)
  r.n = 50

sub wrb(r: !^R)
  r = ^R(n: 60)

sub f(v: ?List[^R])
  for x in v
    !x.bump()
    wr(!x)
    wrb(!x)

sub main()
  v: List[^R] = List()
  !v.push(^R(n: 1))
  f(?v)
  for x in ?v
    !x.bump()
    wr(!x)
    wrb(!x)
    x.n = 3
  print(v)
