obj Bag
  items: List[Int]
  name: String

  fun first(!self) -> !Int
    !self.items[0]

  fun label(!self) -> !String
    !self.name

fun mk() -> Bag
  b = Bag(items: List(), name: String("a"))
  !b.items.push(1)
  b

sub main()
  (!mk()).first() = 1
  (!mk()).label() = String("zzz")
  (!mk()).first() += 5
  print("ok")
