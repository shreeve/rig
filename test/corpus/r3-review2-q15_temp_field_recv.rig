struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

struct H
  c: Counter
  arr: [1]Counter

sub bumpc(c: ?Counter)
  c.hit()

sub main()
  H(c: Counter(hits: Cell(0)), arr: [Counter(hits: Cell(0))]).c.hit()
  bumpc(?H(c: Counter(hits: Cell(0)), arr: [Counter(hits: Cell(0))]).c)
  bumpc(?H(c: Counter(hits: Cell(0)), arr: [Counter(hits: Cell(0))]).arr[0])
  print("ok")
