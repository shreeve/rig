error E
  bad

struct Node
  n: Int

fun f(k: Int) -> Int!
  return E.bad if k > 0
  k

enum Sh
  one(a: *Node, b: Int)
  two

sub g(k: Int)!
  s: Sh = .one(a: *Node(n: 1), b: f(k)!)
  s2 = Sh.one(a: *Node(n: 1), b: f(k)!)
  print(s == .two, s2 == .two)

sub main
  g(0) catch print("e")
  g(1) catch print("e")
