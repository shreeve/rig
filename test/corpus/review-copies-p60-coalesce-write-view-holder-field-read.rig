# Reading a field of `r ?? W(...)`, with `r: ?W?` and `W` holding a
# write view, copies nothing out for good: is it rejected?
obj W
  w: !List[Int]

sub main()
  a: List[Int] = List()
  !a.push(4)
  b: List[Int] = List()
  o: W? = W(w: !a)
  r = ?o
  print((r ?? W(w: !b)).w.len)
  if r as h
    print(h.w.len)
