obj Big
  v: List[Int]

obj View
  b: ?Big

enum O
  some(x: Big)
  nothing

fun put(v: !View, t: ?Big) -> Bool keeps t
  v.b = t
  true

sub viaIf()
  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: Big? = Big(v: List())
  if <o as x and put(!vw, ?x)
    print(vw.b.v.len)
  print("done")

sub viaMatch()
  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: O = .some(x: Big(v: List()))
  match <o
    .some(x) if put(!vw, ?x) => print(vw.b.v.len)
    _ => print("other")
  print("done")

sub main()
  viaIf()
  viaMatch()
