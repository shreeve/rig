struct Node
  key: Int
  left: Box[Node]?
  right: Box[Node]?

fun contains(root: ?Box[Node]?, key: Int) -> Bool
  cur = root
  while cur as n
    if key == n.key
      return true
    cur = ?n.left if key < n.key else ?n.right
  false

sub insert(slot: !Box[Node]?, key: Int)
  if !slot as n
    insert(!n.left, key) if key < n.key else insert(!n.right, key)
  else
    slot = Box(Node(key: key, left: none, right: none))

sub main
  root: Box[Node]? = none
  for k in [5, 2, 8, 1]
    insert(!root, k)
  print(contains(?root, 8), contains(?root, 3))
