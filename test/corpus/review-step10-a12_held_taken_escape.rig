# held / taken: a view of a loop element over a made value's field
# (`held`) or a made array (`taken`) stored past the loop.
obj H
  items: [2]String
  n: Int

fun mkh() -> H
  H(items: [String("held"), String("h2")], n: 1)

fun mka() -> [2]String
  [String("taken"), String("t2")]

sub main()
  z = String("z")
  r = ?z
  for x in ?mkh().items
    r = x
  print(r)
  s = ?z
  for y in ?mka()
    s = y
  print(s)
