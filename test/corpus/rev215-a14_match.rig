# Review probe (#215): a loan reaching a generic body's T; rejected, or runs sanitizer-clean.
enum Opt[T]
  some(value: T)
  nothing

fun g[T](o: ?Opt[T], d: T) -> T from d
  match o
    .some(v) => v
    .nothing => d

sub main()
  t = String("abc")
  u = String("u")
  o = Opt[?String].some(?t)
  r = g(?o, ?u)
  <o
  <t
  print(r)
