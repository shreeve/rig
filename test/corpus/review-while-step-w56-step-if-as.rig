# The step reads `h` inside an `if ... as` expression.
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 40
    return S(s: ?v[..])
  none

fun at(s: []Int, i: Int) -> Int?
  if i < s.len
    return s[i]
  none

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  while mk(?v, i) as h: k += (x if at(h.s, 0) as x else 0)
    i += 1
    !v.push(2)
  print(k)
