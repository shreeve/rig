struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun find(v: ?Vec[*Tok], k: Int) -> *Tok?
  for t in ?v
    break +t if t.n == k
  else
    none

sub main
  v: Vec[*Tok] = Vec()
  !v.push(*Tok(n: 1))
  !v.push(*Tok(n: 2))
  if find(?v, 2) as t
    print("found", t.n)
  print(find(?v, 3) == none)
