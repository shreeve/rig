struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main
  v: Vec[Int] = Vec()
  f = |!v, x: Int| !v.push(x)
  f(1)
  print(v.len)
  f(2)
