# a read view of an element obtained via ?self through a held write view, then push through the holder (expect reject)
obj Cur
  items: !List[String]

  fun peek(?self) -> ?String
    ?self.items[0]

  sub add(!self, t: String)
    !self.items.push(<t)

sub main()
  v: List[String] = List()
  !v.push(String("hello world, long enough for the heap"))
  c = Cur(items: !v)
  a = ?c.peek()
  !c.add(String("b"))
  !c.add(String("c"))
  !c.add(String("d"))
  !c.add(String("e"))
  print(a)
