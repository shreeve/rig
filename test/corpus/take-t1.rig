obj Node
  value: Int
  next: ^Node?

  drop(!self)
    print("drop", self.value)

obj Stack
  top: ^Node?

  sub push(!self, v: Int)
    self.top = ^Node(value: v, next: <self.top)

  fun pop(!self) -> Int?
    if <self.top as n
      self.top = <n.next
      return n.value
    none

  sub reverse(!self)
    cur = <self.top
    prev: ^Node? = none
    while <cur as n
      cur = <n.next
      n.next = <prev
      prev = <n
    self.top = <prev

sub main()
  s = Stack(top: none)
  !s.push(1)
  !s.push(2)
  !s.push(3)
  !s.reverse()
  print((!s).pop(), (!s).pop())
  print("end")
