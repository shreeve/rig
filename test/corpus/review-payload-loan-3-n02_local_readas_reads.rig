obj P
  t: String
  n: Int
  xs: List[Int]

sub main()
  xs: List[Int] = List()
  !xs.push(7)
  p = P(t: String("hello"), n: 3, xs: <xs)
  o: (!P)? = !p
  if o as x
    print(x.n, x.xs.len)
  a = [1, 2, 3]
  so: (![]Int)? = !a[..]
  if so as s
    print(s.len, s[1])
  tt = String("abc")
  to: (!String)? = !tt
  if to as t
    print(t.len, t[1..])
