enum E
  a(n: Int)
  b

error Bad
  bad

fun double(n: Int) -> Int
  n * 2

fun yes(n: Int) -> Bool
  n > 0

obj Set
  items: List[Int]

  fun insert(!self, k: Int) -> Bool
    !self.items.push(k)
    true

obj Q
  n: Int

  sub bump(!self)
    self.n += 1

  fun get(?self) -> Int
    self.n

obj S
  x: Int
  o: Int?
  a: [2]Int
  v: List[Int]
  q: Q
  e: E
  f: fun(Int) -> Int
  g: fun(Int) -> Bool
  t: String
  s: Set

fun mk(n: Int) -> S
  S(x: n, o: n, a: [n, n], v: List(), q: Q(n: n), e: E.a(n: n), f: double, g: yes, t: String("t"), s: Set(items: List()))

fun pk(d: !S, k: Bool) -> (!S)?
  return none if k
  d

fun fl(d: !S, k: Bool) -> (!S)!
  return Bad.bad if k
  d

sub bump(n: !Int)
  n += 100

fun show(c: ?S) -> Int
  c.x * 1000 + c.a[1] * 100 + c.q.n * 10 + c.v.len

sub go(pc: !S)
  y = (!(!pc).s).insert(1)
  print(y)

sub main()
  c = mk(1)
  go(!c)
  print(show(?c))
