struct B
  n: Int

  drop(!self)
    print("drop", self.n)

struct Point
  x: Int
  f: fun(Int) -> Point

  fun shifted(?self, d: Int) -> Point
    Point(x: self.x + d, f: self.f)

  fun mk(?self) -> B
    B(n: self.x)

fun mkp(n: Int) -> Point
  Point(x: n, f: mkp)

sub show_point(p: ?Point)
  print("point", p.x)

sub show_b(b: ?B)
  print("b", b.n)

sub main
  p = Point(x: 1, f: mkp)
  show_point(?p.shifted(4))
  show_b(?p.mk())
  h = *Point(x: 9, f: mkp)
  show_point(?h.shifted(1))
  show_b(?h.mk())
  print("end")
