# `+x` of a Vec, a box, or a struct of owners is a new owner, part by
# part (Core s2): it carries the loans of the views its value holds, and
# none on `x`.

fun mk() -> Vec[Int]
  v: Vec[Int] = Vec()
  !v.push(1)
  v

sub of_owner()
  v: Vec[Int] = Vec()
  !v.push(1)
  w = +v
  !v.push(2)
  -v
  print(w)

sub of_made()
  c = +mk()
  !c.push(2)
  print(c)

sub main()
  of_owner()
  of_made()

# expect:
# [1]
# [1, 2]

# oracle: of_owner accept
# oracle: of_made accept
