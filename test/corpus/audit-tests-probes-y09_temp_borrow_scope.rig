struct S
  n: Int
  m: Int

struct H
  s: ?S

fun rt(n: Int) -> Int
  n

fun clobber(a: Int) -> Int
  x = [a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a]
  x[0] + x[15]

sub main
  h = H(s: ?S(n: rt(1), m: rt(2)))
  if rt(1) == 1
    new h = H(s: ?S(n: rt(7), m: rt(8)))
    print(h.s.n)
  print(clobber(5))
  print(h.s.n, h.s.m)
