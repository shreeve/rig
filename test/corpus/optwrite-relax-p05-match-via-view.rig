obj K
  a: ?String

  sub put(!self, v: ?String) keeps v
    self.a = v

enum E
  one(k: K)
  nothing

sub putk(k: !K, v: ?String) keeps v
  k.a = v

sub main()
  t = String("outer")
  e: E = .one(k: K(a: ?t))
  if true
    w = !e
    match !w
      .one(k: x)
        d = String("local")
        !x.put(?d)
      .nothing => pass
  if true
    w = !e
    match !w
      .one(k: x)
        d = String("local2")
        putk(!x, ?d)
      .nothing => pass
  match e
    .one(k: y) => print(y.a)
    .nothing => pass
