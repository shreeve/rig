# `<` of a branching value whose leaf is a name or part that copies:
# the source is left as it was.
struct S
  n: Int

fun f(k: Int) -> Int!
  k

sub main
  n = 1
  s = S(n: 2)
  o: Int? = 3
  c = n == 1
  a = <(n if c else 5)
  b = <(s.n if c else 5)
  d = <(o ?? n)
  e = <(f(1) catch n)
  g = <(s if c else S(n: 4))
  print(a, b, d, e, g.n, n, s.n, o)

# oracle: f accept
# oracle: main reject C3
