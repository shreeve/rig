obj O
  n: Int?
  s: String?
  r: (?String)?

fun of(o: !O) -> !(Int?) from o
  !o.n

fun sf(o: !O) -> !(String?) from o
  !o.s

sub main()
  t = String("tt")
  o = O(n: 1, s: String("abc"), r: none)
  of(!o) = none
  print(o.n)
  of(!o) = 5
  sf(!o) = none
  print(o.n, o.s)
  sf(!o) = String("again")
  print(o.s)
