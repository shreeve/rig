obj Res
  n: Int
  t: String

enum E
  a(r: Res)
  b

fun pad(n: Int) -> Int
  arr = [n, n, n, n, n, n, n, n, n, n, n, n, n, n, n, n]
  arr[3] + arr[7]

sub main()
  e = E.a(r: Res(n: 1, t: String("hello")))
  keep = Res(n: 0, t: String("k"))
  saved = ?keep
  match e
    .a(r) => saved = ?r
    .b => pass
  print(pad(77))
  print(saved.n, saved.t)
  b = ^E.a(r: Res(n: 2, t: String("boxed")))
  match b
    .a(r) => saved = ?r
    .b => pass
  print(pad(88))
  print(saved.n, saved.t)
