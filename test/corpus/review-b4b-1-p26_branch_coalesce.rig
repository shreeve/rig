# `??` and `catch`-free branching match subject with a temp index. Expect reject or clean.
enum E
  a(t: String)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[E?] = List()
  !v.push(E.a(t: String("a")))
  w = E.b
  match (v[idx(?String("a"))] ?? w)
    .a(t) => print(t)
    .b => print("b")
  match !(v[idx(?String("a"))] ?? w)
    .a(t) => !t.add("x")
    .b => print("b")
  print(v, w)
