# The fold: a String that views a Text slot (vec-get-assign): rejected where the Text changes or ends while it is used, or runs sanitizer-clean.
enum E
  full(t: Text)
  empty

struct S
  name: String

struct H
  t: Text

fun id[T](x: ?T) -> ?T from x
  x

fun first(v: ?Vec[Text]) -> ?Text from v
  ?v[0]

sub main()
  o: Vec[Text] = Vec()
  !o.push(Text("hello"))
  keep: String = ""
  keep = first(?o)
  o[0] = Text("zzz")
  print(keep)
