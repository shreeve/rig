obj S
  c: Cell[List[Int]]

  fun growi(!self) -> Int
    for i in 0..100
      !self.c.push(i)
    5

obj O
  s: S

fun grow(s: !S) -> Int
  for i in 0..100
    !s.c.push(i)
  5

sub main()
  a = *O(s: S(c: Cell(List())))
  b = *O(s: S(c: Cell(List())))
  k = a.s.c.len == 0
  !a.s.c.push(1)
  print(a.s if k else b.s, (!a.s).growi())
