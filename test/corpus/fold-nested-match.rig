# The fold: a String that views a Text slot (nested-match): rejected, or runs sanitizer-clean.
enum E
  full(t: String)
  empty

obj H
  t: String

sub main()
  e = E.full(t: String("hello"))
  keep: ?String = ""
  match ?e
    .full(p) => match ?p[1..]
      s => keep = s
    .empty => pass
  e = E.empty
  print(keep)
