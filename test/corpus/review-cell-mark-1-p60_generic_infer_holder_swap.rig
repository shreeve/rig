obj H
  n: Cell[Int]
  items: List[Int]

obj S
  h: *H
  tag: Cell[Int]

sub sw[T](a: !T, b: !T)
  swap(!a, !b)

sub look(r: ?List[Int], s: ?S, t: ?S)
  sw(!s.h, !t.h)
  print(r.len)

sub main()
  v = List[Int]()
  !v.push(1)
  s = S(h: *H(n: Cell(1), items: <v), tag: Cell(0))
  t = S(h: *H(n: Cell(2), items: List()), tag: Cell(0))
  h2 = +s.h
  look(?h2.items, ?s, ?t)
  print(s.h.items.len)
