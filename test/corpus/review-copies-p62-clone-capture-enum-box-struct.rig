# `|+x|` deep-clones an enum with an owning payload, a Box, and a struct
# of a Text and a List of handles; each clone is dropped with its closure.
obj N
  v: Int

  drop(!self)
    print("drop", self.v)

enum E
  t(s: String)
  n(h: *N)
  nothing

obj R
  name: String
  hs: List[*N]

fun elen(e: ?E) -> Int
  match e
    .t(s) => s.len
    .n(h) => h.v
    .nothing => 0

sub main()
  e = E.t(s: String("enum text"))
  f = |+e| elen(?e)
  e = E.n(h: *N(v: 1))
  g = |+e| elen(?e)
  <e
  b = ^String("boxed")
  h = |+b| b.len
  <b
  r = R(name: String("rec"), hs: List())
  !r.hs.push(*N(v: 2))
  k = *|+r| r.name.len + r.hs[0].v
  <r
  k2 = +k
  print(f(), g(), h(), k(), k2())
  <k
  print(k2())
