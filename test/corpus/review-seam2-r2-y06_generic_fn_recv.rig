# Review probe r2/y06_generic_fn_recv.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.drop accept
# oracle: W.put accept
# oracle: mk accept
# oracle: mkw accept
# oracle: go reject C5
# oracle: main accept
struct S
  n: Int
  t: Text

  drop(!self)
    print("dropS", self.n)

struct H
  rs: Vec[String]

  drop(!self)
    print("dropH sees", self.rs)

struct W[V]
  h: H
  xs: Vec[V]

  sub put(!self, r: String, v: V)
    !self.h.rs.push(r)
    !self.xs.push(v)

fun mk(n: Int) -> S
  S(n: n, t: Text("hello world, long enough to be on the heap"))

fun mkw[V]() -> W[V]
  W(h: H(rs: Vec()), xs: Vec[V]())

sub go[V](v: V)
  !mkw[V]().put(?mk(1).t, <v)

sub main()
  go(5)
  print("end")
