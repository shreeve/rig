# oracle: mk accept

struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

sub main
  v: Vec[Int] = Vec()
  !v.push(3)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    continue if i == 2
    k += 100
  else
    print("ended")
  print(k, i)

# expect:
# ended
# 415 5
