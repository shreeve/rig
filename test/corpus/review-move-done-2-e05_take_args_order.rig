# A take beside a lend of the same place in one call.
obj S
  o: List[Int]?

  sub set(!self, x: List[Int]?)
    self.o = <x

fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

fun both(a: ?List[Int]?, b: List[Int]?) -> Int
  n = 0
  if a as x
    n += x.len
  if b as y
    n += y.len
  n

fun both2(b: List[Int]?, a: ?S) -> Int
  n = 0
  if b as y
    n += y.len
  if a.o as x
    n += x.len
  n

sub one()
  s = S(o: mkv(1))
  print(both(?s.o, <s.o))

sub two()
  s = S(o: mkv(1))
  print(both2(<s.o, ?s))

sub three()
  s = S(o: mkv(1))
  !s.set(<s.o)
  print(s.o == none)

sub four()
  v: List[List[Int]?] = List()
  !v.push(mkv(1))
  !v.push(<v[0])
  print(v.len, v[0] == none)

sub main()
  one()
  two()
  three()
  four()

# oracle: S.set accept
# oracle: mkv accept
# oracle: both accept
# oracle: both2 accept
# oracle: one reject C4
# oracle: two accept
# oracle: three reject C4
# oracle: four reject C4
# oracle: main accept
