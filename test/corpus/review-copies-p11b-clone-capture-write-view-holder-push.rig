# `|+h|` of a struct holding a write view of a List: the closure's copy
# writes through the view while the original also does.
obj H
  w: !List[Int]

sub bump(v: !List[Int])
  !v.push(9)

sub main()
  xs: List[Int] = List()
  h = H(w: !xs)
  f = |+h| bump(!h.w)
  !h.w.push(1)
  f()
  !h.w.push(2)
  print(h.w.len)
