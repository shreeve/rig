# `|+h|` of a struct holding a write view of a Vec: the closure's copy
# writes through the view while the original also does.
struct H
  w: !Vec[Int]

sub bump(v: !Vec[Int])
  !v.push(9)

sub main()
  xs: Vec[Int] = Vec()
  h = H(w: !xs)
  f = |+h| bump(!h.w)
  !h.w.push(1)
  f()
  !h.w.push(2)
  print(h.w.len)
