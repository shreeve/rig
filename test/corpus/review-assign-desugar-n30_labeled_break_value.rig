# Valid: a `break` out of a `for` inside the value, and a `break` out of
# the outer loop from the value's last arm.
sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  for i in 0..5
    w[0] = match i
      4 => 0
      _
        n = 0
        for j in 0..10
          n = j
          break if j == i
        break if i == 3
        n + 10
  print(v[0])

# expect:
# 12
