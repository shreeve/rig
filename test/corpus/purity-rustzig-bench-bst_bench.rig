obj Node
  key: Int
  left: ^Node?
  right: ^Node?

sub insert(slot: !^Node?, key: Int)
  if !slot as n
    insert(!n.left, key) if key < n.key else insert(!n.right, key)
  else
    slot = ^Node(key: key, left: none, right: none)

fun total(slot: ?^Node?) -> Int
  if slot as n
    return total(?n.left) + n.key + total(?n.right)
  0

sub main()
  root: ^Node? = none
  x = 12345
  i = 0
  while i < 20000 : i += 1
    x = (x * 1103515245 + 12345) % 2147483648
    insert(!root, x)
  print(total(?root))
