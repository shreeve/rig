struct R
  n: Int
  drop(!self)
    print("drop R", self.n)

fun first(s: String) -> U8?
  s.get(0)

fun lead(s: String, f: ?fun(String) -> R?) -> Int
  if f(s) as r
    return r.n
  -1

fun nested(s: String, f: ?fun(String) -> Int!) -> Int
  f(s) catch -9

error E
  bad

fun fail(n: Int) -> Int!
  if n == 0
    return E.bad
  n

sub main()
  print(lead("hi", |s|
    a = R(n: 1)
    R(n: Int(first(s)?) + a.n)))
  print(lead("", |s|
    a = R(n: 2)
    R(n: Int(first(s)?) + a.n)))
  print(nested("x", |s|
    g: *fun(Int) -> Int! = *|k| fail(k)! + 1
    g(s.len - 1)! + 100))
  print(nested("xy", |s|
    g: *fun(Int) -> Int! = *|k| fail(k)! + 1
    g(s.len - 1)! + 100))
  k: *fun(Int) -> U8? = *|n| first("abc"[n..])?
  print(k(1) ?? 0)
