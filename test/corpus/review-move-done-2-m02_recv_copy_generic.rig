# A consuming method called on a part of generic type, instantiated with
# a type that copies and with one that owns.
obj P
  v: Int

  fun into(<self) -> Int
    self.v

obj HV
  v: List[Int]

  fun into(<self) -> Int
    self.v.len

obj G[T]
  f: T

fun use_part[T](g: ?G[T]) -> Int
  g.f.into()

fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

sub main()
  a = G(f: P(v: 1))
  print(use_part(?a))
  b = G(f: HV(v: mkv(2)))
  print(use_part(?b))
  print(b.f.v.len)

# oracle: P.into accept
# oracle: HV.into accept
# oracle: mkv accept
