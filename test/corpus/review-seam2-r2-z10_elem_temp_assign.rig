# Review probe r2/z10_elem_temp_assign.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.me accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: mkh accept
# oracle: wrap accept
# oracle: wv accept
# oracle: main reject C5
struct S
  n: Int
  t: Text

  drop(!self)
    print("dropS", self.n)

struct H
  r: String
  rs: Vec[String]

  fun me(!self) -> !H
    self

  drop(!self)
    print("dropH sees", self.r, self.rs)

fun mk(n: Int) -> S
  S(n: n, t: Text("hello world, long enough to be on the heap ", n))

fun mkh -> H
  H(r: "init", rs: Vec())

fun wrap(h: !H) -> !H
  h

fun wv(v: !Vec[H]) -> !Vec[H]
  v

sub main
  v: Vec[H] = Vec()
  !v.push(mkh())
  if true
    s = mk(3)
    wv(!v)[0].r = ?s.t
  print("end")
