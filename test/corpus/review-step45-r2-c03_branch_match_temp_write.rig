# match (!v[idx(?Text("a"))] if c else !v[0]) guarded; grow payload
enum E
  a(t: Text)
  b(n: Int)

fun idx(s: String) -> Int
  s.len - 1

sub main()
  v: Vec[E] = Vec()
  !v.push(E.a(t: Text("hi")))
  c = v.len == 1
  match (!v[idx(?Text("a"))] if c else !v[0])
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0]
    .a(t) => print(t.len)
    .b(n) => print(n)
