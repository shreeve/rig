# A receiver that copies but holds a read view: `s.rv.into()` takes a
# copy; the result views what the receiver viewed.
obj RV
  r: ?List[Int]

  fun into(<self) -> ?List[Int]
    self.r

obj S
  rv: RV

fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

sub main()
  v = mkv(5)
  s = S(rv: RV(r: ?v))
  x = ?s.rv.into()
  v = mkv(6)
  print(x[0])

# oracle: RV.into accept
# oracle: mkv accept
# oracle: main reject C4
