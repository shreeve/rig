struct P
  t: Text
  n: Int

enum WP
  a(w: !P)
  b

enum WI
  a(w: !Int)
  b

struct H
  e: WP

struct HI
  e: WI

fun mk(p: !P) -> H from p
  H(e: WP.a(!p))

fun mki(x: !Int) -> HI from x
  HI(e: WI.a(!x))

sub main()
  p = P(t: Text("hello"), n: 2)
  match mk(!p).e
    .a(w)
      r = ?w.t[1..]
      print(r, w.n)
    .b => pass
  h = mk(!p)
  match !h.e
    .a(w)
      w.n = 7
      !w.t.add("!")
    .b => pass
  print(p.n, p.t)
  x = 3
  match mki(!x).e
    .a(w) if w > 2 => print("big", w + 1)
    .a(w) => print(w)
    .b => pass
  match mki(!x).e
    .a(w)
      k = w * 2
      print(k)
    .b => pass
