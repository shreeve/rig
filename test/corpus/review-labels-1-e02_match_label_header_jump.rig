fun get(i: Int) -> Bool?
  (i < 9) if i < 2 else none

sub main()
  k = 1
  @m match k
    1
      i = 0
      while get(i) ?? break @m : i += 1
        print(i)
      print("never")
    _ => print(0)
  @r raw
    i = 0
    while get(i) ?? break @r : i += 1
      print("r", i)
    print("never")
  print(9)
