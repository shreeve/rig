# `u[w[0]][w[1]] = ` where the last arm re-points `w` at its own local.
sub main()
  v: List[Int] = List()
  !v.push(0)
  !v.push(0)
  u: List[List[Int]] = List()
  !u.push(List())
  !u[0].push(0)
  w = ?v[0..2]
  k = 0
  u[w[0]][w[1]] = match k
    1 => 4
    _
      t: List[Int] = List()
      !t.push(0)
      !t.push(0)
      w = ?t[0..2]
      3
  print(u[0][0])
