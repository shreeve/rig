# A Cell change through an `if ... as` binding of a branching optional with
# a named leaf.
#
# oracle: C.hit accept
# oracle: main accept
struct C
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

fun mko(n: Int) -> C?
  C(c: Cell(n))

sub go(k: Bool)
  o: C? = C(c: Cell(1))
  if (o if k else mko(5)) as x
    x.hit()
    x.c.set(x.c.get() + 10)
  if o as y
    print(y.c.get())

sub main()
  go(true)
  go(false)

# expect:
# 12
# 1
