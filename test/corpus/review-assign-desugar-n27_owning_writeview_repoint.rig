# A write view of an owning struct, re-pointed in the value, which then
# grows the old List: the old value at y[0] is dropped and replaced.
obj S
  items: List[Int]

fun grow(v: !List[S]) -> Int
  for _ in 0..200
    !v.push(S(items: List()))
  v.len

sub main()
  x: List[S] = List()
  !x.push(S(items: List()))
  y: List[S] = List()
  !y.push(S(items: List()))
  !y[0].items.push(5)
  w = !x[0]
  k = 0
  w = match k
    0
      w = !y[0]
      n = grow(!x)
      t: List[Int] = List()
      !t.push(n)
      S(items: <t)
    _ => S(items: List())
  print(x.len, x[0].items.len, y[0].items[0])

# expect:
# 201 0 201
