obj P
  t: String

obj H
  w: !P

enum E
  a(h: H)
  b

sub put(q: !P)
  q.t = String("other")

sub main()
  p = P(t: String("hello"))
  e = E.a(H(w: !p))
  match e
    .a(h)
      r = ?h.w.t[1..]
      k: !P = match e
        .a(z) => z.w
        .b => h.w
      k.t = String("other")
      print(r)
    .b => pass
