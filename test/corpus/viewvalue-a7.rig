use std.hash

error Bad
  oops

fun setk(m: !hash.Map[String, String], k: ?String) -> Int?
  (!m).edit(k)? = String("new value that is long enough to allocate")
  1

fun lsl(v: !List[List[Int]], ok: Bool) -> (!List[Int])! from v
  return Bad.oops if not ok
  !v[0]

fun mkl() -> List[Int]
  l: List[Int] = List()
  !l.push(42)
  l

sub put(v: !List[List[Int]], ok: Bool)!
  lsl(!v, ok)! = mkl()

sub main()
  m = hash.Map[String, String]()
  !m.put(String("a"), String("old"))
  print(setk(!m, "a"), setk(!m, "b"), m.get("a"))
  v: List[List[Int]] = List()
  !v.push(List())
  put(!v, false) catch print("failed")
  put(!v, true) catch print("failed")
  print(v)
