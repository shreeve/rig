struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct H
  o: Box[Tok]?

sub main
  v: Vec[Box[H]] = Vec()
  !v.push(Box(H(o: Box(Tok(n: 1)))))
  for b in ?v
    x = <b.o
    print(x == none)
