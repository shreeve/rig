# match !getw(!v, ?Text("a"))[0]: temp in a call argument on the path (call returns a view)
enum E
  a(t: String)
  b(n: Int)

fun getw(v: !List[E], s: ?String) -> !List[E]
  v

sub main()
  v: List[E] = List()
  !v.push(E.a(t: String("hi")))
  match !getw(!v, ?String("a"))[0]
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0]
    .a(t) => print(t.len)
    .b(n) => print(n)
