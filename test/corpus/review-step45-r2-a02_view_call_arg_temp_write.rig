# match !getw(!v, ?Text("a"))[0]: temp in a call argument on the path (call returns a view)
enum E
  a(t: Text)
  b(n: Int)

fun getw(v: !Vec[E], s: String) -> !Vec[E]
  v

sub main()
  v: Vec[E] = Vec()
  !v.push(E.a(t: Text("hi")))
  match !getw(!v, ?Text("a"))[0]
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0]
    .a(t) => print(t.len)
    .b(n) => print(n)
