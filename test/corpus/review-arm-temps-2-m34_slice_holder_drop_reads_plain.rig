# The same as m33 with no nested statement: the right side grows `v`, then
# the store drops the old `h`, whose `drop` reads a slice of `v`.
struct H
  v: []Int

  drop(!self)
    print("drop", self.v[0])

fun growh(v: !Vec[Int], u: ?Vec[Int]) -> H
  for _ in 0..200
    !v.push(1)
  H(v: ?u[0..1])

sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  h = H(v: ?v[0..1])
  h = growh(!v, ?u)
  print("end")
