# A binary search tree of boxed nodes: `if !slot as n` views the node
# inside an optional box in place, and assigning to a `!^Node?`
# slot stores a new subtree.

obj Node
  key: Int
  left: ^Node?
  right: ^Node?

sub insert(slot: !^Node?, key: Int)
  if !slot as n
    if key < n.key
      insert(!n.left, key)
    else
      insert(!n.right, key)
  else
    slot = ^Node(key: key, left: none, right: none)

fun contains(slot: ?^Node?, key: Int) -> Bool
  if slot as n
    if key == n.key
      return true
    if key < n.key
      return contains(?n.left, key)
    return contains(?n.right, key)
  false

fun size(slot: ?^Node?) -> Int
  if slot as n
    1 + size(?n.left) + size(?n.right)
  else
    0

sub walk(slot: ?^Node?)
  if slot as n
    walk(?n.left)
    print(n.key)
    walk(?n.right)

sub main()
  root: ^Node? = none
  for k in [5, 2, 8, 1, 9, 3]
    insert(!root, k)
  print(size(?root), contains(?root, 3), contains(?root, 4))
  walk(?root)

# expect:
# 6 true false
# 1
# 2
# 3
# 5
# 8
# 9
