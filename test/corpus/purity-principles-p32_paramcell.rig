struct Counter
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

sub direct(c: Counter)
  !c.hits.set(9)
  print(c.hits.get())

sub viaMethod(c: Counter)
  !c.hit()
  print(c.hits.get())

sub cellParam(c: Cell[Int])
  !c.set(3)
  print(c.get())

sub main()
  direct(Counter(hits: Cell(0)))
  viaMethod(Counter(hits: Cell(0)))
  cellParam(Cell(0))
  for k in [Counter(hits: Cell(0))]
    k.hit()
    print("loop", k.hits.get())
