# std.time: clocks and sleeping. A time is an `Int` of nanoseconds.

pub NS = 1
pub US = 1_000
pub MS = 1_000_000
pub SECOND = 1_000_000_000
pub MINUTE = 60_000_000_000

extern zig "time.zig"
  # Nanoseconds on the monotonic clock, since an unspecified moment: it
  # never goes back, so the difference of two readings is the time
  # between them.
  pub fun now() -> Int

  # Nanoseconds since 1970-01-01 00:00 UTC on the wall clock, which can
  # be set, so it may jump.
  pub fun unix() -> Int

  # Wait at least `ns` nanoseconds; none when `ns` is not positive.
  pub sub sleep(ns: Int)

# Nanoseconds since `start`, a reading of `now()`.
pub fun elapsed(start: Int) -> Int
  now() - start
