error E
  bad

obj Q
  n: Int

  sub bump(!self)
    self.n += 1

obj P
  x: Int
  o: Int?
  a: [2]Int
  v: List[Int]
  q: Q

fun mk() -> P
  P(x: 1, o: 3, a: [1, 2], v: List(), q: Q(n: 1))

fun pick(p: !P, b: Bool) -> (!P)?
  return none if b
  p

fun fail(p: !P, b: Bool) -> (!P)!
  return E.bad if b
  p

sub main()
  p = mk()
  q = mk()
  (<(fail(!q, true) catch !p)).a[0] = 5
  print(p.a)
