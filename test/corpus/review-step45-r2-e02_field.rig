# H3: generic loop over ?List[T], body: store into a struct field
struct S
  t: String

struct Holder[T]
  x: T?

fun hold[T](v: ?List[T]) -> Holder[T]
  h = Holder[T](x: none)
  for x in v
    h.x = x
  <h

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(hold(?v).x)
