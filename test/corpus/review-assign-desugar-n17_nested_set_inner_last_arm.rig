# A nested assignment inside the value; the inner one's last arm
# re-points the OUTER target at its local.
sub run(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  x = 0
  w = !v[0..1]
  w[0] = match k
    1 => 4
    _
      x = match k
        1 => 5
        _
          u: Vec[Int] = Vec()
          !u.push(1)
          w = !u[0..1]
          6
      3
  print(v[0], x)

sub main()
  run(0)
