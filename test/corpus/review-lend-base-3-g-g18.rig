obj K
  hits: Cell[Int]
  log: Cell[List[Int]]
  n: Int

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

obj N
  v: Int
  next: (~N)?

fun made() -> K
  K(hits: Cell(0), log: Cell(List[Int]()), n: 3)

sub main()
  k = made()
  h = *N(v: 1, next: none)
  wk = ~h
  hh = +h
  (?hh).v = 9
  print(k.hits.get(), k.log.len, k.n, h.v)
