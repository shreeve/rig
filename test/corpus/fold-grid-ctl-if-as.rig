# The fold: a String that views a Text slot (ctl-if-as): rejected where the Text changes or ends while it is used, or runs sanitizer-clean.
enum E
  full(t: String)
  empty

obj S
  name: ?String

obj H
  t: String

fun id[T](x: ?T) -> ?T from x
  x

fun first(v: ?List[String]) -> ?String from v
  ?v[0]

sub main()
  o: String? = String("hello")
  keep: ?String = ""
  if ?o as p
    keep = p
  print(keep)
