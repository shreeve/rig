# `<` of a branching value one of whose leaves is an owning part of a
# value made there
struct S
  v: Vec[Int]

fun mk -> S
  v: Vec[Int] = Vec()
  !v.push(7)
  S(v: <v)

fun pick(c: Bool) -> Vec[Int]
  w: Vec[Int] = Vec()
  <(mk().v if c else <w)

sub main
  c = true
  x = <(mk().v if c else Vec[Int]())
  print(x.len)
  print(pick(true).len)

# oracle: mk accept
# oracle: main reject C3
