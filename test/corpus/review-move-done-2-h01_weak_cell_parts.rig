# Parts reached through a weak handle's upgrade, and through a Cell.
obj S
  v: List[Int]
  o: List[Int]?

fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

fun up(w: ~S) -> Int?
  x = <((*w)?.o)
  print(x == none)
  0

fun up2(w: ~S) -> Int?
  y = <((*w)?.v)
  print(y.len)
  0

sub main()
  h = *S(v: mkv(1), o: mkv(2))
  w = ~h
  print(up(w), up2(w))
  print(h.o == none, h.v.len)

# oracle: mkv accept
# oracle: up reject C3
# oracle: up2 reject C3
# oracle: main reject C2
