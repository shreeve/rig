# match !b.v[idx(?Text("a"))] through a Box: must reject
enum E
  a(t: Text)
  b(n: Int)

struct S
  v: List[E]

fun idx(s: String) -> Int
  s.len - 1

sub main()
  b = ^S(v: List())
  !b.v.push(E.a(t: Text("hi")))
  match !b.v[idx(?Text("a"))]
    .a(t) if t.len > 0 => !t.add("!")
    .a(t) => !t.add("?")
    .b(n) => print(n)
  print(b.v.len)
