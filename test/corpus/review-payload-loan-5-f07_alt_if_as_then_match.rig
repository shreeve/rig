struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

fun f(e: !E) -> Int?
  o: (!E)? = !e
  if o as x
    match x
      .a(r) => print(r.n)
      .b => pass
  if !o as x
    match !x
      .a(r) => r.n = 9
      .b => pass
  print(o)
  1

sub main()
  e = mk(1)
  _ = f(!e)
