obj P
  x: Int
  y: Int

obj S
  a: List[Int]
  b: Int

obj Q
  a: P
  b: Int

fun grow(v: !List[Int]) -> Int
  !v.push(7)
  2

fun bump(p: !P) -> Int
  p.x += 1
  0

fun rd(v: ?List[Int], n: Int) -> Int
  v.len + n

fun rp(p: P, n: Int) -> Int
  p.x + n

fun rs(s: []Int, n: Int) -> Int
  s.len + n

obj T
  x: Int
  fun get(?self, n: Int) -> Int
    self.x + n

fun bt(t: !T) -> Int
  t.x += 10
  0

sub main()
  t = T(x: 1)
  print(t.get(bt(!t)))
