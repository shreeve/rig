struct P
  x: Int
  o: Int?
  arr: [3]Int

fun pickw(p: !P, q: !P, c: Bool) -> !Int
  !(<(!p if c else !q)).x

fun pickr(p: ?P, q: ?P, c: Bool) -> Int
  (<(?p if c else ?q)).arr[1]

fun pickv(p: ?P, q: ?P, c: Bool) -> ?Int
  ?(<(?p if c else ?q)).arr[2]

sub main()
  p = P(x: 1, o: 5, arr: [1, 2, 3])
  q = P(x: 2, o: none, arr: [4, 5, 6])
  w = pickw(!p, !q, false)
  w += 10
  print(q.x)
  print(pickr(?p, ?q, true))
  print(pickv(?p, ?q, false))
  f = |!p, !q| (<(!p if true else !q)).x = 99
  f()
  print(p.x)
  g = |?p, ?q, k: Bool| (<(?p if k else ?q)).o ?? -1
  print(g(false), g(true))
  if <(<(!p if true else !q)).o as v
    print(v)
  print(p.o ?? 0)
  print((<(?p if false else ?q)).x == 2)
