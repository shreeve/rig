# Review probe h01_holder_drop_order.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
obj S
  n: Int
  items: List[Int]

  fun at(!self) -> !Int
    !self.n

  drop(!self)
    print("dropS", self.n)
    self.n = 777

obj H
  ws: List[!Int]

  sub keep(!self, w: !Int)
    !self.ws.push(w)

  drop(!self)
    for w in self.ws
      print("dropH sees", w)

fun mk(n: Int) -> S
  S(n: n, items: List())

fun mkh() -> H
  H(ws: List())

sub main()
  !mkh().keep((!mk(1)).at())
