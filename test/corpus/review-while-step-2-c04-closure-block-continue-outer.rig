# A block-bodied closure naming an outer loop label. Expected: rejected.
#
# oracle: mk accept
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  @outer while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    f = ||
      continue @outer
    f()
  print(k)
