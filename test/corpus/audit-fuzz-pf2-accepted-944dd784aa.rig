# `T.min` and `T.max` are a number type's least and greatest values,
# constants of that type; a float's least is its most negative finite
# value.

LAST = U8.max

fun clamp(n: Int) -> U8
  U8(n) if n < Int(U8.max) else U8.max

sub main()
  print(U8.min, U8.max, I8.min, I16.max, U32.max)
  print(Int.min, Int.max, U64.max)
  print(I128.min, U128.max)
  print(F32.max > 3.0e38, Float.min == -F64.max, Float.max > 1.7e308)
  print(LAST, clamp(7), clamp(300), U8.max -% 1 +% 2)
  buf: [U8.max]Bool = [U8.max of false]
  print(buf.len, U16.max / 2 + 1)
# expect:
# 0 255 -128 32767 42949-x67295
# -9223372036854775808 9223372036854775807 18446744073709551615
# -170141183460469231731687303715884105728 340282366920938463463374607431768211455
# true true true
# 255 7 255 0
# 255 32768
