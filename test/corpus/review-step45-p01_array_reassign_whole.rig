# reassign an array of owners whole, and an element of a List of arrays
obj D
  n: Int

  drop(!self)
    print("drop", self.n)

sub main()
  a = [D(n: 1), D(n: 2)]
  a = [D(n: 3), D(n: 4)]
  print("mid")
  v: List[[2]String] = List()
  !v.push([String("a"), String("b")])
  v[0][1] = String("z")
  v[0] = [String("p"), String("q")]
  print(v)
