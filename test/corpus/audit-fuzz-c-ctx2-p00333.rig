  x

fun id_i128(x: I128) -> I128
  x

fun id_u128(x: U128) -> U128
  x

fun id_float(x: Float) -> Float
  x

fun id_f32(x: F32) -> F32
  x

struct GP3713[T]
  f: T

fun cf18(ok: Bool) -> U16!
  return CE18.no if not ok
  11482

error CE18
  no

fun fo5013(s: Bool) -> U64?
  return none if not s
  18446744073709551615

fun fu5013(s: Bool) -> U64?
  x = fo5013(s)?
  x

enum Op5013
  some(v: U64)
  nothing

struct FA1759
  f: Float

struct Bx1497
  f: U64

struct FA1218
  f: U8

fun fal3588(ok: Bool) -> U32!
  return Err3588.bad if not ok
  4

error Err3588
  bad

fun fal387(ok: Bool) -> U128!
  return Err387.bad if not ok
  247082430125122878275228786794844851034

error Err387
  bad

struct W387
  f: U128
  g: Int = 1

sub t408
  arr408: [2]F32 = [0, (-1.5)]
  vec408: Vec[F32] = Vec()
  !vec408.push(arr408[1])
  print(vec408)

sub t5652
  o5652: U64? = id_u64(18098824267028067248)
  vw5652: Vec[U64] = Vec()
  pushit5652 = |!vw5652, x: U64| !vw5652.push(x)
  pushit5652((o5652 ?? 2))
  print(vw5652)

sub t3713
  gp3713: GP3713[F32] = GP3713(f: gid(0.5))
  print(gp3713.f)

sub t18
  o18: U16? = none
  flag18 = rt_bool(false)
  print(cf18(false) catch (o18 ?? (53771 if flag18 else 48455)))

sub t5013
  en5013: Op5013 = .some((fu5013(false) ?? 19))
  print(en5013)

sub t1759
