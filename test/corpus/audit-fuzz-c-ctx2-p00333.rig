  print(x201)

sub t387
  w387 = W387(f: (fal387(true) catch 182303071622359499255022518865723165525))
  print(w387.f, w387)

sub t241
  cmp241: U128 = id_u128(66597)
  print(cmp241 == 17, 17 < cmp241, 17 >= cmp241)

