  x

fun id_i128(x: I128) -> I128
  x

fun id_u128(x: U128) -> U128
  x

fun id_float(x: Float) -> Float
  x

fun id_f32(x: F32) -> F32
  x

struct Bx472
  f: I32

sub t472
  bx472 = Bx472(f: 6)
  av472: Vec[I32] = Vec()
  !av472.push(0)
  av472[0] = bx472.f
  aa472: [3]I32 = [3 of 0]
  aa472[rt_int(2)] = bx472.f
  print(av472[0], aa472)

sub main
  t472()
