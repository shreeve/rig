fun rt_bool(b: Bool) -> Bool
  b

fun rt_int(n: Int) -> Int
  n

fun gid[T](a: T) -> T
  a

fun gmax[T](a: T, b: T) -> T
  a if a > b else b

fun gsome[T](a: T) -> T?
  a

fun id_u8(x: U8) -> U8
  x

fun id_i8(x: I8) -> I8
  x

