# write match on vv[0][i]; arm pushes to vv (outer) then writes payload. Expect reject.
enum E
  a(n: Int)
  b

sub main()
  vv: List[List[E]] = List()
  w: List[E] = List()
  !w.push(E.a(n: 4))
  !vv.push(<w)
  i = 0
  match !vv[0][i]
    .a(n)
      for _ in 0..64
        x: List[E] = List()
        !vv.push(<x)
      n = 5
    .b => pass
  print(vv[0][0])
