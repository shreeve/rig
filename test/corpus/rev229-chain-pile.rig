# Step 3 of the frame owners round: `a`, which the rule inlines, calls
# `g`, marked `inline`, which calls `w`, which the rule inlines, 56 KB of
# values; `near` calls `a` 300 times. Each call of `a` lands `g` and `w`
# in `near`'s frame, so `w`'s frame counts in `near`'s account through
# both, and the rule stops before the frame passes 64 KiB.

fun w(i: Int) -> Int
  t = [7000 of 0]
  for k in 0..7000
    t[k] = k + i
  t[i % 7000]

inline fun g(i: Int) -> Int
  w(i) + 1

fun a(i: Int) -> Int
  g(i)

fun near(i: Int) -> Int
  a(i + 0) + a(i + 1) + a(i + 2) + a(i + 3) + a(i + 4) + a(i + 5) + a(i + 6) + a(i + 7) + a(i + 8) + a(i + 9) + \
  a(i + 10) + a(i + 11) + a(i + 12) + a(i + 13) + a(i + 14) + a(i + 15) + a(i + 16) + a(i + 17) + a(i + 18) + a(i + 19) + \
  a(i + 20) + a(i + 21) + a(i + 22) + a(i + 23) + a(i + 24) + a(i + 25) + a(i + 26) + a(i + 27) + a(i + 28) + a(i + 29) + \
