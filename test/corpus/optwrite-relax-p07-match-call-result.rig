obj K
  a: ?String

  sub put(!self, v: ?String) keeps v
    self.a = v

enum E
  one(k: K)
  nothing

fun thru(e: !E) -> !E
  e

sub main()
  t = String("outer")
  e: E = .one(k: K(a: ?t))
  if true
    match !thru(!e)
      .one(k: x)
        d = String("local")
        !x.put(?d)
      .nothing => pass
  match e
    .one(k: y) => print(y.a)
    .nothing => pass
