obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub bump(v: !List[Int])
  !v.push(9)

sub main()
  v: List[Int] = List()
  f = |!v| bump(!v)
  f()
  f()
  print(v.len)
