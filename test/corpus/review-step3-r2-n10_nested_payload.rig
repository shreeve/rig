struct Res
  n: Int
  t: Text

enum In
  x(r: Res)
  y

enum Out
  w(i: In, t: Text)
  z

fun deep(o: ?Out, d: ?Res) -> ?Res
  match o
    .w(i, t) if t.len > 0
      match i
        .x(r) if r.n > 0 => r
        .x(r) => r
        .y => d
    .w(i, _)
      match i
        .x(r) => r
        .y => d
    .z => d

sub main
  o = Out.w(i: In.x(r: Res(n: 3, t: Text("three"))), t: Text("t"))
  dd = Res(n: 0, t: Text("d"))
  r = deep(o, dd)
  arr = [1, 2, 3, 4, 5, 6, 7, 8]
  print(arr[2])
  print(r.n, r.t)
