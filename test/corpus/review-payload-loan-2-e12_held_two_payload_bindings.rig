obj P
  t: String

enum WP2
  a(w: !P, v: ?P)
  b

obj H
  e: WP2

fun mk(p: !P, q: ?P) -> H from p, q
  H(e: WP2.a(w: !p, v: q))

sub main()
  p = P(t: String("hello"))
  q = P(t: String("q"))
  match mk(!p, ?q).e
    .a(w: w, v: v)
      r = ?w.t[1..]
      !w.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r, v.t)
    .b => pass
