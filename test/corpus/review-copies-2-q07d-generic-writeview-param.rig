error Bad
  oops

struct P
  x: Int

struct Q
  p: P
  n: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r


fun first[T](r: !T, ok: Bool) -> (!T)!
  return Bad.oops if not ok
  r

sub main
  a = P(x: 1)
  b = P(x: 2)
  v = first(!a, true) catch !b
  v.x = 7
  u = first(!b, false) catch !a
  u.x += 100
  vs: Vec[Int] = Vec()
  print(a.x, b.x)
