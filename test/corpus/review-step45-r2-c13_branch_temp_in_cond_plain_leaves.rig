# if (!a if f(?Text("x")) else !b) as t: temp only in the branch condition (c01c), List leaf
fun f(s: ?String) -> Bool
  s.len == 1

sub main()
  v: List[String?] = List()
  !v.push(String("q"))
  w: String? = String("w")
  if (!v[0] if f(?String("x")) else !w) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(v[0], w)
