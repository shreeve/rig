fun f0(a0: Int) -> Int
  new a0 = a0
  b0 = 8
  c0 = -4
  o1: Int? = 16 if (-1) <= c0 else none
  if o1 as o1x
    print("some", o1x)
  else
    print("none", o1 ?? (18 % 9))
  v2 = for i3 in 0..6
    break (5 - b0) if (i3 >= 4) and (not (((9 % 6) <= 8) or (((-5) + c0) > 11)))
  else
    (18 / 6)
  print("lv", v2)
  a0 + b0 + c0

fun f1(a1: Int) -> Int
  new a1 = a1
  b1 = 6
  c1 = -3
  :l1 for i4 in (-1)..5
    print(i4)
    c1 = ((16 % 9) - (5 / 9)) % 1000
    a1 -= (3 - (i4 % 8))
    a1 = a1 % 1000
  defer print("defer", (b1 % 3))
  c1 += ((b1 - 1) - ((-8) / 2))
  c1 = c1 % 1000
  a1 + b1 + c1

sub main
  print("ret", f0(7))
  print("ret", f1((-1)))
  print("ret", f1(5))
