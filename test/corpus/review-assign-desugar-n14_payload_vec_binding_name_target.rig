# A write payload binding holding a List, as a name target: the value
# replaces the subject, which drops the List the store writes into.
enum Bx
  has(v: List[Int])
  nothing

fun grow(b: !Bx) -> Int
  b = Bx.nothing
  0

sub main()
  b = Bx.has(List())
  k = 0
  match !b
    .has(d)
      d = match k
        0
          grow(!b)
          List()
        _ => List()
    .nothing => pass
