error E
  bad

struct Res
  id: Int

  drop(!self)
    print("drop", self.id)

fun may(n: Int) -> Int!
  return E.bad if n < 0
  n

fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

fun go(n: Int) -> Int!
  r = Res(id: n)
  apply(|<r, a| a + r.id, may(n)!)

sub main()
  print(go(3) catch -1)
  print(go(-2) catch -1)
