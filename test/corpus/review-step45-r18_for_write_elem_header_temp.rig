# for t in !m[idx(?Text("a"))]: write loop over an element List, header temporary
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  m: List[List[String]] = List()
  r: List[String] = List()
  !r.push(String("q"))
  !m.push(<r)
  for t in !m[idx(?String("a"))]
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(m[0][0].len)
