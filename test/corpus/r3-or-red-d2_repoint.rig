# Must stay rejected under D2 depth tokens: after `self.src = other`,
# a projection of `self.src` is not `ext(self, src)` alone.
obj Tok
  n: Int

obj Parser
  src: ?List[Tok]
  scratch: List[Tok]

  fun next(!self, other: ?List[Tok]) -> ?Tok keeps other
    self.src = other
    ?self.src[0]

sub main()
  a: List[Tok] = List()
  !a.push(Tok(n: 1))
  p = Parser(src: ?a, scratch: List())
  t = ?a[0]
  if true
    b: List[Tok] = List()
    !b.push(Tok(n: 2))
    t = (!p).next(?b)
  print(t.n)
