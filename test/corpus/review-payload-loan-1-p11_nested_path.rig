enum E
  a(t: String)
  b

obj H
  e: E

obj G
  h: H

sub f(p: !G)
  match !p.h.e
    .a(t)
      s = ?t[1..]
      for _ in 0..50
        !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub main()
  g = G(h: H(e: E.a(String("hello"))))
  f(!g)
