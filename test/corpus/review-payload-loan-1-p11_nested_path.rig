enum E
  a(t: Text)
  b

struct H
  e: E

struct G
  h: H

sub f(p: !G)
  match !p.h.e
    .a(t)
      s = ?t[1..]
      for _ in 0..50
        !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub main()
  g = G(h: H(e: E.a(Text("hello"))))
  f(!g)
