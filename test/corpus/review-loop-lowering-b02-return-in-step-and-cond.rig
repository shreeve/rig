# `return` from a step and from a condition, with owned locals before the
# loop and in the body.
#
# oracle: D.drop accept
# oracle: nxt accept
# oracle: mk accept
# oracle: f accept
# oracle: h3 accept
# oracle: main accept
struct D
  n: Int
  drop(!self)
    print("drop", self.n)

fun nxt(i: Int) -> Int?
  i + 1 if i < 2 else none

fun mk(i: Int) -> Int?
  50 + i if i < 5 else none

fun f(lim: Int) -> Int
  keep = D(n: 1)
  i = 0
  while i < 10: i = nxt(i) ?? return 7
    d = D(n: 10 + i)
    defer print("defer", i)
  0

fun g(lim: Int) -> Int
  keep = D(n: 2)
  i = 0
  while mk(i) as h and (nxt(i) ?? return 8) > 0: i += 1
    d = D(n: 20 + i)
    print("body", h)
  0

fun h3(lim: Int) -> Int
  keep = D(n: 3)
  i = 0
  while mk(i) as h: i = nxt(h - 50) ?? return h
    d = D(n: 30 + i)
    defer print("defer", i)
    print("body", h)
  0

sub main()
  print("f", f(0))
  print("g", g(0))
  print("h", h3(0))
