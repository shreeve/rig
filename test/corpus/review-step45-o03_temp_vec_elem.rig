# index the List a call returns: print, bind, lend, take
fun mk() -> List[String]
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  <v

fun mko() -> List[String?]
  v: List[String?] = List()
  !v.push(String("a"))
  <v

sub main()
  print(mk()[1], mk()[0].len)
  t = <mko()[0]
  print(t)
