# H3: generic loop over ?List[T], body: T = ^Text, return element
struct S
  t: Text

struct Holder[T]
  x: T?

fun first[T](v: ?List[T]) -> T?
  for x in v
    return x
  none

sub main()
  v: List[Text] = List()
  !v.push(Text("a"))
  !v.push(Text("b"))
  b: List[^Text] = List()
  !b.push(^Text("q"))
  r = first(?b)
  <b
  print(r)
