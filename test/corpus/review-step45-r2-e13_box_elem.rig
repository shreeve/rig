# H3: generic loop over ?List[T], body: T = ^Text, return element
obj S
  t: String

obj Holder[T]
  x: T?

fun first[T](v: ?List[T]) -> T?
  for x in v
    return x
  none

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  b: List[^String] = List()
  !b.push(^String("q"))
  r = first(?b)
  <b
  print(r)
