obj Pair[A, B]
  a: A
  b: B

obj Chain[T]
  items: List[T]

  fun zip[U](?self, other: ?Chain[U]) -> Chain[Pair[T, U]]
    out: List[Pair[T, U]] = List()
    i = 0
    while i < self.items.len and i < other.items.len
      !out.push(Pair(a: self.items[i], b: other.items[i]))
      i += 1
    Chain(items: <out)

  fun count(?self) -> Int
    self.items.len

sub main()
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  l = Chain(items: <v)
  w: List[?String] = List()
  !w.push("a")
  !w.push("b")
  m = Chain(items: <w)
  z = ?l.zip(?m)
  print(z.count(), z.items[1].b)
