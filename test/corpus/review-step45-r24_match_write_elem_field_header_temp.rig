# match !v[idx(?Text("a"))].e (field of an element), guarded, grows a Text payload
enum E
  a(t: String)
  b(n: Int)

obj S
  e: E

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[S] = List()
  !v.push(S(e: E.a(t: String("hi"))))
  match !v[idx(?String("a"))].e
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0].e
    .a(t) => print(t.len)
    .b(n) => print(n)
