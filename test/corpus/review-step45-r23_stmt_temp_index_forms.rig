# statement temporaries inside an element index in every statement form
fun idx(s: ?String) -> Int
  s.len - 1

sub grow(t: !String)
  for _ in 0..40
    !t.add("xxxxxxxx")

sub main()
  v: List[String] = List()
  !v.push(String("q"))
  v[idx(?String("a"))] = String("z")
  !v[idx(?String("a"))].add("!")
  grow(!v[idx(?String("a"))])
  print(v[0].len)
  o: List[String?] = List()
  !o.push(String("p"))
  t = <o[idx(?String("a"))]
  print(t, o)
  n: List[Int] = List()
  !n.push(1)
  n[idx(?String("a"))] += 5
  print(n)
  s = ?v[idx(?String("a"))]
  print(s.len)
