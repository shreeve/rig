struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main()
  s: Slot = .pair(a: *Tok(n: 1), b: *Tok(n: 2))
  match <s
    .pair(a, b) if a.n > 5 => eat(<a)
    .pair(a, b) if b.n > 1 => eat(<b)
    _ => print("other")
  print("end")
