# read match through a shared handle element with a temp index; arm drops other handles. Expect accept, clean.
enum E
  a(t: String)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  h: *E = *E.a(t: String("x"))
  hs = [+h, +h]
  match hs[idx(?String("a"))]
    .a(t)
      <h
      print(t)
    .b => pass
