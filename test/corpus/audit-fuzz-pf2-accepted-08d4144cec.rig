# A boxed value holding a Cell changes through any path to it, and a
# Cell can hold a box.

obj C
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

fun peek(b: !^C) -> Int
  !b.hit()
  b.hits.get()

sub main()
  b = ^C(hits: Cell(0))
  !b.hit()
  print(peek(!b))
  cell: Cell[^C] = Cell(^C(hits: Cell(5)))
  b.hits.get()
  old = (!cell).replace(^C(hits: Cell(7)))
  print(old.hits.get())

# expect:
# 2
# 5
