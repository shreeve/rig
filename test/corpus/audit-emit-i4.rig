error E
  bad

struct R
  n: Int
  drop(!self)
    print("drop R", self.n)

fun mk(k: Int) -> R!
  return E.bad if k < 0
  R(n: k)

fun pick(c: Bool) -> R
  a = R(n: 1)
  b = R(n: 2)
  if c
    a
  else
    b

sub main()
  p = pick(true)
  print(p.n)
  d = R(n: 5)
  x = mk(-1) catch <d
  print(x.n)
