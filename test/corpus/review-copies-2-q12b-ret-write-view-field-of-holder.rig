error Bad
  oops

struct P
  x: Int

struct Q
  r: ?P
  n: Int

struct W
  w: !P

struct WI
  w: !Int

fun f(h: W, ok: Bool) -> (!P)!
  return Bad.oops if not ok
  h.w

sub main()
  a = P(x: 1)
  b = P(x: 2)
  v = f(W(w: !a), true) catch !b
  v.x = 10
  u = f(W(w: !a), false) catch !b
  u.x = 20
  print(a.x, b.x)
