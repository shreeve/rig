struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

sub bump(c: Counter)
  c.hit()
  print("param", c.hits.get())

sub main
  k =! Counter(hits: Cell(0))
  k.hit()
  k.hit()
  print(k.hits.get())
  c = Cell(5)
  c.set(6)
  print(c.get())
  bump(<k)
  bump(Counter(hits: Cell(40)))
