# Direct `c[i] = e` and `c[i] += e` into a temporary's Cell[List].
#
obj Log
  lines: Cell[List[Int]]

fun made() -> Log
  w: List[Int] = List()
  !w.push(1)
  Log(lines: Cell(<w))

fun freshv() -> Cell[List[Int]]
  w: List[Int] = List()
  !w.push(1)
  Cell(<w)

sub main()
  made().lines[0] += 4
  freshv()[0] = 3
