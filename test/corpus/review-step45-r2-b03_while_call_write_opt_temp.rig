# while getw(!o, ?Text("a")) as t: re-evaluated each iteration, grow t, break
fun getw(o: !String?, s: ?String) -> !String?
  o

sub main()
  o: String? = String("q")
  n = 0
  while getw(!o, ?String("a")) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
    n += 1
    if n == 2
      break
  print(o)
