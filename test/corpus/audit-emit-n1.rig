limit = 4

struct Ring[T, n: Int]
  buf: [n]T
  head: Int = 0
  count: Int = 0

  sub push(!self, x: T)
    self.buf[(self.head + self.count) % n] = x
    if self.count < n
      self.count += 1
    else
      self.head = (self.head + 1) % n

  fun at(?self, i: Int) -> T
    self.buf[(self.head + i) % n]

  fun cap(?self) -> Int
    n

fun zeros[n: Int]() -> [n]Int
  [n of 0]

fun sum[n: Int](xs: ?[n]Int) -> Int
  t = 0
  for x in xs
    t += x
  t

fun first[n: Int](xs: ?[n]Int) -> Int
  xs[0]

sub show[s: String, b: Bool, o: Int?]()
  print(s, b, o)

sub main()
  r = Ring[Int, limit * 2](buf: [limit * 2 of 0])
  for i in 0..10
    !r.push(i)
  print(r.at(0), r.at(7), r.cap(), r.count)
  z = zeros[3]()
  print(z, sum(?z), first(?z))
  e = zeros[0]()
  print(e, sum(?e))
  show["hi", true, none]()
  show["x", limit > 3, 5]()
  w = Ring[Float, 2](buf: [2 of 1.5])
  !w.push(2.5)
  print(w.at(0), w.at(1))
