# match !v[idx(?Text("a"))] with a guard: a write payload grows the Text in the arm
enum E
  a(t: String)
  b(n: Int)

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[E] = List()
  !v.push(E.a(t: String("hi")))
  match !v[idx(?String("a"))]
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0]
    .a(t) => print(t.len)
    .b(n) => print(n)
