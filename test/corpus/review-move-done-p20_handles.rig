struct S
  n: Int
  v: Vec[Int]
  o: Vec[Int]?

sub h1
  h = *S(n: 1, v: Vec(), o: none)
  w = <h.v
  print(w.len)

sub h2
  h = *S(n: 1, v: Vec(), o: none)
  w = <h.o
  print(w)

sub h3
  h = *S(n: 1, v: Vec(), o: none)
  k = ~h
  if k.upgrade() as g
    w = <g.v
    print(w.len)

sub h4
  h = *S(n: 1, v: Vec(), o: none)
  w = <(+h).v
  print(w.len)

sub h5
  h = *S(n: 1, v: Vec(), o: none)
  w = <(!h).v
  print(w.len)

sub main
  h1()

# oracle: h1 reject C3
# oracle: h3 reject C3
# oracle: h4 reject C3
# oracle: h5 reject C3
# oracle: main accept
