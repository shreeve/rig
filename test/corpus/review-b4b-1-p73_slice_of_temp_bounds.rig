# subject is an element of a slice whose bounds make a temp. Expect clean, correct.
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[String?] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  if !(!v[idx(?String("ab"))..])[0] as t
    !t.add("x")
  if (?v[idx(?String("a"))..2])[1] as t
    print(t)
  print(v)
