struct Key
  id: Int

struct Entry
  id: Int
  score: Int

struct Table
  rows: [3]Entry

  fun find(?self, key: ?Key) -> (?Entry)?
    for i in 0..3
      if self.rows[i].id == key.id
        return ?self.rows[i]
    none

sub main
  t = Table(rows: [Entry(id: 1, score: 10), Entry(id: 2, score: 20), Entry(id: 3, score: 30)])
  k = Key(id: 2)
  if t.find(?k) as hit
    k.id = 3
    print(hit.score, k.id)
