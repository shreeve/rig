# Branching receivers with a named leaf of every branching kind, the named
# leaf taken: the Cell change must land in the name's value.
#
# oracle: D.drop accept
# oracle: D.hit accept
# oracle: mkd accept
# oracle: main accept
struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

  sub hit(?self)
    self.c.set(self.c.get() + 1)

error E
  bad

fun mkd(n: Int) -> D
  D(c: Cell(n))

sub run(k: Int)
  a = mkd(10)
  o: D? = mkd(20)
  (a if k == 0 else mkd(11)).c.set(100)
  (a if k == 0 else mkd(12)).hit()
  (o ?? mkd(21)).c.set(300)
  (o ?? mkd(22)).hit()
  print(a.c.get())
  if o as x
    print(x.c.get())

sub main()
  run(0)

# expect:
# 101
# 301
# drop 301
# drop 101
