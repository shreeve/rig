fun keep(s: ?String) -> ?String
  s

sub main()
  a = String("hello")
  b = String("world")
  v: List[!String] = List()
  !v.push(!a)
  !v.push(!b)
  out: List[?String] = List()
  for w in v
    !out.push(keep(w[1..]))
  for w in !v
    for _ in 0..50
      !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(out)
