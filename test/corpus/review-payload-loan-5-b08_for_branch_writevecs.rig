struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

sub f(a: !Vec[Int], b: !Vec[Int], c: Bool)
  for x in (a if c else b)
    !a.push(x)
    if a.len > 200
      break
  print(a.len)

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  u: Vec[Int] = Vec()
  f(!v, !u, true)
