# while-as over an element via temp index; body moves the owner after using t. Expect reject (moved in loop).
fun idx(s: ?String) -> Int
  s.len - 1

sub eat(v: List[String?])
  print(v.len)

sub main()
  a: List[String?] = List()
  !a.push(String("a"))
  while a[idx(?String("a"))] as t
    print(t)
    eat(<a)
