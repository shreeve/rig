struct Rec
  name: Text
  n: Int

fun size(v: ?List[Int]) -> Int
  v.len

sub main()
  rows: List[List[Int]] = List()
  r: List[Int] = List()
  !r.push(5)
  !rows.push(<r)
  print(rows.len, rows[0].len)
  !rows[0].push(6)
  print(rows[0], size(?rows[0]), size(rows[0]))
  q: List[Int] = List()
  rows[0] = <q
  print(rows)
  ts: List[Text] = List()
  !ts.push(Text("a"))
  !ts[0].add("b")
  print(ts[0], ts[0].len)
  ts[0] = Text("zz")
  print(ts)
  rs: List[Rec] = List()
  !rs.push(Rec(name: Text("x"), n: 1))
  rs[0].n = 4
  rs[0].name = Text("y")
  print(rs[0].name, rs[0].n)
  os: List[Text?] = List()
  !os.push(Text("o"))
  if <os[0] as t
    print(t)
  print(os)
