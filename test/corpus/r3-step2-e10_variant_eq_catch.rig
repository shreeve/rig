error E
  bad

enum Shape
  dot
  line(v: List[Int])

fun mk(ok: Bool) -> Shape!
  if not ok
    return E.bad
  .dot

sub main()
  p: List[Int] = List()
  !p.push(1)
  d = Shape.line(<p)
  if (mk(false) catch d) != .dot
    print("line")
  match ?d
    .line(v) => print(v[0])
    .dot => print("dot")
