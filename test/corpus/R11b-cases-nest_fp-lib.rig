pub struct Pair[A, B]
  a: A
  b: B

pub struct List[T]
  items: Vec[T]

  fun map[U](?self, f: fun(T) -> U) -> List[U]
    out: Vec[U] = Vec()
    for x in self.items
      !out.push(f(x))
    List(items: <out)

  fun count(?self) -> Int
    self.items.len

pub fun countdown[T](x: T, n: Int) -> Int
  if n == 0
    0
  else
    1 + countdown(x, n - 1)

pub fun ping[T](x: T, n: Int) -> Int
  if n == 0
    0
  else
    pong(x, n - 1)

fun pong[T](x: T, n: Int) -> Int
  ping(x, n)

pub fun once[T](x: T) -> Pair[T, T]
  helper(Pair(a: x, b: x))

fun helper[U](p: U) -> U
  p

pub fun swap[A, B](p: Pair[A, B], n: Int) -> Int
  if n == 0
    0
  else
    swap(Pair(a: p.b, b: p.a), n - 1)
