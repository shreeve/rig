struct P
  t: Text

enum WP
  a(w: !P)
  b

struct H
  e: WP

fun mk(p: !P) -> H from p
  H(e: WP.a(!p))

sub main()
  p = P(t: Text("hello"))
  match mk(!p).e
    .a(w)
      r = ?w.t[1..]
      for _ in 0..50
        !w.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r)
    .b => pass
