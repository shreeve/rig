fun pick(a: !Int, b: !Int, c: Bool) -> !Int
  a if c else b

fun pickv(a: !List[Int], b: !List[Int], c: Bool) -> !List[Int]
  return a if c else b

sub main()
  x = 1
  y = 2
  w = pick(!x, !y, false)
  w += 10
  u: List[Int] = List()
  v: List[Int] = List()
  pickv(!u, !v, true).push(3)
  print(x, y, u.len, v.len)
