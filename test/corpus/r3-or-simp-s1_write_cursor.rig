# Must stay rejected under the type rule: the cursor reaches `Item`
# through a WRITE view, so `next`'s result keeps the loan on `c`
# (two live write results would alias).
struct Item
  n: Int

struct Cursor
  items: ![]Item
  i: Int

  fun next(!self) -> !Item
    k = self.i
    self.i += 1
    !self.items[k]

sub main
  a = [Item(n: 1), Item(n: 2)]
  c = Cursor(items: !a, i: 0)
  x = !c.next()
  y = !c.next()
  x.n = 5
  print(y.n)
