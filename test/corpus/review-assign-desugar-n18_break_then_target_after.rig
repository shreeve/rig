# A jump in an inner loop of the value does not leave the assignment.
sub run(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  w[0] = match k
    1 => 4
    _
      for _ in 0..3
        u: Vec[Int] = Vec()
        !u.push(1)
        w = !u[0..1]
        break
      3
  print(v[0])

sub main()
  run(0)
