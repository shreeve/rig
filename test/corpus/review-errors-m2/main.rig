use lib

sub main
  r = lib.Rec()
  print(r, lib.dflt(), lib.dflt(.full), lib.dflt(lib.Disk.full))
  print(lib.opt(0), r.e == .full, r.e == lib.Disk.full)
  x = lib.fail(1) catch 5
  print(x)
  y = lib.fail(0) catch |e|
    print(e, e == .full, e == lib.Disk.full, e == .timeout)
    7
  print(y)
  match r.e
    .timeout => print("t")
    lib.Disk.full => print("f")
