# Review probe h03_store_into_recv.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.at accept
# oracle: S.drop accept
# oracle: H.keep accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: mkh accept
# oracle: main reject C5
struct S
  n: Int

  fun at(!self) -> !Int
    !self.n

  drop(!self)
    print("dropS", self.n)
    self.n = 777

struct H
  ws: Vec[!Int]

  sub keep(!self, w: !Int)
    !self.ws.push(<w)

  drop(!self)
    i = 0
    while i < self.ws.len
      print("dropH sees", self.ws[i])
      i += 1

fun mk(n: Int) -> S
  S(n: n)

fun mkh() -> H
  H(ws: Vec())

sub main()
  s = mk(5)
  h = mkh()
  !h.keep((!s).at())
  print("named ok")
  !mkh().keep((!mk(1)).at())
  print("end")
