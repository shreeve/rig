enum Expr
  num(n: Int)
  add(l: ^Expr, r: ^Expr)
  neg(e: ^Expr)

fun eval(e: ?^Expr) -> Int
  match e
    .num(n) => n
    .add(l, r) => eval(?l) + eval(?r)
    .neg(x) => 0 - eval(?x)

sub main()
  e = ^Expr.add(l: ^.num(n: 2), r: ^Expr.neg(e: ^.num(n: 5)))
  print(eval(?e))
  match ?e
    .add(l, _) => print("left", eval(?l))
    _ => print("other")
