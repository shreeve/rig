enum Expr
  num(n: Int)
  add(l: Box[Expr], r: Box[Expr])
  neg(e: Box[Expr])

fun eval(e: ?Box[Expr]) -> Int
  match e
    .num(n) => n
    .add(l, r) => eval(?l) + eval(?r)
    .neg(x) => 0 - eval(?x)

sub main()
  e = Box(value: Expr.add(l: Box(value: .num(n: 2)), r: Box(value: Expr.neg(e: Box(value: .num(n: 5))))))
  print(eval(?e))
  match ?e
    .add(l, _) => print("left", eval(?l))
    _ => print("other")
