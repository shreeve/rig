obj R
  n: Int
  drop(!self)
    print("drop R", self.n)

obj Stack[T]
  items: List[T]

  sub push(!self, x: T)
    !self.items.push(<x)

  fun pop(!self) -> T?
    (!self.items).pop()

  fun size(?self) -> Int
    self.items.len

fun keep[T](x: T) -> T
  x

fun choose[T](a: T, b: T, first: Bool) -> T
  if first
    <a
  else
    <b

fun largest[T](xs: ?List[T]) -> T?
  best: T? = none
  for x in xs
    if best as b
      best = x if x > b else b
    else
      best = x
  best

sub main()
  s = Stack[^R](items: List())
  !s.push(^R(n: 1))
  !s.push(^R(n: 2))
  if (!s).pop() as top
    print("popped", top.n)
  print(s.size())
  k = keep(R(n: 3))
  print(k.n)
  c = choose(R(n: 4), R(n: 5), false)
  print(c.n)
  v: List[Int] = List()
  !v.push(3)
  !v.push(9)
  !v.push(4)
  print(largest(?v))
  w: List[?String] = List()
  !w.push("b")
  !w.push("a")
  print(largest(?w))
  f = choose(1.5, 2, true)
  print(f)
