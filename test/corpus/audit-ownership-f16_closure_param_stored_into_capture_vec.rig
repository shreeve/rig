obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main()
  keep: List[*Tok] = List()
  f = |!keep, t: *Tok| !keep.push(<t)
  f(*Tok(n: 1))
  f(*Tok(n: 2))
  print(keep.len)
