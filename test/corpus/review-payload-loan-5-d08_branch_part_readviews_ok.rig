obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

obj W
  e: E

sub f(a: ?W, b: ?W, c: Bool)
  match (a if c else b).e
    .a(r) => print(r.n)
    .b => pass

sub main()
  x = W(e: mk(1))
  y = W(e: mk(2))
  f(?x, ?y, true)
