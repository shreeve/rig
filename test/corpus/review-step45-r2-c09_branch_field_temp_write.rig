# if (!s.f[idx(?Text("a"))].o if c else !w) as t : field after index, inside a branch
obj S
  o: String?

obj H
  f: List[S]

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  h = H(f: List())
  !h.f.push(S(o: String("q")))
  w: String? = String("w")
  c = h.f.len == 1
  if (!h.f[idx(?String("a"))].o if c else !w) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(h.f[0].o)
