struct R
  n: Int

  drop(!self)
    print("drop", self.n)

fun has[T](o: ?T?) -> Bool
  if o as _
    true
  else
    false

fun has2[T](o: ?T?) -> Bool
  o != none

sub put[T](o: !T?, v: T)
  if !o as x
    x = <v
  else
    o = <v

sub main()
  r: R? = R(n: 1)
  print(has2(?r))
  b: Box[R]? = Box(value: R(n: 2))
  put(!r, R(n: 7))
  put(!b, Box(value: R(n: 8)))
  print(r, b)
