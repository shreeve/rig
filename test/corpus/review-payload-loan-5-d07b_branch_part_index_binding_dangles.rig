obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

obj W
  e: E

sub f(a: !List[W], b: !List[W], c: Bool)
  match (a if c else b)[0].e
    .a(r0)
      for _ in 0..100
        !a.push(W(e: mk(1)))
      print(r0.n)
    .b => pass

sub main()
  x: List[W] = List()
  !x.push(W(e: mk(3)))
  y: List[W] = List()
  !y.push(W(e: mk(3)))
  f(!x, !y, true)
