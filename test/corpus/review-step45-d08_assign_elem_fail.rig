# v[0] = mk()! where mk fails: no drop of old, no leak
error Bad
  oops

fun mk(ok: Bool) -> String!
  if not ok
    return Bad.oops
  String("new")

fun run(v: !List[String], ok: Bool) -> Int!
  v[0] = mk(ok)!
  1

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  print(run(!v, false) catch 0)
  print(v)
  print(run(!v, true) catch 0)
  print(v)
