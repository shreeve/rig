struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun f(t: *Tok) -> Bool
  print("f", t.n)
  true

sub main
  a = *Tok(n: 1)
  c = false
  if c and f(<a)
    print("yes")
  print("end")
