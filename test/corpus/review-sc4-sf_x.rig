enum Shape
  circle(r: Int)
  point

fun mk() -> Shape
  print("mk")
  .circle(r: 3)

struct H
  s: Shape

  fun get(?self) -> Shape
    print("get")
    self.s
sub main
  h = H(s: .circle(r: 3))
  match ?(mk())
    .circle(r) if r > 5 => print("big")
    .circle(r) if r > 1 => print("mid", r)
    _ => print("other")
  print(h.s)
