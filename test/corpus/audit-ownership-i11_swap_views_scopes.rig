struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct View
  b: ?Tok

sub main()
  x = Tok(n: 1)
  vw = View(b: ?x)
  if true
    y = Tok(n: 2)
    v2 = View(b: ?y)
    swap(!vw, !v2)
  print(vw.b.n)
