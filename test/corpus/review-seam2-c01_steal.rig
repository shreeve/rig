# Review probe c01_steal.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.steal accept
# oracle: S.into accept
# oracle: S.at accept
# oracle: S.rd accept
# oracle: S.drop accept
# oracle: mk accept
# oracle: main accept
struct S
  n: Int
  items: Vec[Int]

  fun steal(!self) -> Vec[Int]
    replace(!self.items, Vec())

  fun into(<self) -> Int
    self.n

  fun at(!self) -> !Int
    !self.n

  fun rd(?self) -> Int
    self.n

  drop(!self)
    print("drop", self.n, self.items)

fun mk(n: Int) -> S
  s = S(n: n, items: Vec())
  !s.items.push(n)
  s

sub main
  v = !mk(1).steal()
  print(v)
