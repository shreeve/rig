# Under the planned rule (Core s1) a bare owning place an `if … as` or
# `while … as` binds is lent to read while the binding lives: the place
# may not be assigned, moved, or dropped then, the payload may not move
# out of the view, and the view may not outlive the place.
#
# oracle: assign_place reject C2
# oracle: escape reject C2
# oracle: match_assign reject C4
# oracle planned: assign_place reject C4
# oracle planned: move_place reject C4
# oracle planned: drop_place reject C4
# oracle planned: move_payload reject C7
# oracle planned: while_assign reject C4
# oracle planned: escape reject C5
# oracle planned: match_assign reject C4

struct N
  v: Int

  drop(!self)
    print("drop", self.v)

enum E
  one(b: Box[N])
  none

sub assign_place()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    o = none
    print(x.v)

sub move_place()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    p = <o
    print(x.v, p == none)

sub drop_place()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    -o
    print(x.v)

sub move_payload()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    y = <x
    print(y.v)

sub while_assign()
  o: Box[N]? = Box(N(v: 1))
  while o as x
    o = none
    print(x.v)

fun escape(d: ?N) -> ?N
  o: Box[N]? = Box(N(v: 1))
  if o as x
    return ?x
  d

sub match_assign()
  e = E.one(b: Box(N(v: 3)))
  match e
    .one(n)
      e = E.none
      print(n.v)
    .none => pass

sub main()
  assign_place()
