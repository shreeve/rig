# Core s1: a bare owning place an `if … as` or `while … as` binds is
# lent to read while the binding lives: the place may not be assigned,
# moved, or dropped then, and the view may not outlive the place. The
# binding is a view (`x: ?T`): `<x` moves the view, which still carries
# the loan on the place, and nothing can be taken out of the payload
# through it (`<x.next`).
#
# oracle: assign_place reject C4
# oracle: move_place reject C4
# oracle: drop_place reject C4
# oracle: move_view_then_assign reject
# oracle: take_payload reject C7
# oracle: while_assign reject C4
# oracle: escape reject C5
# oracle: match_assign reject C4

obj N
  v: Int

  drop(!self)
    print("drop", self.v)

enum E
  one(b: ^N)
  empty

sub assign_place()
  o: ^N? = ^N(v: 1)
  if o as x
    o = none
    print(x.v)

sub move_place()
  o: ^N? = ^N(v: 1)
  if o as x
    p = <o
    print(x.v, p == none)

sub drop_place()
  o: ^N? = ^N(v: 1)
  if o as x
    <o
    print(x.v)

sub move_view_then_assign()
  o: ^N? = ^N(v: 1)
  if o as x
    y = <x
    o = none
    print(y.v)

obj L
  v: Int
  next: ^L?

sub take_payload()
  o: ^L? = ^L(v: 1, next: ^L(v: 2, next: none))
  if o as x
    y = <x.next
    print(y == none)

sub while_assign()
  o: ^N? = ^N(v: 1)
  while o as x
    o = none
    print(x.v)

fun escape(d: ?N) -> ?N
  o: ^N? = ^N(v: 1)
  if o as x
    return ?x
  d

sub match_assign()
  e = E.one(b: ^N(v: 3))
  match e
    .one(n)
      e = E.empty
      print(n.v)
    .empty => pass

sub main()
  assign_place()
