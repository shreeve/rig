# Under the planned rule (Core s1) a bare owning place an `if … as` or
# `while … as` binds is lent to read while the binding lives: the place
# may not be assigned, moved, or dropped then, and the view may not
# outlive the place. The binding is a view (`x: ?T`): `<x` moves the
# view, which still carries the loan on the place, and nothing can be
# taken out of the payload through it (`<x.next`).
#
# The plain lines hold before and after the rule is on by default: a
# rejection there is C2 (a bare owner would be copied) before, and the
# planned line's rule after.
#
# oracle: assign_place reject
# oracle: escape reject
# oracle: match_assign reject C4
# oracle: take_payload reject
# oracle planned: assign_place reject C4
# oracle planned: move_place reject C4
# oracle planned: drop_place reject C4
# oracle planned: move_view_then_assign reject
# oracle planned: take_payload reject C7
# oracle planned: while_assign reject C4
# oracle planned: escape reject C5
# oracle planned: match_assign reject C4

struct N
  v: Int

  drop(!self)
    print("drop", self.v)

enum E
  one(b: Box[N])
  none

sub assign_place()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    o = none
    print(x.v)

sub move_place()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    p = <o
    print(x.v, p == none)

sub drop_place()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    -o
    print(x.v)

sub move_view_then_assign()
  o: Box[N]? = Box(N(v: 1))
  if o as x
    y = <x
    o = none
    print(y.v)

struct L
  v: Int
  next: Box[L]?

sub take_payload()
  o: Box[L]? = Box(L(v: 1, next: Box(L(v: 2, next: none))))
  if o as x
    y = <x.next
    print(y == none)

sub while_assign()
  o: Box[N]? = Box(N(v: 1))
  while o as x
    o = none
    print(x.v)

fun escape(d: ?N) -> ?N
  o: Box[N]? = Box(N(v: 1))
  if o as x
    return ?x
  d

sub match_assign()
  e = E.one(b: Box(N(v: 3)))
  match e
    .one(n)
      e = E.none
      print(n.v)
    .none => pass

sub main()
  assign_place()
