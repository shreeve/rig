struct P
  x: Int
  y: Int

fun px(o: P?) -> Int
  if o as p
    return p.x
  0

sub main
  f = *|| 3
  g = *|| 2.5
  h = *|p: P| P(x: p.y, y: p.x)
  q = h(P(x: 1, y: 2))
  print(f(), g(), q.x, q.y)
  k: *fun([2]Int, P?) -> [2]Int = *|a, o| [a[1], px(o)]
  print(k([5, 6], none), k([7, 8], P(x: 9, y: 0)))
  s = *|| "str"
  print(s())
  m = *|| P(x: 4, y: 5)
  c = Cell(m())
  print(c.get().y)
