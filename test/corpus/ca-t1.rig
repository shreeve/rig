fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

sub each(xs: ?Vec[Int], f: ?sub(Int))
  for x in xs
    f(x)

fun twice(n: Int) -> Int
  n * 2

sub main()
  k = 3
  print(apply(|a| a + 1, 4))
  print(apply(twice, 4))
  add_k = |+k, a: Int| a + k
  print(apply(?add_k, 4))
  inc: *fun(Int) -> Int = *|a| a + 100
  print(apply(?inc, 4))
  v: Vec[Int] = Vec()
  !v.push(1)
  !v.push(2)
  !v.push(3)
  total = 0
  each(?v, |!total, n|
    total += n)
  print(total)
  g = ?add_k
  print(g(10))
