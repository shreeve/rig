obj Node
  v: Int
  next: ^Node?

sub two(a: !Node, b: !^Node?)
  b = none
  print(a.next)

sub two2(a: !Node, b: ?Node)
  a.next = none
  print(b.v)

sub main()
  b = ^Node(v: 1, next: ^Node(v: 2, next: none))
  two(!b, !b.next)
  two2(!b, ?b)
  o: ^Node? = ^Node(v: 1, next: none)
  if !o as x
    if ?o as y
      print(y.v)
