# oracle: mk accept
# oracle: eat accept
# oracle: main reject C4

obj S
  s: []Int

fun mk(v: ?List[Int]) -> S?
  if v.len < 40
    return S(s: ?v[..])
  none

fun eat(v: List[Int]) -> Int
  v.len

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  while mk(?v) as h: k += h.s[0]
    k += eat(<v)
    v = List()
    !v.push(2)
  print(k)
