# while !v[idx(?Text("a"))] as t: write binding with a header temporary, grows the Text
fun idx(s: String) -> Int
  s.len - 1

sub main()
  v: Vec[Text?] = Vec()
  !v.push(Text("q"))
  n = 0
  while !v[idx(?Text("a"))] as t
    for _ in 0..40
      !t.add("xxxxxxxx")
    n += 1
    if n == 2
      break
  if v[0] as t
    print(t.len)
