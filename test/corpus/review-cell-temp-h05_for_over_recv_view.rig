# A for header over a view a `?self` method returns of a Cell-holding
# temporary: the view would outlive the header.
#
# oracle: D.drop accept
# oracle: D.items accept
obj D
  c: Cell[Int]
  xs: List[Int]

  drop(!self)
    print("drop", self.c.get())

  fun items(!self) -> ?List[Int]
    !self.c.set(9)
    ?self.xs

fun mkd(n: Int) -> D
  v: List[Int] = List()
  !v.push(n)
  D(c: Cell(n), xs: <v)

sub main()
  for x in mkd(1).items()
    print(x)
