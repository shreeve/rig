obj Val
  n: Int
  drop(!self)
    print("drop", self.n)

obj Map
  es: List[^Val]

  fun find(?self, n: Int) -> (?Val)?
    for e in ?self.es
      if e.n == n
        return ?e
    none

  fun find_mut(!self, n: Int) -> (!Val)?
    for e in !self.es
      if e.n == n
        return !e
    none

sub main()
  m = Map(es: List())
  !m.es.push(^Val(n: 1))
  if m.find(1) as v
    print(v.n)
  if (!m).find_mut(1) as w
    w.n = 7
  print(m.es.len)
