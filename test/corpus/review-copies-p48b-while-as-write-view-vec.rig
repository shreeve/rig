# The owner List is replaced while `h` holds a live write view of it:
# the view is then used.
obj W
  w: !List[Int]

fun mk(v: !List[Int]) -> W?
  if v.len < 3
    return W(w: !v)
  none

sub main()
  v: List[Int] = List()
  while mk(!v) as h
    v = List()
    !v.push(1)
    !v.push(2)
    !h.w.push(7)
    print(h.w.len)
  print(v.len)
