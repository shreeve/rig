# argument (`owned`), a14: as a13 with a `?String` parameter: the Text
# temporary is lent by pointer from its statement slot; the call's result
# views it.
fun g(k: Int) -> Int
  print("g")
  k

fun pick(s: ?String, n: Int) -> ?String
  s

sub main()
  print(pick(n: g(1), s: String("hello world, long enough to be on the heap")))
