obj Counter
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

enum E
  a(c: Counter)
  b

fun getb(b: ?^E, n: Int) -> ?^E
  b

fun get(e: ?E, n: Int) -> ?E
  e

sub main()
  e = E.a(c: Counter(hits: Cell(1)))
  match get(e, String("xy").len)
    .a(c) => c.hit()
    .b => pass
  print(e)
  b = ^E.a(c: Counter(hits: Cell(1)))
  match getb(b, String("xyz").len)
    .a(c) => c.hit()
    _ => pass
  print(b)
