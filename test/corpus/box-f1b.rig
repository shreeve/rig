enum Shape
  circle(r: Int)
  square(s: Int)

fun area(b: ?Box[Shape]) -> Int
  match b
    .circle(r) => 3 * r * r
    .square(s) => s * s

fun name(b: !Box[Shape]) -> String
  match b
    .circle(_) => "circle"
    .square(_) => "square"

sub main()
  b = Box(value: Shape.circle(r: 2))
  match ?b
    .circle(r) => print("circle", r)
    .square(s) => print("square", s)
  print(area(?b), name(!b))
  b = Box(value: Shape.square(s: 3))
  print(b, area(?b))
