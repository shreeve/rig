obj H
  w: !List[Int]

sub f(a: !H, b: !H)
  t = !a.w[..]
  !b.w.push(2)
  !b.w.push(3)
  !b.w.push(4)
  !b.w.push(5)
  t[0] = 99
  print(t)

sub main()
  v: List[Int] = List()
  !v.push(1)
  d: List[Int] = List()
  e: List[Int] = List()
  ys = [H(w: !d), H(w: !e)]
  !ys.fill(H(w: !v))
  for h in !ys[..1]
    for k in !ys[1..]
      f(h, k)
