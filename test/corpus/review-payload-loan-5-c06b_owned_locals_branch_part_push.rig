struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

struct W
  v: Vec[Int]
  e: E

fun mkw(n: Int) -> W
  v: Vec[Int] = Vec()
  for i in 0..n
    !v.push(i + 1)
  W(v: <v, e: mk(n))

sub main()
  x = mkw(3)
  y = mkw(3)
  c = true
  match (x if c else y).e
    .a(r0)
      s = ?r0.v[..]
      match !x.e
        .a(r)
          for i in 0..100
            !r.v.push(i)
        .b => pass
      print(s[0])
    .b => pass
