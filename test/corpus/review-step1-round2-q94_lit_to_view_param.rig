struct Counter
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

struct H
  arr: [2]Counter

fun bumpa(a: ?[2]Counter) -> Int
  for k in a
    k.hit()
  a[0].hits.get()

fun bumph(h: !H) -> Int
  !h.arr[0].hit()
  h.arr[0].hits.get()

fun bumpc(c: !Counter) -> Int
  !c.hit()
  c.hits.get()

sub main()
  print(bumpa(?[Counter(hits: Cell(0)), Counter(hits: Cell(1))]))
  print(bumph(?H(arr: [Counter(hits: Cell(0)), Counter(hits: Cell(1))])))
  print(bumpc(?Counter(hits: Cell(0))))
