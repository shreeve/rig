obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

obj H
  o: *Tok?

fun mk() -> ^H
  ^H(o: *Tok(n: 3))

sub main()
  x = <mk().o
  print(x == none)
