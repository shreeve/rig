# s01 with a `continue` in the body: the body becomes a labeled block, so its defer runs before the step (control).
# body's scope ends (the checker: `while true { x = a or break; { body };
# step }`), so a body `defer` runs before it. Here the step moves `b`,
# which the body's defer reads. Expected: accepted, prints d 1 / d 2 /
# d 3 then `end 6 3`, sanitizer-clean.
#
# oracle: mk accept
# oracle: fresh accept
# oracle: take accept
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

fun fresh(n: Int) -> List[Int]
  a: List[Int] = List()
  !a.push(n)
  a

fun take(a: List[Int]) -> Int
  a[0]

sub main()
  v: List[Int] = List()
  !v.push(0)
  b = fresh(0)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: k += h.s[0] + take(<b)
    i += 1
    b = fresh(i)
    defer print("d", b[0])
    continue if i == 99
  print("end", k, i)
