obj Tree
  key: Int
  left: ^Tree?
  right: ^Tree?

  drop(!self)
    print("drop", self.key)

fun leaf(k: Int) -> ^Tree?
  ^Tree(key: k, left: none, right: none)

# rotate right: the left child becomes the root
sub rot2(slot: !^Tree?)
  top = replace(slot, none)
  if <top as t
    if <t.left as l
      t.left = <l.right
      l.right = <t
      slot = <l
    else
      slot = <t

sub main()
  root: ^Tree? = ^Tree(key: 2, left: leaf(1), right: leaf(3))
  rot2(!root)
  print(root)
