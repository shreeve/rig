struct R
  n: Int
  drop(!self)
    print("drop", self.n)

struct W[T]
  x: T?

  fun grab(!self) -> T?
    <self.x

sub main
  w = W[R](x: R(n: 1))
  a = !w.grab()
  print(a, w)
  b = W[Box[R]](x: Box(value: R(n: 2)))
  c = !b.grab()
  print(c, b)
  d = W[*R](x: *R(n: 3))
  e = !d.grab()
  print(e, d)
  f = W[String](x: "s")
  g = !f.grab()
  print(g, f)
