error Bad
  oops

fun slot(v: !List[Int], i: Int) -> !Int from v
  !v[i]

fun both(v: !List[Int], i: Int) -> ((!Int)?)! from v
  return Bad.oops if i < 0
  return none if i >= v.len
  !v[i]

fun opt(v: !List[Int], i: Int) -> (!Int)? from v
  return none if i >= v.len
  !v[i]

fun run(v: !List[Int], i: Int) -> (Int?)!
  both(!v, i)!? = 7
  0

fun run2(v: !List[Int], i: Int) -> Int?
  (opt(!v, i))? += 1
  0

sub main()
  v: List[Int] = List()
  !v.push(1)
  (slot(!v, 0)) = 3
  print(v)
  r = run(!v, 0) catch none
  r2 = run(!v, 5) catch none
  r3 = run(!v, -1) catch none
  print(r, r2, r3, v)
  a = run2(!v, 0)
  b = run2(!v, 3)
  print(a, b, v)
