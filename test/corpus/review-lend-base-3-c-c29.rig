obj P
  x: Int
  o: Int?
  items: List[Int]
  s: String
  arr: [3]Int

fun mk() -> P
  P(x: 1, o: 2, items: List[Int](), s: String("hi"), arr: [1, 2, 3])

fun own(v: List[Int]) -> Int
  v.len

fun gid[T](x: T) -> T
  x

fun cnt(v: ?List[Int]) -> Int
  v.len

sub main()
  p = mk()
  c = true
  _ = c
  y = (!(<(!p))).x
  print(y)
  print(p.x, p.items.len)
