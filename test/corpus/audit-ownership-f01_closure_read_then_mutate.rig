struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  f = |?v| print(v[0])
  f()
  !v.clear()
  f()
