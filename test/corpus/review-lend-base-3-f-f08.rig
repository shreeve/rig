fun dbl(n: Int) -> Int
  n * 2

struct T
  f: fun(Int) -> Int
  ops: [2]fun(Int) -> Int
  n: Int

  fun get(?self) -> Int
    self.n

struct W
  t: T
  ts: [2]T

sub main()
  t = T(f: dbl, ops: [dbl, dbl], n: 1)
  w = W(t: T(f: dbl, ops: [dbl, dbl], n: 2), ts: [T(f: dbl, ops: [dbl, dbl], n: 3), T(f: dbl, ops: [dbl, dbl], n: 4)])
  y = (!w.t).ops[1](5)
  print(y)
  print(t.n, w.t.n)
