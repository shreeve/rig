struct Wrap
  n: Int

  drop(!self)
    print("drop", self.n)

sub grow(w: !Wrap, by: Int)
  inc = |!w|
    w.n += 5
  inc()
  inc()

fun total_of[T](xs: ?Vec[T], pick: Int) -> Int
  count = 0
  f = |!count, ?xs|
    count += xs.len
  f()
  count

sub main()
  w = Wrap(n: 1)
  grow(!w, 5)
  print(w.n)
  v: Vec[Int] = Vec()
  push = |!v, x: Int|
    v.push(x)
  push(1)
  push(2)
  print(v.len)
  swap = |!w|
    w = Wrap(n: 99)
  swap()
  print(w.n)
  s: Vec[String] = Vec()
  !s.push("a")
  print(total_of(?s, 10))
  outer = |?w|
    inner = |?w| w.n
    inner() + 1
  print(outer())
