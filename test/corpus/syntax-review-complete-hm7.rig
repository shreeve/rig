struct Map[K, V]
  keys: Vec[K?]
  vals: Vec[V?]
  hash: fun(?K) -> U64
  len: Int
  nothing: V?

  fun new(h: fun(?K) -> U64) -> Self
    m: Self = Map(keys: Vec(), vals: Vec(), hash: h, len: 0, nothing: none)
    for _ in 0..8
      !m.keys.push(none)
      !m.vals.push(none)
    m

  fun find(?self, k: ?K) -> Int?
    cap = self.keys.len
    i = Int(self.hash(k) % U64(cap))
    for _ in 0..cap
      if self.keys[i] as kk
        return i if kk == k
      else
        return none
      i = (i + 1) % cap
    none

  fun get(?self, k: ?K) -> ?V?
    if self.find(k) as i
      return ?self.vals[i]
    ?self.nothing

  sub put(!self, k: K, v: V)
    cap = self.keys.len
    f = self.hash
    i = Int(f(?k) % U64(cap))
    while self.keys[i] != none and self.keys[i] != k
      i = (i + 1) % cap
    self.len += 1 if self.keys[i] == none
    self.keys[i] = k
    self.vals[i] = <v

fun hash_str(s: ?String) -> U64
  h: U64 = 5381
  for b in s
    h = (h * 33 + U64(b)) % 1000000007
  h

sub main()
  m = Map[String, Int].new(hash_str)
  !m.put("one", 1)
  !m.put("two", 2)
  !m.put("one", 11)
  print(m.get(?"one"), m.get(?"two"), m.get(?"three"), m.len)
  if m.get(?"one") as v
    print("got", v)
  n = Map[Int, *Node].new(hash_int)
  !n.put(1, *Node(id: 1))
  !n.put(1, *Node(id: 2))
  if n.get(?1) as nd
    print("node", nd.id)

struct Node
  id: Int
  drop(!self)
    print("drop", self.id)

fun hash_int(k: ?Int) -> U64
  U64(k)
