struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

struct H
  o: (!E)?

fun f(h: !H) -> Int?
  match (<h.o)?
    .a(r0)
      s = ?r0.v[..]
      if !h.o as w
        match !w
          .a(r)
            for i in 0..100
              !r.v.push(i)
          .b => pass
      print(s[0])
    .b => pass
  1

sub main()
  e = mk(1)
  h = H(o: !e)
  _ = f(!h)
  print(e)
