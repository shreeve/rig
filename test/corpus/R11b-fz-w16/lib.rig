obj Wrap[T]
  v: T

  fun get(?self) -> T
    self.v

pub obj Holder
  b: Wrap[Int]

obj Slot[T]
  v: T

obj Q
  b: Slot[*Int]

pub obj P
  q: Q

  fun make() -> P
    P(q: Q(b: Slot(v: *41)))

obj Secret
  value: Int

pub obj Cover[T]
  inner: T

pub fun make(n: Int) -> Wrap[Int]
  Wrap(v: n)

pub fun holder() -> Holder
  Holder(b: Wrap(v: 4)[Int, 3])

pub fun make_secret() -> Secret
  Secret(value: 42)

pub sub take_secret(s: Secret)
  print(s.value)

pub fun cover_secret(x: Int) -> Cover[Secret]
  Cover(inner: Secret(value: x))

pub fun uncover(w: Cover[Secret]) -> Int
  w.inner.value
