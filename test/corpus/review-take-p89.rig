struct R
  n: Int
  drop(!self)
    print("drop", self.n)

sub main()
  v: Vec[*R?] = Vec()
  !v.push(*R(n: 1))
  !v.push(none)
  x = <v[0]
  print(x, v)
  b: Vec[Box[R]?] = Vec()
  !b.push(Box(value: R(n: 2)))
  y = <b[0]
  z = replace(!b[0], Box(value: R(n: 3)))
  print(y, z, b)
  swap(!v[0], !v[1])
  print("end")
