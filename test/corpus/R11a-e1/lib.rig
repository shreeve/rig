enum Color
  red
  green

pub struct Wrap[T]
  v: T
  n: Int = 5
  c: Color = .green

  fun add(?self, k: Int = 5) -> Int
    self.n + k

  fun more[U](?self, u: U, k: Int = 300) -> Int
    k

  fun col(?self, c: Color = .red) -> Bool
    c == .red

pub fun f[T](x: T, k: Int = 7) -> Int
  k

pub fun g[T](x: T, k: T? = none) -> Bool
  k == none
