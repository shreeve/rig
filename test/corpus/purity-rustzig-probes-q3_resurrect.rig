struct H
  name: String
  cb: Cell[(*sub())?]

  drop(!self)
    print("dropping", self.name)
    if (!self.cb).replace(none) as f
      f()

sub main()
  h = *H(name: "h", cb: Cell(none))
  !h.cb.set(*|~h|
    if h.upgrade() as s
      print("upgraded during drop", s.name)
    else
      print("gone")
  )
  <h
  print("end")
