struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

sub f(v: !Vec[!E], c: Bool)
  match (v[0] if c else v[1])
    .a(r) => r.n = 4
    .b => pass

sub main()
  e = mk(1)
  d = mk(2)
  v: Vec[!E] = Vec()
  !v.push(!e)
  !v.push(!d)
  f(!v, true)
  print(e)
