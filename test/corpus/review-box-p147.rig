struct R
  n: Int

  drop(!self)
    print("drop", self.n)

sub main
  o: R? = R(n: 1)
  f = |?o|
    if o as x
      print("f", x.n)
  f()
  g = |!o|
    if !o as x
      x.n += 1
    if ?o as y
      print("g", y.n)
  g()
  g()
  b = Box(value: R(n: 5))
  h = |?b|
    print(rd(b), rd(?b))
  h()
  k = |!b|
    wr(!b)
    wr(b)
  k()
  print(b.n)

fun rd(r: ?R) -> Int
  r.n

sub wr(r: !R)
  r.n += 1
