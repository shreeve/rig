obj Q
  n: Int

  sub bump(!self)
    self.n += 1

obj P
  x: Int
  o: [2]Int?
  a: [2]Int
  v: List[Int]
  qs: [2]Q
  t: String

fun mk() -> P
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  P(x: 1, o: [3, none], a: [1, 2], v: <v, qs: [Q(n: 1), Q(n: 2)], t: String("hey"))

sub main()
  y = (?mk().a[..])[1]
  print(y)
