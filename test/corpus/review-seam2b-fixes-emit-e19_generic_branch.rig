use std.sort

error Bad
  no

enum Sh
  circle(r: Int)
  point

struct K2
  n: Int

  sub put2(!self, a: Int, b: Int)
    self.n = a * 10 + b

  fun put2v(!self, a: Int, b: Int) -> Int
    self.n = a * 10 + b
    self.n

struct S
  n: Int
  t: Text
  items: Vec[Int]
  arr: [3]Int
  kk: K2
  oi: Int?
  e: Sh

  fun bump(!self) -> Int
    self.n += 1
    self.n

  sub put2(!self, a: Int, b: Int)
    self.n = a * 10 + b

  fun at(!self) -> !Int
    !self.n

  fun me(!self) -> !S
    self

  drop(!self)
    print("dropS", self.n, self.t, self.items, self.arr, self.kk.n, self.oi, self.e)

struct Pair
  a: S
  b: S

fun mk(n: Int) -> S
  print("make", n)
  v: Vec[Int] = Vec()
  !v.push(3)
  !v.push(1)
  S(n: n, t: Text("text long enough for the heap ", n), items: <v, arr: [3, 2, 1], kk: K2(n: 0), oi: n, e: .circle(r: n))

fun mkopt(n: Int) -> S?
  return none if n == 0
  mk(n)

fun mkf(n: Int) -> S!
  return Bad.no if n == 0
  mk(n)

fun mkpair(n: Int) -> Pair
  Pair(a: mk(n), b: mk(n + 1))

sub setg[T](x: !T, v: T)
  x = v

sub grow(s: !S)
  s.n += 100

sub inc(x: !Int)
  x += 1

fun f(n: Int) -> Int
  n

fun incr(x: !Int) -> Int
  x += 1
  x

fun sortv(xs: ![]Int) -> Int
  sort.sort(!xs)
  xs[0]

struct K3
  n: Int

fun f2(n: Int) -> Int
  n + 1

struct GW[T]
  v: T
  k: Int

sub gsw[T](mkx: fun(Int) -> T, sel: fun(!T) -> !Int, c: Bool)
  k = 3
  swap(sel(!(mkx(1) if c else mkx(2))), !k)
  print(k)
  print(replace(!(GW(v: mkx(4), k: 1) if c else GW(v: mkx(5), k: 2)).k, 9))
  swap(!(GW(v: mkx(6), k: 1) if c else GW(v: mkx(7), k: 2)).k, !k)
  print(k)
  swap(sel(!(GW(v: mkx(8), k: 1) if c else GW(v: mkx(9), k: 2)).v), !k)
  print(k)

fun seln(s: !K2) -> !Int
  !s.n

sub main
  gsw(mkk, seln, f(1) == 1)

fun mkk(n: Int) -> K2
  K2(n: n)
