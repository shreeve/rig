struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

sub main()
  t = Tok(n: 5)
  n = apply(|?t, a| a + t.n, 1)
  <t
  print(n)
