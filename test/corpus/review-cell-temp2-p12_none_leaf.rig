# A `none` literal leaf of an optional that branches, unwrapped with `?`
# and changed through a `?self` method: accepted, then emit stops at its
# backstop ("a Cell held in storage Zig keeps for the expression").
#
# oracle: D.drop accept
# oracle: D.hit accept
# oracle: D.bumped accept
# oracle: D.me accept
# oracle: mk accept
# oracle: mkf accept
# oracle: mko accept
# oracle: mkww accept
# oracle: look accept
# oracle: main accept
error E
  bad

struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

  sub hit(?self)
    self.c.set(self.c.get() + 1)

  fun bumped(?self) -> Int
    self.c.set(self.c.get() + 1)
    self.c.get()

  fun me(?self) -> ?D
    self.c.set(self.c.get() + 1)
    self

struct WW
  t: D

fun mk(n: Int) -> D
  D(c: Cell(n))

fun mkf(n: Int) -> D!
  return E.bad if n < 0
  mk(n)

fun mko(n: Int) -> D?
  return none if n < 0
  mk(n)

fun mkww(n: Int) -> WW
  WW(t: mk(n))

fun look(x: ?D) -> Int
  x.c.set(x.c.get() + 10)
  x.c.get()

fun opt(k: Bool) -> Int?
  o: D? = mk(2)
  (o if k else none)?.hit()
  print("v", (o if k else none)?.bumped())
  (mko(5) if k else none)?.hit()
  (none if k else o)?.hit()
  0

sub main()
  print("q", opt(true) ?? -1)
  print("q", opt(false) ?? -1)

# expect:
# v 4
# drop 6
# drop 4
# q -1
# drop 2
# q -1
