obj Node[T]
  value: T
  next: ^Node[T]?

fun push[T](top: ^Node[T]?, v: T) -> ^Node[T]?
  ^Node(value: v, next: <top)

fun count[T](top: ?^Node[T]?) -> Int
  n = 0
  cur = top
  while cur as node
    n += 1
    cur = ?node.next
  n

sub main()
  s: ^Node[?String]? = none
  s = push(<s, "a")
  s = push(<s, "b")
  print(count(?s), s)
