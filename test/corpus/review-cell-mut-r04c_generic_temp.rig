# `?self` calls and read lends on temporaries inside generic code, where
# whether the temporary holds a Cell depends on the instance.
struct T
  c: Cell[Int]

  sub hit(!self)
    !self.c.set(self.c.get() + 1)

struct H[X]
  x: X

  sub run(?self, f: ?sub(?X))
    f(?self.x)

struct P[X]
  h: H[X]

sub bump(t: !T)
  !t.hit()

fun mkh[X](x: X) -> H[X]
  H(x: <x)

fun mkp[X](x: X) -> P[X]
  P(h: H(x: <x))

sub look[X](h: ?H[X], f: ?sub(?X))
  h.run(f)

sub a[X](x: X, f: ?sub(?X))
  mkh(<x).run(f)

sub b[X](x: X, f: ?sub(?X))
  mkp(<x).h.run(f)

sub c[X](x: X, f: ?sub(?X))
  look(?mkh(<x), f)

sub main()
  c(T(c: Cell(0)), bump)
  print("ok")

# expect:
# ok

# oracle: T.hit accept
# oracle: H.run accept
# oracle: bump accept
# oracle: mkh accept
# oracle: mkp accept
# oracle: look accept
# oracle: a accept
# oracle: b accept
# oracle: c accept
