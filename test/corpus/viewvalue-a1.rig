fun slot(v: !List[Int], i: Int) -> !Int from v
  !v[i]

fun fslot(v: !List[Float], i: Int) -> !Float from v
  !v[i]

fun bslot(v: !List[U8], i: Int) -> !U8 from v
  !v[i]

sub main()
  v: List[Int] = List()
  !v.push(-7)
  !v.push(-7)
  !v.push(-7)
  !v.push(-7)
  slot(!v, 0) /= 2
  slot(!v, 1) %= 3
  x = -7
  x /= 2
  y = -7
  y %= 3
  print(v[0], x, v[1], y)
  f: List[Float] = List()
  !f.push(1.5)
  fslot(!f, 0) *= 3
  fslot(!f, 0) /= 2
  fslot(!f, 0) -= 0.25
  print(f[0])
  b: List[U8] = List()
  !b.push(200)
  bslot(!b, 0) +%= 100
  bslot(!b, 0) <<%= 3
  print(b[0])
  sh = v.len * 20
  slot(!v, 2) <<= sh
  print(v[2])
