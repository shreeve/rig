# match < on an element through a temp index. Expect reject or correct (no double free).
enum E
  a(t: String)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[E] = List()
  !v.push(E.a(t: String("q")))
  match <v[idx(?String("a"))]
    .a(t) => print(t)
    .b => pass
  print(v.len)
