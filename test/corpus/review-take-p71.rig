obj Tree
  key: Int
  left: ^Tree?
  right: ^Tree?

  drop(!self)
    print("drop", self.key)

fun leaf(k: Int) -> ^Tree?
  ^Tree(key: k, left: none, right: none)

fun cut(b: !^Tree) -> ^Tree?
  <b.left

fun cut2(slot: !^Tree?) -> ^Tree?
  if !slot as t
    return <t.right
  none

sub main()
  b = ^Tree(key: 2, left: leaf(1), right: leaf(3))
  l = cut(!b)
  print(l)
  swap(!b.left, !b.right)
  print(b)
  o: ^Tree? = <b
  r = cut2(!o)
  print(r, o)
