struct S
  c: Cell[Vec[Int]]

  sub grow(!self)
    for i in 0..50
      !self.c.push(i)

struct O
  s: S

fun peek(o: ?O) -> ?S
  ?o.s

sub main()
  a = *O(s: S(c: Cell(Vec())))
  b = *O(s: S(c: Cell(Vec())))
  k = a.s.c.len == 0
  !a.s.c.push(1)
  (a.s if k else peek(b)).grow()
  (peek(a) if k else b.s).c.push(3)
  print(a.s.c.len, b.s.c.len)
