use std.text

obj P
  owned: String
  n: Int
  pos: Int
  src: ?String
  names: List[String]

  sub note(!self, s: ?String)
    self.owned = String(s)
    self.n += s.len
    !self.owned.add(s)
    self.pos = text.find(s, "l") ?? -1
    self.src = "static"
    !self.names.push(String(s))

sub main()
  p = P(owned: String(""), n: 0, pos: 0, src: "", names: List())
  t = String("hello")
  !p.note(?t)
  <t
  u = String("zzzzzzzz")
  print(p.owned, p.n, p.pos, p.src, p.names[0], u)
