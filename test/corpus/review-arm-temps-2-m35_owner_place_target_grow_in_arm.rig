# The target is the owner's own place, evaluated after the value: growing
# the owner in an arm is fine.
fun grow(v: !Vec[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  k = 0
  v[0] = match k
    0
      grow(!v)
    _ => 3
  v[0] += if k == 0
    grow(!v)
  else
    3
  print(v[0], v.len)

# expect:
# 602 401
