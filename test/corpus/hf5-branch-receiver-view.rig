# A view a `?self` method returns of a receiver that branches (`(a if c
# else b).inner()`), held while `a.t` is replaced: rejected.

obj S
  t: String

  fun inner(?self) -> ?String
    ?self.t

sub main()
  a = S(t: String("aa"))
  b = S(t: String("bb"))
  c = a.t.len == 2
  r = (a if c else b).inner()
  a.t = String("zz")
  print(r, b.t)
