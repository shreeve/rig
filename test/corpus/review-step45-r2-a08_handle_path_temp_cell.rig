# guarded match h.v[idx(?Text("a"))] through a shared handle, Cell payload
obj C
  c: Cell[Int]

enum E
  a(x: C)
  b(n: Int)

obj S
  v: List[E]

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[E] = List()
  !v.push(E.a(x: C(c: Cell(1))))
  h = *S(v: <v)
  match h.v[idx(?String("a"))]
    .a(x) if x.c.get() == 1 => (!x.c).set(5)
    .a(x) => (!x.c).set(6)
    .b(n) => print(n)
  match h.v[0]
    .a(x) => print(x.c.get())
    .b(n) => print(n)
