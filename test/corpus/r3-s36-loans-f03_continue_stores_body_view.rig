# `continue` leaves the body scope: a view of a body local held by
# an outer var is used on the next iteration.
struct R
  n: Int
  drop(!self)
    print("drop", self.n)

struct V
  r: ?R

sub main
  keep = R(n: 0)
  v = V(r: ?keep)
  i = 0
  while i < 3 : i += 1
    print(v.r.n)
    inner = R(n: i + 10)
    v = V(r: ?inner)
    if i < 5
      continue
