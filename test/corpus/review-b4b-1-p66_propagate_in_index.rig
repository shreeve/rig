# a temp-making index that propagates failure / none out of the function, inside a pointing header. Expect leak-free, correct.
fun idxo(s: ?String) -> Int?
  return none if s.len > 3
  s.len - 1

error Bad
  long

fun idxf(s: ?String) -> Int!
  return Bad.long if s.len > 3
  s.len - 1

fun go(v: !List[String?], w: String) -> Int?
  if !v[idxo(?String(w))?] as t
    !t.add("o")
  1

fun gof(v: !List[String?], w: String) -> Int!
  if !v[idxf(?String(w))!] as t
    !t.add("f")
  1

sub main()
  v: List[String?] = List()
  !v.push(String("a"))
  print(go(!v, String("a")), go(!v, String("abcd")))
  print(gof(!v, String("a")) catch 0, gof(!v, String("abcd")) catch 0)
  print(v)
