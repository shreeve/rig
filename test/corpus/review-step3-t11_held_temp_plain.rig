struct Res
  n: Int
  t: String

struct P
  a: Int
  b: Int

enum E
  a(p: P)
  b

struct H
  e: E
  t: String

fun mkh(r: ?Res) -> H
  H(e: E.a(p: P(a: r.n, b: 2)), t: String("q"))

fun mkres(n: Int) -> Res
  Res(n: n, t: String("abc"))

sub main()
  match mkh(?mkres(1)).e
    .a(p) => print("a", p.a)
    .b => pass
