error E
  bad

struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

  sub hit(!self)
    !self.c.set(self.c.get() + 1)

  fun bumped(!self) -> Int
    !self.c.set(self.c.get() + 1)
    self.c.get()

  fun me(!self) -> ?D
    !self.c.set(self.c.get() + 1)
    self

struct WW
  t: D

fun mk(n: Int) -> D
  D(c: Cell(n))

fun mkf(n: Int) -> D!
  return E.bad if n < 0
  mk(n)

fun mko(n: Int) -> D?
  return none if n < 0
  mk(n)

fun mkww(n: Int) -> WW
  WW(t: mk(n))

fun look(x: !D) -> Int
  !x.c.set(x.c.get() + 10)
  x.c.get()

fun pick(k: Int, a: ?D) -> Int
  match k
    0 => mk(5).me().c.get() + a.c.get()
    1
      t = mk(7).me().c.get()
      t + mk(8).me().c.get()
    _ => return mk(k).me().c.get()

sub main()
  a = mk(1)
  print(pick(0, ?a))
  print(pick(1, ?a))
  print(pick(4, ?a))

# expect:
# drop 6
# 7
# drop 8
# drop 9
# 17
# drop 5
# 5
# drop 1
