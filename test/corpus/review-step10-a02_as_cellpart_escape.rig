# as_copy: `if ?mkh().q as x` over a Cell-holding part of a temporary
# binds a mutable copy (`__rig_opt_N_v`), poisoned when the body ends.
# Can a view of `x` escape the body?
struct Q
  c: Cell[Int]
  n: Int

struct H
  q: Q?

fun mkh() -> H
  H(q: Q(c: Cell(1), n: 42))

sub main()
  if ?mkh().q as x
    x.c.set(5)
    print(x.n, x.c.get())
