# `for x in <v` consumes the List: each element is handed to `x`, which
# owns it for one iteration (and may move it on). Elements a `break` or
# `return` leaves behind are dropped with the buffer.

obj B
  n: Int

  drop(!self)
    print("drop", self.n)

sub eat(b: *B)
  print("eat", b.n)

fun first(v: List[*B]) -> Int
  for x in <v
    return x.n
  -1

sub main()
  v: List[*B] = List()
  for i in 0..4
    !v.push(*B(n: i))
  for x, i in <v
    if i == 1
      eat(<x)
      continue
    if i == 2
      break
    print("see", x.n)
  print("after")

  w: List[*B] = List()
  !w.push([0]*B(n: 7))
  !w.push(*B(n: 8))
  print(first(<w))

  nums: List[Int] = List()
  !nums.push(3)
  !nums.push(4)
  total = 0
  for x in <nums
    total += x
  else
    print("all")
  print(total)

  src: List[*B] = List()
  !src.push(*B(n: 9))
  keep: List[*B] = List()
  for x in <src
    !keep.push(<x)
  print(keep.len)

# expect:
# see 0
# drop 0
# eat 1
# drop 1
# drop 2
# drop 3
# after
# drop 7
# drop 8
# 7
# all
# 7
# 1
# drop 9
