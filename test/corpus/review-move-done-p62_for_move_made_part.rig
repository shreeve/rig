enum E
  full(v: List[Int])
  empty

obj S
  o: List[Int]?
  v: List[Int]
  arr: [2]Int
  e: E

fun mk() -> S
  v: List[Int] = List()
  !v.push(7)
  w: List[Int] = List()
  !w.push(8)
  S(o: <v, v: <w, arr: [1, 2], e: E.empty)

sub h2()
  for x in <mk().arr
    print(x)

sub h3()
  for x in <mk().v
    print(x)

sub h5()
  if mk().o as x
    print(x)
  for x in mk().v
    print(x)
  match mk().e
    .full(v) => print(v.len)
    .empty => print("e")

sub main()
  h2()
  h3()
  h5()

# oracle: mk accept
# oracle: h2 reject C3
# oracle: h3 reject C3
# oracle: h5 accept
# oracle: main accept
