# for x in (!m[idx(?Text("a"))] if c else !n): branching for source with a temp leaf
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  m: List[List[String]] = List()
  r: List[String] = List()
  !r.push(String("p"))
  !m.push(<r)
  n: List[String] = List()
  c = m.len == 1
  for x in (!m[idx(?String("a"))] if c else !n)
    for _ in 0..40
      !x.add("xxxxxxxx")
  print(m[0][0].len)
