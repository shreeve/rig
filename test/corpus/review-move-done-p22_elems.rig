obj S
  v: List[Int]

sub e1()
  vv: List[List[Int]] = List()
  w = <vv[0]
  print(w.len)

sub e2()
  vs: List[S] = List()
  w = <vs[0]
  print(w.v.len)

sub e3()
  vs: List[S] = List()
  w = <vs[0].v
  print(w.len)

sub e4()
  a = [S(v: List()), S(v: List())]
  w = <a[0]
  print(w.v.len)

sub e5()
  a = [S(v: List()), S(v: List())]
  sl = !a[..]
  w = <sl[0]
  print(w.v.len)

sub main()
  e1()

# oracle: e1 reject C3
# oracle: e2 reject C3
# oracle: e3 reject C3
# oracle: e4 reject C3
# oracle: e5 reject C3
# oracle: main accept
