# `continue :outer` from an inner `while` must run the outer step,
# which reads the outer condition's binding.
#
# oracle: mk accept
# oracle: main accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

sub main()
  v: Vec[Int] = Vec()
  !v.push(5)
  k = 0
  i = 0
  :outer while mk(?v, i) as h: k += h.s[0]
    i += 1
    j = 0
    while j < 3: j += 1
      continue :outer if j == 2
    k += 100
  print(k, i)

# expect: 25 5
