struct R
  n: Int

  drop(!self)
    print("drop", self.n)

fun get(k: Int) -> Int?
  k if k > 0 else none

fun eat(r: R) -> Int
  r.n

sub use1(k: Int)
  y = R(n: 100 + k)
  x = get(k) ?? eat(<y)
  print("got", x)

fun use2(k: Int) -> Int
  y = R(n: 200 + k)
  z = R(n: 300 + k)
  x = get(k) ?? return eat(<y)
  w = get(k - 1) ?? eat(<z)
  x + w

sub main()
  use1(1)
  use1(0)
  print(use2(0))
  print(use2(1))
  print(use2(2))
