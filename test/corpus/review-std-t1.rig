use std.math
use std.time
use std.random
use std.sort
use std.os

fun main() -> Int
  r = random.Random.seeded(3)
  print((!r).int(0, 10) < 10)
  xs = [3, 1, 2]
  sort.sort(!xs)
  t = time.now()
  time.sleep(time.MS)
  print(xs, math.sqrt(16.0), time.elapsed(t) >= time.MS, os.args().len)
  math.gcd(12, 8)

test "math in test"
  print(math.pow(2, 10))
