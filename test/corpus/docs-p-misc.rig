obj V
  items: List[Int]
  sub put[k: Int](!self, x: Int)
    !self.items.push(x * k)

fun top(v: !List[Int]) -> Int?
  a = ((!v).pop())?
  b = (!v).pop()?
  a + b

sub main()
  v: List[Int] = List(capacity: 16)
  w = V(items: List())
  (!w).put[2](3)
  !w.put[3](1)
  !v.push(1)
  !v.push(2)
  print(top(!v), w.items.len, w.items[0], w.items[1])
  x: Int? = 1
  if x as _
    print("has")
