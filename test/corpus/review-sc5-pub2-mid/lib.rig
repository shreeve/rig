obj Hidden
  pub shown: Int
  secret: Int

  fun peek(?self) -> Int
    self.secret

obj Wrap[T]
  v: T
  pub w: T

  fun get(?self) -> T
    self.v

pub fun hidden() -> Hidden
  Hidden(shown: 1, secret: 2)

pub fun wrap() -> Wrap[Int]
  Wrap(v: 5, w: 6)

pub fun hiddens() -> List[Hidden]
  v = List[Hidden]()
  !v.push(hidden())
  v
