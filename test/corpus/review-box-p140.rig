obj Node
  key: Int
  left: ^Node?
  right: ^Node?

sub insert(slot: !^Node?, key: Int)
  if !slot as n
    if key < n.key
      insert(!n.left, key)
    else
      insert(!n.right, key)
  else
    slot = ^Node(key: key, left: none, right: none)

fun find(root: ?^Node?, k: Int) -> (?^Node)?
  cur = root
  while cur as n
    if n.key == k
      return n
    cur = ?n.left if k < n.key else ?n.right
  none

fun min(root: ?^Node?) -> Int
  cur = root
  best = -1
  while cur as n
    best = n.key
    cur = ?n.left
  best

sub main()
  root: ^Node? = none
  for k in [5, 2, 8, 1, 9, 3]
    insert(!root, k)
  print(min(?root))
  if find(?root, 8) as f
    print("found", f.key)
  if find(?root, 7) as _
    print("bad")
