obj Tree
  key: Int
  left: ^Tree?
  right: ^Tree?

sub mirror(slot: !^Tree?)
  if !slot as t
    swap(!t.left, !t.right)
    mirror(!t.left)
    mirror(!t.right)

sub show(slot: ?^Tree?)
  if slot as t
    show(?t.left)
    print(t.key)
    show(?t.right)

fun leaf(k: Int) -> ^Tree?
  ^Tree(key: k, left: none, right: none)

sub main()
  root: ^Tree? = ^Tree(key: 2, left: leaf(1), right: leaf(3))
  mirror(!root)
  show(?root)
  a = 1
  b = 2
  swap(!a, !b)
  old = replace(!a, 10)
  print(a, b, old)
  names: List[?String] = List()
  !names.push("x")
  first = replace(!names[0], "y")
  print(first, names)
