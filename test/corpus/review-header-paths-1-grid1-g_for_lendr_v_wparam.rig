obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

obj Q
  e: E
  o: E?
  v: List[Int]

obj W
  e: E
  o: E?
  v: List[Int]
  q: Q?

  fun ge(?self) -> ?E
    ?self.e

  fun gv(?self) -> ?List[Int]
    ?self.v

  fun go(?self) -> ?(E?)
    ?self.o

  fun gew(!self) -> !E
    !self.e

  fun gvw(!self) -> !List[Int]
    !self.v

obj H
  w: !W

fun mkv(n: Int) -> List[Int]
  v: List[Int] = List()
  for i in 0..n
    !v.push(i + 1)
  v

fun mkw(n: Int) -> W
  W(e: mk(n), o: mk(n + 10), v: mkv(n), q: Q(e: mk(n + 20), o: mk(n + 30), v: mkv(n)))

fun id[T](x: T) -> T
  x

fun f(a: !W, b: !W, c: Bool, d: E, dv: List[Int]) -> Int?
  n = 0
  for x in ?(a if c else b).v
    for _ in 0..100
      !a.v.push(1)
    n += x
  print(n)
  1

sub main()
  x = mkw(3)
  y = mkw(3)
  _ = f(!x, !y, true, mk(7), mkv(2))
