obj R
  n: Int

  drop(!self)
    print("drop", self.n)

sub eat(b: ^R)
  print("eat", b.n)

sub main()
  b = ^R(n: 1)
  <b
  b = ^R(n: 2)
  flag = b.n > 1
  if flag
    eat(<b)
  c = ^R(n: 3)
  i = 0
  while i < 3
    if i == 1
      eat(<c)
      c = ^R(n: 30)
    i += 1
  o: ^R? = ^R(n: 4)
  if flag
    x = <o
  print("end")
