# H3: generic loop over ?List[T], body: T = S (struct of Text), return element
struct S
  t: Text

struct Holder[T]
  x: T?

fun first[T](v: ?List[T]) -> T?
  for x in v
    return x
  none

sub main()
  v: List[Text] = List()
  !v.push(Text("a"))
  !v.push(Text("b"))
  s: List[S] = List()
  !s.push(S(t: Text("q")))
  print(first(?s))
