# H3: generic loop over ?List[T], body: T = S (struct of Text), return element
obj S
  t: String

obj Holder[T]
  x: T?

fun first[T](v: ?List[T]) -> T?
  for x in v
    return x
  none

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  s: List[S] = List()
  !s.push(S(t: String("q")))
  print(first(?s))
