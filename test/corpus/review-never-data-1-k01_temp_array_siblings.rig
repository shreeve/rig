obj H
  a: [1]String

fun look(s: []String) -> Int
  s[0].len + s.len

fun lookv(s: ?[2]String) -> Int
  s[1].len

fun str(s: ?String) -> Int
  s.len

fun mka() -> [1]String
  [String("xyz")]

sub main()
  c = mka()[0].len > 0
  print(look(?([String("a")] if c else [String("bb")])))
  print(lookv(?[String("a"), String("bc")]))
  print(str(String("abcd")))
  print(look(?H(a: [String("q")]).a))
  for t in [String("m"), String("n")]
    print(t)
  print(look([String(mka()[0])]))
