struct Node
  key: Int
  left: Box[Node]?
  right: Box[Node]?

  drop(!self)
    print("drop", self.key)

sub insert(slot: !Box[Node]?, key: Int)
  if !slot as n
    if key < n.key
      insert(!n.left, key)
    else
      insert(!n.right, key)
  else
    slot = Box(Node(key: key, left: none, right: none))

sub walk(slot: ?Box[Node]?)
  if slot as n
    walk(?n.left)
    print(n.key)
    walk(?n.right)

enum Tree
  leaf(v: Int)
  node(l: Box[Tree], r: Box[Tree])

fun flatten(t: Tree, out: !Vec[Int])
  match <t
    .leaf(v) => !out.push(v)
    .node(l, r)
      flatten(<l.unbox(), !out)
      flatten(<r.unbox(), !out)

sub main
  t: Tree = .node(l: Box(Tree.leaf(v: 1)), r: Box(Tree.leaf(v: 3)))
  v: Vec[Int] = Vec()
  flatten(<t, !v)
  print(v)
