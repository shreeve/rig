obj Node
  key: Int
  left: ^Node?
  right: ^Node?

  drop(!self)
    print("drop", self.key)

sub insert(slot: !^Node?, key: Int)
  if !slot as n
    if key < n.key
      insert(!n.left, key)
    else
      insert(!n.right, key)
  else
    slot = ^Node(key: key, left: none, right: none)

sub walk(slot: ?^Node?)
  if slot as n
    walk(?n.left)
    print(n.key)
    walk(?n.right)

enum Tree
  leaf(v: Int)
  node(l: ^Tree, r: ^Tree)

fun flatten(t: Tree, out: !List[Int])
  match <t
    .leaf(v) => !out.push(v)
    .node(l, r)
      flatten(<l.unbox(), !out)
      flatten(<r.unbox(), !out)

sub main()
  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.leaf(v: 3))
  v: List[Int] = List()
  flatten(<t, !v)
  print(v)
