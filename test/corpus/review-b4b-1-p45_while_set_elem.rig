# while !… as with the body assigning the element itself (place the binding points at). Expect reject or clean.
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  a: List[String?] = List()
  !a.push(String("a"))
  k = 0
  while !a[idx(?String("a"))] as t
    !t.add("x")
    a[0] = none
    k += 1
  print(a, k)
