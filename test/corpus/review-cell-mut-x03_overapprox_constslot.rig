# No user generic function: a List of a generic instance that holds Cell
# holders only on the heap, read through a read view of the List. The
# runtime's constSlot gives `*const G(C)`, the emitter's view type is
# `*G(C)`.
obj C
  c: Cell[Int]

obj G[T]
  items: List[T]
  k: Int

fun mk(k: Int) -> G[C]
  v: List[C] = List()
  !v.push(C(c: Cell(k)))
  G(items: <v, k: k)

fun look(g: !G[C]) -> Int
  !g.items[0].c.set(g.items[0].c.get() + 1)
  g.items[0].c.get() + g.k

fun first(v: !List[G[C]]) -> Int
  look(!v[0])

sub main()
  v: List[G[C]] = List()
  !v.push(mk(10))
  print(first(!v))
  print(look(!v[0]))

# expect:
# 21
# 22

# oracle: look accept
# oracle: first accept
# oracle: main accept
