struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun dup[T](a: ?T) -> T
  +a

sub main
  t = *Tok(n: 1)
  u = dup(?t)
  print(u.n)
  v: Vec[Int] = Vec()
  !v.push(3)
  w = dup(?v)
  print(w.len)
