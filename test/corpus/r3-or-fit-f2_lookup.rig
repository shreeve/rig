struct Var
  name: String
  value: String

struct Env
  vars: [3]Var

  fun get(?self, name: String) -> String?
    for v in ?self.vars
      if v.name == name
        return v.value
    none

sub main
  env = Env(vars: [Var(name: "a", value: "1"), Var(name: "b", value: "2"), Var(name: "c", value: "3")])
  out: Vec[String] = Vec()
  for n in ["a", "c"]
    q = Text(n)
    if env.get(?q) as v
      !out.push(v)
  print(out)
