struct Tok
  kind: Int
  start: Int
  len: Int

struct Parser
  src: String
  toks: []Tok
  pos: Int

  fun next(!self) -> ?Tok
    t = ?self.toks[self.pos]
    self.pos += 1
    t

  fun text(?self, t: ?Tok) -> String
    self.src[t.start..t.start + t.len]

sub main()
  src = Text("let x")
  toks = [Tok(kind: 1, start: 0, len: 3), Tok(kind: 2, start: 4, len: 1)]
  p = Parser(src: ?src, toks: ?toks, pos: 0)
  a = (!p).next()
  b = (!p).next()
  print(a.kind, b.kind)
