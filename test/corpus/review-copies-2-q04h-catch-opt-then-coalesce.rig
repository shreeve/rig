error Bad
  oops

struct P
  x: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r

fun opt(r: ?P, k: Int) -> (?P)?!
  return Bad.oops if k == 0
  return none if k == 1
  r

sub main()
  a = P(x: 1)
  b = P(x: 2)
  for k in 0..3
    c: P = (opt(?a, k) catch ?b) ?? ?b
    print(c.x)
