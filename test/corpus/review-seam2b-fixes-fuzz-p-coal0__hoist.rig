# Review probe fuzz/p/coal0__hoist.rig (seam2b fixes): rejected, or runs sanitizer-clean.
# oracle: K2.put2 accept
# oracle: S.bump accept
# oracle: S.put2 accept
# oracle: S.at accept
# oracle: S.me accept
# oracle: S.drop accept
# oracle: mk accept
# oracle: mkopt accept
# oracle: mkf accept
# oracle: mkpair accept
# oracle: setg accept
# oracle: grow accept
