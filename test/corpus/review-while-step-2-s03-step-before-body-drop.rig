# Drop order: a body local's drop runs when the body's scope ends,
# before a step that reads the joined condition's binding. Plain and
# joined lowerings must print the same trace.
#
# oracle: D.drop accept
# oracle: mk accept
# oracle: st accept
struct S
  s: []Int

struct D
  n: Int
  drop(!self)
    print("drop", self.n)

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 2
    return S(s: ?v[..])
  none

fun st(i: Int) -> Int
  print("step", i)
  i

sub main()
  v: Vec[Int] = Vec()
  !v.push(0)
  i = 0
  while mk(?v, i) as h: i += st(h.s[0])
    i += 1
    y = D(n: i)
    defer print("defer", i)
  print("--")
  i = 0
  while mk(?v, i) as h and i >= 0: i += st(h.s[0])
    i += 1
    y = D(n: i)
    defer print("defer", i)
