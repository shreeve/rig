# Recursive expression evaluator with an enum (following the compiler's hint: *Expr)
enum Expr
  num(value: Float)
  add(left: *Expr, right: *Expr)
  mul(left: *Expr, right: *Expr)
  neg(inner: *Expr)
  div(left: *Expr, right: *Expr)

fun eval(e: ?*Expr) -> Float
  match e
    .num(v) => v
    .add(l, r) => eval(?l) + eval(?r)
    .mul(l, r) => eval(?l) * eval(?r)
    .neg(x) => -eval(?x)
    .div(l, r) => eval(?l) / eval(?r)

sub main()
  # (2 + 3) * -4
  e = *Expr.mul(left: *Expr.add(left: *Expr.num(2), right: *Expr.num(3)), right: *Expr.neg(*Expr.num(4)))
  print(eval(?e))
