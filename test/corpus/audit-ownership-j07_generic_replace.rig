struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun put[T](a: !T, x: T) -> T
  replace(!a, <x)

sub main
  a = *Tok(n: 1)
  old = put(!a, *Tok(n: 2))
  print(old.n, a.n)
