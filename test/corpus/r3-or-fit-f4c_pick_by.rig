obj Wrap
  n: Int
  v: List[Int]

fun better(a: ?Wrap, b: ?Wrap, score: ?fun(?Wrap) -> Int) -> ?Wrap
  if score(a) >= score(b)
    a
  else
    b

sub main()
  x = Wrap(n: 1, v: List())
  y = Wrap(n: 2, v: List())
  bias = 0
  r = better(?x, ?y, |?bias, w: ?Wrap| w.n + bias)
  bias = 10
  print(r.n, bias)
