# write match on an element of a List in a Box, an array in a Box, a List reached through `if !o as v`, and a `!H` param's field. Expect clean, correct.
enum E
  a(n: Int, t: String)
  b

obj H
  f: List[E]

sub viaparam(h: !H, i: Int)
  match !h.f[i]
    .a(n, t)
      n += 1
      !t.add("p")
    .b => pass

sub main()
  i = 0
  o: List[E]? = List()
  if !o as v
    !v.push(E.a(n: 9, t: String("o")))
    match !v[i]
      .a(n, _) => n += 1
      .b => pass
  h = H(f: List())
  !h.f.push(E.a(n: 3, t: String("h")))
  viaparam(!h, i)
  print(o, h.f[0])
