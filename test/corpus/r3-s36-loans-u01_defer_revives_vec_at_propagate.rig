# UNSOUND on main: the `!` exit re-checks the scope's defers against
# the current state and keeps their effects on the path that goes on.
# The defer reassigns `v`, so after `<v` moved it, `v` looks live again
# past `maybe(ok)!`, and reading it reads a freed Vec.
error E
  bad

sub eat(v: Vec[Int])
  print("eat", v.len)

fun maybe(ok: Bool) -> Int!
  return E.bad if not ok
  1

fun f(ok: Bool) -> Int!
  v: Vec[Int] = Vec()
  !v.push(41)
  defer v = Vec()
  eat(<v)
  k = maybe(ok)!
  print(v[0] + k)
  k

sub main()
  print(f(true) catch 0)
