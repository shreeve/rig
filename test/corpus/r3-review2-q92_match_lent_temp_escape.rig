struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

enum E
  a(c: Counter)
  b

struct H
  e: E

fun mkh(n: Int) -> H
  H(e: E.a(c: Counter(hits: Cell(n))))

sub main()
  one = [Counter(hits: Cell(1))]
  saved = ?one[0]
  match ?mkh(7).e
    .a(c) => saved = c
    .b => pass
  print(saved.hits.get())
