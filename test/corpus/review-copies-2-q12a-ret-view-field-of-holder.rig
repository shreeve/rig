error Bad
  oops

struct P
  x: Int

struct Q
  r: ?P
  n: Int

struct W
  w: !P

struct WI
  w: !Int


fun f(q: ?Q, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  q.r

fun g(q: Q, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  q.r

sub main
  a = P(x: 1)
  b = P(x: 2)
  q = Q(r: ?a, n: 0)
  v = f(?q, true) catch ?b
  u = g(q, true) catch ?b
  t = g(q, false) catch ?b
  print(v.x, u.x, t.x)
