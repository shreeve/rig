struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main
  v: Vec[*Tok] = Vec()
  !v.push(*Tok(n: 1))
  for t in !v
    -t
    print("x")
  print(v.len)
