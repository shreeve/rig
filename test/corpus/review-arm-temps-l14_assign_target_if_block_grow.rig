# Same class with an `if` whose branch is a block: the branch's lines are
# statements of their own, so the target's view looks dead there.
fun grow(v: !Vec[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  k = true
  w[0] = if k
    grow(!v)
  else
    3
  print(v[0], v.len)
