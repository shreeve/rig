# The value's last scope re-points a view the while step reads.
sub run(k: Int)
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  n = 0
  while n < 2 : n += w[0]
    w[0] = match k
      1 => 4
      _
        u: Vec[Int] = Vec()
        !u.push(1)
        w = !u[0..1]
        3

sub main()
  run(0)
