# Review probe l03_branch_clone.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.vs accept
# oracle: mk accept
# oracle: f accept
struct S
  n: Int
  items: Vec[Int]

  fun vs(!self) -> ![]Int
    !self.items[..]

fun mk(n: Int) -> S
  S(n: n, items: Vec())

fun f(n: Int) -> Int
  n

sub main
  s = mk(100)
  !s.items.push(1)
  c = f(1) == 1
  !(+s if c else mk(1)).items.push(5)
  print(!(+s if c else mk(1)).vs())
  print((!(+s.items if c else Vec[Int]())).len)
  !(+s.items if c else Vec[Int]()).push(3)
  print(s.items)
