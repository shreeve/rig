# return of a value-if whose branches build owners before an error
error Bad
  oops

fun f(c: Bool) -> List[Text]!
  v: List[Text] = List()
  !v.push(Text("a"))
  errdefer print("errdefer")
  return (Bad.oops if c else <v)

sub main()
  print(f(true) catch List[Text]())
  print(f(false) catch List[Text]())
