# oracle: mk accept
# oracle: mkf accept
# oracle: grow accept
# oracle: main accept

error E
  bad

obj S
  s: []Int

fun mk(v: ?List[Int], n: Int) -> S?
  if n < 4
    return S(s: ?v[..])
  none

fun mkf(v: ?List[Int], n: Int) -> S?!
  return E.bad if n == 70
  mk(v, n)

sub grow(v: !List[Int])
  for i in 0..50
    !v.push(i)

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  @outer while (mkf(?v, n) catch break) as h: k += h.s[0]
    n += 1
    while mk(?v, 0) as g
      k += g.s[0] - 1
      k += 1000
      continue @outer
  print(k, n)
