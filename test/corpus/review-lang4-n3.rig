obj H
  w: !List[Int]

fun make(v: !List[Int]) -> H
  H(w: v)

sub fill(h: H)
  u: List[Int] = List()
  !u.push(1)
  h.w = <u

fun pass_on(h: H) -> H
  k: List[Int] = List()
  !k.push(1)
  !k.push(2)
  h.w = <k
  h

sub main()
  v: List[Int] = List()
  h = make(!v)
  h2 = pass_on(<h)
  h2.w = List[Int]()
  fill(<h2)
  print(v.len)
