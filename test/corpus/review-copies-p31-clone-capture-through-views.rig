# `|+r|` through read and write views of owners and handles: each
# closure holds its own clone, dropped once with the closure.
obj N
  v: Int

  drop(!self)
    print("drop", self.v)

obj B
  t: String
  hs: List[*N]

fun vof(o: ?(*N)?) -> Int
  if o as n
    return n.v
  0

fun tlen(o: ?String?) -> Int
  if o as t
    return t.len
  0

sub main()
  hs: List[*N] = List()
  !hs.push(*N(v: 1))
  r = ?hs
  f = |+r| r.len + r[0].v
  print(f())
  o: (*N)? = *N(v: 2)
  ro = ?o
  g = |+ro| vof(?ro)
  <o
  print(g())
  bx = ^String("boxed")
  rb = ?bx
  h = |+rb| rb.len
  print(h())
  ts = [String("a"), String("bb")]
  rt = ?ts
  k = |+rt| rt[1].len
  print(k())
  ot: String? = String("opt")
  rot = ?ot
  m = |+rot| tlen(?rot)
  print(m())
  b = B(t: String("bee"), hs: List())
  !b.hs.push(*N(v: 3))
  wb = !b
  q = |+wb| wb.t.len + wb.hs[0].v
  !wb.hs.push(*N(v: 4))
  print(q())
  print("end")
