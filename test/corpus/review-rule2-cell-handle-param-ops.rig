sub fill(xs: !Cell[List[Int]])
  !xs.push(7)
  xs[0] = 3

sub ops(c: *Cell[List[Int]])
  (!c)[0] = 10
  print(c.len)
  (!c).push(11)
  print((!c).pop() ?? -1)
  (!c).push(12)
  print(c.get(0) ?? -1)
  fill(!c)
  print(c.len, c[0])
  (!c).keep(2)
  print(c.len)
  (!c).clear()
  print(c.len)

sub cellops(c: *Cell[Int], s: *Cell[String])
  (!c).set(5)
  print(c.get())
  old = (!c).replace(6)
  print(old, c.get())
  (!s).set(String("hi"))
  t = (!s).replace(String("yo"))
  print(t)

sub builtins(c: *Cell[Int], d: *Cell[Int], s: *Cell[String], t: *Cell[String])
  swap(!c, !d)
  print(c.get(), d.get())
  swap(!s, !t)
  u = (!s).replace(String("z"))
  print(u)

sub main()
  c: *Cell[List[Int]] = *Cell(List())
  !c.push(1)
  ops(+c)
  print(c.len)
  i: *Cell[Int] = *Cell(1)
  s: *Cell[String] = *Cell(String("a"))
  cellops(+i, +s)
  print(i.get())
  j: *Cell[Int] = *Cell(2)
  t: *Cell[String] = *Cell(String("b"))
  builtins(+i, +j, +s, +t)
  print(i.get(), j.get())
  print((!s).replace(String("")), (!t).replace(String("")))
