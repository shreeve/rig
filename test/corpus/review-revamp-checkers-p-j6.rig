struct Res
  id: Int
  v: Vec[Int]

struct H
  r: ?Res

fun store(h: !H, r: ?Res) -> Bool
  h.r = r
  false

fun make(k: Int) -> Res?
  Res(id: k, v: Vec()) if k > 0 else none

sub main()
  z = Res(id: 0, v: Vec())
  h = H(r: ?z)
  for i in 1..3
    print(h.r.id)
    match i
      k if make(k) as a and store(!h, ?a) => return
      _ => print("no")
