# A defer with `?? continue` in an expression. Expected: rejected.
#
# oracle: mk accept
# oracle: odd accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

fun odd(j: Int) -> Int?
  j if j % 2 == 1 else none

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  :outer while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    defer k += odd(i) ?? continue :outer
  print(k)
