enum Mode
  fast
  slow

X = true
K = "long one" if X else "b"
O: (?String)? = "o" if not X else none
A = [1, 2, 3]
SA = ["a", "b"]
BA = [true, false]
V = Simd[U8, 4].splat(7)
M = Mode.slow
F = 2.0 * 3.0
N = (1 + 2) * -3
U: U8 = 255
I: I16 = -32768
W = 1 if X else 2

sub main()
  print(X, K, O, A, SA, BA, V, M, F, N, U, I, W)
  print(K, "", K)
  t = String(X, K, O, A, SA, BA, V, M, F, N, U, I, W)
  print(t)
