# Review probe d02_text_branch.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: mkt accept
# oracle: f accept
# oracle: mkv accept
# oracle: arr accept
# oracle: fill accept
# oracle: main accept
fun mkt(s: ?String) -> String
  String(s)

fun f(n: Int) -> Int
  n

fun mkv() -> List[Int]
  v: List[Int] = List()
  !v.push(1)
  v

fun arr() -> [3]Int
  [7, 8, 9]

sub fill(t: !String)
  !t.add("!")
  print(t)

sub main()
  c = f(1) == 1
  !mkt("a").add("b")
  !(String("x") if c else mkt("y")).add("z")
  fill(!(mkt("p") if c else String("q")))
  fill(!String("lit"))
  !(mkv() if c else List[Int]()).push(2)
  !([1, 2, 3] if c else arr()).fill(0)
  print(?(arr() if c else [4, 5, 6])[..])
  !(arr() if c else [4, 5, 6])[0..2].fill(3)
  print((mkv() if not c else List[Int]()).len)
