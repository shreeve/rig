# The step pushes through a write view the binding holds while the body
# replaced the List (two writers of `v` across the body).
obj W
  v: !List[Int]

fun mk(v: !List[Int], i: Int) -> W?
  if i < 3
    return W(v: !v)
  none

sub main()
  v: List[Int] = List()
  i = 0
  while mk(!v, i) as h: !h.v.push(i)
    v = List()
    !v.push(10)
    i += 1
  print(v.len)
