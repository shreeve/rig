obj K
  a: ?String

  sub put(!self, v: ?String) keeps v
    self.a = v

sub main()
  t = String("outer")
  o: K? = K(a: ?t)
  arr: [2]K = [K(a: ?t), K(a: ?t)]
  l: List[K] = List()
  !l.push(K(a: ?t))
  if true
    w = !o
    if !w as x
      y = !x
      d = String("d1")
      !y.put(?d)
  if true
    w = !arr
    for x in !w
      y = !x
      d = String("d2")
      !y.put(?d)
  if true
    w = !o
    while !w as x
      d = String("d4")
      !x.put(?d)
      break
  print(o, arr[0].a, l[0].a)
