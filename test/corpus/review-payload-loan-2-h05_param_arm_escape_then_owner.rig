enum WT
  a(w: !String)
  b

fun peek(e: ?WT, d: ?String) -> ?String from e, d
  match e
    .a(w) => ?w[1..]
    .b => ?d[..]

sub main()
  x = String("hello")
  d = String("d")
  e = WT.a(!x)
  r = peek(?e, ?d)
  !x.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(r)
