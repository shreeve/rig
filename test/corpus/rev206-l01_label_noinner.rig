obj Cur
  xs: ?List[Int]
  i: Int

  fun next(!self) -> Int?
    return none if self.i >= self.xs.len
    self.i += 1
    self.xs[self.i - 1]

fun mk(v: ?List[Int]) -> Cur from v
  Cur(xs: v, i: 0)

obj Bag
  xs: List[Int]

  fun each(?self) -> Cur from self
    Cur(xs: ?self.xs, i: 0)

sub fill(v: !List[Int])
  for _ in 0..3
    !v.push(1)

sub grow(v: !List[Int])
  for _ in 0..100
    !v.push(1)

sub main()
  v: List[Int] = List()
  fill(!v)
  @o for x in mk(?v)
    grow(!v)
    print(x)
