struct Bag[T]
  items: Vec[T] = Vec()
  n: Int = 0

  sub add(!self, x: T)
    !self.items.push(<x)
    self.n += 1

struct Holder
  bag: Bag[String]

sub main()
  b = Bag[String]()
  !b.add("a")
  c = Bag[Int]()
  !c.add(3)
  h = Holder(bag: Bag[String]())
  print(b.items.len, c.items.len, h.bag.items.len, b.n)
