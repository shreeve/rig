obj Res
  id: Int
  v: List[Int]

obj H
  r: ?Res

fun store(h: !H, r: ?Res) -> Bool keeps r
  h.r = r
  false

fun make(k: Int) -> Res?
  Res(id: k, v: List()) if k > 0 else none

sub main()
  z = Res(id: 0, v: List())
  h = H(r: ?z)
  i = 1
  while make(i) as a and store(!h, ?a) : i += 1
    print("yes")
  print(h.r.id)
