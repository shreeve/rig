# The shadowing inner loop is a joined while with a step reading its binding; its `continue :a` must go to its own step, not the outer one.
# Expected: accepted, prints `end 3 9 3`.
#
# oracle: mk accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  q = 0
  m = 0
  :a while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    m = 0
    break :a if i > 50
    :a while mk(?v, m) as g and m >= 0: q += g.s[0]
      m += 1
      for _ in 0..2
        continue :a
  print("end", k, q, m)
