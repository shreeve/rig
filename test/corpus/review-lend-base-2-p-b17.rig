struct Q
  n: Int

  sub bump(!self)
    self.n += 1

  fun get(?self) -> Int
    self.n

struct P
  x: Int
  o: Int?
  a: [2]Int
  v: Vec[Int]
  q: Q

fun mk() -> P
  P(x: 1, o: 3, a: [1, 2], v: Vec(), q: Q(n: 1))

fun id(n: Int) -> Int
  n

fun apply[T](f: fun(T) -> T, n: T) -> T
  f(n)

sub main()
  p = mk()
  print(apply(|k| (?p.a)[k], 1))
