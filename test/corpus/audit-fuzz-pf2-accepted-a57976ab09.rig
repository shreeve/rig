  print(xs324)

sub t2001()
  flag2001 = rt_bool(true)
  tv2001: Int = id_int((-2))
  op2001: Int? = ((-6) if flag2001 else tv2001)
  print(op2001, op2001 ?? 0)

sub t3121()
  mk3121 = rt_int(0)
  mz3121: F32 = match mk3121
    1 => gid((-2))
    _ => 1
  print(mz3121)

