sub t2545()
  cmp2545: U32 = id_u32(11)
  print(cmp2545 == (fal2545(false) catch 20), (fal2545(false) catch 20) < cmp2545, (fal2545(false) catch 20) >= cmp2545)

sub t773()
  const cst773: U64 = 14
  vw773: Vec[U64] = Vec()
  pushit773 = |!vw773, x: U64| !vw773.push(x)
  pushit773(cst773)
  print(vw773)

sub t4344()
