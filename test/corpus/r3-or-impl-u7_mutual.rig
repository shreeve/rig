fun ping(a: ?List[Int], b: ?List[Int], n: Int) -> ?List[Int]
  if n == 0
    return a
  pong(a, b, n - 1)

fun pong(a: ?List[Int], b: ?List[Int], n: Int) -> ?List[Int]
  if n == 1
    return b
  ping(a, b, n - 1)

sub main()
  x: List[Int] = List()
  y: List[Int] = List()
  r = ping(?x, ?y, 3)
  !y.push(1)
  print(r.len)
