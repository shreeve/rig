use std.math

sub main
  print(math.gcd(0, 0), math.gcd(-12, 18), math.gcd(12, -18), math.gcd(0, -5))
  print(math.mod(-1, 3), math.mod(1, -3), math.mod(-1, -3), math.mod(7, -3), math.mod(-7, 3))
  print(math.pow(2, 62), math.pow(-2, 63), math.pow(2, -1), math.pow(-1, -3), math.pow(1, -5))
  print(math.pow(0, 0), math.clamp(5, 10, 1))
  print(math.sqrt(-1.0), math.ln(0.0), math.pow_f(-8.0, 1.0 / 3.0))
