struct Big
  a: Int
  b: Int
  c: Int

struct Two
  x: Big
  y: Big

  fun pick(?self, first: Bool) -> ?Big
    ?self.x if first else ?self.y

  fun pickw(!self, first: Bool) -> !Big
    if first
      !self.x
    else
      !self.y

fun total(b: ?Big) -> Int
  b.a + b.b + b.c

sub main()
  t = Two(x: Big(a: 1, b: 2, c: 3), y: Big(a: 4, b: 5, c: 6))
  print(total(t.pick(true)), t.pick(false).a)
  w = (!t).pickw(false)
  w.a = 40
  print(t.y.a)
  ((!t).pickw(true)).b = 20
  print(t.x.b)
  r = ?t.pick(true)
  print(r == t.x, r.a == 1)
