struct P
  t: Text

struct H
  w: !P

enum E
  a(h: H)
  b

sub main()
  p = P(t: Text("hello"))
  e = E.a(H(w: !p))
  match e
    .a(h)
      r = ?h.w.t[1..]
      for _ in 0..50
        !h.w.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r)
    .b => pass
