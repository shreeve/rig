obj P
  hl: *List[Int]

fun reh(p: !P) -> Int
  n: List[Int] = List()
  for i in 0..100
    !n.push(i + 50)
  p.hl = *<n
  0

sub main()
  v: List[Int] = List()
  !v.push(7)
  p = P(hl: *<v)
  print(p.hl[reh(!p)])

