# FizzBuzz, variant: a function that returns the label.
# No string building and no int->string, so the label is optional.
fun label(n: Int) -> String?
  if n % 15 == 0
    "FizzBuzz"
  else if n % 3 == 0
    "Fizz"
  else if n % 5 == 0
    "Buzz"
  else
    none

sub main()
  for i in 1..16
    if label(i) as s
      print(s)
    else
      print(i)
