# The fold: a String that views a Text slot (ctl-field): rejected where the Text changes or ends while it is used, or runs sanitizer-clean.
enum E
  full(t: Text)
  empty

struct S
  name: String

struct H
  t: Text

fun id[T](x: ?T) -> ?T from x
  x

fun first(v: ?List[Text]) -> ?Text from v
  ?v[0]

sub main()
  o = H(t: Text("hello"))
  keep: String = ""
  keep = ?o.t
  print(keep)
