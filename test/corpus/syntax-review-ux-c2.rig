# count lines, words, bytes on stdin (wc), via libc getchar
extern fun getchar() -> I32

fun next_byte() -> I32
  raw
    getchar()

sub main
  lines = 0
  words = 0
  bytes = 0
  in_word = false
  while true
    c = next_byte()
    break if c < 0
    bytes += 1
    if c == 10
      lines += 1
    if c == 32 or c == 10 or c == 9
      in_word = false
    else if not in_word
      in_word = true
      words += 1
  print(lines, words, bytes)
