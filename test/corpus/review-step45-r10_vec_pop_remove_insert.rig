# pop / remove / insert on List[Text] and List[^Text]
sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  !v.insert(0, String("z"))
  x = (!v).remove(1)
  if (!v).pop() as y
    print(x, y, v)
  w: List[^String] = List()
  !w.push(^String("q"))
  !w.clear()
  print(w.len)
