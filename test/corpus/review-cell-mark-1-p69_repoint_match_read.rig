enum E
  a(c: *Cell[List[Int]])
  b

sub g(x: !*Cell[List[Int]])
  x = *Cell(List[Int]())

sub k(r: ?Cell[List[Int]], e: ?E)
  match e
    .a(c) => g(!c)
    .b => print("b")
  print(r.len)

sub main()
  w: *Cell[List[Int]] = *Cell(List())
  !w.push(1)
  e = E.a(c: <w)
  match ?e
    .a(c) => k(c, ?e)
    .b => print("b")
