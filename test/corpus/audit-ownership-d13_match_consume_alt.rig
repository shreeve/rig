struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main
  s: Slot = .pair(a: *Tok(n: 1), b: *Tok(n: 2))
  match <s
    .full(_), .pair(_, _) => print("some")
    .empty => print("none")
  print("end")
