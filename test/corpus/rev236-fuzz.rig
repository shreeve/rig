use std.hash

obj Pair
  key: String
  value: String
  live: Bool

obj Model
  pairs: List[Pair] = List()
  len: Int = 0

  fun find(?self, k: ?String) -> Int?
    for p, i in ?self.pairs
      return i if p.live and p.key == k
    none

obj Rand
  s: U64

  fun next(!self, n: Int) -> Int
    self.s = self.s *% 6364136223846793005 +% 1442695040888963407
    Int((self.s >> 33) % U64(n))

fun mk(k: Int) -> String
  String("k", k, "-long-enough-to-allocate-on-heap")

sub addone(k: ?String, v: !String)
  !v.add("+")

fun agree(m: ?hash.Map[String, String], ref: ?Model, span: Int) -> Bool
  return false if m.len != ref.len
  for x in 0..span
    k = mk(x)
    if ref.find(?k) as i
      if m.get(?k) as v
        return false if v != ref.pairs[i].value
      else
        return false
    else
      return false if m.has(?k)
  i = 0
  for e in ?m.items()
    while i < ref.pairs.len and not ref.pairs[i].live
      i += 1
    return false if i >= ref.pairs.len
    return false if ref.pairs[i].key != e.key or ref.pairs[i].value != e.value
    i += 1
  while i < ref.pairs.len and not ref.pairs[i].live
    i += 1
  i == ref.pairs.len

fun run(seed: U64, span: Int, steps: Int) -> Bool
  r = Rand(s: seed)
  m = hash.Map[String, String].new(capacity: (!r).next(20))
  ref = Model()
  for step in 0..steps
    op = (!r).next(20)
    x = (!r).next(span)
    if op < 8
      v = String("v", step)
      found = ref.find(?mk(x))
      old = (!m).replace(mk(x), +v)
      if found as i
        if old as o
          return false if o != ref.pairs[i].value
        else
          return false
        ref.pairs[i].value = <v
      else
        return false if old != none
        !ref.pairs.push(Pair(key: mk(x), value: <v, live: true))
        ref.len += 1
    else if op < 15
      got = (!m).take(?mk(x))
      if ref.find(?mk(x)) as i
        if got as g
          return false if g != ref.pairs[i].value
        else
          return false
        ref.pairs[i].live = false
        ref.len -= 1
      else
        return false if got != none
    else if op < 16
      !m.reserve((!r).next(30))
    else if op < 17
      !m.update(addone)
      for p in !ref.pairs
        !p.value.add("+") if p.live
    else if op < 18
      if (!m).edit(?mk(x)) as v
        !v.add("e")
        if ref.find(?mk(x)) as i
          !ref.pairs[i].value.add("e")
        else
          return false
    else if (!r).next(30) == 0
      !m.clear()
      !ref.pairs.clear()
      ref.len = 0
    if not agree(?m, ?ref, span)
      print("disagree at", step)
      return false
  true

sub main()
  ok = true
  for seed in 1..9
    span = 3 + Int(seed % 25)
    if not run(U64(seed), span, 300)
      print("fail", seed)
      ok = false
  print(run(99, 200, 800), ok)
