# for x in !m[idx(?Text("a"))][0..1] : slice of a Vec element reached through a temp
fun idx(s: String) -> Int
  s.len - 1

sub main
  m: Vec[Vec[Text]] = Vec()
  r: Vec[Text] = Vec()
  !r.push(Text("p"))
  !m.push(<r)
  for x in !m[idx(?Text("a"))][0..1]
    for _ in 0..40
      !x.add("xxxxxxxx")
  print(m[0][0].len)
