# ?self method changing a Cell on an element of a ?List[C] param
obj C
  c: Cell[Int]

  sub hit(!self)
    !self.c.set(self.c.get() + 1)

sub bump(v: !List[C], a: ![1]C)
  !v[0].hit()
  !a[0].hit()

sub main()
  v: List[C] = List()
  !v.push(C(c: Cell(1)))
  a = [C(c: Cell(1))]
  bump(!v, !a)
  print(v[0].c.get(), a[0].c.get())
