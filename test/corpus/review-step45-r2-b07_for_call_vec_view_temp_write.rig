# for x in !getv(!v, ?Text("a")): write loop over a List view returned by a call with temp
fun getv(v: !List[String], s: ?String) -> !List[String]
  v

sub main()
  v: List[String] = List()
  !v.push(String("p"))
  for x in !getv(!v, ?String("a"))
    for _ in 0..40
      !x.add("xxxxxxxx")
  print(v[0].len)
