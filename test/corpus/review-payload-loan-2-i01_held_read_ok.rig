struct P
  t: Text
  n: Int

enum WP
  a(w: !P)
  b

enum WI
  a(w: !Int)
  b

struct H
  e: WP

struct HI
  e: WI

fun mk(p: !P) -> H from p
  H(e: WP.a(!p))

fun mki(x: !Int) -> HI from x
  HI(e: WI.a(!x))

fun pass_through(x: !Int, d: !Int) -> !Int from x, d
  match mki(!x).e
    .a(w) => w
    .b => d

sub main()
  p = P(t: Text("hello"), n: 2)
  match mk(!p).e
    .a(w)
      r = ?w.t[1..]
      print(r, w.n)
      w.n = 7
    .b => pass
  print(p.n)
  x = 3
  match mki(!x).e
    .a(w) if w > 2 => print("big", w)
    .a(w) => print(w)
    .b => pass
  d = 0
  m = pass_through(!x, !d)
  m += 1
  print(x)
