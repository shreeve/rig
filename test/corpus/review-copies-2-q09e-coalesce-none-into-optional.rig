# `?? none` and `catch none` where an optional of the viewed value is expected.
error Bad
  oops

struct P
  x: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r

fun px(o: P?) -> Int
  if o as p
    return p.x
  -1

sub main
  a = P(x: 1)
  i: (?P)? = ?a
  f: P? = i ?? none
  g: P? = get(?a, false) catch none
  print(px(f), px(g))
