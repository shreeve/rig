obj Res
  n: Int
  t: String

enum E
  a(r: Res)
  b

fun getw(e: !E) -> !E
  e

obj H
  w: !E

sub f(h1: ?H, h2: ?H, c: Bool)
  match (h1.w if c else h2.w)
    .a(r) => r.n = 77
    .b => pass

sub main()
  e = E.a(r: Res(n: 1, t: String("x")))
  d = E.a(r: Res(n: 2, t: String("y")))
  h1 = H(w: !e)
  h2 = H(w: !d)
  f(?h1, ?h2, true)
  print(h1.w)
