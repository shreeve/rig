obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

obj Q
  e: E
  o: E?
  v: List[Int]

obj W
  e: E
  o: E?
  v: List[Int]
  q: Q?

  fun ge(?self) -> ?E
    ?self.e

  fun gv(?self) -> ?List[Int]
    ?self.v

  fun go(?self) -> ?(E?)
    ?self.o

  fun gew(!self) -> !E
    !self.e

  fun gvw(!self) -> !List[Int]
    !self.v

obj H
  w: !W

fun mkv(n: Int) -> List[Int]
  v: List[Int] = List()
  for i in 0..n
    !v.push(i + 1)
  v

fun mkw(n: Int) -> W
  W(e: mk(n), o: mk(n + 10), v: mkv(n), q: Q(e: mk(n + 20), o: mk(n + 30), v: mkv(n)))

fun id[T](x: T) -> T
  x

obj P2
  k: Int
  o: Int?

obj WP
  p: P2
  e: E

fun f(a: !WP, b: !WP, c: Bool) -> Int?
  match (a if c else b).p.k
    1 => print("one")
    _ => print("other")
  if (a if c else b).p.o as z
    print(z)
  for x in (a if c else b).p.k..3
    print(x)
  1

sub main()
  x = WP(p: P2(k: 1, o: 4), e: mk(1))
  y = WP(p: P2(k: 2, o: none), e: mk(2))
  _ = f(!x, !y, true)
