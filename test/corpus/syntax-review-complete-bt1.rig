obj Node
  keys: List[Int]
  kids: List[^Node]

fun count(n: ?Node) -> Int
  total = n.keys.len
  for k in ?n.kids
    total += count(?k)
  total

sub add(n: !Node, i: Int, key: Int)
  for k, j in !n.kids
    if j == i
      !k.keys.push(key)

sub main()
  root = Node(keys: List(), kids: List())
  !root.kids.push(^Node(keys: List(), kids: List()))
  add(!root, 0, 5)
  print(count(?root))
