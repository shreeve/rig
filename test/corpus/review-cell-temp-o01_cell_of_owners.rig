# Cell methods on temporaries whose Cell holds owners: no leak, no double drop.
#
# oracle: D.drop accept
# oracle: L.drop accept
obj D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

obj L
  t: Cell[String]
  v: Cell[List[String]]
  d: Cell[D]

  drop(!self)
    print("dropL", (!self.t).replace(String("-")), self.v.len)

fun mkd(n: Int) -> D
  D(c: Cell(n))

fun mkl(s: ?String) -> L
  L(t: Cell(String(s)), v: Cell(List()), d: Cell(mkd(0)))

fun freshT() -> Cell[String]
  Cell(String("ft"))

fun freshV() -> Cell[List[String]]
  w: List[String] = List()
  !w.push(String("v0"))
  Cell(<w)

fun freshD() -> Cell[D]
  Cell(mkd(100))

sub main()
  mkl("a").t.set(String("b"))
  print(mkl("c").t.replace(String("d")))
  mkl("e").v.push(String("x"))
  print(mkl("f").v.pop())
  mkl("g").v.clear()
  mkl("h").d.set(mkd(5))
  print(mkl("i").d.replace(mkd(6)).c.get())
  freshT().set(String("z"))
  print(freshT().replace(String("y")))
  freshV().push(String("w"))
  print(freshV().pop())
  freshV().clear()
  freshD().set(mkd(7))
  freshD().replace(mkd(8)).c.set(9)
