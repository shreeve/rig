use std.hash

obj P
  x: Int

sub main()
  q = hash.Map[String, P]()
  !q.put(String("a"), P(x: 1))
  d = P(x: 4)
  x1: P? = q.get("z") ?? (q.get("a") ?? none)
  x2: P? = q.get("z") ?? q.get("y") ?? none
  x3: P = q.get("z") ?? q.get("a") ?? P(x: 0)
  x4: P? = q.get("z") ?? (q.get("a") ?? P(x: 3))
  x5 = (q.get("z") ?? (q.get("a") ?? ?d)).x
  x6: P? = q.get("z") ?? (q.get("y") ?? (q.get("a") ?? none))
  !q.put(String("a"), P(x: 2))
  print(x1, x2, x3, x4, x6)
  print(x5)
