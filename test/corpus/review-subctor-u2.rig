obj Bag[T]
  items: List[T]

obj Opt[T]
  o: T?

obj Sh[T]
  h: *T

obj Node
  v: Int

sub main()
  a = Bag(List[Int]())
  b: Bag[?String] = Bag(List())
  c = Opt(3)
  d: Opt[Int] = Opt(none)
  e = Sh(*Node(1))
  f: Bag[Int] = Bag(items: List())
  print(a, b, c, d, e, f)
  g: ^Opt[Int] = ^Opt(none)
  print(g)
