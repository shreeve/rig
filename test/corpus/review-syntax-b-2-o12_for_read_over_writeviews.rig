fun keep(s: String) -> String
  s

sub main()
  a = Text("hello")
  v: List[!Text] = List()
  !v.push(!a)
  out: List[String] = List()
  for r in ?v
    !out.push(keep(r[1..]))
  for _ in 0..50
    !v[0].add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(out)
