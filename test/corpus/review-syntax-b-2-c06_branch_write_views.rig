fun keep(s: ?String) -> ?String
  s

sub f(a: !String, b: !String, c: Bool)
  s = keep((a if c else b)[1..])
  for _ in 0..50
    !a.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(s)

sub main()
  x = String("hello")
  y = String("world")
  f(!x, !y, true)
