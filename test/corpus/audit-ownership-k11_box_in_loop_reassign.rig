obj Node
  key: Int
  left: ^Node?
  right: ^Node?

  drop(!self)
    print("drop", self.key)

sub insert(slot: !^Node?, key: Int)
  if !slot as n
    if key < n.key
      insert(!n.left, key)
    else
      insert(!n.right, key)
  else
    slot = ^Node(key: key, left: none, right: none)

sub walk(slot: ?^Node?)
  if slot as n
    walk(?n.left)
    print(n.key)
    walk(?n.right)

sub main()
  cur: ^Node? = ^Node(key: 1, left: ^Node(key: 0, left: none, right: none), right: none)
  while <cur as n
    print("at", n.key)
    cur = <n.left
  print("end")
