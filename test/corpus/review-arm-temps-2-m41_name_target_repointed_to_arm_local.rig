# A write-view name target the value re-points at an arm-local List; the
# store then writes 3 through it after the arm drops that List.
sub main()
  v: List[Int] = List()
  !v.push(7)
  w = !v[0]
  k = 0
  w = match k
    0
      u: List[Int] = List()
      !u.push(1)
      w = !u[0]
      3
    _ => 4
  print(v[0])
