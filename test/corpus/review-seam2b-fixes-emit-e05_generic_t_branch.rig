# Review probe emit/e05_generic_t_branch.rig (seam2b fixes): rejected, or runs sanitizer-clean.
use std.sort

error Bad
  no

enum Sh
  circle(r: Int)
  point

struct K2
  n: Int

  sub put2(!self, a: Int, b: Int)
    self.n = a * 10 + b

  fun put2v(!self, a: Int, b: Int) -> Int
    self.n = a * 10 + b
    self.n

struct S
  n: Int
  t: Text
  items: Vec[Int]
  arr: [3]Int
  kk: K2
  oi: Int?
  e: Sh

  fun bump(!self) -> Int
    self.n += 1
    self.n

  sub put2(!self, a: Int, b: Int)
    self.n = a * 10 + b

  fun at(!self) -> !Int
    !self.n

  fun me(!self) -> !S
    self

  drop(!self)
    print("dropS", self.n, self.t, self.items, self.arr, self.kk.n, self.oi, self.e)

struct Pair
  a: S
  b: S

fun mk(n: Int) -> S
  print("make", n)
  v: Vec[Int] = Vec()
  !v.push(3)
  !v.push(1)
  S(n: n, t: Text("text long enough for the heap ", n), items: <v, arr: [3, 2, 1], kk: K2(n: 0), oi: n, e: .circle(r: n))

fun mkopt(n: Int) -> S?
  return none if n == 0
  mk(n)

fun mkf(n: Int) -> S!
  return Bad.no if n == 0
  mk(n)

fun mkpair(n: Int) -> Pair
  Pair(a: mk(n), b: mk(n + 1))

sub setg[T](x: !T, v: T)
  x = v

sub grow(s: !S)
  s.n += 100

sub inc(x: !Int)
  x += 1

fun f(n: Int) -> Int
  n

fun incr(x: !Int) -> Int
  x += 1
  x

fun sortv(xs: ![]Int) -> Int
  sort.sort(!xs)
  xs[0]

struct K3
  n: Int

fun f2(n: Int) -> Int
  n + 1

sub gt[T](a: T, b: T, c: Bool, put: sub(!T))
  put(!(a if c else b))

sub putn(s: !S)
  s.n = 99

sub main()
  gt(mk(1), mk(2), f(1) == 1, putn)
