struct R
  id: Int

  drop(!self)
    print("rel", self.id)

struct P
  a: R
  b: R

enum HR
  one(r: R)
  empty

error E
  bad

fun mk(id: Int) -> R
  print("new", id)
  R(id: id)

fun optr(id: Int) -> R?
  return none if id % 3 == 0
  mk(id)

sub look(r: ?R)
  print("use", r.id)

fun rt_bool(b: Bool) -> Bool
  b

fun rt_int(n: Int) -> Int
  n

fun pick[T](a: T, b: T, first: Bool) -> T
  if first
    return <a
  <b

fun keep_first[T](a: T, b: T) -> T
  a

fun ident[T](x: T) -> T
  x

fun cycle[T](x: T, n: Int) -> T
  cur = <x
  for _ in 0..n
    cur = ident(<cur)
  cur

fun wrap[T](x: T) -> T?
  x

fun unwrap_or[T](o: T?, d: T) -> T
  if <o as v
    return <v
  <d

fun first_some[T](a: T?, b: T?) -> T?
  if <a as x
    return <x
  <b

fun must[T](o: T?) -> T!
  if <o as x
    return <x
  return E.bad

fun chain[T](o: T?) -> T?
  x = (<o)?
  x

sub swap_gen[T](a: !T, b: !T)
  swap(!a, !b)

fun first_ref[T, U](p: ?Pair[T, U]) -> ?T
  ?p.first

struct Pair[T, U]
  first: T
  second: U

  fun left(?self) -> ?T
    ?self.first

struct Shelf[T]
  items: Vec[T]

  sub add(!self, x: T)
    !self.items.push(<x)

  fun take(!self) -> T?
    !self.items.pop()

enum Maybe[T]
  just(v: T)
  nada

fun get_or[T](m: Maybe[T], d: T) -> T
  match <m
    .just(v) => v
    .nada => d

fun fill_shelf[T](a: T, b: T) -> Shelf[T]
  s = Shelf[T](items: Vec())
  !s.add(<a)
  !s.add(<b)
  s

sub h0
  o1: Int? = 10
  r1 = chain(<o1)
  if ?r1 as w2
    print("int", w2)
  o4: R? = none
  r4 = chain(<o4)
  if ?r4 as w5
    look(?w5)

sub h1()!
  r7 = optr(20)
  c7 = |x: ?R?| 1
  print("int", c7(?r7))
  if ?r7 as y8
    print("use", y8.id)
  o9: P? = P(a: mk(30), b: mk(31))
  r9 = chain(<o9)
  if ?r9 as w10
    look(?w10.a)
    look(?w10.b)
  r12 = ident(ident(HR.one(r: mk(40))))
  match ?r12
    .one(z13) => look(?z13)
    .empty => print("empty")
  m14: Maybe[P] = .just(P(a: mk(50), b: mk(51)))
  r14 = get_or(<m14, P(a: mk(60), b: mk(61)))
  look(?r14.a)
  look(?r14.b)
  m16: Maybe[Int] = .just(70)
  r16 = get_or(<m16, 80)
  print("int", r16)
  r18 = pick("s90", "s100", rt_bool(true))
  print("str", r18)

sub h2()!
  r20 = cycle("s110", rt_int(3))
  print("str", r20)
  r22 = ident(ident(HR.one(r: mk(120))))
  match ?r22
    .one(z23) => look(?z23)
    .empty => print("empty")
  m24: Maybe[P] = .just(P(a: mk(130), b: mk(131)))
  r24 = get_or(<m24, P(a: mk(140), b: mk(141)))
  look(?r24.a)
  look(?r24.b)
  a26 = "s150"
  b26 = "s160"
  swap_gen(!a26, !b26)
  print("str", a26)
  o29: P? = none
  r29 = chain(<o29)
  if ?r29 as w30
    look(?w30.a)
    look(?w30.b)

sub main
  h0()
  h1() catch |e| print("caught", e)
  h2() catch |e| print("caught", e)
