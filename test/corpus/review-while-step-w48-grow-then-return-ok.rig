# Valid: the body grows `v` only on a path that returns, which never
# reaches the step.
#
# oracle: mk accept
# oracle: run accept
# oracle: main accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

fun run() -> Int
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  while mk(?v, i) as h: k += h.s[0]
    i += 1
    if i == 3
      !v.push(2)
      return k + v.len
  k

sub main
  print(run())

# expect: 4
