obj unique
  n: Int

pub obj S unique # comment
  unique: Int

  fun get(?self) -> Int
    self.unique

obj W[T] unique
  item: T

obj Z
  unique: Bool

sub main()
  u = unique(n: 1)
  s = S(unique: 2)
  w = W(item: 3)
  v = <w
  z = Z(unique: true)
  print(u.n, s.get(), v.item, z.unique)
  t = <s
  print(t.unique)
  x = w
