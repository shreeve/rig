obj Bx
  c: Cell[Int]
  v: List[Int]

obj View
  b: ?Bx

sub stash(h: *Cell[*sub()])
  x = Bx(c: Cell(0), v: List())
  !x.v.push(42)
  vw = View(b: ?x)
  !h.set(*|<vw| print("read after free:", vw.b.v[0]))

sub main()
  a: *Cell[*sub()] = *Cell(*|| print("init"))
  stash(+a)
  f = (!a).replace(*|| print("z"))
  f()
