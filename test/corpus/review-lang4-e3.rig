struct R
  id: Int

  drop(!self)
    errdefer print("x")

fun f() -> Int!
  defer
    errdefer print("y")
  g = |x: Int|
    errdefer print("z")
    x
  _ = g(1)
  1

fun h() -> Int?
  errdefer print("w")
  none

sub main()
  :a defer print("q")
  :b x = 1
  :c :d while true
    break :c
  print(f() catch 0, h(), x)
  r = R(id: 1)
