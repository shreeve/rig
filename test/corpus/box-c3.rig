enum Expr
  num(n: Int)
  add(l: ^Expr, r: ^Expr)
  mul(l: ^Expr, r: ^Expr)

fun eval(e: ?Expr) -> Int
  match e
    .num(n) => n
    .add(l, r) => eval(?l) + eval(?r)
    .mul(l, r) => eval(?l) * eval(?r)

fun num(n: Int) -> ^Expr
  ^.num(n)

sub main()
  e = Expr.add(l: num(2), r: ^Expr.mul(l: num(3), r: num(4)))
  print(eval(?e))
  print(e)
