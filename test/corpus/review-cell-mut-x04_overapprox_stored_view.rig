# A generic struct's stored `?T` field at an instance whose sema and
# runtime interior-mutability disagree.
obj C
  c: Cell[Int]

obj G[T]
  h: *T
  k: Int

obj R[T]
  r: ?T

fun look(g: ?G[C]) -> Int
  !g.h.c.set(g.h.c.get() + 1)
  g.h.c.get() + g.k

sub main()
  g = G(h: *C(c: Cell(1)), k: 10)
  r = R(r: ?g)
  print(look(r.r))

# expect:
# 12

# oracle: main accept
