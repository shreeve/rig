struct Tok
  kind: Int
  start: Int
  len: Int

struct Parser
  src: String
  toks: []Tok
  pos: Int

  fun text(?self, t: ?Tok) -> String
    self.src[t.start..t.start + t.len]

sub main
  src = Text("let x")
  toks = [Tok(kind: 1, start: 0, len: 3), Tok(kind: 2, start: 4, len: 1)]
  p = Parser(src: ?src, toks: ?toks, pos: 0)
  name = p.text(?toks[1])
  p.pos = 1
  toks[0].kind = 9
  print(name, toks[0].kind)
