obj P
  n: Int

sub sort[T](xs: !List[T], less: ?fun(?T, ?T) -> Bool)
  i = 1
  while i < xs.len : i += 1
    j = i
    while j > 0 and less(?xs[j], ?xs[j - 1]) : j -= 1
      xs.swap(j, j - 1)

sub main()
  v: List[*P] = List()
  !v.push(*P(n: 3))
  !v.push(*P(n: 1))
  sort(!v, |a, b| a.n < b.n)
  for p in ?v
    print(p.n)
