obj A
  xs: [3]Int

obj Name
  s: ?String

obj Sl
  items: List[?String]

enum Kind
  one
  two

obj K
  k: Kind

sub main()
  a = A([1, 2, 3])
  b = A([3 of 0])
  n = Name("bob")
  bb = ^^1
  bc = ^^2
  k = K(.two)
  kk = ^K(.one)
  print(a, b, n, bb, bc, k, kk)
  print(Name("x").s, A([4, 5, 6]).xs[1])
