# A generic enum whose variants carry nothing has neither `.text` nor
# `from_text`: rejected, with a reason that names the generic enum, not
# payloads it does not have. (`Int(t)` still names payloads.)
enum Tag[T]
  a
  b

sub main()
  t: Tag[Int] = .a
  print(t.text)
  print(Tag[Int].from_text("a"))
  print(Int(t))
