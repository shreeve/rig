# argument (`owned`, not walked by B3): a plain made value implicitly
# lent to a `?Q` parameter in a hoisted call is `&mkq()`, the address of
# a Zig rvalue in the call's block; the result views it after the block.
struct Q
  xs: [4]Int
  n: Int

fun g(k: Int) -> Int
  k

fun mkq(k: Int) -> Q
  Q(xs: [k, k, k, k], n: k)

fun pick(q: ?Q, n: Int) -> ?Q
  q

sub main
  print(pick(n: g(1), q: mkq(5)).xs[3], pick(n: g(1), q: ?mkq(6)).xs[3])
