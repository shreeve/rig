# UNSOUND on main: the defer re-points `r` at `keep`. The `!` exit
# runs it and keeps its effect on the path that goes on, so there `r`
# seems to borrow only `keep`, `x` can be dropped, and `r` reads it.
error E
  bad

fun maybe(ok: Bool) -> Int!
  return E.bad if not ok
  1

fun f(ok: Bool) -> Int!
  keep: Vec[Int] = Vec()
  !keep.push(1)
  x: Vec[Int] = Vec()
  !x.push(41)
  r = ?x
  defer r = ?keep
  k = maybe(ok)!
  -x
  print(r[0] + k)
  k

sub main
  print(f(true) catch 0)
