obj Res
  n: Int
  t: String

enum E
  a(r: Res)
  b

fun getw(e: !E) -> !E
  e

sub f(a: !E, b: !E, c: Bool)
  match (a if c else b)
    .a(r) => r.n = 44
    .b => pass
  print(a, b)

sub main()
  e = E.a(r: Res(n: 1, t: String("x")))
  d = E.a(r: Res(n: 2, t: String("y")))
  f(!e, !d, true)
  print(e)
