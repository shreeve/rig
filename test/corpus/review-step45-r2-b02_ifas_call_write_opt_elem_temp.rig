# if getw(!v, ?Text("a")) as t over an element view returned by a call (temp argument); grow t
fun getw(v: !List[Text?], s: String) -> !Text?
  !v[s.len - 1]

sub main()
  v: List[Text?] = List()
  !v.push(Text("q"))
  if getw(!v, ?Text("a")) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(v)
