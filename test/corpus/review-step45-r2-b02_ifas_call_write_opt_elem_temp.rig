# if getw(!v, ?Text("a")) as t over an element view returned by a call (temp argument); grow t
fun getw(v: !List[String?], s: ?String) -> !String?
  !v[s.len - 1]

sub main()
  v: List[String?] = List()
  !v.push(String("q"))
  if getw(!v, ?String("a")) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(v)
