# A binary search tree of Ints with owned children.

obj Node
  key: Int
  left: ^Node?
  right: ^Node?

  sub insert(!self, key: Int)
    if key < self.key
      if !self.left as l
        !l.insert(key)
      else
        self.left = ^Node(key: key, left: none, right: none)
    else
      if !self.right as r
        !r.insert(key)
      else
        self.right = ^Node(key: key, left: none, right: none)

  sub walk(?self, visit: ?sub(Int))
    if ?self.left as l
      l.walk(visit)
    visit(self.key)
    if ?self.right as r
      r.walk(visit)

obj Tree
  root: ^Node?
  size: Int

  sub insert(!self, key: Int)
    if !self.root as n
      !n.insert(key)
    else
      self.root = ^Node(key: key, left: none, right: none)
    self.size += 1

  sub each(?self, visit: ?sub(Int))
    if ?self.root as n
      n.walk(visit)

  fun sorted(?self) -> List[Int]
    out: List[Int] = List()
    self.each(|!out, k| !out.push(k))
    out

sub main()
  t = Tree(root: none, size: 0)
  for k in [50, 30, 70, 20, 40, 60, 80, 35]
    !t.insert(k)
  t.each(|k| print(k))
  keys = t.sorted()
  print(keys, t.size)

sub unused_helper()
  print(1)
