obj Val
  n: Int
  drop(!self)
    print("drop", self.n)

obj Slot
  v: Val?

obj Map
  slots: List[^Slot]
  one: Val?

  fun first(?self) -> ?Val?
    ?self.one

  fun val(?self) -> (?Val)?
    if ?self.one as v
      return v
    none

sub main()
  m = Map(slots: List(), one: Val(n: 3))
  if m.first() as v
    print(v.n)
  if m.val() as v
    print(v.n)
