# B3: a call-held view used as an operand of `??`, `catch`, `!`, as an
# argument to another call (generic and not), and as a receiver. Each of
# the 6 statements should be reported.
error Bad
  no

struct Q
  c: Cell[Int]
  n: Int

  fun me(?self, j: Int, k: Int) -> ?Q
    self

  fun mo(?self, j: Int, k: Int) -> (?Q)?
    self

  fun mf(?self, j: Int, k: Int) -> (?Q)!
    self

  fun get(?self) -> Int
    self.n

struct H
  q: Q

fun mkh(k: Int) -> H
  H(q: Q(c: Cell(1), n: k))

fun g(k: Int) -> Int
  k

fun id[T](x: ?T) -> ?T from x
  x

fun nn(q: ?Q) -> Int
  q.n

fun run(d: ?Q) -> Int!
  a = mkh(1).q.mo(k: g(1), j: g(2)) ?? d
  b = mkh(2).q.mf(k: g(1), j: g(2)) catch d
  c = mkh(3).q.mf(k: g(1), j: g(2))!
  e = id(mkh(4).q.me(k: g(1), j: g(2)))
  f = nn(mkh(5).q.me(k: g(1), j: g(2)))
  h = mkh(6).q.me(k: g(1), j: g(2)).get()
  a.n + b.n + c.n + e.n + f + h

sub main()
  d = Q(c: Cell(0), n: 0)
  print(run(?d) catch -1)
