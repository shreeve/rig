error Bad
  oops

struct P
  x: Int

struct Q
  p: P
  n: Int


fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r

fun two(r: ?P, s: ?P, ok: Bool) -> (?P)!
  get(r, ok) catch s

sub main
  a = P(x: 1)
  b = P(x: 2)
  v = two(?a, ?b, true)!
  u = two(?a, ?b, false)!
  print(v.x, u.x)
