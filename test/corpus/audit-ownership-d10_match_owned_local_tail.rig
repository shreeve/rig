struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

fun pick(k: Int) -> *Tok?
  s: Slot = .pair(a: *Tok(n: k), b: *Tok(n: 2))
  match s
    .pair(a, b) => b
    _ => none

sub main()
  if pick(1) as t
    print("got", t.n)
  print("end")
