# Review probe h07_store_via_view_recv_bang.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.keep accept
# oracle: H.drop accept
# oracle: mk accept
# oracle: wrap accept
# oracle: main reject C5
obj S
  n: Int
  t: String

  drop(!self)
    print("dropS", self.n)

obj H
  rs: List[?String]

  sub keep(!self, r: ?String) keeps r
    !self.rs.push(r)

  drop(!self)
    print("dropH sees", self.rs)

fun mk(n: Int) -> S
  S(n: n, t: String("hello world, long enough to be on the heap"))

fun wrap(h: !H) -> !H
  h

sub main()
  h = H(rs: List())
  if true
    s = mk(1)
    !wrap(!h).keep(?s.t)
  print("end")
