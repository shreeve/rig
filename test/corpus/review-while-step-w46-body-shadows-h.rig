# The body shadows `h` with `new h`, viewing a body-local List; the step's
# `h` must be the condition's binding.
#
# oracle: mk accept
# oracle: main accept
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  while mk(?v, i) as h: k += h.s[0]
    local: List[Int] = List()
    !local.push(100)
    new h = S(s: ?local[..])
    k += h.s[0]
    i += 1
  print(k)

# expect: 303
