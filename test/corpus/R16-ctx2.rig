struct Res
  id: Int

  drop(!self)
    print("drop", self.id)

fun val(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

sub main
  x = 5
  c = Res(id: 9)
  y = val(|<c, a| a + c.id, x) if x < 3 else 0
  print(y)
  d = Res(id: 8)
  z = (x > 3) and val(|<d, a| a + d.id, x) > 0
  print(z)
  e = Res(id: 7)
  i = 0
  while i < 2
    i += 1
  q = 0
  for j in 0..2
    q = val(|+j, a| a + j, q)
  print(q)
