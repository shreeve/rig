struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

struct W
  e: E
  o: E?
  v: Vec[Int]

fun mkw(n: Int) -> W
  v: Vec[Int] = Vec()
  for i in 0..n
    !v.push(i + 1)
  W(e: mk(n), o: mk(n + 10), v: <v)

struct A3
  o: Int

sub f(a: !Vec[A3], b: !Vec[A3], c: Bool)
  w = !(a if c else b)[0].o
  for _ in 0..100
    !a.push(A3(o: 1))
  w = 7

sub main()
  x: Vec[A3] = Vec()
  !x.push(A3(o: 1))
  y: Vec[A3] = Vec()
  !y.push(A3(o: 1))
  f(!x, !y, true)
  print(x[0].o)
