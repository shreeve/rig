use lib

type LW = lib.IW
type LPP = lib.PP
type Chain = LPP

sub main()
  w = lib.IW(v: 3)
  p = lib.PP(x: 1, v: List())
  q = LPP(x: 2, v: List())
  r = Chain(x: 3, v: List())
  a = lib.AA(x: 4, v: List())
  v = lib.IV()
  l = LW(v: 9)
  b = lib.Byte(300 - 100)
  bx = lib.BS(lib.P(x: 5, v: List()))
  print(w.v, p.x, q.x, r.x, a.x, v.len, l.v, b, lib.Byte.max)
