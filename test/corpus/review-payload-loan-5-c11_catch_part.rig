struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

struct G
  e: E

fun tg(g: !G, ok: Bool) -> (!G)!
  return Bad.nope if not ok
  g

sub f(a: !G, b: !G)
  match (tg(!a, false) catch |_| b).e
    .a(r0)
      s = ?r0.v[..]
      b.e = mk(5)
      print(s[0])
    .b => pass

sub main()
  x = G(e: mk(1))
  y = G(e: mk(2))
  f(!x, !y)
