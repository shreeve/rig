struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

struct P
  a: *Tok
  n: Int

fun get(k: Int) -> Int?
  k if k > 0 else none

fun run(k: Int) -> Int?
  p = P(a: *Tok(n: 1), n: get(k)?)
  p.n

sub main()
  print(run(0))
  print(run(2))
