obj H
  s: ?String
  t: ?String

  sub keep(!self, v: ?String) keeps v
    self.t = v

sub set(w: (!H)?, g: (!H)?) keeps w
  x = <w ?? return
  !x.keep(x.s)
  y = <g ?? return
  !y.keep(x.s)
  y.s = x.t

sub main()
  a = String("a")
  b = String("b")
  h = H(s: ?a, t: "")
  k = H(s: ?b, t: "")
  set(!h, !k)
  print(h.s, h.t, k.s, k.t)
