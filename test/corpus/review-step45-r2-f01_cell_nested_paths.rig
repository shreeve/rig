# H2: Cell set/replace through nested List/array/Box/field paths under read views
obj C
  c: Cell[Int]

  sub hit(!self)
    !self.c.set(self.c.get() + 1)

obj S
  cs: List[C]
  arr: [2]C
  b: ^C

sub viaVecVec(v: !List[List[C]])
  !v[0][0].c.set(11)
  !v[0][0].hit()

sub viaArrVec(a: ![1]List[C])
  !a[0][0].c.set(21)

sub viaVecBox(v: !List[^C])
  !v[0].c.set(31)
  _ = !v[0].c.replace(32)

sub viaStruct(s: !S)
  !s.cs[0].c.set(41)
  !s.arr[1].c.set(42)
  !s.b.c.set(43)

sub viaSlice(s: []List[C])
  !s[0][0].c.set(61)

sub viaVecCells(v: !List[List[Cell[Int]]])
  !v[0][0].set(71)

sub main()
  vv: List[List[C]] = List()
  inner: List[C] = List()
  !inner.push(C(c: Cell(0)))
  !vv.push(<inner)
  viaVecVec(!vv)
  av = [List[C]()]
  !av[0].push(C(c: Cell(0)))
  viaArrVec(!av)
  vb: List[^C] = List()
  !vb.push(^C(c: Cell(0)))
  viaVecBox(!vb)
  cs: List[C] = List()
  !cs.push(C(c: Cell(0)))
  s = S(cs: <cs, arr: [C(c: Cell(0)), C(c: Cell(0))], b: ^C(c: Cell(0)))
  viaStruct(?s)
  viaSlice(?vv)
  vc: List[List[Cell[Int]]] = List()
  ic: List[Cell[Int]] = List()
  !ic.push(Cell(0))
  !vc.push(<ic)
  viaVecCells(!vc)
  print(vv[0][0].c.get(), av[0][0].c.get(), vb[0].c.get(), s.cs[0].c.get(), s.arr[1].c.get(), s.b.c.get(), vc[0][0].get())
