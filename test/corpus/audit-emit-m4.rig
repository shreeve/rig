obj N
  n: Int

obj HasH
  h: *N

obj HasB
  b: ^Int

sub main()
  a: List[Int] = List(capacity: 8)
  b: List[Int] = List()
  !a.push(1)
  !b.push(1)
  x = ^1
  y = ^1
  p = HasH(h: *N(n: 1))
  q = HasH(h: *N(n: 1))
  print(p == q)
  s = *N(n: 1)
  t = *N(n: 1)
  print(s == t)
  hb = HasB(b: ^2)
  hc = HasB(b: ^2)
  print(hb == hc)
