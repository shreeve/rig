obj Res
  n: Int
  t: String

  drop(!self)
    print("drop", self.n)

enum E
  a(r: Res, s: Res)
  b

sub eat(r: Res)
  print("eat", r.n)

sub main()
  e = E.a(r: Res(n: 1, t: String("x")), s: Res(n: 2, t: String("y")))
  match <e
    .a(r, s) if r.n > 5 => eat(<r)
    .a(r, _) => eat(<r)
    .b => pass
  print("end")
