# A for header over elements a view of a Cell-holding temporary reaches.
#
# oracle: items accept
obj D
  c: Cell[Int]
  xs: List[Int]

fun mkd(n: Int) -> D
  v: List[Int] = List()
  !v.push(n)
  D(c: Cell(n), xs: v)

fun items(p: !D) -> ?List[Int]
  !p.c.set(9)
  ?p.xs

sub main()
  for x in items(?mkd(1))
    print(x)
