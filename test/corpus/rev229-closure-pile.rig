    w(i + 170) + w(i + 171) + w(i + 172) + w(i + 173) + w(i + 174) + w(i + 175) + w(i + 176) + w(i + 177) + w(i + 178) + w(i + 179) + \
    w(i + 180) + w(i + 181) + w(i + 182) + w(i + 183) + w(i + 184) + w(i + 185) + w(i + 186) + w(i + 187) + w(i + 188) + w(i + 189) + \
    w(i + 190) + w(i + 191) + w(i + 192) + w(i + 193) + w(i + 194) + w(i + 195) + w(i + 196) + w(i + 197) + w(i + 198) + w(i + 199) + \
