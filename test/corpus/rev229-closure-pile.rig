    w(i + 70) + w(i + 71) + w(i + 72) + w(i + 73) + w(i + 74) + w(i + 75) + w(i + 76) + w(i + 77) + w(i + 78) + w(i + 79) + \
    w(i + 80) + w(i + 81) + w(i + 82) + w(i + 83) + w(i + 84) + w(i + 85) + w(i + 86) + w(i + 87) + w(i + 88) + w(i + 89) + \
    w(i + 90) + w(i + 91) + w(i + 92) + w(i + 93) + w(i + 94) + w(i + 95) + w(i + 96) + w(i + 97) + w(i + 98) + w(i + 99) + \
    w(i + 100) + w(i + 101) + w(i + 102) + w(i + 103) + w(i + 104) + w(i + 105) + w(i + 106) + w(i + 107) + w(i + 108) + w(i + 109) + \
    w(i + 110) + w(i + 111) + w(i + 112) + w(i + 113) + w(i + 114) + w(i + 115) + w(i + 116) + w(i + 117) + w(i + 118) + w(i + 119) + \
    w(i + 120) + w(i + 121) + w(i + 122) + w(i + 123) + w(i + 124) + w(i + 125) + w(i + 126) + w(i + 127) + w(i + 128) + w(i + 129) + \
    w(i + 130) + w(i + 131) + w(i + 132) + w(i + 133) + w(i + 134) + w(i + 135) + w(i + 136) + w(i + 137) + w(i + 138) + w(i + 139) + \
    w(i + 140) + w(i + 141) + w(i + 142) + w(i + 143) + w(i + 144) + w(i + 145) + w(i + 146) + w(i + 147) + w(i + 148) + w(i + 149) + \
