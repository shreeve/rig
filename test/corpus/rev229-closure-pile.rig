# A closure that calls a 56 KB helper the rule inlines 300 times is a
# frame of its own, whose account holds what is inlined into it.
fun w(i: Int) -> Int
  t = [7000 of 0]
  for k in 0..7000
    t[k] = k + i
  t[i % 7000]

fun near(i: Int) -> Int
  f = |+i|
    w(i + 0) + w(i + 1) + w(i + 2) + w(i + 3) + w(i + 4) + w(i + 5) + w(i + 6) + w(i + 7) + w(i + 8) + w(i + 9) + \
    w(i + 10) + w(i + 11) + w(i + 12) + w(i + 13) + w(i + 14) + w(i + 15) + w(i + 16) + w(i + 17) + w(i + 18) + w(i + 19) + \
    w(i + 20) + w(i + 21) + w(i + 22) + w(i + 23) + w(i + 24) + w(i + 25) + w(i + 26) + w(i + 27) + w(i + 28) + w(i + 29) + \
