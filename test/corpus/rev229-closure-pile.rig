    w(i + 230) + w(i + 231) + w(i + 232) + w(i + 233) + w(i + 234) + w(i + 235) + w(i + 236) + w(i + 237) + w(i + 238) + w(i + 239) + \
    w(i + 240) + w(i + 241) + w(i + 242) + w(i + 243) + w(i + 244) + w(i + 245) + w(i + 246) + w(i + 247) + w(i + 248) + w(i + 249) + \
    w(i + 250) + w(i + 251) + w(i + 252) + w(i + 253) + w(i + 254) + w(i + 255) + w(i + 256) + w(i + 257) + w(i + 258) + w(i + 259) + \
    w(i + 260) + w(i + 261) + w(i + 262) + w(i + 263) + w(i + 264) + w(i + 265) + w(i + 266) + w(i + 267) + w(i + 268) + w(i + 269) + \
    w(i + 270) + w(i + 271) + w(i + 272) + w(i + 273) + w(i + 274) + w(i + 275) + w(i + 276) + w(i + 277) + w(i + 278) + w(i + 279) + \
    w(i + 280) + w(i + 281) + w(i + 282) + w(i + 283) + w(i + 284) + w(i + 285) + w(i + 286) + w(i + 287) + w(i + 288) + w(i + 289) + \
    w(i + 290) + w(i + 291) + w(i + 292) + w(i + 293) + w(i + 294) + w(i + 295) + w(i + 296) + w(i + 297) + w(i + 298) + w(i + 299)
  f()

sub main()
  print(near(1))
