fun rt_bool(b: Bool) -> Bool
  b

fun rt_int(n: Int) -> Int
  n

fun gid[T](a: T) -> T
  a

fun gmax[T](a: T, b: T) -> T
  a if a > b else b

fun gsome[T](a: T) -> T?
  a

fun id_u8(x: U8) -> U8
  x

fun id_i8(x: I8) -> I8
  x

fun id_i16(x: I16) -> I16
  x

fun id_u16(x: U16) -> U16
  x

fun id_i32(x: I32) -> I32
  x

fun id_u32(x: U32) -> U32
  x

fun id_int(x: Int) -> Int
  x

fun id_u64(x: U64) -> U64
  x

fun id_i128(x: I128) -> I128
  x

fun id_u128(x: U128) -> U128
  x

fun id_float(x: Float) -> Float
  x

fun id_f32(x: F32) -> F32
  x

fun fal2314(ok: Bool) -> F32!
  return Err2314.bad if not ok
  (-1.5)

error Err2314
  bad

struct GP2314[T]
  f: T

sub t2314
  gp2314: GP2314[F32] = GP2314(f: (fal2314(true) catch 10.25))
  print(gp2314.f)

sub main
  t2314()
