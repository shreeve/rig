struct Q
  n: Int

  sub bump(!self)
    self.n += 1

struct P
  x: Int
  a: [2]Int
  q: Q
  v: Vec[Int]

fun mk() -> P
  P(x: 1, a: [1, 2], q: Q(n: 1), v: Vec())

fun go() -> Int?
  os: [2]P? = [mk(), none]
  ((!os[0])?).x = 9
  ((!os)[0]?).x = 8
  z = os[0] ?? mk()
  print(z.x)
  1

sub main()
  print(go() ?? 0)
