# A view of a part (a field, an element) of a branching receiver keeps a
# loan on every name a leaf names: writing to one while the view lives
# is rejected (C4), as it is for a view of the whole receiver. A leaf
# that makes a value is read where it is too, a temporary of the
# statement: a view of it held past the statement is rejected (C5),
# whichever branch made it.
#
# oracle: field_write reject C4
# oracle: elem_write reject C4
# oracle: nested_write reject C4
# oracle: made_part reject C5
# oracle: made_whole reject C5
# oracle: made_fallback reject C5

struct S
  t: Text
  xs: [4]Int

  fun inner(?self) -> ?Text
    ?self.t

struct W
  s: S

struct P
  xs: [4]Int

  fun arr(?self) -> ?[4]Int
    ?self.xs

fun mk(n: Int) -> W
  W(s: S(t: Text("a text long enough to live on the heap:", n), xs: [n, n, n, n]))

fun maybe(n: Int) -> W?
  return mk(n) if n > 0 else none

sub field_write(c: Bool)
  wa = mk(1)
  wb = mk(2)
  z = (wa if c else wb).s.inner()
  wa = mk(3)
  print(z)

sub elem_write(c: Bool)
  vs: Vec[P] = Vec()
  !vs.push(P(xs: [1, 1, 1, 1]))
  ws: Vec[P] = Vec()
  !ws.push(P(xs: [2, 2, 2, 2]))
  y = (vs if c else ws)[0].arr()
  !vs.push(P(xs: [3, 3, 3, 3]))
  print(y)

sub nested_write(c: Bool, d: Bool)
  wa = mk(1)
  wb = mk(2)
  wc = mk(3)
  z = (wa if c else (wb if d else wc)).s.inner()
  wc = mk(4)
  print(z)

sub made_part(c: Bool)
  a = mk(1)
  z = (a if c else mk(2)).s.inner()
  print(z)

sub made_whole(c: Bool)
  a = mk(1)
  z = (a.s if c else mk(2).s).inner()
  print(z)

sub made_fallback()
  a = mk(1)
  z = (maybe(1) ?? a).s.inner()
  print(z)

sub main()
  field_write(true)
  elem_write(true)
  nested_write(false, false)
  made_part(false)
  made_whole(false)
  made_fallback()
