# 2d47a2db: write match on List element (no temp); arm pushes then writes payload. Expect reject.
enum E
  a(t: String)
  b(n: Int)

sub main()
  v: List[E] = List()
  !v.push(E.a(t: String("q")))
  i = 0
  match !v[i]
    .a(t)
      for _ in 0..64
        !v.push(E.b(n: 5))
      !t.add("x")
    .b(n) => n += 1
  print(v.len)
