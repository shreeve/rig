struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub main()
  s: Slot = .full(t: *Tok(n: 1))
  match <s
    .full(t) if cond(<t) => print("a")
    .full(t) => eat(<t)
    _ => print("other")
