error Bad
  oops

struct P
  x: Int

struct Q
  p: P
  n: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r


sub main
  a = P(x: 1)
  b = P(x: 2)
  f: fun(?P, Bool) -> (?P)! = |r, ok|
    return Bad.oops if not ok
    r
  v = f(?a, true) catch ?b
  u = f(?a, false) catch ?b
  print(v.x, u.x)
