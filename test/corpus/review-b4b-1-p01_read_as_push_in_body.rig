# read `if … as` over a Vec element through a temporary index; body
# grows the Vec and then uses the binding (dangling). Expect reject.
fun idx(s: ?Text) -> Int
  s.len - 1

sub main()
  v: Vec[Text?] = Vec()
  !v.push(Text("a"))
  if v[idx(?Text("a"))] as t
    for _ in 0..64
      !v.push(Text("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"))
    print(t)
