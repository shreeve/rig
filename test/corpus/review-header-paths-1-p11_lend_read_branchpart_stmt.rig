obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

obj W
  e: E
  o: E?
  v: List[Int]

fun mkw(n: Int) -> W
  v: List[Int] = List()
  for i in 0..n
    !v.push(i + 1)
  W(e: mk(n), o: mk(n + 10), v: <v)

sub f(a: !List[W], b: !List[W], c: Bool)
  r = ?(a if c else b)[0].v
  for _ in 0..100
    !a.push(mkw(1))
  print(r.len)

sub main()
  x: List[W] = List()
  !x.push(mkw(3))
  y: List[W] = List()
  !y.push(mkw(1))
  f(!x, !y, true)
