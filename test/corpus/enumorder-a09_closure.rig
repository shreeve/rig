# A closure captures a plain enum and orders by it.
use std.sort

enum Size
  large = 30
  small = 10
  medium = 20

fun count(xs: []Size, keep: ?fun(Size) -> Bool) -> Int
  n = 0
  for x in xs
    if keep(x)
      n += 1
  n

sub main()
  floor = Size.medium
  xs = [Size.large, Size.small, Size.medium, Size.small]
  print(count(?xs, |x| x >= floor), count(?xs, |x| .small < x))
  ys = [Size.large, Size.small, Size.medium]
  sort.sort_by(!ys, |a, b| a < b)
  print(ys)
