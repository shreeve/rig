# nested pointing headers: the inner subject is reached from the outer binding with its own temp index. Expect clean, correct.
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  vv: List[[2]String?] = List()
  !vv.push([String("a"), String("b")])
  for row in !vv[idx(?String("a"))..1]
    if !row[idx(?String("ab"))] as t
      !t.add("x")
  if !vv[idx(?String("a"))][idx(?String("a"))] as t
    !t.add("y")
    if !vv[0][idx(?String("ab"))] as u
      !u.add("z")
  print(vv)
