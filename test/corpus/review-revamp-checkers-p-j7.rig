obj Res
  id: Int
  v: List[Int]

obj H
  r: ?Res

fun store(h: !H, r: ?Res) -> Bool keeps r
  h.r = r
  false

sub main()
  z = Res(id: 0, v: List())
  h = H(r: ?z)
  for i in 1..3
    print(h.r.id)
    y = Res(id: i, v: List())
    match i
      k if store(!h, ?y) => return
      _ => print("no")
