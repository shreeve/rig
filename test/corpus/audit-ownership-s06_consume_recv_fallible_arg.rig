struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

struct R
  t: *Tok

  sub done(<self, n: Int)
    print("done", self.t.n, n)

fun run(k: Int) -> Int!
  r = R(t: *Tok(n: 1))
  <r.done(fail(k)!)
  0

sub main()
  print(run(1) catch -1)
  print(run(0) catch -1)
