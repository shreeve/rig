# `catch` with a named fallback, the made payload taken (no drop): changed through a pointer to a temporary.
# Each branching kind with a named leaf and a constant made leaf of a type
# with no drop, changed by a Cell method or a `?self` method.
#
# oracle: C.hit accept
# oracle: main accept
struct C
  c: Cell[Int]

  sub hit(!self)
    !self.c.set(self.c.get() + 1)

struct W
  inner: C

error E
  bad

fun mkf(n: Int) -> C!
  return E.bad if n < 0
  C(c: Cell(n))

sub run(k: Bool)
  a = C(c: Cell(1))
  o: C? = none
  w = W(inner: C(c: Cell(1)))
  (mkf(5) catch a).hit()
  (mkf(5) catch a).c.set(9)
  print(a.c.get())
  (mkf(-1) catch a).hit()
  print(a.c.get())

sub main()
  run(true)

# expect:
# 1
# 2
