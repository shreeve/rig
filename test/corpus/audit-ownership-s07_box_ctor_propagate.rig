obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

obj Node
  a: *Tok
  next: ^Node?

fun get(k: Int) -> Int?
  k if k > 0 else none

fun run(k: Int) -> Int?
  x: ^Node? = ^Node(a: *Tok(n: 5), next: none)
  b = ^Node(a: *Tok(n: get(k)?), next: <x)
  b.a.n

sub main()
  print(run(0))
  print(run(3))
