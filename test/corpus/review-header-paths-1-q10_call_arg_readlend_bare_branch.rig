struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

struct Q
  e: E
  o: E?
  v: Vec[Int]

struct W
  e: E
  o: E?
  v: Vec[Int]
  q: Q?

  fun ge(?self) -> ?E
    ?self.e

  fun gv(?self) -> ?Vec[Int]
    ?self.v

  fun go(?self) -> ?(E?)
    ?self.o

  fun gew(!self) -> !E
    !self.e

  fun gvw(!self) -> !Vec[Int]
    !self.v

struct H
  w: !W

fun mkv(n: Int) -> Vec[Int]
  v: Vec[Int] = Vec()
  for i in 0..n
    !v.push(i + 1)
  v

fun mkw(n: Int) -> W
  W(e: mk(n), o: mk(n + 10), v: mkv(n), q: Q(e: mk(n + 20), o: mk(n + 30), v: mkv(n)))

fun id[T](x: T) -> T
  x

fun first(v: ?Vec[Int]) -> []Int
  ?v[..1]

fun f(a: !Vec[Int], b: !Vec[Int], c: Bool) -> Int?
  s = first(?(a if c else b))
  for _ in 0..100
    !a.push(1)
  print(s[0])
  1

sub main()
  x = mkv(3)
  y = mkv(3)
  _ = f(!x, !y, true)
