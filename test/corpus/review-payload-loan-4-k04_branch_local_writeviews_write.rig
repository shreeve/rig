struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

sub main()
  e = mk(1)
  d = mk(2)
  a = !e
  b = !d
  c = true
  match (a if c else b)
    .a(r) => !r.v.push(5)
    .b => pass
  match !a
    .a(r) => !r.v.push(6)
    .b => pass
  print(e, d)
