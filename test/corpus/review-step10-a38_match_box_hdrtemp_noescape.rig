# a37 without any escape: a guarded `match ?bs[idx(?String("a"))]` on an
# element of an array of ^E. The subject once was copied into a
# `__rig_subject_N` typed `rig.Box(E)` and assigned the boxed `E`, which
# Zig rejected; the guarded match now holds the boxed value's address.
enum E
  a(xs: [4]Int)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  bs = [^E.a(xs: [7, 7, 7, 7]), ^E.b]
  k = 3
  match ?bs[idx(?String("a"))]
    .a(xs) if k > 2 => print(xs[0])
    _ => print(0)
  v: List[^E] = List()
  !v.push(^E.a(xs: [8, 8, 8, 8]))
  match ?v[idx(?String("a"))]
    .a(xs) if k > 2 => print(xs[0])
    _ => print(0)
