# `continue @outer` from an inner `while`, with the outer label kept by
# a `break @outer`: the checker sends the continue through the step,
# which re-fills `a`; does emit run the step, or skip it and move `a`
# a second time? (A direct `continue` keeps the body block label used.)
#
# oracle: mk accept
# oracle: fresh accept
# oracle: take accept
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

fun fresh(n: Int) -> List[Int]
  a: List[Int] = List()
  !a.push(n)
  a

fun take(a: List[Int]) -> Int
  a[0]

sub main()
  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  @outer while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    continue if i > 200
    j = 0
    while j < 3: j += 1
      break @outer if i > 100
      continue @outer if j == 2
  print(k, i)

# expect: 21 5
