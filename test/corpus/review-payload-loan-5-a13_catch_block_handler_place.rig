obj Res
  n: Int
  v: List[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

fun mk(n: Int) -> E
  v: List[Int] = List()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

fun getw(e: !E) -> !E
  e

fun tryw(e: !E, ok: Bool) -> (!E)!
  return Bad.nope if not ok
  e

fun optw(e: !E, ok: Bool) -> (!E)?
  return none if not ok
  e

fun id[T](x: T) -> T
  x

obj H
  w: !E

sub f(x: !E, h: ?H)
  match (tryw(!x, false) catch |_| h.w)
    .a(r) => r.n = 77
    .b => pass

sub main()
  e = mk(1)
  d = mk(2)
  h = H(w: !d)
  f(!e, ?h)
  print(d)
