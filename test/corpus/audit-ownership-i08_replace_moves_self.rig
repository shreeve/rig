struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct P
  a: *Tok?

sub main()
  p = P(a: *Tok(n: 1))
  old = replace(!p.a, none)
  print(old == none, p.a == none)
