obj B
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(b: *B)
  empty

sub keep(b: *B)
  print("kept", b.n)

sub main()
  v: List[Slot] = List()
  !v.push(.full(b: *B(n: 1)))
  match <v[0]
    .full(b) => keep(<b)
    .empty => print("e")
  bx = ^Slot.full(b: *B(n: 2))
  match <bx
    .full(b) => keep(<b)
    .empty => print("e")
  print("mid")
