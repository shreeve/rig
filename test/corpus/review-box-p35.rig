struct R
  n: Int

  drop(!self)
    print("drop", self.n)

enum E
  empty
  full(b: Box[R])

sub eat(b: Box[R])
  print("eat", b.n)

sub main()
  e = E.full(b: Box(value: R(n: 1)))
  match ?e
    .empty => print("empty")
    .full(b) => print(b.n)
  match !e
    .empty => print("empty")
    .full(b) => b.n = 5
  print(e)
