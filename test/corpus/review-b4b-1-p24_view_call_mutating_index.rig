# view-returning call base, index mutates the owner. Expect reject.
enum E
  a(t: String)
  b

obj H
  es: List[E]

fun get(h: !H) -> !H from h
  h

fun grow(h: !H, s: ?String) -> Int
  for _ in 0..64
    !h.es.push(E.b)
  s.len - 1

sub main()
  h = H(es: List())
  !h.es.push(E.a(t: String("x")))
  match !get(!h).es[grow(!h, ?String("a"))]
    .a(t) => !t.add("y")
    .b => pass
  print(h.es[0])
