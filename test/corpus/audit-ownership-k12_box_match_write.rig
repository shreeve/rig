obj Node
  key: Int
  left: ^Node?
  right: ^Node?

  drop(!self)
    print("drop", self.key)

sub insert(slot: !^Node?, key: Int)
  if !slot as n
    if key < n.key
      insert(!n.left, key)
    else
      insert(!n.right, key)
  else
    slot = ^Node(key: key, left: none, right: none)

sub walk(slot: ?^Node?)
  if slot as n
    walk(?n.left)
    print(n.key)
    walk(?n.right)

enum Tree
  leaf(v: Int)
  node(l: ^Tree, r: ^Tree)

fun sum(t: ?Tree) -> Int
  match t
    .leaf(v) => v
    .node(l, r) => sum(?l) + sum(?r)

sub bump(t: !Tree)
  match !t
    .leaf(v) => v += 1
    .node(l, r)
      bump(!l)
      bump(!r)

sub main()
  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.node(l: ^Tree.leaf(v: 2), r: ^Tree.leaf(v: 3)))
  bump(!t)
  print(sum(?t))
