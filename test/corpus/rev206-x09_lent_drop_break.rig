obj Cur
  xs: ?List[Int]
  i: Int

  fun next(!self) -> Int?
    return none if self.i >= self.xs.len
    self.i += 1
    self.xs[self.i - 1]

fun mk(v: ?List[Int]) -> Cur from v
  Cur(xs: v, i: 0)

obj Bag
  xs: List[Int]

  fun each(?self) -> Cur from self
    Cur(xs: ?self.xs, i: 0)

sub fill(v: !List[Int])
  for _ in 0..3
    !v.push(1)

obj DCur
  xs: ?List[Int]
  i: Int

  fun next(!self) -> Int?
    return none if self.i >= self.xs.len
    self.i += 1
    self.xs[self.i - 1]

  drop(!self)
    print("drop", self.xs[0])

fun dmk(v: ?List[Int]) -> DCur from v
  DCur(xs: v, i: 0)

obj Bag2
  xs: List[Int]

  fun each(?self) -> DCur from self
    DCur(xs: ?self.xs, i: 0)

sub main()
  b = Bag2(xs: List())
  fill(!b.xs)
  for x in ?b.each()
    for _ in 0..100
      !b.xs.push(x)
    break
