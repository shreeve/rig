# Cell change through an element of a List in a shared handle and in a ?Box
obj C
  c: Cell[Int]

obj S
  v: List[C]

sub bump(b: !^S)
  !b.v[0].c.set(40)

sub main()
  v: List[C] = List()
  !v.push(C(c: Cell(3)))
  h = *S(v: <v)
  !h.v[0].c.set(9)
  print(h.v[0].c.get())
  w: List[C] = List()
  !w.push(C(c: Cell(3)))
  b = ^S(v: <w)
  bump(!b)
  print(b.v[0].c.get())
