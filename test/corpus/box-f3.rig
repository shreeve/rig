obj C
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

fun peek(b: !^C) -> Int
  !b.hit()
  b.hits.get()

sub main()
  b = ^C(hits: Cell(value: 0))
  !b.hit()
  print(peek(!b))
  cell: Cell[^C] = Cell(value: ^C(hits: Cell(value: 5)))
  old = (!cell).replace(^C(hits: Cell(value: 7)))
  print(old.hits.get())
