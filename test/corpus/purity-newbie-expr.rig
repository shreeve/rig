# Recursive expression evaluator with an enum.
# The compiler suggested `*Expr`, but a shared handle cannot be matched,
# so this follows SPEC §10 Box instead.
error EvalError
  divide_by_zero

enum Expr
  num(value: Float)
  add(left: ^Expr, right: ^Expr)
  mul(left: ^Expr, right: ^Expr)
  div(left: ^Expr, right: ^Expr)
  neg(inner: ^Expr)

fun eval(e: ?^Expr) -> Float!
  match e
    .num(v) => v
    .add(l, r) => eval(?l)! + eval(?r)!
    .mul(l, r) => eval(?l)! * eval(?r)!
    .neg(x) => -eval(?x)!
    .div(l, r)
      d = eval(?r)!
      return EvalError.divide_by_zero if d == 0.0
      eval(?l)! / d

fun num(v: Float) -> ^Expr
  ^.num(v)

fun add(l: ^Expr, r: ^Expr) -> ^Expr
  ^.add(left: <l, right: <r)

fun mul(l: ^Expr, r: ^Expr) -> ^Expr
  ^.mul(left: <l, right: <r)

fun div(l: ^Expr, r: ^Expr) -> ^Expr
  ^.div(left: <l, right: <r)

fun neg(x: ^Expr) -> ^Expr
  ^.neg(inner: <x)

sub main()
  # (2 + 3) * -4
  e = mul(add(num(2), num(3)), neg(num(4)))
  print(eval(?e)!)
  bad = div(num(1), add(num(2), neg(num(2))))
  result = eval(?bad) catch |err|
    print("error:", err)
    0.0
  print(result)
