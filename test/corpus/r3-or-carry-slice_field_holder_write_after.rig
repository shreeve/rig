# A view reached through a slice field carries the slice's loans, not a
# loan on the holder: the holder's other fields stay writable.

struct Tok
  kind: Int

struct P
  toks: []Tok
  pos: Int

sub main
  a = [Tok(kind: 1), Tok(kind: 2)]
  p = P(toks: ?a[..], pos: 0)
  t = ?p.toks[0]
  p.pos = 1
  print(t.kind, p.pos)
