use std.hash

sub main()
  count = 0
  a = hash.Map[Int, Int].new()
  b = hash.Map[Int, Int].new()
  f = |!count, k: ?Int| tick(k, !count)
  x = (!a).ensure_with(1, ?f)
  y = (!b).ensure_with(2, ?f)
  x += y
  print(a.get(1), b.get(2), count)

fun tick(k: ?Int, count: !Int) -> Int
  count += 1
  k * 10
