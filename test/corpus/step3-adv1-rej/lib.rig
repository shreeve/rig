pub obj Stack[T]
  items: List[T]

  fun new_stack() -> Self
    Stack(items: List())

  sub push(!self, x: T, note: ?String = "pushed")
    !self.items.push(<x)
    print(note)

  fun size(?self) -> Int
    self.items.len

pub obj Slot[T]
  c: Cell[T]

  fun swap(!self, x: T) -> T
    (!self.c).replace(<x)

pub fun wrap[T](x: T, label: ?String = "w") -> Stack[T]
  s = Stack[T].new_stack()
  !s.push(<x)
  print(label)
  s

pub obj View[T]
  r: ?T
