struct R
  id: Int

  drop(!self)
# Sigil-prefixed names (`?x`) are sugar for `self` parameters only, not
    print("rel", self.id)

  fun look(?self) -> Int
    print("use", self.id)
    self.id

struct P
  a: R
  b: R

struct Q
  h: *R
  o: R?

enum HR
  one(r: R)
  two(a: R, b: *R)
  empty

struct M
  r: R

  fun with(<self, n: Int) -> Int
    print("use", self.r.id)
    n + self.r.id

  fun peek(?self, n: Int) -> Int
    print("use", self.r.id)
    n

  sub put(!self, r: R)
    self.r = <r

error E
  bad

fun mk(id: Int) -> R
  print("new", id)
  R(id: id)

fun mkm(id: Int) -> M
  M(r: mk(id))

fun mayr(k: Int) -> R!
  return E.bad if k == 0
  mk(k)

fun may(k: Int) -> Int!
  return E.bad if k == 0
  k

fun optr(k: Int) -> R?
  return none if k == 0
  mk(k)

fun opt(k: Int) -> Int?
  return none if k == 0
  k

fun two(a: R, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  a.id + b.id

fun one(a: R, n: Int) -> Int
  print("use", a.id)
  a.id + n

fun take3(a: R, n: Int, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  n

fun hand(h: *R, n: Int) -> Int
  print("use", h.id)
  n

fun bx(b: Box[R], n: Int) -> Int
  print("use", b.id)
  n

fun pp(p: P) -> Int
  print("use", p.a.id)
  print("use", p.b.id)
  1

fun qq(q: Q) -> Int
  print("use", q.h.id)
  2

fun hr(e: HR) -> Int
  match <e
    .one(r) => r.look()
    .two(a, b)
      print("use", b.id)
      a.look()
    .empty => 0

fun ints(xs: [2]Int) -> Int
  xs[0] + xs[1]

fun rt_int(n: Int) -> Int
  n

fun h0 -> Int?
  print("val", hr(HR.two(a: mk(1), b: *mk(2))))
  m1 = M(r: mk(3))
  !m1.put(optr(rt_int(4004))?)
  print("val", m1.peek(bx(Box(optr(rt_int(3005))?), take3(mk(6), 6, mk(7)))))
  0

sub h1()!
  print("val", may(rt_int(5))!)
  q1 = Q(h: *mk(18), o: none)
  print("val", hand(*mk(19), qq(Q(h: *mk(20), o: mayr(rt_int(3021))!))))
  v3: Vec[*R] = Vec()
  !v3.push(*mk(22))
  !v3.push(*mk(23))

sub h2()!
  print("val", two(mk(34), mk(35)))
  b1 = [qq(Q(h: *mayr(rt_int(0))!, o: mayr(rt_int(0))!)), ints([6, ints([5, 2])])]
  print("val", b1[0])
  v3: Vec[*R] = Vec()
  !v3.push(*mk(38))
  !v3.push(*mk(39))
  m6 = M(r: mk(40))
  !m6.put(mk(41))
  print("val", m6.peek(hand(*mk(42), take3(mk(43), 4, mk(44)))))
  print("val", two(mk(45), mk(46)))

sub main
  print("got", h0())
  h1() catch |e| print("caught", e)
  h2() catch |e| print("caught", e)
