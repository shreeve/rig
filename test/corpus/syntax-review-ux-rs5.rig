obj Doc
  title: ?String
  words: List[?String]

obj View
  doc: ?Doc
  pos: Int

fun longest(a: ?Doc, b: ?Doc) -> ?Doc
  a if a.words.len > b.words.len else b

sub main()
  d1 = Doc(title: "a", words: List())
  !d1.words.push("x")
  d2 = Doc(title: "b", words: List())
  v = View(doc: ?d1, pos: 0)
  w = longest(?d1, ?d2)
  print(v.doc.title, w.title)
  !d1.words.push("y")
  print(d1.words.len)
