pub fun same[T](x: T) -> T
  x

pub obj Tagger
  label: ?String

  sub show[T](?self, x: T)
    print(self.label, x)

fun local[T](x: T) -> T
  x

obj Inner
  n: Int

  fun same[U](?self, x: U) -> U
    x

pub obj Outer
  i: Inner

pub fun uses_local(n: Int) -> Int
  local(n)

pub fun make_outer(n: Int) -> Outer
  Outer(i: Inner(n: n))
