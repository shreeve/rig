error E
  bad

struct P
  n: Int
  fun use(?self, a: Vec[Int], b: Vec[Int]) -> Int
    self.n + a.len + b.len

fun mk(c: !*Cell[Vec[P]]) -> Vec[Int]!
  for i in 0..10000
    !c.push(P(n: i))
  v = Vec[Int]()
  !v.push(1)
  v

fun run(c: ?*Cell[Vec[P]], d: !*Cell[Vec[P]]) -> Int!
  c[0].use(mk(!d)!, mk(!d)!)

sub main()
  c = *Cell[Vec[P]](value: Vec())
  !c.push(P(n: 41))
  d = +c
  print(run(c, !d) catch 0)
