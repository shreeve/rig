error E
  bad

obj P
  n: Int
  fun use(?self, a: List[Int], b: List[Int]) -> Int
    self.n + a.len + b.len

fun mk(c: !*Cell[List[P]]) -> List[Int]!
  for i in 0..10000
    !c.push(P(n: i))
  v = List[Int]()
  !v.push(1)
  v

fun run(c: ?*Cell[List[P]], d: !*Cell[List[P]]) -> Int!
  c[0].use(mk(!d)!, mk(!d)!)

sub main()
  c = *Cell[List[P]](value: List())
  !c.push(P(n: 41))
  d = +c
  print(run(c, !d) catch 0)
