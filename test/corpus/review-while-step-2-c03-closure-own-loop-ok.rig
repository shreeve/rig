# A closure with its own loop inside a joined step-inside loop: its continue targets its own loop. Expected: accepted, prints `end 3 6`.
#
# oracle: mk accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  i = 0
  c: *Cell[Int] = *Cell(0)
  :outer while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    f = |+c|
      for t in 0..3
        continue if t == 1
        c.set(c.get() + 1)
    f()
    continue :outer if i == 99
  print("end", k, c.get())
