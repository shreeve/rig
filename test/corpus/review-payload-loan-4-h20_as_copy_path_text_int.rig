sub f(a: ?((!String)?), b: ?((!String)?), ia: ?((!Int)?), c: Bool)
  if (a if c else b) as t
    print(t, t.len)
    g = |?t| t.len
    print(g())
  if ia as k
    print(k + 1)

sub main()
  x = String("aa")
  y = String("bbb")
  n = 41
  o1: (!String)? = !x
  o2: (!String)? = !y
  oi: (!Int)? = !n
  f(?o1, ?o2, ?oi, true)
