# Header exception "takes": `<p` through a path that makes a header
# temporary. The place must be left empty (none), the value owned by the
# construct, no leak and no double drop.
enum E
  a(t: String)
  b

fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[String?] = List()
  !v.push(String("first text long enough to live on the heap"))
  if <v[idx(?String("a"))] as t
    print(t)
  print(v[0] == none)
  w: List[E?] = List()
  !w.push(E.a(t: String("an enum text long enough for the heap")))
  if <w[idx(?String("a"))] as e
    match <e
      .a(t) => print(t)
      .b => print("b")
  print(w.len)
  o: [1](List[Int]?) = [none]
  vv: List[Int] = List()
  !vv.push(3)
  o[0] = <vv
  while <o[idx(?String("a"))] as xs
    for x in xs
      print(x)
  print(o[0] == none)
