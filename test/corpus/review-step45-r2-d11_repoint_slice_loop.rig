# re-point a ![]Text local in a loop at different Vecs, push the old one after re-point
sub main()
  v: List[String] = List()
  !v.push(String("a"))
  u: List[String] = List()
  !u.push(String("b"))
  s = !v[..]
  for i in 0..3
    s = !u[..] if i % 2 == 0 else !v[..]
    s[0] = String("z")
  !v.push(String("c"))
  print(v, u)
