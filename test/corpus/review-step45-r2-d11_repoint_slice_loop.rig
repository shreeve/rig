# re-point a ![]Text local in a loop at different Vecs, push the old one after re-point
sub main()
  v: Vec[Text] = Vec()
  !v.push(Text("a"))
  u: Vec[Text] = Vec()
  !u.push(Text("b"))
  s = !v[..]
  for i in 0..3
    s = !u[..] if i % 2 == 0 else !v[..]
    s[0] = Text("z")
  !v.push(Text("c"))
  print(v, u)
