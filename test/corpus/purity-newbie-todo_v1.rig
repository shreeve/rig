# To-do list, first attempt, Python/TS habits
obj Todo
  title: ?String
  done: Bool = false

obj TodoList
  items: List[Todo]

  sub add(!self, title: ?String)
    self.items.push(Todo(title: title))

  sub complete(!self, index: Int)
    self.items[index].done = true

  sub show(?self)
    for i, item in enumerate(self.items)
      mark = "[x]" if item.done else "[ ]"
      print(i, mark, item.title)

sub main()
  todos = TodoList(items: List[Todo]())
  todos.add("buy milk")
  todos.add("write rig program")
  todos.add("walk dog")
  todos.complete(1)
  todos.show()
