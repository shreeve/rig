obj N
  v: Int
  drop(!self)
    print("drop", self.v)

fun build() -> *fun() -> Int
  v: List[String] = List()
  !v.push(String("aa"))
  !v.push(String("bbb"))
  f = *|+v| v.len + v[1].len
  !v.push(String("c"))
  f

sub unused()
  v: List[String] = List()
  !v.push(String("zz"))
  f = |+v| v.len
  if v.len > 5
    print(f())
  print("unused", v.len)

sub many()
  hs: List[*N] = List()
  !hs.push(*N(v: 7))
  f = |+hs| hs[0].v
  <hs
  print(f(), f(), f())

sub main()
  g = build()
  print(g(), g())
  h = +g
  <g
  print(h())
  unused()
  many()
