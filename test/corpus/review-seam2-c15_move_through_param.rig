# Review probe c15_move_through_param.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: steal reject C3
# oracle: main accept
obj S
  n: Int
  items: List[Int]

sub steal(p: !S)
  x = <(!p).items
  print(x)

sub main()
  s = S(n: 1, items: List())
  !s.items.push(1)
  steal(!s)
  print(s.items)
