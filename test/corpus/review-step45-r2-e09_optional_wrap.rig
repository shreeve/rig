# H3: generic loop over ?List[T], body: push into List[T] by bare x
struct S
  t: String

struct Holder[T]
  x: T?

fun cp[T](v: ?List[T]) -> List[T]
  out: List[T] = List()
  for x in v
    !out.push(x)
  <out

sub main()
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(cp(?v))
