# Review probe c12_move_elem.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.steal accept
# oracle: S.into accept
# oracle: S.at accept
# oracle: S.rd accept
# oracle: S.drop accept
# oracle: mk accept
# oracle: mkv accept
# oracle: main reject C3
obj S
  n: Int
  items: List[Int]

  fun steal(!self) -> List[Int]
    replace(!self.items, List())

  fun into(<self) -> Int
    self.n

  fun at(!self) -> !Int
    !self.n

  fun rd(?self) -> Int
    self.n

  drop(!self)
    print("drop", self.n, self.items)

fun mk(n: Int) -> S
  s = S(n: n, items: List())
  !s.items.push(n)
  s

fun mkv() -> List[List[Int]]
  v: List[List[Int]] = List()
  w: List[Int] = List()
  !w.push(1)
  !v.push(<w)
  v

sub main()
  x = <(!mkv())[0]
  print(x)
  y = <(!mk(3)).n
  print(y)
