struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun f(t: *Tok, k: Int) -> *Tok!
  return E.bad if k > 0
  <t

sub main()
  a = *Tok(n: 1)
  b = *Tok(n: 2)
  x = f(<a, 1) catch <b
  print(x.n)
