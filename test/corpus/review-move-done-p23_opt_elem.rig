# optional elements holding owners: taken and emptied
obj S
  v: List[Int]

fun len_of(o: S?) -> Int
  if o as s
    return s.v.len
  -1

sub main()
  vv: List[List[Int]?] = List()
  r: List[Int] = List()
  !r.push(1)
  !vv.push(<r)
  !vv.push(none)
  w = <vv[0]
  print(w, vv[0], vv.len)
  a: [2]S? = [S(v: List()), none]
  x = <a[0]
  print(len_of(<x), a[0] == none)
  vs: List[S?] = List()
  !vs.push(S(v: List()))
  sl = !vs[..]
  y = <sl[0]
  print(len_of(<y), vs[0] == none)
  i = 0
  z = <vv[i]
  print(z, vv[0])

# oracle: len_of accept
# oracle: main accept
