  x

fun id_u64(x: U64) -> U64
  x

fun id_i128(x: I128) -> I128
  x

fun id_u128(x: U128) -> U128
  x

fun id_float(x: Float) -> Float
  x

fun id_f32(x: F32) -> F32
  x

fun fo287(s: Bool) -> F32?
  return none if not s
  3

fun fu287(s: Bool) -> F32?
  x = fo287(s)?
  x

struct W1879
  f: Int
  g: Int = 1

fun fal541(ok: Bool) -> U32!
  return Err541.bad if not ok
  1416856575

error Err541
  bad

fun ret934() -> U8
  k934 = rt_int(2)
  match k934
      1 => 3
      2, 3 => 11
      _ => 69

struct Bx1071
  f: U32

