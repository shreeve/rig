struct Counter
  hits: Cell[Int] = Cell(0)

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

struct G[T]
  v: T

  sub run(?self, f: sub(T))
    f(self.v)

sub hitit(c: !Counter)
  !c.hit()

sub main()
  k = *Counter()
  g = G(v: ?k)
  !g.v.hit()
  g.run(hitit)
  o: (?Counter)? = ?k
  if o as r
    r.hit()
  print(k.hits.get())
