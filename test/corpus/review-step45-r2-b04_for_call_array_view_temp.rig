# for x in !geta(!a, ?Text("a")): write loop over an array view a call returns, temp argument
fun geta(a: ![2]String, s: ?String) -> ![2]String
  a

sub main()
  a = [String("p"), String("q")]
  for x in !geta(!a, ?String("a"))
    for _ in 0..40
      !x.add("xxxxxxxx")
  print(a[0].len, a[1].len)
