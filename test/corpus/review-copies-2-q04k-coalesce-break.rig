error Bad
  oops

struct P
  x: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r

fun opt(r: ?P, k: Int) -> (?P)?!
  return Bad.oops if k == 0
  return none if k == 1
  r


sub main
  a = P(x: 1)
  os: Vec[(?P)?] = Vec()
  !os.push(?a)
  !os.push(none)
  !os.push(?a)
  t = 0
  for o in os
    c: P = o ?? break
    t += c.x
  print(t)
