# Header exception "a value made in the header": `for` over a List made
# by a call whose argument is a header temporary (plain elements, and
# Text elements taken), and over a made array of plain data.
fun idx(s: ?String) -> Int
  s.len

fun mkv(k: Int) -> List[Int]
  v: List[Int] = List()
  for i in 0..k
    !v.push(i)
  v

fun mkt(s: ?String) -> List[String]
  v: List[String] = List()
  !v.push(String(s, " one, long enough for the heap"))
  !v.push(String(s, " two, long enough for the heap"))
  v

fun mka(k: Int) -> [3]Int
  [k, k + 1, k + 2]

sub main()
  for x in mkv(idx(?String("abc")))
    print(x)
  for y in mka(idx(?String("ab")))
    print(y)
