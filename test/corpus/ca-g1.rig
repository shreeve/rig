fun sort[T](xs: ![]T, less: ?fun(?T, ?T) -> Bool)
  i = 1
  while i < xs.len : i += 1
    j = i
    while j > 0 and less(?xs[j], ?xs[j - 1]) : j -= 1
      !xs.swap(j, j - 1)

fun map[T, U](xs: []T, f: ?fun(?T) -> U) -> Vec[U]
  out: Vec[U] = Vec()
  for x in xs
    !out.push(f(?x))
  out

sub main()
  v: Vec[Int] = Vec()
  !v.push(3)
  !v.push(1)
  !v.push(2)
  sort(!v[..], |a, b| a < b)
  print(v)
  names = ["bob", "ada", "cy"]
  sort(!names[..], |a, b| a > b)
  print(names)
  lens = map(?names[..], |s| s.len * 10)
  print(lens)
  flags = map(?v[..], |n| n > 1)
  print(flags)
