struct P
  x: Int

fun remove_at[T](v: !Vec[T], i: Int) -> T?
  j = i
  while j + 1 < v.len : j += 1
    !v.swap(j, j + 1)
  (!v).pop()

sub insert_at[T](v: !Vec[T], i: Int, x: T)
  !v.push(<x)
  j = v.len - 1
  while j > i : j -= 1
    !v.swap(j - 1, j)

sub main()
  v: Vec[*P] = Vec()
  !v.push(*P(x: 1))
  !v.push(*P(x: 2))
  old = *P(x: 0)
  insert_at(!v, 0, *P(x: 7))
  if remove_at(!v, 1) as r
    print(r.x)
  print(old.x, v)
