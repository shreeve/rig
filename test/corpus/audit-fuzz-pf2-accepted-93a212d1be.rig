struct R
  id: Int

  drop(!self)
    print("rel", self.id)

  fun look(?self) -> Int
    print("use", self.id)
    self.id

struct P
  a: R
  b: R

struct Q
  h: *R
  o: R?

enum HR
  one(r: R)
  two(a: R, b: *R)
  empty

struct M
  r: R

  fun with(<self, n: Int) -> Int
    print("use", self.r.id)
    n + self.r.id

  fun peek(?self, n: Int) -> Int
    print("use", self.r.id)
    n

  sub put(!self, r: R)
    self.r = <r

error E
  bad

fun mk(id: Int) -> R
  print("new", id)
  R(id: id)

fun mkm(id: Int) -> M
  M(r: mk(id))

fun mayr(k: Int) -> R!
  return E.bad if k == 0
  mk(k)

fun may(k: Int) -> Int!
  return E.bad if k == 0
  k

fun optr(k: Int) -> R?
  return none if k == 0
  mk(k)

fun opt(k: Int) -> Int?
  return none if k == 0
  k

fun two(a: R, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  a.id + b.id

fun one(a: R, n: Int) -> Int
  print("use", a.id)
  a.id + n

fun take3(a: R, n: Int, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  n

fun hand(h: *R, n: Int) -> Int
  print("use", h.id)
  n

fun bx(b: Box[R], n: Int) -> Int
  print("use", b.id)
  n

fun pp(p: P) -> Int
  print("use", p.a.id)
  print("use", p.b.id)
  1

fun qq(q: Q) -> Int
  print("use", q.h.id)
  2

fun hr(e: HR) -> Int
  match <e
    .one(r) => r.look()
    .two(a, b)
      print("use", b.id)
      a.look()
    .empty => 0

fun ints(xs: [2]Int) -> Int
  xs[0] + xs[1]

fun rt_int(n: Int) -> Int
  n

fun h0() -> Int?
  p0 = P(a: optr(rt_int(0))?, b: mk(2))
  b1 = [ints([opt(rt_int(1))?, qq(Q(h: *mk(3), o: mk(4)))]), one(mk(5), take3(mk(6), 3, mk(7)))]
  print("val", b1[0])
  print("val", 2)
  print("val", opt(rt_int(0))?)
  0

sub h1()!
  print("val", hand(*mk(18), M(r: mk(19)).with(2)))
  q1 = Q(h: *mk(20), o: none)

sub h2()!
  print("val", may(rt_int(1))!)
  x1 = mk(31)
  print("val", hand(*mk(32), M(r: mk(33)).with(two(mk(34), mk(35)))))
  print("val", may(rt_int(1))!)
  print("val", one(mk(36), bx(Box(mk(37)), pp(P(a: mk(38), b: mk(39))))))

sub h3()!
  m0 = M(r: mk(50))
  !m0.put(mk(51))
  print("val", m0.peek(qq(Q(h: *mk(52), o: mayr(rt_int(0))!))))
  print("val", ((may(rt_int(1))! + 6) + (one(mk(54), 3) + (5 + 9))))
  m4 = M(r: mk(55))
  !m4.put(mk(56))
  print("val", m4.peek(hand(*mayr(rt_int(4057))!, one(mk(58), 4))))
  print("val", bx(Box(mk(59)), (1 + may(rt_int(1))!)))
  q8 = Q(h: *mayr(rt_int(0))!, o: mk(61))
  print("val", qq(Q(h: *mk(62), o: mayr(rt_int(3063))!)))

sub main()
  print("got", h0())
  h1() catch |e| print("caught", e)
  h2() catch |e| print("caught", e)
  h3() catch |e| print("caught", e)
