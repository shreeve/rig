# An unlabeled `continue` in the `else` of a nested loop used as a value leaves the loop around it: the joined outer loop, whose step reads its binding and refills `a`. Expected: accepted, prints `21 5` (the first pass takes 1, each later one 5), sanitizer-clean; or rejected.
#
# oracle: mk accept
# oracle: fresh accept
# oracle: take accept
obj S
  s: []Int

fun mk(v: ?List[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

fun fresh(n: Int) -> List[Int]
  a: List[Int] = List()
  !a.push(n)
  a

fun take(a: List[Int]) -> Int
  a[0]

sub main()
  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    w = for t in 0..2
      break t if t == 9
    else
      continue
    k += w
    k += 100
  print(k, i)
