# Header exception "slices": `for x in sl(?mkv(5))`, where `sl` returns a
# slice of the List temporary the header makes (dropped when the header
# ends), and `for x in ?mkv(6)[1..]`, a slice of the temporary itself.
fun mkv(k: Int) -> List[Int]
  v: List[Int] = List()
  for i in 0..40
    !v.push(k + i)
  v

fun sl(v: ?List[Int]) -> []Int from v
  ?v[1..3]

sub main()
  for x in sl(?mkv(5))
    print(x)
