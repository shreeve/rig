struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct P
  a: *Tok
  b: *Tok

sub f(p: !P)
  swap(!p.a, !p.b)

sub main
  p = P(a: *Tok(n: 1), b: *Tok(n: 2))
  f(!p)
  print(p.a.n, p.b.n)
