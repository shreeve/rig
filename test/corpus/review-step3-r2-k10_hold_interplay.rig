obj Counter
  hits: Cell[Int]

  sub hit(!self)
    !self.hits.set(self.hits.get() + 1)

obj Res
  n: Int
  t: String

enum E
  a(r: Res)
  b

fun bump(c: !Counter) -> Int
  !c.hit()
  0

fun reset(e: !E) -> Int
  e = E.b
  0

sub main()
  c = Counter(hits: Cell(1))
  print(c, bump(?c), c.hits.get())
  e = E.a(r: Res(n: 1, t: String("x")))
