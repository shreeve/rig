fun index_of[T](xs: []T, x: T) -> Int?
  i = 0
  for y in xs
    if y == x
      return i
    i += 1
  none

fun max_of[T](xs: []T) -> T?
  if xs.len == 0
    return none
  m = xs[0]
  for y in xs
    if y > m
      m = y
  m

sub main()
  a = [3, 9, 2]
  print(index_of(?a, 9), max_of(?a), index_of(["a", "b"], "b"))
