struct R
  id: Int

  drop(!self)
    print("rel", self.id)

  fun look(?self) -> Int
    print("use", self.id)
    self.id

struct P
  a: R
  b: R

struct Q
  h: *R
  o: R?

enum HR
  one(r: R)
  two(a: R, b: *R)
  empty

struct M
  r: R

  fun with(<self, n: Int) -> Int
    print("use", self.r.id)
    n + self.r.id

  fun peek(?self, n: Int) -> Int
    print("use", self.r.id)
    n

  sub put(!self, r: R)
    self.r = <r

error E
  bad

fun mk(id: Int) -> R
  print("new", id)
  R(id: id)

fun mkm(id: Int) -> M
  M(r: mk(id))

fun mayr(k: Int) -> R!
  return E.bad if k == 0
  mk(k)

fun may(k: Int) -> Int!
  return E.bad if k == 0
  k

fun optr(k: Int) -> R?
  return none if k == 0
  mk(k)

fun opt(k: Int) -> Int?
  return none if k == 0
  k

fun two(a: R, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  a.id + b.id

fun one(a: R, n: Int) -> Int
  print("use", a.id)
  a.id + n

fun take3(a: R, n: Int, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  n

fun hand(h: *R, n: Int) -> Int
  print("use", h.id)
  n

fun bx(b: Box[R], n: Int) -> Int
  print("use", b.id)
  n
# `if m as v` runs its branch with `v` bound to the value inside the

fun pp(p: P) -> Int
  print("use", p.a.id)
  print("use", p.b.id)
  1

fun qq(q: Q) -> Int
  print("use", q.h.id)
  2

fun hr(e: HR) -> Int
  match <e
    .one(r) => r.look()
    .two(a, b)
      print("use", b.id)
      a.look()
    .empty => 0

fun ints(xs: [2]Int) -> Int
  xs[0] + xs[1]

fun rt_int(n: Int) -> Int
  n

fun h0() -> Int?
  q0 = Q(h: *optr(rt_int(0))?, o: mk(2))
  print("val", 3)
  print("val", opt(rt_int(5))?)
  print("val", bx(Box(optr(rt_int(4003))?), two(mk(4), mk(5))))
  q4 = Q(h: *optr(rt_int(4006))?, o: none)
  e5 = HR.one(r: mk(7))
  0

sub h1()!
  q0 = Q(h: *mayr(rt_int(0))!, o: mk(19))
  x1 = mayr(rt_int(3020))!
  print("val", may(rt_int(1))!)
  print("val", pp(P(a: mk(21), b: mk(22))))
  m4 = M(r: mayr(rt_int(3023))!)
  !m4.put(mk(24))
  print("val", m4.peek((may(rt_int(0))! + one(mk(25), 1))))
  print("val", one(mk(26), one(mk(27), ints([2, 1]))))

sub h2()!
  print("val", ints([one(mk(38), may(rt_int(2))!), qq(Q(h: *mk(39), o: mk(40)))]))
  print("val", 3)
  b2 = [pp(P(a: mk(41), b: mayr(rt_int(3042))!)), one(mayr(rt_int(4043))!, may(rt_int(1))!)]
  print("val", b2[0])
  q4 = Q(h: *mk(44), o: none)

fun h3() -> Int?
  print("val", 0)
  q1 = Q(h: *mk(55), o: optr(rt_int(3056))?)
  print("val", opt(rt_int(1))?)
  0

sub main()
  print("got", h0())
  h1() catch |e| print("caught", e)
  h2() catch |e| print("caught", e)
  print("got", h3())
