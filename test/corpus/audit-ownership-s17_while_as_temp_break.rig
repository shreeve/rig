struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

fun mk(k: Int) -> *Tok?
  *Tok(n: k) if k < 3 else none

sub main()
  k = 0
  while mk(k) as t
    k += 1
    break if t.n == 1
  print("end", k)
