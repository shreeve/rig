obj Res
  n: Int
  t: String

  drop(!self)
    print("drop", self.n)

enum E
  a(r: ?Res)
  b

obj H
  e: E

fun mkh(r: ?Res) -> H
  H(e: E.a(r: r))

fun mkres(n: Int) -> Res
  Res(n: n, t: String("abc"))

sub main()
  match mkh(?mkres(1)).e
    .a(r) => print("a", r.n, r.t)
    .b => pass
  print("end")
