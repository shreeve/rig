obj R
  n: Int

  drop(!self)
    print("drop", self.n)

  sub bump(!self)
    self.n += 10

sub main()
  v: List[^R] = List()
  !v.push(^R(n: 1))
  b = ^R(n: 2)
  !v.push(<b)
  for x in ?v
    print("see", x.n)
  for x in !v
    !x.bump()
  if (!v).pop() as last
    print("popped", last.n)
  print(v.len)
