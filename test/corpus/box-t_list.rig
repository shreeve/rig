# A singly linked list of 200,000 boxed nodes is built, counted, and
# dropped without deep recursion: releasing a box that releases boxes is
# queued past a fixed depth.

obj Node
  value: Int
  next: ^Node?

fun count(list: ?^Node?) -> Int
  n = 0
  cur = list
  while cur as node
    n += 1
    cur = ?node.next
  n

sub main()
  head: ^Node? = none
  i = 0
  while i < 200000 : i += 1
    head = ^Node(value: i, next: <head)
  print(count(?head))

# expect:
# 200000
