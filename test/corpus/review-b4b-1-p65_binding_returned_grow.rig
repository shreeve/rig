# returned header binding, then the owner grows while the view lives. Expect reject.
fun idx(s: ?String) -> Int
  s.len - 1

fun get(v: ?List[String?]) -> (?String)? from v
  if v[idx(?String("a"))] as t
    return t
  none

sub main()
  v: List[String?] = List()
  !v.push(String("a"))
  r = get(?v)
  for _ in 0..64
    !v.push(String("zzzzzzzzzzzzzzzzzzzzzzzzz"))
  print(r)
