# returned header binding, then the owner grows while the view lives. Expect reject.
fun idx(s: ?Text) -> Int
  s.len - 1

fun get(v: ?Vec[Text?]) -> (?Text)? from v
  if v[idx(?Text("a"))] as t
    return t
  none

sub main()
  v: Vec[Text?] = Vec()
  !v.push(Text("a"))
  r = get(?v)
  for _ in 0..64
    !v.push(Text("zzzzzzzzzzzzzzzzzzzzzzzzz"))
  print(r)
