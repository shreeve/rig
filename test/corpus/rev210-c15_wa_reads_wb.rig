# Reviewer probe for #210 (field loans): Storing through a write view of
# `p.a` a view of a write view of `p.b`.

obj Holder
  t: ?String

  sub keep(!self, t: ?String) keeps t
    self.t = t

obj P
  a: Holder
  b: String
  views: List[?String]
  arr: [2]?String
  bx: ^Holder
  hs: List[Holder]

sub main()
  p = P(a: Holder(t: ""), b: String("x"), views: List(), arr: ["", ""], bx: ^Holder(t: ""), hs: List())
  wa = !p.a
  wb = !p.b
  wa.t = ?wb
  !wb.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(p.a.t)
