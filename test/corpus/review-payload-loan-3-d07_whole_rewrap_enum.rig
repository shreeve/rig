obj P
  t: String

obj H
  w: !P

enum E
  a(h: H)
  b

sub put(q: !P)
  q.t = String("other")

sub main()
  p = P(t: String("hello"))
  e = E.a(H(w: !p))
  match e
    .a(h)
      r = ?h.w.t[1..]
      g = E.a(h)
      match !g
        .a(k) => k.w.t = String("other")
        .b => pass
      print(r)
    .b => pass
