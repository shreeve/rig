# Review probe diag/d03_param_shadows_module.rig (seam2b fixes): rejected, or runs sanitizer-clean.
use lib

struct U
  n: Int

  fun bump(!self) -> Int
    self.n += 1
    self.n

  fun me(!self) -> !U
    self

  fun make -> U
    U(n: 1)

struct Wrap[T]
  v: T

  fun bump(!self) -> Int
    1

  fun make(v: T) -> Wrap[T]
    Wrap(v: v)

enum E
  a(s: String)
  b

sub sete(e: !E)
  print(e)
  e = .b

sub grow(u: !lib.T)
  u.n += 100
  print(u.n)

sub growu(u: !U)
  u.n += 100
  print(u.n)

sub g(lib: !U)
  print(!lib.me().bump())

sub main
  u = U(n: 1)
  g(!u)
  print(u.n)
