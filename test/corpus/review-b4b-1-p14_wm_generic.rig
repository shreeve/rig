# generic write match on a List element. Expect accept, clean.
enum O[T]
  some(x: T)
  nothing

sub setall[T](v: !List[O[T]], i: Int, x: T)
  match !v[i]
    .some(y) => y = <x
    .nothing => pass

sub main()
  v: List[O[Int]] = List()
  !v.push(O.some(x: 1))
  setall(!v, 0, 9)
  w: List[O[String]] = List()
  !w.push(O.some(x: String("a")))
  setall(!w, 0, String("b"))
  print(v[0], w[0])
