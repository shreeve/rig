obj Res
  n: Int
  t: String

  drop(!self)
    print("drop", self.n)

enum Opt[T]
  some(v: T)
  nothing

obj W[T]
  e: Opt[T]
  tag: String

fun mk[T](x: T) -> W[T]
  W(e: .some(v: x), tag: String("tag"))

fun show[T](x: T) -> Int
  match mk(<x).e
    .some(v)
      print(v)
      1
    .nothing => 0

sub main()
  print(show(Res(n: 3, t: String("three"))))
  print(show(5))
