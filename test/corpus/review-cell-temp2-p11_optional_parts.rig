# oracle: D.drop accept
# oracle: D.hit accept
# oracle: D.bumped accept
# oracle: D.me accept
# oracle: mk accept
# oracle: mkf accept
# oracle: mko accept
# oracle: mkww accept
# oracle: look accept
# oracle: mkho accept
# oracle: main accept
error E
  bad

struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

  sub hit(?self)
    self.c.set(self.c.get() + 1)

  fun bumped(?self) -> Int
    self.c.set(self.c.get() + 1)
    self.c.get()

  fun me(?self) -> ?D
    self.c.set(self.c.get() + 1)
    self

struct WW
  t: D

fun mk(n: Int) -> D
  D(c: Cell(n))

fun mkf(n: Int) -> D!
  return E.bad if n < 0
  mk(n)

fun mko(n: Int) -> D?
  return none if n < 0
  mk(n)

fun mkww(n: Int) -> WW
  WW(t: mk(n))

fun look(x: ?D) -> Int
  x.c.set(x.c.get() + 10)
  x.c.get()

struct HO
  o: D?
  n: Int

fun mkho(n: Int) -> HO
  return HO(o: none, n: 0) if n < 0
  HO(o: mk(n), n: n)

fun opt(k: Bool, j: Bool) -> Int?
  a = mk(1)
  h = mkho(2 if j else -1)
  (h.o ?? mk(5)).hit()
  (mkho(6 if j else -1).o ?? a).hit()
  (a if k else (mkho(7 if j else -1).o if k else mkho(8).o)?).hit()
  (h.o if k else mkho(9).o)?.hit()
  print("v", (h.o if k else mkho(10).o)?.bumped(), (mkho(11 if j else -1).o ?? (h.o ?? a)).bumped())
  print("a", a.c.get())
  if h.o as y
    print("h", y.c.get())
  0

sub main()
  print("q", opt(true, true) ?? -1)
  print("q", opt(true, false) ?? -1)
  print("q", opt(false, true) ?? -1)
  print("q", opt(false, false) ?? -1)
# expect:
# drop 7
# v 5 12
# drop 12
# a 2
# h 5
# drop 5
# drop 2
# q 0
# drop 6
# drop 3
# q -1
# drop 7
# drop 9
# drop 10
# v 11 12
# drop 12
# drop 11
# a 1
# h 3
# drop 3
# drop 1
# q 0
# drop 6
# drop 9
# drop 10
# v 11 3
# drop 11
# a 3
# drop 3
# q 0
