struct R
  id: Int

  drop(!self)
    print("rel", self.id)

  fun look(?self) -> Int
    print("use", self.id)
    self.id

struct P
  a: R

  b: R

struct Q
  h: *R
  o: R?

enum HR
  one(r: R)
  two(a: R, b: *R)
  empty

struct M
  r: R

  fun with(<self, n: Int) -> Int
    print("use", self.r.id)
    n + self.r.id

  fun peek(?self, n: Int) -> Int
    print("use", self.r.id)
    n

  sub put(!self, r: R)
    self.r = <r

error E
  bad

fun mk(id: Int) -> R
  print("new", id)
  R(id: id)

fun mkm(id: Int) -> M
  M(r: mk(id))

fun mayr(k: Int) -> R!
  return E.bad if k == 0
  mk(k)

fun may(k: Int) -> Int!
  return E.bad if k == 0
  k

fun optr(k: Int) -> R?
  return none if k == 0
  mk(k)

fun opt(k: Int) -> Int?
  return none if k == 0
  k

fun two(a: R, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  a.id + b.id

fun one(a: R, n: Int) -> Int
  print("use", a.id)
  a.id + n

fun take3(a: R, n: Int, b: R) -> Int
  print("use", a.id)
  print("use", b.id)
  n

fun hand(h: *R, n: Int) -> Int
  print("use", h.id)
  n

fun bx(b: Box[R], n: Int) -> Int
  print("use", b.id)
  n

fun pp(p: P) -> Int
  print("use", p.a.id)
  print("use", p.b.id)
  1

fun qq(q: Q) -> Int
  print("use", q.h.id)
  2

fun hr(e: HR) -> Int
  match <e
    .one(r) => r.look()
    .two(a, b)
      print("use", b.id)
      a.look()
    .empty => 0

fun ints(xs: [2]Int) -> Int
  xs[0] + xs[1]

fun rt_int(n: Int) -> Int
  n

sub h0()!
  p0 = P(a: mayr(rt_int(4001))!, b: mk(2))
  v1: Vec[*R] = Vec()
  !v1.push(*mayr(rt_int(0))!)
  !v1.push(*mayr(rt_int(0))!)

sub h1()!
  b0 = [two(mayr(rt_int(4015))!, mayr(rt_int(0))!), may(rt_int(0))!]
  print("val", b0[0])
  p2 = P(a: mk(17), b: mayr(rt_int(4018))!)

fun h2() -> Int?
  v0: Vec[*R] = Vec()
  !v0.push(*mk(29))
  !v0.push(*mk(30))
  b3 = [qq(Q(h: *mk(31), o: optr(rt_int(3032))?)), take3(mk(33), 5, mk(34))]
  print("val", b3[0])
  p5 = P(a: optr(rt_int(0))?, b: mk(36))
  print("val", opt(rt_int(5))?)
  print("val", one(mk(37), opt(rt_int(1))?))
  e8 = HR.one(r: optr(rt_int(0))?)
  0

sub main()
  h0() catch |e| print("caught", e)
  h1() catch |e| print("caught", e)
  print("got", h2())
