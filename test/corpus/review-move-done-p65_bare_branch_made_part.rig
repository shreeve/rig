# no `<`: a binding of a branching value one of whose leaves is an
# owning part of a value made there
obj S
  v: List[Int]

fun mk() -> S
  v: List[Int] = List()
  !v.push(7)
  S(v: <v)

sub main()
  c = true
  x = mk().v if c else List[Int]()
  print(x.len)
  y = mk().v
  print(y.len)

# oracle: mk accept
# oracle: main reject C2
