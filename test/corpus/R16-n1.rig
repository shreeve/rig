sub rec(n: Int, f: ?sub(Int))
  if n == 0
    f(0)
  else
    rec(n - 1, |?f, +n, k|
      f(k + n))

sub each(xs: ?Vec[Int], f: ?sub(Int))
  for x in xs
    f(x)

sub main
  total = 0
  rec(3, |!total, k|
    total += k)
  print(total)
  v: Vec[Int] = Vec()
  !v.push(1)
  !v.push(2)
  w: Vec[Int] = Vec()
  !w.push(10)
  !w.push(20)
  sum = 0
  each(?v, |?w, !sum, a|
    each(?w, |!sum, +a, b|
      sum += a * b))
  print(sum)
