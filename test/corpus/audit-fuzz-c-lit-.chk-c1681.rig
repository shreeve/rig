fun gid[T](a: T) -> T
  a

fun gmax[T](a: T, b: T) -> T
  a if a > b else b

fun gmin[T](a: T, b: T) -> T
  a if a < b else b

fun gadd[T](a: T, b: T) -> T
  a + b

fun gdbl[T](a: T) -> T
  a * 2

fun ghalf[T](a: T) -> T
  a / 2

fun gsome[T](a: T) -> T?
  a

fun gnone[T]() -> T?
  none

fun gpick[T](a: T, b: T, first: Bool) -> T
  a if first else b

fun gfail[T](a: T, ok: Bool) -> T!
  return GE.bad if not ok
  a

error GE
  bad

struct Wrap[T]
  v: T

  fun get(?self) -> T
    self.v

  fun make(x: T) -> Wrap[T]
    Wrap(v: x)

enum Opt[T]
  some(v: T)
  nothing

  fun or(?self, d: T) -> T
    match self
      .some(v) => v
      .nothing => d

struct Pair[T, U]
  a: T
  b: U

fun rt_bool(b: Bool) -> Bool
  b

