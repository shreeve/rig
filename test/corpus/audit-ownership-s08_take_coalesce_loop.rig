obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

obj H
  o: *Tok?

sub main()
  hs: List[^H] = List()
  !hs.push(^H(o: *Tok(n: 1)))
  !hs.push(^H(o: none))
  !hs.push(^H(o: *Tok(n: 3)))
  for h in !hs
    t = <h.o ?? continue
    eat(<t)
  print("end")
