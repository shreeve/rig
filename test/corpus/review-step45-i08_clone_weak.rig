# +v of Vec[~D] and optionals of handles
struct D
  n: Int

  drop(!self)
    print("drop", self.n)

sub main()
  a = *D(n: 1)
  v: Vec[~D] = Vec()
  !v.push(~a)
  w = +v
  o: (*D)? = +a
  p = +o
  -a
  -o
  print("still", w.len)
  -p
  if w[0].upgrade() as h
    print("alive", h.n)
  else
    print("gone")
  -v
  -w
  print("end")
