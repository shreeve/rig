struct T
  k: Int
  kids: Vec[^T]

struct Q
  k: Int
  a: ^Q?
  s: *Q2?

  drop(!self)
    if self.k % 100000 == 0
      print("drop q", self.k)

struct Q2
  q: ^Q?

sub main()
  root = ^T(k: 0, kids: Vec())
  i = 1
  while i < 300000
    root = ^T(k: i, kids: Vec())
    i += 1
  deep: ^T? = none
  i = 0
  while i < 300000
    kids: Vec[^T] = Vec()
    if <deep as d
      !kids.push(<d)
    deep = ^T(k: i, kids: <kids)
    i += 1
  print("built")
  deep = none
  print("dropped")
  q: ^Q? = none
  i = 0
  while i < 300000
    if i % 2 == 0
      q = ^Q(k: i, a: <q, s: none)
    else
      q = ^Q(k: i, a: none, s: *Q2(q: <q))
    i += 1
  q = none
  print("done")
