# The step reads the condition binding only through a closure capture
# (`|+h, x: Int| x + h`): no jump in the condition.
#
# oracle: odd accept
# oracle: some accept
# oracle: apply accept
# oracle: main accept
fun odd(i: Int) -> Int?
  none if i % 2 == 1 else i

fun some(i: Int) -> Int?
  i if i < 6 else none

fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

sub main()
  steps = 0
  i = 0
  while some(odd(i) ?? break) as h: steps = apply(|+h, x: Int| x + h, steps)
    i += 1
    print("body", i, h)
  print(steps, i)
