obj R
  n: Int

  drop(!self)
    print("drop", self.n)

fun unbox[T](b: ^T) -> T
  <b.take()

fun wrap[T](v: T) -> ^T
  ^<v

fun peek[T](b: ?^T) -> ?T
  ?b

obj Pair[T]
  a: T
  b: T

sub main()
  b = wrap(R(n: 1))
  r = unbox(<b)
  print(r.n)
  c = wrap(wrap(R(n: 2)))
  print(c)
  p = Pair(a: wrap(R(n: 3)), b: wrap(R(n: 4)))
  print(p.a.n, p.b.n)
  q = <p
  print(peek(?q.a).n)
