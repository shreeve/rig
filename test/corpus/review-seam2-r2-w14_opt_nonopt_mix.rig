# Review probe r2/w14_opt_nonopt_mix.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: mk accept
# oracle: mkopt accept
# oracle: f accept
# oracle: main accept
obj S
  n: Int
  items: List[Int]
  o: List[Int]?
  b: ^List[Int]

  drop(!self)
    print("drop", self.n, self.items, self.o)

fun mk(n: Int) -> S
  v: List[Int] = List()
  !v.push(n)
  w: List[Int] = List()
  !w.push(n * 10)
  S(n: n, items: <v, o: <w, b: ^List[Int]())

fun mkopt(n: Int) -> S?
  return none if n == 0
  mk(n)

fun f(n: Int) -> Int
  n

sub main()
  s = mk(1)
  x = <(!s).o
  y = <(!s).o
  print(x, y)
