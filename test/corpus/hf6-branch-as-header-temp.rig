# `if (!arr[idx(?Text("a"))] if c else !w) as n` over a `[1]Int?`: the
# header makes a temporary, so the write would land in a copy.
fun idx(s: String) -> Int
  s.len - 1

sub main()
  arr: [1]Int? = [1]
  w: Int? = 2
  c = w != none
  if (!arr[idx(?Text("a"))] if c else !w) as n
    n = 50
  print(arr, w)
