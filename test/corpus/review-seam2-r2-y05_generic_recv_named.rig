# Review probe r2/y05_generic_recv_named.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.drop accept
# oracle: W.put accept
# oracle: mk accept
# oracle: wrapw accept
# oracle: main reject C5
struct S
  n: Int
  t: Text

  drop(!self)
    print("dropS", self.n)

struct H
  rs: Vec[String]

  drop(!self)
    print("dropH sees", self.rs)

struct W[V]
  h: H
  xs: Vec[V]

  sub put(!self, r: String, v: V)
    !self.h.rs.push(r)
    !self.xs.push(v)

fun mk(n: Int) -> S
  S(n: n, t: Text("hello world, long enough to be on the heap"))

fun wrapw[V](w: !W[V]) -> !W[V]
  w

sub main()
  w = W(h: H(rs: Vec()), xs: Vec[Int]())
  if true
    s = mk(2)
    wrapw(!w).put(?s.t, 1)
  print("end")
