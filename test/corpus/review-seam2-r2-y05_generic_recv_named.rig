# Review probe r2/y05_generic_recv_named.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.drop accept
# oracle: W.put accept
# oracle: mk accept
# oracle: wrapw accept
# oracle: main reject C5
obj S
  n: Int
  t: String

  drop(!self)
    print("dropS", self.n)

obj H
  rs: List[?String]

  drop(!self)
    print("dropH sees", self.rs)

obj W[V]
  h: H
  xs: List[V]

  sub put(!self, r: ?String, v: V) keeps r
    !self.h.rs.push(r)
    !self.xs.push(v)

fun mk(n: Int) -> S
  S(n: n, t: String("hello world, long enough to be on the heap"))

fun wrapw[V](w: !W[V]) -> !W[V]
  w

sub main()
  w = W(h: H(rs: List()), xs: List[Int]())
  if true
    s = mk(2)
    wrapw(!w).put(?s.t, 1)
  print("end")
