# while-as re-evaluated each iteration while the body re-points the view it goes through. Expect accept, clean.
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  a: List[String?] = List()
  !a.push(String("a"))
  b: List[String?] = List()
  !b.push(String("b"))
  !b.push(none)
  r = ?a
  k = 0
  while r[idx(?String("a"))] as t
    print(t)
    r = ?b
    k += 1
    break if k > 3
  print(k)
