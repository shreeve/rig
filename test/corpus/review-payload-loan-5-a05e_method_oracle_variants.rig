struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

fun mk(n: Int) -> E
  v: Vec[Int] = Vec()
  !v.push(n)
  E.a(r: Res(n: n, v: <v))

struct H
  w: !E

  fun gw(!self) -> !E
    !self.w

sub main()
  e = mk(1)
  h = H(w: !e)
  w = (!h).gw()
  match !w
    .a(r)
      for i in 0..3
        !r.v.push(i)
    .b => pass
  print(h.w)
