struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

struct View
  b: ?Tok

sub main
  x = Tok(n: 1)
  arr = [View(b: ?x), View(b: ?x)]
  for vw in !arr
    y = Tok(n: 2)
    vw = View(b: ?y)
  print(arr[0].b.n)
