# Moving a captured owner out of a closure's environment, called twice.
fun mkv(n: Int) -> List[Int]
  xs: List[Int] = List()
  !xs.push(n)
  xs

fun eat(x: List[Int]) -> Int
  x.len

obj S
  v: List[Int]
  o: List[Int]?

sub main()
  v = mkv(1)
  g = |<v| eat(<v)
  print(g())
  print(g())

# oracle: mkv accept
# oracle: eat accept
# oracle: main reject B3
