struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false
error E
  bad

fun fail(k: Int) -> Int!
  return E.bad if k > 0
  k

fun run -> Int!
  t = *Tok(n: 1)
  for i in 0..3
    fail(i - 1)!
    if i == 0
      eat(<t)
      t = *Tok(n: 5)
  0

sub main
  print(run() catch -1)
