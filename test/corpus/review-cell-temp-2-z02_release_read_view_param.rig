# Pre-existing (main too): a function that changes a Cell[List] through a
# read view parameter. Debug is right; --release loses the push (the length
# read after it is stale), for a temporary and for a named local alike.
#
# oracle: build accept
# oracle: look accept
fun build(n: Int) -> List[Int]
  v: List[Int] = List()
  for i in 0..n
    !v.push(i)
  v

fun look(x: !Cell[List[Int]]) -> Int
  !x.push(10)
  x.len

sub main()
  a: Cell[List[Int]] = Cell(build(1))
  print(look(!a), a.len)
  print(look(?Cell(build(1))))
  b: Cell[List[Int]] = Cell(build(1))
  print(look(!(<b)))

# expect:
# 2 2
# 2
# 2
