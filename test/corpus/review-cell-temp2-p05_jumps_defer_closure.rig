# oracle: D.drop accept
# oracle: D.hit accept
# oracle: D.bumped accept
# oracle: D.me accept
# oracle: mk accept
# oracle: mkf accept
# oracle: mko accept
# oracle: mkww accept
# oracle: look accept
# oracle: main accept
error E
  bad

struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

  sub hit(?self)
    self.c.set(self.c.get() + 1)

  fun bumped(?self) -> Int
    self.c.set(self.c.get() + 1)
    self.c.get()

  fun me(?self) -> ?D
    self.c.set(self.c.get() + 1)
    self

struct WW
  t: D

fun mk(n: Int) -> D
  D(c: Cell(n))

fun mkf(n: Int) -> D!
  return E.bad if n < 0
  mk(n)

fun mko(n: Int) -> D?
  return none if n < 0
  mk(n)

fun mkww(n: Int) -> WW
  WW(t: mk(n))

fun look(x: ?D) -> Int
  x.c.set(x.c.get() + 10)
  x.c.get()

sub jumps(k: Bool, j: Bool)
  a = mk(1)
  for i in 0..3
    (a if k else (mko(5 if j else -1) ?? continue)).hit()
    print("i", i)
  for i in 0..3
    (mkf(6 if k else -1) catch break).hit()
    print("ii", i)
  print("a", a.c.get())

fun early(k: Bool, j: Bool) -> Int
  a = mk(1)
  (a if k else (mko(5 if j else -1) ?? return -1)).hit()
  (mko(7 if j else -1) ?? return -2).hit()
  (a if j else (mkf(-1) catch return -3)).hit()
  a.c.get()

sub deferred(k: Bool)
  a = mk(1)
  if true
    defer (a if k else mk(5)).hit()
    defer print("d", (a if k else mk(6)).bumped())
    print("in")
  print("a", a.c.get())

sub closures(k: Bool)
  a = mk(1)
  f = |?a, j: Bool| (a if j else ?mk(5)).hit()
  f(k)
  f(not k)
  print("a", a.c.get())
  b = mk(100)
  g = |<b, j: Bool| (b if j else mk(6)).bumped()
  print("g", g(k))
  print("g", g(not k))
  h = |?g| g(true) + 1000
  print("h", h())

sub main()
  jumps(true, true)
  jumps(false, false)
  jumps(false, true)
  print(early(true, true), early(false, true), early(false, false))
  deferred(true)
  deferred(false)
  closures(true)
  closures(false)
