struct Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

sub sw[T](a: !T, b: !T)
  swap(!a, !b)

sub main()
  a = *Tok(n: 1)
  b = *Tok(n: 2)
  sw(!a, !b)
  print(a.n, b.n)
