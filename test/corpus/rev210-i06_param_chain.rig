# Reviewer probe for #210 (field loans): The same chain through a
# write-view parameter.

obj Holder
  t: ?String

obj Mid
  h: Holder
  k: Int

obj P
  hs: List[Holder]
  m: Mid
  b: String

sub go(q: !P)
  w = !q.m.h
  set(!w, ?q.b)
  q.b = String("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")

sub set(h: !Holder, s: ?String) keeps s
  h.t = s

sub main()
  p = P(hs: List(), m: Mid(h: Holder(t: ""), k: 0), b: String("x"))
  !p.hs.push(Holder(t: ""))
  go(!p)
  print(p.m.h.t)
