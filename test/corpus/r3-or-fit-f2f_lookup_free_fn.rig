struct Var
  name: String
  value: String

struct Env
  vars: [3]Var

fun get(env: ?Env, name: String) -> String?
  for v in ?env.vars
    if v.name == name
      return v.value
  none

sub main()
  env = Env(vars: [Var(name: "a", value: "1"), Var(name: "b", value: "2"), Var(name: "c", value: "3")])
  for n in ["a", "c"]
    q = Text(n)
    if get(?env, ?q) as v
      print(v)
  print(env.vars[0].name)
