obj S
  c: Cell[List[Int]]

  sub grow(!self)
    for i in 0..50
      !self.c.push(i)

obj O
  s: S

fun peek(o: ?O) -> ?S
  ?o.s

sub main()
  a = *O(s: S(c: Cell(List())))
  b = *O(s: S(c: Cell(List())))
  k = a.s.c.len == 0
  !a.s.c.push(1)
  (a.s if k else b.s).c[0] = 7
  print(a.s.c[0])
  print(a.s.c.len, b.s.c.len)
