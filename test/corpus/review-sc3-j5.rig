fun get(k: Int) -> Int?
  k if k > 0 else none

fun app(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

sub main()
  f: fun(Int) -> Int = |k|
    n = get(k) ?? return -1
    n * 2
  print(f(3), f(0))
  print(app(|k| (get(k) ?? return 5) + 1, 1), app(|k| (get(k) ?? return 5) + 1, 0))
  h = |k: Int| (get(k) ?? return 5) + 1
  print(h(2), h(0))
  s = |k: Int|
    n = get(k) ?? return
    print("s", n)
  s(3)
  s(0)
