# Valid: the step writes through the bound write view; the body only
# counts.
fun at(v: !Vec[Int], i: Int) -> (!Int)?
  if i < v.len
    return !v[i]
  none

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  !v.push(2)
  i = 0
  while at(!v, i) as p: p += 10
    i += 1
  print(v[0], v[1])

# expect: 11 12
