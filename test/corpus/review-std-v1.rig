struct Res
  n: Int

  drop(!self)
    print("drop", self.n)

sub main()
  v = Vec[*Res]()
  !v.push(*Res(n: 1))
  !v.push(*Res(n: 2))
  !v.insert(1, *Res(n: 3))
  h = *Res(n: 4)
  !v.insert(0, <h)
  _ = !v.remove(2)
  print("after discard")
  r = !v.remove(0)
  print("got", r.n)
  x = *Res(n: 5)
  !v.insert(v.len, <x)
  print("len", v.len)
