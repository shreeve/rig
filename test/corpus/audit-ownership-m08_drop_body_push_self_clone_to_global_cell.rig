obj Tok
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(t: *Tok)
  pair(a: *Tok, b: *Tok)
  empty

sub eat(t: *Tok)
  print("eat", t.n)

fun cond(t: *Tok) -> Bool
  print("cond", t.n)
  false

obj R
  t: *Tok
  sink: *Cell[List[*Tok]]

  drop(!self)
    !self.sink.push(+self.t)

sub main()
  sink: *Cell[List[*Tok]] = *Cell(List())
  if true
    r = R(t: *Tok(n: 1), sink: +sink)
  print("len", sink.len)
  v = (!sink).replace(List())
  for t in ?v
    print("kept", t.n)
