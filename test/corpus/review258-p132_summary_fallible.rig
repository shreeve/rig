error Bad
  oops

obj H
  s: ?String

fun must(v: !List[H]) -> (!H)! from v
  return Bad.oops if v.len == 0
  !v[0]

fun go(v: !List[H], u: ?String) -> Int!
  must(!v)! = H(s: u)
  0

sub main()
  t = String("t")
  v: List[H] = List()
  !v.push(H(s: ?t))
  u = String("u")
  print(go(!v, ?u) catch 1)
  <u
  print(v[0].s)
