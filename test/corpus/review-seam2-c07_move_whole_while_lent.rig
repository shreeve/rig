# Review probe c07_move_whole_while_lent.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.at accept
# oracle: S.drop accept
# oracle: mk accept
# oracle: both accept
# oracle: main reject C4
struct S
  n: Int
  items: Vec[Int]

  fun at(!self) -> !Int
    !self.n

  drop(!self)
    print("drop", self.n, self.items)

fun mk(n: Int) -> S
  s = S(n: n, items: Vec())
  !s.items.push(n)
  s

sub both(a: !Int, b: S)
  a += 1
  print(b.n)

sub main()
  s = mk(1)
  both(!s.n, <s)
