error Bad
  oops

struct P
  x: Int

fun get(r: ?P, ok: Bool) -> (?P)!
  return Bad.oops if not ok
  r

fun opt(r: ?P, k: Int) -> (?P)?!
  return Bad.oops if k == 0
  return none if k == 1
  r

sub main()
  a = P(x: 1)
  b = P(x: 2)
  o1: (?P)? = none
  o2: (?P)? = ?a
  c: P = o1 ?? o2 ?? ?b
  f: P = o1 ?? (o2 ?? ?b)
  a.x = 5
  b.x = 6
  print(c.x, f.x)
