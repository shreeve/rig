obj Box[T]
  item: T

  sub show(?self, label: ?String)
    print(label, self.item, "|", self.item)
    t = String(label, self.item)
    print(t)

sub show[T](x: T)
  print("show", x)
  print(x)
  print(x, x)

sub main()
  show(1)
  show(-1)
  show(true)
  show(2.5)
  show("lit")
  show(String("own"))
  b = Box[Int](item: 5)
  b.show("int")
  c = Box[Bool](item: false)
  c.show("bool")
  d = Box[Float](item: 0.5)
  d.show("float")
  e = Box[String](item: String("s"))
  e.show("str")
  v: Simd[U8, 4] = Simd[U8, 4]([1, 2, 3, 4])
  m = v == Simd[U8, 4]([1, 0, 3, 0])
  print(v, m, v + 1)
  show(v)
  show(m)
  fv: Simd[F32, 2] = Simd[F32, 2]([1.0, 2.5])
  print(fv)
