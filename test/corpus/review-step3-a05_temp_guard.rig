struct Bag
  n: Int

  drop(!self)
    print("drop", self.n)

enum E
  a(n: Int)
  b

fun size(b: ?Bag) -> Int
  b.n

fun mk(n: Int) -> Bag
  Bag(n: n)

sub main
  e = E.a(n: 2)
  match e
    .a(n) if n == size(mk(1)) => print("one")
    .a(n) if n == size(mk(2)) => print("two")
    _ => print("other")
