# A `continue :a` in the `else` of an inner loop also labeled `:a`: the inner loop has ended, so it names the outer joined `:a` loop, whose step refills `a`. Expected: accepted, prints `21 5`, sanitizer-clean; or rejected.
#
# oracle: mk accept
# oracle: fresh accept
# oracle: take accept
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 5
    return S(s: ?v[..])
  none

fun fresh(n: Int) -> Vec[Int]
  a: Vec[Int] = Vec()
  !a.push(n)
  a

fun take(a: Vec[Int]) -> Int
  a[0]

sub main()
  v: Vec[Int] = Vec()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  :a while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    :a while j < 2: j += 1
      continue :a if j == 7
      k += 0
    else
      continue :a
    k += 100
  print(k, i)
