# if-as over a match value whose arm lends an element through a temp; grow t
fun idx(s: ?String) -> Int
  s.len - 1

sub main()
  v: List[String?] = List()
  !v.push(String("q"))
  w: String? = String("w")
  k = 1
  o = match k
    1 => !v[idx(?String("a"))]
    _ => !w
  if !o as t
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(v[0])
