# Review probe r2/x04_kwargs_hoist.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
# oracle: S.drop accept
# oracle: H.keep accept
# oracle: H.keep2 accept
# oracle: H.keepg accept
# oracle: H.me accept
# oracle: H.drop accept
# oracle: HH.in accept
# oracle: mk accept
# oracle: mkh accept
# oracle: mkhh accept
# oracle: mkhopt accept
# oracle: wrap accept
# oracle: f accept
# oracle: main reject C5
obj S
  n: Int
  t: String

  drop(!self)
    print("dropS", self.n)

obj H
  rs: List[?String]

  sub keep(!self, r: ?String) keeps r
    !self.rs.push(r)

  sub keep2(!self, a: ?String, b: ?String) keeps a, b
    !self.rs.push(a)
    !self.rs.push(b)

  sub keepg[T](!self, r: ?String, k: T) keeps r
    !self.rs.push(r)

  fun me(!self) -> !H
    self

  drop(!self)
    print("dropH sees", self.rs)

obj HH
  inner: H
  hs: List[H]

  fun in(!self) -> !H
    !self.inner

fun mk(n: Int) -> S
  S(n: n, t: String("hello world, long enough to be on the heap ", n))

fun mkh() -> H
  H(rs: List())

fun mkhh() -> HH
  hh = HH(inner: H(rs: List()), hs: List())
  !hh.hs.push(H(rs: List()))
  hh

fun mkhopt(n: Int) -> H?
  return none if n == 0
  H(rs: List())

fun wrap(h: !H) -> !H
  h

fun f(n: Int) -> Int
  n

sub main()
  !mkh().keep2(b: ?mk(1).t, a: ?mk(2).t)
  print("end")
