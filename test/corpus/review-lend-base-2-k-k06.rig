obj Q
  n: Int

obj P
  x: Int
  a: [2]Int
  q: Q
  items: List[Int]

obj W
  r: ?List[Int]

fun mk() -> P
  P(x: 1, a: [1, 2], q: Q(n: 1), items: List())

sub grow(v: !List[Int])
  !v.push(7)

sub bump(n: !Int)
  n += 1

sub bumpq(q: !Q)
  q.n += 1

fun size(v: ?List[Int]) -> Int
  v.len

fun items(p: ?P) -> ?List[Int] from p
  (?p).items

sub main()
  p = mk()
  print(size((?p).items))
