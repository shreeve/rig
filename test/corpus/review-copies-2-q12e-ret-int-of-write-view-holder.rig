error Bad
  oops

struct P
  x: Int

struct Q
  r: ?P
  n: Int

struct W
  w: !P

struct WI
  w: !Int

fun f(h: ?WI, ok: Bool) -> Int!
  return Bad.oops if not ok
  h.w

fun g(h: WI, ok: Bool) -> Int?!
  return Bad.oops if not ok
  return none if h.w < 0
  h.w

sub main()
  n = 4
  hw = WI(w: !n)
  x = f(?hw, true) catch 0
  y = g(<hw, true) catch none
  print(x, y ?? -1)
