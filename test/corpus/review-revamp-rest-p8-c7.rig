error E
  bad

obj P
  n: Int
  fun use(!self, a: List[Int], b: List[Int]) -> Int
    self.n += 1
    self.n + a.len + b.len

fun mk(n: Int) -> List[Int]!
  return E.bad if n < 0
  v = List[Int]()
  !v.push(n)
  v

fun run(ps: ![2]P, i: !Int) -> Int!
  (!ps[i]).use(mk(1)!, mk(2)!)

sub main()
  ps = [P(n: 1), P(n: 2)]
  i = 0
  print(run(!ps, !i) catch 0, ps[0].n, ps[1].n)
