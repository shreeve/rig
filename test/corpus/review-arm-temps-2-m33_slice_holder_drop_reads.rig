# The store drops the old `h`, whose `drop` reads a slice of `v`, after the
# arm grows `v`.
struct H
  v: []Int

  drop(!self)
    print("drop", self.v[0])

fun grow(v: !Vec[Int]) -> Int
  for _ in 0..200
    !v.push(1)
  v.len

sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  u: Vec[Int] = Vec()
  !u.push(8)
  h = H(v: ?v[0..1])
  k = 0
  h = match k
    0
      grow(!v)
      H(v: ?u[0..1])
    _ => H(v: ?u[0..1])
  print("end")
