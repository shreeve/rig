# Valid: the step reads no binding, so it runs after `x` dropped.
#
# oracle: D.drop accept
# oracle: mkd accept
obj D
  s: []Int
  drop(!self)
    print("drop", self.s[0])

fun mkd(w: ?List[Int], i: Int) -> D?
  if i < 3
    return D(s: ?w[..])
  none

sub main()
  w: List[Int] = List()
  !w.push(2)
  i = 0
  while i >= 0 and mkd(?w, i) as x: !w.push(9)
    i += 1
  print(i, w.len)

# expect:
# drop 2
# drop 2
# drop 2
# 3 6
