obj P
  x: Int
  v: List[Int]
  arr: [3]Int

  fun vr(?self) -> ?List[Int]
    ?self.v

obj S
  b: ^P

fun rd(s: ?S) -> Int
  s.b.x + s.b.v.len + s.b.arr[1]

sub wr(s: !S)
  s.b.x += 1
  !s.b.v.push(4)
  s.b.arr[1] = 9
  s.b.v[0] = 8

sub main()
  s = S(b: ^P(x: 1, v: List(), arr: [1, 2, 3]))
  !s.b.v.push(1)
  wr(!s)
  print(rd(?s), s.b.v[0], s.b.vr().len)
  print("x is {s.b.x}")
  b = ^P(x: 1, v: List(), arr: [1, 2, 3])
  b.x *= 5
  b.arr[0] += 1
  print(b)
  for e in ?b.arr
    print(e)
