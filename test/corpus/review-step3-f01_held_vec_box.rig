obj Res
  n: Int

  drop(!self)
    print("drop", self.n)

obj Bag
  v: List[^Res]
  tag: Res

fun mk(n: Int) -> Bag
  v: List[^Res] = List()
  !v.push(^Res(n: n))
  !v.push(^Res(n: n + 1))
  Bag(v: <v, tag: Res(n: 99))

sub main()
  for x in mk(10).v
    print("x", x.n)
  print("mid")
  for x in mk(20).v
    if x.n == 20
      break
  print("end")
