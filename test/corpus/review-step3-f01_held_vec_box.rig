struct Res
  n: Int

  drop(!self)
    print("drop", self.n)

struct Bag
  v: Vec[Box[Res]]
  tag: Res

fun mk(n: Int) -> Bag
  v: Vec[Box[Res]] = Vec()
  !v.push(Box(Res(n: n)))
  !v.push(Box(Res(n: n + 1)))
  Bag(v: <v, tag: Res(n: 99))

sub main()
  for x in mk(10).v
    print("x", x.n)
  print("mid")
  for x in mk(20).v
    if x.n == 20
      break
  print("end")
