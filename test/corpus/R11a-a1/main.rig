use lib

struct Res
  n: Int

  drop(!self)
    print("drop", self.n)

sub main()
  print(lib.dup(Res(n: 1)).n)
  v = Vec[Res]()
  !v.push(Res(n: 2))
  print(lib.last(?v, Res(n: 3)).n)
  print(lib.eq(Res(n: 1), Res(n: 1)))
  print(lib.lt(Res(n: 1), Res(n: 1)))
  print(lib.arr[-1]())
  u: U8 = 3
  print(lib.fit(u))
  print(lib.add("a", "b"))
  print(lib.dup(Vec[Int]()).len)
