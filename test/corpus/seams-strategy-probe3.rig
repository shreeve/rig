use std.sort

struct Task
  name: Text
  priority: Int

sub main()
  board: Vec[^Task] = Vec()
  !board.push(^Task(name: Text("a"), priority: 2))
  !board.push(^Task(name: Text("b"), priority: 1))
  sort.sort_by(!board[..], |a, b| a.priority < b.priority)
  !board.swap(0, 1)
  for t in ?board
    print(t.name)
