use std.sort

obj Task
  name: String
  priority: Int

sub main()
  board: List[^Task] = List()
  !board.push(^Task(name: String("a"), priority: 2))
  !board.push(^Task(name: String("b"), priority: 1))
  sort.sort_by(!board[..], |a, b| a.priority < b.priority)
  !board.swap(0, 1)
  for t in ?board
    print(t.name)
