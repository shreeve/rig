# a binding of a header that points escapes into an outer name / is returned; then the owner is grown. Expect reject at the push.
fun idx(s: ?Text) -> Int
  s.len - 1

sub main()
  v: Vec[Text?] = Vec()
  !v.push(Text("a"))
  r: (?Text)? = none
  if v[idx(?Text("a"))] as t
    r = t
  for _ in 0..64
    !v.push(Text("zzzzzzzzzzzzzzzzzzzzzzzzz"))
  print(r)
