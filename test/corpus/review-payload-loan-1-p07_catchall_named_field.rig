obj P
  t: String
  xs: List[Int]

enum S
  a(p: P)
  b

sub main()
  e = S.a(P(t: String("hello"), xs: List()))
  match !e
    x
      match !x
        .a(p: q)
          s = ?q.t[1..]
          for _ in 0..50
            !q.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
          print(s)
        .b => pass
