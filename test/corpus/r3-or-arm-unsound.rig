# The neighbours of r3-or-arm-sound, once unsound while emit matched a
# copy of the subject: a view of a read match's binding that is no plain
# data given as the match's value, returned from a guarded arm, or from
# a generic body. Emit matches each subject where it is, so the view
# carries the subject's loan (INTERNALS "Header subjects").
#
# oracle: yielded accept
# oracle: guarded_return accept
# oracle: Opt.peek accept

struct Res
  n: Int
  t: Text

enum E
  a(r: Res)
  b

enum Opt[T]
  some(v: T)
  nothing

  fun peek(?self, d: ?T) -> ?T
    match self
      .some(v) => ?v
      .nothing => d

sub yielded(e: ?E, k: ?Res)
  r = match e
    .a(p) => ?p
    .b => k
  print(r.n)

fun guarded_return(e: ?E, k: ?Res) -> ?Res
  match e
    .a(p) if p.n > 0
      return ?p
    _ => pass
  k

sub main()
  k = Res(n: 0, t: Text("k"))
  e = E.a(r: Res(n: 1, t: Text("e")))
  yielded(?e, ?k)
  print(guarded_return(?e, ?k).t)
  o = Opt.some(v: Text("o"))
  d = Text("d")
  print(o.peek(?d))
