# The unsound neighbours of r3-or-arm-sound: a view of a read match's
# binding that is no plain data given as the match's value, returned
# from a guarded arm, or from a generic body (INTERNALS "Header
# subjects").
#
# oracle: yielded reject C5
# oracle: guarded_return reject C5
# oracle: Opt.peek reject C6

struct Res
  n: Int
  t: Text

enum E
  a(r: Res)
  b

enum Opt[T]
  some(v: T)
  nothing

  fun peek(?self, d: ?T) -> ?T
    match self
      .some(v) => ?v
      .nothing => d

sub yielded(e: ?E, k: ?Res)
  r = match e
    .a(p) => ?p
    .b => k
  print(r.n)

fun guarded_return(e: ?E, k: ?Res) -> ?Res
  match e
    .a(p) if p.n > 0
      return ?p
    _ => pass
  k

sub main()
  k = Res(n: 0, t: Text("k"))
  yielded(?E.b, ?k)
