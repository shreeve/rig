fun bump[k: Int](s: ?String, at: Int) -> Int
  i = at
  if i + 1 <= s.len
    i += 1
  if i + 1 <= s.len
    i += 1
  if i + 1 <= s.len
    i += 1
  if i + 1 <= s.len
    i += 1
  if i + 1 <= s.len
    i += 1
  if i + 1 <= s.len
    i += 1
  i + k - 1

