# A user module may be named `rig`; it is imported like any other.
# Known bug (A8): emit declares `const rig = @import("rig.zig")` next to
# the runtime's `const rig`, and the Zig build fails on the duplicate
# name. Emit should write user names with `rig.writeZigIdent`, which
# renames `rig` to `@"rig'"`.
use rig

sub main()
  print(rig.helper())

# expect:
# 7
