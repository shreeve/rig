# Known bug (B10, emit): a closure capture's type is found by a global
# name scan; with another function's Int `s`, the captured String prints
# as a byte array. Sema's facts table has the right answer:
# `ctx.symbolOf(capture_leaf)` is the capture with type String.

sub other()
  s = 3
  print(s)

sub main()
  s =! "hello"
  f = |s|
    print(s)
  f()
  other()

# expect:
# hello
# 3
