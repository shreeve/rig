# A fallible function fails by returning a value of an error set; the
# caller's `catch` supplies the fallback. (The spelling of the failing
# `return` is a proposal: `return ParseError.empty`.)
#
# Bug: there is no way to produce an error. Every value a `-> T!`
# function can return is a plain `T`, so a fallible function never
# fails; `return ParseError.empty` is rejected with "type mismatch:
# expected `Int!`, got `ParseError`".

error ParseError
  empty

fun parse_len(s: String) -> Int!
  if s == ""
    return ParseError.empty
  s.len

sub main()
  print(parse_len("abc") catch -1)
  print(parse_len("") catch -1)

# expect:
# 3
# -1
