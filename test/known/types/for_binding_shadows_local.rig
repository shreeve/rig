# Known bug (D14): a `for` binding that reuses the name of a local in the
# same scope is implicit shadowing, which SPEC forbids; it is accepted and
# the emitted Zig fails ("local constant 'n' shadows local constant").

sub main()
  n = 99
  v: Vec(Int) = Vec()
  (!v).push(1)
  for n in v
    print(n)
  print(n)

# error: shadows
