# In `new x = x + 10` the right side reads the previous `x`.
# Known bug: emit renames the new binding and uses the new name on the
# right side too (`const x_1 = (x_1 + 10);`), which Zig rejects.
# Known bug: sema says the previous binding is used before it has a value

sub main()
  x = 1
  new x = x + 10
  print x

# expect:
# 11
