# A variant's value may convert a constant to a sized integer type.
#
# Known bug: the emitter writes the value's expression rather than the
# folded `Field.value`, and the checker records no type for the
# conversion, so emitting `U16(7)` fails with "cannot emit an untyped
# conversion".

enum E
  a = U16(7)
  b = I128(3) + 5

sub main()
  print(Int(E.a), Int(E.b))

# expect:
# 7 8
