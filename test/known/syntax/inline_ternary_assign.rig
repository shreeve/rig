# `x = a if c else b` is the inline ternary expression.
# Known bug: it parses to (set _ x _ (if c 1 2)), but emit writes
# `const x = if (c) 1 else 2;` with no type, and Zig rejects the
# comptime_int result of runtime control flow.

fun f(c: Bool) -> Int
  x = 1 if c else 2
  return x

sub main()
  print(f(true))
  print(f(false))

# expect:
# 1
# 2
