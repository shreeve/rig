# A nested array type, `[2][3]Int`, is an array of arrays, as an array
# literal of arrays already is.
#
# Known bug: the type does not parse. The second `[` touches the first
# `]`, so the lexer reads it as an index: "unexpected `[`; expected a
# type".

fun corner(g: [2][3]Int) -> Int
  g[1][2]

sub main
  grid: [2][3]Int = [[1, 2, 3], [4, 5, 6]]
  print(corner(grid), grid[0])

# expect:
# 6 [1, 2, 3]
