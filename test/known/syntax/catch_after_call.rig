# `f() catch 0` recovers from a failure of `f()` with 0; here `may`
# succeeds, so the result is its value.
# Known bug: it parses to (catch (call may) _ 0), but emit has no lowering
# for `catch` and writes a `@compileError` placeholder.

fun may() -> Int!
  return 42

sub main()
  y = may() catch 0
  print(y)

# expect:
# 42
