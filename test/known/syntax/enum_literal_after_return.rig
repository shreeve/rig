# `return .red` returns the enum literal `.red` of the declared return
# type.
# Known bug (B10): it parses, but emit's match lowering adds an `else`
# prong to the exhaustive switch and Zig rejects it as unreachable.

enum Color
  red
  green

fun pick(b: Bool) -> Color
  if b
    return .red
  return .green

sub main()
  match pick(true)
    .red => print(1)
    .green => print(2)
  match pick(false)
    .red => print(1)
    .green => print(2)

# expect:
# 1
# 2
