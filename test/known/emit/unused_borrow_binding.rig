# Known bug (new, emit): a borrow binding that is never read is emitted as a
# plain Zig `const`, which Zig rejects as "unused local constant".
# Dropping the read borrow `r` releases it, so the write borrow `w` is
# allowed.

struct User
  name: String

sub main()
  user = User(name: "Steve")
  r = ?user
  -r
  w = !user
  print("ok")

# expect:
# ok
