# `x = ...` inside a nested block assigns the enclosing binding.
# Known bug (new, emit): emit's reassignment pre-scan (`scanMutations`)
# tracks each block separately, so `x` is declared `const` and Zig
# rejects the assignment. Sema records the fact as
# `Symbol.flags.reassigned` (reachable through `ctx.symbolOf(leaf)`).

sub main()
  x = 1
  if x > 0
    x = 2
  print(x)

# expect:
# 2
