# Reading a field through the element of `for n in ?xs`, where `xs` holds
# `*Node` handles, auto-derefs the handle.
# Known bug (new, emit): the element is not recognized as a shared handle,
# so `n.v` is emitted without `.value`. Sema types `n` as `?*Node`
# (`ctx.typeOf(n)`).

struct Node
  v: Int

sub main()
  xs: Vec(*Node) = Vec()
  a = *Node(v: 7)
  (!xs).push(<a)
  for n in ?xs
    print(n.v)

# expect:
# 7
