# `return 1 if c` returns only when `c` holds; otherwise execution
# continues to `return 2`.
# Known bug (A1): the guard is parsed but emit ignores it, so the return
# is unconditional and the emitted Zig fails to compile (unreachable code).

fun f(c: Bool) -> Int
  return 1 if c
  return 2

sub main()
  print(f(true))
  print(f(false))

# expect:
# 1
# 2
