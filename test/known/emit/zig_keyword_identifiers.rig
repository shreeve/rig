# `var` and `fn` are not Rig keywords, so they are ordinary local names;
# emit must escape identifiers that collide with Zig keywords.
# Known bug (A8): they are emitted unescaped (`const var = 3;`) and the
# Zig compiler rejects the program.

sub main()
  var = 3
  fn = 2
  print(var + fn)

# expect:
# 5
