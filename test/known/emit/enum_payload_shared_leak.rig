# Known bug (C6): an enum variant carrying a shared handle has no drop
# glue, so the `*Box` payload is never released. Today the output is
# right but the leak check fails.

struct Box
  payload: Int

enum Slot
  full(b: *Box)
  empty

sub main()
  rc = *Box(payload: 5)
  s: Slot = .full(b: <rc)
  match s
    .full(b) => print(1)
    .empty => print(0)

# expect:
# 1
