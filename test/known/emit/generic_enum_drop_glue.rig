# Known bug (D10): generic enums get no drop glue, so a `Maybe(*Noisy)`
# holding a handle never drops it: the Noisy is never dropped and leaks.

enum Maybe(T)
  some(value: T)
  none

struct Noisy
  id: Int

  drop self: !Noisy
    print(self.id)

sub main()
  n = *Noisy(id: 6)
  m: Maybe(*Noisy) = .some(value: <n)
  match m
    .some => print("some")
    .none => print("none")

# expect:
# some
# 6
