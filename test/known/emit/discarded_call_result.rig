# Known bug (new, emit): a call whose Int result is discarded as a statement
# is emitted without `_ =`, and Zig rejects "value of type 'i32' ignored".
# Moving a Copy value (`<n`) copies it, so `n` stays usable.

fun consume(n: Int) -> Int
  n

sub main()
  n = 1
  consume <n
  print n

# expect:
# 1
