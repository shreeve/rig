# Moving a match payload binding out of an owned local scrutinee is
# allowed; it consumes the scrutinee.
# Known bug: emit keeps the scrutinee's drop armed after the payload
# moves out, so the handle is dropped twice (segfault).

struct Box
  payload: Int

  drop self: !Box
    print("drop")

enum Slot
  full(b: *Box)
  empty

sub eat(rc: *Box)
  print(rc.payload)

sub main()
  rc = *Box(payload: 5)
  s: Slot = .full(b: <rc)
  match s
    .full(b) => eat(<b)
    .empty => print(0)
  print("end")

# expect:
# 5
# drop
# end
