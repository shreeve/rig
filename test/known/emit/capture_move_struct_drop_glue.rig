# Known bug (D11): a closure that move-captures a struct with drop glue
# never drops it (capture cleanup only knows shared and weak handles), so
# Noisy's drop body never runs.

struct Noisy
  id: Int

  drop self: !Noisy
    print(self.id)

sub main()
  n = Noisy(id: 7)
  f = |<n|
    print(n.id + 1)
  f()
  print("end")
  # scope exit drops `f`, which drops the captured Noisy: prints 7

# expect:
# 8
# end
# 7
