# Known bug (new, emit): binding an error-set value `e: NetworkError =
# .timeout` is accepted by sema, but the emitted Zig assigns an enum
# literal to an error set and fails to compile.

error NetworkError
  timeout
  refused
  reset

sub main()
  e: NetworkError = .timeout
  match e
    .timeout => print("timeout")
    .refused => print("refused")
    .reset => print("reset")

# expect:
# timeout
