# Known bug (D16): a method call through a generic struct's field of
# shared type (`h.value.get()`) is not auto-dereferenced, so the Zig fails
# to compile (no `get` on `RcBox`).

type Holder(T)
  value: T

sub main()
  c: *Cell(Int) = *Cell(value: 8)
  h: Holder(*Cell(Int)) = Holder(value: <c)
  print(h.value.get())

# expect:
# 8
