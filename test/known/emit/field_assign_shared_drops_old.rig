# Known bug (D7): assigning a shared handle into a struct field is dropped
# by the emitter: the old Noisy is not released at the assignment and the
# struct keeps it. Correct: 1 drops at the assignment, 2 when `p` drops.

struct Noisy
  id: Int

  drop self: !Noisy
    print(self.id)

struct Pair
  a: *Noisy

sub main()
  p = Pair(a: *Noisy(id: 1))
  n = *Noisy(id: 2)
  p.a = <n
  print("assigned")

# expect:
# 1
# assigned
# 2
