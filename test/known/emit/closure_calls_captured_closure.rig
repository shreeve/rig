# Known bug (D15): calling a captured `*Closure()` inside another closure
# (`|+inc| inc()`) is not lowered to `.value.invoke()`, so the Zig fails
# to compile ("not a function").

sub main()
  count: *Cell(Int) = *Cell(value: 0)
  inc: *Closure() = *Closure(|+count| count.set(count.get() + 1))
  twice = |+inc|
    inc()
  twice()
  twice()
  print(count.get())

# expect:
# 2
