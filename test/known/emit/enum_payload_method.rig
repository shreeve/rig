# Known bug: a method declared inside an enum with payload variants is
# also emitted as a union member of the same name, so Zig rejects the
# program with "duplicate union member name".

enum Shape
  circle(radius: Int)
  point

  fun is_point(?self) -> Bool
    match self
      .circle(r) => false
      .point => true

sub main()
  s: Shape = .circle(radius: 2)
  print(s.is_point())
  p: Shape = .point
  print(p.is_point())

# expect:
# false
# true
