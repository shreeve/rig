# Known bug (D7): a `!self` receiver is lowered as a by-value `self`, so
# mutation through it cannot reach the caller; pushing to `self.items`
# fails to compile (`*const Vec` where `*Vec` is needed).

struct Bag
  items: Vec(Int)

  sub add(!self, x: Int)
    (!self.items).push(x)

sub main()
  v: Vec(Int) = Vec()
  b = Bag(items: <v)
  (!b).add(4)
  (!b).add(5)
  print(b.items.length())

# expect:
# 2
