# Known bug: built with --release on aarch64 (macOS), the checked `+=`
# of two `Simd[U8, 64]`s panics with "integer overflow" though no lane
# overflows; a debug build prints 482, and `+%=` prints 482 in both. The
# check Zig makes for the vector add is what fails: the same Zig with
# `+%=` runs, and a plain Zig program doing the same add has not
# reproduced it yet. Found while trying 64-lane blocks for std.utf8's
# counting, which uses four `Simd[U8, 16]`s instead.
# release
type Wide = Simd[U8, 64]

fun sum(v: Wide) -> Int
  n = 0
  for x in v.array()
    n += Int(x)
  n

sub main()
  s = String()
  for k in 0..640
    !s.push(U8((k * 37) % 256))
  t = ?s[..]
  acc = Wide.splat(0)
  i = 0
  while i + 64 <= t.len : i += 64
    v = t.read[Wide](i)
    acc += ((v < 0x80) | (v >= 0xC0)).select(Wide.splat(1), Wide.splat(0))
  print(sum(acc))

# expect:
# 482
