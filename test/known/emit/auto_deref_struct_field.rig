# Known bug (D16): field reads and method calls through a local struct's
# shared-handle field (`p.a.n`, `p.a.twice()`) are not auto-dereferenced,
# so the Zig fails to compile (no field `n` on `RcBox`). The same access
# through `self` in a method works.

struct Box
  n: Int

  fun twice(self: ?Box) -> Int
    self.n * 2

struct Pair
  a: *Box

sub main()
  b = *Box(n: 4)
  p = Pair(a: <b)
  print(p.a.n)
  print(p.a.twice())

# expect:
# 4
# 8
