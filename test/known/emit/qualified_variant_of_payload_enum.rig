# `Shape.point` names a bare variant of an enum whose other variants
# carry payloads; bound without an annotation it is a `Shape`, so its
# methods can be called.
#
# Bug: emit lowers it to Zig `Shape.point`, which for a tagged union is
# the tag enum, not the union, so `c.area()` fails to compile ("no field
# or member function named 'area'").

enum Shape
  circle(radius: Int)
  point

  fun area(?self) -> Int
    match self
      .circle(r) => 3 * r * r
      .point => 0

sub main()
  c = Shape.point
  print(c.area(), c)

# expect:
# 0 .point
