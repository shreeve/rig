# Known bug (new, emit): a value-position match arm that destructures a
# multi-field payload (`.triangle(a, b) => a + b`) discards the arm's
# value, and Zig rejects "value of type 'i32' ignored".

enum Shape
  circle(radius: Int)
  triangle(a: Int, b: Int)

fun measure(s: Shape) -> Int
  match s
    .circle(r) => r
    .triangle(a, b) => a + b

sub main()
  s: Shape = .triangle(a: 3, b: 4)
  print(measure(s))

# expect:
# 7
