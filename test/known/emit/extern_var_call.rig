# Known bug (new, emit): an extern declared in the `name: fun(...)` form
# is accepted by sema but never emitted, so the call inside `raw` fails
# with Zig "use of undeclared identifier".

extern abs: fun(Int) Int

sub print_abs(n: Int)
  raw
    print(abs(n))

sub main()
  print_abs(-5)

# expect:
# 5
