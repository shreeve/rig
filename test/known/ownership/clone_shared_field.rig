# Known bug (emit): `+p.a` on a shared-handle field is emitted as a plain
# copy of the field (no `cloneStrong`), so the handle is dropped twice.
# The ownership checker accepts it (and suggests it for `x = p.a`).

struct Box
  payload: Int

  drop self: !Box
    print("drop")

struct Pair
  a: *Box

sub main()
  p = Pair(a: *Box(payload: 1))
  x = +p.a
  print(x.payload)

# expect:
# 1
# drop
