# Building a second view from the write borrow a first view holds would
# give two live mutable paths to the same Vec; here the second iterates
# while the first pushes, reading a freed buffer. Currently accepted and
# crashes.

struct Ed
  t: !Vec(Int)

sub main()
  v: Vec(Int) = Vec()
  (!v).push(1)
  (!v).push(2)
  (!v).push(3)
  if true
    e = Ed(t: !v)
    f = Ed(t: e.t)
    for x in ?f.t
      (!e.t).push(x)
  print(v.length())

# error: would duplicate a write borrow
