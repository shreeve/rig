# Known bug (C1): the loop body is walked once, so `-rc` inside a `while`
# body is not seen by the next iteration's read. Today this is accepted
# and the second iteration segfaults on the freed handle.

struct Box
  payload: Int

sub main()
  rc = *Box(payload: 42)
  i = 0
  while i < 2
    print(rc.payload)
    -rc
    i += 1

# error: use of `rc` after drop
