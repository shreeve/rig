# Known bug (C2): moving a field out of a `?self` receiver is accepted.
# The caller still owns and drops `p.a`, so today this double-frees
# (segfault after "back").

struct Box
  payload: Int

struct Pair
  a: *Box

  sub take(?self)
    x = <self.a
    print(x.payload)

sub main()
  p = Pair(a: *Box(payload: 1))
  p.take()
  print("back")

# error: cannot move out of
