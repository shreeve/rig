# Known bug (C2): moving a field out of a read-borrowed parameter is
# accepted (only the root is marked moved). The caller still owns and
# drops `p.a`, so today this double-frees (segfault after "back").

struct Box
  payload: Int

struct Pair
  a: *Box

sub eat(rc: *Box)
  print(rc.payload)

sub steal(p: ?Pair)
  eat(<p.a)

sub main()
  p = Pair(a: *Box(payload: 1))
  steal(?p)
  print("back")

# error: cannot move out of
