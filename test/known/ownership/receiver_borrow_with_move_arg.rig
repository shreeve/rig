# Known bug (C5): a method call's receiver takes no temporary read borrow,
# so `rc.show(<rc)` moves `rc` while it is the receiver. The free-function
# form `show(?rc, <rc)` is rejected. Today this segfaults.

struct Inner
  x: Int

struct Box
  inner: *Inner

  sub show(?self, other: *Box)
    -other
    y = +self.inner
    print(y.x)

sub main()
  rc = *Box(inner: *Inner(x: 5))
  rc.show(<rc)

# error: cannot move `rc` while it is read-borrowed
