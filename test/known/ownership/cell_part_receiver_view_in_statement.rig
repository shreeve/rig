# Known bug: a `?self` method called on a Cell-holding field of a
# temporary its statement does not keep in a slot runs on a copy of the
# field in the call's block, and a view it returns is read after that
# block ends, from dead storage (garbage under the sanitizer's stack
# poisoning). The temporary must live, in a slot, until the statement
# ends.

struct Q
  c: Cell[Int]
  n: Int

  fun me(?self) -> ?Q
    self

struct H
  q: Q

fun mkh -> H
  H(q: Q(c: Cell(1), n: 42))

sub main
  print(mkh().q.me().n)

# expect:
# 42
