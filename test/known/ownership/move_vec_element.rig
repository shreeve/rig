# Known bug (C2): moving an element out of a Vec by index (`<v[0]`) is
# accepted; the Vec still owns and drops the slot. Today `rig check`
# accepts this.

sub eat(c: *Cell(Int))
  print(c.get())

sub main()
  c1: *Cell(Int) = *Cell(value: 7)
  v: Vec(*Cell(Int)) = Vec()
  (!v).push(<c1)
  eat(<v[0])

# error: cannot move out of
