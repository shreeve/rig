# Known bug (C3): the alias rule only checks bare names, so a shared
# handle chosen by a match expression is copied without a refcount bump.
# Today `rig check` accepts this.

struct Box
  payload: Int

sub main()
  rc = *Box(payload: 5)
  n = 1
  x = match n
    1 => rc
    _ => rc
  print(x.payload)

# error: would alias the handle
