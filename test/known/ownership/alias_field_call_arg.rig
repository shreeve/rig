# Known bug (C3): the alias rule only checks bare names, so passing the
# field `o.inner` as an owned argument hands the callee the handle without
# a refcount bump. Today this is accepted and the second drop panics.

struct Box
  payload: Int

struct Outer
  inner: *Box

sub eat(rc: *Box)
  print(rc.payload)

sub main()
  b = *Box(payload: 7)
  o = *Outer(inner: <b)
  eat(o.inner)
  eat(o.inner)

# error: would alias the handle
