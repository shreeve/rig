# A value that branches, read where its leaves are, whose made leaf is a
# `catch` handler's value: the leaf lives in its statement's slot, which
# emit declares for the statement, and the read is within the statement.
# Known bug: the ownership checker scopes the handler's temporaries to the
# handler, so it reports "a view of the temporary `mk(7)` outlives its
# statement". It does so for a type that needs cleanup, and for any type
# that holds a Cell, whose leaves are always kept in the slot.

error E
  bad

struct N
  c: Cell[Int]

struct D
  c: Cell[Int]

  drop(!self)
    print("drop", self.c.get())

fun mkn(n: Int) -> N
  N(c: Cell(n))

fun mknf(n: Int) -> N!
  return E.bad if n < 0
  mkn(n)

fun mkd(n: Int) -> D
  D(c: Cell(n))

fun mkdf(n: Int) -> D!
  return E.bad if n < 0
  mkd(n)

sub go(k: Bool)
  n = mkn(2)
  print((n if k else (mknf(-1) catch mkn(7))).c.get())
  d = mkd(3)
  print((d if k else (mkdf(-1) catch mkd(8))).c.get())

sub main()
  go(true)
  go(false)

# expect:
# 2
# 3
# drop 3
# 7
# 8
# drop 8
# drop 3
