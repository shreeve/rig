# Known bug (C7): a local lambda `|<rc|` move-captures a read-borrowed
# parameter, taking ownership of a handle the caller still owns. Today
# `rig check` accepts this.

struct Box
  payload: Int

sub f(rc: ?*Box)
  g = |<rc|
    print(rc.payload)
  g()

sub main()
  rc = *Box(payload: 5)
  f(?rc)
  print(rc.payload)

# error: cannot move-capture borrowed
