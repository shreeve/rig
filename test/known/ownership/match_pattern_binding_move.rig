# Known bug (C8): pattern bindings are unknown to the ownership checker,
# so moving the payload binding `b` out of a match arm is rejected today
# with "use of unbound name `b`".

struct Box
  payload: Int

  drop self: !Box
    print("drop")

enum Slot
  full(b: *Box)
  empty

sub eat(rc: *Box)
  print(rc.payload)

sub main()
  rc = *Box(payload: 5)
  s: Slot = .full(b: <rc)
  match s
    .full(b) => eat(<b)
    .empty => print(0)
  print("end")

# expect:
# 5
# drop
# end
