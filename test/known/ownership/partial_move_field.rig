# Known bug (C2): after moving `p.a` out of a local struct, the struct's
# drop glue still drops `a` along with `b`. Today the output is right up
# to "after", then the second drop of `a` segfaults.

struct Box
  payload: Int

  drop self: !Box
    print(self.payload + 100)

struct Pair
  a: *Box
  b: *Box

sub eat(rc: *Box)
  print(rc.payload)

sub main()
  p = Pair(a: *Box(payload: 1), b: *Box(payload: 2))
  eat(<p.a)
  print("after")

# expect:
# 1
# 101
# after
# 102
