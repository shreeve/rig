# Known bug (C3): inside a `|+count|` closure, `y = count` is rejected,
# but the same alias through an if-expression is not. Today this is
# accepted; each call drops the captured handle, and the program segfaults.

sub main()
  count: *Cell(Int) = *Cell(value: 0)
  f = |+count|
    y = if true
      count
    else
      count
    print(y.get())
  f()
  f()

# error: bare use of captured resource `count`
