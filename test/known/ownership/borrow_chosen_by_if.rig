# Known bug (C4): a borrow produced by an if-expression is not tracked, so
# `-h` is accepted while `r` is still used. Today this segfaults.

struct Box
  payload: Int

struct Holder
  inner: *Box

sub main()
  h = Holder(inner: *Box(payload: 5))
  r = if true
    ?h
  else
    ?h
  -h
  x = +r.inner
  print(x.payload)

# error: cannot drop `h` while borrows are live
