# Known bug (C4): rebinding a borrow to a value from an inner block lets
# it outlive that value. Today `rig check` accepts this.

struct Box
  payload: Int

sub main()
  a = Box(payload: 1)
  r = ?a
  if true
    b = Box(payload: 2)
    r = ?b
  print(r.payload)

# error: `b` does not live long enough
