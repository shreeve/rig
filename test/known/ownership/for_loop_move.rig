# Known bug (C1): a `for` body is walked once, so a move inside it is not
# seen by the next iteration. Today `rig check` accepts this.

struct Box
  payload: Int

sub eat(rc: *Box)
  print(rc.payload)

sub main()
  rc = *Box(payload: 1)
  for i in 0..3
    eat(<rc)

# error: use of `rc` after move
