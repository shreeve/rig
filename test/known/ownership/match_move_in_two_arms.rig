# Known bug (emit): the ownership checker accepts moving `rc` in each of
# two match arms (arms are checked independently), but emit lowers the
# `_` arm to a second `else` prong: "multiple else prongs in switch
# expression".

struct Box
  payload: Int

sub eat(rc: *Box)
  print(rc.payload)

sub go(n: Int)
  rc = *Box(payload: n)
  match n
    1 => eat(<rc)
    _ => eat(<rc)

sub main()
  go(1)
  go(2)

# expect:
# 1
# 2
