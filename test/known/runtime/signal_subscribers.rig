# Known bug (D1): `Signal.subscribe` clones the handle the caller already
# cloned with `+cb`, so each subscriber's refcount never reaches zero and
# all three closures (and the cell they capture) leak. Output is correct;
# the leak check fails.

sub main()
  notes: *Cell(Int) = *Cell(value: 0)
  one:   *Closure() = *Closure(|+notes| notes.set(notes.get() + 1))
  ten:   *Closure() = *Closure(|+notes| notes.set(notes.get() + 10))
  cent:  *Closure() = *Closure(|+notes| notes.set(notes.get() + 100))

  sig: *Signal(Int) = *Signal(value: 0)
  sig.subscribe(+one)
  sig.subscribe(+ten)
  sig.subscribe(+cent)

  print(notes.get())                # 0: no notification yet
  sig.set(1)                        # calls all three: 0 -> 111
  print(notes.get())                # 111
  sig.set(2)                        # again: 111 -> 222
  print(notes.get())                # 222

# expect:
# 0
# 111
# 222
