# Known bug (D1): two reactive sources chained by a multi-capture closure
# (count -> total -> print) produce the right output but leak: `body_a`
# captures `count` and `body_b` captures `total`, and each source's list
# holds its subscriber, forming strong Rc cycles. Safe Rig cannot write this
# cycle-free until a weak capture's `upgrade()` result can be unwrapped.

struct IntSource
  value: *Cell(Int)
  subs: *Cell(Vec(*Closure()))

  fun new(initial: Int) -> *IntSource
    val: *Cell(Int) = *Cell(value: initial)
    empty: Vec(*Closure()) = Vec()
    subs_cell: *Cell(Vec(*Closure())) = *Cell(value: <empty)
    *IntSource(value: <val, subs: <subs_cell)

  fun get(self: ?IntSource) -> Int
    self.value.get()

  sub subscribe(self: ?IntSource, cb: *Closure())
    empty: Vec(*Closure()) = Vec()
    current: Vec(*Closure()) = self.subs.replace(<empty)
    (!current).push(+cb)
    discarded: Vec(*Closure()) = self.subs.replace(<current)

  sub set(self: ?IntSource, v: Int)
    self.value.set(v)
    empty: Vec(*Closure()) = Vec()
    current: Vec(*Closure()) = self.subs.replace(<empty)
    for cb in ?current
      cb()
    discarded: Vec(*Closure()) = self.subs.replace(<current)

sub main()
  count = IntSource.new(0)
  total = IntSource.new(0)

  body_a: *Closure() = *Closure(|+count, +total| total.set(count.get() * 10))
  count.subscribe(+body_a)

  body_b: *Closure() = *Closure(|+total| print(total.get()))
  total.subscribe(+body_b)

  count.set(1)        # total becomes 10, prints 10
  count.set(7)        # total becomes 70, prints 70
  print(total.get())  # 70

# expect:
# 10
# 70
# 70
