# Known bug (C6, D9): the `(*T)?` returned by `w.upgrade()` gets no drop
# guard. Here `m` is otherwise unused, so the emitted Zig fails to compile
# ("unused local constant"); when `m` is used, the strong handle it holds
# leaks. Correct: `m` is dropped at scope exit, running Noisy's drop body.

struct Noisy
  id: Int

  drop self: !Noisy
    print(self.id)

sub main()
  rc = *Noisy(id: 1)
  w  = ~rc
  m = w.upgrade()
  -rc
  print("rc dropped")               # `m` still holds the Noisy
  -w
  # scope exit drops `m`, the last strong handle: prints 1

# expect:
# rc dropped
# 1
