# Known bug (D1): the reactive substrate end to end (Cell, stack and owned
# closures, Vec of closures, Signal) prints the right values but leaks:
# `Signal.subscribe` clones the handle the caller already cloned with `+`,
# so every subscriber leaks. The `log` subscriber also captures `sig`, which
# holds `log`, a strong cycle that leaks even once D1 is fixed.

sub main()
  # Cell interior mutability through a shared handle.
  count: *Cell(Int) = *Cell(value: 0)
  count.set(1)
  print(count.get())                # 1

  # Stack closure clone-capturing the cell.
  bump = |+count|
    count.set(count.get() + 1)
  bump()
  bump()
  print(count.get())                # 3

  # Owned (escapable) closure.
  eff: *Closure() = *Closure(|+count| count.set(count.get() + 10))
  eff()
  print(count.get())                # 13

  # Signal: `set` stores the value and calls every subscriber.
  sig: *Signal(Int) = *Signal(value: 0)
  log: *Closure() = *Closure(|+sig| print(sig.get()))
  sig.subscribe(+log)
  sig.set(7)                        # 7
  sig.set(99)                       # 99

  # Walking a Vec of closures by borrowed slot.
  notes: *Cell(Int) = *Cell(value: 0)
  one:   *Closure() = *Closure(|+notes| notes.set(notes.get() + 1))
  ten:   *Closure() = *Closure(|+notes| notes.set(notes.get() + 10))
  cent:  *Closure() = *Closure(|+notes| notes.set(notes.get() + 100))
  subs: Vec(*Closure()) = Vec()
  (!subs).push(+one)
  (!subs).push(+ten)
  (!subs).push(+cent)
  for cb in ?subs
    cb()
  print(notes.get())                # 111 (1 + 10 + 100)

  # Signal with several subscribers, called in subscription order.
  tally: *Cell(Int) = *Cell(value: 0)
  add_a: *Closure() = *Closure(|+tally| tally.set(tally.get() + 1))
  add_b: *Closure() = *Closure(|+tally| tally.set(tally.get() + 10))
  add_c: *Closure() = *Closure(|+tally| tally.set(tally.get() + 100))
  multi: *Signal(Int) = *Signal(value: 0)
  multi.subscribe(+add_a)
  multi.subscribe(+add_b)
  multi.subscribe(+add_c)
  multi.set(42)                     # tally 0 -> 111
  print(tally.get())                # 111

# expect:
# 1
# 3
# 13
# 7
# 99
# 111
# 111
