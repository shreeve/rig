# Known bug (D1): a userland reactive source (`*Cell` value plus a
# `*Cell(Vec(*Closure()))` subscriber list) notifies on `set` correctly but
# leaks: `body` captures `count` strongly while `count`'s list holds `body`,
# a strong Rc cycle. A `|~count|` capture would avoid it, but the `(*T)?`
# from `upgrade()` cannot be unwrapped yet, so safe Rig has no cycle-free form.

struct IntSource
  value: *Cell(Int)
  subs: *Cell(Vec(*Closure()))

  fun new(initial: Int) -> *IntSource
    val: *Cell(Int) = *Cell(value: initial)
    empty: Vec(*Closure()) = Vec()
    subs_cell: *Cell(Vec(*Closure())) = *Cell(value: <empty)
    *IntSource(value: <val, subs: <subs_cell)

  fun get(self: ?IntSource) -> Int
    self.value.get()

  # A Cell holding a Vec gives no borrowed access, so the list is swapped
  # out with `replace`, pushed to, and swapped back.
  sub subscribe(self: ?IntSource, cb: *Closure())
    empty: Vec(*Closure()) = Vec()
    current: Vec(*Closure()) = self.subs.replace(<empty)
    (!current).push(+cb)
    discarded: Vec(*Closure()) = self.subs.replace(<current)

  sub set(self: ?IntSource, v: Int)
    self.value.set(v)
    empty: Vec(*Closure()) = Vec()
    current: Vec(*Closure()) = self.subs.replace(<empty)
    for cb in ?current
      cb()
    discarded: Vec(*Closure()) = self.subs.replace(<current)

sub main()
  count = IntSource.new(0)
  body: *Closure() = *Closure(|+count| print(count.get()))
  count.subscribe(+body)
  count.set(1)
  count.set(7)

# expect:
# 1
# 7
