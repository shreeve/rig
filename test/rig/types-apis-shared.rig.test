test "apis object shared names its type", '''
  *{Shape}
  ~{Shape + Print}
  *{Shape + Syncs}
'''
  api Shape
    fun area(?@) -> Float

  type S = *{Shape}
  type W = ~{Shape + Print}
  type F = *{Shape + Syncs}

  sub show[T]()
    print($name(T))

  show[S]()
  show[W]()
  show[F]()

# ---- rejections ----

