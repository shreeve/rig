test "apis object shared a channel of frozen objects", seeds: 20, "6.0"
  # A `*{A + Syncs}` goes to any task: a channel's elements move.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side

  type S = *{Shape + Syncs}

  sub feed(ch: *Chan[S])!
    for i in 1..4
      !ch.send(*Frozen(Square(side: Float(i))))!
    !ch.close()

  fun drain(ch: *Chan[S]) -> Float!
    t = feed(+ch)&
    n = 0.0
    while (!ch).recv()! as s
      n += s.area()
    >t!
    n

  ch = *Chan[S](2)
  print(drain(+ch) catch 0.0)

