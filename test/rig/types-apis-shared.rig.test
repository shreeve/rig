# types: tests whose names start `apis object shared`: a counted API
# object, `*{Shape}`, and its weak handle, `~{Shape}` (docs/design/apis.md,
# Stage 5).

test "apis object shared a weak handle and the last drop", '''
  4.0
  gone
'''
  # Core §4's example: `~s` holds the value weakly, `*w` gives a new
  # count while it lives and `none` after its last count is dropped.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  s: *{Shape} = *Square(side: 2.0)
  w = ~s
  if *w as h
    print(h.area())
  <s
  if *w as h
    print("still here")
  else
    print("gone")

test "apis object shared a fallible result erases its last expression", "4.0 9.0"
  # Through a result's `!`, a handle is erased as where a `*{Shape}`
  # itself goes (`erasureTarget`).
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  error Bad
    oops

  fun counted(n: Int) -> (*{Shape})!
    return Bad.oops if n < 0
    *Square(side: 2.0)

  fun frozen(n: Int) -> (*{Shape + Syncs})!
    return Bad.oops if n < 0
    *Frozen(Square(side: 3.0))

  a = counted(1) catch return
  b = frozen(1) catch return
  print(a.area(), b.area())

fail "apis object shared a fallible result keeps the erasure's rules", "a frozen value's handle is erased only to `*{Shape + Syncs}`, which counts atomically", errors: 1
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun counted() -> (*{Shape})!
    *Frozen(Square(side: 2.0))

  a = counted() catch return
  print(a.area())

test "apis object shared a frozen value read by two tasks", seeds: 20, "8.0"
  # Core §4's second example: a frozen value's handle counts atomically,
  # so a `*{Shape + Syncs}` of it goes to any task.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: *{Shape + Syncs}) -> Float
    s.area()

  s: *{Shape + Syncs} = *Frozen(Square(side: 2.0))
  a = area_of(+s)&
  b = area_of(+s)&
  print(>a + >b)

test "apis object shared a handle moved keeps its allocation", "4.0 4.0"
  # `<h` moves the `*Square` in, `+h` adds a count first: both keep the
  # allocation `*Square(...)` made.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  h = *Square(side: 2.0)
  t: *{Shape} = +h
  s: *{Shape} = <h
  print(s.area(), t.area())

test "apis object shared made where it goes", "9.0 1.0"
  # `*S(...)` and `*<x` written where a `*{Shape}` goes make the
  # allocation there, of the value's own type.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  sq = Square(side: 1.0)
  a: *{Shape} = *Square(side: 3.0)
  b: *{Shape} = *<sq
  print(a.area(), b.area())

test "apis object shared counts", '''
  3
  2
  1
'''
  # `+s` adds a count through the table, and a drop gives one back.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun count(w: ?~{Shape}) -> Int
    n = 0
    if *w as h
      n = 1
    n

  s: *{Shape} = *Square(side: 1.0)
  t = +s
  u = +t
  w = ~s
  print(count(?w) + 2)
  <u
  print(count(?w) + 1)
  <t
  print(count(?w))

test "apis object shared a List of two types with a shared element", "4.0 3.14 4.0 3"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Circle: Shape
    r: Float

    fun area(?@) -> Float
      3.14 * @r * @r

  sq: *{Shape} = *Square(side: 2.0)
  shapes: List[*{Shape}] = List()
  !shapes.push(+sq)
  !shapes.push(*Circle(r: 1.0))
  !shapes.push(<sq)
  print(shapes[0].area(), shapes[1].area(), shapes[2].area(), shapes.len)

test "apis object shared changed through a Cell its value holds", "3"
  # A `*{A}` reaches `?@` methods only; one changes a shared Cell its
  # value holds by a marked call on a count of its own.
  api Tick
    sub tick(?@)
    fun count(?@) -> Int

  obj Counter: Tick
    hits: *Cell[Int]

    sub tick(?@)
      c = +@hits
      !c.set(c.get() + 1)

    fun count(?@) -> Int
      @hits.get()

  t: *{Tick} = *Counter(hits: *Cell(0))
  u = +t
  t.tick()
  u.tick()
  t.tick()
  print(u.count())

test "apis object shared a long chain drops without deep recursion", "100000 1 gone"
  # 100,000 `*{Node}` links, each with a weak handle to the root: the
  # last count of the head drops the chain through the drop queue a
  # `*T` uses, and each link's weak handle once.
  api Node
    fun depth(?@) -> Int

  obj Root: Node
    n: Int

    fun depth(?@) -> Int
      0

  obj Link: Node
    next: (*{Node})?
    root: ~{Node}

    fun depth(?@) -> Int
      1

  root: *{Node} = *Root(n: 0)
  head: (*{Node})? = none
  n = 0
  for 0..100000
    head = *Link(next: <head, root: ~root)
    n += 1
  d = 0
  if head as h
    d = h.depth()
  <head
  w = ~root
  <root
  gone = "alive"
  if *w as r
    gone = "still"
  else
    gone = "gone"
  print(n, d, gone)

test "apis object shared a plugin registry frozen and read by two tasks", seeds: 20, "6 6"
  # The reviewer's fix 2: a frozen value holds `*{A + Syncs}` handles,
  # another frozen value's, so a registry of plugins is frozen whole.
  api Plugin
    fun run(?@, n: Int) -> Int

  obj Double: Plugin
    k: Int

    fun run(?@, n: Int) -> Int
      n * @k

  obj Add: Plugin
    k: Int

    fun run(?@, n: Int) -> Int
      n + @k

  fun total(reg: *Frozen[List[*{Plugin + Syncs}]]) -> Int
    n = 1
    for i in 0..reg.len
      n = reg[i].run(n)
    n

  ps: List[*{Plugin + Syncs}] = List()
  !ps.push(*Frozen(Double(k: 2)))
  !ps.push(*Frozen(Add(k: 4)))
  reg = *Frozen(<ps)
  a = total(+reg)&
  b = total(+reg)&
  print(>a, >b)

