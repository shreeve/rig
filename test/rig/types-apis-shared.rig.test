  # counts atomically.
  api Shape: Syncs
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: *{Shape}) -> Float
    s.area()

  s: *{Shape} = *Frozen(Square(side: 2.0))
  t = area_of(+s)&
  print(>t)

test "apis object shared generic erasures by their bounds", "4.0 9.0"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun share[T: Shape](h: *T) -> *{Shape}
    <h

  fun freeze[T: Shape + Syncs](h: *Frozen[T]) -> *{Shape + Syncs}
    <h

  a = share(*Square(side: 2.0))
  b = freeze(*Frozen(Square(side: 3.0)))
  print(a.area(), b.area())

test "apis object shared weak handles counted", "true false"
  # `+w` makes another weak handle; each is dropped once.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun alive(w: ?~{Shape}) -> Bool
    if *w as h
      return true
    false

  s: *{Shape} = *Square(side: 2.0)
  w = ~s
  v = +w
  a = alive(?v)
  <s
  print(a, alive(?w))

