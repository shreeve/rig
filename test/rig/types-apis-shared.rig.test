test "apis object shared lends the read view it holds", "4.0 8.0"
  # `?s` lends the `?{Shape}` the handle holds, the same two words.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape}) -> Float
    s.area()

  fun twice(s: ?*{Shape}) -> Float
    area_of(?s) * 2.0

  s: *{Shape} = *Square(side: 2.0)
  print(area_of(?s), twice(?s))

test "apis object shared lent to write is the handle", "1.0"
  # `!s` lends the handle itself: the callee may put another in its
  # place, erased where it is written.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Circle: Shape
    r: Float

    fun area(?@) -> Float
      @r

  sub replace(s: !*{Shape})
    s = *Circle(r: 1.0)

  s: *{Shape} = *Square(side: 2.0)
  replace(!s)
  print(s.area())

test "apis object shared optional handles", "4.0 none"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: (*{Shape})?) -> Float?
    if s as h
      return h.area()
    none

  h: (*Square)? = *Square(side: 2.0)
  a: (*{Shape})? = <h
  b: (*{Shape})? = none
  print(area_of(<a), area_of(<b))

test "apis object shared a field and a drop body", '''
  4.0
  dropped
  done
'''
  # The hidden value's `drop` body runs at the last count's drop.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

    drop(!@)
      print("dropped")

  obj Holder
    s: *{Shape}

  h = Holder(s: *Square(side: 2.0))
  t = +h.s
  <h
  print(t.area())
  <t
  print("done")

test "apis object shared by the API's bound", seeds: 20, "4.0"
