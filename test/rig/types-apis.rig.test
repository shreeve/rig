  wraps.Wrap(x: 4).show()
  print(wraps.inside())

  file "shapes.rig"
    pub api Shape
      fun area(?@) -> Float

    add Int: Shape
      fun area(?@) -> Float
        Float(@)

  file "wraps.rig"
    use shapes

    pub obj Wrap[T]
      pub x: T

    pub fun Wrap[T: shapes.Shape].doubled(?@) -> Float
      2.0 * @x.area()

    pub sub Wrap[T: Print].show(?@)
      print("show", @x)

    pub fun inside() -> Float
      Wrap(x: 3).doubled()

test "apis own add with value parameters", "9.0 4.0\n24.0\n5.0"
  # `Slot[n]`, `Table[T, n]`, and a type of the program's with a value
  # parameter: an addition names `n` as it names `T`, and its methods
  # read it.

  api Shape
    fun area(?@) -> Float

  add Slot[n]: Shape
    fun area(?@) -> Float
      Float(Int(@)) + Float(n)

  add Table[T, n]: Shape
    fun area(?@) -> Float
      Float(@len * 10 + n)

  obj Ring[T, n: Int]
    xs: List[T]

  add Ring[T: Shape, n]: Shape
    fun area(?@) -> Float
      Float(n)

  fun total[T: Shape](xs: ?List[T]) -> Float
    t = 0.0
    for x in xs
      t += x.area()
    t

  t: Table[Int, 4] = Table()
  s = (!t).push(7)
  s2 = (!t).push(8)
  ss = List([s, s2])
  print(total(?ss), s.area())
  ts: List[Table[Int, 4]] = List()
  !ts.push(<t)
  print(total(?ts))
  rs: List[Ring[Slot[3], 5]] = List()
  !rs.push(Ring[Slot[3], 5](xs: List()))
  print(total(?rs))

test "apis own homes", '''
  3.0 2.0 5.0 1.0
  1.0 4.0 7.0
  2.0 1.0
'''
  # Each home of a conformance: a header in the type's module; an addition
  # in the API's module to a built-in type (`Int`, `String`, `List[T]`,
  # `Slot[n]`) and to a type of a third module; an addition under a bound
  # in the type's module.

  use shapes
  use geo
  use boxes

  obj Square: shapes.Shape
    side: Float

    pub fun area(?@) -> Float
      @side * @side

  fun total[T: shapes.Shape](x: ?T) -> Float
    x.area()

  t: Table[Int, 8] = Table()
  s = (!t).push(1)
  s = (!t).push(2)
  n = 3
  print(total(?n), total(?String("ab")), total(?List([1, 2, 3, 4, 5])), total(?s))
  print(total(?(geo.Circle(r: 1.0))), total(?Square(side: 2.0)), total(?(boxes.Box(x: 7))))
  print(total(?(boxes.Box(x: Square(side: 1.0)))) + 1.0, total(?(geo.Circle(r: 1.0))))

  file "shapes.rig"
    use geo

    pub api Shape
      fun area(?@) -> Float

    add Int: Shape
      fun area(?@) -> Float
        Float(@)

    add String: Shape
      fun area(?@) -> Float
        Float(@len)

    add List[T]: Shape
      fun area(?@) -> Float
        Float(@len)

    add Slot[n]: Shape
      fun area(?@) -> Float
        Float(Int(@))

    add geo.Circle: Shape
      fun area(?@) -> Float
        @r

  file "geo.rig"
    pub obj Circle
      pub r: Float

  file "boxes.rig"
    use shapes

    pub obj Box[T]
      pub x: T

    add Box[T: shapes.Shape]: shapes.Shape
      fun area(?@) -> Float
        @x.area()

