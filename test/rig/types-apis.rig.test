test "apis a call through a bound passes an addition's set", "3 -1 12"
  # A set parameter and a value parameter of an addition's methods, at
  # the instances a call through a bound makes.
  error Stop
    early

  api Each
    fun each[E](?@, f: ?fun(Int) -> Bool!E) -> Int!E

    fun times[n: Int](?@) -> Int

  add Int: Each
    fun each[E](?@, f: ?fun(Int) -> Bool!E) -> Int!E
      k = 0
      for i in 0..@
        f(i)!
        k += 1
      k

    fun times[n: Int](?@) -> Int
      a: [n]Int = [n of @]
      a[0] * n

  fun check(i: Int) -> Bool!Stop
    return Stop.early if i > 5
    true

  fun count[T: Each](x: ?T) -> Int!Stop
    x.each(check)!

  fun times[T: Each](x: ?T) -> Int
    x.times[3]()

  print(count(?3) catch -1, count(?9) catch -1, times(?4))

test "apis own generic witnesses", '''
  8.0 2.0 3.0
  area 8.0 area 2.0
'''
  # A generic type's witnesses are among its arguments, so `Box[Square]`
  # is one type; an addition under a bound reaches its own bound's.

  api Shape
    fun area(?@) -> Float

    fun describe(?@) -> String
      String("area ", @area())

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Wrap[T]
    x: T

  add Wrap[T: Shape]: Shape
    fun area(?@) -> Float
      2.0 * @x.area()

  obj Box[U: Shape]: Shape
    inner: U

    fun area(?@) -> Float
      @inner.area() + 1.0

  fun total[T: Shape](xs: ?List[T]) -> Float
    t = 0.0
    for x in xs
      t += x.area()
    t

  ws: List[Wrap[Square]] = List()
  !ws.push(Wrap(x: Square(side: 2.0)))
  bs: List[Box[Square]] = List()
  !bs.push(Box(inner: Square(side: 1.0)))
  bws: List[Box[Wrap[Square]]] = List()
  !bws.push(Box(inner: Wrap(x: Square(side: 1.0))))
  print(total(?ws), total(?bs), total(?bws))
  print(ws[0].describe(), bs[0].describe())

test "apis own type through its bound", '''
  5.0
  5.0
  close 2.0
  close 1.0
'''
  # A generic type's methods, its own `print` among them, call through
  # the bounds of its parameters.

  api Shape
    fun area(?@) -> Float

  api Closer
    sub close(!@)

  obj Square: Shape + Closer
    side: Float

    fun area(?@) -> Float
      @side * @side

    sub close(!@)
      print("close", @side)

  obj Bag[T: Shape + Closer]: Print
    items: List[T]

    fun total(?@) -> Float
      t = 0.0
      for x in @items
        t += x.area()
      t

    sub print(?@, out: !Printer)
      !out.value(@total())

    sub shut(!@)
      for x in !@items
        !x.close()

  fun make[T: Shape + Closer](x: T) -> Bag[T]
    b = Bag[T](items: List())
    !b.items.push(<x)
    b

  b = make(Square(side: 2.0))
  !b.items.push(Square(side: 1.0))
  print(b.total())
  print(b)
  !b.shut()

test "apis own across modules", '''
  4.0 3.0 3.0
  area 4.0 area 3.0 3.0
  9.0 32.0
'''
  # An API of another module: its defaults, its additions to a built-in
  # type and a third module's, and the shorthand on a type it reaches.

  use shapes
  use geo

  obj Square: shapes.Shape
    side: Float

    pub fun area(?@) -> Float
      @side * @side

  fun total[T: shapes.Shape](xs: ?List[T]) -> Float
    t = 0.0
    for x in xs
      t += x.area()
    t

  sub main()
    xs: List[Square] = List()
    !xs.push(Square(side: 2.0))
    cs: List[geo.Circle] = List()
    !cs.push(geo.Circle(r: 1.0))
    print(total(?xs), total(?cs), shapes.circles())
    print(xs[0].describe(), cs[0].describe(), cs[0].area())
    n = 3
    print(shapes.Shape.area(n), shapes.both(4))

  file "shapes.rig"
    use geo

    pub api Shape
      fun area(?@) -> Float

      fun describe(?@) -> String
        String("area ", @area())

    add geo.Circle: Shape
      fun area(?@) -> Float
        3.0 * @r * @r

    add Int: Shape
      fun area(?@) -> Float
        Float(@) * Float(@)

      fun describe(?@) -> String
        String("an int")

    fun count[T: Shape](xs: ?List[T]) -> Float
      t = 0.0
      for x in xs
        t += x.area()
      t

    pub fun circles() -> Float
      cs: List[geo.Circle] = List()
      !cs.push(geo.Circle(r: 1.0))
      count(?cs)

    pub fun both(n: Int) -> Float
      n.area() + Shape.area(n)

  file "geo.rig"
    pub obj Circle
      pub r: Float

