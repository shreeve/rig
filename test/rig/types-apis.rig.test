test "apis pub states its bounds with implied bounds", "true false 2 true"
  # A bound a signature's types already require counts as stated: `K`
  # named in `Map[K, V]` is `K: Hash` without saying it, whether or not
  # it has bounds of its own, and so is one named in a type whose field
  # does (`Index[K]`), declared before or after.

  pub fun has[K](ix: ?Index[K], k: ?K) -> Bool
    ix.m.has(k)

  obj Index[K]
    m: Map[K, Int]

  fun shown[K: Print, V](m: ?Map[K, V], k: ?K) -> Bool
    m.has(k)

  pub fun count[K, V](m: ?Map[K, V], k: ?K) -> Int
    m.len + (1 if k.hash() > 0 else 0)

  m: Map[Int, Int] = Map()
  !m.put(1, 1)
  ix = Index(m: Map[Int, Int]())
  !ix.m.put(1, 2)
  print(has(?ix, ?1), shown(?m, ?5), count(?m, ?1), ix.m.len == 1)

fail "apis pub states its bounds implied at each instance", "`Index[Float]` cannot use `K = Float`: `Float` cannot be hashed"
  # An implied bound is checked at each instance, as a written one is.

  obj Index[K]
    m: Map[K, Int]

  ix: Index[Float]? = none
  print(ix == none)

fail "apis pub states its bounds of a type declared later", "4:11: `pub obj W[T]` names `Index[T]`, which needs `K: Hash`: write `[T: Hash]`", "10:11: `pub fun f[T]` names `Index[T]`, which needs `K: Hash`: write `[T: Hash]`"
  # The bounds a type's signature implies are asked whatever the order
  # of the declarations, and the fix names the bound the type implies,
  # not one that bound implies in turn (`Hash` gives `Eq`).
  pub obj W[T]
    t: T

    pub fun m(?@, ix: ?Index[T]) -> Int
      1

  pub fun f[T](x: ?T) -> Int
    ix: Index[T]? = none
    1

  obj Index[K]
    m: Map[K, Int]

  w = W(t: 1)
  print(w.t, f(?1))

fail "apis pub states its bounds on lines of their own", "4:3: `pub fun pick[K, T]` copies a `T`: write `[T: Copy]`", whole: true
  # The error names the declaration on one line, without its comments.
  pub fun pick[
    K,
    T,  # the element, copied out [by value]
  ](m: ?Map[K, Int], xs: ?List[T]) -> T
    xs[0]

  sub main()
    l: List[Int] = List()
    !l.push(1)
    print(pick(?Map[Int, Int](), ?l))

fail "apis a call through a bound checks the implementation's instance", "`Sq.look[Float]` cannot use `K = Float`: the generic body hashes a `K` with `.hash()`, which `Float` does not support", "`Sq.look[Float]` is made by `probe[Sq]`"
  # An implementation's generic method checked at each instance (`Sq` is
  # private) is reached through `T: Keyed` at `K = Float`, which it
  # hashes: the instance must be checked, not left to Zig.
  api Keyed
    fun look[K](?@, k: ?K) -> Bool

  obj Sq: Keyed
    n: Int

    fun look[K](?@, k: ?K) -> Bool
      k.hash() > 0

  fun probe[T: Keyed](t: ?T) -> Bool
    t.look(?1.5)

  print(probe(?Sq(n: 1)))

test "apis pub states its bounds facts no API names", "301 2"
  # A literal's fit and a table's default are no API's: each instance of
  # a `pub` generic decides them, bounded or not.

  pub fun add300[T: Num](x: T) -> T
    x + 300

  pub fun slots[T: Copy, n: Int]() -> Int
    t = Table[T, n]()
    n

  print(add300(1), slots[Int, 2]())

test "apis bounds of a composite argument", "1"
  # A bound asked of an argument made of other types (`Pair[T, U]`) in a
  # signature is checked once every type's contents are known.

  obj Pair[A, B]
    a: A
    b: B

  obj Chain[T: Copy]
    items: List[T]

    fun zip[U](?@, other: ?Chain[U]) -> Chain[Pair[T, U]]
      out: List[Pair[T, U]] = List()
      i = 0
      while i < @items.len and i < other.items.len
        !out.push(Pair(a: @items[i], b: other.items[i]))
        i += 1
      Chain(items: <out)

  v: List[Int] = List()
  !v.push(1)
  l = Chain(items: <v)
  z = ?l.zip(?l)
  print(z.items[0].a)
