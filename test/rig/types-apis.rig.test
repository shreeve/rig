test "apis own associated type", "4\nb\n5"
  # `type Item` names a type each provider chooses, by what its methods
  # give in the API's place; a body bounded by the API reads it `S.Item`,
  # and bounds it as an entry of its own.

  api Source
    type Item

    fun take(!@) -> Item? from @

    fun skip(!@) -> Int              # a default
      n = 0
      while (!@).take() as _
        n += 1
      n

  obj Count: Source
    n: Int
    hi: Int

    fun take(!@) -> Int?
      return none if @n >= @hi
      @n += 1
      @n

  obj Words: Source
    ws: List[String]
    at: Int

    fun take(!@) -> String?
      return none if @at >= @ws.len
      @at += 1
      +@ws[@at - 1]

  fun most[S: Source, S.Item: Ord + Copy](s: !S) -> S.Item?
    best = (!s).take() ?? return none
    while (!s).take() as x
      best = x if x > best
    best

  fun first_of[S: Source](s: !S) -> S.Item?
    (!s).take()

  c = Count(n: 0, hi: 4)
  print(most(!c) ?? -1)
  ws: List[String] = List()
  !ws.push(String("b"))
  !ws.push(String("a"))
  w = Words(ws: <ws, at: 0)
  print(first_of(!w) ?? String("none"))
  d = Count(n: 0, hi: 5)
  print((!d).skip())

test "apis own associated type in a type and a default", "4\n3\n3"
  # A generic type bounded by the API names `S.Item` in its methods, and a
  # default names `Item` in its body.

  api Source
    type Item

    fun take(!@) -> Item? from @

    fun last(!@) -> Item? from @
      out: Item? = none
      while (!@).take() as x
        out = <x
      out

  obj Count: Source
    n: Int
    hi: Int

    fun take(!@) -> Int?
      return none if @n >= @hi
      @n += 1
      @n

  obj Keep[S: Source]
    src: S
    seen: Int

    fun pull(!@) -> S.Item?
      @seen += 1
      (!@src).take()

  fun drain[S: Source](s: S) -> Int
    k = Keep(src: <s, seen: 0)
    while (!k).pull() as _
      pass
    k.seen

  fun last_of[S: Source](s: !S) -> S.Item?
    (!s).last()

  print(drain(Count(n: 0, hi: 3)))
  d = Count(n: 0, hi: 3)
  print(last_of(!d) ?? -1)
  e = Count(n: 0, hi: 3)
  print((!e).last() ?? -1)

test "apis own associated type across modules", "4 2\n7"
  # An API's associated type, given by a provider in another module and
  # read by bodies in a third and in its own.

  use src
  use nums

  fun most[S: src.Source, S.Item: Ord + Copy](s: !S) -> S.Item?
    best = (!s).take() ?? return none
    while (!s).take() as x
      best = x if x > best
    best

  c = nums.Count(n: 0, hi: 4)
  print(most(!c) ?? -1, src.size_of(!(nums.Count(n: 0, hi: 2))))
  print(nums.biggest())

  file "src.rig"
    pub api Source
      type Item

      fun take(!@) -> Item? from @

    pub fun size_of[S: Source](s: !S) -> Int
      n = 0
      while (!s).take() as _
        n += 1
      n

  file "nums.rig"
    use src

    pub obj Count: src.Source
      pub n: Int
      pub hi: Int

      pub fun take(!@) -> Int?
        return none if @n >= @hi
        @n += 1
        @n

    fun top[S: src.Source](s: !S) -> S.Item?
      out: S.Item? = none
      while (!s).take() as x
        out = <x
      out

    pub fun biggest() -> Int
      c = Count(n: 0, hi: 7)
      top(!c) ?? -1

