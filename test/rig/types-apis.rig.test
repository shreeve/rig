test "apis iter", "3\n1\n4\n3 7"
  # `Iter` is what a `for` loop walks: a type provides it by declaring
  # `next(!@) -> T?`, its `Item` is `T`, and an API may build on it.

  obj Count
    n: Int
    hi: Int

    fun next(!@) -> Int?
      return none if @n >= @hi
      @n += 1
      @n

  api Stream: Iter
    fun name(?@) -> Int

  obj Named: Stream
    n: Int

    fun next(!@) -> Int?
      return none if @n >= 3
      @n += 1
      @n

    fun name(?@) -> Int
      7

  fun total[I: Iter](it: !I) -> Int
    n = 0
    for _ in !it
      n += 1
    n

  fun first[I: Iter](it: !I) -> I.Item?
    (!it).next()

  fun biggest[I: Iter, I.Item: Ord + Copy](it: !I) -> I.Item?
    best = (!it).next() ?? return none
    for x in !it
      best = x if x > best
    best

  fun named[S: Stream](s: !S) -> Int
    s.name()

  c = Count(n: 0, hi: 3)
  print(total(!c))
  d = Count(n: 0, hi: 3)
  print(first(!d) ?? -1)
  e = Count(n: 0, hi: 4)
  print(biggest(!e) ?? -1)
  s = Named(n: 0)
  print(total(!s), named(!s))

