  # the API.

  use geo

  api Shape
    fun area(?@) -> Float

  api Region
    fun area(?@) -> Float

  add geo.Circle: Shape + Region
    fun area(?@) -> Float
      @r

  sub main()
    c = geo.Circle(r: 1.0)
    print(c.area(), Shape.area(c))

  file "geo.rig"
    pub obj Circle
      pub r: Float

fail "apis own no bound", "`T` has no method `area`: `total[T]` gives `T` no bound; write `[T: Shape]`, which declares `area`"
  # An addition's methods are the API's: a call on a `T` with no bound
  # reaches only a type's own methods.

  api Shape
    fun area(?@) -> Float

  add Int: Shape
    fun area(?@) -> Float
      Float(@)

  fun total[T](x: ?T) -> Float
    x.area()

  n = 3
  print(total(?n))

test "apis own compile-time parameters", "4 2 12"
  # An API's method takes compile-time parameters of its own, a set's and
  # a value's, which a call through a bound passes as any call does.

  error Stop
    early

  api Each
    fun each[E](?@, f: ?fun(Int) -> Bool!E) -> Int!E

    fun scaled[n: Int](?@) -> Int

  obj Range: Each
    hi: Int

    fun each[E](?@, f: ?fun(Int) -> Bool!E) -> Int!E
      k = 0
      for i in 0..@hi
        k += 1
        break if not f(i)!
      k

    fun scaled[n: Int](?@) -> Int
      @hi * n

  fun small(i: Int) -> Bool!Stop
    return Stop.early if i > 5
    i < 3

  fun count[T: Each](x: ?T) -> Int!Stop
    x.each(small)!

  fun tripled[T: Each](x: ?T) -> Int
    x.scaled[3]()

  print(count(?Range(hi: 10)) catch -1, count(?Range(hi: 2)) catch -1, tripled(?Range(hi: 4)))

fail "apis a call through a bound checks the method's instance", errors: 3, "`Sq.look[Float]` cannot use `K = Float`: the generic body hashes a `K` with `.hash()`", "`Sq.size[-1]` cannot use `n = -1`: the generic body uses `n` as an array length", "`Sq.scale[U8]` cannot use `T = U8`: the generic body applies `*` to a `T` and the literal `300`"
  # A generic method an implementation declares is checked at the
  # compile-time arguments a call through a bound gives it, at each
  # instance of the body, as a call of the method itself is, whichever
  # way it takes self: never left to Zig.
  api Keyed
    fun look[K](?@, k: ?K) -> Bool

    fun size[n: Int](!@) -> Int

    fun scale[T](<@, x: T) -> Int

  obj Sq: Keyed
    n: Int

    fun look[K](?@, k: ?K) -> Bool
      k.hash() > 0

    fun size[n: Int](!@) -> Int
      a: [n]Int = [n of 0]
      a.len + @n

    fun scale[T](<@, x: T) -> Int
      y = x * 300
      @n

  fun look[T: Keyed](t: ?T) -> Bool
    t.look(?1.5)

  fun size[T: Keyed](t: !T) -> Int
    (!t).size[-1]()

  fun scale[T: Keyed](t: T) -> Int
    (<t).scale(U8(1))

  sub main()
    s = Sq(n: 1)
    print(look(?s), size(!s), scale(Sq(n: 2)))

fail "apis a call through an API checks an addition's instance", errors: 2, "`Int.look[Float]` cannot use `K = Float`: the generic body hashes a `K` with `.hash()`", "`List.first[Float]` cannot use `T = Float`: the generic body hashes a `T` with `.hash()`", "`List.first[Float]` is made by `first[List[Float]]`"
  # An addition's method is checked at its own compile-time arguments and
  # at the addition's, which no type's instance checks: `List[Float]` is
  # an instance of `add List[T]`.
  api Keyed
    fun look[K](?@, k: ?K) -> Bool

    fun first(?@) -> Bool

  add Int: Keyed
    fun look[K](?@, k: ?K) -> Bool
      k.hash() > 0

    fun first(?@) -> Bool
      @ > 0

  add List[T]: Keyed
    fun look[K](?@, k: ?K) -> Bool
      true

    fun first(?@) -> Bool
      @[0].hash() > 0

  fun look[T: Keyed](t: ?T) -> Bool
    t.look(?1.5)

  fun first[T: Keyed](t: ?T) -> Bool
    t.first()

  sub main()
    xs: List[Float] = List()
    !xs.push(1.5)
    print(look(?3), first(?xs))

fail "apis a default's call through Self checks the method's instance", errors: 2, "`Sq.look[Float]` cannot use `K = Float`", "`Sq.look[Float]` is made by `Sq.show`", "`Tri.look[Float]` is made by `relay[Tri]`"
  # A default reached through an API is its body at the type that
  # provides it: what it calls on `Self` is that type's method.
  api Keyed
    fun look[K](?@, k: ?K) -> Bool

    fun show(?@) -> Bool
      @look(?1.5)

    fun relay[J](?@, j: ?J) -> Bool
      @look(?j)

  obj Sq: Keyed
    n: Int

    fun look[K](?@, k: ?K) -> Bool
      k.hash() > 0

  obj Tri: Keyed
    n: Int

    fun look[K](?@, k: ?K) -> Bool
      k.hash() > 1

  fun relay[T: Keyed](t: ?T) -> Bool
    t.relay(?2.5)

  sub main()
    s = Sq(n: 1)
    print(s.show(), relay(?Tri(n: 2)))

fail "apis a call through an API's name checks the method's instance", errors: 2, "`Sq.look[Float]` cannot use `K = Float`", "`Sq.look[Float]` is made by `outer[Sq]`", "`Tri.look[Float]` is made by `named[Tri]`"
  # `Keyed.look(?t, ?k)`, and a call whose arguments are a body's own
  # parameters, reached through another generic body.
  api Keyed
    fun look[K](?@, k: ?K) -> Bool

  obj Sq: Keyed
    n: Int

    fun look[K](?@, k: ?K) -> Bool
      k.hash() > 0

  obj Tri: Keyed
    n: Int

    fun look[K](?@, k: ?K) -> Bool
      k.hash() > 1

  fun named[T: Keyed](t: ?T) -> Bool
    Keyed.look(?t, ?1.5)

  fun probe[T: Keyed, X](t: ?T, x: ?X) -> Bool
    t.look(?x)

  fun outer[U: Keyed](u: ?U) -> Bool
    probe(?u, ?2.5)

  sub main()
    print(outer(?Sq(n: 1)), named(?Tri(n: 2)))

