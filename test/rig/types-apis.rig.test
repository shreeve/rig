# Calls through a bound, and witnesses: a call on a bounded `T` is typed
# from the API's declaration and reaches each type's method through the
# conformance's witness.

test "apis own defaults", '''
  area 9.0 18.0
  a dot 0.0
  area 1.0
'''
  # A default is checked once, generic over the type that provides the
  # API; a type takes it or writes its own, and a call through a bound,
  # or on the type itself, reaches either.

  api Shape
    fun area(?@) -> Float

    fun describe(?@) -> String
      String("area ", @area())

    fun twice(?@) -> Float
      2.0 * @area()

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Dot: Shape
    fun area(?@) -> Float
      0.0

    fun describe(?@) -> String
      String("a dot")

  sub report[T: Shape](x: ?T)
    print(x.describe(), x.twice())

  report(Square(side: 3.0))
  report(Dot())
  print(Square(side: 1.0).describe())

test "apis own closures and tasks", "8.0 4.0 4.0"
  # A closure in a bounded body calls through its bounds; a call through
  # a bound may be a task, local where self cannot be shared.

  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun twice[T: Shape](x: ?T) -> Float
    f = |?x| x.area() * 2.0
    f()

  fun spawned[T: Shape + Syncs](x: ?T) -> Float
    t = x.area()&
    >t

  fun local[T: Shape](x: ?T) -> Float
    t = x.area()&
    >t

  xs: List[Square] = List()
  !xs.push(Square(side: 2.0))
  print(twice(?xs[0]), spawned(?xs[0]), local(?xs[0]))

test "apis own by name", "4.0 9.0 3.0"
  # `Shape.area(c)` calls the method of the API by name, self given first
  # with its sigil as at any call, on a provider or a bounded `T`.

  api Shape
    fun area(?@) -> Float

    sub grow(!@, by: Float)

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

    sub grow(!@, by: Float)
      @side += by

  fun both[T: Shape](x: !T) -> Float
    Shape.grow(!x, 1.0)
    Shape.area(x)

  s = Square(side: 1.0)
  Shape.grow(!s, 1.0)
  print(Shape.area(s), both(!s), s.side)

