test "apis own self by its sigil", '''
  5 7
  ab ab
  closed ab
'''
  # Self goes through a bound as the API declares it: `!@` by address, so
  # the caller's value changes; `?@` as the view lent, so a result `from
  # @` views the caller's value after the call; `<@` moved in.

  api Counter
    sub bump(!@, by: Int)

    fun label(?@) -> ?String from @

    sub close(<@)

  obj Tally: Counter
    n: Int
    name: String

    sub bump(!@, by: Int)
      @n += by

    fun label(?@) -> ?String from @
      ?@name

    sub close(<@)
      print("closed", @name)

  sub twice[T: Counter](x: !T)
    !x.bump(1)
    !x.bump(2)

  fun named[T: Counter](x: ?T) -> ?String from x
    x.label()

  sub done[T: Counter](x: T)
    <x.close()

  t = Tally(n: 0, name: String("ab"))
  twice(!t)
  !t.bump(2)
  v = named(?t)
  print(t.n, t.n + 2)
  print(v, t.label())
  done(<t)

