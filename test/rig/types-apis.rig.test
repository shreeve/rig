test "apis own method bounds name types", "2.0\n3.0 0.0"
  # A method's signature and body name the types its bounds allow, a
  # generic enum's too.

  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side

  obj Box[U: Shape]
    inner: U

    fun get(?@) -> Float
      @inner.area()

  obj Wrap[T: Copy]
    x: T

  fun Wrap[T: Shape].boxed(?@) -> Box[T]
    Box(inner: @x)

  enum Maybe[T]
    some(v: T)
    nothing

