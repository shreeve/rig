# types: tests whose names start `cell`.

test "cell behind shared", '''
  11 12 12
  6 j
'''
  # A Cell lives behind a shared handle: `*Cell[T]`, or `*S` where `S`
  # holds one in a field, set by a field default or a field argument. A
  # read view of either changes it in place.

  obj Counter
    hits: Cell[Int] = Cell(0)
    name: ?String

    fun hit(!@) -> Int
      !@hits.set(@hits.get() + 1)
      @hits.get()

  sub bump(c: !Cell[Int])
    !c.set(c.get() + 10)

  fun total(k: ?Counter) -> Int
    k.hits.get()

  local = *Cell(1)
  bump(!local)
  k = *Counter(name: "k")
  !k.hit()
  bump(!k.hits)
  same = +k
  print(local.get(), (!same).hit(), total(k))
  j = *Counter(hits: Cell(5), name: "j")
  print((!j).hit(), j.name)

test "cell branch leaf forms", release: true, '''
  71
  a 71
  drop 71
  drop 70
  drop 7
  8
  drop 8
  a 1
  drop 1
  drop 8
  70
  a 70
  drop 70
  drop 70
  9
  drop 9
  a 2
  drop 2
  drop 7
  70
  a 1
  drop 70
  drop 1
  70
  drop 6
  drop 70
  7
  drop 7
  a 2
  drop 2
  drop 2
  2
  5
  1 3 3
  6
  1 4 4
'''
  # A value that branches beside a name's leaf is reached at the leaf it
  # takes, through every branching form: a nested branch whose every leaf
  # is made here, a `??` or `catch` fallback, a made value reached through
  # `e!` or `e?`, and an optional that branches, unwrapped with `?`. Each
  # value made here lives in its statement's slot, so a change to its
  # shared Cell lands in it and its `drop` sees it, and a read sees the
  # leaf it takes. A shared `Cell[List]` is reached the same way by its
  # List's members.

  error E
    bad

  obj D
    c: *Cell[Int]

    drop(!@)
      print("drop", @c.get())

  sub bump(c: !Cell[Int])
    !c.set(c.get() + 1)

  fun mk(n: Int) -> D
    D(c: *Cell(n))

  fun mkf(n: Int) -> D!
    return E.bad if n < 0
    mk(n)

  fun mko(n: Int) -> D?
    return none if n < 0
    mk(n)

  fun vec1(n: Int) -> List[Int]
    v: List[Int] = List()
    !v.push(n)
    v

  fun mkv(n: Int) -> *Cell[List[Int]]
    *Cell(vec1(n))

  sub nested(k: Bool, j: Bool)
    a = mk(1)
    !(a if k else (mk(5) if j else mk(8))).c.set(70)
    bump(!(a if k else (mko(-1) ?? mk(6))).c)
    print((a if k else (mk(5) if j else mk(8))).c.get())
    print("a", a.c.get())

  sub fails(k: Bool)!
    a = mk(1)
    !(a if k else mkf(6)!).c.set(70)
    bump(!(mkf(7)! if k else a).c)
    print((a if k else mkf(9)!).c.get())
    print("a", a.c.get())

  fun absent(k: Bool) -> Int?
    a = mk(1)
    o: D? = mk(2)
    bump(!(mko(6)? if k else a).c)
    (!(o if k else mko(5))?.c).set(6)
    (!(o if k else mko(6))?.c).set(70)
    print((o if k else mko(7))?.c.get())
    print("a", a.c.get())
    o?.c.get()

  sub cells(k: Bool)
    x = mkv(1)
    !(x if k else mkv(5)).push(5)
    print((!(x if k else mkv(6))).pop() ?? -1)
    !(x if k else mkv(7)).clear()
    !(x if k else mkv(8)).push(9)
    (!(x if k else mkv(2)))[0] = 3
    print((x if k else mkv(4)).len, (x if k else mkv(4)).get(0) ?? -1, (x if k else mkv(4))[0])

  nested(true, true)
  nested(false, false)
  fails(true) catch print("failed")
  fails(false) catch print("failed")
  print(absent(true) ?? -1)
  print(absent(false) ?? -1)
  cells(true)
  cells(false)

fail "cell by value", "8:13: a value of `Counter` holds a Cell, so it lives only behind a shared handle: write `*Counter`", "11:15: a value of `Counter` holds a Cell, so it lives only behind a shared handle: write `*Counter`", "14:17: a value of `Cell[Int]` holds a Cell, so it lives only behind a shared handle: write `*Cell[Int]`", "14:33: a value of `Counter` holds a Cell, so it lives only behind a shared handle: write `*Counter`", "17:4: a value of `Cell[Int]` holds a Cell, so it lives only behind a shared handle: write `*Cell[Int]`", "18:4: a value of `Counter` holds a Cell, so it lives only behind a shared handle: write `*Counter`", errors: 6
  # A value holding a Cell lives only behind a shared handle: no
  # parameter, result, local, optional, element, slice, or type argument
  # holds one by value.

  obj Counter
    hits: Cell[Int]

  sub take(k: Counter)
    print(k.hits.get())

  fun make() -> Counter?
    none

  sub each(xs: [2]Cell[Int], s: []Counter)
    print(xs.len, s.len)

  a: Cell[Int]? = none
  v: List[Counter] = List()
  print(a, v.len)

fail "cell holder no clone", "12:6: `+x` cannot clone a `Counter`: it is unique, and a copy would duplicate it; move it with `<x`", "13:6: `+x` cannot clone a `Cell[Int]`: it is unique, and a copy would duplicate it; move it with `<x`", "14:13: `[n of x]` copies its element into every slot, and a `Counter` is unique, so it cannot be copied, and it has no clone: write a loop that makes each element anew"
  # A value that holds a Cell is unique, also as a field of a value behind
  # `*`: it has no `+x` clone, and `[n of x]` does not copy one.

  obj Counter
    hits: Cell[Int]

  obj Holder
    c: Counter
    k: Cell[Int]

  h = *Holder(c: Counter(hits: Cell(0)), k: Cell(1))
  b = +h.c
  d = +h.k
  all = [2 of h.c]

fail "cell in temporary field", "13:13: a value of `Q` holds a Cell, so it lives only behind a shared handle: write `*Q`", "14:3: `Q(p: P(c: Cell(1)))` makes a `Q`, which holds a Cell, so it lives only behind a shared handle: write `*Q(p: P(c: Cell(1)))`", "19:7: `mk()` makes a `Q`, which holds a Cell, so it lives only behind a shared handle: write `*mk()`", errors: 3
  # A Cell lives only behind a shared handle, so no temporary holds one: a
  # call cannot return a value that holds a Cell to have a part of it
  # lent. The rule that a Cell lives only behind `*` rejects the result
  # type `Q`, the constructor that makes the value, and the temporary the
  # call makes.

  obj P
    c: Cell[Int]

  obj Q
    p: P

  fun mk() -> Q
    Q(p: P(c: Cell(1)))

  sub bump(p: !P)
    !p.c.set(p.c.get() + 10)

  bump(?mk().p)

fail "cell made outside shared", "12:5: `Cell(0)` makes a `Cell[Int]`, which holds a Cell, so it lives only behind a shared handle: write `*Cell(0)`", "13:1: `Cell(1)` makes a `Cell[Int]`, which holds a Cell, so it lives only behind a shared handle: write `*Cell(1)`", "14:7: `Counter()` makes a `Counter`, which holds a Cell, so it lives only behind a shared handle: write `*Counter()`", "15:6: `Cell(3)` makes a `Cell[Int]`, which holds a Cell, so it lives only behind a shared handle: write `*Cell(3)`"
  # A value holding a Cell is made only under `*`, as a field of a value
  # made there, or as a field's default: a bare one, a temporary, and a
  # Cell in a built-in generic's value are rejected.

  obj Counter
    hits: Cell[Int] = Cell(0)

    fun hit(!@) -> Int
      !@hits.set(@hits.get() + 1)
      @hits.get()

  c = Cell(0)
  Cell(1).set(2)
  print(Counter().hit())
  b = ^Cell(3)
  print(c.get(), b)

fail "cell moved receiver", "7:6: method `push` needs its receiver lent to write, not moved", "9:10: method `pop` needs its receiver lent to write, not moved", "11:6: method `clear` needs its receiver lent to write, not moved", "13:6: method `set` needs its receiver lent to write, not moved", "15:10: method `replace` needs its receiver lent to write, not moved", errors: 5
  # A Cell's `set`, `replace`, and its List's `push`, `pop`, and `clear`
  # take their receiver lent to write, as any `!@` method does, so a
  # `*Cell` handle moved there with `<` is rejected: `<` would end the
  # binding for a call that only lends it.

  c: *Cell[List[Int]] = *Cell(List[Int]())
  (<c).push(1)
  d: *Cell[List[Int]] = *Cell(List[Int]())
  x = (<d).pop()
  e: *Cell[List[Int]] = *Cell(List[Int]())
  (<e).clear()
  n: *Cell[Int] = *Cell(1)
  (<n).set(2)
  m: *Cell[Int] = *Cell(1)
  y = (<m).replace(2)
  print(x ?? 0, y)

fail "cell name reserved", "`Cell` is a reserved built-in nominal name"
  # `Cell` is a built-in nominal name and cannot be redefined.

  obj Cell[T]
    value: T

fail "cell non copy element", "`Cell[T]` requires `T` to be a value that copies (Int, Bool, Float, `?String`), plain data"
  # `Cell[T]` needs a Copy `T`, plain data, or a type with drop glue; a
  # view is none of these: every handle to the cell would reach it.

  n = 1
  c: Cell[?Int] = Cell(?n)
  print(c.get())

test "cell signal plain data", '''
  11 1
  11 0
  true
  circle 3
  none
  4
  3 1
  2 true
  moved to 5 6
  true
'''
  # `Cell[T]`, `Signal[T]`, and `List[T]` hold plain data: a struct, an
  # enum, an optional, or an array that owns nothing; `get` returns a
  # copy.

  obj Point
    x: Int
    y: Int

  enum Color
    red
    green

  enum Shape
    dot
    circle(r: Int)

  p: *Cell[Point] = *Cell(Point(x: 1, y: 2))
  q = p.get()
  !p.set(Point(x: q.x + 10, y: q.y))
  print(p.get().x, q.x)
  old = (!p).replace(Point(x: 0, y: 0))
  print(old.x, p.get().y)

  c: *Cell[Color] = *Cell(Color.red)
  d = +c
  !d.set(.green)
  print(c.get() == .green)

  sh: *Cell[Shape] = *Cell(Shape.circle(r: 3))
  match sh.get()
    .circle(r) => print("circle", r)
    .dot => print("dot")

  o: *Cell[Int?] = *Cell(none)
  print(o.get())
  !o.set(4)
  print(o.get() ?? 0)

  a: *Cell[[3]Int] = *Cell([1, 2, 3])
  arr = a.get()
  !a.set([arr[2], arr[1], arr[0]])
  print(a.get()[0], arr[0])

  vs: List[[2]Int] = List()
  !vs.push([1, 2])
  print(vs[0][1], vs.get(1) == none)

  sig: *Signal[Point] = *Signal(Point(x: 0, y: 0))
  !sig.subscribe(*|~sig|
    if *sig as s
      print("moved to", s.get().x, s.get().y)
  )
  !sig.set(Point(x: 5, y: 6))
  mode: *Signal[Color?] = *Signal(none)
  !mode.set(Color.red)
  print(mode.get() == Color.red)

test "cell through read viewed elements", "10 20 30 40 50 60", release: true
  # A shared Cell changes by a marked call through any path to it, a handle
  # in an element of a write-viewed List, array, or slice included: through a field of the
  # element, the element itself, an element of an element, and a field's
  # List.

  obj C
    c: Cell[Int]

  obj H
    cs: List[*C]

  sub bump(a: ![2]*C, s: ![]*C, v: !List[*C], w: !List[*Cell[Int]], m: !List[List[*C]], h: !H)
    !a[0].c.set(10)
    !s[0].c.set(20)
    !v[0].c.set(30)
    !w[0].set(40)
    !m[0][0].c.set(50)
    !h.cs[0].c.set(60)

  a = [*C(c: Cell(1)), *C(c: Cell(2))]
  v: List[*C] = List()
  !v.push(*C(c: Cell(3)))
  sl: List[*C] = List()
  !sl.push(*C(c: Cell(4)))
  w: List[*Cell[Int]] = List()
  !w.push(*Cell(5))
  m: List[List[*C]] = List()
  row: List[*C] = List()
  !row.push(*C(c: Cell(6)))
  !m.push(<row)
  hs: List[*C] = List()
  !hs.push(*C(c: Cell(7)))
  h = H(cs: <hs)
  bump(!a, !sl[..], !v, !w, !m, !h)
  print(a[0].c.get(), sl[0].c.get(), v[0].c.get(), w[0].get(), m[0][0].c.get(), h.cs[0].c.get())

fail "cell too large", "6:5: `Two` takes 9600000 bytes; a value takes at most 8388608 (8 MiB), since it may live on the stack. Keep larger data in a `List`", "10:6: `Signal[[600000]Int]` takes 9600026 bytes; a value takes at most 8388608 (8 MiB), since it may live on the stack. Keep larger data in a `List`"
  # A `Cell[T]` holds its `T` inline, and a `Signal[T]` its value and a
  # pending one: both count toward the 8 MiB a value takes.

  type Arr = [600000]Int

  obj Two
    a: Cell[Arr]
    b: Cell[Arr]

  s = *Signal[Arr](value: [600000 of 0])
  print(s.get()[0])

fail "cell type route get", "6:18: `Cell.get` returns a copy of the value, and a `String` owns what it must release, so it can't be copied", errors: 1
  # `Cell[String].get(?c)` calls `get` through the type: it hands out a
  # copy of the Cell's value as `c.get()` does, so it needs a value that
  # copies. Accepted, the copy and the Cell's own String were both freed.

  c = *Cell(String("a"))
  s = Cell[String].get(?c)
  print(s)

fail "cell value field", "5:9: a Cell is read with `c.get()` and written with `!c.set(v)`, not through `.value`", "6:3: a Cell is read with `c.get()` and written with `!c.set(v)`, not through `.value`"
  # A Cell is read with `get()` and written with `set(v)` or
  # `replace(v)`; `value` names only its constructor argument.

  c: Cell[Int] = Cell(7)
  print(c.value)
  c.value = 8

fail "cell vec element place", "9:6: cannot lend an element of a Cell's List", "10:1: an element of a Cell's List is written whole", "13:1: an element of a Cell's List is written whole", "14:4: cannot assign to `.len`; a length is read-only"
  # An element of a Cell's List is a copy: it cannot be lent, and it is
  # written whole with `c[i] = e`, not through a field or `+=`.

  obj P
    x: Int

  ps: Cell[List[P]] = Cell(List())
  !ps.push(P(x: 1))
  r = ?ps[0]
  ps[0].x = 2
  ns: Cell[List[Int]] = Cell(List())
  !ns.push(1)
  ns[0] += 1
  ns.len = 3
  print(r)

fail "cell vec element take", "7:5: an element of a Cell's List is read and written whole: copy it out with `c[i]`, then write `c[i] = none`"
  # An element of a Cell's List is read and written whole, so it cannot be
  # taken out in place with `<`.

  v = List[Int?]()
  (!v).push(4)
  c = *Cell(<v)
  y = <c[0]
  print(y ?? 0)

fail "cell vec handle elements", "10:5: cannot read or overwrite an element of a `Cell[List[*N]]` in place", "11:8: cannot read or overwrite an element of a `Cell[List[*N]]` in place", "12:1: cannot read or overwrite an element of a `Cell[List[*N]]` in place", "13:8: `Cell.get` returns a copy of the value, and a `List[*N]` owns what it must release, so it can't be copied; write `(!cell).replace(<new)`, which puts `new` in and hands back the old value"
  # The elements of a Cell's List of handles are not read or overwritten in
  # place: that would copy a handle out, or release one, while the cell
  # holds the List. `pop` them, or `replace` the List.

  obj N
    id: Int

  hs: Cell[List[*N]] = Cell(List())
  !hs.push(*N(id: 1))
  a = hs[0]
  b = hs.get(0)
  hs[0] = *N(id: 2)
  c = hs.get()
  print(a, b, c)
