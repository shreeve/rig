test "syntax-review-complete-hm6", "11 2 none 2"
  obj Map[K, V]
    keys: List[K?]
    vals: List[V?]
    hash: fun(?K) -> U64
    len: Int

    fun new(h: fun(?K) -> U64) -> Self
      m: Self = Map(keys: List(), vals: List(), hash: h, len: 0)
      for _ in 0..8
        !m.keys.push(none)
        !m.vals.push(none)
      m

    fun find(?@, k: ?K) -> Int?
      cap = @keys.len
      i = Int(@hash(k) % U64(cap))
      for _ in 0..cap
        if @keys[i] as kk
          return i if kk == k
        else
          return none
        i = (i + 1) % cap
      none

    fun get(?@, k: ?K) -> (?V)?
      i = @find(k)?
      ?@vals[i]

    sub put(!@, k: K, v: V)
      cap = @keys.len
      f = @hash
      i = Int(f(?k) % U64(cap))
      while @keys[i] != none and @keys[i] != k
        i = (i + 1) % cap
      @len += 1 if @keys[i] == none
      @keys[i] = k
      @vals[i] = <v

  fun hash_str(s: ?String) -> U64
    h: U64 = 5381
    for b in s
      h = (h * 33 + U64(b)) % 1000000007
    h

  m = Map[?String, Int].new(hash_str)
  !m.put("one", 1)
  !m.put("two", 2)
  !m.put("one", 11)
  print(m.get(?"one"), m.get(?"two"), m.get(?"three"), m.len)

