fail "syntax-review-complete-vw2", "bare use of loop view `x` in return value would carry the viewed handle past the loop; a `for x in ?list` element is a read view of the List slot and cannot be cloned, moved, dropped, or stored"
  obj Node
    n: Int

  obj Bag
    items: List[*Node]

    fun iter(?@) -> BagIter
      BagIter(bag: @, i: 0)

  obj BagIter
    bag: ?Bag
    i: Int

    fun next(!@) -> (?*Node)?
      j = 0
      for x in ?@bag.items
        if j == @i
          @i += 1
          return x
        j += 1
      none

  b = Bag(items: List())
  !b.items.push(*Node(n: 4))
  it = ?b.iter()
  while (!it).next() as x
    print(x.n)

