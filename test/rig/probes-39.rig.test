fail "step3-adv1-rej", "method `new_stack` of `lib.Stack` is private to module `lib`; declare it `pub fun new_stack` there to call it from here"
  use lib

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  obj Loop
    s: lib.Stack[Loop]

  obj Holds
    b: lib.View[Int]

  fun boxed[T](x: T) -> lib.Stack[T]
    lib.wrap(<x)

  sub main()
    s = lib.Stack[Res].new_stack()
    t = boxed(Res(n: 3))
    u = lib.wrap(Res(n: 4))
    print(s.size(), t.size(), u.size())

  file "lib.rig"
    pub obj Stack[T]
      items: List[T]

      fun new_stack() -> Self
        Stack(items: List())

      sub push(!@, x: T, note: ?String = "pushed")
        !@items.push(<x)
        print(note)

      fun size(?@) -> Int
        @items.len

    pub obj Slot[T]
      c: Cell[T]

      fun swap(!@, x: T) -> T
        (!@c).replace(<x)

    pub fun wrap[T](x: T, label: ?String = "w") -> Stack[T]
      s = Stack[T].new_stack()
      !s.push(<x)
      print(label)
      s

    pub obj View[T]
      r: ?T

fail "step3-bagt", "only module `bag` can construct `bag.Bag`: its field `items` is private; declare every field `pub` there, or make the value with a `pub` function of `bag`"
  use bag

  sub main()
    b = bag.Bag[Int](items: List())
    !b.add(3)
    !b.add(4)
    print(bag.largest(?b, 0), b.items.len)

  file "bag.rig"
    pub obj Bag[T]
      items: List[T]

      sub add(!@, x: T)
        !@items.push(<x)

    pub fun largest[T](b: ?Bag[T], start: T) -> T
      t = start
      for x in b.items
        if x > t
          t = x
      t

