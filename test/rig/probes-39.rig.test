test "syntax-review-complete-gm1", '''
  drop 1
  a 3
  b 2
  true
  drop 2
  drop 3
'''
  obj Entry[K, V]
    k: K
    v: V

  obj Map[K, V]
    es: List[^Entry[K, V]]

    sub put(!@, k: K, v: V)
      for e in !@es
        if e.k == k
          e.v = <v
          return
      !@es.push(^Entry(k: k, v: <v))

    sub each(?@, f: ?sub(?K, ?V))
      for e in ?@es
        f(?e.k, ?e.v)

    fun has(?@, k: ?K) -> Bool
      for e in ?@es
        return true if e.k == k
      false

  obj Node
    id: Int
    drop(!@)
      print("drop", @id)

  m = Map[?String, *Node](es: List())
  !m.put("a", *Node(id: 1))
  !m.put("b", *Node(id: 2))
  !m.put("a", *Node(id: 3))
  m.each(|k, v| print(k, v.id))
  print(m.has(?"b"))

test "syntax-review-complete-h3", "5"
  obj Map[K, V]
    keys: List[K?]
    vals: List[V?]
    hash: fun(?K) -> U64

    fun new(h: fun(?K) -> U64) -> Self
      Map(keys: List(), vals: List(), hash: h)

    fun slot(?@, k: ?K) -> Int
      h = @hash(k)
      Int(h % 16)

  fun hash_int(k: ?Int) -> U64
    U64(k) if k >= 0 else 0

  m = Map[Int, ?String].new(hash_int)
  five = 5
  print(m.slot(?five))

