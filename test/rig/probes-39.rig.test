test "seams-temps-m1", '''
  1
  drop 1
  2
  drop 2
  3
  drop 3
'''
  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  fun mk(n: Int) -> B
    B(n: n)

  fun get(b: ?B) -> Int
    b.n

  fun opt(n: Int) -> B?
    if n > 0
      return B(n: n)
    none

  print(get(?mk(1)))
  if opt(2) as b
    print(b.n)
  x = opt(0) ?? mk(3)
  print(x.n)

fail "static-owned closure string param", "an owned closure cannot capture a view of `s`: it can be stored anywhere, so it could outlive `s`; capture an owned value, or use a stack closure (`|...|`)"
  fun later(s: ?String) -> *sub()
    *|?s| print(s)

  t = String("abc")
  f = later(?t[..])
  <t
  f()

test "static-static runs clean after text dropped", '''
  tagged
  b t tagged
'''
  obj Tag
    name: Static

  fun label(t: Tag) -> *sub()
    *|+t| print(t.name)

  t = String("abc")
  c = *Cell("one")
  pieces = ["a", "b", "c"]
  !c.set(pieces[1])
  tag = Tag(name: "tagged")
  f = label(tag)
  sig = *Signal("s")
  !sig.set("t")
  <t
  f()
  print(c.get(), sig.get(), tag.name)

