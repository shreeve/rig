test "stdlib-probe-i2", '''
  the
  quick
  fox
  3
'''
  obj Words
    s: ?String
    i: Int = 0

    fun next(!@) -> (?String)?
      while @i < @s.len and @s[@i] == 32
        @i += 1
      return none if @i >= @s.len
      start = @i
      while @i < @s.len and @s[@i] != 32
        @i += 1
      @s[start..@i]

  w = Words(s: "  the quick  fox ")
  n = 0
  while (!w).next() as x
    print(x)
    n += 1
  print(n)

test "stdlib-probe-i3", "13 91"
  obj Random
    s: U64

    fun next(!@) -> U64
      @s = @s +% 0x9E3779B97F4A7C15
      z = @s
      z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9
      z = (z ^ (z >> 27)) *% 0x94D049BB133111EB
      z ^ (z >> 31)

    fun below(!@, n: U64) -> U64
      (!@).next() % n

  r = Random(s: 42)
  print((!r).below(100), (!r).below(100))

test "stdlib-probe-i4", "2 2 1"
  fun lower_bound[T](xs: []T, x: T) -> Int
    lo = 0
    hi = xs.len
    while lo < hi
      mid = (lo + hi) / 2
      if xs[mid] < x
        lo = mid + 1
      else
        hi = mid
    lo

  a = [1, 3, 5, 7]
  print(lower_bound(?a[..], 5), lower_bound(?a[..], 4), lower_bound(["a", "c"], "b"))

