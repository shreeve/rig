test "syntax-review-complete-bt4", "three none"
  obj Node[K, V]
    keys: List[K]
    vals: List[V]
    kids: List[^Node[K, V]]

    fun leaf() -> Self
      Node(keys: List(), vals: List(), kids: List())

    fun find(?@, k: K) -> V?
      i = 0
      while i < @keys.len and @keys[i] < k
        i += 1
      if i < @keys.len and @keys[i] == k
        return @vals[i]
      return none if @kids.len == 0
      j = 0
      for c in ?@kids
        if j == i
          return c.find(k)
        j += 1
      none

  n = Node[Int, ?String].leaf()
  !n.keys.push(3)
  !n.vals.push("three")
  print(n.find(3), n.find(4))

test "syntax-review-complete-by1", '''
  77
  5 77
  1
'''
  obj Page
    buf: [4096]U8
    used: Int

    sub put(!@, at: Int, key: U64)
      !@buf.write[U64, .little](at, key)

    fun key(?@, at: Int) -> U64
      @buf.read[U64, .little](at)

    fun bytes(?@, a: Int, b: Int) -> []U8
      ?@buf[a..b]

  p = Page(buf: [4096 of 0], used: 0)
  !p.put(8, 77)
  print(p.key(8))
  v: List[U8] = List()
  for _ in 0..16
    !v.push(0)
  !v.write[U32, .big](0, 5)
  !v[4..8].copy(p.bytes(8, 12))
  print(v.read[U32, .big](0), v[4])
  pages: List[^Page] = List()
  !pages.push(^<p)
  print(pages.len)

