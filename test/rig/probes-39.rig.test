test "stdlib-rig-g18 hashfn", "0 none"
  obj Map[K, V]
    keys: List[K]
    vals: List[V]

    pub fun find(?@, k: K, h: ?fun(K) -> U64) -> Int?
      hk = h(k)
      i = 0
      for x in ?@keys
        if h(x) == hk and x == k
          return i
        i += 1
      none

  fun hs(s: ?String) -> U64
    U64(s.len)

  m = Map[?String, Int](keys: List(), vals: List())
  !m.keys.push("a")
  !m.vals.push(1)
  print(m.find("a", hs), m.find("b", |s| U64(s.len)))

