test "stdlib-probe-h2", "3 none"
  obj Pair[K, V]
    k: K
    v: V

  obj Map[K, V]
    slots: List[Pair[K, V]]

    fun get(?@, k: K) -> V?
      for p in ?@slots
        return p.v if p.k == k
      none

    sub put(!@, k: K, v: V)
      for p in !@slots
        if p.k == k
          p.v = v
          return
      !@slots.push(Pair(k: k, v: v))

  m = Map[?String, Int](slots: List())
  !m.put("a", 1)
  !m.put("b", 2)
  !m.put("a", 3)
  print(m.get("a"), m.get("c"))

