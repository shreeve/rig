test "review-subctor-a1", '''
  acc 3
  e Bad.neg
  ate 3
'''
  error Bad
    neg

  obj Acc
    n: Int

    sub bump(!@, k: Int)!
      return Bad.neg if k < 0
      @n += k

    sub show(?@)!
      return Bad.neg if @n < 0
      print("acc", @n)

    sub eat(<@)!
      return Bad.neg if @n > 100
      print("ate", @n)

  a = Acc(n: 1)
  !a.bump(2)!
  a.show()!
  !a.bump(-1) catch |e|
    print("e", e)
  <a.eat()!

