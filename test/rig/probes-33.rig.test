test "review-step45-r21 for read elem header temp", "q"
  # for t in m[idx(?Text("a"))] read loop over an element List of owners, header temp
  fun idx(s: ?String) -> Int
    s.len - 1

  m: List[List[String]] = List()
  r: List[String] = List()
  !r.push(String("q"))
