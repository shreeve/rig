test "review-subctor-i1", '''
  Wrap(item: 3) Wrap(item: "a") Wrap(item: 3)
  M(v: 4)
  9
  M(v: 8)
  M(v: 5)
'''
  obj Wrap[T]
    item: T

    fun rewrap(?@) -> Wrap[T]
      Wrap(@item)

  obj M
    v: Int

    fun twice(?@) -> M
      M(@v * 2)

  fun mk[T](x: T) -> Wrap[T]
    Wrap(x)

  fun mk2[T](x: T) -> Wrap[T]
    Wrap[T](x)

  fun boxit[T](x: T) -> ^T
    ^x

  w = mk(3)
  print(w, mk2("a"), w.rewrap())
  m = M(2)
  print(m.twice())
  b = boxit(9)
  print(b)
  sm = *M(4)
  print(sm.twice())
  bm = ^M(5)
  print(bm)

