# Probes from past reviews and audits, 33 of 41: review-step45-r2-a15_take_branch_temp to review-syntax-b-1-d05_loop_moved_source_drop.

fail "review-step45-r2-a15 take branch temp", "use of `w` after move"
  # if (<v[idx(?Text("a"))] if c else <w) as t: takes through a temp in a branch (exempt form)
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("q"))
  w: String? = String("w")
  c = v.len == 1
  if (<v[idx(?String("a"))] if c else <w) as t
    !t.add("!")
    print(t)
  print(v, w)

test "review-step45-r2-b06 match call write temp", "322"
  # match getw(!e, ?Text("a")) guarded: a write view of an enum returned by a call with a temp argument
  enum E
    a(t: String)
    b(n: Int)

  fun getw(e: !E, s: ?String) -> !E
    e

  e = E.a(t: String("hi"))
  match getw(!e, ?String("a"))
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match e
    .a(t) => print(t.len)
    .b(n) => print(n)

