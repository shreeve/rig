fail "review-step45-r2-e02 field", "`hold[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  # H3: generic loop over ?List[T], body: store into a struct field
  obj S
    t: String

  obj Holder[T]
    x: T?

  fun hold[T](v: ?List[T]) -> Holder[T]
    h = Holder[T](x: none)
    for x in v
      h.x = x
    <h

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(hold(?v).x)

fail "review-step45-r2-e03 arg", "`all[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  # H3: generic loop over ?List[T], body: pass by value to a T param
  obj S
    t: String

  obj Holder[T]
    x: T?

  fun eat[T](x: T) -> Int
    1

  fun all[T](v: ?List[T]) -> Int
    n = 0
    for x in v
      n += eat(x)
    n

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(all(?v))

fail "review-step45-r2-e04 closure", "`cap[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  # H3: generic loop over ?List[T], body: capture <x in a closure
  obj S
    t: String

  obj Holder[T]
    x: T?

  fun cap[T](v: ?List[T]) -> Int
    n = 0
    for x in v
      f = |<x| 1
      n += f()
    n

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(cap(?v))

fail "review-step45-r2-e07 box", "`bx[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  # H3: generic loop over ?List[T], body: ^x
  obj S
    t: String

  obj Holder[T]
    x: T?

  fun bx[T](v: ?List[T]) -> Int
    n = 0
    for x in v
      b = ^x
      n += 1
    n

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(bx(?v))

fail "review-step45-r2-e08 bind copy", "`last[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  # H3: generic loop over ?List[T], body: y = x then return y
  obj S
    t: String

  obj Holder[T]
    x: T?

  fun last[T](v: ?List[T]) -> T?
    r: T? = none
    for x in v
      r = x
    r

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  print(last(?v))

fail "review-step45-r2-e10 swap in loop", "cannot lend `v` to write while a read loan is live"
  # H3: generic loop over ?List[T], body: swap the List while looping
  obj S
    t: String

  obj Holder[T]
    x: T?

  sub sw[T](v: !List[T])
    for x in v
      !v.swap(0, 1)

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  sw(!v)
  print(v)

fail "review-step45-r2-e14 match", "`cnt[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  # H3: generic loop over ?List[T], body: match x on T? binding
  obj S
    t: String

  obj Holder[T]
    x: T?

  fun cnt[T](v: ?List[T?]) -> Int
    n = 0
    for x in v
      if x as y
        n += 1
    n

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  o: List[String?] = List()
  !o.push(String("q"))
  print(cnt(?o))

fail "review-step45-r2-e15 take from opt", "`grab[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  # H3: generic loop over ?List[T], body: if <x as y : take out of the T? loop binding
  obj S
    t: String

  obj Holder[T]
    x: T?

  fun grab[T](v: ?List[T?]) -> T?
    for x in v
      if <x as y
        return <y
    none

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  o: List[String?] = List()
  !o.push(String("q"))
  r = grab(?o)
  <o
  print(r)

fail "review-step45-r2-e16b view of loop copy escape int", "`x` does not live long enough"
  # same with T = Int, and non-generic Int (base-comparable)
  fun lastref[T](v: ?List[T]) -> ?T
    r = ?v[0]
    for x in v
      r = ?x
    r

  fun lastint(v: ?List[Int]) -> ?Int
    r = ?v[0]
    for x in v
      r = ?x
    r

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  print(lastref(?v), lastint(?v))

