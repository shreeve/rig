  w: String? = String("w")
  if (!o if f(?String("a")) else !w) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
  print(o, w)

test "review-step45-r2-c03 branch match temp write", "322"
  # match (!v[idx(?Text("a"))] if c else !v[0]) guarded; grow payload
  enum E
    a(t: String)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[E] = List()
  !v.push(E.a(t: String("hi")))
  c = v.len == 1
  match (!v[idx(?String("a"))] if c else !v[0])
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0]
    .a(t) => print(t.len)
    .b(n) => print(n)

test "review-step45-r2-c08 branch while temp write", " w"
  # while (!v[idx(?Text("a"))] if c else !w) as t: re-evaluated each iteration
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("q"))
  w: String? = String("w")
  c = v.len == 1
  n = 0
  while (!v[idx(?String("a"))] if c else !w) as t
    for _ in 0..40
      !t.add("xxxxxxxx")
    n += 1
    if n == 2
      break
  print(v[0], w)

