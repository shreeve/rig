test "review-step45-r22 match read elem header temp noguard", "hi"
  # unguarded read match on element with a header temporary (r11 sibling, no Cell)
  enum E
    a(t: String)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[E] = List()
  !v.push(E.a(t: String("hi")))
  match v[idx(?String("a"))]
    .a(t) => print(t)
    .b(n) => print(n)

test "review-step45-r23 stmt temp index forms", '''
  322
  p [none]
  [6]
  322
'''
  # statement temporaries inside an element index in every statement form
  fun idx(s: ?String) -> Int
    s.len - 1

  sub grow(t: !String)
    for _ in 0..40
      !t.add("xxxxxxxx")

  v: List[String] = List()
  !v.push(String("q"))
  v[idx(?String("a"))] = String("z")
  !v[idx(?String("a"))].add("!")
  grow(!v[idx(?String("a"))])
  print(v[0].len)
  o: List[String?] = List()
  !o.push(String("p"))
  t = <o[idx(?String("a"))]
  print(t, o)
  n: List[Int] = List()
  !n.push(1)
  n[idx(?String("a"))] += 5
  print(n)
  s = ?v[idx(?String("a"))]
  print(s.len)

test "review-step45-r24 match write elem field header temp", "322"
  # match !v[idx(?Text("a"))].e (field of an element), guarded, grows a Text payload
  enum E
    a(t: String)
    b(n: Int)

  obj S
    e: E

  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[S] = List()
  !v.push(S(e: E.a(t: String("hi"))))
  match !v[idx(?String("a"))].e
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0].e
    .a(t) => print(t.len)
    .b(n) => print(n)

test "review-step45-r25 while write elem header temp", "641"
  # while !v[idx(?Text("a"))] as t: write binding with a header temporary, grows the Text
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("q"))
  n = 0
  while !v[idx(?String("a"))] as t
    for _ in 0..40
      !t.add("xxxxxxxx")
    n += 1
    if n == 2
      break
  if v[0] as t
    print(t.len)

