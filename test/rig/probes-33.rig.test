fail "review-step45-r2-d01 repoint via lend on move", "cannot reassign `w` while it is lent"
  # w = !a; w2 = !w; w = <w2: the right side doesn't name w but carries w's view of a
  a = String("a")
  b = String("b")
  w = !a
  w2 = !w
  w = <w2
  a = String("A")
  !w.add("!")
  print(a, b)

fail "review-step45-r2-d02 repoint via fn of lend on", "cannot reassign `w` while it is lent"
  # w2 = id(!w); w = <w2 : re-point to a view derived from w through a call
  fun id(x: !String) -> !String
    x

  a = String("a")
  w = !a
  w2 = id(!w)
  w = <w2
  a = String("A")
  !w.add("!")
  print(a)

