fail "review-step45-r2-d06 repoint loop continue", "cannot reassign `a` while it is lent"
  # re-point in a loop with continue and break, old target used after the loop
  a = String("a")
  b = String("b")
  c = String("c")
  w = !a
  for i in 0..6
    if i % 3 == 0
      w = !b
      continue
    if i == 5
      break
    w = !c
    !w.add("x")
  a = String("A")
  !w.add("!")
  print(a, b, c)

fail "review-step45-r2-d07 repoint branch then old used", "cannot reassign `a` while it is lent"
  # re-point inside a branch; after the join the old target is written while w may still view it
  a = String("a")
  b = String("b")
  w = !a
  if b.len == 1
    w = !b
  a = String("A")
  !w.add("!")
  print(a, b)

fail "review-step45-r2-d08 repoint defer uses w", "use of `b` while a write loan is live"
  # defer writes through w; w re-pointed after; old target dropped before scope end
  b = String("b")
  w = !b
  if true
    a = String("a")
    w = !a
    defer !w.add("d")
    w = !b
  print(b)

test "review-step45-r2-d09 repoint rhs reads old target", "a b!"
  # right side reads the old target a directly (allowed only if w's loan ended): w = pick(?a, !b)
