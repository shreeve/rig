      !t.add("xxxxxxxx")
  print(v[0], w)

test "review-step45-r2-c01b branch subject temp plain", "[50] 2"
  # base-comparable c01: if (!arr[idx(?Text("a"))] if c else !w) as n over [1]Int?: the write must land
  fun idx(s: ?String) -> Int
    s.len - 1

  arr: [1]Int? = [1]
  w: Int? = 2
  c = w != none
  if (!arr[idx(?String("a"))] if c else !w) as n
    n = 50
  print(arr, w)

test "review-step45-r2-c01c branch subject temp noindex", " w"
