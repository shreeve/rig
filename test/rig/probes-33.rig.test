fail "review-subctor-m1", "only module `lib` can construct `lib.M`: its field `v` is private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib

  sub main()
    lib.check(1)!
    lib.check(-1) catch |e|
      print("e", e)
    m = lib.M(3)
    !m.bump(2)!
    print(m)
    w = lib.W(4)
    w2 = lib.W[?String]("s")
    print(w, w2)
    r = lib.Res(List())
    print(r)
    d = lib.D(9)
    print(d)
    a = [1, 2]
    n = lib.each(?a, lib.check)!
    print(n)
    h: sub(Int)! = lib.check
    h(5)!

  file "lib.rig"
    pub error Bad
      neg

    pub sub check(n: Int)!
      return Bad.neg if n < 0
      print("ok", n)

    pub obj M
      v: Int

      sub bump(!@, k: Int)!
        return Bad.neg if k < 0
        @v += k

    pub obj W[T]
      item: T

    pub obj Res
      items: List[Int]

    pub obj D
      n: Int = 7

    pub fun each(xs: []Int, f: ?sub(Int)!) -> Int!
      for x in xs
        f(x)!
      xs.len

