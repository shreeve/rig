test "review-step45-r2-f06 readview elem forms", "20"
  # element of a read-view List in each form: while-as, lends of fields, implicit lend args, ?self method
  obj R
    t: String
    n: Int

    fun len(?@) -> Int
      @t.len + @n

  fun tl(s: ?String) -> Int
    s.len

  fun rl(r: ?R) -> Int
    r.n

  fun f(v: ?List[R], o: ?List[Int?]) -> Int
    k = 0
    i = 0
    while o[i] as x
      k += x
      i += 1
      if i == o.len
        break
    k + tl(?v[0].t) + tl(v[0].t) + rl(v[0]) + rl(?v[0]) + v[0].len()

  v: List[R] = List()
  !v.push(R(t: String("abc"), n: 2))
  o: List[Int?] = List()
  !o.push(5)
  print(f(?v, ?o))

test "review-step45-r2-f07 guarded match slice elem", "5 7"
  # guarded match on an element of a []E slice parameter and a ?[1]E, plain payload
  enum E
    a(n: Int)
    b(n: Int)

  fun f(v: []E) -> Int
    match v[0]
      .a(n) if n > 1 => n
      .a(_) => 1
      .b(n) => n

  fun g(v: ?[1]E) -> Int
    match v[0]
      .a(n) if n > 1 => n
      .a(_) => 1
      .b(n) => n

  e: List[E] = List()
  !e.push(E.a(n: 5))
  a = [E.a(n: 7)]
  print(f(?e), g(?a))

