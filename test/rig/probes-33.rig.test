    y

  a = String("a")
  b = String("b")
  w = !a
  w = pick(?a, !b)
  !w.add("!")
  print(a, b)

test "review-step45-r2-d10 repoint rhs drops old target", "replaced b!"
  # right side drops/replaces the old target through a function that takes ownership-ish ops
  fun swapin(x: !String, y: !String) -> !String
    x = String("replaced")
    y

  a = String("a")
  b = String("b")
  w = !a
  w = swapin(!a, !b)
  !w.add("!")
  print(a, b)

