test "for index counter", '''
  one 7 0
  tail 30 0
  tail 40 1
  5001
  jump 10 0
  jump 30 2
  grid 0 0 40
  grid 0 1 50
  grid 1 0 50
  grid 1 1 60
  byte 0
  byte 1
  byte 2
  byte 3
  list 5 0
  list 6 1
  take 5 0
  take 6 1
'''
  # The index of `for x, i in ...` is the iteration count, at the edges: an
  # empty source, one element, a slice with an offset, `break`, `continue`,
  # nested loops, a String's bytes, and a List the loop consumes.

  fun tally(xs: []Int) -> Int
    n = 0
    for x, i in xs
      n += x * 100 + i
    n

  a = [10, 20, 30, 40]
  empty: [0]Int = []
  one = [7]
  for x, i in ?empty[..]
    print("never", x, i)
  for x, i in ?one[..]
    print("one", x, i)
  for x, i in ?a[2..]
    print("tail", x, i)
  print(tally(?a[1..3]))

  for x, i in ?a[..]
    continue if i == 1
    break if i == 3
    print("jump", x, i)

  for x, i in ?a[..2]
    for y, j in ?a[2..]
      print("grid", i, j, x + y)

  s = String("héy")
  for _, k in ?s
    print("byte", k)

  v: List[Int] = List()
  !v.push(5)
  !v.push(6)
  for x, i in ?v
    print("list", x, i)
  for x, i in <v
    print("take", x, i)

