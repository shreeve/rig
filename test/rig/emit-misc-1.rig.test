test "closure named invoke", '''
  3
  x
  3 3
'''
  # A local, parameter, or closure parameter may be named `invoke`, the
  # name a closure's call would otherwise have in the emitted Zig.

  sub each(n: Int, f: ?sub(Int))
    for i in 0..n
      f(i)

  fun helper(invoke: Int) -> Int
    f = |a: Int| a + 1
    f(invoke)

  fun sum() -> Int
    total = 0
    each(3, |!total, invoke| total += invoke)
    total

  invoke = 3
  print(invoke)
  f = || print("x")
  f()
  print(sum(), helper(2))

bomb "const match binding overflow", "integer overflow", prints: "2\n9223372036854775806", release: true
  # A name a match binds to a constant subject is a run-time value, as is
  # the value an optional constant holds.

  M = 9223372036854775807
  O: Int? = 9223372036854775807

  sub main()
    match 1
      0 => print(0)
      n => print(n + 1)
    if O as x
      print(x - 1)
    match M
      0 => print(0)
      n => print(n + 1)

bomb "const optional propagate none", "integer overflow", prints: "2", release: true
  # `?` of a constant optional binds a run-time value: adding to it
  # overflows when the program runs, not when Zig compiles it.

  O: Int? = 9223372036854775807
  P: Int? = 1

  fun f(o: Int?) -> Int?
    v = o?
    v + 1

  fun g() -> Int?
    v = P?
    w = O?
    v + w

  sub main()
    print(f(1) ?? 0)
    print(g() ?? 0)

bomb "const table conversion", "integer does not fit", prints: "7", release: true
  # A conversion of a constant array's element is checked when the program
  # runs.

  big = [300, 7]

  sub main()
    print(U8(big[1]))
    print(U8(big[0]))

bomb "const table element bound", "integer overflow", prints: "2", release: true
  # A binding of a constant array's element is a run-time value too.

  big = [9223372036854775807, 1]

  sub main()
    small = big[1]
    print(small + 1)
    m = big[0]
    print(m + 1)

bomb "const table element overflow", "integer overflow", prints: "2", release: true
  # An element of a module constant array is a run-time value: the sum
  # overflows when the program runs, not when Zig compiles it.

  big = [9223372036854775807, 1]

  sub main()
    print(big[1] + 1)
    print(big[0] + 1)

bomb "const table row bound", "integer overflow", prints: "1", release: true
  # A row of a nested constant array, bound, is read at run time.

  grid = [[1, 2], [9223372036854775807, 0]]

  sub main()
    row = grid[1]
    print(row[1] + 1)
    print(row[0] + 1)

bomb "const table zero divisor", "division by zero", prints: "8", release: true
  # A zero element of a constant array divides when the program runs.

  zeros = [1, 0]

  sub main()
    print(8 / zeros[0])
    print(8 / zeros[1])

bomb "constructed field overflow", "integer overflow", prints: "2", release: true
  # A field read straight off a constructor is a run-time value.

  obj P
    a: Int = 9223372036854775807

  print(P(a: 1).a + 1)
  print(P().a + 1)

test "consuming method temporary failing arg", '''
  3
  9
'''
  # A consuming method called on a temporary whose later argument fails:
  # the temporary is evaluated first, and dropped when the argument fails.

