test "function values", '''
  4
  6
  4
  Op(f: <fun>, n: 1)
  .op(f: <fun>)
  [<fun>, <fun>]
'''
  # A function bound without an annotation is a function value; values
  # holding functions print as `<fun>`.

  fun twice(n: Int) -> Int
    n * 2

  fun thrice(n: Int) -> Int
    n * 3

  fun half(n: Int) -> Int!
    n / 2

  obj Op
    f: fun(Int) -> Int
    n: Int

  enum K
    op(f: fun(Int) -> Int)
    nothing

  g = twice
  print(g(2))
  g = thrice
  print(g(2))
  h = half
  print(h(8)!)
  print(Op(f: twice, n: 1))
  k: K = .op(f: twice)
  print(k)
  print([twice, thrice])

test "guarded match element of read vec", '''
  5 5 -7
  3
'''
  # A guarded match reads its subject where it is: an element of a List a
  # read view reaches is read through a constant pointer, whether the
  # subject is the element, a lend of it, or a field of it.

  enum E
    a(n: Int)
    b(n: Int)

  obj W
    e: E

  fun f(v: ?List[E]) -> Int
    match v[0]
      .a(n) if n > 1 => n
      .a(_) => 1
      .b(n) => n

  fun g(v: ?List[E], i: Int) -> Int
    match ?v[i]
      .a(n) if n > 10 => 10
      .a(n) => n
      .b(n) => -n

  fun h(ws: ?List[W]) -> Int
    match ws[1].e
      .b(n) if n < 0 => 0
      .b(n) => n
      _ => -1

  e: List[E] = List()
  !e.push(E.a(n: 5))
  !e.push(E.b(n: 7))
  print(f(?e), g(?e, 0), g(?e, 1))
  ws: List[W] = List()
  !ws.push(W(e: E.a(n: 1)))
  !ws.push(W(e: E.b(n: 3)))
  print(h(?ws))

test "guarded match read view element", '''
  zero
  5 5 9
  0
'''
  # A guarded match on an element of a List reached through a read view
  # matches the element where it is: plain, Text, and Cell-holder
  # payloads (the last behind a shared handle), through a parameter and
  # through a field.

  obj C
    c: Cell[Int]

  enum E
    a(n: Int)
    b(n: Int)

  enum T
    a(t: String)
    b

  enum K
    a(x: C)
    b

  obj H
    es: List[E]

  fun plain(v: ?List[E]) -> Int
    match v[0]
      .a(n) if n > 1 => n
      .a(_) => 1
      .b(n) => n

  fun text(v: ?List[T]) -> Int
    match v[0]
      .a(t) if t.len > 1 => t.len
      .a(_) => 1
      .b => 0

  sub cell(v: ?List[*K])
    match v[0]
      .a(x) if x.c.get() == 0 => print("zero")
      .a(_) => print("set")
      .b => pass

  fun field(h: ?H) -> Int
    match h.es[0]
      .a(n) if n > 1 => n
      _ => 0

  e: List[E] = List()
  !e.push(E.a(n: 5))
  t: List[T] = List()
  !t.push(T.a(t: String("hello")))
  k: List[*K] = List()
  !k.push(*K.a(x: C(c: Cell(0))))
  cell(?k)
  es: List[E] = List()
  !es.push(E.a(n: 9))
  h = H(es: <es)
  print(plain(?e), text(?t), field(?h))
  match k[0]
    .a(x) => print(x.c.get())
    .b => pass

test "handle reached through pointer", '''
  4
  1 1
  4
'''
  # A handle reached through a pointer, a held receiver's address or the
  # leaf a branch of lends takes, is dereferenced before its value is
  # reached: a field, and a method whose arguments run first.

  obj Q
    n: Int

    fun get(?@, j: Int, k: Int) -> Int
      @n + j + k

  fun g(k: Int) -> Int
    k

  qs = [*Q(n: 1), *Q(n: 2)]
  print(qs[g(0)].get(k: g(1), j: g(2)))
  h1 = *Q(n: 1)
  h2 = *Q(n: 2)
  c = g(1) == 1
  print((?h1 if c else ?h2).n, (h1 if c else h2).n)
  print((?h1 if c else ?h2).get(k: g(1), j: g(2)))

test "hoisted argument lent", '''
  g
  hello world, long enough to be on the heap
  g
  42
'''
  # An argument lent to a call whose arguments are evaluated first, as the
  # view its parameter expects (a Text temporary as a `?String`, a Box as
  # the value it holds), is held as that view, never as the owner: the
  # statement's slot keeps and drops the owner.

  fun g(k: Int) -> Int
    print("g")
    k

  fun pick(s: ?String, n: Int) -> ?String
    if n > 0
      return s
    "none"

  obj P
    x: Int
    t: String

  fun px(p: ?P, n: Int) -> Int
    p.x + n

  print(pick(n: g(1), s: String("hello world, long enough to be on the heap")))
  b = ^P(x: 40, t: String("t"))
  print(px(n: g(2), p: b))

test "hoisted argument needs type", '''
  18
  9
'''
  # Arguments evaluated into temporaries before a later failing argument
  # keep their types: `List()`, `none`, and `.north` have none on their own.

  error E
    bad

  enum Dir
    north
    south

  fun g(ok: Bool) -> Int!
    return E.bad if not ok
    7

  fun take(v: List[Int], o: Int?, d: Dir, n: Int) -> Int
    k = 10 if d == .north else 20
    v.len + (o ?? 1) + n + k

  fun run(ok: Bool) -> Int!
    take(List(), none, .north, g(ok)!)

  print(run(true) catch 0)
  print(run(false) catch 9)

test "hoisted call receiver first", '''
  121
  recv
  b
  a
  111
  i
  b
  a
  211
  i
  b
  a
  311
  3
  v
  b
  a
  411
'''
  # A method call runs its receiver before its arguments, as written, also
  # when keyword arguments are evaluated into temporaries first.

  obj K
    n: Int

    fun add(?@, a: Int, b: Int) -> Int
      @n * 100 + a * 10 + b

    fun bump(!@, a: Int, b: Int) -> Int
      @n += 1
      @n * 100 + a * 10 + b

  fun take(k: !K) -> K
    k.n = k.n + 1
    K(n: k.n)

  fun say(s: ?String) -> Int
    print(s)
    1

  fun mk(s: ?String) -> K
    print(s)
    K(n: 1)

  k = K(n: 0)
  print(take(!k).add(b: k.n, a: k.n + 1))
  print(mk("recv").add(b: say("b"), a: say("a")))
  ps = [K(n: 1), K(n: 2)]
  print(ps[say("i")].add(b: say("b"), a: say("a")))
  print((!ps[say("i")]).bump(b: say("b"), a: say("a")))
  print(ps[1].n)
  v: List[K] = List()
  !v.push(K(n: 4))
  print(v[say("v") - 1].add(b: say("b"), a: say("a")))

test "hoisted field callable args", '''
  -1
  44
  g 4
  5
  5
'''
  # A callable held in a field, `s.cb(...)`, has no receiver: a call of it
  # whose arguments are evaluated first fills its parameters from its first
  # argument, so an owned argument is held as the value it is and dropped
  # when a later argument fails, and a write view its first parameter
  # takes is of the argument.

  error Bad
    no

  obj Q
    c: Int
    n: Int

  obj H
    q: Q

  obj S
    cb: fun(String, ?Q, Int) -> Int
    wr: fun(!Q, Int) -> Int

  fun gf(k: Int) -> Int!
    if k > 1
      return Bad.no
    k

  fun g(k: Int) -> Int
    print("g", k)
    k

  fun mkh(k: Int) -> H
    H(q: Q(c: k, n: k))

  fun usq(t: String, q: ?Q, n: Int) -> Int
    t.len + q.c + n

  fun wr(q: !Q, n: Int) -> Int
    q.n = q.n + n
    q.n

  fun run(s: ?S, k: Int) -> Int!
    s.cb(String("a text long enough to live on the heap"), ?mkh(5).q, gf(k)!)

  s = S(cb: usq, wr: wr)
  print(run(?s, 2) catch -1)
  print(run(?s, 1) catch -1)
  q = Q(c: 0, n: 1)
  print(s.wr(!q, g(4)))
  print(q.n)

test "hoisted receiver index first", '''
  27
  105 6 1
  112 6 1
'''
  # A method call on an indexed element picks the element before its
  # arguments run, also when the arguments are evaluated into temporaries
  # first (keyword arguments, an owned argument before a failing one).

  error E
    bad

  obj C
    n: Int

    fun sub2(!@, a: Int, b: Int) -> Int
      @n += 100
      a * 10 + b

    sub put(!@, v: List[Int], b: Int)
      @n += 100 + v.len + b

  fun bump(k: !Int) -> Int
    k += 1
    7

  fun bump2(k: !Int) -> Int!
    return E.bad if k > 5
    k += 1
    7

  fun two() -> Int
    2

  sub run()!
    cs = [C(n: 5), C(n: 6)]
    k = 0
    !cs[k].put(List(), bump2(!k)!)
    print(cs[0].n, cs[1].n, k)

  cs = [C(n: 5), C(n: 6)]
  k = 0
  print((!cs[k]).sub2(b: bump(!k), a: two()))
  print(cs[0].n, cs[1].n, k)
  run() catch print("e")

