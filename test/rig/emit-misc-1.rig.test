test "enum payload method", '''
  false
  true
'''
  # Methods declared inside an enum with payload variants.

  enum Shape
    circle(radius: Int)
    point

    fun is_point(?@) -> Bool
      match @
        .circle(_) => false
        .point => true

  s: Shape = .circle(radius: 2)
  print(s.is_point())
  p: Shape = .point
  print(p.is_point())

test "enum payload shared leak", "1"
  # An enum variant carrying a shared handle owns it: the enum drops the
  # handle when it goes.

  obj Wrap
    payload: Int

  enum Slot
    full(b: *Wrap)
    empty

  rc = *Wrap(payload: 5)
  s: Slot = .full(b: <rc)
  match s
    .full(_) => print(1)
    .empty => print(0)

test "error set value", "timeout"
  # A binding of an error-set type holds one of its members, and `match`
  # selects on it.

  error NetworkError
    timeout
    refused
    reset

  e: NetworkError = .timeout
  match e
    .timeout => print("timeout")
    .refused => print("refused")
    .reset => print("reset")

test "fallible mutual recursion", '''
  true
  true
  false
  5
  -1
'''
  # Fallible functions may call each other, and a function type may be
  # fallible: every fallible type is emitted with the error set `anyerror`.

  error Bad
    negative

  fun even(n: Int) -> Bool!
    return Bad.negative if n < 0
    return true if n == 0
    odd(n - 1)!

  fun odd(n: Int) -> Bool!
    return false if n == 0
    even(n - 1)!

  fun half(n: Int) -> Int!
    return Bad.negative if n < 0
    n / 2

  fun apply(f: fun(Int) -> Int!, x: Int) -> Int!
    f(x)!

  print(even(10)!)
  print(odd(7)!)
  print(even(-1) catch false)
  print(apply(half, 10)!)
  print(apply(half, -2) catch -1)

