test "clone viewed handle result", '''
  4
  8
'''
  # `+` of a call that returns a view of a handle clones the handle it
  # views, as it does for a binding holding that view.

  obj Leaf
    n: Int

  error Lookup
    missing

  obj Root
    leaf: *Leaf
    fun first(?@) -> ?*Leaf
      ?@leaf
    fun pick(?@, ok: Bool) -> (?*Leaf)!
      return Lookup.missing if not ok
      ?@leaf

  fun count(root: ?Root) -> Int!
    k = +root.pick(true)!
    k.n

  root = Root(leaf: *Leaf(n: 4))
  k = +root.first()
  print(k.n)
  r = ?root.first()
  j = +r
  print(j.n + (count(?root) catch 0))

