  obj User
    name: ?String

  u = User(name: "x")
  u.name = "y"
  print(u.name)

test "field assign shared drops old", '''
  1
  assigned
  2
'''
  # Assigning a shared handle into a struct field drops the old handle at
  # the assignment; the struct drops the new one when it goes.

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  obj Pair
    a: *Noisy

  p = Pair(a: *Noisy(id: 1))
  n = *Noisy(id: 2)
  p.a = <n
  print("assigned")

test "field assign through write param", '''
  2
  bumped
'''
  # Assigning a field through a `!T` parameter updates the caller's value;
  # compound assignment works on fields too.

  obj Counter
    hits: Int
    label: ?String

  sub bump(c: !Counter)
    c.hits += 1
    c.label = "bumped"

  c = Counter(hits: 0, label: "new")
  bump(!c)
  bump(!c)
  print(c.hits)
  print(c.label)

test "field assign through write self", '''
  1
  2
  end
  2
'''
  # Assigning a field through `!@` drops the old value and keeps the new
  # one in the caller's struct.

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  obj Slot
    held: *Noisy

    sub put(!@, n: *Noisy)
      @held = <n

  s = Slot(held: *Noisy(id: 1))
  !s.put(*Noisy(id: 2))
  print(s.held.id)
  print("end")

