# List[T, inline: n]: a List whose first n elements live inside it.

test "inline list grows past its room, and every member works as a List's", release: true, '''
  [0, 10] [0, 10, 20, 30, 40]
  0 40 [7, 10, 20, 30]
  [7, 10]
  [] 0
  [1, 2, 3]
  [9, 9, 9] [8, 8, 8, 8, 8, 8]
  ["x", "y", "z"]
  [19, 20] 20
  [0, 10] 10
  List[Int, inline: 3]
  [7, 10] 2
'''
  obj Bag
    items: List[String, inline: 2]

  fun make(n: Int) -> List[Int, inline: 3]
    xs: List[Int, inline: 3] = List()
    for i in 0..n
      !xs.push(i * 10)
    xs

  a = make(2)
  b = make(5)
  print(a, b)
  !b.insert(0, 7)
  r = (!b).remove(1)
  p = (!b).pop() ?? -1
  print(r, p, b)
  !b.keep(2)
  print(b)
  !b.clear()
  print(b, b.len)
  print(List[Int, inline: 4]([1, 2, 3]))
  print(List[Int, inline: 4].filled(3, 9), List[Int, inline: 4].filled(6, 8))
  bag = Bag(items: List())
  !bag.items.push(String("x"))
  !bag.items.push(String("y"))
  !bag.items.push(String("z"))
  print(bag.items)
  outer = List[List[Int, inline: 2]]()
  for i in 0..20
    inner: List[Int, inline: 2] = List()
    !inner.push(i)
    !inner.push(i + 1)
    !outer.push(<inner)
  print(outer[19], outer.len)
  moved = <a
  s = 0
  for x in ?moved
    s += x
  print(moved, s)
  print($name($type(b)))
  !b.push(7)
  !b.push(10)
  c = +b
  print(c, c.len)

code "an inline list is the runtime's InlineList", "rig.InlineList(i64, 4)"
  xs = List[Int, inline: 4]()
  !xs.push(1)
  print(xs)

fail "an inline length runs from 1 to 1024", "a List's inline length is from 1 to 1024; got 0"
  xs: List[Int, inline: 0] = List()
  print(xs)

fail "only a List takes an inline length", "`inline:` names no argument of `Cell`; only a List takes one"
  c: Cell[Int, inline: 2] = Cell(1)
  print(c.get())

fail "an inline list is a type of its own", "expected `?List[Int]`, got `?List[Int, inline: 4]`"
  fun sum(xs: ?List[Int]) -> Int
    t = 0
    for x in xs
      t += x
    t

  xs = List[Int, inline: 4]()
  print(sum(?xs))
