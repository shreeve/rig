test "write through local view", '''
  6
  6 20
  drop 1
  3
  bb
  2
  drop 3
'''
  # A local write view is assigned like a `!T` parameter: `w = v` and
  # `w += 1` write through to the viewed value (a resource's old value
  # is dropped), and `new w = !m` points a new binding at another place.

  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  obj In
    n: Int

  obj View
    b: ?In

  n = 1
  w = !n
  w = 5
  w += 1
  print(n)
  m = 10
  new w = !m
  w *= 2
  print(n, m)
  r = R(n: 1)
  if true
    x = !r
    x = R(n: 2)
    x.n += 1
  print(r.n)
  s = "a"
  t = !s
  t = "bb"
  print(s)
  a = In(n: 1)
  y = In(n: 2)
  v = View(b: ?a)
  if true
    u = !v
    u = View(b: ?y)
  print(v.b.n)

