fail "write receiver temporary", "41:5: `bump` changes `self`, a temporary no name holds; add `!`: `!(@twice()).bump()`", "48:1: `bump` changes `self`, a temporary no name holds; add `!`: `!mk().bump()`", "49:1: `bump` changes `self`, a temporary no name holds; add `!`: `!S(n: 1, inner: T(k: 0)).bump()`", "50:7: `next` changes `self`, a temporary no name holds; add `!`: `(!mk()).next()`", "51:2: `bump` changes `self`, a temporary no name holds; add `!`: `!(mk() if c else S(n: 2, inner: T(k: 0))).bump()`", "52:2: `bump` changes `self`, a temporary no name holds; add `!`: `!(+s).bump()`", "53:1: `bump` changes `self`, a temporary no name holds; add `!`: `!mk().inner.bump()`", "54:1: `bump` changes `self`, a temporary no name holds; add `!`: `![T(k: 1), T(k: 2)][0].bump()`", "55:7: `at` changes `self`, a temporary no name holds; add `!`: `(!mk()).at()`", errors: 9
  # A `!@` method changes its receiver, and every change is marked by
  # `!` (Core sentences 4 and 9): called on a value made in place, which no
  # name holds, with no `!`, it is rejected, with the hint to add one. The
  # same holds for a part of such a value, a field or an element, for a
  # branching value whose every branch is made there, for a method that
  # returns a view of the receiver, and in a generic body. Each hint, as
  # written, runs: `test/behavior/ownership/write_receiver_temporary_lent.rig`.
  # A write view a call returns is no temporary: the method writes through
  # it (`test/behavior/ownership/write_receiver_through_returned_view.rig`).

  obj S
    n: Int
    inner: T

    sub bump(!@)
      @n += 1

    fun next(!@) -> Int
      @n += 1
      @n

    fun at(!@) -> !Int
      !@n

  obj T
    k: Int

    sub bump(!@)
      @k += 1

  obj Wrap[V]
    v: V

    sub bump(!@)
      pass

    fun twice(?@) -> Wrap[V]
      Wrap(v: @v)

    sub again(?@)
      @twice().bump()

  fun mk() -> S
    S(n: 1, inner: T(k: 0))

  c = mk().n == 1
  s = mk()
  mk().bump()
  S(n: 1, inner: T(k: 0)).bump()
  print(mk().next())
  (mk() if c else S(n: 2, inner: T(k: 0))).bump()
  (+s).bump()
  mk().inner.bump()
  [T(k: 1), T(k: 2)][0].bump()
  print(mk().at() + 1)
  Wrap(v: 1).again()
  print(s.n)

