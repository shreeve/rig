    items: List[Item]

    fun first(!@) -> ?Item
      ?@items[0]

    fun consume(!@, it: ?Item) -> Int
      !@items.push(Item(n: 0))
      it.n

  b = Bag(items: List())
  !b.items.push(Item(n: 7))
  print((!b).consume((!b).first()))

