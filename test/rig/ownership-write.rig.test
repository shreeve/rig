  # A `!` that does not reach a write method's temporary receiver: one
  # outside a chain the receiver-sigil rule stops at (`!o?.pop()` lends
  # what `pop` returns), and the `!` before a `for` source, which is the
  # loop's mode. The diagnostic says so, and names what works.

  obj S
    n: Int
    items: List[Int]

    fun pop(!@) -> Int
      @n += 1
      @n

    fun vs(!@) -> ![]Int
      !@items[..]

  fun mk(n: Int) -> S
    S(n: n, items: List())

  fun mkopt(n: Int) -> S?
    return none if n == 0
    mk(n)

  fun go(n: Int) -> Int?
