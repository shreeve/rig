test "write view lent as copied read", '''
  3 8
  4 5
'''
  # A held write view may be lent where a read view is expected. A read
  # view of a scalar, or of an optional one, is a copy of the value, so
  # the write view is read through there. (A written `!x` there only
  # reads, and is rejected: test/reject/ownership/
  # ignored_write_lend_read_view.rig.)

  fun peek(m: ?(Int?)) -> Int
    m ?? 0

  fun twice(n: ?Int) -> Int
    n * 2

  x: Int? = 3
  n: Int = 4
  k: Int = 5
  wx = !x
  wn = !n
  wk = !k
  print(peek(wx), twice(wn))
  g: [2]?Int = [wn, wk]
  print(g[0], g[1])

fail "write view lent bare", "13:5: write `!@bump()`: the call writes `@`", "26:8: write `!c`: the call writes through `c`", "30:3: `fill` writes the elements; lend `self` with `!`: `!xs.fill(0)`", "33:14: write `!c`: the call writes through `c`", "38:1: write `!w.bump()`: the call writes `w`"
  # Lending a write view always shows its sigil: a held write view (a
  # `!T` parameter, `@` in a `!@` method, a local) is lent to a `!T`
  # parameter, a `!@` receiver, or an element method as `!w`. A held
  # read view is lent on bare.

  obj Counter
    n: Int

    sub bump(!@)
      @n += 1

    sub twice(!@)
      @bump()
      !@bump()

    fun get(?@) -> Int
      @n

  sub bump(c: !Counter)
    !c.bump()

  fun peek(c: ?Counter) -> Int
    c.get()

  sub echo(c: !Counter, r: ?Counter)
    bump(c)
    print(peek(r), peek(c))

  sub fill(xs: ![]Int)
    xs.fill(0)

  sub reset(c: !Counter)
    old = swap(c, Counter(n: 0))
    print(old.n)

  c = Counter(n: 0)
  w = !c
  w.bump()
  !w.twice()
  d = Counter(n: 0)
  echo(!c, ?d)
  xs = [1, 2, 3]
  fill(!xs[..])

