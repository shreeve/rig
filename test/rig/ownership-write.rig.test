    s: String = String()
    v: List[?String] = List()

    sub selfview(!@)
      !@v.push(?@s)

  sub viewparam(x: !V)
    !x.v.push(?x.s)

  print(1)

test "write a call's write view read where a value is stored", "[10, 10] 10"
  # A `!Int` a call gives, where an `Int` is stored, is read there (SPEC
  # §7 "Second-class views"): the lend of `v` it took ends with the
  # read, before the place stored into is lent.
  # oracle: main accept

  fun slot(v: !List[Int], i: Int) -> !Int from v
    !v[i]

  obj P
    x: Int

  sub main()
    v: List[Int] = List()
    !v.push(10)
    !v.push(2)
    v[1] = slot(!v, 0)
    p = P(x: 1)
    p.x = slot(!v, 1)
    slot(!v, 1) = slot(!v, 0)
    print(v, p.x)

