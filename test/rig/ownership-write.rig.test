test "write a String from a sibling field", "5 4"
  # A `String` holds no view (Core s7: a store carries the loans of
  # only what could hold it), so `!@b.add(@nl)` stores nothing that
  # views `@`, through self or a write-view parameter.
  # oracle: W.raw accept
  # oracle: W.raw2 accept
  # oracle: W.raw3 accept
  # oracle: viaparam accept

  obj W
    nl: String = String()
    b: String = String()
    n: Int = 0

    sub raw(!@)
      @n = @b.len
      !@b.add(@nl)

    sub raw2(!@)
      !@b.add(@nl)

    sub raw3(!@)
      !@b.add(?@nl)
      @n = @b.len

  sub viaparam(w: !W)
    !w.b.add(w.nl)

  w = W(nl: String("\n"), b: String("x"))
  !w.raw()
  !w.raw2()
  !w.raw3()
  viaparam(!w)
  print(w.b.len, w.n)

