  # view, leave their values usable after it.

  sub f(s: !String, a: ![3]Int, n: !Int, o: !Int?)
    s = String("changed")
    a[0] = 42
    n += 1
    o = none
    for x in !a
      x += 1

  s = String("hi")
  a = [1, 2, 3]
  n = 5
  o: Int? = 3
  f(!s, !a, !n, !o)
  f(!s, !a, !n, !o)
  print(s, a, n, o)

test "write view branches read", '''
  11
  1 2
'''
  # A branching value of write views where the value they see is wanted
  # reads that value in each branch (Core §4): a bare name binds it.
  # Changing the copy changes neither viewed value.
  # oracle: names accept

  fun pick() -> Bool
    true

  sub names()
    n = 1
    m = 2
    w = !n
    v = !m
    y = w if pick() else v
    y += 10
    print(y)
    print(n, m)

  names()

