test "write through view of view", '''
  b
  c
  0 none a
  b
  c a b c
  1 2
  3 2
  8 7 8
'''
  # A write view `!T` whose `T` is itself a view (`T = ?P` in a generic)
  # writes that view: assigning through it points the view at another
  # place, and drops nothing. So for a call's write view, its `?`, a `!T`
  # binding, a generic body's, and a Map's `edit` and `ensure`.


  obj P
    x: Int
    n: String

  fun gslot[T](v: !List[T], i: Int) -> !T from v
    !v[i]

  fun gpick[T](v: !List[T], i: Int) -> (!T)? from v
    return none if i >= v.len
    !v[i]

  sub setit[T](v: !List[?T], x: ?T) keeps x
    gslot(!v, 0) = x

  fun opt(v: !List[?P], b: ?P, i: Int) -> Int? keeps b
    gpick(!v, i)? = b
    i

  sub bind(v: !List[?P], b: ?P) keeps b
    w = gslot(!v, 0)
    w = b

  sub edit(m: !Map[Int, ?P], b: ?P) keeps b
    if (!m).edit(1) as w
      w = b

  fun at(m: ?Map[Int, ?P], k: Int) -> Int?
    m.get(k)?.x

  fun medit(m: !Map[Int, ?P], b: ?P) -> Int? keeps b
    (!m).edit(1)? = b
    1

  a = P(x: 1, n: String("a"))
  b = P(x: 2, n: String("b"))
  c = P(x: 3, n: String("c"))
  v: List[?P] = List()
  !v.push(?a)
  gslot(!v, 0) = ?b
  print(v[0].n)
  setit(!v, ?c)
  print(v[0].n)
  print(opt(!v, ?a, 0), opt(!v, ?b, 5), v[0].n)
  w = gslot(!v, 0)
  w = ?b
  print(v[0].n)
  bind(!v, ?c)
  print(v[0].n, a.n, b.n, c.n)
  m = Map[Int, ?P]()
  !m.put(1, ?a)
  print(medit(!m, ?b), at(?m, 1))
  edit(!m, ?c)
  (!m).ensure(2, ?a) = ?b
  print(at(?m, 1), at(?m, 2))
  shared: List[?*P] = List()
  s1 = *P(x: 7, n: String("s1"))
  s2 = *P(x: 8, n: String("s2"))
  !shared.push(?s1)
  gslot(!shared, 0) = ?s2
  print(shared[0].x, s1.x, s2.x)

fail "write through view of view local", "13:3: cannot store a view of `d`", "18:3: cannot store a view of `d`", errors: 2
  # Pointing a view a write view reaches at another place stores that view
  # where the write view reaches: the caller's List here, which outlives a
  # local. So for a call's write view and a `!T` binding of it.

  obj P
    x: Int

  fun gslot[T](v: !List[T], i: Int) -> !T from v
    !v[i]

  sub call(v: !List[?P])
    d = P(x: 1)
    gslot(!v, 0) = ?d

  sub bind(v: !List[?P])
    d = P(x: 1)
    w = gslot(!v, 0)
    w = ?d

  a = P(x: 0)
  v: List[?P] = List()
  !v.push(?a)
  call(!v)
  bind(!v)
  print(v[0].x)

test "write view arg plain pointee", '''
  3 22
  45 23
  2 5 6
'''
  # A write view of a value that cannot hold a view keeps no loan of
  # the call's other arguments.

  sub f(a: !Int, b: !Int)
    a += 1
    b += 10

  sub g(acc: !Int, y: ?Int)
    acc += y

  sub h(out: !List[Int], k: ?Int)
    !out.push(k)

  sub fill(out: !List[Int])
    t = 5
    h(!out, ?t)
    t += 1
    h(!out, ?t)

  x = 1
  y = 2
  f(!x, !y)
  f(!x, !y)
  print(x, y)
  acc = 0
  g(!acc, ?y)
  y += 1
  g(!acc, ?y)
  print(acc, y)
  v: List[Int] = List()
  fill(!v)
  print(v.len, v[0], v[1])

