test "write lend temporary siblings", '''
  1
  11
  123 123 123
  2 102
  k 1
  k 2
  drop 2
  drop 6
  11
  11
  drop 11
  drop 201
  -1
  k 20
  k 21
  drop 21
  40 40
  end
  61
  drop 61
  deferred 50
  deferred 51
  drop 51
'''
  # `!` lends any temporary to write (Core sentence 4) wherever a write
  # lend goes: the receiver of a generic type's `!@` method, also in a
  # generic body, and of a plain struct's; a Text; an array or List lent
  # whole or sliced as a `![]T`; a generic function's `!List[T]`; a call
  # followed by `?` or `!`, or under `catch`; a receiver whose method
  # takes a closure, which may capture a name to write; a branching value
  # made in every branch; a clone; and `defer`. Each lives in its
  # statement's slot until the statement ends.


  obj Wrap[V]
    v: V

    sub set(!@, v: V)
      @v = v

    fun swap_in(!@, v: V) -> V
      old = @v
      @v = v
      old

    fun twice(?@) -> Wrap[V]
      Wrap(v: @v)

    sub again(?@)
      !(@twice()).set(@v)

  obj C
    c: Int

    sub bump(!@)
      @c += 1

    fun pop(!@) -> Int
      @c += 10
      @c

  obj B
    n: Int
    items: List[Int]

    sub each(!@, f: ?sub(Int))
      @n += 1
      for x in @items
        f(x)

    fun tryit(!@) -> Int!
      @n += 1
      if @n > 100
        return Bad.big
      @n

    drop(!@)
      print("drop", @n)

  error Bad
    big

  fun mkb(n: Int) -> B
    b = B(n: n, items: List())
    !b.items.push(n)
    !b.items.push(n + 1)
    b

  fun mkc() -> C
    C(c: 1)

  fun mkv() -> List[Int]
    v: List[Int] = List()
    !v.push(3)
    !v.push(1)
    !v.push(2)
    v

  fun mka() -> [3]Int
    [3, 1, 2]

  fun sum(xs: []Int) -> Int
    t = 0
    for x in xs
      t = t * 10 + x
    t

  fun sorted(xs: ![]Int) -> Int
    sort.sort(!xs)
    sum(?xs)

  sub push_one[T](v: !List[T], x: T)
    !v.push(x)

  fun first_of(v: !List[Int]) -> Int?
    (!v).pop()?

  fun top() -> Int?
    x = (!mkv()).pop()?
    x + 100

  fun fails() -> Int!
    (!mkb(200)).tryit()!

  !Wrap(v: 1).set(2)
  print((!Wrap(v: 1)).swap_in(5))
  Wrap(v: 7).again()
  !mkc().bump()
  print((!mkc()).pop())
  !String("a").add("b")
  print(sorted(!mka()[..]), sorted(!mkv()[..]), sorted(!mka()))
  sort.sort(!mka())
  sort.sort(!mkv())
  push_one(!mkv(), 4)
  print(first_of(!mkv()) ?? 0, top() ?? 0)
  !mkb(1).each(|k| print("k", k))
  total = 0
  !mkb(5).each(|!total, k: Int| total += k)
  print(total)
  print((!mkb(10)).tryit() catch 0)
  print(fails() catch -1)
  c = total > 0
  !(mkb(20) if c else mkb(30)).each(|k| print("k", k))
  s = Wrap(v: 40)
  print((!(+s)).swap_in(41), s.v)
  defer !mkb(50).each(|k| print("deferred", k))
  defer print((!mkb(60)).tryit() catch 0)
  print("end")

test "write lend temporary store ok", '''
  drop ["kept"]
  drop ["kept"]
  end kept
'''
  # A temporary lent to write as a receiver holds what the call stores, as
  # a name does: a view of a value that outlives the statement may be
  # stored there, and the temporary's `drop` reads it before the statement
  # ends (`test/reject/ownership/write_lend_temporary_stores.rig`). A
  # holder with no `drop` body may even hold a view of a temporary made
  # after it, which the statement drops first: dropping the holder reads
  # nothing (Core sentence 6), as for a name.
  # oracle: main accept

  obj PR
    r: ?String

    sub set(!@, r: ?String) keeps r
      @r = r

  obj S
    t: String

  fun mk(n: Int) -> S
    S(t: String("t", n))

  fun mkpr() -> PR
    PR(r: "")

  obj H
    rs: List[?String]

    sub keep(!@, r: ?String) keeps r
      !@rs.push(r)

    drop(!@)
      print("drop", @rs)

  fun mkh() -> H
    H(rs: List())

  t = String("kept")
  !mkh().keep(?t)
  !mkh().rs.push(?t)
  !mkpr().set(?mk(1).t)
  print("end", t)

fail "write lend temporary stores", "33:16: a view of the temporary `mk(1)` is held by `mkh()`, a temporary its statement drops after it; bind the value to a name first", "36:19: a view of the temporary `mk(1)` is held by `mkh()`, a temporary its statement drops after it; bind the value to a name first", "42:20: `s` does not live long enough", errors: 3
  # A temporary lent to write as a method's receiver, or a part of one,
  # holds what the call stores in it, as a name does
  # (`store_into_unnamed_receiver.rig`): a view of a temporary made after
  # it, which its statement drops first, would be read by its `drop`.
  # oracle: stores_string reject C5
  # oracle: pushes_string reject C5
  # oracle: stores_through_bang reject C5

  obj S
    n: Int
    t: String
    items: List[Int]

  obj H
    rs: List[?String]

    sub keep(!@, r: ?String) keeps r
      !@rs.push(r)

    drop(!@)
      print(@rs)

  fun mk(n: Int) -> S
    S(n: n, t: String("t"), items: List())

  fun mkh() -> H
    H(rs: List())

  fun wrap(h: !H) -> !H
    h

  sub stores_string()
    !mkh().keep(?mk(1).t)

  sub pushes_string()
    !mkh().rs.push(?mk(1).t)

  sub stores_through_bang()
    h = mkh()
    if h.rs.len == 0
      s = mk(1)
      !wrap(!h).keep(?s.t)

  stores_string()

test "write lend temporary view", '''
  grown 2
  grown 2
  grown 4
  grown 2
  1
  was 2
  drop 2
  drop 20
  was 3
  drop 3
  drop 30
  was 4
  drop 40
  4
  123 12 12 2
  drop 4
'''
  # `!` lends any value to write (Core sentence 4): a call's result, a
  # struct literal, a clone, a moved or new handle, a branching value made
  # in every branch, or a field or element of one, passed where a `!T` or
  # `![]T` is expected. The temporary lives in its statement's slot, where
  # the callee's change is seen and dropped with it.
  # oracle: main accept


  obj S
    n: Int

    fun twin(?@) -> S
      S(n: @n)

  obj P
    n: Int

    drop(!@)
      print("drop", @n)

  fun make() -> S
    S(n: 1)

  fun mkp(n: Int) -> *P
    *P(n: n)

  fun mka() -> [3]Int
    [3, 1, 2]

  fun mkv() -> List[Int]
    v: List[Int] = List()
    !v.push(2)
    !v.push(1)
    v

  sub grow(s: !S)
    s.n += 1
    print("grown", s.n)

  sub bump(n: !Int)
    n += 1

  sub repoint(p: !*P)
    print("was", p.n)
    p = *P(n: p.n * 10)

  fun digits(xs: ![]Int) -> Int
    sort.sort(!xs)
    t = 0
    for x in xs
      t = t * 10 + x
    t

  o = S(n: 1)
  c = o.n == 1
  grow(!make())
  grow(!(o.twin()))
  grow(!S(n: 3))
  grow(!(make() if c else S(n: 5)))
  bump(!make().n)
  print(o.n)
  repoint(!mkp(2))
  h = *P(n: 3)
  repoint(!(<h))
  k = *P(n: 4)
  repoint(!(+k))
  print(k.n)
  print(digits(!mka()), digits(!mkv()), digits(!mka()[1..]), digits(!mkv()[..1]))
  sort.sort(!mka())
  !mka().fill(0)

