test "generic plain tells a Static from a viewed String", '''
  ?String ?String Static
  true false
  kept lit
  none
'''
  # A `Static` and a `?String` given as `T` are one Zig type, but the
  # instance's bit tells them apart: the `?String`'s branch is not
  # compiled, so no owned closure keeps a view of `s` past its drop.
  fun name[T](x: T) -> ?String
    $name(T)

  fun pl[T](x: T) -> Bool
    $plain(T)

  fun later[T: Print](x: T) -> *sub()
    if $plain(T)
      return *|+x| print("kept", x)
    *|| print("none")

  s = String("abc")
  a: Static = "lit"
  f = later(a)
  g = later(?s)
  print(name(?s), name(a), $name(Static))
  print(pl(a), pl(?s))
  <s
  f()
  g()

