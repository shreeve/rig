test "generic plain narrows else if, a guard, a while, and an arm", "1 2 3 0 1 2"
  fun f[T](x: T, c: Bool) -> Int
    if c
      return 0
    else if $plain(T)
      y = x
      _ = y
      return 1
    else
      return 2

  fun g[T](x: T, v: !List[T]) -> Int
    !v.push(x) if $plain(T)
    n = 0
    while $plain(T) and n < 2
      !v.push(x)
      n += 1
    v.len

  fun h[T](x: T, n: Int) -> Int
    match n
      0 if $plain(T)
        y = x
        _ = y
        return 1
      _ => return 2

  a: List[Int] = List()
  b: List[String] = List()
  print(f(3, false), f(String("s"), false), g(4, !a), g(String("t"), !b), h(5, 0), h(String("u"), 0))

