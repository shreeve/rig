test "generic plain copies a composite of plain parameters", "3 2"
  # The packed fill copies an `Entry[K, V]`; with both plain, it copies.
  obj Entry[K, V]
    key: K
    val: V

  pub fun spread[K: Copy + Owned, V: Copy + Owned](es: ?List[Entry[K, V]], n: Int) -> List[Entry[K, V]]
    filler = es[0]
    List.filled(n, filler)

  fun spread_private[K, V](es: ?List[Entry[K, V]], n: Int) -> Int
    if $plain(K) and $plain(V)
      a = es[0]
      b = a
      c = a
      _ = b
      _ = c
