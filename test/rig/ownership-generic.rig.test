test "generic plain keeps no view of a scalar past its loan", '''
  none
  kept 3
  n 4
'''
  # `hold[?Int]` is not plain, so it compiles the body without the
  # branch and keeps no view of `n`, which changes after.
  fun hold[T: Print](x: T) -> *sub()
    if $plain(T)
      return *|+x| print("kept", x)
    *|| print("none")

  n = 3
  f = hold[?Int](?n)
  g = hold[Int](n)
  n = 4
  f()
  g()
  print("n", n)

