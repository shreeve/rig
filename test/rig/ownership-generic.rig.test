test "generic plain narrows an associated type", "2 2"
  use std.iter

  obj Count
    n: Int
    hi: Int

    fun next(!@) -> Int?
      return none if @n >= @hi
      @n += 1
      @n

  obj Words
    i: Int

    fun next(!@) -> String?
      return none if @i >= 2
      @i += 1
      String("w")

  fun twice_first[I: Iter](it: !I) -> Int
    if $plain(I.Item)
      if (!it).next() as x
        a = x
        b = x
        _ = a
        _ = b
        return 2
    iter.count(!it)

  c = Count(n: 0, hi: 3)
  w = Words(i: 0)
  print(twice_first(!c), twice_first(!w))

test "generic plain gives a pub generic Copy beside its bounds", '''
  5 5
