test "generic plain meets a bound Copy and Owned give", "1 0 1 0"
  # A bounded `T`, or a private one, is plain where the test held, so a
  # call there meets `Copy + Owned`.
  fun need[T: Copy + Owned](x: T) -> Int
    1

  fun call[T: Print](x: T) -> Int
    if $plain(T)
      return need(x)
    0

  fun call2[T](x: T) -> Int
    if $plain(T)
      return need(x)
    0

  print(call(3), call(String("s")), call2(4), call2(String("t")))

test "generic plain passes through a wrapper", "3 1"
  # `W[Int]` and `W[?Int]` are one Zig type but for the bit each passes
  # its `Slots`.
  obj Slots[K]
    es: List[K] = List()

    sub fill(!@, n: Int)
      if $plain(K) and @es.len > 0
        k = @es[0]
        while @es.len < n
          !@es.push(k)

  obj W[V]
    m: Slots[V]

    sub put(!@, v: V)
      !@m.es.push(<v)

  fun fresh[V]() -> W[V]
    m: Slots[V] = Slots()
    W(m: <m)

  n = 3
  a = fresh[Int]()
  !a.put(n)
  !a.m.fill(3)
  b = fresh[?Int]()
  !b.put(?n)
  !b.m.fill(3)
  print(a.m.es.len, b.m.es.len)

test "generic plain of a type built from a parameter", "true false true false false true false"
  # A bit passed on is `$plain` of the argument, each parameter read as
  # the caller's bit: `T?` and `Pair[T, Int]` are plain where `T` is,
  # `?T` and `List[T]` never are.
  obj Pair[A, B]
    a: A
    b: B

  fun pl[T]() -> Bool
    $plain(T)

  fun of[T]() -> Bool
    pl[T?]() and pl[Pair[T, Int]]()

  fun views[T]() -> Bool
    pl[?T]() or pl[List[T]]()

  obj U unique
    n: Int

  print(of[Int](), of[String](), of[Bool](), views[Int](), views[String](), pl[Pair[Int, Bool]](), pl[U]())

