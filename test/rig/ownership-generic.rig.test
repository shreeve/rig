test "generic plain escapes from the branch run clean", '''
  hook 9
  field true
  defer 9
  4 1
'''
  # The branch's copies leave it by an outer `T`, a List, a field, a
  # capture, a defer, and `break` and `continue`, at `Int`; at `String`
  # the branch is not there.
  obj Holder[T]
    last: T?

  fun all[T: Print](x: T, xs: ?List[T]) -> List[T]
    out: List[T] = List()
    hooks: List[*sub()] = List()
    h = Holder[T](last: none)
    keep: T = <x
    if $plain(T)
      y = keep
      !out.push(y)
      h.last = y
      f: *sub() = *|+y| print("hook", y)
      !hooks.push(<f)
      defer print("defer", y)
      for e in xs
        continue if out.len > 3
        !out.push(e)
        break if out.len > 2
      for g in ?hooks
        g()
      print("field", h.last != none)
    !out.push(<keep)
    out

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  !v.push(3)
  a = all(9, ?v)
  w: List[String] = List()
  !w.push(String("s"))
  b = all(String("x"), ?w)
  print(a.len, b.len)

