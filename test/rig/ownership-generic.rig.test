test "generic plain of a value's known type is a constant", "true false"
  # `$plain($type(x))` with `x` of a known type is that type's answer,
  # and narrows nothing.
  fun known[T](x: T, n: Int) -> Bool
    s = String("s")
    $plain($type(n)) and not $plain($type(s))

  fun other[T](x: T) -> Bool
    s = String("s")
    $plain($type(s))

  print(known(1, 2), other(3))
