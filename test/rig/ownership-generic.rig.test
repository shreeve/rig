test "generic plain matches its bounded form", '''
  hook 3 3
  1 2
'''
  # The branch is checked as a body whose `T` is `T: Copy + Owned` is.
  fun hook[T: Copy + Owned + Print](x: T) -> Int
    hooks: List[*sub()] = List()
    f: *sub() = *|+x|
      y = x
      print("hook", y, x)
    !hooks.push(<f)
    for h in ?hooks
      h()
    hooks.len

  fun twice_first[I: Iter, I.Item: Copy + Owned](it: !I) -> Int
