      @i += 1
      ?@xs[@i - 1]

  obj Count
    n: Int

    fun next(!@) -> Int?
      return none if @n >= 2
      @n += 1
      @n

  fun item_plain[I: Iter](it: !I) -> Bool
    $plain(I.Item)

  v: List[Int] = List()
  !v.push(5)
  w = Views(xs: ?v, i: 0)
  c = Count(n: 0)
  print(item_plain(!w), item_plain(!c))

test "generic plain copies a viewed element as a read view does", "ab 1"
  # A read-view `T` copies where an element of `for x in ?v` is taken
  # and where `as` unwraps a viewed optional, keeping its loans.
  fun first[T](xs: ?List[T]) -> T?
    for x in xs
      return x
    none

  fun unwrap[T](o: ?(T?)) -> Int
    if o as y
      z = y
      _ = z
      return 1
    0

  s = String("ab")
  v: List[?String] = List()
  !v.push(?s)
  o: (?String)? = ?s
  r = first(?v)
  print(r ?? "none", unwrap(?o))

