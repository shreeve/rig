fail "review-syntax-b-1-s78 writeview call obj", "a view reached through `getw(!v)` outlives its statement, which holds `getw(!v)`, itself a view, only while it runs; bind `getw(!v)` to a name first"
  fun getw(v: !List[Int]) -> !List[Int]
    v

  fun keep(xs: []Int) -> []Int
    xs

  v: List[Int] = List()
  !v.push(1)
  r = keep(?getw(!v)[..])
  !v.push(2)
  print(r)

fail "review-syntax-b-1-s79 text view call obj", "a view reached through `gett(!t)` outlives its statement, which holds `gett(!t)`, itself a view, only while it runs; bind `gett(!t)` to a name first"
  fun gett(t: !String) -> !String
    t

  fun word(s: ?String) -> ?String
    s

  t = String("hello")
  r = word(?gett(!t)[1..])
  for _ in 0..50
    !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(r)

