    s: ?String

    sub keep(!self, s: ?String) keeps s
      self.s = s

  t = String("hello")
  h = H(s: "x")
  !h.keep(?t[1..])
  for _ in 0..50
    !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
