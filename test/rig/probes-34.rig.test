    f: ?String

  t = String("hello")
  r = R(f: ?t)
  s = r.f[1..]
  for _ in 0..50
    !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(s)

fail "review-syntax-b-2-a02 writeholder readfield ret", "cannot lend `t` to write while a read loan is live"
  obj R
    f: ?String

  fun cut(r: !R) -> ?String
    r.f[1..]

  t = String("hello")
  r = R(f: ?t)
  s = cut(!r)
  for _ in 0..50
    !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(s)

fail "review-syntax-b-2-a04 readview of slice", "cannot lend `v` to write while a read loan is live"
