  h = *String("hello")
  r = ?h
  s = r[1..]
  h = *String("other")
  print(s)

test "review-syntax-b-2-a14 shared two handles", '''
  ello
  other
'''
  sub f(r: ?*String, h: !*String)
    s = r[1..]
    h = *String("other")
    print(s)

  a = *String("hello")
  b = +a
  f(?a, !b)
  print(b)

test "review-syntax-b-2-a15 shared drop other", "ello"
  sub f(r: ?String, h: *String)
    s = r[1..]
    <h
    print(s)

  a = *String("hello")
  b = +a
  f(?a, <b)

