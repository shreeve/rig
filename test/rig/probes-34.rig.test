fail "review-syntax-b-1-s44 if as", "cannot lend `v` to write while a read loan is live"
  fun find(xs: []Int) -> ([]Int)?
    if xs.len > 0
      xs
    else
      none

  v: List[Int] = List()
  !v.push(1)
  if find(v[..]) as x
    !v.push(2)
    print(x)

fail "review-syntax-b-1-s47 closure param fn", "`apply` returns a view of `f`, but its signature says it views only `xs`"
  fun apply(f: ?fun([]Int) -> []Int, xs: []Int) -> []Int from xs
    f(xs)

  v: List[Int] = List()
  !v.push(1)
  r = apply(|xs: []Int| xs, ?v[..])
  !v.push(2)
  print(r)

fail "review-syntax-b-1-s48 self field", "cannot lend `self.items` to write while a read loan is live"
  fun keep(xs: []Int) -> []Int
    xs

  obj B
    items: List[Int]

    sub go(!self)
      r = keep(?self.items[..])
      !self.items.push(9)
      print(r)

  b = B(items: List())
  !b.items.push(1)
  !b.go()

