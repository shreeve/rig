fail "review-syntax-b-2-b18 write closure param text arg", "cannot lend `w` to write while a read loan is live"
  fun keep(s: ?String) -> ?String
    s

  sub f(w: !String)
    g = |!w|
      s = keep(?w[1..])
      for _ in 0..50
        !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    g()

  t = String("hello")
  f(!t)

fail "review-syntax-b-2-b19 defer slice", "cannot lend `w` to write while a read loan is live"
  sub f(w: !String)
    s = ?w[1..]
    defer print(s)
    for _ in 0..50
      !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")

  t = String("hello")
  f(!t)

