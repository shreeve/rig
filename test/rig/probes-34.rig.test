fail "review-syntax-b-2-b02 match write payload arg", "cannot lend `t` to write while a read loan is live"
  fun keep(s: ?String) -> ?String
    s

  enum E
    a(t: String)
    b

  e = E.a(String("hello"))
  match !e
    .a(t)
      s = keep(?t[1..])
      for _ in 0..50
        !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => print("b")

