test "review-syntax-b-1-s99 holder keep text ok", '''
  ello
  hellozz
'''
  obj H
    s: ?String

    sub keep(!self, s: ?String) keeps s
      self.s = s

  t = String("hello")
  h = H(s: "x")
  !h.keep(?t[1..])
  print(h.s)
  !t.add("zz")
  print(t)

test "review-syntax-b-1-w01 postfix if stmt", "[]"
  v: List[Int] = List()
  !v.push(1)
  c = v.len > 0
  !v.pop() if c
  print(v)

test "review-syntax-b-1-w02 match arm stmt", "[]"
  v: List[Int] = List()
  !v.push(1)
  n = v.len
  match n
    1 => !v.pop()
    _ => !v.push(2)
  print(v)

test "review-syntax-b-1-w03 match arm stmt both", "[]"
  v: List[Int] = List()
  !v.push(1)
  n = v.len
  match n
    1 => !v.pop()
    _ => !v.pop()
  print(v)

test "review-syntax-b-1-w06 if value stmt", "[] [1]"
  v: List[Int] = List()
  w: List[Int] = List()
  !v.push(1)
  !w.push(1)
  c = v.len > 0
  if c
    !v.pop()
  else
    !w.pop()
  print(v, w)

test "review-syntax-b-1-w07 defer", "[1]"
  v: List[Int] = List()
  !v.push(1)
  defer !v.pop()
  print(v)

test "review-syntax-b-1-w16 while as new only", '''
  1
  2
  3
  3
'''
  obj It
    n: Int

    fun next(!self) -> Int?
      return none if self.n >= 3
      self.n += 1
      self.n

  it = It(n: 0)
  while (!it).next() as x
    print(x)
  print(it.n)

test "review-syntax-b-1-w19 prop none stmt", "7"
  fun f(v: !List[Int]) -> Int?
    !v.pop()?
    7

  v: List[Int] = List()
  !v.push(1)
  print(f(!v))

test "review-syntax-b-1-w20 underscore", "[]"
  v: List[Int] = List()
  !v.push(1)
  _ = !v.pop()
  print(v)

test "review-syntax-b-1-w24 stmt paren long", "[1]"
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  (!v).pop()
  print(v)

test "review-syntax-b-1-w33 for source long", '''
  1
  1
'''
  obj C
    n: Int

    fun next(!self) -> [2]Int
      self.n += 1
      [self.n, self.n]

  c = C(n: 0)
  for x in (!c).next()
    print(x)

test "review-syntax-b-1-w35 return postfix", "3"
  obj C
    n: Int

    fun next(!self) -> Int
      self.n += 1
      self.n

  fun f(c: !C) -> Int
    !c.next() if c.n > 5
    3

  c = C(n: 0)
  print(f(!c))

test "review-syntax-b-1-w36 stmt unwrap fail", "2"
  error E
    bad

  obj C
    n: Int

    fun take(!self) -> Int!
      return E.bad if self.n > 5
      self.n += 1
      self.n

  fun run(c: !C) -> Int!
    !c.take()!
    !c.take()!
    c.n

  c = C(n: 0)
  print(run(!c) catch 0)

fail "review-syntax-b-2-a01 field readview slice", "cannot lend `t` to write while a read loan is live"
