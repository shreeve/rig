# Probes from past reviews and audits, 34 of 41: review-syntax-b-1-d06_param_slice_drop to review-syntax-b-2-b24_writeview_of_box_local_arg.

use std.text

fail "review-syntax-b-1-d06 param slice drop", "cannot drop view parameter `w`; the caller owns what it views"
  sub f(xs: []Int, s: ?String, w: ![]Int)
    <xs
    <s
    <w

  a = [1, 2]
  t = String("x")
  f(?a, ?t, !a)

test "review-syntax-b-1-d07 capture clone drop", "2"
  t = String("hi")
  f = |+t| t.len
  print(f())
  <t

fail "review-syntax-b-1-d11 loop index drop", "cannot drop loop view `x`; a `for x in ?list` element is a read view of the List slot and cannot be cloned, moved, dropped, or stored"
  vv: List[List[String]] = List()
  v: List[String] = List()
  !v.push(String("a"))
  !vv.push(<v)
  for x in vv[0]
    <x
  print(vv)

fail "review-syntax-b-1-d12 loop param bang drop", "cannot drop loop view `x`; a `for x in ?list` element is a read view of the List slot and cannot be cloned, moved, dropped, or stored"
  sub f(v: !List[String])
    for x in v
      <x

  v: List[String] = List()
  !v.push(String("a"))
  f(!v)
  print(v)

test "review-syntax-b-1-d15 generic loop drop int", "[1]"
  sub f[T](v: ?List[T])
    for x in v
      <x

  w: List[Int] = List()
  !w.push(1)
  f(w)
  print(w)

test "review-syntax-b-1-d16 capture shadow drop", '''
  hi
  1
  hi
'''
  t = String("hi")
  f = |+t|
    print(t)
    new t = String("local")
    <t
    print(1)
  f()
  print(t)

test "review-syntax-b-1-d17 closure param drop", "1"
  f = |t: String|
    <t
    print(1)
  f(String("a"))

fail "review-syntax-b-1-d19 generic capture", "cannot move captured `x`: the closure keeps what it captures for every call"
  sub run[T](x: T)
    f = |+x|
      <x
    f()

  run(1)

test "review-syntax-b-1-d20 closure local drop", "1"
  f = ||
    u = String("x")
    <u
    print(1)
  f()

test "review-syntax-b-1-h02 hints followed", '''
  4
  [1, 0, 3] hello
'''
  fun name(t: String) -> Int
    t.len

  sub zero(w: ![]Int)
    w[0] = 0

  t = String("hello")
  a = [1, 2, 3]
  print(name(String(t[1..])))
  zero(!a[1..])
  print(a, t)

fail "review-syntax-b-1-s02 vec drop alive", "cannot drop `v` while it is lent"
  fun keep(xs: []Int) -> []Int
    xs

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  r = keep(?v[..])
  <v
  print(r)

fail "review-syntax-b-1-s03 vec move alive", "cannot move `v` while a read loan is live"
  fun keep(xs: []Int) -> []Int
    xs

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  r = keep(?v[..])
  u = <v
  print(r, u)

test "review-syntax-b-1-s05 order grow rev", "1"
  fun grow(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    0

  fun two(n: Int, xs: []Int) -> Int
    xs[0] + n

  v: List[Int] = List()
  !v.push(1)
  print(two(grow(!v), v[0..1]))

fail "review-syntax-b-1-s06 method ret view", "cannot assign to `a[1]` while `a` is lent"
  obj B
    n: Int

    fun pick(?self, xs: []Int) -> []Int
      xs

  a = [1, 2, 3, 4]
  b = B(n: 1)
  r = b.pick(?a[1..])
  a[1] = 9
  print(r)

fail "review-syntax-b-1-s07 nested", "cannot lend `v` to write while a read loan is live"
  fun keep(xs: []Int) -> []Int
    xs

  v: List[Int] = List()
  !v.push(1)
  r = keep(keep(?v[..]))
  !v.push(2)
  print(r)

fail "review-syntax-b-1-s08 closure ret", "cannot lend `v` to write while a read loan is live"
  v: List[Int] = List()
  !v.push(1)
  f = |xs: []Int| xs
  r = f(?v[..])
  !v.push(2)
  print(r)

test "review-syntax-b-1-s100 literal slice", '''
  5
  [5, 6]
  3
'''
  fun total(xs: []Int) -> Int
    n = 0
    for x in xs
      n += x
    n

  fun keep(xs: []Int) -> []Int
    xs

  print(total([1, 2, 3][1..]))
  print(keep([4, 5, 6][1..]))
  t: List[String] = List()
  !t.push(String("a"))
  print(total([t.len, 2][..]))

fail "review-syntax-b-1-s101 literal slice keep", "a view of the temporary `[4, 5, 6]` outlives its statement, which drops it; bind the value to a name first"
  fun keep(xs: []Int) -> []Int
    xs

  r = keep([4, 5, 6][1..])
  print(r)

test "review-syntax-b-1-s102 text literal vec", "2"
  fun count(xs: []String) -> Int
    xs.len

  print(count([String("a"), String("b")][..]))

