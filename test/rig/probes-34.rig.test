fail "review-syntax-b-1-s97 holder keep", "cannot lend `v` to write while a read loan is live"
  obj H
    xs: []Int

    sub keep(!self, xs: []Int) keeps xs
      self.xs = xs

  v: List[Int] = List()
  !v.push(1)
  e = [0]
  h = H(xs: ?e[..])
  !h.keep(?v[..])
  for i in 0..50
    !v.push(i)
  print(h.xs)

fail "review-syntax-b-1-s98 holder keep text", "cannot lend `t` to write while a read loan is live"
