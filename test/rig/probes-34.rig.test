fail "review-syntax-b-1-s32 self method alias", "cannot lend `b` to write while a read loan on `b.items` is live"
  obj B
    items: List[Int]

    sub add_all(!self, xs: []Int)
      for x in xs
        !self.items.push(x)

  b = B(items: List())
  !b.items.push(1)
  !b.items.push(2)
  !b.add_all(b.items[..])
  print(b.items)

fail "review-syntax-b-1-s33 vec push slice", "cannot assign to `arr[0]` while `arr` is lent"
  s: List[[]Int] = List()
  arr = [1, 2, 3]
  !s.push(?arr[..2])
  arr[0] = 9
  print(s)

fail "review-syntax-b-1-s35 store concrete", "cannot assign to `arr[0]` while `arr` is lent"
  sub store(v: !List[[]Int], x: []Int) keeps x
    !v.push(x)

  s: List[[]Int] = List()
  arr = [1, 2, 3]
  store(!s, ?arr[..2])
  arr[0] = 9
  print(s)

