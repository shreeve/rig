# ownership: tests whose names start `origin`.

test "origin from", '''
  1 1
  1
  1
  1
  1
  /home HOMEX
  long
  3
'''
  # `-> T from a` says which arguments a result views (Core sentence 7):
  # the others are free again after the call, even of the same type. The
  # compiler checks each body against its clause.

  obj Entry
    key: ?String
    value: ?String

  obj Env
    entries: List[Entry]

    fun get(?@, key: ?String) -> (?String)? from @
      for e in ?@entries
        if e.key == key
          return e.value
      none

  fun first(a: ?List[Int], b: ?List[Int]) -> ?List[Int] from a
    a

  fun pick[T](a: ?T, b: ?T) -> ?T from a
    a

  fun deep(a: ?List[Int], b: ?List[Int], n: Int) -> ?List[Int] from a
    if n == 0
      return a
    deep(a, b, n - 1)

  fun label(t: ?String) -> ?String from static
    if t.len > 3
      "long"
    else
      "short"

  fun mk() -> List[Int]
    v: List[Int] = List()
    !v.push(9)
    v

  fun span(from: Int, to: Int) -> Int
    to - from

  x: List[Int] = List()
  y: List[Int] = List()
  !x.push(1)
  r = first(?x, ?y)
  !y.push(2)
  print(r.len, y.len)
  s = first(b: ?y, a: ?x)
  !y.push(3)
  print(s.len)
  p = pick(?x, ?y)
  !y.push(4)
  print(p.len)
  d = deep(?x, ?y, 3)
  !y.push(5)
  print(d.len)
  t = first(?x, ?mk())
  print(t.len)
  env = Env(entries: List())
  !env.entries.push(Entry(key: "HOME", value: "/home"))
  q = String("HO", "ME")
  if env.get(?q) as home
    !q.add("X")
    print(home, q)
  w = String("abcd")
  l = label(?w)
  <w
  print(l)
  from = 2
  print(span(from, 5))

fail "origin from body exceeds", "5:3: `tail` returns a view of `b`, but its signature says it views only `a`", "8:10: `early` returns a view of `b`", "12:15: `branch` returns a view of `b`", "15:3: `fallback` returns a view of `b`", "21:3: `through` returns a view of `b`", "24:3: `only` returns a view of `s`, but its signature says it views only what lives for the whole program", errors: 6
  # A body is checked against its `from` clause, whatever form returns the
  # view: a tail value, a `return`, a branch, a fallback, or a call.

  fun tail(a: ?List[Int], b: ?List[Int]) -> ?List[Int] from a
    b

  fun early(a: ?List[Int], b: ?List[Int], c: Bool) -> ?List[Int] from a
    return b if c
    a

  fun branch(a: ?List[Int], b: ?List[Int], c: Bool) -> ?List[Int] from a
    a if c else b

  fun fallback(a: (?List[Int])?, b: ?List[Int]) -> ?List[Int] from a
    a ?? b

  fun both(a: ?List[Int], b: ?List[Int]) -> ?List[Int]
    a

  fun through(a: ?List[Int], b: ?List[Int]) -> ?List[Int] from a
    both(a, b)

  fun only(s: ?String) -> ?String from static
    s

  pass

fail "origin from body forms", "17:5: `get` returns a view of `other`, but its signature says it views only `@`", "20:3: `arm` returns a view of `b`", "29:3: `loop` returns a view of `b`", "33:12: `unwrap` returns a view of `b`", "38:3: `field` returns a view of `b`", "41:3: `payload` returns a view of `b`", errors: 6
  # More forms a body returns a view through, each checked against its
  # `from` clause: a match arm, a loop's `break` value, `if … as`, a field
  # of a local struct, a payload of a parameter, and a method's argument.

  obj Pair
    x: ?List[Int]
    y: ?List[Int]

  enum Pick
    one(v: ?List[Int])
    none_

  obj Table
    rows: List[Int]

    fun get(?@, other: ?List[Int]) -> ?List[Int] from @
      other

  fun arm(a: ?List[Int], b: ?List[Int], n: Int) -> ?List[Int] from a
    match n
      0 => a
      _ => b

  fun loop(a: ?List[Int], b: ?List[Int]) -> ?List[Int] from a
    r = while true
      break b
    else
      a
    r

  fun unwrap(a: ?List[Int], b: (?List[Int])?) -> ?List[Int] from a
    if b as v
      return v
    a

  fun field(a: ?List[Int], b: ?List[Int]) -> ?List[Int] from a
    p = Pair(x: a, y: b)
    p.y

  fun payload(a: ?List[Int], b: ?Pick) -> ?List[Int] from a
    match b
      .one(v) => v
      .none_ => a

  pass

fail "origin from keeps named", "14:1: cannot lend `x` to write while a read loan is live", "17:1: cannot lend `y` to write while a read loan is live", errors: 2
  # The arguments `from` names stay lent while the result lives; a
  # function lent as a value calls with its type's origins, which keep
  # every argument that could hold the result.

  fun first(a: ?List[Int], b: ?List[Int]) -> ?List[Int] from a
    a

  fun apply(f: ?fun(?List[Int], ?List[Int]) -> ?List[Int], a: ?List[Int], b: ?List[Int]) -> ?List[Int]
    f(a, b)

  x: List[Int] = List()
  y: List[Int] = List()
  r = first(?x, ?y)
  !x.push(1)
  print(r.len)
  s = apply(?first, ?x, ?y)
  !y.push(2)
  print(s.len)

fail "origin from names", "4:50: `k: ?Int` cannot hold a view of what `a` returns", "7:41: `b` has no parameter `w`", "10:22: `c` returns `Int`, which views nothing", "13:59: `static` stands alone (`from static`)", errors: 4
  # `from` names parameters whose types could hold what the result views,
  # on a result that views something; `static` stands alone.

  fun a(v: ?List[Int], k: ?Int) -> ?List[Int] from k
    v

  fun b(v: ?List[Int]) -> ?List[Int] from w
    v

  fun c(n: Int) -> Int from n
    n

  fun d(x: ?List[Int], y: ?List[Int]) -> ?List[Int] from y, static
    y

  pass

fail "origin from static", "6:3: `pick` returns a view of `static`, but its signature says it views only what lives for the whole program", errors: 1
  # `from static` means what lives for the whole program: a parameter
  # named `static` cannot be named in `from`, so a body that returns it
  # exceeds the clause, and the note says why.

  fun pick(static: ?List[Int], other: ?List[Int]) -> ?List[Int] from static
    static

  pass

fail "origin holder owns target", "22:6: cannot lend `c` to write while a read loan is live"
  # A cursor that also owns items of the type it hands out keeps itself
  # lent, to read: its result may view its own `scratch`.

  obj Item
    n: Int

  obj Cursor
    items: ?List[Item]
    scratch: List[Item]
    i: Int

    fun next(!@) -> ?Item
      k = @i
      @i += 1
      ?@items[k]

  v: List[Item] = List()
  !v.push(Item(n: 1))
  !v.push(Item(n: 2))
  c = Cursor(items: ?v, scratch: List(), i: 0)
  a = (!c).next()
  b = (!c).next()
  print(a.n, b.n)

test "origin key not kept", '''
  5 2
  7 0
  5 3
'''
  # A call's result carries the loans of only the arguments whose types
  # could hold what it views (Core sentence 7): a key, an index, or a
  # counter is free again after the call.

  obj Item
    n: Int

  obj Key
    id: Int

  obj Table
    items: [4]Item

    fun get(?@, k: ?Int) -> ?Item
      ?@items[k]

    fun find(?@, key: ?Key) -> (?Item)?
      for i in 0..4
        if @items[i].n == key.id
          return ?@items[i]
      none

  fun at(v: ?[4]Item, k: !Int) -> ?Item
    k += 1
    ?v[k - 1]

  t = Table(items: [Item(n: 3), Item(n: 5), Item(n: 7), Item(n: 9)])
  k = 1
  r = ?t.get(?k)
  k = 2
  print(r.n, k)
  key = Key(id: 7)
  if t.find(?key) as hit
    key.id = 0
    print(hit.n, key.id)
  a = [4 of Item(n: 5)]
  i = 0
  s = at(?a, !i)
  i = 3
  print(s.n, i)

fail "origin keyword argument mapping", "10:1: cannot lend `x` to write while a read loan is live"
  # Keyword arguments fill parameters by name: the result keeps the
  # argument that fills `a`, wherever it is written.

  fun first(a: ?List[Int], b: ?List[Int]) -> ?List[Int]
    a

  x: List[Int] = List()
  y: List[Int] = List()
  r = first(b: ?y, a: ?x)
  !x.push(1)
  print(r.len)

test "origin read receiver keeps nothing", '''
  x a
  1
  x cd
  2
  x
'''
  # A method that reads its receiver keeps none of its arguments' views
  # in it (Core sentence 4: nothing changes through a read view), so a key
  # that dies each iteration is fine.

  obj Box2
    label: ?String

    fun show(?@, s: ?String) -> Int
      print(@label, s)
      s.len

  b = Box2(label: "x")
  for n in ["a", "cd"]
    q = String(n)
    k = b.show(?q)
    print(k)
  print(b.label)

fail "origin receiver stored in argument", "18:2: cannot drop `s` while it is lent"
  # A method may store a view of what its receiver holds in what it was
  # lent to write: the receiver stays lent while that view lives.

  obj Holder
    r: []Int

  obj Src
    items: List[Int]

    sub put(?@, out: !Holder) keeps @
      out.r = ?@items[..]

  x = [1, 2]
  h = Holder(r: ?x[..])
  s = Src(items: List())
  !s.items.push(5)
  ?s.put(!h)
  <s
  print(h.r[0])

test "origin receiver stores into argument", "[1, 2, 3] 2"
  # A method may store a view of what it is handed in an argument it was
  # lent to write; its receiver is lent to write only for the call, so
  # the argument keeps what it stored, and the receiver is free after.

  obj View
    xs: []Int

  obj Counter
    n: Int

    sub stash(!@, v: !View, ys: []Int) keeps ys
      @n += 1
      v.xs = ys

  b = [9]
  a = [1, 2, 3]
  v = View(xs: ?b)
  c = Counter(n: 0)
  !c.stash(!v, ?a)
  c.n += 1
  print(v.xs, c.n)

fail "origin same type keeps both", "10:1: cannot lend `y` to write while a read loan is live"
  # Without `from`, a result carries every argument whose type could hold
  # what it views: two arguments of the same type stay lent.

  fun first(a: ?List[Int], b: ?List[Int]) -> ?List[Int]
    a

  x: List[Int] = List()
  y: List[Int] = List()
  r = first(?x, ?y)
  !y.push(1)
  print(r.len)

test "origin store by type", '''
  3 abcd
  kept
  3
'''
  # What a call stores through a write argument carries the loans of only
  # the arguments whose types could be held there (Core sentence 7): a
  # counter's name is free after the call, while the view stored stays.

  obj Counter
    n: Int

  obj Holder
    r: []Int

  sub bump(c: !Counter, name: ?String)
    c.n += name.len

  sub keep(h: !Holder, x: []Int, label: ?String) keeps x
    h.r = x
    print(label)

  c = Counter(n: 0)
  t = String("abc")
  bump(!c, ?t)
  !t.add("d")
  print(c.n, t)
  a = [1, 2]
  b = [3, 4]
  h = Holder(r: ?a[..])
  l = String("kept")
  keep(!h, ?b[..], ?l)
  <l
  print(h.r[0])

fail "origin stores before result", "`w` does not live long enough"
  # A call stores before its result is handed back: `next` re-points
  # `@items` at `extra`, so its result views `w`, which ends first.

  obj Item
    n: Int

  obj Cursor
    items: ?List[Item]

    fun next(!@, extra: ?List[Item]) -> ?Item keeps extra
      @items = extra
      ?@items[0]

  v: List[Item] = List()
  !v.push(Item(n: 1))
  c = Cursor(items: ?v)
  r = ?v[0]
  if true
    w: List[Item] = List()
    !w.push(Item(n: 2))
    r = (!c).next(?w)
  print(r.n)

test "origin view through view", '''
  1 2
  1 5
  1 0
'''
  # A view reached through another view carries that view's loans, not a
  # loan on its holder (Core sentence 7): a cursor holding a view of a List
  # hands out views of the List's items, and stays free to move on.

  obj Item
    n: Int

  obj Cursor
    items: ?List[Item]
    i: Int

    fun next(!@) -> ?Item
      k = @i
      @i += 1
      ?@items[k]

  obj Pair
    a: ?List[Int]
    b: ?List[Int]

  fun left(p: ?Pair) -> ?List[Int]
    p.a

  v: List[Item] = List()
  !v.push(Item(n: 1))
  !v.push(Item(n: 2))
  c = Cursor(items: ?v, i: 0)
  a = (!c).next()
  b = (!c).next()
  print(a.n, b.n)
  r = ?c.items[0]
  c.i = 5
  print(r.n, c.i)
  x: List[Int] = List()
  y: List[Int] = List()
  !x.push(4)
  p = Pair(a: ?x, b: ?y)
  l = left(?p)
  p = Pair(a: ?y, b: ?y)
  print(l.len, p.a.len)

fail "origin write cursor keeps holder", "9:10: a write view is never stored inside a value, and `![]Item` cannot stand here", errors: 1
  # A write cursor cannot hold its items as a write view: a write view is
  # never stored inside a value, so the field is rejected where it is
  # declared, and no two items such a cursor hands out can alias.

  obj Item
    n: Int

  obj Cursor
    items: ![]Item
    i: Int

  a = [Item(n: 1), Item(n: 2)]
  c = Cursor(items: !a, i: 0)
  print(c.i)

test "origin self path reader", "hi 7 8"
  # `from @seen` and `from @text` name the path of self a result views
  # (Core sentence 7): `seen` holds a read view, so the items view the
  # List, not the reader; `word` views `text` alone, so `at` may be
  # written while it lives.

  obj Reader
    text: String
    seen: ?List[Int]
    at: Int

    fun next(!@) -> ?Int from @seen
      @at += 1
      ?@seen[@at - 1]

    fun word(?@) -> ?String from @text
      ?@text[..2]

  v: List[Int] = List()
  !v.push(7)
  !v.push(8)
  r = Reader(text: String("hi there"), seen: ?v, at: 0)
  a = (!r).next()
  b = (!r).next()
  w = ?r.word()
  r.at = 0
  print(w, a, b)

test "origin self path scanner", "12 50"
  # A self that is itself a view lends what that view carries: `number`
  # lends `@` to write again while `whole` lives, since `digits` views
  # only what `@text` views.

  obj Scanner
    text: ?String
    pos: Int
    value: String

    fun digits(!@) -> ?String from @text
      start = @pos
      while @pos < @text.len and @text[@pos] >= 0x30 and @text[@pos] <= 0x39
        @pos += 1
      @text[start..@pos]

    sub number(!@)
      whole = (!@).digits()
      @pos += 1
      frac = (!@).digits()
      print(whole, frac)

  s = Scanner(text: "12.50", pos: 0, value: String())
  !s.number()

test "origin self path items held", "30"
  # A Map's iterator views the Map, not itself (`from @map`): a function
  # lent one to write holds two of its items at once.

  fun both(it: !Items[Int, Int]) -> Int
    a = (!it).next() ?? return 0
    b = (!it).next() ?? return 0
    a.value + b.value

  m: Map[Int, Int] = Map()
  !m.put(1, 10)
  !m.put(2, 20)
  k = ?m.items()
  print(both(!k))

test "origin self path loans copied", '''
  1
  10
'''
  # A result through a read-view field carries the loans self holds as
  # the call runs: pointing the field at a shorter-lived Map afterwards
  # leaves the item viewing the first.

  obj Walk
    map: ?Map[Int, Int]
    at: Int

    fun next(!@) -> (?Int)? from @map
      @at += 1
      @map.get(@at)

  m1: Map[Int, Int] = Map()
  !m1.put(1, 10)
  it = Walk(map: ?m1, at: 0)
  a = (!it).next()
  if it.at == 1
    m2: Map[Int, Int] = Map()
    !m2.put(2, 20)
    it.map = ?m2
    print(it.map.len)
  if a as x
    print(x)

fail "origin self path loans stay", "cannot lend `m1` to write while a read loan is live"
  # The item keeps the first Map lent after the field is pointed away.

  obj Walk
    map: ?Map[Int, Int]
    at: Int

    fun next(!@) -> (?Int)? from @map
      @at += 1
      @map.get(@at)

  m1: Map[Int, Int] = Map()
  m2: Map[Int, Int] = Map()
  !m1.put(1, 10)
  it = Walk(map: ?m1, at: 0)
  a = (!it).next()
  it.map = ?m2
  !m1.put(3, 30)
  print(a)

fail "origin self path kept map", "cannot lend `m1` to write while a read loan is live"
  # A method that re-points the field (`keeps m`) may run while an item
  # lives, and the item still keeps the first Map lent.

  obj Walk
    map: ?Map[Int, Int]
    at: Int

    fun next(!@) -> (?Int)? from @map
      @at += 1
      @map.get(@at)

    sub retarget(!@, m: ?Map[Int, Int]) keeps m
      @map = m

  m1: Map[Int, Int] = Map()
  m2: Map[Int, Int] = Map()
  !m1.put(1, 10)
  it = Walk(map: ?m1, at: 0)
  a = (!it).next()
  !it.retarget(?m2)
  !m1.put(3, 30)
  print(a)

test "origin self path temporary iterator", "1 10"
  # An item of a temporary iterator views the Map, so it outlives the
  # iterator's statement.

  m: Map[Int, Int] = Map()
  !m.put(1, 10)
  e = (!(m.items())).next()
  if e as x
    print(x.key, x.value)

fail "origin self path temporary owner", "a view of the temporary `mk()` outlives its statement"
  # A result viewing an owned field of a temporary views the temporary.

  obj Reader
    text: String

    fun word(!@) -> ?String from @text
      ?@text[..2]

  fun mk() -> Reader
    Reader(text: String("hi there"))

  w = (!mk()).word()
  print(w)

test "origin self path other field", "ab 1 3"
  # An owned path lends that field alone: self's other fields may be
  # written while the result lives, and `from @text, k` carries both.

  obj Buf
    text: String
    n: Int

    fun head(?@) -> ?String from @text
      ?@text[..2]

    fun pick(?@, k: ?String) -> ?String from @text, k
      return k if k.len > @n
      ?@text[..1]

  b = Buf(text: String("abc"), n: 0)
  h = ?b.head()
  b.n = 1
  k = String("xyz")
  p = ?b.pick(?k)
  b.n = p.len
  print(h, b.n - 2, p.len)

test "origin self path write view and api", '''
  2
  11 5
'''
  # A write view of one field leaves the others free, and a path is
  # narrower than an API's `from @`, which a call through the bound uses.

  api Source
    fun take(!@) -> (?Int)? from @

  obj Walk: Source
    items: ?List[Int]
    at: Int

    fun take(!@) -> (?Int)? from @items
      return none if @at >= @items.len
      @at += 1
      ?@items[@at - 1]

  obj B
    a: Int
    c: Int

    fun slot(!@) -> !Int from @a
      !@a

  fun pull[S: Source](s: !S) -> Int
    n = 0
    while (!s).take() as _
      n += 1
    n

  l: List[Int] = List()
  !l.push(1)
  !l.push(2)
  w = Walk(items: ?l, at: 0)
  print(pull(!w))
  b = B(a: 1, c: 2)
  s = (!b).slot()
  b.c = 5
  s += 10
  print(b.a, b.c)

fail "origin self path whole self", "cannot lend `s` to write while a read loan on `s.text` is live"
  # A use of all of self touches the path: `reset` may change `@text`.

  obj Scanner
    text: String
    pos: Int

    fun digits(!@) -> ?String from @text
      @pos += 1
      ?@text[..@pos]

    sub reset(!@)
      @text = String("")

  s = Scanner(text: String("12"), pos: 0)
  r = (!s).digits()
  !s.reset()
  print(r)

test "origin self path view self reset", "1"
  # A read-view path leaves self free, even to write: `reset` may point
  # `@text` elsewhere, and `r` keeps viewing what it viewed.

  obj Scanner
    text: ?String
    pos: Int

    fun digits(!@) -> ?String from @text
      @pos += 1
      @text[..@pos]

    sub reset(!@)
      @text = ""
      @pos = 0

  src = String("12")
  s = Scanner(text: ?src, pos: 0)
  r = (!s).digits()
  !s.reset()
  print(r)

fail "origin self path held views", "cannot lend `w` to write while a read loan is live"
  # An owned path's result also carries the loans self holds: `words`
  # holds views of `w`, which stays lent while `r` lives.

  obj Bag
    words: List[?String]
    n: Int

    fun first(?@) -> ?String from @words
      @words[0]

  w = String("hi")
  l: List[?String] = List()
  !l.push(?w)
  b = Bag(words: <l, n: 0)
  r = ?b.first()
  b.n = 1
  !w.add("!")
  print(r)

fail "origin self path handle", "while `s.h` is lent"
  # A handle field is an owned path: replacing it would drop what the
  # result views.

  obj Buf
    t: String

  obj S
    h: *Buf
    n: Int

    fun view(?@) -> ?String from @h
      ?@h.t[..]

  s = S(h: *Buf(t: String("abc")), n: 0)
  r = ?s.view()
  s.n = 1
  s.h = *Buf(t: String("x"))
  print(r)

fail "origin self path body", "`word` returns a view of `@name`, but its signature says it views only `@text`"
  # The body is checked against the path it names.

  obj Reader
    text: String
    name: String

    fun word(?@) -> ?String from @text
      ?@name[..2]

  print(1)

fail "origin self path body call", "`word` returns a view of `@name`, but its signature says it views only `@text`"
  # A view a call returns counts for each path it was lent.

  fun pick(a: ?String, b: ?String) -> ?String
    return a if a.len > b.len
    b

  obj Reader
    text: String
    name: String

    fun word(?@) -> ?String from @text
      pick(?@text, ?@name)

  print(1)

fail "origin self path body bound", "`next` returns a view of `@b`, but its signature says it views only `@a`"
  # A call through a bound views its receiver: `(!@b).next()` views `@b`.

  obj Two[I: Iter]
    a: I
    b: I

    fun next(!@) -> I.Item? from @a
      (!@b).next()

  print(1)

test "origin self path view of view", "ab"
  # A read view of a read-view field is that same view.

  obj Reader
    text: ?String

    fun rest(?@) -> ?String from @text
      @text

  r = Reader(text: "ab")
  print(r.rest())

