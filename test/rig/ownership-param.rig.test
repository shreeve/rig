# ownership: tests whose names start `param`.

fail "param store alias", "11:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A store through a local write view of parameter `a` lands in `a`'s
  # value, which keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  fun f(a: !Holder, b: !List[Int]) -> Int keeps b
    k = !a
    k.r = ?b[..]
    for i in 0..100
      !b.push(i)
    a.r[0]

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

fail "param store as binding", "11:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A store through an `if !a as h` binding lands in parameter `a`'s value,
  # which keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  fun f(a: !Holder?, b: !List[Int]) -> Int keeps b
    if !a as h
      h.r = ?b[..]
    for i in 0..100
      !b.push(i)
    if ?a as h
      return h.r[0]
    0

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h: Holder? = Holder(r: ?x[..])
  print(f(!h, !v))

fail "param store assign whole", "10:5: cannot lend `b` to write while a read loan is live", errors: 1
  # Assigning write parameter `a` writes into the caller's value, which
  # keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  fun f(a: !Holder, b: !List[Int]) -> Int keeps b
    a = Holder(r: ?b[..])
    for i in 0..100
      !b.push(i)
    a.r[0]

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

fail "param store by value write field", "9:6: a write view is never stored inside a value, and `!Holder` cannot stand here", errors: 1
  # A parameter taken by value cannot hold a `!Holder` that reaches the
  # caller's Holder: a write view is never stored inside a value, so the
  # field is rejected where it is declared.

  obj Holder
    r: []Int

  obj Ctx
    w: !Holder

  print(1)

fail "param store call", "13:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A call that may store its arguments in its `!` arguments stores a view
  # of `b` in parameter `a`, which keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  sub put(h: !Holder, s: []Int) keeps s
    h.r = s

  fun f(a: !Holder, b: !List[Int]) -> Int keeps b
    put(!a, ?b[..])
    for i in 0..100
      !b.push(i)
    a.r[0]

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

fail "param store closure capture", "11:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A closure that captures `!a` and `?b` may store a view of `b` in `a`:
  # making it keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  fun f(a: !Holder, b: !List[Int]) -> Int keeps b
    g = |!a, ?b| a.r = ?b[..]
    g()
    for i in 0..100
      !b.push(i)
    a.r[0]

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

fail "param store closure param", "14:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A closure's write parameter is a parameter too: a view of `b` stored
  # in `a` keeps `b` lent for the rest of the closure's body.

  obj Holder
    r: []Int

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  g = |a: !Holder, b: !List[Int]|
    a.r = ?b[..]
    for i in 0..100
      !b.push(i)
    a.r[0]
  print(g(!h, !v))

fail "param store defer", "12:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A `defer` that stores in parameter `a` runs when its block ends; from
  # there on, `b` stays lent for the rest of the body.

  obj Holder
    r: []Int

  fun f(a: !Holder, b: !List[Int]) -> Int keeps b
    if a.r.len > 0
      defer a.r = ?b[..]
      print(1)
    for i in 0..100
      !b.push(i)
    a.r[0]

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

