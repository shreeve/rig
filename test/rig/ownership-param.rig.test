fail "param store read back", "11:5: cannot lend `c` to write while a read loan is live", errors: 1
  # A view of `b` stored in parameter `a` and read back into a local keeps
  # `b` lent: `t` views `b`'s buffer through `a`.

  obj Holder
    r: []Int

  fun f(a: !Holder, b: []Int, c: !List[Int]) -> Int keeps c
    a.r = ?c[..]
    t = a.r
    for i in 0..100
      !c.push(i)
    t[0] + b.len

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, ?x[..], !v))

fail "param store swap", "11:5: cannot lend `b` to write while a read loan is live", errors: 1
  # `swap` moves a value holding a String that views `b` into parameter
  # `a`, which keeps `b` lent for the rest of the body.

  obj Holder
    s: ?String

  fun f(a: !Holder, b: !String) -> Int keeps b
    q = Holder(s: ?b[0..1])
    swap(!a, !q)
    for _ in 0..100
      !b.add("abcdefgh")
    print(a.s)
    0

  t = String("zz")
  w = String("abc")
  h = Holder(s: ?t[..])
  print(f(!h, !w))

fail "param store then assign owner", "12:3: cannot assign to `b.n` while `b` is lent", errors: 1
  # A read view of `b` stored in parameter `a` keeps `b` lent: `b` cannot
  # be written while the read loan is live.

  obj Item
    n: Int

  obj Holder
    r: ?Item

  fun f(a: !Holder, b: !Item) -> Int keeps b
    a.r = ?b
    b.n = 5
    a.r.n

  x = Item(n: 1)
  y = Item(n: 2)
  h = Holder(r: ?x)
  print(f(!h, !y))

test "param store view", '''
  3 8
  3
  3
  4
  1
  2
  2
  12
  9
  4
  2 2
  2
  bcd abcdef
  6
  bcd
'''
  # A view stored in a view parameter keeps what it views lent for the
  # rest of the body. The owner can still be read, written before the
  # store, and written once the holder's caller is done with it; a caller's
  # view stored there lends nothing of the callee's.

  obj Holder
    r: []Int

    sub set(!self, s: []Int) keeps s
      self.r = s

  obj Text2
    s: ?String

  fun total(xs: []Int) -> Int
    n = 0
    for x in xs
      n += x
    n

  # The owner is written first, then lent and only read.
  fun grow_then_store(a: !Holder, b: !List[Int]) -> Int keeps b
    !b.push(5)
    a.r = ?b[..]
    print(b.len, total(?b[..]))
    a.r[0] + a.r[1]

  # A method stores the view; the owner is read through other views.
  fun store_by_method(a: !Holder, b: !List[Int]) -> Int keeps b
    !a.set(?b[..])
    for x in ?b
      print(x)
    a.r.len

  # A caller's view stored in a parameter lends nothing here.
  fun store_caller_view(a: !Holder, b: []Int, c: !List[Int]) -> Int keeps b
    a.r = b
    !c.push(7)
    a.r[0] + c.len

  # A local holder's loan ends at its last use.
  fun local_holder(b: !List[Int]) -> Int
    x = [9, 9]
    h = Holder(r: ?x[..])
    h.r = ?b[..]
    n = h.r[0]
    !b.push(8)
    n + b.len

  # A closure that captures `!a` and only reads leaves `b` readable.
  fun closure_reads(a: !Holder, b: !List[Int]) -> Int keeps b
    g = |!a, ?b| print(a.r.len, b.len)
    g()
    b.len

  # A String viewing a Text stays readable beside the Text.
  fun text_view(a: !Text2, b: !String) -> Int keeps b
    !b.add("def")
    a.s = ?b[1..4]
    print(a.s, b)
    b.len

  fun mk() -> List[Int]
    v: List[Int] = List()
    !v.push(1)
    !v.push(2)
    v

  x = [9, 9]
  v1 = mk()
  h1 = Holder(r: ?x[..])
  print(grow_then_store(!h1, !v1))
  print(h1.r.len)
  !v1.push(3)
  print(v1.len)
  v2 = mk()
  h2 = Holder(r: ?x[..])
  print(store_by_method(!h2, !v2))
  v3 = mk()
  h3 = Holder(r: ?x[..])
  print(store_caller_view(!h3, ?x[..], !v3))
  print(h3.r[0])
  v4 = mk()
  print(local_holder(!v4))
  v5 = mk()
  h5 = Holder(r: ?x[..])
  print(closure_reads(!h5, !v5))
  t = String("abc")
  q = String("zz")
  w = Text2(s: ?q[..])
  print(text_view(!w, !t))
  print(w.s)

fail "param store view is rejected", "10:5: cannot lend `b` to write while a read loan is live", errors: 1
  # Storing a String viewing `b` in a field of parameter `a` keeps `b`
  # lent for the rest of the body.

  obj Holder
    s: ?String

  fun f(a: !Holder, b: !String) -> Int keeps b
    a.s = ?b[0..1]
    for _ in 0..100
      !b.add("abcdefgh")
    print(a.s)
    0

  t = String("zz")
  w = String("abc")
  h = Holder(s: ?t[..])
  print(f(!h, !w))

fail "param store write field", "13:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A store into a field of a `Holder` that parameter `c` writes lands in
  # what the caller lent, which keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  obj Ctx
    w: Holder

  fun f(c: !Ctx, b: !List[Int]) -> Int keeps b
    c.w.r = ?b[..]
    for i in 0..100
      !b.push(i)
    c.w.r[0]

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  c = Ctx(w: <h)
  print(f(!c, !v))

fail "param store write through", "13:5: cannot lend `b` to write while a read loan is live", errors: 1
  # Assigning a `Holder` field of parameter `c` writes into what the
  # caller lent, which keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  obj Ctx
    w: Holder

  fun f(c: !Ctx, b: !List[Int]) -> Int keeps b
    c.w = Holder(r: ?b[..])
    for i in 0..100
      !b.push(i)
    c.w.r[0]

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  c = Ctx(w: <h)
  print(f(!c, !v))
