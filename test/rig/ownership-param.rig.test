fail "param store match payload", "16:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A store through a `match !a` payload lands in parameter `a`'s value,
  # which keeps `b` lent for the rest of the body.

  obj Holder
    r: []Int

  enum E
    one(h: Holder)
    zero

  fun f(a: !E, b: !List[Int]) -> Int keeps b
    match !a
      .one(h) => h.r = ?b[..]
      .zero => print(0)
    for i in 0..100
      !b.push(i)
    match a
      .one(h) => h.r[0]
      .zero => 0

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  e: E = .one(h: Holder(r: ?x[..]))
  print(f(!e, !v))

fail "param store method", "13:5: cannot lend `b` to write while a read loan is live", errors: 1
  # A method that stores its argument in `!self` stores a view of `b` in
