# types: tests whose names start `match`.

fail "match arm never runs", "this arm never runs: the arms before it cover every value"
  # An arm that follows arms covering every value, or follows a catch-all
  # arm, never runs and is rejected.

  enum Color
    red
    green

  sub show(c: Color, n: U8)
    match c
      .red => print("red")
      .green => print("green")
      other => print("other")
    match n
      _ => print("any")
      1 => print("one")

  show(.green, 1)

fail "match arm value is assignment", "11:7: type mismatch: expected `Int`, got `Void`"
  # A match whose value is used needs a value from every arm; an arm that
  # ends in an assignment has none.

  enum Op
    a
    b

  fun broken(op: Op) -> Int
    match op
      .a
        x = 5
      .b => 7

  print(broken(.a))

fail "match bool value partial", "`match` is not exhaustive: it misses `false`; add an arm for it, or `_ =>` for the rest"
  # A match on a Bool must cover both values.

  b = false
  s = match b
    true => "yes"
  print(s)

fail "match duplicate after guard", "12:4: duplicate arm for variant `circle`", "14:3: this arm never runs"
  # An arm may repeat the pattern of a guarded arm before it, but not of
  # an unguarded one; an arm after a catch-all never runs, guarded or not.

  enum Shape
    circle(r: Int)
    point

  s = Shape.circle(r: 1)
  match s
    .circle(r) if r > 0 => print("positive")
    .circle(r) => print(r)
    .circle(_) if true => print("again")
    _ => print("other")
    .point if true => print("point")

fail "match duplicate arm", "duplicate arm for variant `red`"
  # Two arms for the same variant are rejected.

  enum Color
    red
    green

  c: Color = .red
  match c
    .red => print(1)
    .red => print(2)
    .green => print(3)

fail "match duplicate literal", "overlaps an earlier arm"
  # Two arms that match the same value are rejected.

  n = 2
  match n
    1..3 => print("low")
    2 => print("two")
    _ => print("other")

fail "match guard changes subject", "16:24: a guard cannot change the value being matched", "23:13: a guard cannot change the value being matched"
  # A guard changes nothing it matches: when it fails, a later arm matches
  # the same value, so it may not lend the subject to write, a binding of
  # the arm, or anything reached from them.

  enum Shape
    circle(r: Int)
    point

  fun flip(s: !Shape) -> Bool
    s = .point
    false

  fun kind(s: !Shape) -> Int
    match s
      .point => 0
      .circle(_) if flip(!s) => 1
      .circle(_) => 2

  c: Shape = .circle(r: 1)
  print(kind(!c))
  n = match !c
    .point => 0
    w if flip(!w) => 1
    .circle(r) => r
  print(n)

fail "match guard rules", "19:9: `match` on `Int` is not exhaustive: it misses `1`", "28:9: `match` is not exhaustive: it misses `.full` (its arm has a guard); add an arm for it", "34:19: a guard cannot move a value", "37:8: type mismatch: expected `Bool`, got `Int`"
  # A guard is a Bool that moves nothing, and a guarded arm covers none of
  # its values: the match still needs an arm for them, and the error says
  # why a variant with only a guarded arm is missed.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  enum Slot
    full(b: *B)
    empty

  fun eat(b: *B) -> Bool
    b.n > 0

  fun size(n: Int) -> ?String
    match n
      k if k > 0 => "positive"
      0 => "zero"

  enum Tank
    full(n: Int)
    low

  fun level(t: Tank) -> Int
    match t
      .full(n) if n > 9 => n
      .low => 0

  s: Slot = .full(b: *B(n: 1))
  match <s
    .full(b) if eat(<b) => print("ate")
    _ => print("other")
  match 3
    n if n => print(n)
    _ => print("other")
  print(size(1))

fail "match guarded repeats", "14:5: this pattern overlaps an earlier arm", "17:8: this pattern overlaps an earlier arm", "23:5: this pattern overlaps an earlier arm", "31:5: duplicate arm for variant `red`", "32:13: duplicate arm for variant `green`", "28:9: `match` is not exhaustive: it misses `.green` (its arm has a guard)"
  # A guarded arm may not repeat what an arm before it covers, an integer,
  # a Bool, or a variant, nor repeat itself across its alternatives; what
  # it covers is its own, so a later arm may repeat it.

  enum Light
    red
    amber
    green

  fun count(n: Int, k: Int) -> Int
    match n
      1, 2 => 1
      3..6 if k > 0 => 2
      2 if k > 1 => 3
      4..9 if k > 2 => 4
      3..6 => 5
      7, 7 if k > 3 => 6
      _ => 0

  fun truth(b: Bool, k: Int) -> Int
    match b
      true => 1
      true if k > 0 => 2
      false if k > 0 => 3
      false => 4

  fun light(l: Light, k: Int) -> Int
    match l
      .red => 1
      .amber if k > 0 => 2
      .red if k > 1 => 3
      .green, .green if k > 2 => 4
      .amber => 5

  print(count(1, 0), truth(true, 0), light(.red, 0))

fail "match int runs", "11:5: this pattern overlaps an earlier arm", "14:5: this arm never runs: the arms before it cover every value", "14:5: this pattern overlaps an earlier arm", "17:9: `match` on `I8` is not exhaustive: it misses `3`", "24:9: `match` on `I8` is not exhaustive: it misses `-127`"
  # Integer arms that touch cover the run between them: a pattern inside
  # the run overlaps an earlier arm, an arm after the arms cover every
  # value never runs, and a match that misses a value names the least one.

  fun bytes(b: U8) -> Int
    match b
      0..100 => 1
      101 => 2
      102 => 3
      100 => 4
      98..102 => 8
      104..256 => 5
      103 => 6
      7 => 7

  fun signed(n: I8) -> Int
    match n
      -128..-1 => 1
      1, 2 => 2
      0 => 3
      4..128 => 4

  fun negative(n: I8) -> Int
    match n
      0..128 => 1
      -126..0 => 2
      -128 => 3

  print(bytes(1), signed(1), negative(1))

fail "match large enum", "27:3: duplicate member `op3` in `Op`", "33:6: duplicate arm for variant `op5`", "33:6: variant `op5` has 2 payload fields, pattern destructures 1", "35:5: duplicate arm for variant `op0`", "36:6: no variant `op21` on enum `Op`", "30:9: `match` is not exhaustive: it misses `.op2`, `.op3`, `.op4`, `.op6`, and 13 more", "39:10: no variant `op22` on enum `Op`"
  # An enum of many variants finds each by name: a pattern or a value
  # naming one it lacks is rejected, as is a repeated arm, and a match
  # that misses some names them. A variant declared twice is rejected
  # where it repeats.

  enum Op
    op0
    op1
    op2
    op3
    op4
    op5(a: Int, b: Int)
    op6
    op7
    op8
    op9
    op10
    op11
    op12
    op13
    op14
    op15
    op16
    op17
    op18
    op19
    op3

  fun cost(o: ?Op) -> Int
    match o
      .op0 => 0
      .op5(a, b) => a + b
      .op5(a) => a
      .op1 => 1
      .op0 => 2
      .op21 => 3
      .op19 if true => 19

  o: Op = .op22
  print(cost(?o), Op.op3)

fail "match on string", "cannot `match` on a value of type `Static`"
  # `match` works on enums, integers, and Bool.

  s = "a"
  match s
    other => print(2)

fail "match range pattern bounds", "empty range `3..3`", "the end of range `0..257` does not fit `U8`; it may be at most 256", "the bounds of a range pattern must be constant integers"
  # A range pattern is half-open: `n..n` matches nothing, its end may be
  # one past the type's largest value but no further, and its bounds are
  # constants.

  fun f(n: U8, k: Int) -> Int
    match n
      3..3 => 0
      0..257 => 1
      _ => 2

  sub g(k: Int)
    match k
      0..k => print("dynamic")
      _ => print("other")

  print(f(1, 2))
  g(3)

test "match ranges cover type", "small medium large"
  # Integer ranges that together cover every value of the type make a
  # complete match, needing no default arm.

  fun size(n: U8) -> ?String
    match n
      0..10 => "small"
      10..100 => "medium"
      100..256 => "large"

  print(size(5), size(42), size(200))

fail "match reversed range", "5:3: empty range `5..1`: a range pattern matches from its start up to, not including, its end"
  # A range pattern runs from low to high.

  n = 2
  match n
    5..1 => print("in")
    _ => print("out")

fail "match struct value", "cannot `match` on a value of type `P`"
  # `match` works on enums, integers, and Bool, not on structs.

  obj P
    n: Int

  p = P(n: 1)
  match p
    x => print(x.n)

fail "match unknown variant", "no variant `purple` on enum `Color`"
  # A match arm pattern must name a variant of the scrutinee's enum.

  enum Color
    red
    green

  c: Color = .red
  match c
    .red => print("R")
    .purple => print("P")

fail "match value arm types", "incompatible types `Int` and `Static`"
  # Value-position match arms must unify into a single result type.

  enum Color
    red
    green

  c: Color = .red
  x = match c
    .red => 1
    .green => "no"

fail "match value non exhaustive", "18:11: `match` is not exhaustive: it misses `.blue`; add an arm for it, or `_ =>` for the rest", "21:7: `match` is not exhaustive: it misses `.green`, `.blue`; add an arm for each, or `_ =>` for the rest", "24:7: `match` is not exhaustive: it misses `.b`, `.c`, `.d`, `.e`, and 1 more", "27:7: `match` on `U8` is not exhaustive: it misses `10`", "31:7: `match` on `Int` is not exhaustive: it misses `-1`", "33:7: `match` is not exhaustive: it misses `false`"
  # A match, used as a value or as a statement, must cover every variant
  # or value, or have a default arm; the error names what it misses.

  enum Color
    red
    green
    blue

  enum Big
    a
    b
    c
    d
    e
    f

  c: Color = .red
  x = match c
    .red => 1
    .green => 2
  match c
    .red => print("red")
  g: Big = .a
  match g
    .a => print("a")
  n: U8 = 3
  match n
    0..10 => print("small")
    k if k > 100 => print("big")
  m = -3
  match m
    0..9223372036854775808 => print("not negative")
  match n > 1
    true => print("yes")
  print(x)

fail "match write bool", "6:7: `!` lends to write; use `not` for negation (a `Bool` is lent to write only where a `!Bool` is expected: `f(!flag)`)", "9:5: `!` lends to write; use `not` for negation"
  # `!` before a Bool reads as negation, so a Bool subject is not matched
  # with `match !b`, nor bound with `w = !b`: the message says where a Bool
  # is lent to write.

  b = true
  match !b
    true => print("t")
    _ => print("f")
  w = !b
  print(w)

test "match constant patterns", '''
  1 2 0
  big small
  on off
  warm cold
  bell
'''
  # A module constant whose value Rig knows, an integer, a Bool, or an
  # enum value, is a pattern: it compares by value and binds nothing. A
  # constant's arithmetic is folded; an enum constant covers its
  # variant, so the match on Color needs no `_`.
  enum Color
    red
    green
    blue

  ESC: U8 = 0x1B
  BEL: U8 = 7
  LIMIT = BASE * 10
  BASE = 10
  ON = true
  RED = Color.red
  WARM: Color = .green

  fun kind(c: U8) -> Int
    match c
      ESC => 1
      0x20..0x7F => 2
      _ => 0

  fun size(n: Int) -> ?String
    match n
      LIMIT => "big"
      _ => "small"

  fun flag(b: Bool) -> ?String
    match b
      ON => "on"
      false => "off"

  fun temp(c: Color) -> ?String
    match c
      RED, WARM => "warm"
      .blue => "cold"

  fun ctl(c: U8) -> ?String
    match c
      ESC, BEL => "bell"
      _ => "other"

  sub main()
    print(kind(0x1B), kind(0x41), kind(3))
    print(size(100), size(99))
    print(flag(true), flag(false))
    print(temp(.green), temp(.blue))
    print(ctl(7))

test "match constant pattern with a guard", "10 1 0"
  # A constant pattern takes a guard, as a literal does; a guarded arm
  # covers nothing, so a later arm may name the same constant.
  ESC: U8 = 0x1B

  fun show(c: U8, n: Int) -> Int
    match c
      ESC if n > 0 => n * 10
      ESC => 1
      _ => 0

  sub main()
    print(show(0x1B, 1), show(0x1B, 0), show(2, 1))

test "match qualified constant patterns", "esc red on"
  # `m.NAME` names another module's constant as a pattern.
  use lib

  fun kind(c: U8) -> ?String
    match c
      lib.ESC => "esc"
      _ => "other"

  fun hue(c: lib.Color) -> ?String
    match c
      lib.RED => "red"
      .green => "green"

  fun flag(b: Bool) -> ?String
    match b
      lib.ON => "on"
      _ => "off"

  sub main()
    print(kind(0x1B), hue(.red), flag(true))

  file "lib.rig"
    pub enum Color
      red
      green

    pub ESC: U8 = 0x1B
    pub RED = Color.red
    pub ON = true

fail "match constant pattern overlaps", "13:5: this pattern overlaps an earlier arm", "19:5: this pattern overlaps an earlier arm", "25:5: duplicate arm for variant `red`", errors: 3
  # A constant pattern covers its value as the literal would: a literal,
  # a range, or a variant it repeats is reported.
  enum Color
    red
    green

  ESC: U8 = 0x1B
  RED = Color.red

  fun a(c: U8) -> Int
    match c
      0x1B => 1
      ESC => 2
      _ => 0

  fun b(c: U8) -> Int
    match c
      0x10..0x20 => 1
      ESC => 2
      _ => 0

  fun d(c: Color) -> Int
    match c
      .red => 1
      RED => 2
      .green => 3

  sub main()
    print(a(1), b(1), d(.red))

fail "match constant pattern rejected", "13:5: `HALF` is a constant of type `Float`; a pattern may name a constant that is an integer, a `Bool`, or an enum value", "14:5: `NAME` is a constant of type `Static`", "19:5: a constant a pattern names must be known when Rig checks the program; the value of `TIER` is chosen for each target", "24:5: type mismatch: expected `U8`, got `Int`", errors: 4
  # A constant that is not an integer, a Bool, or an enum value, or whose
  # value Rig does not know, is no pattern; nor is one of another type
  # than the subject.
  use std.target

  HALF = 0.5
  NAME = "esc"
  TIER = 0 if target.arch == .x86_64 else 16
  ESC = 0x1B

  fun fa(n: Int) -> Int
    match n
      HALF => 1
      NAME => 2
      _ => 0

  fun fb(n: Int) -> Int
    match n
      TIER => 1
      _ => 0

  fun fc(c: U8) -> Int
    match c
      ESC => 1
      _ => 0

  sub main()
    print(fa(1), fb(16), fc(1))

test "match constant pattern in each mode", '''
  1
  4
  limit
  moved point
'''
  # A constant pattern binds nothing in a match that writes, reads a
  # payload enum, or takes the value, and a guarded arm may repeat it.
  enum Shape
    circle(r: Int)
    point

  POINT = Shape.point
  ESC: U8 = 0x1B
  LIMIT = 3

  sub main()
    c: U8 = 0x1B
    match !c
      ESC => c = 1
      x => x = 2
    print(c)
    s: Shape = .circle(r: 4)
    match s
      POINT => print("point")
      .circle(r) => print(r)
    n = 3
    match n
      LIMIT if n > 5 => print("big")
      LIMIT => print("limit")
      other if other > 0 => print("pos", other)
      _ => print("other")
    t: Shape = .point
    match <t
      POINT => print("moved point")
      .circle(_) => pass

fail "match constant pattern hidden by a local", "8:5: pattern binding `ESC` shadows the local `ESC`; use a different name"
  # A local made with `new` hides the constant, as it does anywhere
  # else: the name in the pattern binds, and shadows that local.
  ESC = 27

  fun f(n: Int) -> Int
    new ESC = 5
    match n
      ESC => 1
      _ => 0

test "match as a pattern", '''
  12 0 0
  big circle
  tall rect
  point
  other
  circle 2
  rect 6
  none
  5 0 0
  -1
'''
  # `s as .circle(r)` tests a variant and binds its fields: a `match`
  # with one arm, whose other values fall to `else` (docs/AS-PATTERNS.md).
  enum Shape
    circle(r: Int)
    rect(w: Int, h: Int)
    point

  fun area(s: Shape) -> Int
    if s as .circle(r)
      3 * r * r
    else
      0

  fun kind(s: Shape) -> ?String
    if s as .circle(r) and r > 10
      return "big circle"
    if s as .rect(h: tall) and tall > 3
      return "tall rect"
    if s as .point
      return "point"
    "other"

  fun describe(s: Shape) -> String
    if s as .circle(_)
      n = if s as .circle(r)
        r
      else
        0
      String("circle ", n)
    else if s as .rect(w, h)
      String("rect ", w * h)
    else
      String("none")

  fun radius(m: Shape?) -> Int
    if m as s and s as .circle(r)
      r
    else
      0

  print(area(.circle(r: 2)), area(.rect(w: 2, h: 3)), area(.point))
  print(kind(.circle(r: 20)))
  print(kind(.rect(w: 1, h: 5)))
  print(kind(.point))
  print(kind(.circle(r: 1)))
  print(describe(.circle(r: 2)))
  print(describe(.rect(w: 2, h: 3)))
  print(describe(.point))
  print(radius(.circle(r: 5)), radius(.point), radius(none))
  v = if kind(.point) == "x"
    1
  else
    -1
  print(v)

test "match as a pattern in a loop", '''
  0
  10
  skip 20
  30
  done 4
'''
  # `while e as .v(x)` repeats while the variant matches; `continue` and
  # the step go on, and a value of another variant ends the loop.
  enum Token
    item(n: Int)
    done

  fun next(i: Int) -> Token
    if i < 4
      .item(n: i * 10)
    else
      .done

  i = 0
  while next(i) as .item(x) : i += 1
    if x == 20
      print("skip", x)
      continue
    print(x)
  print("done", i)

fail "match as a pattern rejected", "9:6: `as` with a pattern tests which variant an enum value is, and `n` is an `Int`", "11:12: no variant `two` on enum `Box`", "13:12: variant `one` has 2 payload fields, pattern destructures 1", "15:7: `as` binds only in the condition of an `if` or `while` block", "21:5: cannot assign to `r`: it is a copy of a field of `s`; to change the field in place, test it with `!s as .one(a: r)`", errors: 5
  obj Res
    n: Int

  enum Box
    one(a: Res, b: Int)
    empty

  fun f(s: Box, n: Int) -> Int
    if n as .one(a, b)
      return 1
    if s as .two(x)
      return 2
    if s as .one(x)
      return 3
    v = s as .empty
    0

  sub g()
    s: Box = .one(a: Res(n: 1), b: 2)
    if s as .one(a: r)
      r.n = 5

