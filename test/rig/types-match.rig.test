  enum Shape
    circle(r: Int)
    point

  fun radius(m: Shape?) -> Int
    if m as .circle(r)
      r
    else
      0

fail "match as a pattern with alternatives", "after `as`, a pattern tests one variant; to test several, write a `match`"
  enum S
    a(n: Int)
    b

  s: S = .b
  if s as .a(n), .b
    print(1)

fail "match as a pattern with a guard", "a pattern after `as` takes no `if` guard: join the condition with `and`, `if s as .circle(r) and r > 10`"
  enum S
    a(n: Int)
    b

  s: S = .b
  if s as .a(n) if n > 0
    print(1)

fail "match as a pattern in a loop step", "the loop step cannot use `n`, a field the pattern binds, which lives only in the body; use it at the end of the body instead", errors: 1
  enum S
    a(n: Int)
    b

  fun f(i: Int) -> S
    .b

  i = 0
  while f(i) as .a(n) : i += n
    print(n)
