test "audit-fuzz-pf2-accepted-918ae2f755", '''
  true
  false
  false
  true
  true
  true
'''
  # An optional error compares with an error, a contextual `.name`,
  # `none`, and another optional error.

  error E
    bad
    worse

  e: E? = E.bad
  n: E? = none
  print(e == E.bad)
  print(e == .worse)
  print(e == n)
  print(n == none)
  print(e != none)
  print(n != E.bad)

fail "audit-fuzz-pf2-accepted-92f228c2c3", "`a` is bound but never read; name it `_` to ignore the value"
  # Yielding a Copy payload field from a match arm does not consume the
  # scrutinee; it is still dropped.

  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum S
    one(a: *B, k: Int)
    empty

  fun go(s: S) -> Int
    match s
      .one(a, k) => k
      .empty => 0

  sub main()
    s: S = .one(a: *B(n: 1), k: 3)
    print(go(<s))

   # expect:
  # drop 1
  # 3

