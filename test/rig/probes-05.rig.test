    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  fun find(v: ?List[*Tok], k: Int) -> *Tok?
    for t in ?v
      break +t if t.n == k
    else
      none

  v: List[*Tok] = List()
  !v.push(*Tok(n: 1))
  !v.push(*Tok(n: 2))
  if find(?v, 2) as t
    print("found", t.n)
  print(find(?v, 3) == none)

