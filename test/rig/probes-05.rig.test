test "audit-fuzz-pf2-accepted-f977b401b0", '''
  5 [none]
  2 [1, none]
  Node(v: 1, next: none) Node(v: 2, next: none)
  4 W(x: none)
'''
  # Taking out of an element (`<v[i]`, `<arr[i]`), out of a boxed value,
  # in a generic type's `T?` field, and in a drop body, which releases a
  # long list one node at a time.

  sub elements()
    v: List[Int?] = List()
    !v.push(5)
    a = <v[0]
    print(a, v)
    arr: [2]Int? = [1, 2]
    b = <arr[1]
    print(b, arr)

  obj Node
    v: Int
    next: ^Node?

    drop(!self)
      cur = <self.next
      while <cur as n
        cur = <n.next

  obj W[T]
    x: T?

    fun grab(!self) -> T?
      <self.x

  elements()
  head: ^Node? = none
  i = 0
  while i < 100000 : i += 1
    head = ^Node(v: i, next: <head)
  b = ^Node(v: 1, next: ^Node(v: 2, next: none))
  rest = <b.next
  print(b, rest)
  w = W[Int](x: 4)
  head: ^Node? = none
  print((!w).grab(), w)

    # 4 W(x: none)

test "audit-fuzz-pf2-accepted-f9f37a33c7", '''
  6
  6
  0
'''
  # Moving a write view into a local moves the view, whatever it
  # points to: `w = <a` of an `a: !Int` binds a `!Int`, and writing `w`
  # writes the caller's value, as it does for a struct.

  obj C
    n: Int

  sub set(a: !Int)
    w = <a
    w = 5
    w += 1
    print(w)

  sub setc(a: !C)
    w = <a
    w = C(n: 5)
    print(w.n)

  z = 0
  set(!z)
  print(z)
  c = C(n: 0)
  print(c.n)

bomb "audit-fuzz-pf2-accepted-fc50cbcf57", "index out of bounds"
  K1 = 2

  fun sc1(n: Int, by: Int = K1, off: Int = (-1), _: Bool = false) -> Int
    n * by + off

  obj Acct2
    owner: ?String
    balance: Int = 12
    frozen: Bool = false

    fun open(name: ?String) -> Self
      Acct2(owner: name)

    fun can_pay(?self, amount: Int) -> Bool
      not self.frozen and self.balance >= amount

    sub pay(!self, amount: Int)
      self.balance -= amount

    sub freeze(!self)
      self.frozen = true

    fun close(<self) -> Int
      self.balance

  obj Pt2
    x: Int
    y: Int = 0

    fun plus(?self, o: ?Pt2) -> Pt2
      Pt2(x: self.x + o.x, y: self.y + o.y)

  sub main()
    v0: List[?String] = List()
    !v0.push("a")
    v0[1] = "a"
    print((!v0).pop())
    print((!v0).pop())
    !v0.push("bb")

