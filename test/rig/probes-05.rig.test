    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  t = *Tok(n: 1)
  $outer: for i in 0..3
    for j in 0..3
      if j == 1
        eat(<t)
        t = *Tok(n: i + 10)
        continue $outer
  print("end", t.n)

