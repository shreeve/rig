fail "match binding after decl", "`Thing` has the same name as the module-level declaration `Thing`", "declared here", errors: 1
  # A match binding may not share a module-level name, whichever comes first
  # (here the declaration comes after).

  enum Sh
    circle(r: Int)
    point

  fun site(s: Sh) -> Int
    match s
      .circle(Thing) => return Thing
      .point => return 0

  obj Thing
