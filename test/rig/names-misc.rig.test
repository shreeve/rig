# names: the rest of its tests.

fail "closure param after decl", "parameter `Thing` has the same name as the module-level declaration `Thing`", "declared here", errors: 1
  # A closure param may not share a module-level name, whichever comes first
  # (here the declaration comes after).

  fun site() -> Int
    f = |Thing: Int| Thing
    f(1)

  obj Thing
    v: Int

  print(1)

fail "closure param before decl", "parameter `Thing` has the same name as the module-level declaration `Thing`", "declared here", errors: 1
  # A closure param may not share a module-level name, whichever comes first
  # (here the declaration comes before).

  obj Thing
    v: Int

  fun site() -> Int
    f = |Thing: Int| Thing
    f(1)

  print(1)

fail "errors in source order", "1:7: parameter `Thing` has the same name as the module-level declaration `Thing`", "7:5: duplicate declaration of `dup`", "17:7: parameter `Thing` has the same name as the module-level declaration `Thing`", "17:19: parameter `Other` has the same name as the module-level declaration `Other`", errors: 4
  fun a(Thing: Int) -> Int
    Thing

  fun dup() -> Int
    1

  fun dup() -> Int
    2

  fun b() -> Int
    Other = 1
    Other

  Thing = 4
  Other = 5

  fun c(Thing: Int, Other: Int) -> Int
