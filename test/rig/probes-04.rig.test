fail "audit-fuzz-pf1-accepted-ef0d28d8d2", "cannot move out of `pair.name`: it copies, so `<` would leave it as it was; remove the `<` to copy it"
  # Only `?`, `!`, and `<` reach a method's receiver. The other prefix
  # sigils, and `?` / `!` / `<` before a place with no method call after

  # it, apply to the whole expression; `?(p.m())` views a call's result.

  obj Point
    x: Int
    fun origin() -> Point
      Point(x: 0)
    fun shifted(?self, d: Int) -> Point
      Point(x: self.x + d)

  obj Leaf
    n: Int

  obj Tree
    leaf: *Leaf
    fun first(?self) -> ?*Leaf
      ?self.leaf

  obj Pair
    v: List[Int]
    name: ?String

  sub fill(v: !List[Int])
    !v.push(1)

  sub show(p: ?Point)
    print(p.x)

  shared = *Point.origin()
  print(shared.x)
  tree = Tree(leaf: *Leaf(n: 3))
  copy = +tree.first()
  weak = ~copy
  print(copy.n, *weak != none)
  p = Point(x: 4)
  print(-p.x, -p.shifted(1).x)
  show(?(p.shifted(2)))
  pair = Pair(v: List(), name: "pair")
  fill(!pair.v)
  print(pair.v.len)
  name = <pair.name
  print(name)
  xs = [1, 2, 3]
  first = ?xs[0]
  q = <p
  print(first, q.x)

  # oracle: main reject C3

