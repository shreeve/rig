test "audit-fuzz-pf1-accepted-49de5b5de7", '''
  drop 2
  dropped b early
  end of run
  drop 1
  end of run
  drop 2
  drop 1
'''
  obj Noisy
    id: Int

    drop(!self)
      print("drop", self.id)

  sub run(early: Bool)
    a = Noisy(id: 1)
    b = Noisy(id: 2)
    if early
      <b
      print("dropped b early")
    print("end of run")

  run(true)
  run(false)

test "audit-fuzz-pf1-accepted-718565b254", '''
  80
  [7, 3, 30, 40]
'''
  fun total(xs: []Int) -> Int
    n = 0
    for x in xs
      n += x
    n

  sub scale(s: ![]Int, k: Int)
    for x in !s

      x *= k

  fun rest(s: ![]Int) -> ![]Int
    !s[1..]

  a = [1, 2, 3, 4]
  scale(!a[2..], 10)
  w = !a[..]
  w[0] = 7
  r = rest(!w[..])
  r[0] += 1
  print(total(w))
  print(a)

