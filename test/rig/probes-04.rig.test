      look(?w19)
    r21 = mk(150)
    c21 = |x: ?R| 1
    print("int", c21(?r21))
    look(?r21)
    a23: P? = P(a: mk(160), b: mk(161))
    b23: P? = none
    r23 = first_some(<a23, <b23)
    if ?r23 as w24
      look(?w24.a)
      look(?w24.b)
    r26 = ident(ident(optr(170)))
    if ?r26 as y27
      print("use", y27.id)

  sub h2()!
    o28: *R? = none
    r28 = chain(<o28)
    if ?r28 as w29
      print("use", w29.id)
    a31 = HR.one(r: mk(180))
    b31 = HR.one(r: mk(190))
    swap_gen(!a31, !b31)
    match ?a31
      .one(z32) => look(?z32)
      .empty => print("empty")
    match ?b31
      .one(z33) => look(?z33)
      .empty => print("empty")

  h0()
  h1()
  h2() catch |e| print("caught", e)

