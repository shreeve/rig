test "audit-fuzz-c-gen-g00000", '''
  new 10
  use 10
  new 20
  new 21
  use 20
  use 21
  int 30
  new 40
  new 50
  use 50
  use 40
  new 60
  new 70
  rel 70
  use 60
  rel 60
  rel 40
  rel 50
  rel 21
  rel 20
  rel 10
  new 80
  new 90
  rel 90
  use 80
  new 100
  use 100
  str s110
  str s120
  rel 100
  rel 80
  int 130
  new 150
  use 150
  rel 150
'''
  obj R
    id: Int

    drop(!self)
      print("rel", self.id)

  obj P
    a: R
    b: R

  enum HR
    one(r: R)
    empty

  error E
    bad

  fun mk(id: Int) -> R
    print("new", id)
    R(id: id)

  fun optr(id: Int) -> R?
    return none if id % 3 == 0
    mk(id)

  sub look(r: ?R)
    print("use", r.id)

  fun rt_bool(b: Bool) -> Bool
    b

  fun rt_int(n: Int) -> Int
    n

  fun pick[T](a: T, b: T, first: Bool) -> T
    if first
      return <a
    <b

  fun keep_first[T](a: T, b: T) -> T
    a

  fun ident[T](x: T) -> T
    x

  fun cycle[T](x: T, n: Int) -> T
    cur = <x
    for _ in 0..n
      cur = ident(<cur)
    cur

  fun wrap[T](x: T) -> T?
    x

  fun unwrap_or[T](o: T?, d: T) -> T
    if <o as v
      return <v
    <d

  fun first_some[T](a: T?, b: T?) -> T?
    if <a as x
      return <x
    <b

  fun must[T](o: T?) -> T!
    if <o as x
      return <x
    return E.bad

  fun chain[T](o: T?) -> T?
    x = (<o)?
    x

  sub swap_gen[T](a: !T, b: !T) keeps a, b
    swap(!a, !b)

  fun first_ref[T, U](p: ?Pair[T, U]) -> ?T
    ?p.first

  obj Pair[T, U]
    first: T
    second: U

    fun left(?self) -> ?T
      ?self.first

  obj Shelf[T]
    items: List[T]

    sub add(!self, x: T)
      !self.items.push(<x)

    fun take(!self) -> T?
      (!self.items).pop()

  enum Maybe[T]
    just(v: T)
    nada

  fun get_or[T](m: Maybe[T], d: T) -> T
    match <m
      .just(v) => v
      .nada => d

  fun fill_shelf[T](a: T, b: T) -> Shelf[T]
    s = Shelf[T](items: List())
    !s.add(<a)
    !s.add(<b)
    s

  sub h0()
    o1: R? = none
    r1 = unwrap_or(<o1, mk(10))
    look(?r1)
    r3 = ident(ident(P(a: mk(20), b: mk(21))))
    look(?r3.a)
    look(?r3.b)
    o5: Int? = 30
    r5 = chain(<o5)
    if ?r5 as w6
      print("int", w6)
    a8 = optr(40)
    b8 = optr(50)
    swap_gen(!a8, !b8)
    if ?a8 as y9
      print("use", y9.id)
    if ?b8 as y10
      print("use", y10.id)
    o11: ^R? = ^mk(60)
    r11 = unwrap_or(<o11, ^mk(70))
    print("use", r11.id)

  sub h1()!
    o13: ^R? = ^mk(80)
    r13 = unwrap_or(<o13, ^mk(90))
    print("use", r13.id)
    r15 = ident(ident(*mk(100)))
    print("use", r15.id)
    o17: (?String)? = "s110"
    r17 = chain(<o17)
    if ?r17 as w18
      print("str", w18)
    o20: (?String)? = "s120"
    r20 = must(<o20)!
    print("str", r20)

  sub h2()
    o22: P? = none
    r22 = chain(<o22)
    if ?r22 as w23
      look(?w23.a)
      look(?w23.b)
    r25 = pick(130, 140, rt_bool(true))
    print("int", r25)
    m27: Maybe[*R] = .nada
    r27 = get_or(<m27, *mk(150))
    print("use", r27.id)

  h0()
  h1() catch |e| print("caught", e)
  h2()

