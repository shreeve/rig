  str s10
  new 20
  use 20
  new 30
  new 31
  new 40
  new 41
  rel 41
  rel 40
  use 30
  use 31
  new 50
  use 50
  new 60
  use 60
  rel 60
  rel 50
  rel 31
  rel 30
  rel 20
  new 70
  new 80
  rel 80
  use 70
  new 90
  use 90
  rel 90
  rel 70
'''
  obj R
    id: Int

    drop(!self)
      print("rel", self.id)

  obj P
    a: R
    b: R

  enum HR
    one(r: R)
    empty

  error E
    bad

  fun mk(id: Int) -> R
    print("new", id)
    R(id: id)

  fun optr(id: Int) -> R?
    return none if id % 3 == 0
    mk(id)

  sub look(r: ?R)
    print("use", r.id)

  fun rt_bool(b: Bool) -> Bool
    b

  fun rt_int(n: Int) -> Int
    n

  fun pick[T](a: T, b: T, first: Bool) -> T
    if first
      return <a
    <b

  fun keep_first[T](a: T, b: T) -> T
    a

  fun ident[T](x: T) -> T
    x

  fun cycle[T](x: T, n: Int) -> T
    cur = <x
    for _ in 0..n
      cur = ident(<cur)
    cur

  fun wrap[T](x: T) -> T?
    x

  fun unwrap_or[T](o: T?, d: T) -> T
    if <o as v
      return <v
    <d

  fun first_some[T](a: T?, b: T?) -> T?
    if <a as x
      return <x
    <b

  fun must[T](o: T?) -> T!
    if <o as x
      return <x
    return E.bad

  fun chain[T](o: T?) -> T?
    x = (<o)?
    x

  sub swap_gen[T](a: !T, b: !T) keeps a, b
    swap(!a, !b)

  fun first_ref[T, U](p: ?Pair[T, U]) -> ?T
    ?p.first

  obj Pair[T, U]
    first: T
    second: U

    fun left(?self) -> ?T
      ?self.first

  obj Shelf[T]
    items: List[T]

    sub add(!self, x: T)
      !self.items.push(<x)

    fun take(!self) -> T?
      (!self.items).pop()

  enum Maybe[T]
    just(v: T)
    nada

  fun get_or[T](m: Maybe[T], d: T) -> T
    match <m
      .just(v) => v
      .nada => d

  fun fill_shelf[T](a: T, b: T) -> Shelf[T]
    s = Shelf[T](items: List())
    !s.add(<a)
    !s.add(<b)
    s

  sub h0()
    m1: Maybe[?String] = .nada
    r1 = get_or(<m1, "s10")
    print("str", r1)
    r3 = cycle(^mk(20), rt_int(1))
    print("use", r3.id)
    m5: Maybe[P] = .just(P(a: mk(30), b: mk(31)))
    r5 = get_or(<m5, P(a: mk(40), b: mk(41)))
    look(?r5.a)
    look(?r5.b)
    r7 = cycle(^mk(50), rt_int(0))
    print("use", r7.id)
    r9 = wrap(mk(60))
    if ?r9 as w10
      look(?w10)

  sub h1()!
    r12 = keep_first(^mk(70), ^mk(80))
    print("use", r12.id)
    o14: R? = mk(90)
    r14 = chain(<o14)
    if ?r14 as w15
      look(?w15)

  h0()
  h1() catch |e| print("caught", e)

