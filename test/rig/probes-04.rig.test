test "audit-fuzz-pf2-accepted-0bb6dd2b9b", '''
  true
  false
  true false
  1
  long form
  4
'''
  # A call that lends its receiver to write whose value is a `Bool` takes the short form
  # `!s.add(x)` wherever its `!` cannot read as negation: a binding, an
  # argument, a return value, a body's value.

  obj Set
    items: List[Int]
    fun insert(!self, k: Int) -> Bool
      for x in ?self.items
        return false if x == k
      !self.items.push(k)
      true
    fun checked(!self, k: Int) -> Bool!
      (!self).insert(k)

  fun add(s: !Set, k: Int) -> Bool
    return (!s).insert(k)

  fun again(s: !Set, k: Int) -> Bool
    (!s).insert(k)

  fun fill(s: !Set) -> Int!
    added = (!s).checked(3)!
    1 if added else 0

  # 1
  set = Set(items: List())
  fresh = (!set).insert(1)
  print(fresh)
  print((!set).insert(1))
  print(add(!set, 2), again(!set, 2))
  print(fill(!set) catch 0)
  if (!set).insert(4) and not (!set).insert(4)
    print("long form")
  print(set.items.len)


  # long form
  # 4

