  obj P
    a: R
    b: R

  enum HR
    one(r: R)
    empty

  error E
    bad

  fun mk(id: Int) -> R
    print("new", id)
    R(id: id)

  fun optr(id: Int) -> R?
    return none if id % 3 == 0
    mk(id)

  sub look(r: ?R)
    print("use", r.id)

  fun rt_bool(b: Bool) -> Bool
    b

  fun rt_int(n: Int) -> Int
    n

  fun pick[T](a: T, b: T, first: Bool) -> T
    if first
      return <a
    <b

  fun keep_first[T](a: T, b: T) -> T
    a

  fun ident[T](x: T) -> T
    x

  fun cycle[T](x: T, n: Int) -> T
    cur = <x
    for _ in 0..n
      cur = ident(<cur)
    cur

  fun wrap[T](x: T) -> T?
    x

  fun unwrap_or[T](o: T?, d: T) -> T
    if <o as v
      return <v
    <d

  fun first_some[T](a: T?, b: T?) -> T?
    if <a as x
      return <x
    <b

  fun must[T](o: T?) -> T!
    if <o as x
      return <x
    return E.bad

  fun chain[T](o: T?) -> T?
    x = (<o)?
    x

