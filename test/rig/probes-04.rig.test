test "audit-fuzz-pf2-accepted-142f3b6e69", '''
  1
  2
  end
  2
'''
  # Assigning a field through `!self` drops the old value and keeps the new
  # one in the caller's struct.

  obj Noisy
    id: Int

    drop(!self)
      print(self.id)

  obj Slot
    held: *Noisy

    sub put(!self, n: *Noisy)
      self.held = +n

  s = Slot(held: *Noisy(id: 1))
  !s.put(*Noisy(id: 2))
  print(s.held.id)
  print("end")

test "audit-fuzz-pf2-accepted-1fda7c156c", '''
  [10, 20, 30]
  after
  saw 0
  drop 0
  kept 1
  drop 1
  saw 2
  drop 2
  after
'''
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  sub keep(b: *B)
    print("kept", b.n)

  xs = [1, 2, 3]
  for x in !xs
    x *= 10
  print(xs)
  v: List[*B] = List()

  print("after")
  for i in 0..3
    !v.push(*B(n: i))
  for b, i in <v
    if i == 1
      keep(<b)
      continue
    print("saw", b.n)
  print("after")

