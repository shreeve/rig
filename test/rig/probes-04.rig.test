    q1 = Q(h: *mk(18), o: none)
    print("val", hand(*mk(19), qq(Q(h: *mk(20), o: mayr(rt_int(3021))!))))
    v3: List[*R] = List()
    !v3.push(*mk(22))
    !v3.push(*mk(23))

  sub h2()!
