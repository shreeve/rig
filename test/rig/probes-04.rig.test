# Probes from past reviews and audits, 4 of 41: audit-emit-q2 to audit-fuzz-pf2-accepted-6bc0b88552.

fail "audit-emit-q2", "`peek[^R]` cannot use `T = ^R`: the generic body copies a `T`, which would duplicate the resource `^R` owns"
  obj R
    n: Int
    drop(!self)
      print("drop R", self.n)

  fun peek[T](o: T?) -> Int
    if o as v
      print("some")
      return 1
    0

  obj Holder[T]
    o: T?

    fun has(?self) -> Bool
      if self.o as v
        return true
      false

  print(peek(^R(n: 1)))
  h = Holder(o: ^R(n: 2))
  print(h.has())

test "audit-emit-tt", "m"
  error E
    bad

  fun f(k: Int) -> Int!
    return E.bad if k > 0
    k

  test "ok"
    print(f(0)!)

  test "fails"
    print(f(1)!)

  test "leaks \"quoted\""
    v: List[Int] = List()
    !v.push(1)

  test "last"
    xs = [1]
    i = 3
    i += 0
    print(xs[i])

  sub main()
    print("m")

