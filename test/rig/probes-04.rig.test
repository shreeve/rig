    print("use", b.id)
    n

  fun hand(h: *R, n: Int) -> Int
    print("use", h.id)
    n

  fun bx(b: ^R, n: Int) -> Int
    print("use", b.id)
    n

  fun pp(p: P) -> Int
    print("use", p.a.id)
    print("use", p.b.id)
    1

  fun qq(q: Q) -> Int
    print("use", q.h.id)
    2

  fun hr(e: HR) -> Int
    match <e
      .one(r) => r.look()
      .two(a, b)
        print("use", b.id)
        a.look()
      .empty => 0

  fun ints(xs: [2]Int) -> Int
    xs[0] + xs[1]

  fun rt_int(n: Int) -> Int
    n

  fun h0() -> Int?
    print("val", hr(HR.two(a: mk(1), b: *mk(2))))
    m1 = M(r: mk(3))
    !m1.put(optr(rt_int(4004))?)
