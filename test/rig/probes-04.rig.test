      print("use", self.r.id)
      n + self.r.id

    fun peek(?self, n: Int) -> Int
      print("use", self.r.id)
      n

    sub put(!self, r: R)
      self.r = <r

  error E
    bad

  fun mk(id: Int) -> R
    print("new", id)
    R(id: id)

  fun mkm(id: Int) -> M
    M(r: mk(id))

  fun mayr(k: Int) -> R!
    return E.bad if k == 0
    mk(k)

