'''
  fun index_of(xs: ?[4]Int, target: Int) -> Int
    for x, i in xs
      break i if x == target
    else
      -1

  xs = [3, 1, 4, 1]
  print(index_of(?xs, 4), index_of(?xs, 9))
  n = 27
  steps = 0
  last = while true
    break steps if n == 1
    n = n / 2 if n % 2 == 0 else 3 * n + 1
    steps = 1
  print(last)

