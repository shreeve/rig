# ownership: the rest of its tests, part 2.

use std.text

test "take places", '''
  5 [none]
  2 [1, none]
  Node(v: 1, next: none) Node(v: 2, next: none)
  4 W(x: none)
'''
  # Taking out of an element (`<v[i]`, `<arr[i]`), out of a boxed value,
  # in a generic type's `T?` field, and in a drop body, which releases a
  # long list one node at a time.

  sub elements()
    v: List[Int?] = List()
    !v.push(5)
    a = <v[0]
    print(a, v)
    arr: [2]Int? = [1, 2]
    b = <arr[1]
    print(b, arr)

  obj Node
    v: Int
    next: ^Node?

    drop(!@)
      cur = <@next
      while <cur as n
        cur = <n.next

  obj W[T]
    x: T?

    fun grab(!@) -> T?
      <@x

  elements()
  head: ^Node? = none
  i = 0
  while i < 100000 : i += 1
    head = ^Node(v: i, next: <head)
  b = ^Node(v: 1, next: ^Node(v: 2, next: none))
  rest = <b.next
  print(b, rest)
  w = W[Int](x: 4)
  print((!w).grab(), w)

test "take places more", '''
  1 S(a: none) 1 T(s: S(a: none)) 2 S(a: none) 3 S(a: none)
  S(a: 5)
  S(a: 6)
  6 [S(a: 5), S(a: none)]
  3 H(a: none)
  none
  got 4
  4
'''
  # A take writes its owner, so a plain-data local, a field of a field,
  # and an array element are emptied in place; `(<s.a)?` takes, then
  # returns `none` when there was nothing; `if <slot as t` moves a held
  # write view of an optional into the binding.

  obj S
    a: Int?

  obj T
    s: S

  fun mk() -> S
    S(a: 1)

  sub places()
    s = mk()
    t = <s.a
    u = T(s: mk())
    w = <u.s.a
    x: S = S(a: 2)
    y = <x.a
    z = S(a: 3)
    q = <z.a
    print(t, s, w, u, y, x, q, z)
    a: [2]S = [S(a: 5), S(a: 6)]
    for e in a
      print(e)
    b = <a[1].a
    print(b, a)

  obj N
    v: Int

  obj H
    a: ^N?

  fun first(h: !H) -> Int?
    b = (<h.a)?
    b.v

  sub peek(slot: !Int?)
    if <slot as t
      print("got", t)

  places()
  h = H(a: ^N(v: 3))
  n = first(!h)
  print(n, h)
  print(first(!h))
  x: Int? = 4
  peek(!x)
  print(x)

fail "take rejections", "13:8: cannot take through a read view (`?T`)", "17:5: cannot take through a shared handle (`*T`)"
  # Taking an optional out of a field writes the field: not through a read
  # view or a shared handle.

  obj N
    v: Int
    next: ^N?

  obj S
    top: ^N?
    n: N

  sub rd(s: ?S)
    x = <s.top
    print(x)

  h = *S(top: none, n: N(v: 1, next: none))
  z = <h.top
  s = S(top: none, n: N(v: 1, next: none))
  print(z)
  rd(?s)

fail "take rejections ownership", "16:10: cannot lend `s.top` to write while a read loan is live", "20:21: cannot lend `s.top` to write while a write loan is live", "24:7: cannot move out of `s.n`: `s` would still drop it (partial moves are not supported); move `s` whole, or exchange the field: `old = swap(!s.n, v)`", "27:7: use of `msg` after move"
  # Taking an optional out of a field writes the field: not while another
  # view of the value is live, and not twice in one call. A field that
  # is not optional still cannot be moved out; it is exchanged with
  # `replace`. A local is moved as a whole, and cannot be used after.

  obj N
    v: Int
    next: ^N?

  obj S
    top: ^N?
    n: N

  sub both(s: !S)
    if ?s.top as t
      y = <s.top
      print(t.v)

  sub twice(s: !S)
    a = swap(!s.top, <s.top)
    print(a)

  s = S(top: none, n: N(v: 1, next: none))
  nm = <s.n
  msg: (?String)? = "hi"
  m = <msg
  print(msg, m, nm)
  both(!s)
  twice(!s)

test "take then exit", '''
  drop 1
  0
  S(a: none, b: R(n: 2))
  drop 2
  none
  S(a: none, b: none)
  drop 3
  none
'''
  # A taken field is `none` at once, so an early exit (`!`, `?`, `break`)
  # after the take drops only what was taken, and the place is left empty.

  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  obj S
    a: R?
    b: R?

  error Bad
    no

  fun f(s: !S, fail: Bool) -> Int!
    x = <s.a
    return Bad.no if fail
    s.a = <x
    1

  fun g(s: !S) -> Int?
    y = <s.b
    z: Int? = none
    n = z?
    n

  s = S(a: R(n: 1), b: R(n: 2))
  print(f(!s, true) catch 0)
  print(s)
  print(g(!s))
  print(s)
  i = 0
  s.a = R(n: 3)
  while true
    t = <s.a
    i += 1
    break if i > 1
  print(s.a)

test "take through branch of write views", '''
  [1] none [2]
  [2] [1] none
  [2] [1] none
'''
  # A branching value whose every leaf is a write view is a write view of
  # the leaf it took: `<` through it takes the optional field out of the
  # place that leaf views, and leaves `none` there. The other place is
  # untouched.
  # oracle: lends accept
  # oracle: bindings accept

  obj S
    o: List[Int]?

  fun mkv(n: Int) -> List[Int]
    xs: List[Int] = List()
    !xs.push(n)
    xs

  sub lends(c: Bool)
    s = S(o: mkv(1))
    t = S(o: mkv(2))
    x = <(!s if c else !t).o
    print(x, s.o, t.o)

  sub bindings(c: Bool)
    s = S(o: mkv(1))
    t = S(o: mkv(2))
    r1 = !s
    r2 = !t
    x = <(r1 if c else r2).o
    print(x, r1.o, r2.o)

  lends(true)
  lends(false)
  bindings(false)

test "take through lend", "2 [1] none"
  # `<` through a write view takes an optional field or element, leaving
  # `none`, since the take writes the place it reaches; a plain field is
  # read with no `<` (`test/reject/ownership/move_through_lend.rig` and
  # `move_part_that_copies.rig` have the moves rejected).

  obj S
    n: Int
    o: List[Int]?

  fun take(p: !S) -> List[Int]?
    <p.o

  v: List[Int] = List()
  !v.push(1)
  s = S(n: 2, o: <v)
  n = s.n
  t = take(!s)
  print(n, t, s.o)

fail "take through view of temporary", "9:6: a write view is never stored inside a value, and `!B` cannot stand here", errors: 1
  # A temporary cannot hold a write view on the way to storage that
  # outlives it (`mk(!b).r.o`): a write view is never stored inside a
  # value, so the field is rejected where it is declared.

  obj B
    o: Int?

  obj H
    r: !B

  b = B(o: 3)
  print(b.o ?? 0)

test "taken cell holder lends", release: true, '''
  touch 1
  touch 2
  touch 6
  touch 7
  touch 4
  4
  touch 1
  1
'''
  # A loop or match binding of a handle to a Cell holder is never a copy
  # (Core §1): a taken one is the construct's own, a viewed one a view of
  # the place, and either may be lent, written or bare, and captured.

  obj Counter
    hits: Cell[Int]

    sub hit(!@)
      !@hits.set(@hits.get() + 1)

  enum E
    a(c: *Counter)
    b

  fun two() -> [2]*Counter
    [*Counter(hits: Cell(0)), *Counter(hits: Cell(5))]

  fun mk() -> E
    E.a(c: *Counter(hits: Cell(3)))

  sub touch(c: !Counter)
    !c.hit()
    print("touch", c.hits.get())

  for k in two()
    touch(!k)
    touch(!k)
  match mk()
    .a(c)
      touch(!c)
      f = |?c| c.hits.get()
      print(f())
    .b => pass
  arr = [*Counter(hits: Cell(0))]
  for k in arr
    touch(!(+k))
    g = |?k| k.hits.get()
    print(g())

test "temporaries drop order", '''
  2
  drop R of 2
  drop N 2
  drop R of 1
  drop N 1
  -1
  drop B pass0
  body 0
  drop B pass1
  body 1
  drop B pass2
  body 2
  drop B pass3
  body 3
  drop B pass4
  body 4
  drop B pass5
  body 5
  drop B pass6
  body 6
  drop B pass7
  body 7
  drop B pass8
  body 8
  drop B pass9
  body 9
  drop B pass10
  10
'''
  # The temporaries of a statement are dropped last made first, on every
  # path: after the statement, and when it fails. A loop's condition is a
  # header, its own statement: its temporaries are dropped before each
  # pass's body runs. A value whose `drop` body reads a temporary it
  # views is dropped before that temporary.

  obj N
    id: Int
    v: List[Int]

    drop(!@)
      print("drop N", @id)
      @id = -99

  obj R
    n: ?N

    drop(!@)
      print("drop R of", @n.id)

  obj B
    s: ?String
    v: List[Int]

    drop(!@)
      print("drop B", @s)

  error Bad
    no

  fun f() -> Int!
    return Bad.no

  fun run() -> Int!
    print(R(n: ?N(id: 1, v: List())).n.id, f()!)
    0

  fun mkb(s: ?String) -> B
    B(s: s, v: List())

  print(R(n: ?N(id: 2, v: List())).n.id)
  print(run() catch -1)
  i = 0
  while mkb(?String("pass", i)).s.len < 6
    print("body", i)
    i += 1
  print(i)

fail "temporaries not kept", "19:9: a view of the temporary `String(\"abc\")` outlives its statement", "20:6: a view of the temporary `String(\"x\")` outlives its statement", "21:11: a view of the temporary `String(\"abc\")` outlives its statement", "22:6: a view of the temporary `String(\"r\")` outlives its statement", "25:17: `t` does not live long enough", errors: 5
  # An owning temporary lives until its statement ends, so nothing may
  # keep a view of it: not a binding, a field, a call's String result,
  # or a slice. A `match` takes a call's result: a view of a payload it
  # binds ends with the arm.

  enum M
    a(t: String)
    b

  obj E
    s: ?String

  fun mk() -> M
    M.a(t: String("in m"))

  fun id(s: ?String) -> ?String
    s

  w = id(?String("abc"))
  s = ?String("x")[0..1]
  e = E(s: ?String("abc"))
  r = ?String("r")
  o: ?String = "x"
  match mk()
    .a(t) => o = ?t[..]
    .b => print("b")
  print(w, s, e, r, o)

test "temporaries read then dropped", '''
  parsed 3
  2 2
  true false
  got in m
  Noisy(id: 1) x
  drop 1
  after
  3
  7
  drop 9
  Noisy(id: 9) 2
  drop 9
  -1 1
  [] Cell(value: 5) boxed
'''
  # An owning temporary that is only read (a `print` or `String` argument,
  # a view lent to a call that keeps none, an `==` operand) is dropped
  # when its statement ends, also when the statement fails or leaves
  # early; one in a loop's condition, a header, when the condition ends.
  # A `match` takes a call's result and drops what its arms leave.

  obj Noisy
    id: Int

    drop(!@)
      print("drop", @id)

  enum M
    a(t: String)
    b

  error Bad
    no

  fun mk() -> M
    M.a(t: String("in m"))

  fun len(s: ?String) -> Int
    s.len

  fun tlen(t: ?String) -> Int
    t.len

  fun fails(x: Int) -> Int!
    if x > 0
      return Bad.no
    x

  fun run(x: Int) -> Int!
    print(String("before ", x), fails(x)!)
    0

  fun early(o: Int?) -> Int
    print(Noisy(id: 9), o ?? return -1)
    1

  n = 3
  print(String("parsed ", n))
  print(len(?String("a", n)), tlen(?String("bc")))
  s = "a"
  print(String("a") == s, s == String("b"))
  match mk()
    .a(t) => print("got", t)
    .b => print("b")
  print(Noisy(id: 1), "x")
  print("after")
  i = 0
  while String(i) != "3"
    i += 1
  print(i)
  print(run(1) catch 7)
  print(early(none), early(2))
  print(List[Int](), *Cell(5), ^String("boxed"))

test "temporary field read", '''
  3 5
  drop user
  drop user
  1
  1
  2
  3
  end
'''
  # A field that owns nothing is read from an owning temporary where it
  # stands; the statement drops the temporary. A `for` over a call's
  # result, and `as` over one, take its value.

  obj User
    age: Int
    name: String

    drop(!@)
      print("drop user")

  fun mv() -> List[Int]
    v: List[Int] = List()
    !v.push(1)
    !v.push(2)
    v

  fun mo() -> String?
    String("opt")

  print(String("bye").len, (*User(age: 5, name: String("u"))).age)
  x = User(age: 1, name: String("n")).age
  print(x)
  for n in mv()
    print(n)
  if mo() as t
    print(t.len)
  print("end")

test "temporary match takes payload", '''
  took 1
  drop 1
  took 1
  drop 1
  read 1
  drop 1
  end
'''
  # A `match` takes a call's result, as `match <e` does: an arm may move a
  # payload out, and what it leaves is dropped with the arm.

  obj N
    id: Int

    drop(!@)
      print("drop", @id)

  enum M
    a(n: N)
    b

  fun mk() -> M
    M.a(n: N(id: 1))

  sub take(n: N)
    print("took", n.id)

  match mk()
    .a(n) => take(<n)
    .b => print("b")
  match <mk()
    .a(n) => take(<n)
    .b => print("b")
  match mk()
    .a(n) => print("read", n.id)
    .b => print("b")
  print("end")

fail "temporary match view escapes", "14:17: `t` does not live long enough", errors: 1
  # A `match` takes a call's result, as `match <e` would: a payload an
  # arm binds is dropped when the arm ends, so a view of it cannot
  # outlive the arm.

  enum M
    a(t: String)
    b

  fun mk() -> M
    M.a(t: String("in m"))

  o: ?String = "x"
  match mk()
    .a(t) => o = ?t[..]
    .b => print("b")
  print(o)

test "temporary part view in statement", '''
  tt t in 1
  1 7 bx tt
  tt In(t: "in") tx nm
'''
  # A view of a part of a temporary (a field, a nested field, an element,
  # a slice, a boxed or shared value, a branch value) may be used anywhere
  # in its statement.


  obj In
    t: String

  obj N
    t: String
    inner: In
    arr: [2]Int
    v: List[Int]
    name: ?String

  fun mk() -> N
    v: List[Int] = List()
    !v.push(7)
    N(t: String("tt"), inner: In(t: String("in")), arr: [1, 2], v: <v, name: "nm")

  fun mkbox() -> ^String
    ^String("bx")

  fun mksh() -> *N
    *mk()

  fun mkt() -> String
    String("tx")

  fun first(s: []Int) -> Int
    s[0]

  c = true
  print(text.trim(?mk().t), ?mk().t[1..], text.trim(?mk().inner.t), ?mk().arr[0])
  print(first(?mk().arr[..]), first(?mk().v[..]), text.trim(?mkbox()), text.trim(?mksh().t))
  print(text.trim(?(mk() if c else mk()).t), ?mk().inner, ?mkt()[..], mk().name)

fail "temporary part view kept", "34:17: a view of the temporary `mk()` outlives its statement", "35:7: a view of the temporary `mk()` outlives its statement", "36:17: a view of the temporary `mk()` outlives its statement", "37:7: a view of the temporary `mk()` outlives its statement", "38:7: a view of the temporary `mk()` outlives its statement", "39:7: a view of the temporary `mk()` outlives its statement", "40:17: a view of the temporary `mkbox()` outlives its statement", "41:17: a view of the temporary `mksh()` outlives its statement", "42:18: a view of the temporary `mk() if c else mk()` outlives its statement", "43:8: a view of the temporary `mk()` outlives its statement", errors: 10
  # A view of a part of a temporary (a field, a nested field, an element,
  # a slice, a boxed or shared value, a branch value) carries the loan on
  # the temporary, so it may be used in its statement but not kept past it.


  obj In
    t: String

  obj N
    t: String
    inner: In
    arr: [2]Int
    v: List[Int]
    name: ?String

  fun mk() -> N
    v: List[Int] = List()
    !v.push(7)
    N(t: String("tt"), inner: In(t: String("in")), arr: [1, 2], v: <v, name: "nm")

  fun mkbox() -> ^String
    ^String("bx")

  fun mksh() -> *N
    *mk()

  fun mkt() -> String
    String("tx")

  fun first(s: []Int) -> Int
    s[0]

  c = true
  s1 = text.trim(?mk().t)
  s2 = ?mk().t[1..]
  s3 = text.trim(?mk().inner.t)
  r4 = ?mk().arr[0]
  r5 = ?mk().arr[..]
  r6 = ?mk().v[..]
  s7 = text.trim(?mkbox())
  s8 = text.trim(?mksh().t)
  s9 = text.trim(?(mk() if c else mk()).t)
  r10 = ?mk().inner
  print(s1, s2, s3, r4, r5, r6, s7, s8, s9, r10)

test "temporary receiver read", '''
  1 5
  drop 5
  end
'''
  # A `?@` receiver only reads: a value made there, a cloned handle
  # included, is a temporary its statement drops.

  obj B
    n: Int

    fun get(?@) -> Int
      @n

    drop(!@)
      print("drop", @n)

  fun mk(n: Int) -> B
    B(n: n)

  c: *Cell[Int] = *Cell(1)
  print((+c).get(), mk(5).get())
  print("end")

test "temporary views in statement", '''
  true
  starts 1
  3 v cd
  5 [2, 3]
  k v
  0
  1
'''
  # A view of a temporary, or a view made from one, may be used anywhere
  # in its statement: the temporary lives until the statement ends. A
  # header is its own statement: the temporaries of an `if` or `while`
  # condition end with it, so a view the body uses is made from a Text
  # bound to a name first.


  obj S
    n: Int

  fun pick(s: ?S) -> ?Int
    ?s.n

  print(text.trim(?String("  padded  ")) == "padded")
  n = text.find(?String("abc"), "b") ?? -1
  a = "x"
  b = "yz"
  if text.starts_with(?String(a, b), "xy")
    print("starts", n)
  i = 0
  while text.find(?String(i), "3") == none
    i += 1
  print(i, text.trim(?String(" v ")), ?String("abcdef")[2..4])
  print(pick(?S(n: 4)) + 1, ?[1, 2, 3][1..])
  kv_text = String("k=v")
  if text.cut(?kv_text, "=") as kv
    print(kv.before, kv.after)
  j = 0
  while true
    pass_text = String("pass=", j)
    kw = text.cut(?pass_text, "=") ?? break
    print(kw.after)
    j += 1
    if j == 2
      break

fail "temporary views kept", "11:14: cannot return a view of `String(\" x \")`, which this function was not lent", "13:16: a view of the temporary `String(\" a \")` outlives its statement", "14:21: a view of the temporary `String(\" b \")` outlives its statement", "16:20: a view of the temporary `String(\" c \")` outlives its statement", "17:6: a view of the temporary `String(\"d\")` outlives its statement", "19:17: a view of the temporary `String(\"k=v\")` outlives its statement", errors: 6
  # A view of a temporary cannot outlive its statement, which drops the
  # temporary: not in a binding, a field, a List, or a result. A `while`
  # header's temporaries last one pass, since the next pass evaluates the
  # header again, so a view kept for a later pass is rejected.


  obj E
    s: ?String

  fun f() -> ?String
    text.trim(?String(" x "))

  s = text.trim(?String(" a "))
  e = E(s: text.trim(?String(" b ")))
  v: List[?String] = List()
  !v.push(text.trim(?String(" c ")))
  r = ?String("d")
  last: ?String = "none"
  while text.cut(?String("k=v"), "=") as kw
    print(last)
    last = kw.after
  print(s, e, v, r, f())

fail "text add while viewed", "6:1: cannot lend `t` to write while a read loan is live", errors: 1
  # A String taken from a Text views it: the Text cannot change while
  # the view is in use, since the change may move its bytes.

  t = String("abc")
  s = ?t[..]
  !t.add("d")
  print(s)

fail "text drop while viewed", "9:2: cannot drop `t` while it is lent", "13:1: cannot lend `u` to write while a read loan is live", "17:1: cannot reassign `w` while it is lent", errors: 3
  # A Text cannot be dropped, cleared, or reassigned while a String
  # views it, even through a function's result.

  fun first(s: ?String) -> ?String
    s[..1]

  t = String("abc")
  a = first(?t)
  <t
  print(a)
  u = String("xyz")
  b = ?u[..]
  !u.clear()
  print(b)
  w = String("w")
  c = ?w[..]
  w = String("v")
  print(c, w)

test "text handle slice", '''
  ello h
  he lo
  hello
'''
  # A Text reached through a handle is sliced in place: the
  # String views the Text the handle shares, and the handle stays lent
  # while it is used.

  obj W
    t: *String

  fun first(s: ?String) -> ?String
    s[0..1]

  h = *String("hello")
  s = ?h[1..]
  g = +h
  print(s, first(?g[..]))
  w = W(t: +h)
  u = ?w.t[..2]
  vs: List[*String] = List()
  !vs.push(+h)
  v = ?vs[0][3..]
  print(u, v)
  <h
  print(g)

fail "text handle slice keeps handle", "9:4: cannot return a view of `h`", "14:4: cannot drop `h` while it is lent", "20:3: cannot reassign `w` while `w.t` is lent", "28:6: cannot drop `g` while it is lent", errors: 4
  # A slice of a Text reached through a handle (`*String`) lends the
  # handle (Core §4: a `*T` lends the read views of its `T`): the handle may
  # not be dropped, moved, or replaced while the String is used.

  obj W
    t: *String

  fun peek(h: *String) -> ?String
    ?h[..]

  sub local()
    h = *String("hello")
    s = ?h[..]
