test "vec for clone elem", '''
  1
  drop 0
  drop 1
  held 2
  drop 2
'''
  # The element of `for x in ?v` views its slot; cloning it (`+x`) makes
  # an independent strong handle, which may be kept after the loop and
  # outlive the List.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  count: *Cell[Int] = *Cell(0)
  subs: List[*sub()] = List()
  !subs.push(*|+count| !count.set(count.get() + 1))
  other: List[*sub()] = List()
  for cb in ?subs
    !other.push(+cb)
  <subs
  for cb in ?other
    cb()
  print(count.get())

  v: List[*B] = List()
  !v.push(*B(n: 1))
  !v.push(*B(n: 2))
  held = *B(n: 0)
  for b in ?v
    held = +b
  <v
  print("held", held.n)

