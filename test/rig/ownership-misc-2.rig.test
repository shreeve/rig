test "while step reads binding", '''
  20 5
  325 5
  5 5 6
  5 5 6
  12 6
'''
  # The step of `while c as h: step` may read `h`: it runs after the
  # body, also after a `continue` (and a `continue $outer` from a nested
  # loop), while the body only reads what `h` views. A step that does not
  # read `h` runs after `h`'s scope ends, so the body may grow what `h`
  # viewed once `h` is done, and the step may grow it too. A `continue`
  # in the step ends it.
  #
  # oracle: reads accept
  # oracle: continued accept
  # oracle: body_uses accept
  # oracle: step_grows accept
  # oracle: step_continues accept

  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun next(i: Int) -> Int?
    i if i % 2 == 0 else none

  sub reads()
    v: List[Int] = List()
    !v.push(4)
    k = 0
    i = 0
    while mk(?v, i) as h: k += h.s[0]
      i += 1
    print(k, i)

  sub continued()
    v: List[Int] = List()
    !v.push(5)
    k = 0
    i = 0
    $outer: while mk(?v, i) as h: k += h.s[0]
      i += 1
      if i == 1
        continue
      for j in 0..3
        continue $outer if j == i
      k += 100
    print(k, i)

  sub body_uses()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    i = 0
    while mk(?v, i) as h: i += 1
      k += h.s[0]
      !v.push(2)
    print(k, i, v.len)

  sub step_grows()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    i = 0
    while mk(?v, i) as h: !v.push(2)
      k += h.s[0]
      i += 1
    print(k, i, v.len)

  sub step_continues()
    k = 0
    i = 0
    while i < 6: k += next(i) ?? continue
      i += 1
    print(k, i)

  reads()
  continued()
  body_uses()
  step_grows()
  step_continues()

fail "while step reads binding after grow", "57:5: cannot lend `v` to write while a read loan is live", "65:5: cannot lend `v` to write while a read loan is live", "73:5: cannot lend `v` to write while a read loan is live", "81:5: cannot lend `v` to write while a read loan is live", "88:5: cannot lend `t` to write while a read loan is live", "96:5: cannot lend `v` to write while a read loan is live", "104:5: cannot lend `v` to write while a read loan is live", "112:5: cannot lend `v` to write while a read loan is live", "122:7: cannot lend `v` to write while a read loan is live", "133:7: cannot lend `v` to write while a read loan is live", "141:11: cannot lend `v` to write while a read loan is live", "152:7: cannot lend `v` to write while a read loan is live", errors: 12
  # The step of `while c as h: step` runs after the body, so a view the
  # step reads through `h` keeps its loan through the body: growing the
  # List or Text it views there is rejected, whatever the way to the step
  # (the end of the body, `continue`, `continue $outer` from a nested
  # loop, an inner loop, a `defer`) and however the step reads `h` (a
  # field, a method, a closure), for a joined or a failing condition too.
  #
  # oracle: field reject C4
  # oracle: slice reject C4
  # oracle: method reject C4
  # oracle: closure reject C4
  # oracle: string reject C4
  # oracle: failing reject C4
  # oracle: continued reject C4
  # oracle: labeled reject C4
  # oracle: inner reject C4
  # oracle: deferred reject C4
  # oracle: nested reject C4


  error E
    bad

  obj S
    s: []Int

    fun first(?@) -> Int
      @s[0]

  obj T
    s: ?String

  fun mk(v: ?List[Int]) -> S?
    if v.len < 40
      return S(s: ?v[..])
    none

  fun all(v: ?List[Int]) -> ([]Int)?
    if v.len < 40
      return ?v[..]
    none

  fun mkt(t: ?String) -> T?
    if t.len < 200
      return T(s: ?t)
    none

  fun mkf(v: ?List[Int]) -> S?!
    return E.bad if v.len > 100
    mk(v)

  sub field()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v) as h: k += h.s[0]
      !v.push(2)
    print(k)

  sub slice()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while all(?v) as h: k += h[0]
      !v.push(2)
    print(k)

  sub method()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v) as h: k += h.first()
      !v.push(2)
    print(k)

  sub closure()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v) as h: k += (|?h| h.s[0])()
      !v.push(2)
    print(k)

  sub string()
    t = String("abc")
    k = 0
    while mkt(?t) as h: k += (1 if text.ends_with(h.s, "9") else 0)
      !t.add("0123456789")
    print(k)

  sub joined()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v) as h and h.s.len > 0: k += h.s[0]
      !v.push(2)
    print(k)

  sub failing()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while (mkf(?v) catch none) as h: k += h.s[0]
      !v.push(2)
    print(k)

  sub continued()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v) as h: k += h.s[0]
      !v.push(2)
      continue
    print(k)

  sub labeled()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    $outer: while mk(?v) as h: k += h.s[0]
      for _ in 0..2
        !v.push(2)
        continue $outer
    print(k)

  sub inner()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v) as h: k += h.s[0]
      j = 0
      while j < 2: j += 1
        !v.push(2)
    print(k)

  sub deferred()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v) as h: k += h.s[0]
      defer !v.push(2)
      k += 1
    print(k)

  sub nested()
    v: List[Int] = List()
    !v.push(1)
    k = 0
    i = 0
    while i < 3: i += 1
      while mk(?v) as h: k += h.s[0]
        !v.push(2)
    print(k)

  field()

fail "while step uses owning binding", "the loop step cannot use `b`: the body owns this `*B`"
  # The body drops an owning `as` binding before the loop step runs, so
  # the step cannot use it.

  obj B
    n: Int

  w: List[*B] = List()
  !w.push(*B(n: 1))
  t = 0
  while (!w).pop() as b : t += b.n
    print(b.n)
  print(t)

fail "while step uses view binding", "10:17: the loop step cannot use `x`: it is a view (`!P`) that lives only in the body; use it at the end of the body instead", "14:23: the loop step cannot use `y`: it is a view (`?^P`) that lives only in the body"
  # A view the condition of `while e as x` binds lives only in the body,
  # so the step, which runs after it, cannot use it; a box's value is
  # reached the same way.

  obj P
    n: Int

  o: P? = P(n: 1)
  k = 0
  while !o as x : x.n += 1
    k += 1
    break if k == 3
  b: ^P? = ^P(n: 1)
  while ?b as y : print(y.n)
    k += 1
    break if k == 6
  print(k)

test "while true break move", '''
  7
  drop
  end
'''
  # A move followed by `break` out of `while true` is the only way out of the
  # loop, and the value is not used afterwards.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  sub eat(rc: *Wrap)
    print(rc.payload)

  rc = *Wrap(payload: 7)
  i = 0
  while true
    i += 1
    if i == 3
      eat(<rc)
      break
  print("end")

fail "whole receiver method field arg", "28:6: cannot lend `@` to write while a read loan on `@scanner.value` is live", "lend the fields it writes", errors: 1
  # A `!@` method lends all of `@`, so it cannot be called while a
  # field of `@` is lent: the caller does not look into the body (Core
  # sentence 7). The idiom is a function of the fields it writes, which
  # lends only those paths.
  # From Trig's acceptance tests
  # (docs/ownership/acceptance/beyond/whole_receiver_method_field_arg.rig).

  obj Scanner
    value: String

  obj Arena
    bytes: String

    fun add(!@, text: ?String) -> Int
      !@bytes.add(text)
      @bytes.len

  obj Parser
    scanner: Scanner
    ast: Arena
    count: Int

    fun new_identifier(!@, text: ?String) -> Int
      @count += 1
      (!@ast).add(text)

    fun identifier(!@) -> Int
      (!@).new_identifier(@scanner.value)

  p = Parser(scanner: Scanner(value: String("id")), ast: Arena(bytes: String()), count: 0)
  print((!p).identifier(), p.count)
