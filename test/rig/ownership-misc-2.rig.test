test "variant test catch", '''
  line
  1
'''
  # Testing a `catch` against a bare variant reads it, as any `==`
  # operand: the name its handler gives is read where it is, and a value
  # made there is dropped with the statement.
  error E
    bad

  enum Shape
    dot
    line(v: List[Int])

  fun mk(ok: Bool) -> Shape!
    if not ok
      return E.bad
    .dot

  p: List[Int] = List()
  !p.push(1)
  d = Shape.line(<p)
  if (mk(false) catch d) != .dot
    print("line")
  match ?d
    .line(v) => print(v[0])
    .dot => print("dot")

test "variant test name and call", '''
  some
  1
  line
  still line
  1
'''
  # A name tested against `none` or a bare variant is read in place; a
  # call's result tested that way is dropped after the test.
  enum Shape
    dot
    line(v: List[Int])

  fun mk() -> Shape
    p: List[Int] = List()
    !p.push(1)
    .line(v: <p)

  v: List[Int] = List()
  !v.push(1)
  a: List[Int]? = <v
  if a != none
    print("some")
  if ?a as x
    print(x[0])
  if mk() != .dot
    print("line")
  s = mk()
  if s != .dot
    print("still line")
  match ?s
    .line(w) => print(w[0])
    .dot => print("dot")

test "variant test nullish", '''
  line
  1
'''
  # Testing `o ?? d` against a bare variant reads it, as any `==` operand:
  # the value `o` or `d` holds is read where it is, never dropped.
  enum Shape
    dot
    line(v: List[Int])

  p: List[Int] = List()
  !p.push(1)
  o: Shape? = none
  d = Shape.line(<p)
  if (o ?? d) != .dot
    print("line")
  match ?d
    .line(v) => print(v[0])
    .dot => print("dot")

test "variant test optional field", '''
  true
  1
'''
  # Testing `h.o?` against a bare variant reads the value the field holds
  # where it is, as any `==` operand reads.
  enum Shape
    dot
    line(v: List[Int])

  obj H
    o: Shape?

  fun f(h: ?H) -> Bool?
    r = h.o? != .dot
    r

  p: List[Int] = List()
  !p.push(1)
  h = H(o: Shape.line(<p))
  print(f(?h) ?? false)
  if ?h.o as s
    match s
      .line(v) => print(v[0])
      .dot => print("dot")

test "variant test ternary owners", '''
  line
  1
'''
  # Testing a branching value against a bare variant reads it, as any
  # `==` operand: a name it may be is read where it is, never dropped.
  enum Shape
    dot
    line(v: List[Int])

  p: List[Int] = List()
  !p.push(1)
  a = Shape.line(<p)
  b = Shape.dot
  c = true
  if (a if c else b) != .dot
    print("line")
  match ?a
    .line(v) => print(v[0])
    .dot => print("dot")

