code "inline budget 250 calls of six adds stay inlined", "pub inline fn bump(", "rig.addProven("
  # Nor do 250 calls of one holding six proven adds (1,750 inline calls in
  # main), and the adds stay proven.

  fun bump(s: ?String, at: Int) -> Int
    i = at
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    i - at

  sub main()
