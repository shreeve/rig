code "inline budget raised first in each fn not inline", /(?:rig\.addProven\([\s\S]*?){1000}/, /^fn __rig_run_main\([^\n]*\n[^\n]*@setEvalBranchQuota\(rig\.eval_quota\);/m, /^pub fn many\([^\n]*\n[^\n]*@setEvalBranchQuota\(rig\.eval_quota\);/m, /^(?![\s\S]*pub inline fn [^\n]*(?:\n[^\n]*)?@setEvalBranchQuota)/
  # Each function that is not inline raises its budget first; an inline
  # one runs on its caller's. `main`'s body is `__rig_run_main`, which
  # `main` runs on the program's stack. All 1,000 adds of `many` are proven.

  fun inc(x: Int) -> Int
    x + 1

  fun step[k: Int](x: Int) -> Int
    inc(x) + k - 1

  fun twice(x: Int) -> Int
    inc(inc(x))

  fun bump(s: ?String, at: Int) -> Int
    i = at
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    i - at

  fun cbump[k: Int](s: ?String, at: Int) -> Int
    i = at
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    i - at + k - 1

  inline fun fbump(s: ?String, at: Int) -> Int
