# The inline budget, written by tools/inline_budget.py (edit it, not this
# file): Zig charges every inline call to the evaluation budget of the
# function the code lands in, and every emitted function that is not
# inline raises it first (`rig.eval_quota`), so no count of inline calls
# stops a build (test/cli/inline_budget.sh builds the grid of counts).

test "inline budget proven adds in a plain fn", "26", release: true
  # 1,100 proven adds in one function, a probe of the review that found the class.

