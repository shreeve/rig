code "inline budget marked helper over the size limit", "pub inline fn fbump(", /(?:rig\.addProven\([\s\S]*?){12}/
  # The marked helper is inlined, over the size limit, its adds proven.

  fun inc(x: Int) -> Int
    x + 1

  fun step[k: Int](x: Int) -> Int
    inc(x) + k - 1

  fun twice(x: Int) -> Int
    inc(inc(x))

  fun bump(s: ?String, at: Int) -> Int
    i = at
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    i - at

  fun cbump[k: Int](s: ?String, at: Int) -> Int
    i = at
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    i - at + k - 1

  inline fun fbump(s: ?String, at: Int) -> Int
    i = at
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
