      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    if i + 1 <= s.len
      i += 1
    i - at

  fun many(s: ?String) -> Int
    i = 0
    i

  sub main()
    s = "abcdefghijklmnopqrstuvwxyz"
    n = 0
    n = n + fbump(s, 0)
    n = n + fbump(s, 0)
