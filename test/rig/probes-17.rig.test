fail "review-arm-temps-l13 assign target view grow block", "cannot lend `v` to write while a write loan is live"
  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  k = 0
  w[0] = match k
    0
      grow(!v)
    _ => 3
  print(v[0], v.len)

