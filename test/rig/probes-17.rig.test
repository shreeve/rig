fail "review-assign-desugar-n34 repoint at subject payload last arm", "`p` does not live long enough"
  # The value is a match on a made subject whose last arm re-points the
  # target at the payload. The payload (or the subject temporary holding
  # it) dies at the arm's end or at the statement's end.
  enum Bx
    nothing
    has(v: List[Int])

  fun mk() -> Bx
    v: List[Int] = List()
    !v.push(1)
    Bx.has(<v)

  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = match mk()
    .nothing => 5
    .has(p)
      w = !p[0..1]
      3
  print(v[0])

test "review-assign-desugar-n37 field target owner replaced", "11 0"
  # Valid: the value moves the target's owner and makes a new one; the
  # field store lands in the new owner.
  obj S
    items: List[Int]
    n: Int

  fun sink(s: S) -> Int
    s.items.len

  s = S(items: List(), n: 1)
  !s.items.push(4)
  k = 0
  s.n = match k
    1 => 2
    _
      m = sink(<s)
      s = S(items: List(), n: 0)
      m + 10
  print(s.n, s.items.len)

test "review-assign-desugar-n38 order prints", '''
  arm
  i
  j
  value
  i2
  j2
  w-arm
  w-value
  10
'''
  # Order: the value (with its arm) runs first, then the target's indexes,
  # outermost first; identical on main and the branch.
  fun at(i: Int, what: ?String) -> Int
    print(what)
    i

  a: List[List[Int]] = List()
  !a.push(List())
  !a[0].push(0)
  k = 0
  a[at(0, "i")][at(0, "j")] = match k
    0
      at(5, "arm")
    _ => 1
  a[at(0, "i2")][at(0, "j2")] += at(2, "value")
  w = !a[0][0]
  w = match k
    0 => at(9, "w-arm")
    _ => 1
  w += at(1, "w-value")
  print(a[0][0])

fail "review-assign-desugar-n39 field compound last arm repoint", "`u` does not live long enough"
  # Field compound target; the last arm re-points the view at its local.
  obj S
    n: Int

  v: List[S] = List()
  !v.push(S(n: 7))
  w = !v[0]
  k = 0
  w.n += match k
    1 => 4
    _
      u: List[S] = List()
      !u.push(S(n: 1))
      w = !u[0]
      3
  print(v[0].n)

fail "review-assign-desugar-n40 name catch block repoint", "`u` does not live long enough"
  # Name target through a write view; the catch block re-points it at its
  # local.
  error E
    bad

  fun fail(n: Int) -> Int!
    return E.bad if n < 0
    n

  v: List[Int] = List()
  !v.push(7)
  w = !v[0]
  w = fail(-1) catch |_|
    u: List[Int] = List()
    !u.push(1)
    w = !u[0]
    3
  print(v[0])

fail "review-assign-desugar-n41 nested index view last arm grow", "cannot lend `a` to write while a write loan is live"
  # `wv[0][0] = match` through a slice of a List of Vecs; the last arm
  # grows the outer List, which the slice views.
  fun grow(a: !List[List[Int]]) -> Int
    for _ in 0..100
      !a.push(List())
    a.len

  a: List[List[Int]] = List()
  !a.push(List())
  !a[0].push(0)
  wv = !a[0..1]
  k = 0
  wv[0][0] = match k
    1 => 4
    _
      grow(!a)
  print(a[0][0])

test "review-assign-desugar-n42 nested index view last arm repoint outer", "0 3"
  # Valid: `wv[0][0] = match` whose last arm re-points the slice at another
  # outer List of Vecs; the store lands there.
  a: List[List[Int]] = List()
  !a.push(List())
  !a[0].push(0)
  b: List[List[Int]] = List()
  !b.push(List())
  !b[0].push(0)
  wv = !a[0..1]
  k = 0
  wv[0][0] = match k
    1 => 4
    _
      wv = !b[0..1]
      3
  print(a[0][0], b[0][0])

fail "review-assign-desugar-n43 index in index view last arm", "`t` does not live long enough"
  # `u[w[0]][w[1]] = ` where the last arm re-points `w` at its own local.
  v: List[Int] = List()
  !v.push(0)
  !v.push(0)
  u: List[List[Int]] = List()
  !u.push(List())
  !u[0].push(0)
  w = ?v[0..2]
  k = 0
  u[w[0]][w[1]] = match k
    1 => 4
    _
      t: List[Int] = List()
      !t.push(0)
      !t.push(0)
      w = ?t[0..2]
      3
  print(u[0][0])

fail "review-b4b-1-p01 read as push in body", "cannot lend `v` to write while a read loan is live"
  # read `if … as` over a List element through a temporary index; body
  # grows the List and then uses the binding (dangling). Expect reject.
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("a"))
  if v[idx(?String("a"))] as t
    for _ in 0..64
      !v.push(String("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"))
    print(t)

fail "review-b4b-1-p02 write as push in body", "use of `v` while a write loan is live"
  # write `if !… as` over List element via temp index; body pushes then writes t. Expect reject.
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("a"))
  if !v[idx(?String("a"))] as t
    for _ in 0..64
      !v.push(String("zz"))
    !t.add("x")
  print(v)

fail "review-b4b-1-p03 match write push in arm", "use of `v` while a write loan is live"
  # write match on List element through temp index; arm pushes then writes payload. Expect reject.
  enum E
    a(t: String)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[E] = List()
  !v.push(E.a(t: String("q")))
  match !v[idx(?String("a"))]
    .a(t)
      for _ in 0..64
        !v.push(E.b(n: 5))
      !t.add("x")
    .b(n) => n += 1
  print(v.len)

fail "review-b4b-1-p04 match write push in arm notemp", "use of `v` while a write loan is live"
  # 2d47a2db: write match on List element (no temp); arm pushes then writes payload. Expect reject.
  enum E
    a(t: String)
    b(n: Int)

  v: List[E] = List()
  !v.push(E.a(t: String("q")))
  i = 0
  match !v[i]
    .a(t)
      for _ in 0..64
        !v.push(E.b(n: 5))
      !t.add("x")
    .b(n) => n += 1
  print(v.len)

fail "review-b4b-1-p05 match write push then int", "use of `v` while a write loan is live"
  # write match on List element; arm pushes then writes Int payload n. Expect reject.
  enum E
    a(n: Int)
    b(n: Int)

  v: List[E] = List()
  !v.push(E.a(n: 1))
  i = 0
  match !v[i]
    .a(n)
      for _ in 0..64
        !v.push(E.b(n: 5))
      n = 99
    .b(n) => n += 1
  print(v[0])

test "review-b4b-1-p06 match write push no later use", ".a(n: 99) 65"
  # write match on List element; arm writes payload then pushes (no later use). Expect accept, runs clean.
  enum E
    a(n: Int)
    b(n: Int)

  v: List[E] = List()
  !v.push(E.a(n: 1))
  i = 0
  match !v[i]
    .a(n)
      n = 99
      for _ in 0..64
        !v.push(E.b(n: 5))
    .b(n) => n += 1
  print(v[0], v.len)

fail "review-b4b-1-p07 read match move owner", "cannot move `v` while a read loan is live"
  # read match through temp index, arm moves the owner then uses payload. Expect reject.
  enum E
    a(t: String)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  sub eat(v: List[E])
    print(v.len)

  v: List[E] = List()
  !v.push(E.a(t: String("q")))
  match v[idx(?String("a"))]
    .a(t)
      eat(<v)
      print(t)
    .b(n) => print(n)

fail "review-b4b-1-p08 for elem push", "use of `m` while a write loan is live"
  # for over element (array) of a List via temp index; body pushes. Expect reject.
  fun idx(s: ?String) -> Int
    s.len - 1

  m: List[[2]Int] = List()
  !m.push([1, 2])
  for x in !m[idx(?String("k"))]
    !m.push([3, 4])
    x *= 10
  print(m)

test "review-b4b-1-p09 while as push", "axxx 193"
  # while-as over List element via temp index, body pushes after using t (each iteration re-evaluates). Expect accept + clean.
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("a"))
  k = 0
  while !v[idx(?String("a"))] as t
    !t.add("x")
    for _ in 0..64
      !v.push(String("zzzzzzzzzzzzzzzzzzz"))
    k += 1
    break if k > 2
  print(v[0], v.len)

fail "review-b4b-1-p10 while as push use after", "use of `v` while a write loan is live"
  # while-as over List element via temp index; push then use t. Expect reject.
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("a"))
  k = 0
  while !v[idx(?String("a"))] as t
    for _ in 0..64
      !v.push(String("zzzzzzzzzzzzzzzzzzz"))
    !t.add("x")
    k += 1
    break if k > 2
  print(v[0], v.len)

test "review-b4b-1-p12 wm value pos", '''
  2 .a(n: 2, t: "vg")
  .a(n: 7, t: "vg")
'''
  # write match on List element in value position, with a guard. Expect accept, clean.
  enum E
    a(n: Int, t: String)
    b

  v: List[E] = List()
  !v.push(E.a(n: 1, t: String("v")))
  i = 0
  k = 3
  r = match !v[i]
    .a(n, t) if k > 2
      n += 1
      !t.add("g")
      n
    .a(n, _) => n
    .b => 0
  print(r, v[0])
  match !v[i]
    .a(n, _) => n += 5
    .b => pass
  print(v[0])
