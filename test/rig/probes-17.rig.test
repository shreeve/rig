test "review-assign-desugar-n06 nested index value grows outer", "201 101 201"
  # Valid: `a[i][j] = grow(!a)`: the value grows the outer List before the
  # target is found, so the store lands in the moved inner List.
  fun grow(a: !List[List[Int]]) -> Int
    for _ in 0..100
      !a.push(List())
    a.len

  a: List[List[Int]] = List()
  !a.push(List())
  !a[0].push(0)
  !a[0].push(0)
  k = 0
  a[0][1] = match k
    0
      grow(!a)
    _ => 3
  a[0][0] += grow(!a)
  print(a[0][0], a[0][1], a.len)

