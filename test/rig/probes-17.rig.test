fail "review-arm-temps-2-m46 last arm index target view local", "`u` does not live long enough"
  # The target's index reads a view the last arm re-points at an arm-local List.
  v: List[Int] = List()
  !v.push(2)
  t: List[Int] = List()
  for _ in 0..5
    !t.push(0)
  w = ?v[0..1]
  k = 0
  t[w[0]] = match k
    1 => 4
    _
      u: List[Int] = List()
      !u.push(3)
      w = ?u[0..1]
      9
  print(t[2], t[3])

test "review-arm-temps-2-m47 name target repointed then grows old", "7 201 201"
  # A write-view name target re-pointed inside the value, which then grows
  # the old referent. The source stores through the new view (u[0]); the
  # emitted `w.* = switch ...` takes `w` before the value runs.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  w = !v[0]
  k = 0
  w = match k
    0
      w = !u[0]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

test "review-arm-temps-2-m48 name target repointed no grow", "7 3"
  # The value re-points the write-view name target; the store must go
  # through the new view (u[0]), as for an element target (m23).
  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  w = !v[0]
  k = 0
  w = match k
    0
      w = !u[0]
      3
    _ => 4
  print(v[0], u[0])

test "review-arm-temps-2-m49 rls alias struct swap", '''
  2 1
  4 3
  3 4
  4 3
'''
  # A store whose value reads the place it replaces: the value is computed
  # first, then stored (Zig result-location aliasing would break this).
  obj P
    a: Int
    b: Int

  p = P(a: 1, b: 2)
  p = P(a: p.b, b: p.a)
  print(p.a, p.b)
  v: List[P] = List()
  !v.push(P(a: 3, b: 4))
  v[0] = P(a: v[0].b, b: v[0].a)
  print(v[0].a, v[0].b)
  w = !v[0]
  w = P(a: w.b, b: w.a)
  print(w.a, w.b)
  k = 0
  w = match k
    0
      P(a: w.b, b: w.a)
    _ => P(a: 0, b: 0)
  print(v[0].a, v[0].b)

test "review-arm-temps-2-m50 block last set target view of local", '''
  3
  5
'''
  # Valid: a set is the last line of a block, and its target writes through
  # a view re-pointed at the block's local; nothing uses the view after.
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = 5
  k = true
  if k
    u: List[Int] = List()
    !u.push(1)
    w = !u[0..1]
    w[0] = 3
    print(u[0])
  print(v[0])

test "review-arm-temps-2-m51 block last line set", "5"
  # Valid: as m50 with the set as the block's very last line.
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = 5
  k = true
  if k
    u: List[Int] = List()
    !u.push(1)
    w = !u[0..1]
    w[0] = 3
  print(v[0])

fail "review-arm-temps-l02 binding view grow block", "cannot lend `v` to write while a write loan is live"
  enum Sh
    name(t: String)
    point

  fun grow(v: !List[Sh]) -> Int
    for _ in 0..50
      !v.push(.point)
    v.len

  v: List[Sh] = List()
  !v.push(.name(t: String("abc")))
  x = !v
  match ?x[0]
    .name(t)
      print("block", grow(!v), t.len)
    .point => pass
  print(v.len)

fail "review-arm-temps-l03 place subject grow", "cannot lend `v` to write while a read loan is live"
  enum Sh
    name(t: String)
    point

  fun grow(v: !List[Sh]) -> Int
    for _ in 0..50
      !v.push(.point)
    v.len

  v: List[Sh] = List()
  !v.push(.name(t: String("abc")))
  match v[0]
    .name(t) => print("simple", grow(!v), t.len)
    .point => pass
  print(v.len)

fail "review-arm-temps-l04 write view used in later stmt", "cannot lend `v` to write while a read loan is live"
  # A write view taken before the match, used after it: a write lend in an
  # arm must still conflict.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..50
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  x = ?v[0..1]
  k = 1
  match k
    1 => print(grow(!v))
    _ => pass
  print(x[0])

fail "review-arm-temps-l05 view in loop earlier arm", "cannot lend `v` to write while a read loan is live"
  # A view used in an earlier arm, in a loop: the arm of the next iteration
  # reads it after a later arm lent to write.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..50
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  x = ?v[0..1]
  for i in 0..2
    match i
      0 => print(x[0])
      _ => print(grow(!v))

fail "review-arm-temps-l06 view in loop earlier arm rev", "cannot lend `v` to write while a read loan is live"
  fun grow(v: !List[Int]) -> Int
    for _ in 0..50
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  x = ?v[0..1]
  for i in 0..2
    match 1 - i
      0 => print(x[0])
      _ => print(grow(!v))

fail "review-arm-temps-l07 subject viewed by guard after", "cannot lend `v` to write while a read loan is live"
  # The subject views v; a later arm's guard reads it through x after a
  # write lend in an earlier-tested arm? Guards run before the arm body.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..50
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  x = ?v[0..1]
  k = 0
  r = match k
    0 => grow(!v)
    _ if x[0] > 0 => 1
    _ => 2
  print(r)

fail "review-arm-temps-l08 while step reads view", "cannot lend `v` to write while a read loan is live"
