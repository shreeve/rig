  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  w = !v[0..1]
  k = 0
  w[0] = match k
    0
      w = !u[0..1]
      grow(!v)
    _ => 3
  print(v[0], u[0], v.len)

