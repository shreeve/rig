fail "review-arm-temps-2-m21 name target old drop reads view", "cannot lend `v` to write while a read loan is live"
  # The store drops the old value of `h`, whose `drop` reads what it views,
  # after the arm grows that owner.
  obj H
    v: ?List[Int]

    drop(!@)
      print("drop", @v[0])

  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  h = H(v: ?v)
  k = 0
  h = match k
    0
      grow(!v)
      H(v: ?u)
    _ => H(v: ?u)
  print("end")

test "review-arm-temps-2-m23 arm repoints target view", "7 3"
  # The arm re-points the write view the target writes through; the store
  # goes through the new view, as emit evaluates the target after the value.
  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  w = !v[0..1]
  k = 0
  w[0] = match k
    0
      w = !u[0..1]
      3
    _ => 4
  print(v[0], u[0])

