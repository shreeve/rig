test "review-arm-temps-2-m27 catch block name moved", '''
  drop 1
  s 11
  drop 11
  drop 1
  s 3
  drop 3
'''
  error E
    bad

  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  fun mk(n: Int) -> D!
    return E.bad if n < 0
    D(n: n)

  fun sink(d: D) -> D
    D(n: d.n + 10)

  sub run(k: Int)
    s = D(n: 1)
    s = mk(k) catch |_|
      sink(<s)
    print("s", s.n)

  run(-1)
  run(3)

test "review-arm-temps-2-m28 if block name moved", '''
  drop 1
  s 11
  drop 11
  drop 1
  s 4
  drop 4
'''
  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  fun sink(d: D) -> D
    D(n: d.n + 10)

  sub run(k: Bool)
    s = D(n: 1)
    s = if k
      sink(<s)
    else
      D(n: 4)
    print("s", s.n)

  run(true)
  run(false)

test "review-arm-temps-2-m29 target index temp lend after grow", "4 4"
  # The target's index lends `v` (a temporary) after the value grows it: the
  # checker walks the target after the value, as emit evaluates it.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..3
      !v.push(1)
    v.len

  fun at(v: ?List[Int]) -> Int
    v.len - 1

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  for _ in 0..10
    !u.push(0)
  k = 0
  u[at(?v)] = match k
    0 => grow(!v)
    _ => 3
  print(u[3], v.len)

test "review-arm-temps-2-m30 nested set target in arm", "5 201"
  # A set nested in the value whose own target views the owner the outer
  # value grows afterwards in the same arm.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(1)
  w = !v[0..1]
  k = 0
  u[0] = match k
    0
      w[0] = match k
        0 => 5
        _ => 6
      grow(!v)
    _ => 3
  print(v[0], u[0])

fail "review-arm-temps-2-m33 slice holder drop reads", "cannot lend `v` to write while a read loan is live"
  # The store drops the old `h`, whose `drop` reads a slice of `v`, after the
  # arm grows `v`.
  obj H
    v: []Int

    drop(!@)
      print("drop", @v[0])

  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  h = H(v: ?v[0..1])
  k = 0
  h = match k
    0
      grow(!v)
      H(v: ?u[0..1])
    _ => H(v: ?u[0..1])
  print("end")

fail "review-arm-temps-2-m34 slice holder drop reads plain", "cannot lend `v` to write while a read loan is live"
  # The same as m33 with no nested statement: the right side grows `v`, then
  # the store drops the old `h`, whose `drop` reads a slice of `v`.
  obj H
    v: []Int

    drop(!@)
      print("drop", @v[0])

  fun growh(v: !List[Int], u: ?List[Int]) -> H
    for _ in 0..200
      !v.push(1)
    H(v: ?u[0..1])

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  h = H(v: ?v[0..1])
  h = growh(!v, ?u)
  print("end")

test "review-arm-temps-2-m35 owner place target grow in arm", "602 401"
  # The target is the owner's own place, evaluated after the value: growing
  # the owner in an arm is fine.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  k = 0
  v[0] = match k
    0
      grow(!v)
    _ => 3
  v[0] += if k == 0
    grow(!v)
  else
    3
  print(v[0], v.len)

test "review-arm-temps-2-m36 self field target grow in arm", "201 201"
  obj B
    v: List[Int]

    fun grow(!@) -> Int
      for _ in 0..200
        !@v.push(1)
      @v.len

    sub set(!@, k: Int)
      @v[0] = match k
        0 => (!@).grow()
        _ => 3

  b = B(v: List())
  !b.v.push(7)
  !b.set(0)
  print(b.v[0], b.v.len)

fail "review-arm-temps-2-m37 payload binding target", "cannot lend `b` to write while a write loan is live"
  # The target writes through a payload binding of the enclosing match; the
  # value's arm lends the subject's owner.
  obj D
    v: List[Int]

  enum Bx
    has(d: D)
    nothing

  fun grow(b: !Bx) -> Int
    b = Bx.nothing
    0

  b = Bx.has(D(v: List()))
  k = 0
  match !b
    .has(d)
      !d.v.push(1)
      d.v[0] = match k
        0 => grow(!b)
        _ => 3
    .nothing => pass

test "review-arm-temps-2-m38 arm repoints then grows old", "7 201 201"
  # The arm re-points the target's write view, then grows its old referent:
