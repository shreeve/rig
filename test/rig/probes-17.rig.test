# Probes from past reviews and audits, 17 of 41: review-arm-temps-2-m11_name_writeview_compound to review-b4b-1-p12_wm_value_pos.

fail "review-arm-temps-2-m11 name writeview compound", "cannot lend `v` to write while a write loan is live"
  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  w = !v[0]
  k = 0
  w += match k
    0
      grow(!v)
    _ => 3
  print(v[0])

fail "review-arm-temps-2-m12 nested set owner reassigned", "cannot reassign `v` while it is lent"
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  k = 0
  w[0] = match k
    0
      v = List()
      !v.push(9)
      3
    _ => 3
  print(v[0])

fail "review-arm-temps-2-m15 readview repoint overreject", "cannot lend `v` to write while a read loan is live"
  # A read-view local re-pointed from a value whose arm grows its old referent.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..3
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  r = ?v[0..1]
  print(r[0])
  k = 0
  r = match k
    0
      grow(!v)
      ?u[0..1]
    _ => ?u[0..1]
  print(r[0], v.len)

test "review-arm-temps-2-m16 writeview repoint", "9 6 4"
  # A write-view local re-pointed from a value whose arm grows its old referent.
  fun grow(v: !List[Int]) -> Int
    for _ in 0..3
      !v.push(1)
    v.len

  v: List[Int] = List()
  !v.push(7)
  u: List[Int] = List()
  !u.push(8)
  r = !v[0..1]
  r[0] = 6
  k = 0
  r = match k
    0
      grow(!v)
      !u[0..1]
    _ => !u[0..1]
  r[0] = 9
  print(u[0], v[0], v.len)

