fail "review-arm-temps-2-m42 catch block repoints to local", "`u` does not live long enough"
  error E
    bad

  fun fail(n: Int) -> Int!
    return E.bad if n < 0
    n

  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = fail(-1) catch |_|
    u: List[Int] = List()
    !u.push(1)
    w = !u[0..1]
    3
  print(v[0])

fail "review-arm-temps-2-m43 last arm repoints to arm local", "`u` does not live long enough"
  # m39 with the re-pointing arm last: its scope ends where the assignment
  # ends, at the position the target's uses are recorded.
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  k = 0
  w[0] = match k
    1 => 4
    _
      u: List[Int] = List()
      !u.push(1)
      w = !u[0..1]
      3
  print(v[0])

fail "review-arm-temps-2-m44 else block repoints to local", "`u` does not live long enough"
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  k = false
  w[0] = if k
    4
  else
    u: List[Int] = List()
    !u.push(1)
    w = !u[0..1]
    3
  print(v[0])

