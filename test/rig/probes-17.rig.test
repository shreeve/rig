test "review-assign-desugar-n23 rls if struct swap", '''
  2 1
  1 2
  4 3
  3 4
  2 1
  1 2
'''
  # Valid: pure values (no call) that read the place they replace, through
  # an `if`, a `match`, an array literal, and a write view. Zig result-
  # location aliasing must not show through: __v semantics.
  obj P
    a: Int
    b: Int

  k = 0
  p = P(a: 1, b: 2)
  p = P(a: p.b, b: p.a) if k == 0 else p
  print(p.a, p.b)
  p = match k
    0 => P(a: p.b, b: p.a)
    _ => p
  print(p.a, p.b)
  v: List[P] = List()
  !v.push(P(a: 3, b: 4))
  v[0] = P(a: v[0].b, b: v[0].a) if k == 0 else v[0]
  print(v[0].a, v[0].b)
  w = !v[0]
  w = match k
    0 => P(a: w.b, b: w.a)
    _ => P(a: 0, b: 0)
  print(v[0].a, v[0].b)
  arr = [1, 2]
  arr = [arr[1], arr[0]]
  print(arr[0], arr[1])
  wa = !arr
  wa = [wa[1], wa[0]]
  print(arr[0], arr[1])

test "review-assign-desugar-n24 rls enum payload swap", '''
  4 3 2 1
  4 3 2 1
  1 2 3 4
'''
  # Valid: a match on the place being assigned, whose arm builds the new
  # value from the payload; the payload must be read before the store.
  obj P
    a: Int
    b: Int
    c: Int
    d: Int

  enum Pr
    pair(p: P)
    empty

  e = Pr.pair(P(a: 1, b: 2, c: 3, d: 4))
  e = match e
    .pair(p) => Pr.pair(P(a: p.d, b: p.c, c: p.b, d: p.a))
    .empty => Pr.empty
  match e
    .pair(p) => print(p.a, p.b, p.c, p.d)
    .empty => pass
  v: List[Pr] = List()
  !v.push(Pr.pair(P(a: 1, b: 2, c: 3, d: 4)))
  v[0] = match v[0]
    .pair(p) => Pr.pair(P(a: p.d, b: p.c, c: p.b, d: p.a))
    .empty => Pr.empty
  match v[0]
    .pair(p) => print(p.a, p.b, p.c, p.d)
    .empty => pass
  w = !v[0]
  w = match w
    .pair(p) => Pr.pair(P(a: p.d, b: p.c, c: p.b, d: p.a))
    .empty => Pr.empty
  match v[0]
    .pair(p) => print(p.a, p.b, p.c, p.d)
    .empty => pass

test "review-assign-desugar-n25 value temp drop order", '''
  index
  drop 5
  5
  drop 6
  index2
  6
'''
  # Order: does a temporary the value makes drop before the target's
  # index runs ({ __v = value; place = __v }), or after the store?
  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  fun mk(n: Int) -> D
    D(n: n)

  fun at(i: Int, what: ?String) -> Int
    print(what)
    i

  v: List[Int] = List()
  !v.push(0)
  v[at(0, "index")] = mk(5).n
  print(v[0])
  k = 0
  v[at(0, "index2")] = match k
    0 => mk(6).n
    _ => 1
  print(v[0])

test "review-assign-desugar-n26 generic writeview repoint", '''
  1 9 201
  a z 201
'''
  # A write-view local of a generic element type, re-pointed in the value,
  # which then grows the old referent; the store goes to y[0].
  fun grow[T](v: !List[T], x: T) -> Int
    for _ in 0..200
      !v.push(x)
    v.len

  sub run[T](x: !List[T], y: !List[T], a: T, k: Int)
    w = !x[0]
    w = match k
      0
        w = !y[0]
        grow(!x, a)
        a
      _ => a

  x: List[Int] = List()
  !x.push(1)
  y: List[Int] = List()
  !y.push(2)
  run(!x, !y, 9, 0)
  print(x[0], y[0], x.len)
  xs: List[?String] = List()
  !xs.push("a")
  ys: List[?String] = List()
  !ys.push("b")
  run(!xs, !ys, "z", 0)
  print(xs[0], ys[0], xs.len)

test "review-assign-desugar-n27 owning writeview repoint", "201 0 201"
  # A write view of an owning struct, re-pointed in the value, which then
  # grows the old List: the old value at y[0] is dropped and replaced.
  obj S
    items: List[Int]

  fun grow(v: !List[S]) -> Int
    for _ in 0..200
      !v.push(S(items: List()))
    v.len

  x: List[S] = List()
  !x.push(S(items: List()))
  y: List[S] = List()
  !y.push(S(items: List()))
  !y[0].items.push(5)
  w = !x[0]
  k = 0
  w = match k
    0
      w = !y[0]
      n = grow(!x)
      t: List[Int] = List()
      !t.push(n)
      S(items: <t)
    _ => S(items: List())
  print(x.len, x[0].items.len, y[0].items[0])

