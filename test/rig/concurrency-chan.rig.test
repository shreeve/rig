test "chan made in a variant payload", seeds: 20, "7"
  # `*Chan[T](n)` made in the call that builds a variant is the
  # payload's value.
  enum Link
    ch(c: *Chan[Int])
    null

  sub run()!
    l = Link.ch(c: *Chan[Int](2))
    match !l
      .ch(:c)
        !c.send(7)!
        print((!c).recv()! ?? -1)
      .null => print("null")

  run() catch print("failed")

test "chan send on a closed channel panics, and the channel goes on", seeds: 20, timeout: 10, '''
  -9
  1
  -1
'''
  # The send's panic leaves the channel as it was: an isolate stops it,
  # and the values sent before still come out.
  use std.task

  fun bad(ch: *Chan[Int]) -> Int!
    !ch.send(2)!
    0

  ch = *Chan[Int](4)
  !ch.send(1)!
  !ch.close()
  print(task.isolate(|+ch| bad(+ch)!) catch -9)
  print((!ch).recv()! ?? -1)
  print((!ch).recv()! ?? -1)

test "chan close with a sender waiting panics in the sender", seeds: 20, timeout: 10, '''
  -9
  1
  -1
'''
  # A sender waiting on a full channel that closes panics in its own
  # task, as a later send does; the closer goes on.
  use std.task
  use std.time

  fun fill(ch: *Chan[Int]) -> Int!
    !ch.send(2)!
    0

  ch = *Chan[Int](1)
  !ch.send(1)!
  r = task.isolate(|+ch|
    t = fill(+ch)&
    time.sleep(ms: 5)!
    !ch.close()
    >t!
  ) catch -9
  print(r)
  print((!ch).recv()! ?? -1)
  print((!ch).recv()! ?? -1)

test "chan select named", seeds: 20, timeout: 10, "4"
  # `task.select(name: arm, ...)` gives a value whose variants are the
  # arms' names; the winner's body runs in the enclosing scope, so two
  # bodies write one value. A closed channel gives `none`.
  use std.task
  use std.time

  sub feed(ch: *Chan[Int], n: Int)!
    for i in 1..=n
      !ch.send(i)!
    !ch.close()

  a = *Chan[Int](4)
  b = *Chan[Int](4)
  fa = feed(+a, 3)&
  fb = feed(+b, 2)&
  n = 0
  a_open = true
  b_open = true
  while a_open or b_open
    match task.select(
      add:  !a.on_recv(),
      sub:  !b.on_recv(),
      late: time.after(1)
    )!
      .add(v?) => n += v
      .add(none) => a_open = false
      .sub(v?) => n -= v
      .sub(none) => b_open = false
      .late => print("timeout")
  >fa!
  >fb!
  print(n + 1)

test "chan select named send", seeds: 20, "hi full"
  # A send arm carries nothing; a send that loses drops its value.
  a = *Chan[String](1)
  b = *Chan[String](1)
  !a.send(String("hi"))!
  !b.send(String("full"))!
  match task.select(got: !a.on_recv(), put: !b.on_send(<String("lost")))!
    .got(s?) => print(s, (!b).recv()! ?? String("none"))
    .got(none) => print("closed")
    .put => print("sent")

test "chan select named value", seeds: 20, timeout: 10, '''
  true
  late
  kept 1
'''
  # The select's value is a value like any other: bound, tested with
  # `matches`, and matched later. A received String moves out of it.
  use std.task
  use std.time

  a = *Chan[String](1)
  r = task.select(got: !a.on_recv(), late: time.after(ms: 1))!
  print(r matches .late)
  if r matches .late
    print("late")
  !a.send(String("kept"))!
  kept = List[String]()
  r2 = task.select(got: !a.on_recv(), late: time.after(1))!
  match <r2
    .got(s?) => !kept.push(<s)
    .got(none) => print("closed")
    .late => print("late")
  print(kept[0], kept.len)

