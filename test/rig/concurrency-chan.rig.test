# concurrency: tests whose names start `chan`.
use std.task

test "chan producer and consumer", seeds: 20, "499500"
  # A bounded channel carries values from one task to another; closing
  # it ends the receiver's loop once it has drained what was sent.
  sub produce(ch: *Chan[Int], n: Int)!
    for i in 0..n
      !ch.send(i)!
    !ch.close()

  fun consume(ch: *Chan[Int]) -> Int!
    sum = 0
    loop
      v = (!ch).recv()! ?? -1
      if v < 0
        break
      sum += v
    sum

  ch = *Chan[Int](4)
  p = produce(+ch, 1000)&
  c = consume(+ch)&
  >p!
  print(>c!)

test "chan many senders", seeds: 20, "8000 8"
  # Senders on several tasks share one channel through handles of their
  # own; every value arrives once.
  sub produce(ch: *Chan[Int], n: Int)!
    for 0..n
      !ch.send(1)!

  ch = *Chan[Int](16)
  ts = Tasks[Void!]()
  for 0..8
    !ts.add(produce(+ch, 1000)&)
  sum = 0
  for 0..8000
    sum += (!ch).recv()! ?? 0
  n = ts.len
  >ts!
  print(sum, n)

test "chan select", seeds: 20, '''
  207
  sent 1
  hello
  none
'''
  # `task.select` commits exactly one arm: the receive that can complete,
  # or a send; a send that loses drops its value, and a closed channel
  # gives none.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  got = task.select(
    (!a).on_recv(|v| (v ?? 0) + 100),
    (!b).on_recv(|v| (v ?? 0) + 200),
  )!
  print(got)
  full = *Chan[String](1)
  !full.send(String("hello"))!
  sent = task.select(
    (!full).on_send(String("lost"), || 0),
    (!a).on_send(5, || 1),
  )!
  print("sent", sent)
  print((!full).recv()! ?? String("none"))
  !b.close()
  closed = task.select((!b).on_recv(|v| "none" if v == none else "value"))!
  print(closed)

test "chan select a closure's view in any arm", seeds: 20, "1007 2007"
  # An arm runs on the task that selects, so a closure's view goes to
  # any arm, the first as well as the rest.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  k = 1000
  g = |?k, v: Int?| (v ?? 0) + k
  !b.send(7)!
  first = task.select(
    (!b).on_recv(?g),
    (!a).on_recv(|v| (v ?? 0) + 100),
  )!
  !b.send(7)!
  second = task.select(
    (!a).on_recv(|v| (v ?? 0) + 100),
    (!b).on_recv(?g),
  )!
  print(first, second + 1000)

test "chan select arms that capture", seeds: 20, "12 8 1011"
  # The select makes every arm, then runs the one it commits: each arm's
  # closure environment lives until the select returns.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  c = *Chan[Int](1)
  k = 7
  s = String("abc")
  !a.send(5)!
  first = task.select((!a).on_recv(|+k, v| k + (v ?? 0)))!
  !b.send(5)!
  second = task.select(
    (!a).on_recv(|?s, v| s.len),
    (!b).on_recv(|?s, v| s.len + (v ?? 0)),
  )!
  !b.send(7)!
  !c.send(1)!
  big = 1000
  third = task.select(
    (!a).on_recv(|v| v ?? 0),
    (!b).on_recv(|?s, +big, +c, v|
      inner = task.select((!c).on_recv(|+big, w| big + (w ?? 0))) catch -1
      inner + s.len + (v ?? 0)
    ),
  )!
  print(first, second, third)

test "chan select arm fails after a send arm's value", seeds: 20, "2 -1"
  # A later arm that fails drops the value an earlier send arm holds.
  error Bad
    no

  fun mk(n: Int) -> Int!Bad
    if n < 0
      return Bad.no
    n

  fun run(n: Int) -> Int!
    a = *Chan[String](1)
    b = *Chan[Int](1)
    !a.send(String("full"))!
    task.select(
      (!a).on_send(String("lost"), || 1),
      (!b).on_send(mk(n)!, || 2),
    )!

  print(run(3) catch -1, run(-1) catch -1)

test "chan select makes its arms in order", seeds: 20, '''
  self 1
  arg 1
  self 2
  self 3
  arg 3
  1
  5 1
'''
  # Each arm's channel is evaluated in the arm's turn, before its
  # arguments and before any later arm's: a later arm that changes an
  # index does not change the channel an earlier arm waits on.
  fun at(tag: ?String, n: Int) -> Int
    print(tag)
    n

  fun bump(i: !Int) -> Int
    i += 1
    0

  chs = List[*Chan[Int]]()
  for 0..3
    !chs.push(*Chan[Int](4))
  s = String("a String long enough to be held on the heap")
  x = task.select(
    (!chs[at("self 1", 0)]).on_send(at("arg 1", 5), || 1),
    (!chs[at("self 2", 1)]).on_recv(|?s, v| s.len),
    (!chs[at("self 3", 2)]).on_send(at("arg 3", 5), || 3),
  )!
  print(x)
  for 0..4
    !chs[1].send(7)!
  i = 0
  y = task.select(
    (!chs[i]).on_recv(|?s, v| v ?? -1),
    (!chs[1]).on_send(bump(!i), || 100),
  )!
  print(y, i)

fail "chan select arm views what another arm moves", "10:17: cannot move `s` while a read loan is live", errors: 1
  # Every arm is made before the select runs one: the first arm's view
  # of `s` lives while the second takes `s`.
  a = *Chan[Int](1)
  b = *Chan[String](1)
  !a.send(7)!
  !b.send(String("full"))!
  s = String("a String long enough to be held on the heap")
  x = task.select(
    (!a).on_recv(|?s, v| s.len + (v ?? 0)),
    (!b).on_send(<s, || 0),
  )!
  print(x)

fail "chan select arms lend to write", "12:18: cannot lend `n` to write while a write loan is live: `task.select` makes every arm before it runs one, so two arms cannot each hold `n` to write; let one arm write it, or have each arm give a value and write `n` after the select", errors: 1
  # Only one arm runs, but every arm's closure is made before the select
  # runs one, so two write captures of `n` would live at once (CORE §4).
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  n = 0
  x = task.select(
    (!a).on_recv(|!n, v|
      n += 1
      n
    ),
    (!b).on_recv(|!n, v|
      n += 2
      n
    ),
  )!
  print(x, n)

test "chan select arms give values", "2 2", seeds: 20
  # The rewrite the error above names: each arm gives a value, and `n`
  # is written after the select.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  n = 0
  x = task.select(
    (!a).on_recv(|v| 1),
    (!b).on_recv(|v| 2),
  )!
  n += x
  print(x, n)

test "chan select arms join their types", seeds: 20, '''
  7 7
  Worse.no
'''
  # Every arm gives the same type: one that can fail and one that cannot
  # join as one that can, in either order, and two sets as any error.
  error Bad
    no

  error Worse
    no

  fun chk(n: Int) -> Int!
    if n < 0
      return Bad.no
    n

  fun worse(n: Int) -> Int!Worse
    if n < 0
      return Worse.no
    n

  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  first = task.select(
    (!a).on_recv(|v| v ?? 0),
    (!b).on_recv(|v| chk(v ?? 0)!),
  )!
  !b.send(7)!
  second = task.select(
    (!b).on_recv(|v| chk(v ?? 0)!),
    (!a).on_recv(|v| v ?? 0),
  )!
  print(first, second)
  !b.send(-1)!
  third = task.select(
    (!a).on_recv(|v| chk(v ?? 0)!),
    (!b).on_recv(|v| worse(v ?? 0)!),
  ) catch |e|
    print(e)
    0
  _ = third

test "chan select arm that panics joins nothing", seeds: 20, "7"
  # An arm that never returns gives no value, so it decides no type, in
  # either order.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  x = task.select(
    (!a).on_recv(|v| panic("no")),
    (!b).on_recv(|v| v ?? 0),
  )!
  print(x)

test "chan deadline and cancel", seeds: 20, '''
  -9
  Stop.canceled
'''
  # A receive with nothing to take is a fallible waiting point.
  use std.time

  fun wait_for(ch: *Chan[Int]) -> Int!
    (!ch).recv()! ?? -1

  a = *Chan[Int](1)
  n = time.within(ms: 5, |+a| (!a).recv()! ?? -1) catch -9
  print(n)
  t = wait_for(+a)&
  time.sleep(ms: 1)!
  r = <t.cancel() catch |e|
    print(e)
    -1
  _ = r

