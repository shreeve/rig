test "chan select named in a generic", seeds: 20, "7 none"
  # A receive arm of a `T` carries a `T?`, in a generic body as anywhere.
  fun first[T](a: *Chan[T], b: *Chan[T]) -> T?!
    match task.select(x: !a.on_recv(), y: !b.on_recv())!
      .x(v) => v
      .y(v) => v

  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !a.send(7)!
  x = first(+a, +b)! ?? -1
  !b.close()
  !a.close()
  print(x, "none" if first(+a, +b)! == none else "value")

