# concurrency: tests whose names start `chan`.
use std.task

test "chan producer and consumer", seeds: 20, "499500"
  # A bounded channel carries values from one task to another; closing
  # it ends the receiver's loop once it has drained what was sent.
  sub produce(ch: *Chan[Int], n: Int)!
    for i in 0..n
      !ch.send(i)!
    !ch.close()

  fun consume(ch: *Chan[Int]) -> Int!
    sum = 0
    while true
      v = (!ch).recv()! ?? -1
      if v < 0
        break
      sum += v
    sum

  ch = *Chan[Int](4)
  p = produce(+ch, 1000)&
  c = consume(+ch)&
  >p!
  print(>c!)

test "chan many senders", seeds: 20, "8000 8"
  # Senders on several tasks share one channel through handles of their
  # own; every value arrives once.
  sub produce(ch: *Chan[Int], n: Int)!
    for 0..n
      !ch.send(1)!

  ch = *Chan[Int](16)
  ts = Tasks[Void!]()
  for 0..8
    !ts.add(produce(+ch, 1000)&)
  sum = 0
  for 0..8000
    sum += (!ch).recv()! ?? 0
  n = ts.len
  >ts!
  print(sum, n)

test "chan select", seeds: 20, '''
  207
  sent 1
  hello
  none
'''
  # `task.select` commits exactly one arm: the receive that can complete,
  # or a send; a send that loses drops its value, and a closed channel
  # gives none.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  got = task.select(
    (!a).on_recv(|v| (v ?? 0) + 100),
    (!b).on_recv(|v| (v ?? 0) + 200),
  )!
  print(got)
  full = *Chan[String](1)
  !full.send(String("hello"))!
  sent = task.select(
    (!full).on_send(String("lost"), || 0),
    (!a).on_send(5, || 1),
  )!
  print("sent", sent)
  print((!full).recv()! ?? String("none"))
  !b.close()
  closed = task.select((!b).on_recv(|v| "none" if v == none else "value"))!
  print(closed)

test "chan select a closure's view in any arm", seeds: 20, "1007 2007"
  # An arm runs on the task that selects, so a closure's view goes to
  # any arm, the first as well as the rest.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  k = 1000
  g = |?k, v: Int?| (v ?? 0) + k
  !b.send(7)!
  first = task.select(
    (!b).on_recv(?g),
    (!a).on_recv(|v| (v ?? 0) + 100),
  )!
  !b.send(7)!
  second = task.select(
    (!a).on_recv(|v| (v ?? 0) + 100),
    (!b).on_recv(?g),
  )!
  print(first, second + 1000)

test "chan select arms join their types", seeds: 20, '''
  7 7
  Worse.no
'''
  # Every arm gives the same type: one that can fail and one that cannot
  # join as one that can, in either order, and two sets as any error.
  error Bad
    no

  error Worse
    no

  fun chk(n: Int) -> Int!
    if n < 0
      return Bad.no
    n

  fun worse(n: Int) -> Int!Worse
    if n < 0
      return Worse.no
    n

  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  first = task.select(
    (!a).on_recv(|v| v ?? 0),
    (!b).on_recv(|v| chk(v ?? 0)!),
  )!
  !b.send(7)!
  second = task.select(
    (!b).on_recv(|v| chk(v ?? 0)!),
    (!a).on_recv(|v| v ?? 0),
  )!
  print(first, second)
  !b.send(-1)!
  third = task.select(
    (!a).on_recv(|v| chk(v ?? 0)!),
    (!b).on_recv(|v| worse(v ?? 0)!),
  ) catch |e|
    print(e)
    0
  _ = third

test "chan select arm that panics joins nothing", seeds: 20, "7"
  # An arm that never returns gives no value, so it decides no type, in
  # either order.
  a = *Chan[Int](1)
  b = *Chan[Int](1)
  !b.send(7)!
  x = task.select(
    (!a).on_recv(|v| panic("no")),
    (!b).on_recv(|v| v ?? 0),
  )!
  print(x)

test "chan deadline and cancel", seeds: 20, '''
  -9
  Stop.canceled
'''
  # A receive with nothing to take is a fallible waiting point.
  use std.time

  fun wait_for(ch: *Chan[Int]) -> Int!
    (!ch).recv()! ?? -1

  a = *Chan[Int](1)
  n = time.within(5 * time.MS, |+a| (!a).recv()! ?? -1) catch -9
  print(n)
  t = wait_for(+a)&
  time.sleep(time.MS)!
  r = <t.cancel() catch |e|
    print(e)
    -1
  _ = r

bomb "chan send closed", seeds: 20, "send on a closed channel", prints: "before"
  a = *Chan[Int](1)
  !a.close()
  print("before")
  !a.send(1) catch print("never")

fail "chan only behind a handle", "a channel lives only behind a shared handle: write `*Chan[T](n)`"
  c = Chan[Int](4)

fail "chan holds no view", "a channel's values hold no loan, and a `?String` may hold a view"
  c = *Chan[?String](4)

fail "chan arm outside select", "`on_recv` makes an arm of `task.select`, and stands only as one of its arguments: `task.select((!c).on_recv(...), ...)`", errors: 1
  c = *Chan[Int](1)
  _ = (!c).on_recv(|v| v)

fail "chan receive marked", "method `recv` needs `self` lent to write; write `!c.recv()`: a channel changes as it sends and receives, and a change through a shared handle is marked with `!`", errors: 1
  c = *Chan[Int](1)
  !c.send(3) catch print("closed")
  v = c.recv() catch none
  print(v ?? 0)

fail "chan select arm marked", "an arm receives or sends, which changes the channel: mark it, `(!c).on_recv(...)`"
  fun pick(c: *Chan[Int]) -> Int!
    task.select(c.on_recv(|v| v ?? 0))!

  _ = pick(*Chan[Int](1))

test "chan made in a variant payload", seeds: 20, "7"
  # `*Chan[T](n)` made in the call that builds a variant is the
  # payload's value.
  enum Link
    ch(c: *Chan[Int])
    null

  sub run()!
    l = Link.ch(c: *Chan[Int](2))
    match !l
      .ch(c: c)
        !c.send(7)!
        print((!c).recv()! ?? -1)
      .null => print("null")

  run() catch print("failed")

test "chan send on a closed channel panics, and the channel goes on", seeds: 20, timeout: 10, '''
  -9
  1
  -1
'''
  # The send's panic leaves the channel as it was: an isolate stops it,
  # and the values sent before still come out.
  use std.task

  fun bad(ch: *Chan[Int]) -> Int!
    !ch.send(2)!
    0

  ch = *Chan[Int](4)
  !ch.send(1)!
  !ch.close()
  print(task.isolate(|+ch| bad(+ch)!) catch -9)
  print((!ch).recv()! ?? -1)
  print((!ch).recv()! ?? -1)

test "chan close with a sender waiting panics in the sender", seeds: 20, timeout: 10, '''
  -9
  1
  -1
'''
  # A sender waiting on a full channel that closes panics in its own
  # task, as a later send does; the closer goes on.
  use std.task
  use std.time

  fun fill(ch: *Chan[Int]) -> Int!
    !ch.send(2)!
    0

  ch = *Chan[Int](1)
  !ch.send(1)!
  r = task.isolate(|+ch|
    t = fill(+ch)&
    time.sleep(5 * time.MS)!
    !ch.close()
    >t!
  ) catch -9
  print(r)
  print((!ch).recv()! ?? -1)
  print((!ch).recv()! ?? -1)
