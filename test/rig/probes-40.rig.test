test "t-m1", '''
  0 2 1
  [7, 1, 2]
  Q(a: P(x: 1, y: 2), b: 0) P(x: 2, y: 2)
  [] []
'''
  obj P
    x: Int
    y: Int

  obj S
    a: List[Int]
    b: Int

    fun count(?@, n: Int) -> Int
      @a.len + n

    sub add(!@, n: Int)
      !@a.push(n)

  fun grow(v: !List[Int]) -> Int
    !v.push(7)
    2

  fun bump(p: !P) -> Int
    p.x += 1
    0

  obj Q
    a: P
    b: Int

  s = S(a: List(), b: 1)
  print(s.count(0), grow(!s.a), s.count(0))
  !s.add(s.count(0))
  !s.add(s.a.len)
  print(s.a)
  p = P(x: 1, y: 2)
  q = Q(a: p, b: bump(!p))
  print(q, p)
  o: List[Int]? = List()
  print(o, o)

fail "t-m2", "cannot lend `s.a` to write while a read loan on `s` is live"
  obj S
    a: List[Int]
    b: Int

    fun count(?@, n: Int) -> Int
      @a.len + n

  fun grow(v: !List[Int]) -> Int
    !v.push(7)
    2

  fun grows(s: !S) -> Int
    !s.a.push(7)
    2

  fun growo(o: !List[Int]?) -> Int
    o = none
    2

  s = S(a: List(), b: 1)
  print(s.count(grow(!s.a)))
  print(s.count(grows(!s)))
  !s.a.push(grow(!s.a))
  o: List[Int]? = List()
  print(o, growo(!o))

fail "t-mv1", "cannot move out of `v[0]`: it copies, so `<` would leave it as it was; remove the `<` to copy it"
  sub eat(c: ?String)
    print(c)

  v: List[?String] = List()
  !v.push("a")
  eat(<v[0])

  # oracle: main reject C3

fail "t-mv2", "cannot move out of `v[0]`: it copies, so `<` would leave it as it was; remove the `<` to copy it"
  sub eat(c: Int)
    print(c)

  v: List[Int] = List()
  !v.push(1)
  eat(<v[0])

  # oracle: main reject C3

fail "t-mv3", "cannot move out of `v[0]`: elements cannot be moved out of their container"
  sub eat(c: *Cell[Int])
    print(c.get())

  c1: *Cell[Int] = *Cell(7)
  v: List[*Cell[Int]] = List()
  !v.push(<c1)
  x = <v[0]
  eat(<x)
