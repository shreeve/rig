test "syntax-review-designer-p21 expr", "3"
  enum Expr
    num(v: Int)
    add(l: ^Expr, r: ^Expr)

  fun eval(e: ?Expr) -> Int
    match e
      .num(v) => v
      .add(l, r) => eval(?l) + eval(?r)

  e: Expr = .add(l: ^Expr.num(1), r: ^Expr.num(2))
  print(eval(?e))

