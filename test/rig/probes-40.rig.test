test "syntax-review-readability-closures", '''
  clicked 2
  clicked 3
  ok 5
  2
  171
  5
'''
  obj Button
    label: ?String
    handlers: List[*sub(Int)]

    sub on_click(!@, h: *sub(Int))
      !@handlers.push(<h)

    sub click(?@, times: Int)
      for h in ?@handlers
        h(times)

  fun count_if(xs: []Int, keep: ?fun(Int) -> Bool) -> Int
    n = 0
    for x in xs
      n += 1 if keep(x)
    n

  fun sum_by(xs: []Int, f: ?fun(Int) -> Int) -> Int
    total = 0
    for x in xs
      total += f(x)
    total

  clicks: *Cell[Int] = *Cell(value: 0)
  b = Button(label: "ok", handlers: List())
  !b.on_click(*|+clicks, n| !clicks.set(clicks.get() + n))
  !b.on_click(*|n| print("clicked", n))
  b.click(2)
  b.click(3)
  print(b.label, clicks.get())

  xs = [3, 8, 1, 9, 4]
  limit = 4
  print(count_if(?xs, |+limit, x| x > limit))
  print(sum_by(?xs, |x| x * x))
  seen = 0
  _ = sum_by(?xs, |!seen, x|
    seen += 1
    x
  )
  print(seen)

test "syntax-review-readability-list", '''
  5 15
  15
  14
  13
  12
  11
  15 4
'''
  obj Node
    value: Int
    next: ^Node?

  obj Chain
    head: ^Node? = none
    len: Int = 0

    sub push(!@, v: Int)
      @head = ^Node(value: v, next: <@head)
      @len += 1

    fun pop(!@) -> Int?
      if <@head as n
        @head = <n.next
        @len -= 1
        return n.value
      none

    fun sum(?@) -> Int
      total = 0
      cur = ?@head
      while cur as n
        total += n.value
        cur = ?n.next
      total

    sub each(?@, f: ?sub(Int))
      cur = ?@head
      while cur as n
        f(n.value)
        cur = ?n.next

    sub bump_all(!@, by: Int)
      bump(!@head, by)

  sub bump(slot: !^Node?, by: Int)
    if !slot as n
      n.value += by
      bump(!n.next, by)

  l = Chain()
  for v in 1..6
    !l.push(v)
  print(l.len, l.sum())
  !l.bump_all(10)
  l.each(|x| print(x))
  print((!l).pop() ?? 0, l.len)

