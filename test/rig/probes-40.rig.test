test "syntax-review-designer-p16 view iter", '''
  1
  2
  3
  4
'''
  obj Bag
    items: [4]Int

  obj Iter
    bag: ?Bag
    i: Int

    fun next(!@) -> Int?
      if @i >= 4
        return none
      @i += 1
      @bag.items[@i - 1]

  fun iter(b: ?Bag) -> Iter
    Iter(bag: b, i: 0)

  b = Bag(items: [1, 2, 3, 4])
  it = iter(?b)
  while (!it).next() as x
    print(x)

