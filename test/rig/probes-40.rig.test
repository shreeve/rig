test "syntax-review-ux-py8b", "[72, 69, 76, 76, 79, 44, 32, 82, 73, 71]"
  fun upper(s: ?String) -> List[U8]
    out: List[U8] = List()
    for b in s
      if b >= 97 and b <= 122
        !out.push(b - 32)
      else
        !out.push(b)
    out

  u = upper("hello, rig")
  print(u)

test "syntax-review-ux-py8c", '''
  after
  end
  HELLO, RIG
  HEL
'''
  extern fun putchar(c: I32) -> I32

  sub puts(bytes: []U8)
    for b in bytes
      raw
        _ = putchar(I32(b))
    raw
      _ = putchar(10)

  fun upper(s: ?String) -> List[U8]
    out: List[U8] = List()
    for b in s
      !out.push(b - 32 if b >= 97 and b <= 122 else b)
    out

  u = upper("hello, rig")
  puts(?u[..])
  print("after")
  puts(?u[..3])
  print("end")

test "syntax-review-ux-py9", "count 0 sum 0 max 0"
  extern fun getchar() -> I32

  error InputError
    bad_number

  fun read_line(buf: !List[U8]) -> Bool
    !buf.clear()
    while true
      c: I32 = 0
      raw
        c = getchar()
      return buf.len > 0 if c < 0
      return true if c == 10
      !buf.push(U8(c))

  fun parse(line: []U8) -> Int!
    n = 0
    for b in line
      return InputError.bad_number if b < 48 or b > 57
      n = n * 10 + Int(b - 48)
    n

  line: List[U8] = List()
  total = 0
  count = 0
  biggest: Int? = none
  while read_line(!line)
    n = parse(?line[..]) catch |e|
      print("skipping bad line:", e)
      continue
    total += n
    count += 1
    biggest = n if n > (biggest ?? n - 1) else biggest
  print("count", count, "sum", total, "max", biggest ?? 0)
  print("avg", Float(total) / Float(count)) if count > 0

test "syntax-review-ux-rs1", '''
  20
  -1
'''
  # Rust dev: a tiny expression evaluator with errors
  enum Token
    num(v: Int)
    plus
    minus
    star

  error EvalError
    unexpected
    trailing_op

  fun apply(op: ?Token, a: Int, b: Int) -> Int!
    match op
      .plus => a + b
      .minus => a - b
      .star => a * b
      .num(_) => return EvalError.unexpected

  fun eval(toks: ?List[Token]) -> Int!
    acc = 0
    pending: Token? = none
    first = true
    for t in toks
      match t
        .num(v)
          if first
            acc = v
            first = false
          else if pending as op
            acc = apply(?op, acc, v)!
            pending = none
          else
            return EvalError.unexpected
        _ => pending = t
    return EvalError.trailing_op if pending != none
    acc

  toks: List[Token] = List()
  !toks.push(.num(2))
  !toks.push(.plus)
  !toks.push(.num(3))
  !toks.push(.star)
  !toks.push(.num(4))
  print(eval(?toks)!)
  !toks.push(.minus)
  print(eval(?toks) catch |e| -1 if e == EvalError.trailing_op else -2)

test "syntax-review-ux-rs2", '''
  [1, 4, 9, 16, 25, 36, 49, 64, 81, 100] [4, 16, 36, 64, 100] 220
  [64, 81, 100]
'''
  # generic helpers + closures, the way a Rust dev would write them
  fun map[T, U](xs: ?List[T], f: ?fun(?T) -> U) -> List[U]
    out: List[U] = List()
    for x in xs
      !out.push(f(?x))
    out

  fun filter[T](xs: ?List[T], keep: ?fun(?T) -> Bool) -> List[T]
    out: List[T] = List()
    for x in xs
      if keep(?x)
        !out.push(x)
    out

  fun fold[T, A](xs: ?List[T], init: A, f: ?fun(A, ?T) -> A) -> A
    acc = init
    for x in xs
      acc = f(acc, ?x)
    acc

  v: List[Int] = List()
  for i in 1..11
    !v.push(i)
  squares = map(?v, |x| x * x)
  evens = filter(?squares, |x| x % 2 == 0)
  total = fold(?evens, 0, |acc, x| acc + x)
  print(squares, evens, total)
  threshold = 50
  big = filter(?squares, |+threshold, x| x > threshold)
  print(big)

test "syntax-review-ux-rs4", '''
  5 10
  4 4
'''
  obj Node
    val: Int
    next: ^Node?

  obj Chain
    head: ^Node?
    len: Int = 0

    sub push(!@, v: Int)
      old = <@head
      @head = ^Node(val: v, next: <old)
      @len += 1

    fun pop(!@) -> Int?
      if <@head as b
        n = <b.unbox()
        @head = <n.next
        @len -= 1
        return n.val
      none

    fun sum(?@) -> Int
      total = 0
      cur = ?@head
      while cur as n
        total += n.val
        cur = ?n.next
      total

  l = Chain(head: none)
  for i in 0..5
    !l.push(i)
  print(l.len, l.sum())
  print((!l).pop() ?? -1, l.len)

test "syntax-review-ux-rs5", '''
  a a
  2
'''
  obj Doc
    title: ?String
    words: List[?String]

  obj View
    doc: ?Doc
    pos: Int

  fun longest(a: ?Doc, b: ?Doc) -> ?Doc
    a if a.words.len > b.words.len else b

  d1 = Doc(title: "a", words: List())
  !d1.words.push("x")
  d2 = Doc(title: "b", words: List())
  v = View(doc: ?d1, pos: 0)
  w = longest(?d1, ?d2)
  print(v.doc.title, w.title)
  !d1.words.push("y")
  print(d1.words.len)

fail "syntax-review-ux-rs5b", "cannot lend `d1.words` to write while a read loan on `d1` is live"
  obj Doc
    title: ?String
    words: List[?String]

  obj View
    doc: ?Doc
    pos: Int

  d1 = Doc(title: "a", words: List())
  v = View(doc: ?d1, pos: 0)
  !d1.words.push("y")
  print(v.doc.title)

fail "syntax-review-ux-rs5c", "a view of the temporary `make()` outlives its statement, which drops it; bind the value to a name first"
  obj Doc
    title: ?String
    words: List[?String]

  fun make() -> Doc
    Doc(title: "t", words: List())

  r = ?make()
  print(r.title)

test "syntax-review-ux-rs7", '''
  1
  free 2
  free 1
'''
  obj Job
    id: Int
    drop(!@)
      print("free", @id)

  jobs: List[*Job] = List()
  !jobs.push(*Job(id: 1))
  !jobs.push(*Job(id: 2))
  keep: List[*Job] = List()
  for j in ?jobs
    !keep.push(+j) if j.id > 1
  print(keep.len)

test "syntax-review-ux-rs8", '''
  ada ["member", "admin"]
  bob ["member"]
'''
  obj Person
    name: ?String
    tags: List[?String]

  people: List[^Person] = List()
  for n in ["ada", "bob"]
    !people.push(^Person(name: n, tags: List()))
  for p, i in !people
    !p.tags.push("member")
    !p.tags.push("admin") if i == 0
  for p in ?people
    print(p.name, p.tags)

fail "t-b", "`p` is assigned but never read; use it, or discard the value with `_ = ...`"
  # A `break` value may not lend what the loop declared: it goes out of
  # scope as the loop ends.

  obj P
    n: Int

  q = P(n: 0)
  x = for i in 0..3
    p = P(n: i)
    break ?q if i == 2
  else
    ?q
  print(x.n)

test "t-c", "7"
  # An element cannot be moved out of a List: the List still owns the slot.

  obj P
    n: Int

  sub eat(p: P)
    print(p.n)

  v: List[P] = List()
  !v.push(P(n: 7))
  eat(v[0])

fail "t-c3", "closures cannot escape their defining scope; bind the closure to a local (`f = |...| ...`) and call `f()`, or make it owned (`*|...| body`) to pass, store, or return it"
  fun make() -> fun() -> Int
    x = 1
    return |+x|
      x + 1

  f = make()
  print(f())

