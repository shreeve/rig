test "syntax-review-ux-c1b", "11831194018420276491"
  fun fnv1a(s: ?String) -> U64
    h: U64 = 0xcbf29ce484222325
    for b in s
      h ^= U64(b)
      h = h *% 0x100000001b3
    h

  print(fnv1a("hello"))

test "syntax-review-ux-c1e", "11831194018420276491"
  fun mulw(a: U64, b: U64) -> U64
    wide: U128 = U128(a) * U128(b)
    raw
      r: U64 = $truncate(wide)
      r

  fun fnv1a(s: ?String) -> U64
    h: U64 = 0xcbf29ce484222325
    for b in s
      h ^= U64(b)
      h = mulw(h, 0x100000001b3)
    h

  print(fnv1a("hello"))

test "syntax-review-ux-c2", "0 0 0"
  # count lines, words, bytes on stdin (wc), via libc getchar
  extern fun getchar() -> I32

  fun next_byte() -> I32
    raw
      getchar()

  lines = 0
  words = 0
  bytes = 0
  in_word = false
  while true
    c = next_byte()
    break if c < 0
    bytes += 1
    if c == 10
      lines += 1
    if c == 32 or c == 10 or c == 9
      in_word = false
    else if not in_word
      in_word = true
      words += 1
  print(lines, words, bytes)

test "syntax-review-ux-c3", '''
  full at 7
  full at 8
  full at 9
  0 0
  3 2
  6 2
  9 2
  12 2
  15 4
  18 2
  24
'''
  obj Ring[n: Int]
    buf: [n]U8
    head: Int = 0
    tail: Int = 0

    fun empty(?@) -> Bool
      @head == @tail

    fun push(!@, b: U8) -> Bool
      next = (@tail + 1) % n
      return false if next == @head
      @buf[@tail] = b
      @tail = next
      true

    fun pop(!@) -> U8?
      return none if @empty()
      b = @buf[@head]
      @head = (@head + 1) % n
      b

  fun popcount(x: U32) -> Int
    c = 0
    v = x
    while v != 0
      c += Int(v & 1)
      v >>= 1
    c

  r = Ring[8](buf: [8 of 0])
  for i in 0..10
    ok = (!r).push(U8(i * 3))
    print("full at", i) if not ok
  while (!r).pop() as b
    print(b, popcount(U32(b)))
  print($size(R8))

  type R8 = Ring[8]

test "syntax-review-ux-py6b", exit: 1, '''
  123
  -1
  60
  bad input: ParseError.empty
  0
'''
  error ParseError
    bad_digit
    empty

  fun parse_int(s: ?String) -> Int!
    return ParseError.empty if s.len == 0
    n = 0
    for ch in s
      if ch < "0"[0] or ch > "9"[0]
        return ParseError.bad_digit
      n = n * 10 + Int(ch - "0"[0])
    n

  fun sum_csv(line: ?String) -> Int!
    total = 0
    start = 0
    for ch, i in line
      if ch == ","[0]
        total += parse_int(line[start..i])!
        start = i + 1
    total += parse_int(line[start..])!
    total

  print(parse_int("123")!)
  print(parse_int("12x") catch -1)
  print(sum_csv("10,20,30")!)
  r = sum_csv("10,,30") catch |e|
    print("bad input:", e)
    0
  print(r)
  print(sum_csv("1,2,x")!)

