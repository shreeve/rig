test "syntax-review-designer-p34 generic eq fn", "1 none"
  obj Map[K, V]
    keys: List[K]
    vals: List[V]

    fun get(?@, k: K) -> V?
      for key, i in @keys
        if key == k
          return @vals[i]
      none

    sub put(!@, k: K, v: V)
      !@keys.push(k)
      !@vals.push(v)

  m = Map[?String, Int](keys: List(), vals: List())
  !m.put("a", 1)
  print(m.get("a"), m.get("b"))

