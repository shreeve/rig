  print(x.n)

test "r3-s45-c-c01", '''
  1 2
  x x
  n [3] n! [3, 4] 5 ob
  [["q"]] [["qz"]] ["q"]
  3
  ["a1", "a2"]
  [1]
'''
  obj H
    name: String
    tags: List[Int]
    h: *Int
    o: ^String?

  enum E
    a(t: String)
    b(n: Int)
    c

  v: List[Int] = List()
  !v.push(1)
  w = +v
  !w.push(2)
  print(v.len, w.len)
  b = ^String("x")
  c = +b
  print(b, c)
  h = H(name: String("n"), tags: List(), h: *5, o: ^String("ob"))
  !h.tags.push(3)
  g = +h
  !g.tags.push(4)
  !g.name.add("!")
  print(h.name, h.tags, g.name, g.tags, g.h, g.o)
  vs: List[List[String]] = List()
  row: List[String] = List()
  !row.push(String("q"))
  !vs.push(<row)
  ws = +vs
  !ws[0][0].add("z")
  print(vs, ws, +vs[0])
  es: List[E] = List()
  !es.push(E.a(t: String("ea")))
  !es.push(E.b(n: 2))
  !es.push(.c)
  fs = +es
  print(fs.len)
  arr = [String("a1"), String("a2")]
  arr2 = +arr
  print(arr2)
  r = ?v
  print(+r)

test "r3-s45-c-c04 recursive", "3 3"
  enum Tree
    leaf(n: Int)
    node(l: ^Tree, r: ^Tree)

  fun sum(t: ?Tree) -> Int
    match t
      .leaf(n) => n
      .node(l, r) => sum(l) + sum(r)

  t = Tree.node(l: ^Tree.leaf(n: 1), r: ^Tree.leaf(n: 2))
  u = +t
  print(sum(?t), sum(?u))

