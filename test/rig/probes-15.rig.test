test "r3-step2-r09 read recv mixed", '''
  2
  1
  2
'''
  obj Bag
    items: List[Int]

    fun total(?@) -> Int
      @items.len

  fun mk() -> Bag
    b = Bag(items: List())
    !b.items.push(7)
    b

  a = Bag(items: List())
  !a.items.push(1)
  !a.items.push(2)
  for i in 0..2
    c = i == 0
    print((a if c else mk()).total())
  print(a.items[1])

test "r3-step2-r10 read recv mixed index", '''
  1
  7
  2
'''
  obj Bag
    items: List[Int]

    fun at(?@, i: Int) -> Int
      @items[i]

  fun mk() -> Bag
    b = Bag(items: List())
    !b.items.push(7)
    b

  a = Bag(items: List())
  !a.items.push(1)
  !a.items.push(2)
  v = [0, 1]
  for i in 0..2
    c = i == 0
    print((a if c else mk()).at(v[0]))
  print(a.items[1])

test "r3-step2-r12 read recv catch owner", '''
  1
  0
  4
'''
  error E
    bad

  obj Bag
    items: List[Int]

    fun total(?@) -> Int
      @items.len

  fun mk(ok: Bool) -> Bag!
    if not ok
      return E.bad
    Bag(items: List())

  d = Bag(items: List())
  !d.items.push(4)
  print((mk(false) catch d).total())
  print((mk(true) catch d).total())
  print(d.items[0])

fail "r3-step2-s01 discard ternary owners", "`a` owns a `List[Int]`, which can't be copied by `=`: write `<a` to move it, `+a` to clone it, or `?a` to view it"
  a: List[Int] = List()
  b: List[Int] = List()
  !a.push(1)
  c = true
  _ = a if c else b
  print(a[0])

fail "r3-step2-s02 discard catch owner", "`d` owns a `List[Int]`, which can't be copied by `=`: write `<d` to move it, `+d` to clone it, or `?d` to view it"
  error E
    bad

  fun mk(ok: Bool) -> List[Int]!
    if not ok
      return E.bad
    List()

  d: List[Int] = List()
  !d.push(1)
  _ = mk(false) catch d
  print(d[0])

fail "r3-step2-s03 discard name", "`a` owns a `List[Int]`, which can't be copied by `=`: write `<a` to move it, `+a` to clone it, or `?a` to view it"
  a: List[Int] = List()
  !a.push(1)
  _ = a
  print(a[0])

fail "r3-step2-x02 catch handler break stores", "`i` is bound but never read; name it `_` to ignore the value"
  error E
    bad

  fun mk(ok: Bool) -> Int!
    if not ok
      return E.bad
    1

  obj H
    r: ?List[Int]

  z: List[Int] = List()
  h = H(r: ?z)
  for i in 0..2
    n = mk(false) catch |_|
      inner: List[Int] = List()
      !inner.push(9)
      h.r = ?inner
      break
    print(n)
  print(h.r[0])

test "r3-step2-x04 labeled match guard stores", "0"
  obj H
    r: ?List[Int]

  fun store(h: !H, r: ?List[Int]) -> Bool keeps r
    h.r = r
    false

  z: List[Int] = List()
  h = H(r: ?z)
  k = 3
  $m: match k
    3 if store(!h, ?z) => break $m
    _ => pass
  print(h.r.len)

test "rb-t", '''
  6
  1
'''
  fun total(xs: ?[3]Int) -> Int
    xs[0] + xs[1] + xs[2]

  a = [1, 2, 3]
  print(total(?a))
  b = ?a
  print(b[0])

