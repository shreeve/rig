test "r3-s45-b-b01", '''
  drop 0
  1
  drop 1
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  i = 0
  x = while i < 3
    r = R(n: i)
    i += 1
    if i == 2
      break r
  else
    R(n: 99)
  print(x.n)

test "r3-s45-b-b02", '''
  drop 2
  1
  drop 1
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  v: List[R] = List()
  !v.push(R(n: 1))
  !v.push(R(n: 2))
  x = for r in <v
    break r if r.n == 1
  else
    R(n: 0)
  print(x.n)

fail "r3-s45-b-b03", "use of `r` after move"
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  i = 0
  x = while i < 3
    r = R(n: i)
    defer print("defer", r.n)
    i += 1
    if i == 2
      break r
  else
    R(n: 99)
  print(x.n)

test "r3-s45-b-b04", '''
