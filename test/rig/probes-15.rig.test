test "rev193-utf8-counts-fuzz", "14800 0"
  # Review of #193 (std.utf8's block counting): random strings of valid
  # and invalid UTF-8 and random bytes, up to 200 long, and every length 0
  # to 200 of each piece repeated, so a sequence is cut at every block
  # end. Each compares `rune_count`, `utf16.unit_count`, `is_valid`, and
  # `ascii_end` at every cursor with a reference read rune by rune, and
  # checks that `byte_index` inverts `unit_count` at every rune start.

  obj Gen
    x: Int

  fun next(g: !Gen) -> Int
    g.x = (g.x *% 6364136223846793005 +% 1442695040888963407)
    (g.x >> 33) & 0x7FFFFFFF

  fun reference(s: ?String, wide: Bool) -> Int
    n = 0
    i = 0
    while i < s.len
      d = utf8.rune_after(s, i)
      n += 2 if wide and d.size == 4 else 1
      i += d.size
    n

  fun ref_valid(s: ?String) -> Bool
    i = 0
    while i < s.len
      d = utf8.rune_after(s, i)
      return false if d.size == 1 and s[i] >= 0x80
      i += d.size
    true

  fun ref_end(s: ?String, i: Int) -> Int
    j = i
    while j < s.len and s[j] < 0x80
      j += 1
    j

  PIECES = ["\xc3\xa9", "\xe4\xb8\xad", "\xf0\x9f\x98\x80", "\xed\x9f\xbf", "\xee\x80\x80", "\xf4\x8f\xbf\xbf", "\x80", "\xbf", "\xc0\x80", "\xc1\xbf", "\xe0\x9f\xbf", "\xed\xa0\x80", "\xed\xbf\xbf", "\xf0\x8f\xbf\xbf", "\xf4\x90\x80\x80", "\xf5\x80\x80\x80", "\xfe", "\xff", "\xe0", "\xf0\x9f", "\xf0\x9f\x98", "\xc3"]

  sub check(s: ?String, bad: !Int)
    r = reference(s, false)
    u = reference(s, true)
    if utf8.rune_count(s) != r or utf16.unit_count(s) != u
      bad += 1
      print("COUNT", s.len, utf8.rune_count(s), r, utf16.unit_count(s), u)
    if utf8.is_valid(s) != ref_valid(s)
      bad += 1
      print("VALID", s.len)
    for i in 0..s.len + 1
      if utf8.ascii_end(s, i) != ref_end(s, i)
        bad += 1
        print("END", s.len, i, utf8.ascii_end(s, i), ref_end(s, i))
    # byte_index inverts unit_count at every rune start
    i = 0
    while i < s.len
      k = utf16.unit_count(s[..i])
      if utf16.byte_index(s, k) != i
        bad += 1
        print("BYTEINDEX", s.len, i, utf16.byte_index(s, k))
      i += utf8.rune_after(s, i).size

  sub main()
    g = Gen(x: 193)
    bad = 0
    total = 0
    t = String()
    for _ in 0..6000
      !t.clear()
      len = next(!g) % 200
      mode = next(!g) % 4
      while t.len < len
        k = next(!g) % 100
        if mode == 0
          !t.push(U8(next(!g) % 256))
        else if k < 60 + mode * 10
          !t.push(U8(0x20 + next(!g) % 90))
        else
          !t.add(PIECES[next(!g) % PIECES.len])
      check(t, !bad)
      total += 1
    # every exact length 0..200 of each piece pattern, ending cut
    for p in PIECES
      for len in 0..200
        !t.clear()
        while t.len < len
          !t.add(p)
        check(t, !bad)
        check(t[..len], !bad)
        total += 2
    print(total, bad)

fail "rev203-b01b closure dropped", "cannot drop `h` while it is lent"
  obj S
    text: ?String
    value: String

  obj H
    s: S

  src = String("abc")
  h = H(s: S(text: ?src, value: String()))
  f = |!h| swap(!h.s, S(text: "", value: String()))
  t = f()
  <f
  <h
  <src
  print(t.text)

fail "rev203-c02 view local in block", "cannot drop `src` while it is lent"
  obj S
    text: ?String
    value: String

  obj H
    s: S

  src = String("abc")
  h = H(s: S(text: ?src, value: String()))
  out: List[S] = List()
  if src.len > 0
    w = !h.s
    !out.push(swap(!w, S(text: "", value: String())))
  <src
  print(out[0].text)

test "rev203-e09 failing guard between", '''
  got 1
  h 10
  drop 1
  drop 10
  got 99
  h 11
  drop 99
  drop 11
  got 99
  h 12
  drop 99
  drop 12
'''
  error Bad
    no

  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  obj Hd
    d: D

  fun chk(x: Int) -> Int!
    return Bad.no if x > 1
    x

  fun go(h: !Hd, x: Int) -> D!
    t = swap(!h.d, D(n: 10 + x))
    _ = chk(x)!
    return Bad.no if x == 1
    t

  h = Hd(d: D(n: 1))
  for i in 0..3
    r = go(!h, i) catch D(n: 99)
    print("got", r.n)
    print("h", h.d.n)

fail "rev203-e10 loop break continue", "`tmp` does not live long enough"
  obj S
    text: ?String
    value: String

  obj H
    s: S

  out: List[S] = List()
  keep = String("k")
  for i in 0..4
    tmp = String("t", i)
    s = S(text: ?keep, value: String())
    s.text = ?tmp if i == 1
    continue if i == 2
    t = swap(!s, S(text: "", value: String()))
    break if i == 3
    !out.push(<t)
  print(out[0].text)

test "rev203-f06 closure writes h while t", "abc v n"
  obj S
    text: ?String
    value: String

  obj H
    s: S

  src = String("abc")
  h = H(s: S(text: ?src, value: String("v")))
  f = |!h| swap(!h.s, S(text: "", value: String("n")))
  t = f()
  u = f()
  print(t.text, t.value, u.value)

fail "rev203-h04 put back then drop viewed", "cannot drop `src` while it is lent"
  obj S
    text: ?String
    value: String

  obj H
    s: S

  src = String("abc")
  src2 = String("def")
  h = H(s: S(text: ?src, value: String()))
  w = !h.s
  t = swap(!w, S(text: ?src2, value: String()))
  _ = swap(!w, <t)
  <src
  print(h.s.text)

fail "rev203-h06 swap after take", "cannot drop `src` while it is lent"
  obj S
    text: ?String
    value: String

  obj H
    s: S

  src = String("abc")
  h = H(s: S(text: ?src, value: String()))
  t = swap(!h.s, S(text: "", value: String()))
  h = H(s: S(text: "", value: String()))
  <src
  print(t.text)

test "rev203-j01 closure take twice in fn", '''
  v n
  abc v n
'''
  # A closure that captures `h` to write and hands back what `replace`
  # takes from it: each result views `src`, never `h`, so `f` may be
  # called again while it lives. Production accepts; the oracle rejects
  # (C6, "a view of `h` ... leaves each call").
  obj S
    text: ?String
    value: String

  obj H
    s: S

  fun useh(h: !H) -> S
    f = |!h| swap(!h.s, S(text: "", value: String("n")))
    a = f()
    b = f()
    print(a.value, b.value)
    <a

  src = String("abc")
  h = H(s: S(text: ?src, value: String("v")))
  t = useh(!h)
  print(t.text, t.value, h.s.value)

fail "rev206-b09 chain", "cannot lend `b.xs` to write while a read loan on `b` is live"
  obj C2
    xs: ?List[Int]
    i: Int

    fun next(!@) -> Int?
      return none if @i >= @xs.len
      @i += 1
      @xs[@i - 1]

    fun skip1(<@) -> C2 from @
      C2(xs: @xs, i: @i + 1)

  obj CBag
    xs: List[Int]

    fun each(?@) -> C2 from @
      C2(xs: ?@xs, i: 0)

  b = CBag(xs: List())
  for _ in 0..3
    !b.xs.push(1)
  for x in ?b.each().skip1()
    for _ in 0..100
      !b.xs.push(x)

fail "rev206-d08 defer slice cond only", "cannot lend `v` to write while a read loan is live"
  obj SCur
    xs: []Int
    i: Int

    fun next(!@) -> Int?
      return none if @i >= @xs.len
      @i += 1
      @xs[@i - 1]

  fun smk(v: ?List[Int]) -> SCur from v
    SCur(xs: ?v[0..v.len], i: 0)

  sub grow(v: !List[Int])
    for _ in 0..100
      !v.push(1)

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  s = ?v[0..2]
  i = 0
  while s[i] > 0 : i += 1
    defer grow(!v)
    print(i)
    break if i == 1

fail "rev206-f01 fallible each", "cannot lend `b.xs` to write while a read loan on `b` is live"
  obj Cur
    xs: ?List[Int]
    i: Int

    fun next(!@) -> Int?
      return none if @i >= @xs.len
      @i += 1
      @xs[@i - 1]

  fun mk(v: ?List[Int]) -> Cur from v
    Cur(xs: v, i: 0)

  obj Bag
    xs: List[Int]

    fun each(?@) -> Cur from @
      Cur(xs: ?@xs, i: 0)

  sub fill(v: !List[Int])
    for _ in 0..3
      !v.push(1)

  error E
    bad

  obj FB
    xs: List[Int]

    fun each(?@) -> Cur! from @
      return E.bad if @xs.len == 0
      Cur(xs: ?@xs, i: 0)

  fun go(b: !FB) -> Int!
    for x in ?b.each()!
      !b.xs.push(x)
    0

  b = FB(xs: List())
  fill(!b.xs)
  print(go(!b) catch -1)

fail "rev206-x09 lent drop break", "cannot lend `b.xs` to write while a read loan on `b` is live"
  obj Cur
    xs: ?List[Int]
    i: Int

    fun next(!@) -> Int?
      return none if @i >= @xs.len
      @i += 1
      @xs[@i - 1]

  fun mk(v: ?List[Int]) -> Cur from v
    Cur(xs: v, i: 0)

  obj Bag
    xs: List[Int]

    fun each(?@) -> Cur from @
      Cur(xs: ?@xs, i: 0)

  sub fill(v: !List[Int])
    for _ in 0..3
      !v.push(1)

  obj DCur
    xs: ?List[Int]
    i: Int

    fun next(!@) -> Int?
      return none if @i >= @xs.len
      @i += 1
      @xs[@i - 1]

    drop(!@)
      print("drop", @xs[0])

  fun dmk(v: ?List[Int]) -> DCur from v
    DCur(xs: v, i: 0)

  obj Bag2
    xs: List[Int]

    fun each(?@) -> DCur from @
      DCur(xs: ?@xs, i: 0)

  b = Bag2(xs: List())
  fill(!b.xs)
  for x in ?b.each()
    for _ in 0..100
      !b.xs.push(x)
    break

test "rev210-a05 boxfield disjoint", "id 3 4"
  # Reviewer probe for #210 (field loans): A box field lent beside writes
  # of a sibling and of the box's other field.

  obj Node
    name: String
    n: Int

  obj P
    bx: ^Node
    k: Int

  p = P(bx: ^Node(name: String("id"), n: 0), k: 0)
  r = ?p.bx.name
  p.k = 3
  p.bx.n = 4
  print(r, p.k, p.bx.n)

fail "rev210-c15 wa reads wb", "cannot store in `p.a` a view of `p.b`: a value never holds a view of itself"
  # Reviewer probe for #210 (field loans): Storing through a write view of
  # `p.a` a view of a write view of `p.b`.

  obj Holder
    t: ?String

    sub keep(!@, t: ?String) keeps t
      @t = t

  obj P
    a: Holder
    b: String
    views: List[?String]
    arr: [2]?String
    bx: ^Holder
    hs: List[Holder]

  p = P(a: Holder(t: ""), b: String("x"), views: List(), arr: ["", ""], bx: ^Holder(t: ""), hs: List())
  wa = !p.a
  wb = !p.b
  wa.t = ?wb
  !wb.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(p.a.t)

test "rev210-e03 w across backedge ok", "3 [0, 1, 2]"
  # Reviewer probe for #210 (field loans): A write view of `p.a` live
  # across a loop that pushes to `p.b`.

  obj A
    n: Int
    s: String

  obj P
    a: A
    b: List[Int]
    items: List[Int]
    name: String

  p = P(a: A(n: 0, s: String("x")), b: List(), items: List(), name: String("nm"))
  !p.items.push(1)
  !p.items.push(2)
  w = !p.a
  i = 0
  while i < 3
    w.n += 1
    !p.b.push(i)
    i += 1
  print(p.a.n, p.b)

fail "rev210-f13 read beside write arg", "cannot lend `p.a` to write while a read loan on `p.a.s` is live"
  # Reviewer probe for #210 (field loans): An argument reading `p.a.s`
  # beside a write lend of `p.a`.

  obj Holder
    t: ?String
    s: String

    sub add(!@, x: ?String)
      !@s.add(x)

    fun view(!@) -> ?String from @
      ?@s[0..1]

  obj P
    a: Holder
    b: String
    c: ?String
    q: Holder

  sub rw(s: ?String, h: !Holder)
    h.s = String("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    print(s)

  p = P(a: Holder(t: "", s: String("aa")), b: String("x"), c: "", q: Holder(t: "", s: String("qq")))
  rw(p.a.s, !p.a)
  print(p.a.s)

fail "rev210-f16 print grow same", "cannot lend `p.a` to write while an earlier argument's read of `p.a.s` is in use"
  # Reviewer probe for #210 (field loans): `print(p.a.s, grow(!p.a))`: a
  # read held while the same place is lent to write.

  obj Holder
    t: ?String
    s: String

    sub add(!@, x: ?String)
      !@s.add(x)

    fun view(!@) -> ?String from @
      ?@s[0..1]

  obj P
    a: Holder
    b: String
    c: ?String
    q: Holder

  fun grow(h: !Holder) -> Int
    !h.s.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    h.s.len

  p = P(a: Holder(t: "", s: String("aa")), b: String("x"), c: "", q: Holder(t: "", s: String("qq")))
  print(p.a.s, grow(!p.a))
  print(p.a.s)

fail "rev210-h02 match write payload selfview", "cannot store in `p.sl` a view of `p.b`: a value never holds a view of itself"
  # Reviewer probe for #210 (field loans): A `match !p.sl` payload given a
  # view of `p.b`.

  obj Holder
    t: ?String

  enum Slot
    hold(h: Holder)
    empty

  obj P
    hs: List[Holder]
    b: String
    sl: Slot
    o: Holder?

  p = P(hs: List(), b: String("x"), sl: .hold(h: Holder(t: "")), o: Holder(t: ""))
  !p.hs.push(Holder(t: ""))
  match !p.sl
    .hold(h) => h.t = ?p.b
    .empty => pass
  p.b = String("zzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(p.sl)

fail "rev210-h03 if write opt selfview", "cannot store in `p.o` a view of `p.b`: a value never holds a view of itself"
  # Reviewer probe for #210 (field loans): An `if !p.o as w` binding given
  # a view of `p.b`.

  obj Holder
    t: ?String

  enum Slot
    hold(h: Holder)
    empty

  obj P
    hs: List[Holder]
    b: String
    sl: Slot
    o: Holder?

  p = P(hs: List(), b: String("x"), sl: .hold(h: Holder(t: "")), o: Holder(t: ""))
  !p.hs.push(Holder(t: ""))
  if !p.o as w
    w.t = ?p.b
  p.b = String("zzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(p.o)

fail "rev210-i05 chain2 call", "cannot let this call store a view of `p.b` in `p.m`: a value never holds a view of itself"
  # Reviewer probe for #210 (field loans): A store through a chain of
  # write views of `p.m` of a view of `p.b`.

  obj Holder
    t: ?String

  obj Mid
    h: Holder
    k: Int

  obj P
    hs: List[Holder]
    m: Mid
    b: String

  sub set(h: !Holder, s: ?String) keeps s
    h.t = s

  p = P(hs: List(), m: Mid(h: Holder(t: ""), k: 0), b: String("x"))
  !p.hs.push(Holder(t: ""))
  w1 = !p.m
  w2 = !w1.h
  set(!w2, ?p.b)
  p.b = String("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(p.m.h.t)

fail "rev210-i06 param chain", "cannot let this call store a view of `q.b` in `q.m.h`: a value never holds a view of itself"
  # Reviewer probe for #210 (field loans): The same chain through a
  # write-view parameter.

  obj Holder
    t: ?String

  obj Mid
    h: Holder
    k: Int

  obj P
    hs: List[Holder]
    m: Mid
    b: String

  sub go(q: !P)
    w = !q.m.h
    set(!w, ?q.b)
    q.b = String("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")

  sub set(h: !Holder, s: ?String) keeps s
    h.t = s

  p = P(hs: List(), m: Mid(h: Holder(t: ""), k: 0), b: String("x"))
  !p.hs.push(Holder(t: ""))
  go(!p)
  print(p.m.h.t)
