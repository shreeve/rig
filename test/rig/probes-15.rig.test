test "r3-s45-w-e1", '''
  1 1
  [5, 6] 2 2
  [[]]
  ab 2
  ["zz"]
  y 4
  o
  [none]
'''
  obj Rec
    name: String
    n: Int

  fun size(v: ?List[Int]) -> Int
    v.len

  rows: List[List[Int]] = List()
  r: List[Int] = List()
  !r.push(5)
  !rows.push(<r)
  print(rows.len, rows[0].len)
  !rows[0].push(6)
  print(rows[0], size(?rows[0]), size(rows[0]))
  q: List[Int] = List()
  rows[0] = <q
  print(rows)
  ts: List[String] = List()
  !ts.push(String("a"))
  !ts[0].add("b")
  print(ts[0], ts[0].len)
  ts[0] = String("zz")
  print(ts)
  rs: List[Rec] = List()
  !rs.push(Rec(name: String("x"), n: 1))
  rs[0].n = 4
  rs[0].name = String("y")
  print(rs[0].name, rs[0].n)
  os: List[String?] = List()
  !os.push(String("o"))
  if <os[0] as t
    print(t)
  print(os)

