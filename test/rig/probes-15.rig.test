# Probes from past reviews and audits, 15 of 41: r3-s36-reads-x05_qtext_param_reads to rev210-i06_param_chain.

use std.utf16
use std.utf8

test "r3-s36-reads-x05 qtext param reads", "he hello"
  fun head(t: ?String) -> ?String
    t[0..2]

  fun whole(t: ?String) -> ?String
    t

  t = String("hello")
  print(head(?t), whole(?t))

fail "r3-s36-reads-x05b qtext param for", "`b` is bound but never read; name it `_` to ignore the value"
  fun loopit(t: ?String) -> Int
    n = 0
    for b in t
      n += 1
    n

  t = String("hello")
  print(loopit(?t))

