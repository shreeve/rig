  match mk().s
    .line(v) => print(v[0])
    .dot => print("dot")

fail "r3-step2-r05 consume nullish recv", "`o` owns a `Bag?`, which can't be copied into an argument: write `<o` to move it or `+o` to pass a clone"
  obj Bag
    items: List[Int]

    fun total(<@) -> Int
      @items.len

  b = Bag(items: List())
  !b.items.push(3)
  o: Bag? = <b
  d = Bag(items: List())
  print((o ?? d).total())
  if ?o as x
    print(x.items[0])

