# Masks of 32 and 64 lanes: what rig emits for a mask's bits and lanes,
# and what the kernels of test/cli/wide_masks.sh compute (it reads the
# assembly Zig writes for them on each target, from this case's program).

code "wide masks flip the bits after the reduction", "rig.maskBitsNot(rig.maskOr(", /^(?![\s\S]*rig\.maskBits\(rig\.maskNot\()/, "rig.maskAny(rig.maskNot(m))"
  # `m.not().bits()` flips the bits after the reduction (`rig.maskBitsNot`),
  # not the lanes before it, and `m.not().any()` keeps its lanes.

  type W64 = Simd[U8, 64]
  type W32 = Simd[U8, 32]

  fun nonspace64(s: ?String) -> Int
    n = 0
    i = 0
    while i + 64 <= s.len : i += 64
      v = s.read[W64](i)
      n += ((v == 0x20) | (v == 0x0A) | (v == 0x0D) | (v == 0x09)).not().bits().count_ones()
    n

  fun nonspace32(s: ?String) -> Int
    n = 0
    i = 0
    while i + 32 <= s.len : i += 32
      v = s.read[W32](i)
      n += ((v == 0x20) | (v == 0x0A)).not().bits().count_ones()
    n

  fun starts(s: ?String) -> U64
    prev: U64 = 0
    acc: U64 = 0
    i = 0
    while i + 64 <= s.len : i += 64
      v = s.read[W64](i)
      q = (v == 0x22).bits()
      bs = (v == 0x5C).bits()
      lo = v | 0x20
      op = ((lo == 0x7B) | (lo == 0x7D) | (v == 0x3A) | (v == 0x2C)).bits()
      ws = ((v == 0x20) | (v == 0x0A) | (v == 0x0D) | (v == 0x09)).bits()
      scalar = (op | ws).not()
      follows = (scalar << 1) | prev
      prev = scalar >> 63
      acc = acc ^ ((op | (scalar & follows.not())) & (q | bs).not())
    acc

  fun spaces(s: ?String) -> Int
    n = 0
    i = 0
    while i + 64 <= s.len : i += 64
      m = (s.read[W64](i) == 0x20) | (s.read[W64](i) == 0x0A)
      n += 1 if m.not().any() else 0
      n += 2 if m.not().all() else 0
    n

  fun ends(s: ?String) -> U64
    acc: U64 = 0
    i = 0
    while i + 64 <= s.len : i += 64
      m = s.read[W64](i) == 0x22
      acc = acc +% (m.bits() & 0xFF) +% (m.bits() >> 63)
    acc

  fun low(s: ?String) -> U64
    acc: U64 = 0
    i = 0
    while i + 64 <= s.len : i += 64
      acc = acc +% ((s.read[W64](i) == 0x3A).bits() & 0xFF)
    acc

  sub main()
    s = String()
    # Each block of 64 ends in a space, so `starts` shifts out no bit.
    for k in 0..1024
      !s.push(0x20 if k % 64 == 63 else U8(" \x0a{\"a\": 1, \"b\": [2, 3]}\x09\x0d:x"[k % 26]))
    print(nonspace64(?s), nonspace32(?s), starts(?s), spaces(?s), ends(?s), low(?s))

test "wide masks kernels", "699 775 1309964357605222691 16 882 410", release: true
  type W64 = Simd[U8, 64]
  type W32 = Simd[U8, 32]

  fun nonspace64(s: ?String) -> Int
    n = 0
    i = 0
    while i + 64 <= s.len : i += 64
      v = s.read[W64](i)
      n += ((v == 0x20) | (v == 0x0A) | (v == 0x0D) | (v == 0x09)).not().bits().count_ones()
    n

  fun nonspace32(s: ?String) -> Int
