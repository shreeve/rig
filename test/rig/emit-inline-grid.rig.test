# The inline grid, written by tools/inline_grid.py (edit it, not this
# file): what an inlined function hands back is a run-time value to its
# caller, so Zig folds no use of it into a compile error in code that
# never runs, and the same use, run, panics.

test "inline grid const unreached", release: true, '''
  3
  ok
'''
  # Every use of a constant, in a branch that never runs, builds.

  use std.os

  fun c_div() -> Int
    0

  fun c_overflow() -> Int
    9223372036854775807

  fun c_overflow8() -> U8
    U8(255)

  fun c_narrow() -> Int
    300

  fun c_shift() -> Int
    70

  fun c_index() -> Int
    7

  sub main()
    xs = [1, 2, 3]
    print(xs.len)
    if os.args().len > 50
      z_div = c_div()
      print(10 / z_div)
      z_overflow = c_overflow()
      print(1 + z_overflow)
      z_overflow8 = c_overflow8()
      print(z_overflow8 + U8(1))
      z_narrow = c_narrow()
      print(U8(z_narrow))
      z_shift = c_shift()
      print(1 << z_shift)
      z_index = c_index()
      print(xs[z_index])
    print("ok")

test "inline grid ignored unreached", release: true, '''
  3
  ok
'''
  # Every use of a constant, its parameter ignored, in a branch that never runs, builds.

  use std.os

  fun c_div(n: Int) -> Int
    0

  fun c_overflow(n: Int) -> Int
    9223372036854775807

  fun c_overflow8(n: Int) -> U8
    U8(255)

  fun c_narrow(n: Int) -> Int
    300

  fun c_shift(n: Int) -> Int
    70

  fun c_index(n: Int) -> Int
    7

  sub main()
    xs = [1, 2, 3]
    print(xs.len)
    if os.args().len > 50
      z_div = c_div(1)
      print(10 / z_div)
      z_overflow = c_overflow(1)
      print(1 + z_overflow)
      z_overflow8 = c_overflow8(1)
      print(z_overflow8 + U8(1))
      z_narrow = c_narrow(1)
      print(U8(z_narrow))
      z_shift = c_shift(1)
      print(1 << z_shift)
      z_index = c_index(1)
      print(xs[z_index])
    print("ok")

test "inline grid transitive unreached", release: true, '''
  3
  ok
'''
  # Every use of another inlined call's constant, in a branch that never runs, builds.

  use std.os

  fun c_div() -> Int
    0

  fun t_div(n: Int) -> Int
    c_div()

  fun c_overflow() -> Int
    9223372036854775807

  fun t_overflow(n: Int) -> Int
    c_overflow()

  fun c_overflow8() -> U8
    U8(255)

  fun t_overflow8(n: Int) -> U8
    c_overflow8()

  fun c_narrow() -> Int
    300

  fun t_narrow(n: Int) -> Int
    c_narrow()

  fun c_shift() -> Int
    70

  fun t_shift(n: Int) -> Int
    c_shift()

  fun c_index() -> Int
    7

  fun t_index(n: Int) -> Int
    c_index()

  sub main()
    xs = [1, 2, 3]
    print(xs.len)
    if os.args().len > 50
      z_div = t_div(1)
      print(10 / z_div)
      z_overflow = t_overflow(1)
      print(1 + z_overflow)
      z_overflow8 = t_overflow8(1)
      print(z_overflow8 + U8(1))
      z_narrow = t_narrow(1)
      print(U8(z_narrow))
      z_shift = t_shift(1)
      print(1 << z_shift)
      z_index = t_index(1)
      print(xs[z_index])
    print("ok")

test "inline grid ctbool unreached", release: true, '''
  3
  ok
'''
  # Every use of a compile-time Bool instance's constant, in a branch that never runs, builds.

  use std.os

  fun c_div[b: Bool](n: Int) -> Int
    0 if b else 0

  fun c_overflow[b: Bool](n: Int) -> Int
    9223372036854775807 if b else 9223372036854775807

  fun c_overflow8[b: Bool](n: Int) -> U8
    U8(255) if b else U8(255)

  fun c_narrow[b: Bool](n: Int) -> Int
    300 if b else 300

  fun c_shift[b: Bool](n: Int) -> Int
    70 if b else 70

  fun c_index[b: Bool](n: Int) -> Int
    7 if b else 7

  sub main()
    xs = [1, 2, 3]
    print(xs.len)
    if os.args().len > 50
      z_div = c_div[true](1)
      print(10 / z_div)
      z_overflow = c_overflow[true](1)
      print(1 + z_overflow)
      z_overflow8 = c_overflow8[true](1)
      print(z_overflow8 + U8(1))
      z_narrow = c_narrow[true](1)
      print(U8(z_narrow))
      z_shift = c_shift[true](1)
      print(1 << z_shift)
      z_index = c_index[true](1)
      print(xs[z_index])
    print("ok")

