test "simd lanes beside names of its own", "0 2\n2 3"
  # A module's own `Lanes`, and a method of its own named `lanes`, leave
  # a mask's `lanes()` as it is.

  obj Lanes
    n: Int

  obj Road
    w: Int

    fun lanes(?@) -> Int
      @w

  sub main()
    v = Simd[U8, 4]([1, 2, 1, 4])
    out = String()
    for k in (v == 1).lanes()
      !out.add(" " if out.len > 0 else "", k)
    print(out)
    print(Lanes(n: 2).n, Road(w: 3).lanes())

test "mask lanes kernels", "693 693 693 693 693", release: true
  # The kernels test/cli/mask_lanes.sh reads the assembly of: each walks
  # the lanes of each group equal to `tag` and adds up their positions;
  # `bits16` is the same walk written with `bits()`.

  pub fun lanes16(s: ?String, tag: U8) -> Int
    t = 0
    i = 0
    while i + 16 <= s.len : i += 16
      for k in (s.read[Simd[U8, 16]](i) == tag).lanes()
        t += i + k
    t

  pub fun bits16(s: ?String, tag: U8) -> Int
    t = 0
    i = 0
    while i + 16 <= s.len : i += 16
      m = (s.read[Simd[U8, 16]](i) == tag).bits()
      while m != 0 : m &= m -% 1
        t += i + m.trailing_zeros()
    t

  pub fun lanes8(s: ?String, tag: U8) -> Int
    t = 0
    i = 0
    while i + 8 <= s.len : i += 8
      for k in (s.read[Simd[U8, 8]](i) == tag).lanes()
        t += i + k
    t

  pub fun lanes32(s: ?String, tag: U8) -> Int
    t = 0
    i = 0
    while i + 32 <= s.len : i += 32
      for k in (s.read[Simd[U8, 32]](i) == tag).lanes()
        t += i + k
    t

  pub fun lanes64(s: ?String, tag: U8) -> Int
    t = 0
    i = 0
    while i + 64 <= s.len : i += 64
      for k in (s.read[Simd[U8, 64]](i) == tag).lanes()
        t += i + k
    t

  sub main()
    s = "abcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabc"
    print(lanes16(s, 'a'), bits16(s, 'a'), lanes8(s, 'a'), lanes32(s, 'a'), lanes64(s, 'a'))

