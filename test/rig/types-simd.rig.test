  # `t.lookup(idx)` takes a table of 16, 32, or 64 `U8` lanes and one
  # argument, a `Simd[U8, n]` of indexes: no scalar, no other lane type, no
  # compile-time or keyword argument.

  t = Simd[U8, 16].splat(1)
  idx = Simd[U8, 16].splat(2)
  print(Simd[U8, 8].splat(1).lookup(idx))
  print(Simd[I8, 16].splat(1).lookup(idx))
  print(t.lookup(3), t.lookup(Simd[I8, 16].splat(2)), t.lookup(idx == idx))
  print(t.lookup(), t.lookup(idx, idx), t.lookup(at: idx), t.lookup[1](idx))
  print(idx.lag(t))

