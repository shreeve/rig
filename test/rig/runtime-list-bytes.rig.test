    code: U32
    color: U8
    on: Bool
    n: U16

  xs: List[Rec] = List()
  !xs.extend_from_bytes($embed("recs.bin"))

  file "recs.bin", hex
    94010000 02 02 0500

fail "list of an enum of values from an embedded file holding another", "`extend_from_bytes` reads whole `Code`s from \"codes.bin\": record 1 (byte 4) holds 201, and no variant of `Code` has that value"
