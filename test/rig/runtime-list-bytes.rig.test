    n: U8
    on: Bool

  t = String("\x01\x01")
  xs: List[Rec] = List()
  !xs.extend_from_bytes(?t)

fail "list of records with an enum from a module constant", "field `kind` of `Rec` is an enum, whose values are only its variants'"
  # Only bytes written `$embed(path)` at the call are known to be the
  # file's records; a constant could be a slice or any other `Static`.
  enum Kind
    a
    b

  obj Rec
    kind: Kind

  RECS = $embed("recs.bin")

  sub main()
    xs: List[Rec] = List()
    !xs.extend_from_bytes(RECS)

  file "recs.bin", hex
    00 01

fail "list of an enum of one variant from an embedded file", "`One` holds no bytes"
  enum One
    only

  xs: List[One] = List()
  !xs.extend_from_bytes($embed("one.bin"))

  file "one.bin", hex
    00

fail "list of an enum with a variant written as a call from an embedded file", "`Abc` is an enum, whose values are only its variants'"
  enum Abc
    a()
    b

  xs: List[Abc] = List()
  !xs.extend_from_bytes($embed("abc.bin"))

  file "abc.bin", hex
    00

