# Probes from past reviews and audits, 28 of 41: review-sc5-c6 to review-seam2-r2-z07_me_assign.

test "review-sc5-c6", '''
  see 7 1
  drop R 7
  run failed Parse.empty
  see2 8 1
  see2 8 2
  end
  drop R 8
'''
  error Parse
    empty

  obj R
    n: Int
    drop(!@)
      print("drop R", @n)

  fun parse(s: ?String) -> Int!
    if s.len == 0
      return Parse.empty
    s.len

  sub each(xs: []?String, f: ?sub(?String)!)!
    for x in xs
      f(x)!

  sub run()!
    r = R(n: 7)
    each(["a", "", "c"], |<r, s| print("see", r.n, parse(s)!))!
    print("unreachable")

  run() catch |e| print("run failed", e)
  r2 = R(n: 8)
  each(["a", "bb"], |?r2, s| print("see2", r2.n, parse(s)!)) catch print("no")
  print("end")

test "review-sc5-c7", "3 0 -5"
  error E
    bad

  fun parse(s: ?String) -> Int!
    if s.len == 0
      return E.bad
    s.len

  fun use2(f: ?fun(?String) -> Int!) -> Int
    f("") catch -5

  f: fun(?String) -> Int! = |s| parse(s)! + 1
  print(f("ab") catch 0, f("") catch 0, use2(?f))

