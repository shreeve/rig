  3.402823669209385e38 -1.7014118346046923e38
  0 -2 -2
  56713727820156410577229101238628035242 1 134217727 170141183460469231731687303715884105728
  -170141183460469231731687303715884105728
  340282366920938463463374607431768211455 18446744073709551615
'''
  a: I8 = 127
  print(a +% 1, a *% 2, I8.min -% 1)
  b: U128 = U128.max
