test "review-seam2-m01 text", '''
  dropH ab
  dropH cd
  dropH e
  app g+
  dropH g+
  app h+
  dropH h+
  app i+
  dropH i+
  dropH km
  q ["q0"]
  1
  dropH q
  app s0+
  dropH s
  app v+
  1
  dropH w
'''
  # Review probe m01_text.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
  # oracle: H.tv accept
  # oracle: H.show accept
  # oracle: H.drop accept
  # oracle: mkh accept
  # oracle: mkt accept
  # oracle: f accept
  # oracle: app accept
  obj H
    t: String
    ts: List[String]

    fun tv(!@) -> !String
      !@t

    fun show(!@) -> Int
      print(@t, @ts)
      @t.len

    drop(!@)
      print("dropH", @t)

  fun mkh(s: ?String) -> H
    h = H(t: String(s), ts: List())
    !h.ts.push(String(s, "0"))
    h

  fun mkt(s: ?String) -> String
    String(s)

  fun f(n: Int) -> Int
    n

  sub app(t: !String)
    !t.add("+")
    print("app", t)

  c = f(1) == 1
  !mkh("a").t.add("b")
  (!mkh("c")).tv().add("d")
  !mkh("e").ts[0].add("f")
  app(!mkh("g").t)
  app((!mkh("h")).tv())
  app(!(mkh("i") if c else mkh("j")).t)
  !(mkh("k") if c else mkh("l")).t.add("m")
  !(mkt("n") if c else mkt("o")).add("p")
  print((!(mkh("q") if c else mkh("r"))).show())
  app(!mkh("s").ts[0])
  app(![mkt("u"), mkt("v")][1])
  print((!mkh("w")).tv().len)

