test "review-sc5-pub1", '''
  14 14
  2
  y
  14 6
'''
  use lib

  sub main()
    c = lib.Counter.make("a")
    print(c.twice(1), lib.peekof(?c, "s"))
    p = lib.pair(1, 2)
    print(p.both())
    q = lib.pair("x", "y")
    print(q.both())
    print(lib.scaled(2), lib.opened(2))

  file "lib.rig"
    SECRET = 7
    pub OPEN = 3

    pub obj Counter
      pub label: ?String
      count: Int

      pub fun make(label: ?String) -> Counter
        Counter(label: label, count: SECRET)

      fun peek(?@) -> Int
        @count

      pub fun twice[T](?@, t: T) -> Int
        @peek() * 2

    pub obj Pair[T]
      pub a: T
      b: T

      pub fun both(?@) -> T
        @second()

      fun second(?@) -> T
        @b

    pub fun pair[T](a: T, b: T) -> Pair[T]
      Pair(a: a, b: b)

    pub fun peekof[T](c: ?Counter, t: T) -> Int
      c.count + c.peek()

    pub fun scaled(x: Int, k: Int = SECRET) -> Int
      x * k

    pub fun opened(x: Int, k: Int = OPEN) -> Int
      x * k

test "review-sc5-pub4", '''
  1 2 3 4 1
  drop 5 9
  drop 4 9
  drop 3 9
  drop 2 9
  drop 1 9
'''
  use lib

  sub main()
    r = lib.mk(1)
    b = ^lib.mk(2)
    s = *lib.mk(3)
    h = lib.hold(lib.mk(4))
    print(r.n, b.n, s.n, h.v.n, h.peek())
    v = List[^lib.Res]()
    !v.push(^lib.mk(5))

  file "lib.rig"
    pub obj Res
      pub n: Int
      secret: Int = 9

      drop(!@)
        @log()

      sub log(?@)
        print("drop", @n, @secret)

    pub fun mk(n: Int) -> Res
      Res(n: n)

    pub obj Holder[T]
      pub v: T
      hidden: Int = 0

      pub fun peek(?@) -> Int
        @hidden + @bump()

      fun bump(?@) -> Int
        1

    pub fun hold[T](v: T) -> Holder[T]
      Holder(v: <v)

