test "loop else continue runs step", '''
  in 0 0
  in 0 1
  tail 0
  in 1 0
  in 1 1
  in 2 0
  in 2 1
  tail 2
  end 3
'''
  # A `continue` in an inner loop's `else` targets the loop around it and
  # goes through its step, here the only thing that moves the loop on:
  # a lowering that skipped the step would never end (the guard stops it).
  fun lim(i: Int, n: Int) -> Int?
    i if i < n else none

  i = 0
  guard = 0
  while lim(i, 3) as h and h >= 0: i = h + 1
    guard += 1
    if guard > 50
      print("cap")
      return
    for j in 0..2
      print("in", i, j)
    else
      continue if i == 1
    print("tail", i)
  print("end", i)

test "loop else continue shadowed label", "21 5"
  # A `continue $a` in the `else` of an inner loop also labeled `$a` names
  # the outer `$a`, since the inner loop has ended.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  $a: while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    $a: while j < 2: j += 1
      continue $a if j == 7
      k += 0
    else
      continue $a
    k += 100
  print(k, i)

test "loop else continue value loop", "21 5"
  # A `continue` in the `else` of a nested loop used as a value targets the
  # loop around it.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    w = for t in 0..2
      break t if t == 9
    else
      continue
    k += w
    k += 100
  print(k, i)

test "loop else loop then continue", "21 5"
  # A `continue` after a loop inside a nested loop's `else` targets the loop
  # around the nested one.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    while j < 2: j += 1
      k += 0
    else
      for _ in 0..1
        k += 0
      continue
    k += 100
  print(k, i)

test "loop label shadow break", "end 3 3"
  # An inner `$a: for` inside an outer `$a` loop: `break $a` leaves the inner
  # loop.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  j = 0
  $a: while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    continue $a if i == 99
    $a: for _ in 0..2
      j += 1
      break $a
  print("end", k, j)

test "loop label shadow continue", "end 3 6"
  # An inner `$a: for` inside an outer `$a` loop: `continue $a` targets the
  # inner loop, the innermost of that name.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  j = 0
  $a: while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    break $a if i > 50
    $a: for _ in 0..2
      j += 1
      continue $a
  print("end", k, j)

test "loop label shadow joined inner", "end 3 9 3"
  # An inner joined `$a` loop inside an outer `$a` loop: its `continue $a`
  # goes through its own step.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  q = 0
  m = 0
  $a: while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    m = 0
    break $a if i > 50
    $a: while mk(?v, m) as g and m >= 0: q += g.s[0]
      m += 1
      for _ in 0..2
        continue $a
  print("end", k, q, m)

test "loop label shadow match", "end 3 3"
  # A labeled `$a: match` inside an `$a` loop: its `break $a` leaves the match.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  j = 0
  $a: while mk(?v, i) as h and i >= 0: k += h.s[0]
    i += 1
    continue $a if i == 99
    $a: match i
      1
        j += 1
        break $a
      _ => j += 1
  print("end", k, j)

test "loop label shadow value", '''
  5
  11 2
  7
  20 3
'''
  # A label repeated inside a loop of the same name means the innermost:
  # its `break $a 5` gives the inner loop's value, not the outer one's,
  # and the outer loop is used as a value only by the `break`s that leave
  # it. An inner loop's `else` runs after that loop, so its `break $a`
  # leaves the outer loop.

  fun first(n: Int) -> Int
    $a: while true
      $a: while true
        break $a
      if n > 0
        return n

  n = 1
  m = 2
  c = n > 0
  k = if c
    $a: while true
      j = if c
        $a: while true
          break $a 5
      else
        6
      print(j)
      break $a !n
  else
    !m
  k += 10
  print(n, m)
  $a: while true
    j = if c
      $a: while true
        break $a 7
    else
      8
    print(j)
    break $a
  l = if c
    $a: for i in 0..3
      $a: for x in 0..2
        if x > 5
          break $a
      else
        break $a i + 20
    else
      0
  else
    1
  print(l, first(3))

test "loop step after body defer", '''
  d 1
  d 2
  d 3
  end 6 3
'''
  # A step that reads a binding of a joined condition runs after the body's
  # defers: here it moves `b`, which a body `defer` reads.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(0)
  b = fresh(0)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: k += h.s[0] + take(<b)
    i += 1
    b = fresh(i)
    defer print("d", b[0])
  print("end", k, i)

test "loop step after body defer catch break", '''
  d 1
  d 2
  d 3
  end 6 3
'''
  # A step that reads the binding of a condition that jumps (`catch break`)
  # runs after the body's defers.
  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun mkf(v: ?List[Int], i: Int) -> S?!
    return E.bad if i > 70
    mk(v, i)

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(0)
  b = fresh(0)
  k = 0
  i = 0
  while (mkf(?v, i) catch break) as h: k += h.s[0] + take(<b)
    i += 1
    b = fresh(i)
    defer print("d", b[0])
  print("end", k, i)

test "loop step after body defer continue", '''
  d 1
  d 2
  d 3
  end 6 3
'''
  # The same with a `continue` in the body: both paths to the step run the
  # body's defer first.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(0)
  b = fresh(0)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: k += h.s[0] + take(<b)
    i += 1
    b = fresh(i)
    defer print("d", b[0])
    continue if i == 99
  print("end", k, i)

test "loop step after body drop", '''
  defer 1
  drop 1
  step 0
  defer 2
  drop 2
  step 0
  --
  defer 1
  drop 1
  step 0
  defer 2
  drop 2
  step 0
'''
  # A body local's drop and the body's `defer` run before the step, in a
  # plain and a joined loop alike.
  obj S
    s: []Int

  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 2
      return S(s: ?v[..])
    none

  fun st(i: Int) -> Int
    print("step", i)
    i

  v: List[Int] = List()
  !v.push(0)
  i = 0
  while mk(?v, i) as h: i += st(h.s[0])
    i += 1
    y = D(n: i)
    defer print("defer", i)
  print("--")
  i = 0
  while mk(?v, i) as h and i >= 0: i += st(h.s[0])
    i += 1
    y = D(n: i)
    defer print("defer", i)

test "loop step grows after body defer view", '''
  d 7
  d 7
  d 7
  end 0 3 193
'''
  # The step grows `w` after the body's `defer` has read its view of `w`.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  fun grow(w: !List[Int]) -> Int
    for j in 0..64
      !w.push(j)
    0

  v: List[Int] = List()
  !v.push(0)
  w: List[Int] = List()
  !w.push(7)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: k += h.s[0] + grow(!w)
    i += 1
    s = ?w[..]
    defer print("d", s[0])
  print("end", k, i, w.len)

test "loop step order nested match value", '''
  step 0 0
  step 9 0
  drop 101
  mdefer 1 1
  step 2 6
  drop 102
  mdefer 1 2
  step 2 7
  drop 103
  mdefer 1 3
  step 2 8
  drop 104
  mdefer 1 4
  step 2 9
  after mid 1 4
  drop 1
  odefer 1
  step 1 6
  step 9 0
  drop 101
  mdefer 2 1
  step 2 6
  drop 102
  mdefer 2 2
  drop 2
  odefer 2
  step 1 7
  step 9 0
  drop 101
  mdefer 3 1
  step 2 6
  drop 102
  mdefer 3 2
  step 2 7
  drop 103
  mdefer 3 3
  step 2 8
  drop 104
  mdefer 3 4
  step 2 9
  after mid 3 4
  drop 3
  odefer 3
  step 1 8
  step 9 0
  drop 101
  mdefer 4 1
  step 2 6
  drop 102
  mdefer 4 2
  drop 4
  odefer 4
  step 1 9
  end 275 4
'''
  # Steps, defers, and drops run in the same order for a joined outer loop
  # and a `catch break` inner loop as for plain `while … as` loops, with a
  # `continue $outer` from a `match` value in the inner body.
  error E
    bad

  obj S
    s: []Int

  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 4
      return S(s: ?v[..])
    none

  fun mkf(v: ?List[Int], i: Int, bad: Int) -> S?!
    return E.bad if i == bad
    mk(v, i)

  fun fresh(t: Int, n: Int) -> List[Int]
    print("step", t, n)
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  fun odd(j: Int) -> Int?
    j if j % 2 == 1 else none

  v: List[Int] = List()
  !v.push(5)
  a = fresh(0, 0)
  k = 0
  i = 0
  $outer: while mk(?v, i) as h and i >= 0: a = fresh(1, h.s[0] + i)
    i += 1
    defer print("odefer", i)
    x = D(n: i)
    k += take(<a)
    m = 0
    b = fresh(9, 0)
    $mid: while (mkf(?v, m, 99) catch break) as g: b = fresh(2, g.s[0] + m)
      m += 1
      defer print("mdefer", i, m)
      y = D(n: 100 + m)
      k += take(<b)
      w = match m
        1 => 10
        2
          continue $outer if i % 2 == 0
          20
        _ => 30
      k += w
    print("after mid", i, m)
  print("end", k, i)

test "loop step reads binding through capture", '''
  body 1 0
  body 2 1
  body 3 2
  body 4 3
  60 4
'''
  # A step that reads the condition's binding only through a closure's
  # capture reads the binding: it runs in the binding's scope.
  fun some(i: Int) -> Int?
    i if i < 4 else none

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  steps = 0
  i = 0
  while some(i) as h: steps = apply(|+h, x: Int| x + h * 10, steps)
    i += 1
    print("body", i, h)
  print(steps, i)
