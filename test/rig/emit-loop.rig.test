# emit: tests whose names start `loop`.

test "loop else continue joined inner", "21 5"
  # A `continue` in the `else` of a nested joined loop targets the loop
  # around it.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    while mk(?v, j) as g and j >= 0: j += g.s[0]
      k += 0
    else
      continue
    k += 100
  print(k, i)

test "loop else continue labeled", "21 5"
  # A `continue $outer` in a nested loop's `else` goes through the outer
  # loop's step.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  $outer: while mk(?v, i) as h and i >= 0: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    while j < 2: j += 1
      k += 0
    else
      continue $outer
    k += 100
  print(k, i)

