fail "cell object drop part stays", "`c` views a `*` handle to an object that holds a Cell and `f: Fd`, which is neither plain data, a Cell of one word, nor a word-Cell object, so it stays with one task", errors: 1
  # A part with a `drop` body has no copy, so it is not plain data.
  use std.par

  obj Fd
    k: Int

    drop(!@)
      print("closed")

  obj H
    n: Cell[Int]
    f: Fd

  c = *H(n: Cell(1), f: Fd(k: 3))
  print(par.map(?[1, 2], |?c, x| x + c.n.get()))

