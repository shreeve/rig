    fun total(?@) -> Int

  obj Hits: Count
    n: Cell[Int]

    fun total(?@) -> Int
      @n.get()

  c = *Hits(n: Cell(1))
  o: *{Count + Syncs} = c
  print(o.total())

test "cell object function part across tasks", seeds: 20, "[3, 5]"
  # A function value is plain data (Core §1): an object of one and a
  # word Cell goes to other tasks.
  use std.par

  fun twice(x: Int) -> Int
    x * 2

  obj H
    n: Cell[Int]
    f: fun(Int) -> Int

  c = *H(n: Cell(1), f: twice)
  par.map(?[1, 2], |?c, x| c.f(x) + c.n.get())

