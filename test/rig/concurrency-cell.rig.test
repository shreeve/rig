# concurrency: tests whose names start `cell`.

test "cell count across tasks", seeds: 20, "8000"
  # A Cell of one word goes to other tasks, each through a handle of its
  # own (`+hits`), and no change is lost.
  sub work(hits: *Cell[Int])
    for 0..1000
      !hits.add(1)

  hits = *Cell(0)
  ts = Tasks[Void]()
  for 0..8
    !ts.add(work(+hits)&)
  >ts
  print(hits.get())

test "cell count across tasks released", seeds: 20, release: true, "80000"
  # The same, with more changes than a build in Zig's safe mode can make
  # by luck alone.
  sub work(hits: *Cell[Int])
    for 0..10000
      !hits.add(1)

  hits = *Cell(0)
  ts = Tasks[Void]()
  for 0..8
    !ts.add(work(+hits)&)
  >ts
  print(hits.get())

test "cell counts of many tasks, each its own", seeds: 20, "8000 8 true"
  # Cells made one after another, each changed by its own task while
  # another reads them all, their handles counted from many cores: each
  # Cell has a cache line of its own, and every count and handle comes out
  # exact.
  sub work(c: *Cell[Int])
    for 0..1000
      !c.add(1)

  fun sum(cs: ?List[*Cell[Int]]) -> Int
    n = 0
    for c in cs
      n += c.get()
    n

  cs = List[*Cell[Int]]()
  for 0..8
    !cs.push(*Cell(0))
  ts = Tasks[Void]()
  for c in cs
    !ts.add(work(+c)&)
  t = sum(?cs)&
  >ts
  seen = >t
  print(sum(?cs), cs.len, seen <= 8000)

test "cell claim once", seeds: 20, "1"
  # The first of many tasks to flip a flag wins: `compare_swap` checks
  # and stores at once, so exactly one sees `true`.
  sub claim(flag: *Cell[Bool], wins: *Cell[Int])
    if (!flag).compare_swap(false, true)
      !wins.add(1)

  flag = *Cell(false)
  wins = *Cell(0)
  ts = Tasks[Void]()
  for 0..16
    !ts.add(claim(+flag, +wins)&)
  >ts
  print(wins.get())

test "cell word operations", seeds: 20, '''
  5 7
  true false 9
  5 15
  15
  true false true
  true 3.5 3.5
  true true
  ~(alive)
'''
  # `swap` gives the old value, `compare_swap` whether it stored, and
  # `add` and `sub` the new value; a Cell of one word holds an Int, a
  # Bool, a Float, or a plain enum, and a task may be lent one to read.
  enum Phase
    idle
    busy
    done

  fun peek(n: ?Cell[Int]) -> Int
    n.get()

  n = *Cell(5)
  print((!n).swap(7), n.get())
  print((!n).compare_swap(7, 9), (!n).compare_swap(7, 1), n.get())
  print((!n).sub(4), (!n).add(10))
  t = peek(?n)&
  print(>t)
  b = *Cell(false)
  print((!b).compare_swap(false, true), (!b).compare_swap(false, true), b.get())
  f = *Cell(1.5)
  !f.set(2.25)
  print((!f).compare_swap(2.25, 3.5), f.get(), (!f).swap(0.5))
  p = *Cell(Phase.idle)
  print((!p).compare_swap(Phase.idle, Phase.busy), p.get() == Phase.busy)
  w = ~n
  print(w)

test "cell print shared", seeds: 20, "Cell(value: 3) 4"
  # A Cell many tasks change prints as any Cell does.
  fun one() -> Int
    1

  c = *Cell(3)
  t = one()&
  print(c, 3 + >t)

test "cell list local", seeds: 20, "2 2"
  # A Cell of more than one word stays on one thread: a task given its
  # handle is local, run on the thread of the task that made it.
  fun total(xs: *Cell[List[Int]]) -> Int
    !xs.push(4)
    xs.len

  xs = *Cell(List[Int]())
  !xs.push(1)
  t = total(+xs)&
  print(>t, xs.len)

fail "cell add bool", "`add` counts, so it is a `Cell[Int]`'s; this is a `Cell[Bool]`: change it with `set`, `swap`, or `compare_swap`", errors: 1
  a = *Cell(true)
  !a.add(1)

fail "cell compare list", "`compare_swap` compares and stores at once, so it is a Cell of one word's (`Int`, `Bool`, `Float`, or a plain enum); this is a `Cell[List[Int]]`: change it with `set` or `swap`", errors: 1
  a = *Cell(List[Int]())
  ok = (!a).compare_swap(List[Int](), List[Int]())
  print(ok)

fail "cell read view counts", "cannot lend to write through a read view `?*Cell[Int]`", errors: 1
  # A read view only reads, a Cell's too.
  a = *Cell(0)
  r = ?a
  !r.add(1)

test "cell add that overflows stores nothing", seeds: 20, '''
  caught Stop.panicked
  9223372036854775807
  caught Stop.panicked
  -9223372036854775808
'''
  # A Cell many tasks change panics at an add or subtract that
  # overflows before it stores, as `+` does: an isolate that stops the
  # panic leaves the old value.
  use std.task

  sub bump(c: *Cell[Int], n: Int)
    !c.add(n)

  sub lower(c: *Cell[Int], n: Int)
    !c.sub(n)

  sub nothing()
    pass

  t = nothing()&
  >t
  high = *Cell(Int.max)
  task.isolate(|+high| bump(+high, 1)) catch |e| print("caught", e)
  print(high.get())
  low = *Cell(Int.min)
  task.isolate(|+low| lower(+low, 1)) catch |e| print("caught", e)
  print(low.get())

test "cell object across tasks", seeds: 20, '''
  [8001, 8002, 8003] 16000
  Pair(a: Hits(n: Cell(value: 8000), step: 1), b: Hits(n: Cell(value: 16000), step: 2))
'''
  # An object whose every part is plain data, a Cell of one word, or
  # another such object changes through a handle only by its Cells, so
  # its handles count atomically and go to other cores, as a word Cell's
  # do: `+p` given to tasks, and `p` read by the tasks of `par.map`.
  use std.par

  obj Hits
    n: Cell[Int]
    step: Int

    sub bump(!@)
      _ = !@n.add(@step)

  obj Pair
    a: Hits
    b: Hits

  sub work(p: *Pair)
    for 0..1000
      !p.a.bump()
      !p.b.bump()

  p = *Pair(a: Hits(n: Cell(0), step: 1), b: Hits(n: Cell(0), step: 2))
  ts = Tasks[Void]()
  for 0..8
    !ts.add(work(+p)&)
  >ts
  print(par.map(?[1, 2, 3], |?p, x| x + p.a.n.get()), p.b.n.get())
  print(p)

fail "cell object with an owner stays", "`par.map` calls the closure on several tasks at once, which all read what it captures, and `c` views a `*` handle to an object that holds a Cell and a part that is neither plain data nor a Cell of one word, which stays with one task; an object of plain data and such Cells goes to other tasks", errors: 1
  use std.par

  obj Named
    n: Cell[Int]
    name: String

  c = *Named(n: Cell(1), name: String("x"))
  print(par.map(?[1, 2, 3], |?c, x| x + c.n.get()))
