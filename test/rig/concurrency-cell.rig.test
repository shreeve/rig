fail "cell object part changes only by its cells", "cannot assign through a shared handle (`*T`)", errors: 1
  # A write view of a word-Cell object, handed on, changes only its Cells.
  obj Hits
    n: Cell[Int]
    step: Int

  sub poke(h: !Hits)
    h.step = 3

  c = *Hits(n: Cell(1), step: 1)
  poke(!c)
  print(c.step)

