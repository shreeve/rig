# Probes from past reviews and audits, 7 of 41: audit-tests-probes-c19_else_if to copies-fill-f12.

test "audit-tests-probes-c19 else if", "mid"
  x = 3
  if x > 5
    print("big")
  else if x > 1
    print("mid")

fail "audit-tests-probes-rg03 use after move", "use of `s` after move"
  obj S
    v: List[Int]

  sub take(s: S)
    print(s.v.len)

  s = S(v: List())
  take(<s)
  print(s.v.len)

fail "audit-tests-probes-rg04 implicit move", "`take` takes ownership of an `S`, and `s` can't be copied: write `<s` to move it or `+s` to pass a clone; if `take` only reads it, make its parameter an `?S`"
  obj S
    v: List[Int]

  sub take(s: S)
    print(s.v.len)

  s = S(v: List())
  take(s)

fail "audit-tests-probes-rg105 move then reassign ok", "use of `s` after move"
  obj S
    v: List[Int]

  s = S(v: List())
  t = <s
  print(s.v.len, t.v.len)

fail "audit-tests-probes-rg10 fixed reassign", "cannot reassign fixed binding `x`"
  x =! 1
  x = 2
  print(x)

fail "audit-tests-probes-rg17 return view of local", "cannot return a view of `s`, which this function was not lent"
  obj S
    n: Int

  fun mk() -> ?S
    s = S(n: 1)
    ?s

  print(mk().n)

test "audit-tests-probes-rg19 clone copy", "5"
  x = 5
  y = +x
  print(y)

fail "audit-tests-probes-rg36 view of temp stored", "a view of the temporary `S(n: 1)` outlives its statement, which drops it; bind the value to a name first"
  obj S
    n: Int

  obj H
    s: ?S

  h = H(s: ?S(n: 1))
  print(h.s.n)

fail "audit-tests-probes-rg45 write view twice", "cannot lend `x` to write while a write loan is live"
  sub two(a: !Int, b: !Int)
    a += b

  x = 1
  two(!x, !x)
  print(x)

fail "audit-tests-probes-rg46 move in loop", "`i` is bound but never read; name it `_` to ignore the value"
  obj S
    v: List[Int]

  sub take(s: S)
    print(s.v.len)

  s = S(v: List())
  for i in 0..2
    take(<s)

test "audit-tests-probes-rg49 catch no e", "0"
  error E
    bad

  fun f() -> Int!
    return E.bad

  x = f() catch |e| 0
  print(x)

test "audit-tests-probes-rg52 compare optional none eq", "none"
  fun f() -> Int?
    none

  if f() == none
    print("none")

test "audit-tests-probes-rg53 for index order", '''
  10 0
  20 1
'''
  xs = [10, 20]
  for i, x in xs
    print(i, x)

fail "audit-tests-probes-rg86 vec index owning", "`xs[0]` owns an `S`, which can't be copied by `=`: write `+xs[0]` to clone it or `?xs[0]` to view it"
  obj S
    v: List[Int]

  xs: List[S] = List()
  !xs.push(S(v: List()))
  y = xs[0]
  print(y.v.len)

test "audit-tests-probes-rg91 optional param default none", "0"
  fun f(n: Int? = none) -> Int
    n ?? 0

  print(f())

fail "audit-tests-probes-rg95 unused param ok but unused for", "`i` is bound but never read; name it `_` to ignore the value"
  for i in 0..3
    print("x")

fail "audit-tests-probes-w push in loop", "cannot lend `v` to write while a read loan is live"
  v: List[Int] = List()
  !v.push(1)
  for x in ?v
    !v.push(x)
  print(v.len)

test "audit-tests-probes-w return view param wrong", "2"
  obj S
    n: Int

  fun first(a: ?S, b: ?S) -> ?S
    a if a.n > b.n else b

  x = S(n: 1)
  y = S(n: 2)
  print(first(?x, ?y).n)

test "audit-tests-probes-w struct copy assign", "1 2"
  obj P
    x: Int

  a = P(x: 1)
  b = a
  b.x = 2
  print(a.x, b.x)

test "audit-tests-probes-w vec of string push moved", "a 1"
  v: List[?String] = List()
  s = "a"
  !v.push(s)
  print(s, v.len)

fail "audit-tests-probes-x19 move copy", "use of `x` after move"
  x = 5
  y = <x
  print(x, y)

test "audit-tests-probes-x20 clone then use", "0 0"
  obj S
    v: List[Int]

  s = S(v: List())
  t = +s
  print(s.v.len, t.v.len)

test "audit-tests-probes-y01 errdefer", '''
  defer
  drop 1
  1
  defer
  errdefer 1
  drop 1
  -1
'''
  error E
    bad

  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  fun make(fail: Bool) -> Int!
    r = R(n: 1)
    errdefer print("errdefer", r.n)
    defer print("defer")
    return E.bad if fail
    r.n

  print(make(false)!)
  print(make(true) catch -1)

fail "audit-tests-probes-y04 errdefer moves", "a `defer` body cannot move or drop `r`; it runs when the scope exits"
  error E
    bad

  obj R
    v: List[Int]

  sub eat(r: R)
    print(r.v.len)

  fun f() -> Int!
    r = R(v: List())
    errdefer eat(<r)
    return E.bad

fail "audit-tests-probes-y05 temp view rt", "a view of the temporary `mk(rt(7))` outlives its statement, which drops it; bind the value to a name first"
  obj S
    n: Int
    v: List[Int]

  obj H
    s: ?S

  fun rt(n: Int) -> Int
    n

  fun mk(n: Int) -> S
    s = S(n: n, v: List())
    !s.v.push(n)
    s

  h = H(s: ?mk(rt(7)))
  x = [rt(1), rt(2), rt(3), rt(4)]
  print(h.s.n, h.s.v.len, x[0])

fail "audit-tests-probes-y06 temp view plain", "cannot return a view of `S(n: rt(n), m: rt(n + 1))`, which this function was not lent"
  obj S
    n: Int
    m: Int

  obj H
    s: ?S

  fun rt(n: Int) -> Int
    n

  fun clobber(a: Int) -> Int
    x = [a, a, a, a, a, a, a, a]
    x[0] + x[7]

  fun mk(n: Int) -> H
    H(s: ?S(n: rt(n), m: rt(n + 1)))

  h = H(s: ?S(n: rt(7), m: rt(8)))
  print(clobber(99))
  print(h.s.n, h.s.m)

fail "audit-tests-probes-y07 dangling return", "cannot return a view of `S(n: rt(n), m: rt(n + 1))`, which this function was not lent"
  obj S
    n: Int
    m: Int

  obj H
    s: ?S

  fun rt(n: Int) -> Int
    n

  fun clobber(a: Int) -> Int
    x = [a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a]
    x[0] + x[15]

  fun mk(n: Int) -> H
    H(s: ?S(n: rt(n), m: rt(n + 1)))

  h = mk(7)
  print(clobber(99))
  print(h.s.n, h.s.m)

fail "audit-tests-probes-y08 local view return", "cannot return a view of `s`, which this function was not lent"
  obj S
    n: Int

  obj H
    s: ?S

  fun mk(n: Int) -> H
    s = S(n: n)
    H(s: ?s)

  h = mk(7)
  print(h.s.n)

fail "audit-tests-probes-y09 temp view scope", "a view of the temporary `S(n: rt(1), m: rt(2))` outlives its statement, which drops it; bind the value to a name first"
  obj S
    n: Int
    m: Int

  obj H
    s: ?S

  fun rt(n: Int) -> Int
    n

  fun clobber(a: Int) -> Int
    x = [a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a]
    x[0] + x[15]

  h = H(s: ?S(n: rt(1), m: rt(2)))
  if rt(1) == 1
    new h = H(s: ?S(n: rt(7), m: rt(8)))
    print(h.s.n)
  print(clobber(5))
  print(h.s.n, h.s.m)

