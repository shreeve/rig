  pts = [p, Point(x: 2, y: 0.0), q]
  print(p == q, p != q, n == n, s == .circle(r: 1.0), o == none)
  print("abc" < "abd", "ab" < "abc", "" < "a", "é" > "z", max("pear", "apple"))
  print(index_of(?pts, Point(x: 2, y: 0.0)), index_of(?["a", "b", "c"], "c"))

