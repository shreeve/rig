    circle(r: Float)
    square(side: Int)

  fun max[T](a: T, b: T) -> T
    a if a > b else b

  fun index_of[T](xs: ?[3]T, x: T) -> Int
    for v, i in xs
      return i if v == x
    -1

  p = Point(x: 1, y: 2.5)
  q = Point(x: 1, y: 2.5)
  nan = 0.0 / 0.0
  n = Point(x: 1, y: nan)
  s: Shape = .circle(r: 1.0)
