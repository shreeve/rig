fail "R11b-cases-nest fp", "only module `lib` can construct `lib.Chain`: its field `items` is private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib

  fun dbl(x: Int) -> Int
    x * 2

  sub main()
    v: List[Int] = List()
    !v.push(1)
    !v.push(2)
    l = lib.Chain(items: <v)
    m = l.map(dbl)
    print(m.count())
    print(lib.countdown("s", 3), lib.ping(1, 4), lib.once(2).a, lib.swap(lib.Pair(a: 1, b: "x"), 3))

  file "lib.rig"
    pub obj Pair[A, B]
      a: A
      b: B

    pub obj Chain[T]
      items: List[T]

      fun map[U](?@, f: fun(T) -> U) -> Chain[U]
        out: List[U] = List()
        for x in @items
          !out.push(f(x))
        Chain(items: <out)

      fun count(?@) -> Int
        @items.len

    pub fun countdown[T](x: T, n: Int) -> Int
      if n == 0
        0
      else
        1 + countdown(x, n - 1)

    pub fun ping[T](x: T, n: Int) -> Int
      if n == 0
        0
      else
        pong(x, n - 1)

    fun pong[T](x: T, n: Int) -> Int
      ping(x, n)

    pub fun once[T](x: T) -> Pair[T, T]
      helper(Pair(a: x, b: x))

    fun helper[U](p: U) -> U
      p

    pub fun swap[A, B](p: Pair[A, B], n: Int) -> Int
      if n == 0
        0
      else
        swap(Pair(a: p.b, b: p.a), n - 1)

