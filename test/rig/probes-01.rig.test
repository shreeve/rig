test "R11b-cases-nest fp pubsingle", "1"
  pub obj Pair[A, B]
    a: A
    b: B

  pub obj Chain[T]
    items: List[T]

    fun zip[U](?@, other: ?Chain[U]) -> Chain[Pair[T, U]]
      out: List[Pair[T, U]] = List()
      i = 0
      while i < @items.len and i < other.items.len
        !out.push(Pair(a: @items[i], b: other.items[i]))
        i += 1
      Chain(items: <out)

    fun count(?@) -> Int
      @items.len

  v: List[Int] = List()
  !v.push(1)
  l = Chain(items: <v)
  print(l.count())

fail "R11b-cases-ownchain", "`util.firsts[Res]` cannot use `T = Res`: the generic body copies a `T`, which would duplicate the resource `Res` owns"
  use lib

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  sub main()
    r = lib.f(Res(n: 1))
    v: List[Res] = List()
    print(r.n, lib.g(?v))

  file "lib.rig"
    use util

    pub fun f[T](x: T) -> T
      util.dup(<x)

    pub fun g[T](v: ?List[T]) -> Int
      util.firsts(v)

  file "util.rig"
    pub fun dup[T](x: T) -> T
      a = x
      <a
      x

    pub fun firsts[T](v: ?List[T]) -> Int
      for x in v
        <x
      1

fail "R11b-cases-recursive", "only module `lib` can construct `lib.Node`: its fields `v`, `next` are private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib

  sub main()
    a = lib.cons("a", none)
    b = lib.cons("b", <a)
    n: lib.Node[?String] = lib.Node(v: "c", next: <b)
    print(n.val())
    t = lib.Tree[Int](kids: List(), v: 1)
    !t.kids.push(lib.Tree(kids: List(), v: 2))
    print(t.kids.len, t.kids[0].v)

  file "lib.rig"
    pub obj Node[T]
      v: T
      next: (*Node[T])?

      fun val(?@) -> T
        @v

    pub obj Tree[T]
      kids: List[Tree[T]]
      v: T

    pub fun cons[T](v: T, rest: (*Node[T])?) -> *Node[T]
      *Node(v: v, next: <rest)

fail "R11b-cases-typepos", "field `v` of `lib.Wrap` is private to module `lib`; declare it `pub v: ...` there to use it from here"
  use lib

  type W = lib.Wrap[Int]

  obj Holder
    w: lib.Wrap[Int]
    o: lib.Wrap[Int]?
    arr: [2]lib.Wrap[Int]

  fun p1(w: ?lib.Wrap[Int]) -> Int
    w.v

  sub p2(w: !lib.Wrap[Int])
    w.v = w.v + 1

  fun ret() -> lib.Wrap[Int]
    lib.Wrap[Int](v: 4)

  fun opt(b: Bool) -> lib.Wrap[Int]?
    if b
      lib.Wrap(v: 1)
    else
      none

  fun takesfn(f: fun(lib.Wrap[Int]) -> Int, w: lib.Wrap[Int]) -> Int
    f(w)

  fun getv(w: lib.Wrap[Int]) -> Int
    w.v

  sub main()
    a: W = lib.Wrap[Int].make(3)
    h = Holder(w: a, o: lib.Wrap(v: 2), arr: [lib.Wrap(v: 5), lib.Wrap(v: 6)])
    print(p1(?h.w))
    b = ret()
    p2(!b)
    print(b.v)
    o = opt(true)
    if o as w
      print(w.v)
    s: *lib.Wrap[Int] = *lib.Wrap(v: 9)
    print(s.v)
    v: List[lib.Wrap[Int]] = List()
    !v.push(lib.Wrap(v: 1))
    print(takesfn(getv, lib.Wrap(v: 7)))
    print(lib.max(3, 7), lib.max[Float](1, 2))
    print(h.arr[1].v)

  file "lib.rig"
    pub obj Wrap[T]
      v: T

      fun make(v: T) -> Self
        Wrap(v: v)

    pub fun max[T](a: T, b: T) -> T
      if a > b
        a
      else
        b

