# Probes from past reviews and audits, 1 of 41: R11a-P2_unused_type_param to R15-p-i4.

test "R11a-P2 unused type param", "true"
  enum Tag[T]
    on
    off

    fun flip(?@) -> Tag[T]
      .on

  t: Tag[Int] = .off
  print(t.flip() == .on)

fail "R11a-a2", "only module `lib` can construct `lib.Wrap`: its field `v` is private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  sub main()
    w = lib.Wrap(v: Res(n: 1))
    print(w.v.n)
    k = lib.Keep[List[Int]](items: List())
    print(k.items.len)

  file "lib.rig"
    pub obj Wrap[T]
      v: T

      fun get(?@) -> T
        @v

    pub obj Keep[T]
      items: List[T]

      fun peek(?@) -> T
        for x in ?@items
          return <x
        @items[0]

fail "R11a-a4", "only module `lib` can construct `lib.Wrap`: its field `c` is private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib
  use util

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  sub main()
    w = lib.Wrap(c: util.Cell2(v: Res(n: 1)))
    print(w.c.v.n)
    o = lib.Ord(v: "x")
    print(o.bigger(?o))

  file "lib.rig"
    use util

    pub obj Wrap[T]
      c: util.Cell2[T]

    pub obj Ord[T]
      v: T

      fun bigger(?@, o: ?Self) -> Bool
        util.big(@v, o.v) == @v

  file "util.rig"
    pub fun big[T](a: T, b: T) -> T
      a if a > b else b

    pub fun dup[T](x: T) -> T
      y = x
      y

    pub obj Cell2[T]
      v: T

      fun get(?@) -> T
        @v

    pub fun deep[T](x: T) -> Bool
      x == x

fail "R11a-d1l", "cannot lend `v` to write while a read loan is live"
  fun first[T](v: ?List[T]) -> ?T
    ?v[0]

  obj P
    n: Int

  v = List[P]()
  !v.push(P(n: 1))
  f = first(?v)
  for i in 0..100
    !v.push(P(n: i))
  print(f.n)

test "R11a-d1n", "a"
  use lib

  sub main()
    v = List[?String]()
    !v.push("a")
    f = lib.first(?v)
    !v.push("b")
    print(f)

  file "lib.rig"
    pub fun first(v: ?List[?String]) -> ?String
      ?v[0]

fail "R11a-d4", "only module `lib` can construct `lib.Bag`: its fields `items`, `name` are private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  fun run() -> Int!
    a = lib.check(Res(n: 1), true)!
    print("got", a.n)
    b = lib.check(Res(n: 2), false)!
    print("never", b.n)
    0

  sub main()
    r = run() catch -1
    print(r)
    bag = lib.Bag[Int](items: List())
    !bag.push(1)
    !bag.push(2)
    print(bag.size(), bag.name)
    items = (!bag).take()
    print(items.len)
    h = lib.Holder(v: Res(n: 5))
    print(<h.done())
    h2 = lib.Holder(v: List[Int]())
    print(h2.v.len)
    c = *Cell[lib.Holder[List[Int]]](value: lib.Holder(v: List[Int]()))
    hv = lib.Holder(v: List[Int]())
    !hv.v.push(9)
    !c.set(<hv)
    old = (!c).replace(lib.Holder(v: List[Int]()))
    print(old.v.len)

  file "lib.rig"
    error Oops
      bad

    pub fun check[T](x: T, ok: Bool) -> T!
      if not ok
        <x
        return Oops.bad
      x

    pub obj Bag[T]
      items: List[T]
      name: ?String = "bag"

      sub push(!@, x: T)
        !@items.push(<x)

      fun take(!@) -> List[T]
        out = List[T]()
        while @items.len > 0
          if (!@items).pop() as x
            !out.push(<x)
        out

      fun size(?@) -> Int
        @items.len

    pub obj Holder[T]
      v: T

      fun done(<@) -> Int
        7

fail "R11a-d5", "field `first` of `lib.Pair` is private to module `lib`; declare it `pub first: ...` there to use it from here"
  use lib

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  sub main()
    r = Res(n: 1)
    v = lib.pairs(?r, Res(n: 2))
    <r
    print(v.first.n)

  file "lib.rig"
    pub obj Pair[A, B]
      first: A
      second: B

    pub obj View[T]
      r: ?T

    pub fun view[T](x: ?T) -> View[T]
      View(r: x)

    pub fun pairs[T](x: ?T, y: T) -> Pair[?T, T]
      Pair(first: x, second: <y)

fail "R11a-e1", "only module `lib` can construct `lib.Wrap`: its fields `v`, `n`, `c` are private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib

  sub main()
    w = lib.Wrap(v: 1)
    print(w.n, w.add(), w.more(true), w.col(), lib.f(1), lib.g("x"))
    print(w)

  file "lib.rig"
    enum Color
      red
      green

    pub obj Wrap[T]
      v: T
      n: Int = 5
      c: Color = .green

      fun add(?@, k: Int = 5) -> Int
        @n + k

      fun more[U](?@, u: U, k: Int = 300) -> Int
        k

      fun col(?@, c: Color = .red) -> Bool
        c == .red

    pub fun f[T](x: T, k: Int = 7) -> Int
      k

    pub fun g[T](x: T, k: T? = none) -> Bool
      k == none

fail "R11a-e2", "method `make` of `lib.Wrap` is private to module `lib`; declare it `pub fun make` there to call it from here"
  use lib

  sub main()
    print(lib.Wrap[Int].make(1), lib.Wrap.make(2.5), lib.Wrap(v: 1).with(true))
    w = lib.Wrap(v: 3)
    print(w.with[Int](1), w.with(u: 2))

  file "lib.rig"
    pub obj Wrap[T]
      v: T

      fun make(v: T, tag: ?String = "tagdefault", k: Int = 12345) -> ?String
        tag

      fun with[U](?@, u: U, tag: ?String = "withdefault") -> ?String
        tag

fail "R11a-h5", "compile-time argument 2 of `lib.Ring` is a value of type `Int`, not a type"
  use lib

  fun a(x: lib.Ring[Int, Int]) -> Int
    1

  fun b(x: lib.Ring[4, Int]) -> Int
    1

  fun c(x: lib.Wrap[Int, Int]) -> Int
    1

  fun d(x: lib.Wrap) -> Int
    1

  fun e(x: lib.Ring[Int, -1]) -> Int
    1

  fun f(x: lib.Ring[Int, 99999999999]) -> Int
    1

  sub main()
    print(1)

  file "lib.rig"
    pub obj Wrap[T]
      v: T

    pub enum Opt[T]
      some(value: T)
      nothing

    pub obj Ring[T, n: Int]
      items: [n]T

      fun cap(?@) -> Int
        n

    pub fun make(x: Int) -> Wrap[Int]
      Wrap(v: x)

    pub fun unwrap(w: Wrap[Int]) -> Int
      w.v

    pub fun nest(x: Int) -> Wrap[Wrap[Int]]
      Wrap(v: Wrap(v: x))

    pub fun opt(x: Int) -> Opt[Int]
      .some(value: x) if x > 0 else .nothing

    pub fun ring4() -> Ring[Int, 4]
      Ring(items: [1, 2, 3, 4])

    pub fun ringcap(r: Ring[Int, 2 + 2]) -> Int
      r.cap()

