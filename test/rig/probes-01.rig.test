test "R15-p-ao1", '''
  [1, 1, 1, 1]
  [3, 0, 1, 2]
  [4, 4, 4, 4]
  4 4
'''
  a = [3, 1, 0, 2]
  !a.fill(a[1])
  print(a)
  b = [3, 1, 0, 2]
  !b.swap(b[1], b[3])
  print(b)
  w = !b[..]
  !w.swap(w[2], w.len - 1)
  !w.fill(w.len)
  print(b)
  c: [4]U8 = [1, 2, 3, 4]
  !c.write[U8](c[0], c[3])
  print(c[1], c.read[U8](c.len - 1))

fail "R15-p-b1", "cannot lend `b.a` to write while a read loan on `b` is live"
  # method with !@ and a ![]T param from the same object
