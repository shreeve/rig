  file "lib.rig"
    pub obj Wrap[T]
      v: T

      fun get(?@) -> T
        @v

    pub fun f0[T](a: T, b: T) -> Int
      if a > b
        1
      else
        0

    pub fun g0[T](x: T) -> Wrap[T]
      Wrap(v: x)

    pub fun f1[T](a: T, b: T) -> Int
      f0(a, b) + 1

    pub fun g1[T](x: T) -> Wrap[T]
      Wrap(v: x)

    pub fun f2[T](a: T, b: T) -> Int
      f1(a, b) + 1

    pub fun g2[T](x: T) -> Wrap[T]
      Wrap(v: x)

    pub fun f3[T](a: T, b: T) -> Int
      f2(a, b) + 1

    pub fun g3[T](x: T) -> Wrap[T]
      Wrap(v: x)

    pub fun f4[T](a: T, b: T) -> Int
      f3(a, b) + 1

