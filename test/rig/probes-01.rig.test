test "R15-p-ac1", '''
  [1, 2, 30, 5]
  true
'''
  fun find(s: ![]Int, k: Int) -> (![]Int)?
    i = 0
    while i < s.len : i += 1
      if s[i] == k
        return !s[i..]
    none

  sub inc(x: !Int)
    x += 1

  a = [1, 2, 3, 4]
  if find(!a[..], 3) as t
    t[0] = 30
    inc(!t[1])
  print(a)
  o = find(!a[..], 9)
  print(o == none)

test "R15-p-ac3", '''
  2
  [42, 2]
'''
  fun first(o: (![]Int)?) -> Int
    if <o as s
      s[0] = 42
      s.len
    else
      0

  a = [1, 2]
  w: (![]Int)? = !a[..]
  print(first(<w))
  print(a)

