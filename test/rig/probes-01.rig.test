test "R11a-s8", '''
  1
  .nothing .nothing
'''
  use lib

  sub main()
    a = lib.Opt.some(value: 1)
    b: lib.Opt[?String] = .nothing
    c: lib.Opt[Int] = lib.Opt[Int].nothing
    match a
      .some(value) => print(value)
      .nothing => print("none")
    print(b, c)

  file "lib.rig"
    pub enum Opt[T]
      some(value: T)
      nothing

    pub enum Tag[T]
      on
      off

      fun flip(?@) -> Self
        .off if @ == .on else .on

    pub fun tag[T](x: T) -> Tag[T]
      .on

    pub fun same[T](a: T, b: T) -> Bool
      a == b

