fail "R11a-n1-lib", "`x` is captured by the closure, which keeps it for every call, so a return value can't take it"
  pub fun maker[T](x: T) -> *fun() -> T
    *|<x| x

  pub fun apply[T](x: T, f: *fun(T) -> T) -> T
    f(<x)

  pub fun each[T](v: ?List[T], f: fun(?T) -> Int) -> Int
    t = 0
    for x in v
      t += f(?x)
    t

fail "R11a-p2", "only module `lib` can construct `lib.Two`: its fields `a`, `b` are private; declare every field `pub` there, or make the value with a `pub` function of `lib`"
  use lib

  fun f(s: ?String) -> ?String
    print("eval", s)
    s

  sub main()
    lib.pair(b: f("B"), a: f("A"))
    lib.pair[Int, ?String](b: f("x"), a: 1, sep: f("+"))
    t = lib.Two(b: f("b"), a: f("a"))
    t.show(post: f("]"), pre: f("["))

  file "lib.rig"
    pub sub pair[A, B](a: A, b: B, sep: ?String = "-")
      print(a, sep, b)

    pub obj Two[A, B]
      a: A
      b: B

      sub show(?@, pre: ?String = ">", post: ?String = "<")
        print(pre, @a, @b, post)

