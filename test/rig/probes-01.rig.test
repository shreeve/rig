fail "R13-s-m-lib", "cannot move `v` out of `@`: `match @` reads `@`; write `match <@` to take its fields"
  pub obj Bag
    items: List[Int]

    fun new() -> Bag
      Bag(items: List[Int]())

    fun count(<@) -> Int
      @items.len

  pub enum Opt[T]
    some(v: T)
    no

    fun or(<@, d: T) -> T
      match @
        .some(v) => v
        .no => d

test "R13-v-v4", '''
  .some(v: [1]) .sh(h: N(a: 2)) .wk(w: ~(alive)) .maybe(m: N(a: 2)) .maybe(m: none) .str(s: "x") .vec(v: []) .some(v: .some(v: [])) 1
'''
  obj N
    a: Int

  enum Opt[T]
    some(v: T)
    no

  enum Hold
    vec(v: List[Int])
    sh(h: *N)
    wk(w: ~N)
    maybe(m: *N?)
    str(s: ?String)

  fun mk() -> Hold
    .vec(List[Int]())

  v = List[Int]()
  !v.push(1)
  a = Opt.some(<v)
  n = *N(a: 2)
  b: Hold = .sh(+n)
  c: Hold = .wk(~n)
  d: Hold = .maybe(+n)
  e: Hold = .maybe(none)
  f = Hold.str("x")
  g = mk()
  h = Opt.some(Opt.some(List[Int]()))
  xs = List[*N]()
  !xs.push(<n)
  print(a, b, c, d, e, f, g, h, xs.len)

fail "R15-p-a1", "cannot move `v` while a write loan is live"
  # write slice alive while root moved
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  w = !v[..]
  u = <v
  w[0] = 5
  print(u)

fail "R15-p-a3", "cannot reassign `v` while it is lent"
  # root reassigned
  v: List[Int] = List()
  !v.push(1)
  w = !v[..]
  v = List()
  w[0] = 5
  print(v)

fail "R15-p-a5", "use of `v` while a write loan is live"
  v: List[Int] = List()
  !v.push(1)
  w = !v[..]
  x = (!v).pop()
  w[0] = 5
  print(x)

fail "R15-p-a7", "cannot assign to `a[0]` while `a` is lent"
  # root element written
  a = [1, 2, 3]
  w = !a[..]
  a[0] = 7
  w[0] = 5
  print(a)

test "R15-p-a8", "[5, 2] [9, 4]"
  # different fields of one struct: conservative?
  obj P
    x: [2]Int
    y: [2]Int

  p = P(x: [1, 2], y: [3, 4])
  w = !p.x[..]
  p.y[0] = 9
  w[0] = 5
  print(p.x, p.y)

fail "R15-p-a9", "cannot lend `p.x` to write while a write loan is live"
  # same field twice
  obj P
    x: [2]Int

  p = P(x: [1, 2])
  w = !p.x[..]
  u = !p.x[..]
  w[0] = 5
  u[0] = 6

fail "R15-p-aa1", "`loc` does not live long enough"
  obj R
    s: []Int

  fun t() -> Bool
    true

  a = [1, 2]
  rs = [R(s: ?a[..])]
  w = !rs[..]
  if t()
    loc = [7, 7]
    w[0] = R(s: ?loc[..])
  print(rs[0].s)

fail "R15-p-aa2", "`loc` does not live long enough"
  obj R
    s: []Int

  fun t() -> Bool
    true

  a = [1, 2]
  rs = [R(s: ?a[..])]
  w = !rs[..]
  if t()
    loc = [7, 7]
    !w.fill(R(s: ?loc[..]))
  print(rs[0].s)

fail "R15-p-aa3", "`loc` does not live long enough"
  obj R
    s: []Int

  fun t() -> Bool
    true

  a = [1, 2]
  rs = [R(s: ?a[..])]
  if t()
    loc = [7, 7]
    src = [R(s: ?loc[..])]
    w = !rs[..]
    !w.copy(?src[..])
  print(rs[0].s)

fail "R15-p-aa4", "cannot store a view of `loc` through `r`: `r` views `rs`, which outlives it"
  obj R
    s: []Int

  fun t() -> Bool
    true

  a = [1, 2]
  rs = [R(s: ?a[..]), R(s: ?a[..])]
  if t()
    loc = [7, 7]
    for r in !rs[..]
      r = R(s: ?loc[..])
  print(rs[0].s)

fail "R15-p-aa5", "`loc` does not live long enough"
  obj R
    s: []Int

  fun t() -> Bool
    true

  sub put(w: ![]R, r: R)
    w[0] = r

  a = [1, 2]
  rs = [R(s: ?a[..])]
  if t()
    loc = [7, 7]
    put(!rs[..], R(s: ?loc[..]))
  print(rs[0].s)

fail "R15-p-aa6", "`loc` does not live long enough"
  obj R
    s: []Int

  fun t() -> Bool
    true

  a = [1, 2]
  rs = [R(s: ?a[..])]
  if t()
    loc = [7, 7]
    w = !rs[..]
    e = !w[0]
    e.s = ?loc[..]
  print(rs[0].s)

fail "R15-p-aa8", "`loc` does not live long enough"
  obj R
    s: []Int

  fun t() -> Bool
    true

  a = [1, 2]
  rs = [R(s: ?a[..])]
  if t()
    loc = [7, 7]
    w = !rs[..]
    !w.swap(0, 0)
    w[0].s = ?loc[..]
  print(rs[0].s)

fail "R15-p-ab1", "use of `b.v` while a write loan on `b` is live"
