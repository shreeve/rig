    b(r: Res)

  obj H
    e: E

  fun mkh(n: Int) -> H
    H(e: E.a(r: Res(n: n, t: String("x"))))

  x = match mkh(5).e
    .a(r) => ?r
    .b(r) => ?r
  print(x.n)

