test "review-step3-m06 held nested", '''
  in 5 51
  drop 51
  drop 50
  mid 5
  drop 6
  drop 5
  end
'''
  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  enum E
    a(r: Res)
    b

  obj H
    e: E
    f: E

  fun mkh(n: Int) -> H
    H(e: E.a(r: Res(n: n)), f: E.a(r: Res(n: n + 1)))

  match mkh(5).e
    .a(r)
      match mkh(r.n * 10).f
        .a(s) => print("in", r.n, s.n)
        .b => pass
      print("mid", r.n)
    .b => pass
  print("end")

fail "review-step3-m07 held ifas res", "a view of the temporary `mk(1)` outlives its statement, which drops it; bind the value to a name first"
  obj Res
    n: Int
    t: String

    drop(!@)
      print("drop", @n)

  obj Bag
    o: Res?
    p: Res?

  fun mk(n: Int) -> Bag
    Bag(o: Res(n: n, t: String("a")), p: none)

  keep = Res(n: 0, t: String("k"))
  saved = ?keep
  if mk(1).o as r
    print("in", r.n)
    saved = r
  print(saved.n)

