# Probes from past reviews and audits, 31 of 41: review-step3-l13_handle_in_field to review-step45-e12_arrayiter_vec_elems.

fail "review-step3-l13 handle in field", "cannot assign to `w.h` while `w.h` is lent"
  obj S
    n: Int
    t: String

  obj W
    h: *S

  fun keep(s: ?S) -> ?S
    s

  w = W(h: *S(n: 1, t: String("a")))
  k = keep(?w.h)
  w.h = *S(n: 2, t: String("b"))
  print(k.n)

test "review-step3-l14 handle in vec loop", '''
  1
  1
'''
  obj S
    n: Int
    t: String

  fun keep(s: ?S) -> ?S
    s

  v: List[*S] = List()
  !v.push(*S(n: 1, t: String("a")))
  for h in v
    k = keep(h)
    print(k.n)
  e: ?S = keep(?v[0])
  print(e.n)

test "review-step3-m01 held match break", '''
  drop 0
  got 1
  drop 1
  i 1
  drop 2
  drop 5
  5
  end
'''
  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  enum E
    a(r: Res)
    b

  obj H
    e: E
    tag: Int

  fun mkh(n: Int) -> H
    H(e: E.a(r: Res(n: n)), tag: n)

  fun run() -> Int
    match mkh(5).e
      .a(r)
        if r.n == 5
          return r.n
        print("no")
      .b => pass
    0

  for i in 0..3
    match mkh(i).e
      .a(r)
        if r.n == 0
          continue
        if r.n == 2
          break
        print("got", r.n)
      .b => pass
    print("i", i)
  print(run())
  print("end")

test "review-step3-m02 held guard", '''
