    e: E

  fun mkh(n: Int) -> H
    H(e: E.a(r: Res(n: n)))

  match mkh(5).e
    .a(r) if r.n > 9 => print("big", r.n)
    .a(r) => print("small", r.n)
    .b => pass
  print("end")

