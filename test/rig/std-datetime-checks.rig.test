# std.datetime: each form of `add`, `checked_add`, `with`, `round`, and
# `floor` at each kind of call, built and run, and the checks of their
# arguments where they are called (docs/design/datetime.md §10.2): no
# positional argument to a date's `add` or any `with`, at most one to a
# `DateTime`'s `add`, no time of day for a date, and the increments of
# `round` and `floor`.

use std.datetime
use std.time

test "date add forms at each kind of call", '''
  2027-02-28 2027-02-28 2027-03-07 2026-02-01 2027-01-30
  2027-02-28 2027-02-28 2027-01-31
'''
  # A method call, a call through the type with self first, each amount
  # by name, a value of an `Int` and a constant, and no amount.
  d = datetime.Date.new(2027, 1, 31)
  k = -1
  print(d.add(months: 1)!, datetime.Date.add(d, months: 1)!, d.add(weeks: 5)!, d.add(years: k, days: 1)!, d.add(days: k)!)
  print(d.add(months: 1)!, datetime.Date.add(d, months: 1)!, d.add()!)

test "datetime add forms at each kind of call", '''
  2026-03-08T02:30:01 2026-03-08T02:30:00.5 2026-03-08T04:30:00 2026-03-08T02:30:00.04 2026-03-09T02:30:00 2026-03-09T04:30:00
  2026-03-08T02:30:05 2026-03-09T02:30:02 2026-04-08T02:30:00 2026-03-08T02:30:03 2026-03-08T02:30:02 2026-03-08T02:30:00
'''
  # The duration first, bare in seconds, an `Int` or a `Float`, with a
  # unit's keyword, or a `Duration`, by position or by its name `d:`;
  # the calendar amounts by name, beside it or alone; through the type,
  # with self first; and no amount.
  dt = datetime.DateTime.parse("2026-03-08T02:30")!
  five = time.duration(5)
  print(dt.add(duration: 1)!, dt.add(duration: 0.5)!, dt.add(hours: 2)!, dt.add(ms: 40)!, dt.add(days: 1)!, dt.add(days: 1, hours: 2)!)
  print(dt.add(duration: five)!, dt.add(duration: 2, days: 1)!, datetime.DateTime.add(dt, months: 1)!, datetime.DateTime.add(dt, duration: 3)!, dt.add(duration: 2)!, dt.add()!)

test "time add forms at each kind of call", '''
  01:00:00 23:00:01 23:00:00.5 01:00:00 14:30:07.999999999
'''
  # `Time.add` wraps past midnight, so it takes any duration, the
  # longest too, and cannot fail.
  t = datetime.Time.new(23, 0, 0)
  print(t.add(hours: 2), t.add(1), datetime.Time.add(t, 0.5), datetime.Time.add(t, d: time.duration(hours: 2)), t.add(time.Duration.max()))

test "with, round, and floor forms at each kind of call", '''
  2027-01-01 08:00:00 2026-11-17T00:00:00 2027-01-31
  08:00:00 08:00:00 2026-11-17T08:00:00 2026-11-17T00:00:00 08:07:00
'''
  # Each field by name, an optional `Int` for a field; through the type
  # with self first; an increment from a variable on a `DateTime`,
  # checked as the program runs, and a constant one on a `Time`.
  d = datetime.Date.new(2027, 1, 31)
  t = datetime.Time.new(8, 7, 3)
  dt = d.at(t).with(year: 2026, month: 11, day: 17)!
  day: Int? = none
  print(d.with(day: 1, month: 1)!, t.with(minute: 0, second: 0)!, dt.with(hour: 0, minute: 0, second: 0)!, datetime.Date.with(d, day: day)!)
  k = 15
  print(t.round(hours: 1), datetime.Time.round(t, minutes: 15), dt.floor(minutes: k)!, datetime.DateTime.round(dt, days: 1)!, t.floor(minutes: 1))

fail "a date's amounts are options, given by name", "3:13: `add` of a `Date` takes its amounts as options, given by name: `add(days: 1)` for days", "4:13: `add` of a `Date` takes its amounts as options, given by name: `add(days: n)` for days", "5:28: `add` of a `Date` takes its amounts as options, given by name: `add(days: 1)` for days", "6:24: `add` of a `Date` takes its amounts as options, given by name: `add(days: 2)` for days", errors: 4
  d = datetime.Date.new(2027, 1, 31)
  n = 3
  print(d.add(1))
  print(d.add(n)!)
  print(datetime.Date.add(d, 1))
  print(d.add(months: 1, 2))

fail "a date has no time of day", "2:13: a `Date` has no time of day, so `add` takes no `hours:`: a date and a time of day is a `DateTime`, `d.at(t).add(hours: 1)`", "3:22: a `Date` has no time of day, so `add` takes no `minutes:`: a date and a time of day is a `DateTime`, `d.at(t).add(days: 1, minutes: 30)`", "4:13: a `Date` has no time of day, so `add` takes no `seconds:`: a date and a time of day is a `DateTime`, `d.at(t).add(seconds: 1)`", "5:13: a `Date` has no time of day, so `add` takes no `ns:`: a date and a time of day is a `DateTime`, `d.at(t).add(ns: 5)`", errors: 4
  d = datetime.Date.new(2027, 1, 31)
  print(d.add(hours: 1))
  print(d.add(days: 1, minutes: 30))
  print(d.add(seconds: 1)!)
  print(d.add(ns: 5))

fail "a datetime's duration and amounts are options, given by name", "3:14: `duration` has a default, so it is an option, given by name: `duration: 1`", "3:17: `years` is a field of group `period` of `add`, so it is given by name: `years: 2`", "4:14: `duration` has a default, so it is an option, given by name: `duration: 1`", "4:17: `years` is a field of group `period` of `add`, so it is given by name: `years: 2`", "4:20: `months` is a field of group `period` of `add`, so it is given by name: `months: 3`", "5:33: `duration` has a default, so it is an option, given by name: `duration: 0.5`", "5:38: `years` is a field of group `period` of `add`, so it is given by name: `years: 2`", errors: 7
  d = datetime.Date.new(2027, 1, 31)
  dt = d.at(datetime.Time.new(1, 0, 0))
  print(dt.add(1, 2)!)
  print(dt.add(1, 2, 3)!)
  print(datetime.DateTime.add(dt, 0.5, 2)!)

fail "with takes its fields by name", "3:14: `year` is a field of group `date` of `with`, so it is given by name: `year: 2024`", "4:15: `year` is a field of group `date` of `with`, so it is given by name: `year: 2024`", "5:22: `hour` is a field of group `clock` of `with`, so it is given by name: `hour: 1`", "6:37: `hour` is a field of group `clock` of `with`, so it is given by name: `hour: 1`", errors: 4
  d = datetime.Date.new(2027, 1, 31)
  dt = d.at(datetime.Time.new(1, 0, 0))
  print(d.with(2024)!)
  print(dt.with(2024, month: 1)!)
  print(dt.time().with(1)!)
  print(datetime.Time.with(dt.time(), 1)!)

fail "time and datetime round take one allowed unit", "3:15: `round` takes a unit from `ns:` to `hours:` and its increment, and `days:` is none of them", "4:24: an increment of `round` divides the next larger unit and is smaller than it, so `minutes:` takes 1, 2, 3, 4, 5, 6, 10, 12, 15, 20, or 30, and `45` is not one of them", "5:22: `round` takes `days: 1` and no other number of days, and `2` is not 1", "6:16: `round` takes a unit from `ns:` to `hours:`, or `days: 1`, and its increment, and `weeks:` is none of them", "7:20: an increment of `floor` divides the next larger unit and is smaller than it, so `ns:` takes 1, 2, 4, 5, 8, 10, 20, 25, 40, 50, 100, 125, 200, 250, or 500, and `3` is not one of them", "8:23: an increment of `round` divides the next larger unit and is smaller than it, so `hours:` takes 1, 2, 3, 4, 6, 8, or 12, and `24` is not one of them", "9:15: `ns` has a default, so it is an option, given by name: `ns: 5`", "10:26: `floor` takes one unit and its increment, not 2: name one of them, `floor(hours: 1)`", "11:27: `round` takes one unit and its increment, not 2: name one of them, `round(minutes: 1)`", "12:27: `round` takes one unit and its increment, not 2: write the increment in one unit, `round(ms: 250)`", "13:25: `round` takes one unit and its increment, not 2: name one of them, `round(days: 1)`", errors: 11
  t = datetime.Time.new(1, 0, 0)
  dt = datetime.Date.new(2027, 1, 31).at(t)
  print(t.round(days: 1))
  print(t.round(minutes: 45))
  print(dt.round(days: 2))
  print(dt.round(weeks: 1))
  print(dt.floor(ns: 3))
  print(dt.round(hours: 24))
  print(t.round(5))
  print(dt.floor(hours: 1, minutes: 1))
  print(t.round(minutes: 1, seconds: 30))
  print(t.round(seconds: 0, ms: 250))
  print(dt.round(days: 1, hours: 1))

fail "methods with options are not values", "1:19: `std.datetime.Date.add` has options, given by name, so it is not a value: write a closure that calls it", "2:23: `std.datetime.DateTime.add` has options, given by name, so it is not a value: write a closure that calls it", "3:19: `std.datetime.Time.with` has options, given by name, so it is not a value: write a closure that calls it", "5:7: method `round` must be called; wrap it in a closure to pass it as a value", errors: 4
  f = datetime.Date.add
  g = datetime.DateTime.add
  h = datetime.Time.with
  t = datetime.Time.new(1, 0, 0)
  r = t.round

test "a closure passes a checked method", '''
  2027-02-28 01:00:00
'''
  # §10.2: what a function value cannot carry, a closure can.
  d = datetime.Date.new(2027, 1, 31)
  t = datetime.Time.new(1, 7, 0)
  fun on_date(x: datetime.Date, f: ?fun(datetime.Date) -> datetime.Date!) -> datetime.Date!
    f(x)!

  fun on_time(x: datetime.Time, f: ?fun(datetime.Time) -> datetime.Time) -> datetime.Time
    f(x)

  print(on_date(d, |x| x.add(months: 1)!)!, on_time(t, |x| x.round(minutes: 15)))

fail "the parts are private", "1:14: only the standard library's module `std.datetime` can construct `std.datetime.Date`: its fields `y`, `m`, `d` are private; make one with its `pub` functions", errors: 1
  _ = datetime.Date(y: 2024, m: 2, d: 30)

test "sizes", "1 4 8 12"
  # §7.3: a `Weekday` is a byte, a `Date` four, a `Time` eight, and a
  # `DateTime` the two.
  print($size(datetime.Weekday), $size(datetime.Date), $size(datetime.Time), $size(datetime.DateTime))

fail "a date's add refuses a duration by position", "6:13: a `Date` has no time of day, so `add` takes no duration, `0.5`: a date and a time of day is a `DateTime`, `d.at(t).add(duration: 0.5)`", "7:13: a `Date` has no time of day, so `add` takes no duration, `time.duration(hours: 24)`: a date and a time of day is a `DateTime`, `d.at(t).add(duration: time.duration(hours: 24))`", "8:13: a `Date` has no time of day, so `add` takes no duration, `half`: a date and a time of day is a `DateTime`, `d.at(t).add(duration: half, days: 1)`", "9:13: `years` is a field of group `period` of `add`, so it is given by name", "10:23: a `Date` has no time of day, so `add` takes no `hours:`: a date and a time of day is a `DateTime`, `d.at(t).add(weeks: 1, hours: 2)`", errors: 6
  # A `Float` or a `Duration` by position, and a unit beside other
  # amounts, is a time of day, whose fix is a `DateTime` with every amount
  # written; any other argument by position gives an option.
  d = datetime.Date.new(2027, 1, 31)
  half = time.duration(0.5)
  print(d.add(0.5))
  print(d.add(time.duration(hours: 24)))
  print(d.add(half, days: 1)!)
  print(d.add("x")!)
  print(d.add(weeks: 1, hours: 2))

fail "a generic body cannot call a method with options", "18:7: `bump[datetime.DateTime]` cannot use `T = datetime.DateTime`: the generic body calls `x.add(d, 2, 0, 0, 0)`, and `datetime.DateTime.add` has options, given by name, which a call in a generic body cannot give; call it where its type is written, or pass a closure that does", "19:7: `next[datetime.Date]` cannot use `T = datetime.Date`: the generic body calls `x.add(0, 0, 0, 1)`, and `datetime.Date.add` has options, given by name", "20:7: `change[datetime.Date]` cannot use `T = datetime.Date`: the generic body calls `x.with(y, y, y)`, and `datetime.Date.with` has options, given by name", "21:7: `near[datetime.Time]` cannot use `T = datetime.Time`: the generic body calls `x.round(k, k, k, k, k, k)`, and `datetime.Time.round` has options, given by name", "22:7: `near[time.Duration]` cannot use `T = time.Duration`: the generic body calls `x.round(k, k, k, k, k, k)`, and `time.Duration.round` has options, given by name", errors: 5
  # A generic body passes every argument by position, so it would give
  # options by position: `x.add(d, 2, …)` on a `DateTime` would be two
  # years. A method with options is refused there, as it is as a value.
  fun bump[T](x: T, d: time.Duration?) -> T
    x.add(d, 2, 0, 0, 0)

  fun next[T](x: T) -> T
    x.add(0, 0, 0, 1)

  fun change[T](x: T, y: Int?) -> T!
    x.with(y, y, y)!

  fun near[T](x: T, k: Int?) -> T
    x.round(k, k, k, k, k, k)

  dt = datetime.DateTime.new(2027, 1, 31, hour: 1)
  d = datetime.Date.new(2027, 1, 31)
  print(bump(dt, time.duration(1)))
  print(next(d))
  print(change(d, 1)!)
  print(near(datetime.Time.new(1, 7, 0), 15))
  print(near(time.duration(90), none))

test "a generic body calls an unchecked method", '''
  01:00:01 2027-01-31T01:00:01
'''
  # `Time.add` takes one duration and checks nothing, so a generic body
  # may call it; a closure carries a checked one.
  fun later[T](x: T, d: time.Duration) -> T
    x.add(d)

  fun apply[T](x: T, f: ?fun(T) -> T!) -> T!
    f(x)!

  print(later(datetime.Time.new(1, 0, 0), time.duration(1)), apply(datetime.DateTime.new(2027, 1, 31, hour: 1), |x| x.add(duration: 1)!)!)

test "datetime add of several units", '''
  2026-03-09T05:00:00 2026-03-09T04:00:00 2026-03-08T02:59:59.5
  2026-03-09T05:00:00 range 2026-03-07T02:00:00
'''
  # §5.2 and §6.2: several unit keywords add up into the duration, each
  # of either sign, beside the calendar amounts, applied after them.
  fun step(dt: datetime.DateTime, h: Int) -> String
    r = dt.add(hours: h, minutes: 30, days: 0) catch return String("range")
    String(r)

  dt = datetime.DateTime.parse("2026-03-08T02:30")!
  print(dt.add(days: 1, hours: 2, minutes: 30)!, dt.add(days: 1, hours: 2, minutes: -30)!, dt.add(minutes: 30, seconds: -0.5)!)
  top = datetime.DateTime.new(9999, 12, 31, hour: 22)
  print(dt.add(days: 1, hours: 2, minutes: 30)!, step(top, 2), dt.add(days: -1, hours: -1, minutes: 30)!)

fail "two units on a time or a datetime get one increment it takes", "3:27: `round` takes one unit and its increment, not 2: name one unit and an increment it takes, `round(minutes: 6)`", "4:26: `floor` takes one unit and its increment, not 2: name one unit and an increment it takes, `floor(hours: 4)`", "5:28: `round` takes one unit and its increment, not 2: name one unit and an increment it takes, `round(seconds: 6)`", errors: 3
  t = datetime.Time.new(1, 0, 0)
  dt = datetime.Date.new(2027, 1, 31).at(t)
  print(t.round(minutes: 7, seconds: 1))
  print(dt.floor(hours: 5, minutes: 1))
  print(dt.round(seconds: 7, ms: 1))

fail "an unknown keyword where a duration option is", "2:14: `add` has no parameter `delay`; its duration is an option, given by name, `duration: 2`, or by units' keywords", errors: 1
  dt = datetime.DateTime.new(2026, 1, 2, hour: 3)
  print(dt.add(delay: 2)!)
