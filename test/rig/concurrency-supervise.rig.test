# concurrency: tests whose names start `supervise`.
use std.task

test "supervise restarts", seeds: 20, '''
  30 3
  Flaky.down
  -2 2
  9 3
  -4 2
'''
  # `task.supervise` runs its function isolated, and runs it again when
  # it fails or panics, up to `restarts:` times within `per:`; past that
  # it fails as the last run failed.
  use std.time

  error Flaky
    down

  fun attempt(tries: *Cell[Int]) -> Int!
    n = (!tries).add(1)
    if n < 3
      return Flaky.down
    n * 10

  fun boom(tries: *Cell[Int]) -> Int
    n = (!tries).add(1)
    [9][n - 3]

  tries = *Cell(0)
  print(task.supervise(|+tries| attempt(+tries)!) catch -1, tries.get())
  t2 = *Cell(0)
  r = task.supervise(|+t2| attempt(+t2)!, restarts: 1) catch |e|
    print(e)
    -2
  print(r, t2.get())
  t3 = *Cell(0)
  print(task.supervise(|+t3| boom(+t3), restarts: 5) catch -3, t3.get())
  t4 = *Cell(0)
  print(task.supervise(|+t4| boom(+t4), restarts: 1, per: 1) catch -4, t4.get())

test "supervise stops", seeds: 20, "Stop.timeout 1"
  # A deadline is no failure to start again from.
  use std.time

  fun slow(tries: *Cell[Int]) -> Int!
    !tries.add(1)
    time.sleep(1)!
    1

  fun guarded(tries: *Cell[Int]) -> Int!
    task.supervise(|+tries| slow(+tries)!)!

  tries = *Cell(0)
  r = time.within[Int](ms: 5, |+tries| guarded(+tries)!) catch |e|
    print(e, tries.get())
    -1
  _ = r

fail "supervise options", "`task.supervise` takes the function to run, then `restarts:` and `per:`"
  _ = task.supervise(|| 1, retries: 3) catch 0

fail "supervise lends nothing to write", "`task.supervise` drops what a panic in it half-changed"
  n = 0
  _ = task.supervise(|!n| n) catch 0

test "supervise restarts after a String it grew", seeds: 20, "800 2"
  # A run that panics in a function lent a String it made, after the
  # String grew past several buffers, leaves that String to the panic;
  # the next run makes its own.
  sub fill(out: !String, n: Int, last: Int)
    for i in 0..n
      !out.push[U64, .big](U64(i))
    !out.push(U8([1, 2, 3][last]))

  fun attempt(tries: *Cell[Int]) -> Int
    k = (!tries).add(1)
    s = String()
    fill(!s, 100, 5 - 2 * k)
    s.len - 1

  tries = *Cell(0)
  print(task.supervise(|+tries| attempt(+tries)) catch -1, tries.get())

test "supervise a remake that panics answers the call it took", seeds: 20, timeout: 20, whole: true, '''
  -1
  -2
  true
'''
  # A supervised actor's runner makes its value again for the call it
  # took; a panic there ends the actor, and that call panics in its
  # caller rather than wait for ever.
  use std.task
  use std.time

  obj Rooms
    n: Int

    fun slow(?@) -> Int
      s = 0
      for i in 0..40_000_000
        s += i % 3
      s

    fun pick(?@, i: Int) -> Int
      [1, 2][i] + @n

  fun make(made: *Cell[Int]) -> Rooms
    k = (!made).add(1)
    Rooms(n: [7][k - 1])

  fun hold(r: *Actor[Rooms]) -> Int
    r.slow()

  fun bad(r: *Actor[Rooms]) -> Int
    task.isolate(|+r| r.pick(5)) catch -1

  fun good(r: *Actor[Rooms]) -> Int
    task.isolate(|+r| r.pick(0)) catch -2

  sub main()!
    made = *Cell(0)
    r = *Actor.supervised(*|+made| make(+made))
    a = hold(+r)&
    time.sleep(ms: 5)!
    b = bad(+r)&
    time.sleep(ms: 1)!
    c = good(+r)&
    print(>b)
    print(>c)
    print(>a > 0)

fail "supervise option given twice", "7:52: parameter `restarts` of `task.supervise` is given twice", errors: 1
  use std.task

  sub work()
    print(1)

  sub main()
    task.supervise(work, restarts: 2, per: 0.000001, restarts: 3) catch |e| print(e)

test "a supervised actor starts again once what its method started has ended", seeds: 20, '''
  made
  read 5
  made
  -1 5
'''
  # The task views the value the panic abandoned, in the place the new
  # value is made, so the value is made again only once the task has
  # ended.
  use std.task
  use std.time

  sub nap(ms: Int)
    time.sleep(ms: ms) catch |_|
      return

  sub reader(s: ?Int)
    nap(20)
    print("read", s)

  obj S
    n: Int

    sub slow(!@)
      nap(20)

    fun work(?@) -> Int
      t = reader(?@n)&
      panic("mid") if @n > 0
      >t
      1

    fun get(?@) -> Int
      @n

  fun mk() -> S
    print("made")
    S(n: 5)

  sub first(a: *Actor[S])
    !a.slow()

  fun later(a: *Actor[S]) -> Int
    nap(5)
    a.get()

  a = *Actor.supervised(*|| mk())
  t = first(+a)&
  time.sleep(ms: 5)!
  v = later(+a)&
  time.sleep(ms: 2)!
  u = task.isolate(|+a| a.work()) catch -1
  >t
  print(u, >v)

test "a task queued on the supervised actor that started it cannot hold up its restart", seeds: 20, timeout: 20, '''
  -1
  5
'''
  # The task's call waits behind the method that panics, and the restart
  # waits for the task, so its call fails as one to a dead actor.
  use std.task
  use std.time

  sub nap(ms: Int)
    time.sleep(ms: ms) catch |_|
      return

  sub ring(a: *Actor[S])
    print(a.get())

  obj S
    n: Int

    sub slow(!@)
      nap(20)

    fun work(?@, a: *Actor[S]) -> Int
      t = ring(+a)&
      nap(10)
      panic("mid") if @n > 0
      >t
      1

    fun get(?@) -> Int
      @n

  sub first(a: *Actor[S])
    !a.slow()

  a = *Actor.supervised(*|| S(n: 5))
  t = first(+a)&
  time.sleep(ms: 5)!
  u = task.isolate(|+a| a.work(+a)) catch -1
  print(u)
  >t
  print(a.get())

test "a task that calls the supervised actor during its restart cannot hold it up", seeds: 20, timeout: 20, '''
  -1
  5
'''
  # As above, with the call made after the panic has begun to stop it.
  use std.task
  use std.time

  sub nap(ms: Int)
    time.sleep(ms: ms) catch |_|
      return

  sub ring(a: *Actor[S])
    nap(30)
    print(a.get())

  obj S
    n: Int

    sub slow(!@)
      nap(20)

    fun work(?@, a: *Actor[S]) -> Int
      t = ring(+a)&
      panic("mid") if @n > 0
      >t
      1

    fun get(?@) -> Int
      @n

  sub first(a: *Actor[S])
    !a.slow()

  a = *Actor.supervised(*|| S(n: 5))
  t = first(+a)&
  time.sleep(ms: 5)!
  u = task.isolate(|+a| a.work(+a)) catch -1
  print(u)
  >t
  print(a.get())
