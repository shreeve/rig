test "h1-b", "4 4"
  sub f(w2: !Int)
    new w = w2
    w += 1
    w2 += 1
    print(w, w2)

  m = 3
  f(!m)

fail "h1-c", "bare use of write view `w2` in binding would copy a write view, which is unique; use `<w2` to move it"
  sub f(w2: !Int)
    w: !Int = w2
    w += 1
    w2 += 1

  m = 3
  f(!m)
  print(m)

test "h1-k", '''
  4 3
  3
  3
'''
  sub f(w2: !Int)
    x = w2
    x += 1
    print(x, w2 + 0)
    y: Int = w2
    print(y)

  m = 3
  f(!m)
  print(m)

test "h1-p", '''
  2 3 3 1 2
  1 2
'''
  sub f(w2: !Int, w3: !Int, c: Bool)
    x = while true
      break w2
    y = for _ in 0..3
      break w3 if c
    else
      w2
    z: Int = while true
      break w3
    x += 1
    y += 1
    z += 1
    print(x, y, z, w2, w3)

  n = 1
  m = 2
  f(!n, !m, true)
  print(n, m)

test "hf6-generic-read-view-rebound", "5"
  # A generic method `left(?@, other: ?T) -> ?T` at `T = Int`, its result
  # bound to a name that held a lend of a place.
  obj Pair[T]
    x: T

    fun left(?@, other: ?T) -> ?T
      ?@x

  p = Pair(x: 5)
  q = ?p.x
  o = 6
  q = ?p.left(?o)
  print(q)

test "lamassign-t", "18 4"
  sub each(xs: []Int, f: ?sub(Int))
    for x in xs
      f(x)

  v = [5, 3, 9, 1]
  total = 0
  each(?v, |!total, n| total += n)
  count = 0
  each(?v, |!count, n| count = count + 1)
  print(total, count)

test "lead-s45-f1 for write temp path", "abcdefghijklmnopqrstuvwxyz0123456789"
  fun idx(s: ?String) -> Int
    0

  v: List[List[String]] = List()
  inner: List[String] = List()
  !inner.push(String("a"))
  !v.push(<inner)
  for t in !v[idx(?String("k"))]
    !t.add("bcdefghijklmnopqrstuvwxyz0123456789")
  for t in v[0]
    print(t)

test "lead-s45-f4 for write temp path array", "9 9"
  fun idx(s: ?String) -> Int
    0

  v: List[[2]Int] = List()
  !v.push([1, 2])
  for x in !v[idx(?String("k"))]
    x = 9
  print(v[0][0], v[0][1])

test "lead-s45-f5 for write temp path array text", "abcdefghijklmnopqrstuvwxyz0123456789"
  fun idx(s: ?String) -> Int
    0

  v: List[[1]String] = List()
  !v.push([String("a")])
  for t in !v[idx(?String("k"))]
    !t.add("bcdefghijklmnopqrstuvwxyz0123456789")
  print(v[0][0])

test "lead-s45-f7 for temp path nested array", "9 9"
  fun idx(s: ?String) -> Int
    0

  a = [[1, 2], [3, 4]]
  for x in !a[idx(?String("k"))]
    x = 9
  print(a[0][0], a[0][1])

fail "lead-s45-g1 push loop elem", "`copy_all[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  sub copy_all[T](v: ?List[T], out: !List[T]) keeps v
    for x in v
      !out.push(x)

  v: List[String] = List()
  !v.push(String("a"))
  out: List[String] = List()
  copy_all(?v, !out)
  print(out.len)

fail "lead-s45-g3 store loop elem", "`keep[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  obj Keep[T]
    item: T?

  sub keep[T](v: ?List[T], k: !Keep[T]) keeps v
    for x in v
      k.item = x

  v: List[String] = List()
  !v.push(String("a"))
  k = Keep[String](item: none)
  keep(?v, !k)
  print(v.len)

test "optwrite-ok03-ifas-param", "new"
  obj H
    s: ?String

    sub keep(!@, v: ?String) keeps v
      @s = v

  sub set(w: (!H)?, v: ?String) keeps v
    if <w as x
      x.s = v
      !x.keep(v)

  t = String("outer")
  u = String("new")
  h = H(s: ?t)
  set(!h, ?u)
  print(h.s)

test "optwrite-ok05-local-copy", '''
  outer
  outer
'''
  obj H
    s: ?String

    sub keep(!@, v: ?String) keeps v
      @s = v

  sub set(w: (!H)?)
    d = String("local")
    if <w as x
      k = H(s: ?d)
      k.s = x.s
      print(k.s)

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

test "optwrite-ok07-own-field", "outer"
  obj H
    s: ?String

    sub keep(!@, v: ?String) keeps v
      @s = v

  sub set(w: (!H)?)
    if <w as x
      x.s = x.s

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

test "optwrite-ok08-returned", "y"
  obj H
    s: ?String

    sub keep(!@, v: ?String) keeps v
      @s = v

  fun set(w: (!H)?) -> (!H)?
    x = <w ?? return none
    x.s = "s"
    x

  t = String("outer")
  h = H(s: ?t)
  if set(!h) as y
    y.s = "y"
  print(h.s)

