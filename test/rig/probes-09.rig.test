fail "optwrite-relax-p04-match-write-chain", "`d` does not live long enough"
  obj K
    a: ?String

    sub put(!@, v: ?String) keeps v
      @a = v

  enum E
    one(k: K)
    nothing

  t = String("outer")
  e: E = .one(k: K(a: ?t))
  match !e
    .one(k: x)
      w = !x
      d = String("local")
      !w.put(?d)
    .nothing => pass
  match e
    .one(k: y) => print(y.a)
    .nothing => pass

fail "optwrite-relax-p05-match-via-view", "`d` does not live long enough"
  obj K
    a: ?String

    sub put(!@, v: ?String) keeps v
      @a = v

  enum E
    one(k: K)
    nothing

  sub putk(k: !K, v: ?String) keeps v
    k.a = v

  t = String("outer")
  e: E = .one(k: K(a: ?t))
  if true
    w = !e
    match !w
      .one(k: x)
        d = String("local")
        !x.put(?d)
      .nothing => pass
  if true
    w = !e
    match !w
      .one(k: x)
        d = String("local2")
        putk(!x, ?d)
      .nothing => pass
  match e
    .one(k: y) => print(y.a)
    .nothing => pass

