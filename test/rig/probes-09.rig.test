test "fold-write-match-ok", '''
  .full(t: "ab")
'''
  # The fold: a String that views a Text slot (write-match-ok): rejected, or runs sanitizer-clean.
  enum E
    full(t: String)
    empty

  obj H
    t: String

  e = E.full(t: String("a"))
  match !e
    .full(p) => !p.add("b")
    .empty => pass
  print(e)

test "fr2", '''
  3.4028235e38 255 -3.4028235e38
  0
'''
  use util

  sub main()
    p = util.P()
    print(p.a, p.b, p.c)
    print(util.f())

  sub g()
    print(util.Real.max)

  file "util.rig"
    pub type Real = F32
    pub type Byte = U8

    pub obj P
      pub a: F32 = F32.max
      pub b: U8 = Byte.max
      pub c: F32 = F32.min

    pub fun f(x: U8 = Byte.min) -> U8
      x

test "frameowners-defer-exits", '''
  2
  1
'''
  # A `defer` body is written at each exit it covers: one call of a helper
  # the rule would inline there, at 1,200 exits, ran off the stack.
  fun w(i: Int) -> Int
    t = [7000 of 0]
    for k in 0..7000
      t[k] = k + i
    t[i % 7000]

  fun exits(i: Int) -> Int
    defer print(w(i))
    return 1 if i == 10001
    return 2 if i == 10002
    return 3 if i == 10003
    return 4 if i == 10004
    return 5 if i == 10005
    return 6 if i == 10006
    return 7 if i == 10007
    return 8 if i == 10008
    return 9 if i == 10009
    return 10 if i == 10010
    return 11 if i == 10011
    return 12 if i == 10012
