fail "fold-guard", "cannot reassign `e` while it is lent"
  # The fold: a String that views a Text slot (guard): rejected, or runs sanitizer-clean.
  enum E
    full(t: String)
    empty

  obj H
    t: String

  e = E.full(t: String("hello"))
  keep: ?String = ""
  match ?e
    .full(p) if p.len > 2 => keep = p
    _ => pass
  e = E.empty
  print(keep)

fail "fold-oracle-b05-ifas-field-assign", "cannot reassign `h` while `h.o` is lent"
  # bad: if ?h.o as p, keep bytes, reassign holder
  obj H
    o: String?

  h = H(o: String("abc"))
  keep: ?String = ""
  if ?h.o as p
    keep = p
  h = H(o: none)
  print(keep)

fail "fold-oracle-b06-whileas-assign-in-loop", "cannot reassign `o` while it is lent"
  # bad: while ?o as p, reassign o inside body while p used after
  o: String? = String("a")
  n = 0
  while ?o as p
    o = String("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    print(p)
    n += 1
    if n > 2
      break

fail "fold-oracle-b12-optional-coalesce", "cannot reassign `o` while it is lent"
  # bad: if ?o as p ... else "d" value, then o = none
  o: String? = String("abc")
  s: ?String = if ?o as p
    p
  else
    "d"
  o = none
  print(s)

fail "fold-oracle-f03-ifas-ret-field", "cannot return a view of `h`, which this function was not lent"
  # bad: return bytes bound by if ?h.o as p of a local holder
  obj H
    o: String?

  fun f() -> ?String
    h = H(o: String("abc"))
    if ?h.o as p
      return p
    "none"

  print(f())

fail "fold-oracle-f04-whileas-field-drop", "cannot drop `h` while `h.o` is lent"
  # bad: while ?h.o as p keeps bytes, then drop h
  obj H
    o: String?

  h = H(o: String("abc"))
  keep: ?String = ""
  while ?h.o as p
    keep = p
    break
  <h
  print(keep)

fail "fold-oracle-f06-ifas-vec-opt-elem", "cannot lend `v` to write while a read loan is live"
  # bad: if ?v[0] as p over List[Text?], keep, then clear
  v: List[String?] = List()
  !v.push(String("abc"))
  keep: ?String = ""
  if ?v[0] as p
    keep = p
  !v.clear()
  print(keep)

test "fold-order-i01c-named-args-qtext-param", '''
  8046 1
  
'''
  # order (fold regression): a `?String` parameter; main emitted &t (safe), the fold emits t.bytes() before grow
  fun grow(t: !String) -> Int
    for _ in 0..200
      !t.add("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")
    1

  sub show(s: ?String, n: Int)
    print(s.len, n)
    print(s)

  t = String("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJ")
  show(n: grow(!t), s: ?t)

fail "fold-ret-closure-bad", "an owned closure cannot capture a view of `t`: it can be stored anywhere, so it could outlive `t`; capture an owned value, or use a stack closure (`|...|`)"
  # The fold: a String that views a Text slot (ret-closure-bad): rejected, or runs sanitizer-clean.
  enum E
    full(t: String)
    empty

  obj H
    t: String

  fun f() -> *sub()
    t = String("a")
    *|?t| print(t)

  g = f()
  g()

fail "fold-ret-ifas-local-bad", "cannot return a view of `o`, which this function was not lent"
