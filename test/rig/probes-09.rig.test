fail "optwrite-r02b-fallible-bang", "cannot store a view of `d` through `must(<w)!`: `w` outlives it"
  obj H
    s: ?String

    sub keep(!@, v: ?String) keeps v
      @s = v

  error E
    bad

  fun must(w: (!H)?) -> (!H)!
    <w ?? return E.bad

  fun set(w: (!H)?) -> Int!
    d = String("local")
    must(<w)!.s = ?d
    0

  t = String("outer")
  h = H(s: ?t)
  print(set(!h) catch 1)
  print(h.s)

