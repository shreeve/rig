test "frameowners-drop-pile", '''
  0
  1688700
'''
  # A `drop` body is a frame owner: 1,300 calls of a helper the rule would
  # inline there ran off the stack.
  fun w(i: Int) -> Int
    t = [7000 of 0]
    for k in 0..7000
      t[k] = k + i
    t[i % 7000]

  obj Res
    n: Int

    drop(!@)
      i = @n
      s = 0
      s += w(i + 0) + w(i + 1) + w(i + 2) + w(i + 3) + w(i + 4) + w(i + 5) + w(i + 6) + w(i + 7) + w(i + 8) + w(i + 9)
      s += w(i + 10) + w(i + 11) + w(i + 12) + w(i + 13) + w(i + 14) + w(i + 15) + w(i + 16) + w(i + 17) + w(i + 18) + w(i + 19)
