fail "optwrite-relax-p10-headers", "`d` does not live long enough"
  obj K
    a: ?String

    sub put(!@, v: ?String) keeps v
      @a = v

  t = String("outer")
  o: K? = K(a: ?t)
  arr: [2]K = [K(a: ?t), K(a: ?t)]
  l: List[K] = List()
  !l.push(K(a: ?t))
  if true
    w = !o
    if !w as x
      y = !x
      d = String("d1")
      !y.put(?d)
  if true
    w = !arr
    for x in !w
      y = !x
      d = String("d2")
      !y.put(?d)
  if true
    w = !o
    while !w as x
      d = String("d4")
      !x.put(?d)
      break
  print(o, arr[0].a, l[0].a)

fail "optwrite-relax-p12-closure-body", "`d` does not live long enough"
  obj K
    a: ?String

    sub put(!@, v: ?String) keeps v
      @a = v

  t = String("outer")
  k = K(a: ?t)
  f = |!k|
    d = String("d1")
    !k.put(?d)
  f()
  g = |!k|
    d = String("d2")
    y = !k
    !y.put(?d)
  g()
  h = |!k|
    d = String("d3")
    inner = |!k, ?d| !k.put(d)
    inner()
  h()
  print(k.a)

test "optwrite-relax-p13-accept-mix", '''
  outer local1
  outer
  local2 outer
  local3 outer
  outer local4
  outer
'''
  obj H
    s: ?String

  obj K
    a: ?String
    b: ?String

    sub put(!@, v: ?String) keeps v
      @b = v

  fun mk(w: !H) -> K
    K(a: w.s, b: "")

  sub viaReturn(h: !H)
    if true
      k = mk(!h)
      d = String("local1")
      !k.put(?d)
      print(k.a, k.b)
    print(h.s)

  sub viaSwap(w: !H)
    d = String("local2")
    a = K(a: w.s, b: "")
    b = K(a: ?d, b: ?d)
    swap(!a, !b)
    print(a.a, b.a)

  sub viaReplace(w: !H)
    d = String("local3")
    a = K(a: w.s, b: "")
    old = replace(!a, K(a: ?d, b: ""))
    print(a.a, old.a)

  sub viaOpt(w: (!H)?)
    d = String("local4")
    if w as r
      k = K(a: r.s, b: "")
      !k.put(?d)
      print(k.a, k.b)

  t = String("outer")
  h = H(s: ?t)
  viaReturn(!h)
  viaSwap(!h)
  viaReplace(!h)
  viaOpt(!h)
  print(h.s)

test "optwrite-relax-p14-view-of-copy", '''
  outer local
  outer
'''
  obj H
    s: ?String

  obj K
    a: ?String
    b: ?String

    sub put(!@, v: ?String) keeps v
      @b = v

  sub ok(p: !H)
    d = String("local")
    k = K(a: p.s, b: "")
    w = !k
    !w.put(?d)
    print(k.a, k.b)

  t = String("outer")
  h = H(s: ?t)
  ok(!h)
  print(h.s)

fail "optwrite-review-a01-cross-param-ok", "cannot store a view of `x` through `g ?? return`: `g` outlives it"
  obj H
    n: String

  obj G
    r: ?String

  sub set(w: (!H)?, g: (!G)?)
    x = <w ?? return
    (g ?? return).r = ?x.n

  h = H(n: String("caller"))
  g = G(r: "")
  set(!h, !g)
  print(g.r)

fail "optwrite-review-a02-cross-param-ifas-ok", "cannot store a view of `x` in `y.r`: `y` outlives it"
  obj H
    n: String

  obj G
    r: ?String

  sub set(w: (!H)?, g: (!G)?)
    if <w as x
      if <g as y
        y.r = ?x.n

  h = H(n: String("caller"))
  g = G(r: "")
  set(!h, !g)
  print(g.r)
