test "pub fun private type", "42"
  # A `pub fun` may return a private struct: the importer holds the value
  # and reads its fields, though it cannot name the type.
  use a

  sub main()
    s = a.make_secret()
    print(s.value)

  file "a.rig"
    # `Secret` is private, but the public `make_secret` returns it.

    obj Secret
      pub value: Int

    pub fun make_secret() -> Secret
      Secret(value: 42)

