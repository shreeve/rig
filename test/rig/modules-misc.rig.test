test "generic instance identity", "5 6 [1, 2]"
  # An instance of a generic type is one type in every module that reaches
  # it, whichever module spells it: `a.make()` returns the `lib.Wrap[Int]`
  # that `b.take` and `lib.unbox` take. A module that reaches the type
  # only through another (`c`, through `a`) holds it all the same.

  use lib
  use a
  use b
  use c

  sub main()
    x = a.make(4)
    y: lib.Wrap[Int] = a.make(6)
    print(b.take(x), lib.unbox(y), c.pair(1))

  file "a.rig"
    use lib

    pub fun make(n: Int) -> lib.Wrap[Int]
      lib.Wrap(v: n)

  file "b.rig"
    use lib

    pub fun take(x: lib.Wrap[Int]) -> Int
      x.v + 1

  file "c.rig"
    use a

    pub fun pair(n: Int) -> [2]Int
      wraps = [a.make(n), a.make(n + 1)]
      [wraps[0].v, wraps[1].v]

  file "lib.rig"
    pub obj Wrap[T]
      pub v: T

    pub fun unbox[T](b: Wrap[T]) -> T
      b.v

test "generic method own param", '''
  1 x
  1
'''
  # Another module's public generics may use instances of their own types
  # at a method's own parameter (`Chain[Pair[T, U]]` in `zip[U]`, and a
  # private `Wrap[Pair[T, U]]` in `tag[U]`): these do not nest themselves.

  use lib

  sub main()
    a: List[Int] = List()
    !a.push(1)
    b: List[?String] = List()
    !b.push("x")
    l = lib.Chain(items: <a)
    m = lib.Chain(items: <b)
    z = ?l.zip(?m)
    print(z.items[0].a, z.items[0].b)
    print(lib.tagged(3))

  file "lib.rig"
    pub obj Pair[A, B]
      pub a: A
      pub b: B

    pub obj Chain[T]
      pub items: List[T]

      pub fun zip[U](?self, other: ?Chain[U]) -> Chain[Pair[T, U]]
        out: List[Pair[T, U]] = List()
        i = 0
        while i < self.items.len and i < other.items.len
          !out.push(Pair(a: self.items[i], b: other.items[i]))
          i += 1
        Chain(items: <out)

    obj Wrap[T]
      v: T

      fun tag[U](?self, u: U) -> Wrap[Pair[T, U]]
        Wrap(v: Pair(a: self.v, b: u))

    pub fun tagged[T](x: T) -> Int
      w = Wrap(v: x)
      t = w.tag(true)
      1 if t.v.b else 0

test "generic methods across modules", '''
  tag 3
  tag s
  5 true x 3
'''
  # A generic method of another module's type, public or reached through
  # a public one, is called as a local one is; so is a public generic
  # function, and a private one serves its own module.

  use lib

  sub main()
    t = lib.Tagger(label: "tag")
    t.show(3)
    t.show[?String]("s")
    o = lib.make_outer(2)
    print(o.i.same(5), o.i.same(true), lib.same("x"), lib.uses_local(3))

  file "lib.rig"
    pub fun same[T](x: T) -> T
      x

    pub obj Tagger
      pub label: ?String

      pub sub show[T](?self, x: T)
        print(self.label, x)

    fun local[T](x: T) -> T
      x

    obj Inner
      n: Int

      pub fun same[U](?self, x: U) -> U
        x

    pub obj Outer
      pub i: Inner

    pub fun uses_local(n: Int) -> Int
      local(n)

    pub fun make_outer(n: Int) -> Outer
      Outer(i: Inner(n: n))

test "generic type across modules", '''
  3 3 1
  1 1 1
  s 2.5
  1 true s 7
  some 7
  7 9 x
  3 1
  5 2
'''
  # Another module's generic type is named, constructed, and used as a
  # local one is: `lib.Wrap[Int]` in a type or an expression, with its
  # type arguments given or inferred, and its methods and variants.

  use lib

  sub show(b: lib.Wrap[Int])
    print(b.v, b.get(), b.count)

  sub main()
    a = lib.Wrap[Int](v: 3)
    s = lib.Wrap(v: "s")
    b: lib.Wrap[Int] = lib.Wrap[Int].make(1)
    c = lib.Wrap.make(2.5)
    show(a)
    show(b)
    print(s.get(), c.get())
    p = b.with[Bool](true)
    q = ?s.with(7)
    print(p.first, p.second, q.first, q.second)
    o = lib.Opt[Int].some(value: 7)
    n: lib.Opt[Int] = .nothing
    match o
      .some(value) => print("some", value)
      .nothing => print("none")
    print(o.or(0), n.or(9), lib.Opt[?String].nothing.or("x"))
    v = List[lib.Wrap[Int]]()
    !v.push(a)
    !v.push(lib.Wrap(v: 5, count: 2))
    for x in ?v
      print(x.v, x.count)

  file "lib.rig"
    pub obj Wrap[T]
      pub v: T
      pub count: Int = 1

      pub fun make(v: T) -> Self
        Wrap(v: v)

      pub fun get(?self) -> T
        self.v

      pub fun with[U](?self, u: U) -> Pair[T, U]
        Pair(first: self.v, second: u)

    pub obj Pair[A, B]
      pub first: A
      pub second: B

    pub enum Opt[T]
      some(value: T)
      nothing

      pub fun or(?self, d: T) -> T
        match self
          .some(value) => value
          .nothing => d

