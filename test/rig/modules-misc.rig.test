test "read only field", '''
  2 [3, 4] 7 4
  2 2 7
  tag 3
  tag 4
  busy
  last 4
  8
  1
  10
'''
  # A field declared `pub ?name: T` is read by any module and written only
  # by its own: here it is read, lent to read, walked, and matched, and
  # changed only through the methods of its module. A plain `pub` field
  # stays writable.

  use lib

  sub show(t: ?lib.Tally)
    print(t.count, t.tags.len, t.inner.n)

  sub main()
    t = lib.Tally()
    !t.bump(3)
    !t.bump(4)
    print(t.count, t.tags, t.inner.n, t.last)
    show(?t)
    for g in ?t.tags
      print("tag", g)
    if t.mode as m
      match m
        .idle => print("idle")
        .busy => print("busy")
    if t.last as l
      print("last", l)
    t.note = 7
    t.note += 1
    print(t.note)
    b = ^lib.Tally()
    !b.bump(1)
    print(b.count)
    print(lib.fresh().count)

  file "lib.rig"
    # A tally whose fields other modules read and only this module writes.

    pub obj Inner
      pub n: Int = 0

    pub enum Mode
      idle
      busy

    pub obj Tally
      pub ?count: Int = 0
      pub ?tags: List[Int] = List()
      pub ?inner: Inner = Inner()
      pub ?mode: Mode? = none
      pub ?last: Int? = none
      pub note: Int = 0

      pub sub bump(!self, tag: Int)
        self.count += 1
        !self.tags.push(tag)
        self.inner.n += tag
        self.mode = Mode.busy
        self.last = tag

    pub fun fresh() -> Tally
      t = Tally()
      t.count = 10
      t

test "read only field handle", "5"
  # Read-only stops at a shared handle: a `pub ?h: *Cell[Int]` field is
  # not reassigned from another module, but the Cell it shares changes by
  # a marked call, since a handle is only read.

  use lib

  sub main()
    t = lib.make()
    !t.h.set(5)
    print(t.h.get())

  file "lib.rig"
    pub obj Holder
      pub ?h: *Cell[Int]

    pub fun make() -> Holder
      Holder(h: *Cell(0))

fail "read only field header", "9:5: cannot assign through a read view (`?T`); `b` is a read view of the value inside `t.boxed`, and field `boxed` of `lib.Tally` is read-only outside module `lib`, so nothing here writes through it", errors: 1
  # A header that reads a read-only field binds a read view, and the hint
  # does not suggest the write form, which the field rejects too.

  use lib

  sub main()
    t = lib.make()
    if t.boxed as b
      b.n = 9

  file "lib.rig"
    pub obj Inner
      pub n: Int = 0
      pub name: String = String()

    pub obj Tally
      pub ?boxed: ^Inner? = none

    pub fun make() -> Tally
      Tally(boxed: ^Inner())

fail "read only field writes", "14:5: cannot assign to `w.count`: field `count` of `lib.Tally` is read-only outside module `lib`, which declares it `pub ?count`", "18:5: cannot assign to `t.count`: field `count` of `lib.Tally` is read-only outside module `lib`", "19:5: cannot assign to `t.inner.n`: field `inner` of `lib.Tally` is read-only outside module `lib`", "20:5: cannot assign to `t.count`", "21:10: cannot lend `t.count` to write", "22:10: cannot take `t.last`", "23:6: cannot lend `t.tags` to write", "25:11: cannot lend `t.count` to write", "26:18: cannot lend `t.count` to write", "27:15: cannot write-iterate `t.tags`", "29:9: cannot lend `t.mode` to write", "32:5: cannot assign to `b.count`", "37:7: only module `lib` can construct `lib.Tally`: its fields `count`, `tags`, `inner`, `mode`, `last` are read-only", errors: 13
  # A field declared `pub ?name: T` in another module is read-only here,
  # however it would be written: assigned, or a part of it assigned;
  # assigned by an operator; lent to write; taken out; written by a method
  # that writes its receiver; exchanged; walked or matched to write; and
  # written through a box or a write view. Nor does it set one by
  # constructing the object with its fields given.

  use lib

  sub set(n: !Int)
    n = 1

  sub through(w: !lib.Tally)
    w.count = 9

  sub main()
    t = lib.Tally()
    t.count = 1
    t.inner.n = 2
    t.count += 1
    set(!t.count)
    x = <t.last
    !t.tags.push(5)
    y = 0
    swap(!t.count, !y)
    z = replace(!t.count, 3)
    for g in !t.tags
      g += 1
    if !t.mode as m
      m = lib.Mode.idle
    b = ^lib.Tally()
    b.count = 4
    through(!t)
    print(x, y, z)

  fun make() -> lib.Tally
    lib.Tally(count: 5, note: 1)

  file "lib.rig"
    # A tally whose fields other modules read and only this module writes.

    pub obj Inner
      pub n: Int = 0

    pub enum Mode
      idle
      busy

    pub obj Tally
      pub ?count: Int = 0
      pub ?tags: List[Int] = List()
      pub ?inner: Inner = Inner()
      pub ?mode: Mode? = none
      pub ?last: Int? = none
      pub note: Int = 0

      pub sub bump(!self, tag: Int)
        self.count += 1
        !self.tags.push(tag)
        self.inner.n += tag
        self.mode = Mode.busy
        self.last = tag

    pub fun fresh() -> Tally
      t = Tally()
      t.count = 10
      t

