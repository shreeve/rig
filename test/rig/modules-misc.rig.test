test "pub members", '''
  bumped a 1
  bumped a 6
  a 6 6
  0 h
  bumped b 1
  1 b
  1 2 x
  circle 3 3
  0
'''
  # A struct's or enum's `pub` fields and methods are visible to other
  # modules, through a value, a view, a `*T` handle, a `Box`, and an
  # instance of a generic type; its private members are used by its own
  # module's methods. Variants and payloads are always public.
  use lib

  fun peek(c: ?lib.Counter) -> Int
    c.value()

  sub main()
    c = lib.Counter.make("a")
    !c.bump()
    c.step = 5
    !c.bump()
    print(c.label, c.value(), peek(?c))
    h = *lib.Counter.make("h")
    print(h.value(), h.label)
    b = lib.boxed("b")
    !b.bump()
    print(b.value(), b.label)
    p = lib.Pair[Int](a: 1, b: 2)
    q = lib.Pair(a: "x", b: "y")
    print(p.first(), p.b, q.first())
    s = lib.Shape.circle(r: 3)
    match s
      .circle(r) => print("circle", r, s.size())
      .dot => print("dot")
    print(lib.Shape.dot.size())

  file "lib.rig"
    pub obj Counter
      pub label: ?String
      pub step: Int = 1
      count: Int

      pub fun make(label: ?String) -> Counter
        Counter(label: label, count: 0)

      pub fun value(?self) -> Int
        self.count

      pub sub bump(!self)
        self.count += self.step
        self.note()

      sub note(?self)
        print("bumped", self.label, self.count)

    pub obj Pair[T]
      pub a: T
      pub b: T

      pub fun first(?self) -> T
        self.a

    pub enum Shape
      circle(r: Int)
      dot

      pub fun size(?self) -> Int
        match self
          .circle(r) => r
          .dot => 0

    pub fun boxed(label: ?String) -> ^Counter
      ^Counter.make(label)

test "public surface generic instances", '''
  1 1 4 4 9
  41
  42
  5 5
'''
  # A module's public surface may hold instances of its generic types,
  # private ones included: importers hold the values and use their fields
  # and methods, though they cannot name a private type. A type of the
  # same name here is another type.

  use lib

  obj Wrap
    v: Int

  sub main()
    b = lib.make(1)
    h = lib.holder()
    local = Wrap(v: 9)
    print(b.v, b.get(), h.b.v, h.b.get(), local.v)
    p = lib.P.make()
    print(p.q.b.v)
    w = lib.cover_secret(5)
    lib.take_secret(lib.make_secret())
    print(w.inner.value, lib.uncover(w))

  file "lib.rig"
    obj Wrap[T]
      pub v: T

      pub fun get(?self) -> T
        self.v

    pub obj Holder
      pub b: Wrap[Int]

    obj Slot[T]
      pub v: T

    obj Q
      pub b: Slot[*Int]

    pub obj P
      pub q: Q

      pub fun make() -> P
        P(q: Q(b: Slot(v: *41)))

    obj Secret
      pub value: Int

    pub obj Cover[T]
      pub inner: T

    pub fun make(n: Int) -> Wrap[Int]
      Wrap(v: n)

    pub fun holder() -> Holder
      Holder(b: Wrap(v: 4))

    pub fun make_secret() -> Secret
      Secret(value: 42)

    pub sub take_secret(s: Secret)
      print(s.value)

    pub fun cover_secret(x: Int) -> Cover[Secret]
      Cover(inner: Secret(value: x))

    pub fun uncover(w: Cover[Secret]) -> Int
      w.inner.value

