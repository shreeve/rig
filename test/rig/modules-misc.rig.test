test "symbols across modules", '''
  3 4 0
  true :triangle :circle
  :hexagon 6
'''
  # Symbols are one set for the whole program: `:triangle` written in two
  # modules is one value, a default argument of another module's function
  # is written where it is called, and a symbol only one module writes is
  # found by `Symbol.from_text` in another.

  use shapes

  DEFAULT = :square

  sub main()
    print(shapes.sides(:triangle), shapes.sides(DEFAULT), shapes.sides(:blob))
    print(shapes.kind() == :triangle, shapes.kind(), shapes.pick())
    print(Symbol.from_text("hexagon") ?? :none, shapes.sides(Symbol.from_text("hexagon") ?? :none))

  file "shapes.rig"
    pub fun sides(s: Symbol) -> Int
      match s
        :triangle => 3
        :square => 4
        :hexagon => 6
        _ => 0

    pub fun kind() -> Symbol
      :triangle

    pub fun pick(s: Symbol = :circle) -> Symbol
      s

test "transitive errors", "empty bad digit ok"
  # A module names the errors of a module it reaches only through an
  # import: `.empty` is a member of `parsing`'s error set, which `main`
  # does not import.

  use mid

  fun name(s: ?String) -> ?String
    _ = mid.twice(s) catch |err|
      match err
        .empty => return "empty"
        .bad_digit => return "bad digit"
        _ => return "other"
    "ok"

  sub main()
    print(name(""), name("x"), name("abc"))

  file "mid.rig"
    use parsing

    pub fun twice(s: ?String) -> Int!
      parsing.parse(s)! * 2

  file "parsing.rig"
    pub error ParseError
      empty
      bad_digit

    pub fun parse(s: ?String) -> Int!
      return ParseError.empty if s == ""
      return ParseError.bad_digit if s == "x"
      s.len

test "transitive type", '''
  full 2
  1 3
  drop 3
  drop 2
  drop 1
'''
  # A type from a module the program reaches only through an import
  # (`lib` returns an `a.B`) is dropped, matched, and called like any
  # other.

  use lib

  sub main()
    x = lib.make(1)
    w = ~x
    s = lib.slot(2)
    match s
      .full(b) => print("full", b.get())
      .empty => print("empty")
    p = lib.plain(3)
    q = <p
    print(x.get(), q.n)

  file "a.rig"
    pub obj B
      pub n: Int

      drop(!self)
        print("drop", self.n)

      pub fun get(?self) -> Int
        self.n

    pub enum Slot
      full(b: *B)
      empty

  file "lib.rig"
    use a

    pub fun make(n: Int) -> *a.B
      *a.B(n: n)

    pub fun slot(n: Int) -> a.Slot
      .full(b: make(n))

    pub fun plain(n: Int) -> a.B
      a.B(n: n)

