  # Each value another module's compile-time parameter takes here is
  # checked against what its bodies do with it: an array length runs from
  # 0 to 2^32 - 1, and a value takes at most 8 MiB.

  use lib

  sub main()
    a = lib.zeros[-1]()
    lib.show[5000000000]()
    b = lib.zeros[2000000]()
    r = lib.Ring[Int, -2](items: [])
    print(a.len, b.len, r.items.len)

  file "lib.rig"
    pub fun zeros[n: Int]() -> [n]Int
      [n of 0]

    fun helper[m: Int]() -> Int
      a = [m of 0]
      a.len

    pub sub show[k: Int]()
      print(helper[k]())

    pub obj Ring[T, n: Int]
      items: [n]T

