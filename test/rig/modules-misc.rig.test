test "payload by name across modules", '''
  4
  box
  t
'''
  # A pattern binds the fields of an imported enum's variant by name, as
  # it binds its own enum's.
  use shapes

  fun height(s: ?shapes.Shape) -> Int
    match s
      .rect(h: h) => h
      .point => 0

  fun first(x: ?String, d: ?String) -> ?String from x, d
    match shapes.wrap(x, 2)
      .both(a: v) => v
      .neither => d

  sub main()
    s = shapes.Shape.rect(w: 3, h: 4, label: String("box"))
    print(height(?s))
    match <s
      .rect(label: l) => print(l)
      .point => pass
    t = String("t")
    d = String("d")
    print(first(?t, ?d))

  file "shapes.rig"
    pub enum Shape
      rect(w: Int, h: Int, label: String)
      point

    pub enum Pair[A, B]
      both(a: A, b: B)
      neither

    pub fun wrap(x: ?String, n: Int) -> Pair[?String, Int] from x
      Pair.both(a: x, b: n)

