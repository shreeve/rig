test "error constants and aliases", '''
  Disk.full true H(e: Disk.full) Disk.full
  true true true false
  2 2 1 Disk.full Disk.empty Net.timeout
'''
  # A module's constant of an error-set type is that constant, read as a
  # value, passed, and used as a default; an alias of an error set, local,
  # of another module's set, or another module's own `pub type`, names the
  # set's members as the set does, in values and in patterns.
  use lib

  type L = lib.Disk

  error Net
    timeout

  type N = Net

  obj H
    e: lib.Disk = lib.DEF

  fun g(e: lib.Disk = lib.DEF) -> lib.Disk
    e

  fun take(d: lib.Disk) -> Bool
    d == lib.DEF

  fun net() -> Int!
    return N.timeout

  sub main()
    print(lib.DEF, take(lib.DEF), H(), g())
    x = lib.fail(0) catch |e|
      print(e == lib.DEF, e == L.full, e == lib.D.full, e == L.empty)
      match e
        L.empty => 1
        lib.D.full => 2
        _ => 3
    y = lib.fail(1) catch |e|
      match e
        lib.D.full => 1
        L.empty => 2
        _ => 3
    z = net() catch |e|
      match e
        N.timeout => 1
        _ => 2
    print(x, y, z, L.full, lib.D.empty, N.timeout)

  file "lib.rig"
    pub error Disk
      full
      empty

    pub DEF = Disk.full
    pub type D = Disk

    pub fun fail(n: Int) -> Int!
      return Disk.full if n == 0
      return D.empty if n == 1
      n

fail "error name hints", "9:11: `.timeout` is not a value of `Int`; to fail, name the error set: `Net.timeout`, `b.Mid.timeout`, or `a.Deep.timeout` (import `a` to name it)", "13:35: error sets `Net`, `b.Mid`, and `a.Deep` all have a member `timeout`; name the set: `Net.timeout`, `b.Mid.timeout`, or `a.Deep.timeout` (import `a` to name it)", errors: 2
  # A hint names every error set a bare name could mean, the way this
  # module writes it; a set of a module it does not import says so.
  use b

  error Net
    timeout

  fun g(n: Int) -> Int!
    return .timeout if n == 0
    n

  sub main()
    x = b.h(0) catch |e| 1 if e == .timeout else 2
    print(x, g(1) catch 0)

  file "a.rig"
    pub error Deep
      timeout

  file "b.rig"
    use a

    pub error Mid
      timeout

    pub fun h(n: Int) -> Int!
      return a.Deep.timeout if n == 0
      return Mid.timeout if n == 1
      n

fail "error name in two modules", "9:8: error sets `io.IoError` and `lex.LexError` both have a member `eof`; name the set: `io.IoError.eof` or `lex.LexError.eof`", errors: 1
  # Two modules' error sets that share a member name are distinct: a bare
  # `.eof` against any error could be either, so it names its set.
  use io
  use lex

  sub main()
    a = io.read(0) catch |e|
      match e
        .eof => 1
        _ => 2
    b = io.read(0) catch |e| 1 if e == io.IoError.eof else 2
    print(a, b)

  file "io.rig"
    pub error IoError
      eof

    pub fun read(n: Int) -> Int!
      return IoError.eof if n == 0
      n

  file "lex.rig"
    pub error LexError
      eof

test "error name private sets", '''
  Hidden.timeout
  1 2
'''
  # A bare error name against any error counts this module's own sets and
  # the `pub` sets of the modules it reaches, never another module's
  # private set: `.timeout` here is `Net.timeout`, and `a`'s private
  # `Hidden.timeout` is a different error.
  use a

  error Net
    timeout

  fun g() -> Int!
    return Net.timeout

  sub main()
    x = g() catch |e| 1 if e == .timeout else 2
    y = a.f(0) catch |e|
      print(e)
      match e
        .timeout => 1
        _ => 2
    print(x, y)

  file "a.rig"
    error Hidden
      timeout

    pub fun f(n: Int) -> Int!
      return Hidden.timeout if n == 0
      n

test "error sets per module", '''
  -1 closed
  0 io eof
  1 parse eof
  2 other
  3 ok
  IoError.eof true false
  ParseError.eof false true
  Hidden.eof false false
  0 closed eof
'''
  # Error sets of different modules are distinct, even with the same
  # member name: `io.IoError.eof` is not `parse.ParseError.eof`, nor the
  # `eof` of a set `parse` keeps private. A set is named through its
  # module in a comparison and a match arm, and a member only one set the
  # module can see has, as `.closed`, needs no set. An error prints with
  # its set.
  use io
  use parse

  fun describe(n: Int) -> ?String
    _ = parse.parse(n) catch |e|
      match e
        io.IoError.eof => return "io eof"
        parse.ParseError.eof => return "parse eof"
        .closed => return "closed"
        _ => return "other"
    "ok"

  sub main()
    for n in -1..4
      print(n, describe(n))
    a = parse.parse(0) catch |e|
      print(e, e == io.IoError.eof, e == parse.ParseError.eof)
      0
    b = parse.parse(1) catch |e|
      print(e, e == io.IoError.eof, e == parse.ParseError.eof)
      0
    c = parse.parse(2) catch |e|
      print(e, e == io.IoError.eof, e == parse.ParseError.eof)
      0
    print(a + b + c, io.kind(), io.kind(io.IoError.eof))

  file "io.rig"
    pub error IoError
      eof
      closed

    pub fun read(n: Int) -> Int!
      return IoError.eof if n == 0
      return IoError.closed if n < 0
      n

    pub fun kind(e: IoError = .closed) -> ?String
      match e
        .eof => "eof"
        IoError.closed => "closed"

  file "parse.rig"
    use io

    pub error ParseError
      eof

    error Hidden
      eof

    pub fun parse(n: Int) -> Int!
      return ParseError.eof if n == 1
      return Hidden.eof if n == 2
      io.read(n)! * 10

