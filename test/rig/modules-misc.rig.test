test "for iterator across modules", release: true, '''
  span 1
  span 2
  span 3
  made 1
  made 2
  10
'''
  # An iterator declared in another module is walked by a `for` like a
  # local one, whether a name holds it or a call makes it, and a module
  # can loop over its own iterators in the functions it exports.
  use span

  sub main()
    r = span.span(3)
    for x in !r
      print("span", x)
    for y in span.span(2)
      print("made", y)
    print(span.total(4))

  file "span.rig"
    pub obj Span
      n: Int
      at: Int

      pub fun next(!self) -> Int?
        return none if self.at >= self.n
        self.at += 1
        self.at

    pub fun span(n: Int) -> Span
      Span(n: n, at: 0)

    pub fun total(n: Int) -> Int
      s = 0
      for x in span(n)
        s += x
      s

