test "ct array module const", "[1, 2, 3] 4 [1, 2, 3] 2"
  # A module's constant sizes an array and gives a generic type's value
  # argument in another module: `[lib.N]Int` is `[3]Int`. A public
  # function's compile-time parameter crosses modules when it sizes no
  # array.

  use lib

  obj Ring[T, n: Int]
    items: [n]T

  sub main()
    a: [lib.N]Int = [1, 2, 3]
    b: [3]Int = a
    c: [lib.W * 2]Int = [4 of 0]
    r: Ring[Int, lib.N] = Ring[Int, lib.N](items: b)
    s: Ring[Int, 3] = r
    print(b, c.len, s.items, lib.count[2]())

  file "lib.rig"
    pub N = 3
    pub W: U8 = 2

    pub fun count[n: Int]() -> Int
      n

test "ct imported enum value", '''
  3 6 8
  10
'''
  # A variant of an imported enum is a compile-time value.

  use lib

  sub main()
    print(lib.check[lib.Mode.a](3), lib.check[lib.Mode.b](3), lib.check[.b](4))
    m =! lib.Mode.b
    print(lib.check[m](5))

  file "lib.rig"
    pub enum Mode
      a
      b

    pub fun check[m: Mode](n: Int) -> Int
      if m == .a
        return n
      n * 2

test "default constants", '''
  2 1 2 1 [-1, -1, -1] 3 10 255 8 0
  8 lib 2.5 1 1 0
  13 11 5 40.0 5.0 8.0
'''
  # Field and parameter defaults may name module constants, this module's
  # or an imported one; a field default may also be an empty or literal
  # constructor, made fresh for each value.
  use lib

  MAX = 3

  obj Stack
    items: List[Int] = List()
    names: List[?String] = List[?String]()
    hits: Int = 0
    slots: [MAX]Int = [MAX of -1]
    cap: Int = MAX
    top: U8 = U8.max
    far: Int = lib.LIMIT

    sub push(!self, x: Int)
      !self.items.push(x)
      self.hits += 1

  fun pad(s: ?String, width: Int = MAX, fill: Int = lib.LIMIT) -> Int
    s.len + width + fill

  sub main()
    a = Stack()
    b = Stack(cap: 10)
    !a.push(1)
    !a.push(2)
    !b.push(5)
    print(a.items.len, b.items.len, a.hits, b.hits, a.slots, a.cap, b.cap, a.top, a.far, a.names.len)
    c = lib.Config()
    !c.tags.push("x")
    d = lib.Config(size: 1)
    print(c.size, c.label, c.rate, c.tags.len, d.size, d.tags.len)
    print(pad("ab"), pad("ab", 1), pad("ab", fill: 0), lib.scaled(2), lib.scaled(2, 1), lib.scaled(1, rate: 1.0))

  file "lib.rig"
    pub LIMIT = 8
    pub NAME = "lib"
    RATE = 2.5

    pub obj Config
      pub size: Int = LIMIT
      pub label: ?String = NAME
      pub rate: Float = RATE
      pub tags: List[?String] = List()

    pub fun scaled(n: Int, by: Int = LIMIT, rate: Float = RATE) -> Float
      Float(n * by) * rate

test "diamond import", "30"
  # main imports a and b, and b imports a: a is loaded and checked once
  # and both importers see the same module.
  use a
  use b

  sub main()
    print(a.base() + b.twice())

  file "a.rig"
    pub fun base() -> Int
      10

  file "b.rig"
    use a

    pub fun twice() -> Int
      a.base() * 2

test "directory module", "3"
  # A directory is a module: its files share one namespace and call each
  # other, and a module beneath it is a directory of its own.
  use checker

  sub main()
    print(checker.Checker(depth: 0).expr(3))

  file "checker/expr.rig"
    pub obj Checker
      pub depth: Int

      pub fun expr(?self, n: Int) -> Int
        0 if n == 0 else self.stmt(n - 1)

  file "checker/stmt.rig"
    use checker.binder

    pub fun Checker.stmt(?self, n: Int) -> Int
      binder.bump(self.expr(n))

  file "checker/binder/bump.rig"
    pub fun bump(n: Int) -> Int
      n + 1

test "directory module names", "21 4"
  # The files of a directory module share its private names and
  # constants, in any order; each file uses the modules it names, and two
  # files may use one module. A method may be declared in any file of its
  # type's module.
  use m

  sub main()
    print(m.total(), m.ring().cap())

  file "geo/point.rig"
    pub obj Point
      pub x: Int
      pub y: Int

  file "geo/sum.rig"
    pub fun Point.sum(?self) -> Int
      self.x + self.y

  file "geo/util/twice.rig"
    pub fun twice(n: Int) -> Int
      2 * n

  file "m/a.rig"
    use geo
    use geo.util as u

    pub fun total() -> Int
      LIMIT + helper() + u.twice(geo.Point(x: 1, y: 2).sum())

    pub obj Ring[T, n: Int]
      items: [n]T

  file "m/b.rig"
    use geo

    LIMIT = BASE * 2

    fun helper() -> Int
      geo.Point(x: BASE, y: 0).x

  file "m/c.rig"
    BASE = 5

    pub fun Ring[T, n].cap(?self) -> Int
      n

    pub fun ring() -> Ring[Int, 4]
      Ring(items: [4 of 0])

test "empty constructor", '''
  9 3
  7 0 1 0
  1
'''
  # `T()` of an object whose every field has a default makes the value
  # those defaults give, from any module, though some fields are private:
  # as a local, as a field's default (a fresh one for each value), and for
  # a generic object, as a local and as a default.

  use lib

  obj Shelf
    bag: lib.Bag = lib.Bag()
    pile: lib.Pile[String] = lib.Pile[String]()

  sub main()
    b = lib.Bag()
    !b.add(4)
    !b.add(5)
    print(b.total(), b.limit)
    s = Shelf()
    t = Shelf()
    !s.bag.add(7)
    !s.pile.put(String("x"))
    print(s.bag.total(), t.bag.total(), s.pile.count(), t.pile.count())
    p = lib.Pile[Int]()
    !p.put(1)
    print(p.count())

  file "lib.rig"
    # Objects whose every field has a default, some private: another module
    # makes an empty one with `T()`.

    pub obj Bag
      items: List[Int] = List()
      label: String = String()
      pub limit: Int = 3

      pub sub add(!self, n: Int)
        !self.items.push(n) if self.items.len < self.limit

      pub fun total(?self) -> Int
        sum = 0
        for n in ?self.items
          sum += n
        sum

    pub obj Pile[T]
      items: List[T] = List()

      pub sub put(!self, x: T)
        !self.items.push(<x)

      pub fun count(?self) -> Int
        self.items.len

fail "empty constructor needs defaults", "9:17: `lib.Half()` is a default only when every field of `lib.Half` has one, and `size` has none", "12:11: `lib.Half()` makes a `lib.Half` from its fields' defaults, and `size` has no default; its fields `items`, `size` are private to module `lib`, which alone can set them", "13:11: only module `lib` can construct `lib.Bag`: its field `items` is private"
  # `T()` makes a value only from defaults for every field, as a local or
  # as a field's default: a private field with no default is the module's
  # to set. And explicit fields set a value only when every field is
  # `pub`, as before.

  use lib

  obj Keep
    h: lib.Half = lib.Half()

  sub main()
    h = lib.Half()
    b = lib.Bag(limit: 4)
    print(h, b)

  file "lib.rig"
    pub obj Half
      items: List[Int] = List()
      size: Int

    pub obj Bag
      items: List[Int] = List()
      pub limit: Int = 3

test "endian across modules", '''
  .little true .big
  513 258
  [3, 4]
  [4, 3]
'''
  # Every module's `Endian` is the one built-in type: values, constants,
  # and compile-time arguments of it pass between modules.

  use wire

  sub main()
    b: [2]U8 = [1, 2]
    e: Endian = wire.order()
    print(e, e == Endian.little, wire.ORDER)
    print(wire.get[.little](?b[..]), wire.get[wire.ORDER](?b[..]))
    wire.put(!b[..], .big, 0x0304)
    print(b)
    wire.put(!b[..], e, 0x0304)
    print(b)

  file "wire.rig"
    pub ORDER = Endian.big

    pub fun order() -> Endian
      .little

    pub fun get[e: Endian](b: []U8) -> U16
      b.read[U16, e](0)

    pub sub put(b: ![]U8, e: Endian, v: U16)
      match e
        .little => !b.write[U16, .little](0, v)
        .big => !b.write[U16, .big](0, v)

test "enum order imported", '''
  true false true
  false true .mid
'''
  # Another module's plain enum orders by its variants' values, beside a
  # `.variant`, a qualified variant, and in its own module's function.
  use lib
  use std.math

  sub main()
    l: lib.Level = .mid
    print(l > .low, lib.Level.high < l, l <= lib.Level.mid)
    print(lib.at_least(l, .high), lib.at_least(.high, l), math.min(lib.Level.high, l))

  file "lib.rig"
    pub enum Level
      high = 9
      low = 1
      mid = 5

    pub fun at_least(l: Level, floor: Level) -> Bool
      l >= floor

test "enum text across modules", '''
  .blue blue dark_red red
  .red .dark_red none
  two
'''
  # A plain enum of another module: its `.text` and `from_text`, called
  # from two modules and through another module's alias of it. `Unused`
  # is never looked up, so its module emits no table of names for it.

  use colors
  use paint

  type Local = paint.Shade

  sub main()
    c = colors.Color.from_text("blue") ?? .red
    print(c, c.text, paint.parse("dark_red").text, paint.parse("nope").text)
    print(paint.Shade.from_text("red"), Local.from_text("dark_red"), Local.from_text("Blue"))
    print(colors.Unused.two.text)

  file "colors.rig"
    pub enum Color
      red
      dark_red
      blue

    pub enum Unused
      one
      two

  file "paint.rig"
    use colors

    pub type Shade = colors.Color

    pub fun parse(word: ?String) -> colors.Color
      colors.Color.from_text(word) ?? .red

