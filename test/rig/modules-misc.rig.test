'''
  # Keyword arguments and default parameter values work across modules;
  # a default is the literal written in the declaring module.

  use lib

  sub main()
    print(lib.scale(2))
    print(lib.scale(off: 5, n: 3))

  file "lib.rig"
    pub fun scale(n: Int, by: Int = 10, off: Int = -1) -> Int
      n * by + off

test "cross module method kwargs", "12 19"
  # Methods of a type from another module take keyword arguments and
  # defaults.

  use shapes

  sub main()
    r = shapes.Rect(w: 2, h: 3)
    print(r.scaled(), r.scaled(plus: 1, by: 3))

  file "shapes.rig"
    pub obj Rect
