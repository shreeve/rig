# modules: the rest of its tests.

test "alias across modules", '''
  1 0 2 4 5 7 0 1.5
  8
  light
  true true -128 true
'''
  # Another module's alias names its type in every role here: it
  # constructs values of a struct (declared in that module or one it
  # imports) or a generic instance, calls associated functions, names
  # variants, and converts to a number type. A local alias of an imported
  # alias does too, and a default naming a limit through an alias, of
  # that module or one it imports, fills in here.

  use lib

  type LUP = lib.UP
  type LIP = lib.IP

  sub main()
    p = lib.UP(x: 1)
    o = lib.UP.origin()
    l = LUP(x: 2)
    q = lib.IP(a: 3, b: 4)
    t = lib.IP.twin(5)
    r = LIP(a: 6, b: 7)
    v = lib.IV(capacity: 3)
    s = lib.US.dark(n: 8)
    k: lib.US = lib.US.light
    print(p.x, o.x, l.x, q.b, t.a, r.b, v.len, lib.Real(1.5))
    match s
      .dark(n) => print(n)
      .light => print("light")
    match k
      .light => print("light")
      .dark(_) => print("dark")
    m = lib.Limits()
    print(m.hi > 3.0e38, m.lo < -3.0e38, m.small, m.wide > 1.0e308)

  file "lib.rig"
    use util

    pub obj Pair[T]
      pub a: T
      pub b: T

      pub fun twin(x: T) -> Pair[T]
        Pair(a: x, b: x)

    pub type UP = util.Point
    pub type US = util.Shade
    pub type IP = Pair[Int]
    pub type IV = List[Int]
    pub type Real = F32

    type R = F32

    pub obj Limits
      pub hi: R = R.max
      pub lo: Real = Real.min
      pub small: util.Small = util.Small.min
      pub wide: util.Wide = util.Wide.max

  file "util.rig"
    pub obj Point
      pub x: Int

      pub fun origin() -> Point
        Point(x: 0)

    pub enum Shade
      light
      dark(n: Int)

    pub type Small = I8
    pub type Wide = F64

fail "alias named none", "2:12: `none` is the absent optional and cannot name a module; name it with `as`: `use ... as other`", errors: 1
  # `none` is the absent optional, so no `use ... as` binds it.
  use lib as none

  sub main()
    print(none.two())

  file "lib.rig"
    pub fun two() -> Int
      2

fail "aliased generic type name", "8:13: type mismatch: expected `Bool`, got `g.Wrap[Int]`", "9:13: type mismatch: expected `Bool`, got `g.Point`"
  # A diagnostic names another module's type as this module spells it,
  # by the name of the import: a generic type's instance as a plain type
  # is, `g.Wrap[Int]` beside `g.Point`.

  use geo as g

  sub main()
    w: Bool = g.Wrap(v: 1)
    p: Bool = g.Point(x: 1)
    print(w, p)

  file "geo.rig"
    pub obj Wrap[T]
      pub v: T

    pub obj Point
      pub x: Int

test "box across modules", '''
  6 Tree(key: 1, kids: [Tree(key: 2, kids: []), Tree(key: 3, kids: [])])
  5 6
'''
  # A type from another module is boxed, and holds boxes of itself in a
  # List; its methods are called through the boxes, and a consuming method
  # takes the value out of its box.

  use lib

  sub main()
    root = lib.leaf(1)
    !root.kids.push(lib.leaf(2))
    !root.kids.push(lib.leaf(3))
    print(root.total(), root)
    t = lib.ticket(5)
    print(<t.redeem(), lib.ticket(6).redeem())

  file "lib.rig"
    pub obj Tree
      key: Int
      pub kids: List[^Tree]

      pub fun total(?self) -> Int
        t = self.key
        for k in ?self.kids
          t += k.total()
        t

    pub fun leaf(key: Int) -> ^Tree
      ^Tree(key: key, kids: List())

    pub obj Ticket
      n: Int

      pub fun redeem(<self) -> Int
        self.n

    pub fun ticket(n: Int) -> ^Ticket
      ^Ticket(n: n)

test "builtin type args", "16 16 8 1 2 Bool 2"
  # Every form a type argument of `$size`, `$align`, and `$name`
  # can take: `Self`, an alias, an imported type, a builtin, and a type
  # parameter.

  use lib

  obj P
    x: I64
    y: I64

    fun size(?self) -> Int
      $size(Self)

  type P2 = P

  obj Wrap[T]
    v: T

    fun size(?self) -> Int
      $size(T)

  sub main()
    p = P(x: 1, y: 2)
    b: Wrap[U16] = Wrap(v: 7)
    print($size(P2), p.size(), $size(lib.Q), $size(U8), b.size(), $name(Bool), $align(U16))

  file "lib.rig"
    pub obj Q
      a: I32
      b: I32

test "closure args across modules", '''
  ["apple", "fig", "pear"] [5, 3, 4] true
  7
'''
  # Another module's generic functions and methods take callable views
  # as local ones do: a closure literal written in the call, whose
  # parameter and result types are inferred there.

  use lib

  sub main()
    words = ["pear", "fig", "apple"]
    calls = 0
    lib.sort(!words[..], |!calls, a, b|
      calls += 1
      a < b
    )
    lens = lib.map(?words[..], |w| w.len)
    print(words, lens, calls > 0)
    bag = lib.Bag(items: List())
    !bag.items.push(2)
    !bag.items.push(5)
    total = 0
    bag.each(|!total, n| total += n)
    print(total)

  file "lib.rig"
    pub sub sort[T](xs: ![]T, less: ?fun(?T, ?T) -> Bool)
      i = 1
      while i < xs.len : i += 1
        j = i
        while j > 0 and less(?xs[j], ?xs[j - 1]) : j -= 1
          !xs.swap(j, j - 1)

    pub fun map[T, U](xs: []T, f: ?fun(?T) -> U) -> List[U]
      out: List[U] = List()
      for x in xs
        !out.push(f(?x))
      out

    pub obj Bag
      pub items: List[Int]

      pub sub each(?self, f: ?sub(Int))
        for x in ?self.items
          f(x)

test "comptime params across modules", '''
  15
  40
  8
'''
  # An imported function takes its compile-time arguments in brackets, as
  # a local one does.

  use lib

  sub main()
    print(lib.scaled[3](5))
    lib.banner[40]()
    lib.banner[8]()

  file "lib.rig"
    pub fun scaled[n: Int](x: Int) -> Int
      x * n

    pub sub banner[width: Int]()
      print(width)

test "const generics across modules", '''
  3 3 6 2
  5
  2 4 3
  2 1.5
'''
  # Another module's compile-time integer parameters are given in brackets
  # or inferred, as a local function's are, and each value is checked
  # against what the module's bodies do with it, such as sizing an array.

  use lib

  sub main()
    z = lib.zeros[3]()
    a: [3]Int = lib.zeros()
    print(z.len, a.len, lib.sum([1, 2, 3]), lib.plain[2]())
    lib.show[5]()
    m = lib.Maker.zeros[2]()
    r = lib.Ring[Int, 4](items: [1, 2, 3, 4])
    print(m.len, r.cap(), r.items[2])
    b: lib.Ring[Float, 2] = lib.Ring(items: [0.5, 1.5])
    print(b.cap(), b.items[1])

  file "lib.rig"
    pub fun zeros[n: Int]() -> [n]Int
      [n of 0]

    fun helper[m: Int]() -> Int
      a = [m of 0]
      a.len

    pub sub show[k: Int]()
      print(helper[k]())

    pub fun plain[k: Int]() -> Int
      k

    pub obj Maker
      x: Int

      pub fun zeros[n: Int]() -> [n]Int
        [n of 0]

    pub fun sum[n: Int](xs: [n]Int) -> Int
      t = 0
      for x in xs
        t += x
      t

    pub obj Ring[T, n: Int]
      pub items: [n]T

      pub fun cap(?self) -> Int
        n

fail "constant as pattern", "8:5: `lib.DEF` is a constant, which a pattern cannot name; compare with it in a guard: `x if x == lib.DEF =>`", "12:5: `lib.RED` is a constant, which a pattern cannot name; compare with it in a guard: `x if x == lib.RED =>`", errors: 2
  # A pattern cannot name a module's constant, of an error set or of an
  # enum: it is compared in a guard instead. The rejected arm covers
  # nothing, and the match reports no more than that arm.
  use lib

  fun k(d: lib.Disk) -> ?String
    match d
      lib.DEF => "def"

  fun c(x: lib.Color) -> ?String
    match x
      lib.RED => "red"
      .green => "green"

  sub main()
    print(k(lib.Disk.full), c(.red))

  file "lib.rig"
    pub error Disk
      full
      empty

    pub enum Color
      red
      green

    pub DEF = Disk.full
    pub RED = Color.red

test "cross anon resource temp", "7"
  # A field read from an imported function's `*Wrap` result, without
  # binding it, reads the temporary handle, which its statement drops.

  use a

  sub main()
    print(a.make_box().value)

  file "a.rig"
    pub obj Wrap
      pub value: Int

    pub fun make_box() -> *Wrap
      *Wrap(value: 7)

fail "cross arity", "call to `a.add` expects 2 arguments, got 5"
  # A cross-module call is checked against the imported signature:
  # `a.add` takes two arguments.
  use a

  sub main()
    x = a.add(1, 2, 3, 4, 5)
    print(x)

  file "a.rig"
    pub fun add(a: Int, b: Int) -> Int
      a + b

fail "cross constructor field", "no field `does_not_exist` on type `Wrap`"
  # Constructing an imported struct checks its field list: `Wrap` has no
  # field `does_not_exist`.
  use a

  sub main()
    b = a.Wrap(does_not_exist: 5)
    print(b.value)

  file "a.rig"
    pub obj Wrap
      value: Int

fail "cross fallible call", "fallible call to `a.parse_int` must be wrapped with `!` (propagate) or `catch` (handle)"
  # `a.parse_int` returns `Int!`; calling it without `!` or `catch` is an
  # error at the call site even though the callee lives in another module.
  use a

  sub main()
    x = a.parse_int("hi")
    print(x)

  file "a.rig"
    pub fun parse_int(s: ?String) -> Int!
      return 42

test "cross module default args", '''
  19
