          .some(value) => value
          .nothing => d

      pub fun is_none(?self) -> Bool
        match self
          .some(value) => false
          .nothing => true

      pub fun pick(?self, a: Int, b: Int) -> Int
        a if self.is_none() else b

    pub enum Color
      red
      green

