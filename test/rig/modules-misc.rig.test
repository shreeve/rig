fail "value too large", "6:6: `[3]lib.Big?` takes 12000003 bytes; a value takes at most 8388608 (8 MiB)"
  # A type from another module is sized as it is declared there.

  use lib

  sub main()
    a: [3]lib.Big? = [none, none, none]
    print(a.len)

  file "lib.rig"
    pub obj Big
      cells: [500000]Int

test "view payload across modules", "t"
  # A match binds a payload field of an imported enum's instance that is
  # itself a view (`Opt[?String]`) as the view it is.
  use opt

  fun first(x: ?String, d: ?String) -> ?String from x, d
    match opt.wrap(x)
      .some(v) => v
      .nothing => d

  sub main()
    t = String("t")
    d = String("d")
    print(first(?t, ?d))

  file "opt.rig"
    pub enum Opt[T]
      some(v: T)
      nothing

    pub fun wrap(x: ?String) -> Opt[?String] from x
      Opt.some(v: x)

test "write lend made by module", '''
  6 2 2
  .a(s: "x")
'''
  # The value a function called through a module or a type makes, lent
  # to write with its call in parentheses (Core sentence 4).
  use lib

  obj U
    n: Int

    fun bump(!self) -> Int
      self.n += 1
      self.n

    fun make() -> U
      U(n: 1)

  enum E
    a(s: ?String)
    b

  sub sete(e: !E)
    print(e)
    e = .b

  sub main()
    print((!(lib.mk())).bump(), (!(lib.T.make())).bump(), (!(U.make())).bump())
    sete(!(E.a(s: "x")))

  file "lib.rig"
    pub obj T
      pub n: Int

      pub fun bump(!self) -> Int
        self.n += 1
        self.n

      pub fun make() -> T
        T(n: 1)

    pub fun mk() -> T
      T(n: 5)

fail "write lend through module", "26:9: `!` here reaches `lib`, a module, not the value `lib.mk()` makes: write `!(lib.mk())` to lend that value, or remove the `!`", "27:9: `!` here reaches `lib.T`, a type, not the value `lib.T.make()` makes: write `!(lib.T.make())` to lend that value, or remove the `!`", "28:9: `!` here reaches `U`, a type, not the value `U.make()` makes: write `!(U.make())` to lend that value, or remove the `!`", "29:8: `!` here reaches `E`, a type, not the value `E.a(s: \"x\")` makes: write `!(E.a(s: \"x\"))` to lend that value, or remove the `!`", "30:6: `!` here reaches `lib`, a module, and `lib.ok()` makes a `Bool`; for negation use `not`", errors: 5
  # `!` before a function called through a module or a type reaches the
  # module or type, which a parse cannot tell from a value's method: one
  # diagnostic says so, and how to lend the value the call makes
  # (`test/behavior/modules/write_lend_made_by_module`), or, before a
  # `Bool`, that `!` is not negation.
  use lib

  obj U
    n: Int

    fun bump(!self) -> Int
      self.n += 1
      self.n

    fun make() -> U
      U(n: 1)

  enum E
    a(s: ?String)
    b

  sub sete(e: !E)
    e = .b

  sub main()
    print(!lib.mk().bump())
    print(!lib.T.make().bump())
    print(!U.make().bump())
    sete(!E.a(s: "x"))
    if !lib.ok()
      print("no")

  file "lib.rig"
    pub obj T
      pub n: Int

      pub fun bump(!self) -> Int
        self.n += 1
        self.n

      pub fun make() -> T
        T(n: 1)

    pub fun mk() -> T
      T(n: 5)

    pub fun ok() -> Bool
      true
