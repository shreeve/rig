      pub h: Int

      pub fun scaled(?self, by: Int = 2, plus: Int = 0) -> Int
        self.w * self.h * by + plus

test "cross module read lend", "42"
  # `a.log_box` takes a read view `?Wrap`; a bare `Wrap` argument is lent
  # to read, as `?b` would lend it, across modules too.
  use a

  sub main()
    b = a.make_box(42)
    a.log_box(b)

  file "a.rig"
    pub obj Wrap
      value: Int

    pub fun make_box(v: Int) -> Wrap
      Wrap(value: v)

    # Public fn requires a read view (`?b`) of its argument.
    pub sub log_box(b: ?Wrap)
      print(b.value)

test "cross module struct", '''
  3 1
  0
'''
  # A public struct from another module is constructed as `geo.Point(...)`,
  # returned from its functions, and used through its methods and fields.

  use geo

  sub main()
    p = geo.Point(x: 1, y: 2)
    print(p.sum(), p.x)
    o = geo.origin()
    print(o.sum())

  file "geo.rig"
    pub obj Point
      pub x: Int
      pub y: Int

      pub fun sum(?self) -> Int
        self.x + self.y

    pub fun origin() -> Point
      Point(x: 0, y: 0)

fail "cross private extern", "`a.abs` is not public; mark it `pub` in module `a`"
  # `extern` does not bypass `pub`: a private extern in module `a` is
  # invisible to importers, who must go through the `pub` safe wrapper.
  use a

  sub main()
    raw
      print(a.abs(-1))

  file "a.rig"
    # Not `pub`: a private extern behind a `pub` safe wrapper is the
    # idiom; the extern itself is invisible to importers.
    extern fun abs(n: I32) -> I32

    pub fun safe_abs(n: I32) -> I32
      raw
        abs(n)

fail "cross private fun", "`a.internal_helper` is not public; mark it `pub` in module `a`"
  # `a.internal_helper` is not `pub`, so importers cannot call it.
  use a

  sub main()
    y = a.internal_helper(5)
    print(y)

  file "a.rig"
    pub fun visible_helper(x: Int) -> Int
      x + 1

    # Not `pub`: invisible to importers.
    fun internal_helper(x: Int) -> Int
      x * 2

test "cross resource return", "42"
  # An imported function returning `*Wrap` gives the caller a named binding
  # with an auto-drop guard, and `b.value` auto-derefs through the Rc.
  use a

  sub main()
    b = a.make_box(42)
    print(b.value)

  file "a.rig"
    pub obj Wrap
      pub value: Int

    pub fun make_box(v: Int) -> *Wrap
      *Wrap(value: v)

