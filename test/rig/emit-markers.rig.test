code "markers json shape unmarked", "pub fn number(s: []const u8, i: i64) i64 {", "pub inline fn utf8_text(", "pub fn doc(comptime dense: bool, "
  # std.json's shape: `doc[dense]` is one Zig function of two instances,
  # each calling `number`, over the size limit, and rarely `utf8_text`.

  # The shape std.json wants: one parser, two compile-time instances that
  # each call one helper over the size the compiler inlines by itself.

  DOT: U8 = 0x2E
  ZERO: U8 = 0x30
  NINE: U8 = 0x39
  LOWER_E: U8 = 0x65

  fun is_digit(b: U8) -> Bool
    b >= ZERO and b <= NINE

  # A number at `i`: its integer part times 100, plus the bytes it spans.
  fun number(s: ?String, i: Int) -> Int
    n = 0
    j = i
    while j < s.len and is_digit(s[j])
      n = n * 10 + Int(s[j] - ZERO)
      j += 1
    if j < s.len and s[j] == DOT
      j += 1
      while j < s.len and is_digit(s[j])
        j += 1
    if j < s.len and s[j] == LOWER_E
      j += 1
      e = 0
      while j < s.len and is_digit(s[j])
        e = e * 10 + Int(s[j] - ZERO)
        j += 1
      while e > 0
        n *= 10
        e -= 1
    n * 100 + (j - i)

  # A byte past ASCII, which a document rarely holds.
  fun utf8_text(s: ?String, i: Int) -> Int
    Int(s[i])

  # The parser: `dense` documents keep only the numbers' values.
  fun doc[dense: Bool](s: ?String) -> Int
    total = 0
    words = 0
    spaces = 0
    i = 0
    while i < s.len
      b = s[i]
      if b >= 128
        total += utf8_text(s, i)
        i += 1
      else if is_digit(b)
        v = number(s, i)
        total += v / 100 if dense else v
        i += v % 100
      else if b == 0x20 or b == 0x0A or b == 0x09 or b == 0x0D
        spaces += 1
        i += 1
      else if b == 0x2C or b == 0x3A
        words += 2
        i += 1
      else
        words += 1
        i += 1
    if dense
      return total
    j = 0
    lines = 0
    while j < s.len
      if s[j] == 0x0A
        lines += 1
      j += 1
    total + words * 1000000 + spaces * 10000000 + lines * 100000000

  sub main()
    s = "12 3 4.5 2e2 é"
    print(doc[true](s), doc[false](s))

code "markers json shape marked", "pub inline fn number(__rig_in_s: []const u8, __rig_in_i: i64) i64 {", "pub fn utf8_text(s: []const u8, i: i64) i64 {", /fn utf8_text\([^\n]*\n    @branchHint\(\.cold\);\n/
  # Marked, `number` is inlined into each instance, and `utf8_text` is
  # called, and cold.

  # The shape std.json wants: one parser, two compile-time instances that
  # each call one helper over the size the compiler inlines by itself.

  DOT: U8 = 0x2E
  ZERO: U8 = 0x30
  NINE: U8 = 0x39
  LOWER_E: U8 = 0x65

  fun is_digit(b: U8) -> Bool
    b >= ZERO and b <= NINE

  # A number at `i`: its integer part times 100, plus the bytes it spans.
  inline fun number(s: ?String, i: Int) -> Int
    n = 0
    j = i
    while j < s.len and is_digit(s[j])
      n = n * 10 + Int(s[j] - ZERO)
      j += 1
    if j < s.len and s[j] == DOT
      j += 1
      while j < s.len and is_digit(s[j])
        j += 1
    if j < s.len and s[j] == LOWER_E
      j += 1
      e = 0
      while j < s.len and is_digit(s[j])
        e = e * 10 + Int(s[j] - ZERO)
        j += 1
      while e > 0
        n *= 10
        e -= 1
    n * 100 + (j - i)

  # A byte past ASCII, which a document rarely holds.
  rarely fun utf8_text(s: ?String, i: Int) -> Int
    Int(s[i])

  # The parser: `dense` documents keep only the numbers' values.
  fun doc[dense: Bool](s: ?String) -> Int
    total = 0
    words = 0
    spaces = 0
    i = 0
    while i < s.len
      b = s[i]
      if b >= 128
        total += utf8_text(s, i)
        i += 1
      else if is_digit(b)
        v = number(s, i)
        total += v / 100 if dense else v
        i += v % 100
      else if b == 0x20 or b == 0x0A or b == 0x09 or b == 0x0D
        spaces += 1
        i += 1
      else if b == 0x2C or b == 0x3A
        words += 2
        i += 1
      else
        words += 1
        i += 1
    if dense
      return total
    j = 0
    lines = 0
    while j < s.len
      if s[j] == 0x0A
        lines += 1
      j += 1
    total + words * 1000000 + spaces * 10000000 + lines * 100000000

  sub main()
    s = "12 3 4.5 2e2 é"
    print(doc[true](s), doc[false](s))

