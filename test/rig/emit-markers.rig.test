code "markers inline over the frame limit", "pub inline fn huge(", /^(?![\s\S]*noinline\ fn\ huge\()/, "pub noinline fn near("
  # A marked `inline` function whose frame alone would make it `noinline`
  # (4 times its reach passes 1 MiB) is still written `inline fn`: its
  # values land in its caller, whose account holds them, and the caller is
  # the frame written `noinline`.

  inline fun huge(i: Int) -> Int
    t = [40000 of i]
    t[i % 40000]

  fun near(i: Int) -> Int
    huge(i) + 1

  sub main()
    print(near(3))

test "markers inline over the frame limit runs", "4", release: true
  # The large marked function's caller computes.

  inline fun huge(i: Int) -> Int
    t = [40000 of i]
    t[i % 40000]

  fun near(i: Int) -> Int
    huge(i) + 1

  sub main()
    print(near(3))

test "markers inline nest 256 deep", "256"
  # Calls of marked `inline` functions nest at most 256 deep
  # (`typecheck.max_inline_depth`): Zig analyzes each inlined body inside
  # the one around it, and runs out of its own stack some thousands deep.
  # `main` calls g0, and each marked g_i calls g_(i+1), 256 deep.

  inline fun g0(x: Int) -> Int
    g1(x) + 1

  inline fun g1(x: Int) -> Int
    g2(x) + 1

  inline fun g2(x: Int) -> Int
    g3(x) + 1

  inline fun g3(x: Int) -> Int
    g4(x) + 1

  inline fun g4(x: Int) -> Int
    g5(x) + 1

  inline fun g5(x: Int) -> Int
    g6(x) + 1

  inline fun g6(x: Int) -> Int
    g7(x) + 1

  inline fun g7(x: Int) -> Int
    g8(x) + 1

  inline fun g8(x: Int) -> Int
    g9(x) + 1

  inline fun g9(x: Int) -> Int
    g10(x) + 1

  inline fun g10(x: Int) -> Int
    g11(x) + 1

  inline fun g11(x: Int) -> Int
    g12(x) + 1

  inline fun g12(x: Int) -> Int
    g13(x) + 1

  inline fun g13(x: Int) -> Int
    g14(x) + 1

  inline fun g14(x: Int) -> Int
    g15(x) + 1

  inline fun g15(x: Int) -> Int
    g16(x) + 1

  inline fun g16(x: Int) -> Int
    g17(x) + 1

  inline fun g17(x: Int) -> Int
    g18(x) + 1

  inline fun g18(x: Int) -> Int
    g19(x) + 1

  inline fun g19(x: Int) -> Int
    g20(x) + 1

  inline fun g20(x: Int) -> Int
    g21(x) + 1

  inline fun g21(x: Int) -> Int
    g22(x) + 1

  inline fun g22(x: Int) -> Int
    g23(x) + 1

  inline fun g23(x: Int) -> Int
    g24(x) + 1

  inline fun g24(x: Int) -> Int
    g25(x) + 1

  inline fun g25(x: Int) -> Int
