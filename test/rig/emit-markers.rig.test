# The function markers, written by tools/markers.py (edit it, not this
# file): `inline fun` is emitted `inline fn` at any size, `called fun`
# `noinline fn`, and `rarely fun` starts with Zig's cold hint; the last
# two are never inlined by the compiler's own rule, and no marker changes
# what a program does (test/cli/markers.sh reads the symbols of an
# optimized build, and the limits `rig check` holds).

code "markers each shape", "pub inline fn big(__rig_in_a: i64) i64 {", "pub inline fn get(", "pub inline fn larger(comptime T: type, ", "pub fn small(a: i64) i64 {", "pub noinline fn tiny(a: i64) i64 {", "pub noinline fn same(", /fn tiny\([^\n]*\n    @setEvalBranchQuota\(rig\.eval_quota\);\n/, /fn small\([^\n]*\n    @branchHint\(\.cold\);\n    @setEvalBranchQuota\(rig\.eval_quota\);\n/, /fn peek\([^\n]*\n *@branchHint\(\.cold\);\n/
  # `inline` over the size limit, of a generic type's method, and with a type
  # parameter is `inline fn`; `rarely` is not inlined, and starts with the
  # cold hint; `called` is `noinline`, with no cold hint.

  inline fun big(a: Int) -> Int
    x = a
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x

  rarely fun small(a: Int) -> Int
    a + 1

  called fun tiny(a: Int) -> Int
    a - 1

  obj Wrap[T]
    value: T

    inline fun get(?self) -> T
      self.value

    rarely fun peek(?self) -> T
      self.value

    called fun same(?self) -> T
      self.value

  inline fun larger[T](a: T, b: T) -> T
    a if a > b else b

  sub main()
    w = Wrap[Int](value: 2)
    print(big(1), small(2), tiny(3), w.get(), w.peek(), w.same(), larger(3, 4))

code "markers none, the compiler's rule decides", "pub fn big(a: i64) i64 {", "pub inline fn small(", "pub fn larger(comptime T: type, ", /^(?![\s\S]*@branchHint)/, /^(?![\s\S]*noinline)/
  # Without the markers, the compiler's rule decides: `big` is over its size
  # and is called; `small`, `get`, and `peek` are inlined; `larger`, generic
  # over a type, is not; no function is cold or `noinline`.

  fun big(a: Int) -> Int
    x = a
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x = x * 3 + 1
    x

  fun small(a: Int) -> Int
    a + 1

  fun tiny(a: Int) -> Int
    a - 1

  obj Wrap[T]
    value: T

    fun get(?self) -> T
      self.value

    fun peek(?self) -> T
      self.value

    fun same(?self) -> T
      self.value

  fun larger[T](a: T, b: T) -> T
    a if a > b else b

  sub main()
    w = Wrap[Int](value: 2)
    print(big(1), small(2), tiny(3), w.get(), w.peek(), w.same(), larger(3, 4))

