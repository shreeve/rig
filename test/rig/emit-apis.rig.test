# emit: what a call through a bound lowers to (docs/design/apis.md, Stage
# 3, "Lowering"): a witness per conformance, one compile-time parameter
# per bound after the type it bounds, and `W.area(x)`.

code "apis a call through a witness", "W_T_Shape.area(rig.selfArg(W_T_Shape.area, &x))"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun total[T: Shape](xs: ?List[T]) -> Float
    t = 0.0
    for x in xs
      t += x.area()
    t

  xs: List[Square] = List()
  print(total(?xs))

code "apis a witness among a type's arguments", "Bag(Square, __rig_impl_Shape_Square)"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Bag[T: Shape]
    items: List[T]

  b = Bag[Square](items: List())
  print(b.items.len)

code "apis a header's witness", '''
  pub const __rig_impl_Shape_Square = struct {
      pub const area = Square.area;
      pub const describe = __rig_defaults_Shape(Square, @This()).describe;
  };
'''
  api Shape
    fun area(?@) -> Float

    fun describe(?@) -> String
      String("area ", @area())

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  print(Square(side: 1.0).describe())

code "apis a generic type's method through its bound", "W_T_Closer.close(rig.selfArg(W_T_Closer.close, x));"
  api Closer
    sub close(!@)

  obj File: Closer
    n: Int

    sub close(!@)
      @n = 0

  obj Bag[T: Closer]
    items: List[T]

    sub shut(!@)
      for x in !@items
        !x.close()

  b = Bag[File](items: List())
  !b.shut()
  print(b.items.len)

code "apis by name", "__rig_impl_Shape_Int.area(n)"
  api Shape
    fun area(?@) -> Float

  add Int: Shape
    fun area(?@) -> Float
      Float(@)

  n = 3
  print(Shape.area(n))

code "apis a method under a bound takes its witness", "comptime W_T_Shape: type) f64 {", "w.doubled(__rig_impl_Shape_Square)"
  # A method under a bound takes a witness after self for each API of a
  # program's own its bounds name; a call passes the type argument's.

  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side

  obj Wrap[T]
    x: T

  fun Wrap[T: Shape].doubled(?@) -> Float
    2.0 * @x.area()

  w = Wrap(x: Square(side: 3.0))
  print(w.doubled())

code "apis a slot's witness", "total(rig.SlotOf(4), __rig_impl_Shape_Slot(4), &ss)", "pub fn __rig_impl_Shape_Slot(comptime n: i64) type {"
  # An addition to `Slot[n]` is a function of `n`, as one to a generic
  # type is of its arguments.

  api Shape
    fun area(?@) -> Float

  add Slot[n]: Shape
    fun area(?@) -> Float
      Float(n)

  fun total[T: Shape](xs: ?List[T]) -> Float
    t = 0.0
    for x in xs
      t += x.area()
    t

  t: Table[Int, 4] = Table()
  s = (!t).push(7)
  ss = List([s])
  print(total(?ss))

code "apis an associated type through its witness", "rig.Opt(W_S_Source.Item)", "pub const Item = i64;", "rig.Opt(rig.IterItem(I))"
  # A body names an associated type through the witness of the bound that
  # declares it, which carries what each provider gives it; an iterator's
  # item is what its `next` gives.

  api Source
    type Item

    fun take(!@) -> Item? from @

  obj Count: Source
    n: Int

    fun take(!@) -> Int?
      none

    fun next(!@) -> Int?
      none

  fun first[S: Source](s: !S) -> S.Item?
    (!s).take()

  fun head[I: Iter](it: !I) -> I.Item?
    (!it).next()

  c = Count(n: 0)
  print(first(!c) ?? -1)
  d = Count(n: 0)
  print(head(!d) ?? -1)

# ---- API objects (Stage 4): a table per API, made per type where a
# conversion names it ----

code "apis object a call through its table", "return s.vt.area(s.ptr);"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape}) -> Float
    s.area()

  print(area_of(Square(side: 1.0)))

code "apis object an erasure names its type's table", ".vt = __rig_table_Shape_of(Square, __rig_impl_Shape_Square)"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape}) -> Float
    s.area()

  sq = Square(side: 1.0)
  print(area_of(sq))

code "apis object the table", '''
  pub const __rig_table_Shape = struct {
      area: *const fn (rig.ErasedRead) f64,
      grow: *const fn (rig.ErasedWrite, f64) void,
'''
  api Shape
    fun area(?@) -> Float
    sub grow(!@, by: Float)

  print(1)

code "apis object an entry calls the witness's method", '''
  fn area(__rig_ptr: rig.ErasedRead) f64 {
      const p = rig.erasedSelf(*const T, __rig_ptr);
      return W.area(rig.selfArg(W.area, p));
  }
'''
  api Shape
    fun area(?@) -> Float

  print(1)

code "apis object the slot after the arguments", "s.vt.size(s.ptr, 2, __out)"
  # A set with fields: the slot the frame holds goes on to the entry.

  error Bad
    long(n: Int)

  api Sized
    fun size(?@, k: Int) -> Int!Bad

  fun twice(s: ?{Sized}) -> Int!Bad
    s.size(2)! * 2

  print(1)

code "apis object a receiver evaluated once", "const __rig_obj_"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun pick(a: ?{Shape}) -> ?{Shape} from a
    a

  sq = Square(side: 1.0)
  print(pick(sq).area())
