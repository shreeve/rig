# emit: what a call through a bound lowers to (docs/design/apis.md, Stage
# 3, "Lowering"): a witness per conformance, one compile-time parameter
# per bound after the type it bounds, and `W.area(x)`.

code "apis a call through a witness", "W_T_Shape.area(rig.selfArg(W_T_Shape.area, &x))"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun total[T: Shape](xs: ?List[T]) -> Float
    t = 0.0
    for x in xs
      t += x.area()
    t

  xs: List[Square] = List()
  print(total(?xs))

code "apis a witness among a type's arguments", "Bag(Square, __rig_impl_Shape_Square)"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Bag[T: Shape]
    items: List[T]

  b = Bag[Square](items: List())
  print(b.items.len)

code "apis a header's witness", '''
  pub const __rig_impl_Shape_Square = struct {
      pub const area = Square.area;
      pub const describe = __rig_defaults_Shape(Square, @This()).describe;
  };
'''
  api Shape
    fun area(?@) -> Float

    fun describe(?@) -> String
      String("area ", @area())

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  print(Square(side: 1.0).describe())

code "apis a generic type's method through its bound", "W_T_Closer.close(rig.selfArg(W_T_Closer.close, x));"
  api Closer
    sub close(!@)

  obj File: Closer
    n: Int

    sub close(!@)
      @n = 0

  obj Bag[T: Closer]
    items: List[T]

    sub shut(!@)
      for x in !@items
        !x.close()

  b = Bag[File](items: List())
  !b.shut()
  print(b.items.len)

code "apis by name", "__rig_impl_Shape_Int.area(n)"
  api Shape
    fun area(?@) -> Float

  add Int: Shape
    fun area(?@) -> Float
      Float(@)

  n = 3
  print(Shape.area(n))

code "apis a method under a bound takes its witness", "comptime W_T_Shape: type) f64 {", "w.doubled(__rig_impl_Shape_Square)"
  # A method under a bound takes a witness after self for each API of a
  # program's own its bounds name; a call passes the type argument's.

  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side

  obj Wrap[T]
    x: T

  fun Wrap[T: Shape].doubled(?@) -> Float
    2.0 * @x.area()

  w = Wrap(x: Square(side: 3.0))
  print(w.doubled())

code "apis a slot's witness", "total(rig.SlotOf(4), __rig_impl_Shape_Slot(4), &ss)", "pub fn __rig_impl_Shape_Slot(comptime n: i64) type {"
  # An addition to `Slot[n]` is a function of `n`, as one to a generic
  # type is of its arguments.

  api Shape
    fun area(?@) -> Float

  add Slot[n]: Shape
    fun area(?@) -> Float
      Float(n)

  fun total[T: Shape](xs: ?List[T]) -> Float
    t = 0.0
    for x in xs
      t += x.area()
    t

  t: Table[Int, 4] = Table()
  s = (!t).push(7)
  ss = List([s])
  print(total(?ss))

code "apis an associated type through its witness", "rig.Opt(W_S_Source.Item)", "pub const Item = i64;", "rig.Opt(rig.IterItem(I))"
  # A body names an associated type through the witness of the bound that
  # declares it, which carries what each provider gives it; an iterator's
  # item is what its `next` gives.

  api Source
    type Item

    fun take(!@) -> Item? from @

  obj Count: Source
    n: Int

    fun take(!@) -> Int?
      none

    fun next(!@) -> Int?
      none

  fun first[S: Source](s: !S) -> S.Item?
    (!s).take()

  fun head[I: Iter](it: !I) -> I.Item?
    (!it).next()

  c = Count(n: 0)
  print(first(!c) ?? -1)
  d = Count(n: 0)
  print(head(!d) ?? -1)

# ---- API objects (Stage 4): a table per API, made per type where a
# conversion names it ----

code "apis object a call through its table", "return s.vt.area(s.ptr);"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape}) -> Float
    s.area()

  print(area_of(Square(side: 1.0)))

code "apis object an erasure names its type's table", ".vt = __rig_table_Shape_of(Square, __rig_impl_Shape_Square, .box)"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape}) -> Float
    s.area()

  sq = Square(side: 1.0)
  print(area_of(sq))

code "apis object the table", '''
  pub const __rig_table_Shape = struct {
      area: *const fn (rig.ErasedRead) f64,
      grow: *const fn (rig.ErasedWrite, f64) void,
'''
  api Shape
    fun area(?@) -> Float
    sub grow(!@, by: Float)

  print(1)

code "apis object an entry calls the witness's method", '''
  fn __rig_entry_area(__rig_ptr: rig.ErasedRead) f64 {
      const __rig_p = rig.erasedSelf(*const __rig_T, __rig_ptr);
      return __rig_W.area(rig.selfArg(__rig_W.area, __rig_p));
  }
'''
  api Shape
    fun area(?@) -> Float

  print(1)

code "apis object the slot after the arguments", "s.vt.size(s.ptr, 2, __out)"
  # A set with fields: the slot the frame holds goes on to the entry.

  error Bad
    long(n: Int)

  api Sized
    fun size(?@, k: Int) -> Int!Bad

  fun twice(s: ?{Sized}) -> Int!Bad
    s.size(2)! * 2

  print(1)

code "apis object a receiver evaluated once", "const __rig_obj_"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun pick(a: ?{Shape}) -> ?{Shape} from a
    a

  sq = Square(side: 1.0)
  print(pick(sq).area())

# ---- Stage 4, phase 3: boxes of API objects ----

code "apis object box its type", "var b: rig.ApiBox(__rig_table_Shape, \"\") =", "var c: rig.ApiBox(__rig_table_Shape, \" + Owned + Print\") ="
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  b: ^{Shape} = ^Square(side: 1.0)
  c: ^{Shape + Print + Owned} = ^Square(side: 1.0)
  print(b.area(), c.area())

code "apis object box a move allocates nothing", "rig.ApiBox(__rig_table_Shape, \"\").of(Square, rig.take(&__rig_alive_c, c), __rig_table_Shape_of(Square, __rig_impl_Shape_Square, .box))"
  # `<c` keeps the allocation its `^Square` made.

  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  c = ^Square(side: 1.0)
  b: ^{Shape} = <c
  print(b.area())

code "apis object box a consuming entry frees the box", '''
  fn __rig_entry_close(__rig_ptr: rig.ErasedOwn) void {
      var __rig_self = rig.erasedTake(__rig_T, __rig_ptr);
      const __rig_p = &__rig_self;
      return __rig_W.close(rig.selfArg(__rig_W.close, __rig_p));
  }
'''
  api Shape
    sub close(<@)

  print(1)

code "apis object box the drop and clone entries", ".__rig_drop = rig.dropErased(__rig_T, __rig_H), .__rig_clone = rig.cloneErased(__rig_T, __rig_H)"
  api Shape
    fun area(?@) -> Float

  print(1)

code "apis object crossing a task through its table", "rig.Task(f64).spawnObject(b, \"area\", .{ });", "rig.ApiView(__rig_table_Shape, .read, \" + Syncs\")"
  # A call through an object whose braces let it cross is a task on any
  # core, given the object's two words; a crossing bound changes no Zig
  # but the braces the type is spelled with.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape + Syncs}) -> Float
    s.area()

  b: ^{Shape + Syncs + Sends} = ^Square(side: 2.0)
  t = ?b.area()&
  u = area_of(?b)&
  print(>t, >u)

# ---- Stage 5, phase 2: shared and weak objects ----

code "apis object shared its types", "const s: rig.ApiShared(__rig_table_Shape, \"\") =", "const w = s.weakRef();", "const f: rig.ApiShared(__rig_table_Shape, \" + Syncs\") ="
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  s: *{Shape} = *Square(side: 2.0)
  w = ~s
  f: *{Shape + Syncs} = *Frozen(Square(side: 1.0))
  print(s.area(), f.area())

code "apis object shared a move keeps its allocation and count", "rig.ApiShared(__rig_table_Shape, \"\").of(rig.take(&__rig_alive_h, h), __rig_table_Shape_of(Square, __rig_impl_Shape_Square, .counted))"
  # `<h` keeps the allocation `*Square(...)` made: nothing is allocated
  # or counted again.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  h = *Square(side: 2.0)
  s: *{Shape} = <h
  print(s.area())

code "apis object shared a frozen value's table", "__rig_table_Shape_of(Square, __rig_impl_Shape_Square, .frozen)"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  f: *{Shape + Syncs} = *Frozen(Square(side: 1.0))
  print(f.area())

code "apis object shared counts, lends, and calls through the table", "const t = s.cloneStrong();", "area_of(s.read())", "t.vt.area(t.ptr)", "if (w.upgrade()) |"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape}) -> Float
    s.area()

  s: *{Shape} = *Square(side: 2.0)
  t = +s
  w = ~s
  print(area_of(?s), t.area())
  if *w as u
    print(u.area())

code "apis object shared the count entries", ".__rig_weak = rig.weakErased(__rig_T, __rig_H), .__rig_weak_drop = rig.weakDropErased(__rig_T, __rig_H), .__rig_upgrade = rig.upgradeErased(__rig_T, __rig_H)", "comptime __rig_H: rig.ApiHolding"
  # Three entries beside a box's: a weak count made, given back, and
  # upgraded, each reaching the counts from the value's address.
  api Shape
    fun area(?@) -> Float

  print(1)
