    n: Int

    drop(!@)
      print("drop", @n)

  fun mk(o: ?R?) -> *fun() -> Int
    if o as x
      *|?x| x.n
    else
      *|| 0

  o: R? = R(n: 1)
  f = mk(?o)
  o = none
  print(f())

