    r

  fun opt(r: ?T, k: Int) -> (?T)?!
    return Bad.oops if k == 0
    return none if k == 1
    r

  fun idv(t: T) -> T
    t

  fun unopt(t: T?, d: T) -> T
    if t as v
      return v
    d

  fun retv(o: (?T)?, a: ?T, b: ?T) -> T
    o ?? b

  a = T.a
  b = T.b
  c = unopt((opt(?a, 2) catch ?b) ?? ?b, b)
  print((c == T.a))
