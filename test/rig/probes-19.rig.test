    n: Int
    next: *B?

  obj B
    n: Int
    next: ^A?

  head: ^A? = none
  i = 0
  while i < 150000
    b = *B(n: i, next: <head)
    head = ^A(n: i, next: <b)
    i += 1
  print("built")
  head = none
  print("done")

