# Probes from past reviews and audits, 19 of 41: review-box-p135 to review-copies-2-g-E-optcatch-argopt.

test "review-box-p135", '''
  0 0
  5 .a(n: 5)
  3
'''
  enum E
    a(n: Int)
    b

    fun get(?@) -> Int
      match @
        .a(n) => n
        .b => 0

    sub set(!@, k: Int)
      @ = .a(n: k)

    fun eat(<@) -> Int
      3

  fun g(e: ?^E) -> Int
    e.get()

  e = ^E.b
  print(e.get(), g(?e))
  !e.set(5)
  print(e.get(), e)
  print(<e.eat())

