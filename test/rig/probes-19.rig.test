test "review-cell-temp2-2-q07 arm view regression", '''
  arm 6
  arm2 2 5
  none
  none
  5 5 -2
'''
  # A temporary made in a `match` arm that views the arm's binding: the
  # arm's body is a statement of its own, so the temporary ends with the
  # arm, inside the binding's scope.
  obj P
    n: Int

  obj HT
    v: ?P
    t: String

  fun len2(h: ?HT) -> Int
    h.v.n + h.t.len

  fun mkht(v: ?P) -> HT
    HT(v: v, t: String("ab"))

  enum Bx
    has(p: P)
    nothing

  sub arms(b: ?Bx)
    match b
      .has(x) => print("arm", len2(?HT(v: ?x, t: String("abc"))))
      .nothing => print("none")
    match b
      .has(x) => print("arm2", mkht(?x).t.len, len2(?mkht(?x)))
      .nothing => print("none")

  fun arms3(b: ?Bx) -> Int
    r = match b
      .has(x) => len2(?mkht(?x))
      .nothing => 0
    r

  fun arms4(n: Int) -> Int
    match n
      m if m > 0 => len2(?HT(v: ?P(n: m), t: String("q")))
      m => m

  b = Bx.has(P(n: 3))
  arms(?b)
  arms(?Bx.nothing)
  print(arms3(?b), arms4(4), arms4(-2))

test "review-cell-temp2-2-q12 arm binding view drop", '''
  zero
  m 12
  drop hi 10
  m 22
  drop hi 20
  x 10
  drop hp 7
'''
  # A temporary made in a `match` arm whose drop reads a view of the arm's
  # binding. Where emit keeps the arm's temporary past the arm, the drop
  # would read a binding whose scope has ended.
  obj P
    n: Int

  obj HI
    v: ?Int
    t: String

    drop(!@)
      print("drop hi", @v)

  obj HP
    v: ?P
    t: String

    drop(!@)
      print("drop hp", @v.n)

  enum Bx
    has(p: P)
    nothing

  fun showi(h: ?HI) -> Int
    h.v + h.t.len

  fun showp(h: ?HP) -> Int
    h.v.n + h.t.len

  fun mkbx(n: Int) -> Bx
    return Bx.nothing if n < 0
    Bx.has(P(n: n))

  for i in 0..3
    match i * 10
      0 => print("zero")
      m => print("m", showi(?HI(v: ?m, t: String("ab"))))
  match mkbx(7)
    .has(x) => print("x", showp(?HP(v: ?x, t: String("abc"))))
    .nothing => print("none")

test "review-cell-temp2-p14 none leaf plain", '''
  v 2
  q 0
  q -1
'''
  # A `none` leaf of an optional that branches, unwrapped with `?` and read
  # by a field, for a type with no Cell: emitted as the address of a
  # `null` literal, a Zig compile error (main and branch).
  #
  # oracle: mk accept
  # oracle: opt accept
  # oracle: main accept
  obj Q
    n: Int
    t: String

  fun mk(n: Int) -> Q
    Q(n: n, t: String("x"))

  fun opt(k: Bool) -> Int?
    o: Q? = mk(2)
    print("v", (o if k else none)?.n)
    0

  print("q", opt(true) ?? -1)
  print("q", opt(false) ?? -1)

test "review-cell-temp2-p21 unique named leaf", '''
  1 1
  1
  5 6
  7
'''
  # A `unique` type without a Cell: a read lend of a branch beside a name's
  # value (rejected now: it would copy the unique value into the slot), a
  # `?@` method on such a branch, and a read of a field.
  #
  # oracle: R.get accept
  # oracle: mkr accept
  # oracle: look accept
  # oracle: go accept
  # oracle: main accept
  obj R unique
    n: Int

    fun get(?@) -> Int
      @n

  fun mkr(n: Int) -> R
    R(n: n)

  fun look(r: ?R) -> Int
    r.n

  sub go(k: Bool)
    r = mkr(1)
    print((r if k else mkr(5)).get(), (r if k else mkr(6)).n)
    print(look(?r if k else ?mkr(7)))

  go(true)
  go(false)

test "review-cell-temp2-p22 all none branch", '''
  2
  1
'''
  # A branch whose every leaf is `none`, beside a name's optional, as the
  # left of `??`: emit stops with "cannot emit a value of this type".
  #
  # oracle: mk accept
  # oracle: go accept
  # oracle: main accept
  obj Q
    n: Int
    t: String

  fun mk(n: Int) -> Q
    Q(n: n, t: String("x"))

  sub go(k: Bool, j: Bool)
    a = mk(1)
    o: Q? = mk(2)
    print(((o if j else (none if k else none)) ?? a).n)

  go(true, true)
  go(true, false)

test "review-copies-2-g-E-catchfail-argopt", "false"
  error Bad
    oops

  enum T
    a
    b

  obj H
    t: T

  obj HO
    t: T?

  fun get(r: ?T, ok: Bool) -> (?T)!
    return Bad.oops if not ok
    r

  fun opt(r: ?T, k: Int) -> (?T)?!
    return Bad.oops if k == 0
    return none if k == 1
    r

  fun idv(t: T) -> T
    t

  fun unopt(t: T?, d: T) -> T
    if t as v
      return v
    d

  fun retv(o: (?T)?, a: ?T, b: ?T) -> T
    o ?? b

  a = T.a
  b = T.b
  c = unopt(get(?a, false) catch ?b, b)
  print((c == T.a))

