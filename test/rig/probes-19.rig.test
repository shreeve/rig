    oops

  fun f(k: Int) -> Int!
    b = ^R(n: k)
    o: ^R? = ^R(n: k + 10)
    if !o as x
      defer print("deferred", x.n)
      return Bad.oops if k > 1
      x.n = 99
    b.n

  fun h(k: Int) -> Int!
    o: ^R? = ^R(n: k + 20)
    if !o as x
      x.n = f(k)!
      return x.n
    0

  fun mkopt(k: Int) -> ^R?
    return none if k > 1
    ^R(n: 5)

  fun g(k: Int) -> Int?
    b = ^R(n: k)
    o = mkopt(k)
    if ?o as y
      q = mkopt(k)?
      return y.n + q.n + b.n
    0

  print(f(1) catch -1)
  print(f(2) catch -1)
  print(h(2) catch -1)
  print(g(1) ?? -1)
  print(g(2) ?? -1)

test "review-box-p99", '''
  drop 7
  drop 1
  1
  drop 7
  -1
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  fun mkopt(k: Int) -> ^R?
    return none if k > 1
    ^R(n: k)

  fun g(k: Int) -> Int?
    o: ^R? = ^R(n: 7)
    if !o as y
      q = mkopt(k)?
      y = <q
    z = (<o)?
    z.n

  print(g(1) ?? -1)
  print(g(2) ?? -1)

