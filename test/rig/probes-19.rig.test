    drop(!@)
      print("drop", @n)

  obj H2
    r: ^R?

  obj H
    h2: H2

    fun rinner(?@) -> ?H2
      ?@h2

  fun rin(h: ?H) -> ?H2
    ?h.h2

  h = H(h2: H2(r: ^R(n: 1)))
  x = ?h.rinner().r
  h = H(h2: H2(r: none))
  if x as y
    print(y.n)

