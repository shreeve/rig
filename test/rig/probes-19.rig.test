test "review-box-p138", '''
  1 2 1
  1
  1
  drop 2
  drop 1
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  fun rd(r: ?R) -> Int
    r.n

  fun pick(k: Int, b: ?^R, c: ?^R) -> ?R
    if k > 0
      ?b
    else
      ?c

  fun pick2(k: Int, b: ?^R, c: ?R) -> ?R
    match k
      1 => ?b
      _ => c

  b = ^R(n: 1)
  c = ^R(n: 2)
  print(pick(1, ?b, ?c).n, pick(0, ?b, ?c).n, pick2(1, ?b, ?c).n)
  k = 1
  print(rd(?b if k > 0 else ?c))
  r: ?R = ?b if k > 0 else ?c
  print(r.n)

test "review-box-p140", '''
  1
  found 8
'''
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      if key < n.key
        insert(!n.left, key)
      else
        insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  fun find(root: ?^Node?, k: Int) -> (?^Node)?
    cur = root
    while cur as n
      if n.key == k
        return n
      cur = ?n.left if k < n.key else ?n.right
    none

  fun min(root: ?^Node?) -> Int
    cur = root
    best = -1
    while cur as n
      best = n.key
      cur = ?n.left
    best

  root: ^Node? = none
  for k in [5, 2, 8, 1, 9, 3]
    insert(!root, k)
  print(min(?root))
  if find(?root, 8) as f
    print("found", f.key)
  if find(?root, 7) as _
    print("bad")

fail "review-box-p142", "bare use of loop view `x` in binding would carry the viewed handle past the loop; a `for x in ?list` element is a read view of the List slot and cannot be cloned, moved, dropped, or stored"
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  v: List[^R] = List()
  !v.push(^R(n: 1))
  for x in ?v
    new x = x
    print(x.n)

