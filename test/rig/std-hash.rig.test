# std: tests whose names start `hash`.

use std.hash

test "hash churn", '''
  true true true true
  true true
  true true true
'''
  # std.hash's Map and Set against a plain reference, a List of pairs searched in
  # turn, over a long pseudo-random run of puts, takes, gets, edits,
  # `put_new`s, `ensure`s, `retain`s, and clears, at sizes that cross from a small Map (no table) to a table
  # and back after a clear, and with room reserved. After every step the
  # two agree on the length and on every key, and their walks agree in
  # order.


  obj Pair
    key: Int
    value: Int
    live: Bool

  obj Model
    pairs: List[Pair] = List()
    len: Int = 0

    fun find(?self, k: Int) -> Int?
      for p, i in ?self.pairs
        return i if p.live and p.key == k
      none

    sub put(!self, k: Int, v: Int)
      if self.find(k) as i
        self.pairs[i].value = v
      else
        !self.pairs.push(Pair(key: k, value: v, live: true))
        self.len += 1

    fun take(!self, k: Int) -> Int?
      if self.find(k) as i
        self.pairs[i].live = false
        self.len -= 1
        return self.pairs[i].value
      none

    sub bump(!self, k: Int)
      if self.find(k) as i
        self.pairs[i].value += 1

    sub clear(!self)
      !self.pairs.clear()
      self.len = 0

    # Keep the live pairs `kept_after` is true for, each value first
    # raised by `raise`, as a `retain` raises it.
    sub retain(!self, raise: Int)
      kept: List[Pair] = List()
      for p in ?self.pairs
        if p.live and kept_after(p.key, p.value + raise)
          !kept.push(Pair(key: p.key, value: p.value + raise, live: true))
      self.len = kept.len
      self.pairs = <kept

  fun kept_after(k: Int, v: Int) -> Bool
    (k / 1024 + v) % 3 != 0

  fun raise_and_keep(k: ?Int, v: !Int) -> Bool
    v += 2
    kept_after(k, v)

  obj Rand
    s: U64

    fun next(!self, n: Int) -> Int
      self.s = self.s *% 6364136223846793005 +% 1442695040888963407
      Int((self.s >> 33) % U64(n))

  fun agree(m: ?hash.Map[Int, Int], ref: ?Model, span: Int) -> Bool
    return false if m.len != ref.len
    for x in 0..span
      k = x * 1024
      want: Int? = none
      if ref.find(k) as i
        want = ref.pairs[i].value
      got: Int? = none
      if m.get(k) as v
        got = v
      return false if got != want
    # The walk is in the order keys were first put in.
    order: List[Int] = List()
    for e in ?m.items()
      !order.push(e.key)
    i = 0
    for p in ?ref.pairs
      if p.live
        return false if i >= order.len or order[i] != p.key
        i += 1
    i == order.len

  fun run(seed: U64, span: Int, steps: Int, reserve: Int) -> Bool
    r = Rand(s: seed)
    m = hash.Map[Int, Int].new(capacity: reserve)
    ref = Model()
    for step in 0..steps
      op = (!r).next(20)
      k = (!r).next(span) * 1024
      if op < 9
        !m.put(k, step)
        !ref.put(k, step)
      else if op < 14
        return false if (!m).take(k) != (!ref).take(k)
      else if op < 15
        if (!m).edit(k) as v
          v += 1
          !ref.bump(k)
      else if op < 16
        return false if (!m).put_new(k, step) != (ref.find(k) == none)
        !ref.put(k, step) if ref.find(k) == none
      else if op < 18
        c = (!m).ensure(k, step)
        c += 1
        !ref.put(k, step) if ref.find(k) == none
        !ref.bump(k)
      else if op < 19
        if (!r).next(10) == 0
          !m.retain(|key, val| raise_and_keep(key, !val))
          !ref.retain(2)
      else if (!r).next(25) == 0
        !m.clear()
        !ref.clear()
      return false if not agree(?m, ?ref, span)
    true

  fun set_agrees(s: ?hash.Set[Int], ref: ?Model, span: Int) -> Bool
    return false if s.len != ref.len
    for x in 0..span
      return false if s.has(x * 1024) != (ref.find(x * 1024) != none)
    order: List[Int] = List()
    for k in ?s.items()
      !order.push(k)
    i = 0
    for p in ?ref.pairs
      if p.live
        return false if i >= order.len or order[i] != p.key
        i += 1
    i == order.len

  fun run_set(seed: U64, span: Int, steps: Int, reserve: Int) -> Bool
    r = Rand(s: seed)
    s = hash.Set[Int].new(capacity: reserve)
    ref = Model()
    for _ in 0..steps
      op = (!r).next(10)
      k = (!r).next(span) * 1024
      if op < 6
        return false if (!s).add(k) != (ref.find(k) == none)
        !ref.put(k, 0)
      else if op < 9
        got = (!s).take(k)
        return false if (got != none) != ((!ref).take(k) != none)
      else if (!r).next(10) == 0
        # The Model's values for a Set are all 0, and stay 0.
        !s.retain(|key| kept_after(key, 0))
        !ref.retain(0)
      else if (!r).next(50) == 0
        !s.clear()
        !ref.clear()
      return false if not set_agrees(?s, ?ref, span)
    true

  print(run(1, 6, 400, 0), run(2, 12, 2000, 0), run(3, 40, 4000, 0), run(4, 300, 6000, 0))
  print(run(5, 40, 3000, 100), run(6, 9, 3000, 9))
  print(run_set(7, 6, 400, 0), run_set(8, 40, 4000, 0), run_set(9, 300, 6000, 50))

test "hash compound keys", '''
  10 5 false
  10 5 false
'''
  # A compound key is an object of its parts. One that owns its text is
  # looked up with a key built the same way, its text owned too; one that
  # holds a view of its text looks up with no copy, and its Map holds
  # views, so the text it views is declared before the Map.


  obj Key
    name: String
    n: Int

  obj KeyView
    name: ?String
    n: Int

  m = hash.Map[Key, Int].new()
  !m.put(Key(name: String("a"), n: 1), 10)
  c = (!m).ensure(Key(name: String("b"), n: 2), 0)
  c += 5
  print(m.get(Key(name: String("a"), n: 1)), m.get(Key(name: String("b"), n: 2)), m.has(Key(name: String("a"), n: 2)))

  t = String("a")
  v = hash.Map[KeyView, Int].new()
  !v.put(KeyView(name: ?t, n: 1), 10)
  w = (!v).ensure(KeyView(name: "b", n: 2), 0)
  w += 5
  print(v.get(KeyView(name: "a", n: 1)), v.get(KeyView(name: "b", n: 2)), v.has(KeyView(name: "a", n: 2)))

test "hash ensure chain", "[5, 6] 1"
  # The write view `ensure` returns takes a write call in the same
  # statement, with no `!` before the receiver it already lends.


  b = hash.Map[Int, List[Int]].new()
  (!b).ensure(1, List()).push(5)
  (!b).ensure(1, List()).push(6)
  print(b.get(1), b.len)

fail "hash ensure keeps lent", "use of `m.len` while a write loan on `m` is live"
  # The write view `ensure` returns is `from self`: it keeps the Map lent
  # to write, so the Map cannot be read or written while the view lives.


  m = hash.Map[Int, Int].new()
  c = (!m).ensure(1, 0)
  print(m.len)
  c += 1

test "hash ensure with", '''
  ab true
  cd true
  ab false
  ab false
  ef true
  cd false
  3 3
  ab ["ab!", "ab", "ab", "ab"]
  cd ["cd!", "cd", "cd"]
  ef ["ef!", "ef"]
  10 10 13 85
'''
  # `ensure_with` lends the value under a key to write, making it with
  # `make` only when the key is new: a `|!count|` capture counts the calls,
  # and a `|!added|` capture reports whether the key was new. Values that
  # own memory are made, kept, and dropped clean.


  fun make(k: ?String, count: !Int, added: !Bool) -> List[String]
    count += 1
    added = true
    l = List[String]()
    !l.push(String(k, "!"))
    l

  count = 0
  m = hash.Map[String, List[String]].new()
  for w in ["ab", "cd", "ab", "ab", "ef", "cd"]
    added = false
    g = (!m).ensure_with(String(w), |!count, !added, k| make(k, !count, !added))
    !g.push(String(w))
    print(w, added)
  print(count, m.len)
  for e in ?m.items()
    print(e.key, e.value)

  calls = 0
  sq = hash.Map[Int, Int].new()
  for i in 0..40
    v = (!sq).ensure_with(i % 10, |!calls, k| square(k, !calls))
    v += 1
  print(calls, sq.len, sq.get(3), sq.get(9))

  fun square(k: ?Int, calls: !Int) -> Int
    calls += 1
    k * k

fail "hash ensure with no map", "cannot lend `m` to write while a read loan is live"
  # `ensure_with` holds the Map lent to write while `make` runs, so `make`
  # cannot capture the Map.


  m = hash.Map[Int, Int].new()
  v = (!m).ensure_with(1, |?m, k| m.len + k)
  v += 1

fail "hash get keeps lent", "cannot lend `m` to write while a read loan is live"
  # The view `get` returns is `from self`: it keeps the Map lent to read,
  # so the Map cannot be written while the view lives.


  m = hash.Map[String, Int].new()
  r = ?m.get("a")
  !m.put(String("b"), 1)
  print(r)

fail "hash items then put", "cannot lend `m` to write while a read loan is live"
  # The iterator `items` returns views the Map, which stays lent to read
  # while the loop walks it.


  m = hash.Map[String, Int].new()
  !m.put(String("a"), 1)
  for e in ?m.items()
    !m.put(String("c"), 2)

fail "hash key no eq", "cannot use `K = List[Int]`"
  # A key is a value `.hash()` takes, and a List has no `==`.


  m = hash.Map[List[Int], Int].new()
  print(m.len)

fail "hash key same type", "type mismatch: expected `?Key`, got `KeyView`"
  # A lookup takes a view of the Map's own key type: an object with the
  # same parts, its text viewed rather than owned, is another type.


  obj Key
    name: String
    n: Int

  obj KeyView
    name: ?String
    n: Int

  m = hash.Map[Key, Int].new()
  print(m.get(KeyView(name: "a", n: 1)))

fail "hash len read only", "7:9: `len` is a field of `hash.Map[String, Int]`, not a method: write `m.len`", "7:18: `len` is a field of `hash.Set[Int]`, not a method: write `s.len`", "8:3: cannot assign to `m.len`: field `len` of `hash.Map` is read-only outside module `std.hash`, which declares it `pub ?len`", "9:3: cannot assign to `s.len`: field `len` of `hash.Set` is read-only outside module `std.hash`", errors: 4
  # A Map's and a Set's `len` is a field, read anywhere and written only
  # by `std.hash`; `len()` is no method.


  m = hash.Map[String, Int]()
  s = hash.Set[Int]()
  print(m.len(), s.len())
  m.len = 3
  s.len += 1

test "hash map", '''
  0 false none
  2 uno two false
  two none
  dos
  uno none 2
  b dos
  c tres!
  a again
  b
  c
  a
  dos
  tres!
  again
  0 none
  666 332667 true true none
  1000 1000
  7
  to 4
  be 4
  or 3
  not 4
  a b false
  1 2 none
  true true false 2
  true false x none 1
  y
  z
  x
  0 false
  true false 1 1 0 0
  0 false
'''
  # std.hash's Map and Set: every member, over owned and viewed text keys,
  # integers, objects, and enums, through growth, taking, and clearing,
  # with values that own memory, in the order keys were first put in.
  # `hash.Map[K, V]()` and `hash.Set[K]()` make empty ones, also as a
  # field's default, and `len` is a field read anywhere.


  obj Pt
    x: Int
    y: Int

  enum Key
    name(s: String)
    num(n: Int)

  sub bump(k: ?String, v: !Int)
    v += k.len

  obj Binder
    ids: hash.Map[U32, U32] = hash.Map[U32, U32]()
    seen: hash.Set[U32] = hash.Set[U32]()

  m = hash.Map[String, String].new()
  print(m.len, m.has("a"), m.get("a"))
  !m.put(String("a"), String("one"))
  !m.put(String("b"), String("two"))
  !m.put(String("a"), String("uno"))
  print(m.len, m.get("a"), m.get("b"), m.has("c"))
  old = (!m).replace(String("b"), String("dos"))
  print(old, (!m).replace(String("c"), String("tres")))
  if (!m).edit("c") as v
    !v.add("!")
  t = String("b")
  print(m.get(?t))
  print((!m).take("a"), (!m).take("a"), m.len)
  !m.put(String("a"), String("again"))
  for e in ?m.items()
    print(e.key, e.value)
  for k in ?m.keys()
    print(k)
  for v in ?m.values()
    print(v)
  !m.clear()
  print(m.len, m.get("b"))

  ints = hash.Map[Int, Int].new()
  for i in 0..1000
    !ints.put(i * 7, i)
  for i in 0..1000
    if i % 3 == 0
      _ = (!ints).take(i * 7)
  sum = 0
  for i in 0..1000
    if ints.get(i * 7) as v
      sum += v
  print(ints.len, sum, ints.has(7), ints.has(14), ints.get(6993))
  for i in 0..1000
    !ints.put(i * 7, 1)
  count = 0
  for e in ?ints.items()
    count += e.value
  print(ints.len, count)
  first = 0
  for k in ?ints.keys()
    first = k
    break
  print(first)

  counts = hash.Map[?String, Int].new()
  words = ["to", "be", "or", "not", "to", "be"]
  for w in words
    if (!counts).edit(w) as c
      c += 1
    else
      !counts.put(w, 1)
  !counts.update(bump)
  for e in ?counts.items()
    print(e.key, e.value)

  pts = hash.Map[Pt, ?String].new()
  !pts.put(Pt(x: 1, y: 2), "a")
  !pts.put(Pt(x: 2, y: 1), "b")
  print(pts.get(?Pt(x: 1, y: 2)), pts.get(?Pt(x: 2, y: 1)), pts.has(?Pt(x: 1, y: 1)))

  keyed = hash.Map[Key, Int].new()
  !keyed.put(Key.name(s: String("x")), 1)
  !keyed.put(Key.num(n: 5), 2)
  print(keyed.get(Key.name(s: String("x"))), keyed.get(Key.num(n: 5)), keyed.get(Key.num(n: 6)))

  s = hash.Set[String].new()
  print((!s).add(String("x")), (!s).add(String("y")), (!s).add(String("x")), s.len)
  print(s.has("x"), s.has("z"), (!s).take("x"), (!s).take("x"), s.len)
  _ = (!s).add(String("z"))
  _ = (!s).add(String("x"))
  for k in ?s.items()
    print(k)
  !s.clear()
  print(s.len, s.has("y"))
  bd = Binder()
  other = Binder()
  !bd.ids.put(1, 10)
  print((!bd.seen).add(1), (!bd.seen).add(1), bd.ids.len, bd.seen.len, other.ids.len, other.seen.len)
  e = hash.Map[Int, Int]()
  print(e.len, e.has(1))

test "hash results", '''
  new a
  new b
  new c
  3 1 3
  0 a 3
  1 b 1
  2 c 1
  after take c 1
'''
  # `Map.ensure_added` lends the value under a key to write, with whether
  # the key was new; `Map.at` gives the entry at an index, in order.

  sub count(m: !hash.Map[String, Int], word: ?String)
    w, added = (!m).ensure_added(String(word), 0)
    w += 1
    print("new", word) if added

  m = hash.Map[String, Int]()
  for word in ["a", "b", "a", "c", "a"]
    count(!m, word)
  print(m.get("a") ?? 0, m.get("b") ?? 0, m.len)
  i = 0
  while m.at(i) as k, v
    print(i, k, v)
    i += 1
  _ = (!m).take("b")
  if m.at(1) as k, v
    print("after take", k, v)
  if m.at(2) as k, v
    print("past the end", k, v)
  if m.at(-1) as k, v
    print("below the start", k, v)

fail "hash retain no map", "cannot lend `m` to write while a read loan is live"
  # `retain` holds the Map lent to write while its closure runs, so the
  # closure cannot capture the Map, to read it or to write it.


  m = hash.Map[Int, Int].new()
  !m.put(1, 1)
  !m.retain(|?m, k, v| m.len > 1)
  print(m.len)

test "hash symbols", '''
  0 1 0 none height 2
  1011 1010 n0
  true
  0 1 0 2
'''
  # std.hash's Symbols: a string gets a dense id from 0 the first time
  # it is interned, the same id after, from any text type; `id` finds one
  # without adding it, and `text` views an id's text. Over many strings
  # it crosses from scanning its few stored hashes to a table, and every
  # id still names its own text.


  names = hash.Symbols()
  a = (!names).intern("width")
  b = (!names).intern("height")
  w = String("wid", "th")
  print(a, b, (!names).intern(?w), names.id("depth"), names.text(b), names.len)
  for i in 0..3000
    t = String("n", i % 1009)
    id = (!names).intern(?t)
    if names.text(id) != t
      print("wrong text", id)
  print(names.len, names.id("n1008"), names.text(names.id("n0") ?? 0))
  ok = true
  for i in 0..1009
    t = String("n", i)
    if names.id(?t) as id
      ok = ok and id == U32(i + 2) and names.text(id) == t
    else
      ok = false
  print(ok)
  more = hash.Symbols()
  !more.reserve(4, bytes: 16)
  print((!more).intern(""), (!more).intern("x"), (!more).intern(""), more.len)

test "hash write drops", '''
  0 true
  drop 2
  a false
  drop 3
  b 11
  c 11
  make 2
  d 200
  e true
  drop 11
  f 4
  drop 200
  g 1
  drop 4
'''
  # `put_new` and `ensure` drop the key and value they do not store at
  # the call, `ensure_with` does not call `make` for a key already there,
  # and `retain` drops an entry it rejects then.

  obj Res
    n: Int

    drop(!self)
      print("drop", self.n)

  fun mk(k: ?Int) -> Res
    print("make", k)
    Res(n: k * 100)

  m = hash.Map[Int, Res].new()
  print(m.len, (!m).put_new(1, Res(n: 1)))
  print("a", (!m).put_new(1, Res(n: 2)))
  c = (!m).ensure(1, Res(n: 3))
  c.n += 10
  print("b", c.n)
  d = (!m).ensure_with(1, mk)
  print("c", d.n)
  e = (!m).ensure_with(2, mk)
  print("d", e.n)
  t = (!m).take(1)
  print("e", t != none)
  <t
  f = (!m).ensure(1, Res(n: 4))
  print("f", f.n)
  !m.retain(|k, r| k == 1)
  print("g", m.len)

test "hash writes", '''
  to 3
  be 2
  or 1
  not 1
  2 ["to", "be", "or", "to", "be", "to"]
  3 ["not"]
  ["to", "be", "or", "not"] 0 1 4
  ab abab+
  cd cdcd
  drop 31
  drop 71
  drop 101
  drop 111
  kept 8
  0 1
  1 11
  2 21
  4 41
  5 51
  6 61
  8 81
  9 91
  false true
  9 true
  16 false true [1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13, 14, 16, 17, 18, 19]
  end
  drop 1
  drop 91
  drop 81
  drop 61
  drop 51
  drop 41
  drop 21
  drop 11
  drop 1
'''
  # std.hash's writes beyond `put`: `ensure` lends the value under a key,
  # putting one first when the key is new; `put_new` puts only a new key,
  # so the first value wins; `edit` then `put` makes a value only for a
  # new key; and `retain` keeps, in order, the entries a closure says to,
  # writing values as it goes and dropping each entry it rejects then.


  obj Res
    n: Int

    drop(!self)
      print("drop", self.n)

  words = ["to", "be", "or", "not", "to", "be", "to"]

  counts = hash.Map[String, Int].new()
  for w in words
    c = (!counts).ensure(String(w), 0)
    c += 1
  for e in ?counts.items()
    print(e.key, e.value)

  groups = hash.Map[Int, List[String]].new()
  for w in words
    g = (!groups).ensure(w.len, List())
    !g.push(String(w))
  for e in ?groups.items()
    print(e.key, e.value)

  seen = hash.Map[?String, Int].new()
  order = List[?String]()
  for i in 0..words.len
    if (!seen).put_new(words[i], i)
      !order.push(words[i])
  print(order, seen.get("to"), seen.get("be"), seen.len)

  made = hash.Map[String, String].new()
  for w in ["ab", "cd", "ab"]
    if (!made).edit(w) as s
      !s.add("+")
    else
      !made.put(String(w), String(w, w))
  for e in ?made.items()
    print(e.key, e.value)

  res = hash.Map[Int, Res].new()
  for i in 0..12
    !res.put(i, Res(n: i * 10))
  !res.retain(|k, r| keep(k, !r))
  print("kept", res.len)
  for e in ?res.items()
    print(e.key, e.value.n)
  print(res.has(3), res.get(4) != none)
  !res.put(30, Res(n: 1))
  print(res.len, res.has(30))

  nums = hash.Set[Int].new()
  for i in 0..20
    _ = (!nums).add(i)
  !nums.retain(|k| k % 5 != 0)
  out = List[Int]()
  for k in ?nums.items()
    !out.push(k)
  print(nums.len, nums.has(5), nums.has(6), out)
  print("end")

  fun keep(k: ?Int, r: !Res) -> Bool
    r.n += 1
    k % 4 != 3 and k < 10
