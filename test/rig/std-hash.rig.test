# std: tests whose names start `hash`.

test "hash churn", '''
  true true true true
  true true
  true true true
'''
  # Map and Set against a plain reference, a List of pairs searched in
  # turn, over a long pseudo-random run of puts, takes, gets, edits,
  # `put_new`s, `ensure`s, `retain`s, and clears, at sizes that cross from a small Map (no table) to a table
  # and back after a clear, and with room reserved. After every step the
  # two agree on the length and on every key, and their walks agree in
  # order.


  obj Pair
    key: Int
    value: Int
    live: Bool

  obj Model
    pairs: List[Pair] = List()
    len: Int = 0

    fun find(?@, k: Int) -> Int?
      for p, i in ?@pairs
        return i if p.live and p.key == k
      none

    sub put(!@, k: Int, v: Int)
      if @find(k) as i
        @pairs[i].value = v
      else
        !@pairs.push(Pair(key: k, value: v, live: true))
        @len += 1

    fun take(!@, k: Int) -> Int?
      if @find(k) as i
        @pairs[i].live = false
        @len -= 1
        return @pairs[i].value
      none

    sub bump(!@, k: Int)
      if @find(k) as i
        @pairs[i].value += 1

    sub clear(!@)
      !@pairs.clear()
      @len = 0

    # Keep the live pairs `kept_after` is true for, each value first
    # raised by `raise`, as a `retain` raises it.
    sub retain(!@, raise: Int)
      kept: List[Pair] = List()
      for p in ?@pairs
        if p.live and kept_after(p.key, p.value + raise)
          !kept.push(Pair(key: p.key, value: p.value + raise, live: true))
      @len = kept.len
      @pairs = <kept

  fun kept_after(k: Int, v: Int) -> Bool
    (k / 1024 + v) % 3 != 0

  fun raise_and_keep(k: ?Int, v: !Int) -> Bool
    v += 2
    kept_after(k, v)

  obj Rand
    s: U64

    fun next(!@, n: Int) -> Int
      @s = @s *% 6364136223846793005 +% 1442695040888963407
      Int((@s >> 33) % U64(n))

  fun agree(m: ?Map[Int, Int], ref: ?Model, span: Int) -> Bool
    return false if m.len != ref.len
    for x in 0..span
      k = x * 1024
      want: Int? = none
      if ref.find(k) as i
        want = ref.pairs[i].value
      got: Int? = none
      if m.get(k) as v
        got = v
      return false if got != want
    # The walk is in the order keys were first put in.
    order: List[Int] = List()
    for e in ?m.items()
      !order.push(e.key)
    i = 0
    for p in ?ref.pairs
      if p.live
        return false if i >= order.len or order[i] != p.key
        i += 1
    i == order.len

  fun run(seed: U64, span: Int, steps: Int, reserve: Int) -> Bool
    r = Rand(s: seed)
    m = Map[Int, Int].new(capacity: reserve)
    ref = Model()
    for step in 0..steps
      op = (!r).next(20)
      k = (!r).next(span) * 1024
      if op < 9
        !m.put(k, step)
        !ref.put(k, step)
      else if op < 14
        return false if (!m).take(k) != (!ref).take(k)
      else if op < 15
        if (!m).edit(k) as v
          v += 1
          !ref.bump(k)
      else if op < 16
        return false if (!m).put_new(k, step) != (ref.find(k) == none)
        !ref.put(k, step) if ref.find(k) == none
      else if op < 18
        c = (!m).ensure(k, step)
        c += 1
        !ref.put(k, step) if ref.find(k) == none
        !ref.bump(k)
      else if op < 19
        if (!r).next(10) == 0
          !m.retain(|key, val| raise_and_keep(key, !val))
          !ref.retain(2)
      else if (!r).next(25) == 0
        !m.clear()
        !ref.clear()
      return false if not agree(?m, ?ref, span)
    true

  fun set_agrees(s: ?Set[Int], ref: ?Model, span: Int) -> Bool
    return false if s.len != ref.len
    for x in 0..span
      return false if s.has(x * 1024) != (ref.find(x * 1024) != none)
    order: List[Int] = List()
    for k in ?s.items()
      !order.push(k)
    i = 0
    for p in ?ref.pairs
      if p.live
        return false if i >= order.len or order[i] != p.key
        i += 1
    i == order.len

  fun run_set(seed: U64, span: Int, steps: Int, reserve: Int) -> Bool
    r = Rand(s: seed)
    s = Set[Int].new(capacity: reserve)
    ref = Model()
    for _ in 0..steps
      op = (!r).next(10)
      k = (!r).next(span) * 1024
      if op < 6
        return false if (!s).add(k) != (ref.find(k) == none)
        !ref.put(k, 0)
      else if op < 9
        got = (!s).take(k)
        return false if (got != none) != ((!ref).take(k) != none)
      else if (!r).next(10) == 0
        # The Model's values for a Set are all 0, and stay 0.
        !s.retain(|key| kept_after(key, 0))
        !ref.retain(0)
      else if (!r).next(50) == 0
        !s.clear()
        !ref.clear()
      return false if not set_agrees(?s, ?ref, span)
    true

  print(run(1, 6, 400, 0), run(2, 12, 2000, 0), run(3, 40, 4000, 0), run(4, 300, 6000, 0))
  print(run(5, 40, 3000, 100), run(6, 9, 3000, 9))
  print(run_set(7, 6, 400, 0), run_set(8, 40, 4000, 0), run_set(9, 300, 6000, 50))

test "hash churn wide keys", "true true true"
  # The churn above with a key of 16 bytes, which a Map and a Set keep the
  # hash of (a key of 8 bytes or fewer they hash again): puts, takes and
  # gets against a reference, across a small Map and a table, and a Set
  # the same way.

  obj Wide
    k: Int
    tag: Int

  obj Rand
    s: U64

    fun next(!@, n: Int) -> Int
      @s = @s *% 6364136223846793005 +% 1442695040888963407
      Int((@s >> 33) % U64(n))

  fun wide(k: Int) -> Wide
    Wide(k: k, tag: k ^ 7)

  fun run(seed: U64, span: Int, steps: Int) -> Bool
    r = Rand(s: seed)
    m: Map[Wide, Int] = Map()
    s: Set[Wide] = Set()
    ref: List[Int] = List()
    for _ in 0..span
      !ref.push(-1)
    for step in 0..steps
      k = (!r).next(span)
      if (!r).next(3) < 2
        !m.put(wide(k), step)
        _ = (!s).add(wide(k))
        ref[k] = step
      else
        got = (!m).take(wide(k)) ?? -1
        return false if got != ref[k]
        _ = (!s).take(wide(k))
        ref[k] = -1
      live = 0
      for x in 0..span
        want = ref[x]
        live += 1 if want >= 0
        return false if (m.get(wide(x)) ?? -1) != want
        return false if s.has(wide(x)) != (want >= 0)
      return false if m.len != live or s.len != live
    true

  print(run(1, 6, 300), run(2, 40, 2000), run(3, 300, 3000))

test "hash compound keys", '''
  10 5 false
  10 5 false
'''
  # A compound key is an object of its parts. One that owns its text is
  # looked up with a key built the same way, its text owned too; one that
  # holds a view of its text looks up with no copy, and its Map holds
  # views, so the text it views is declared before the Map.


  obj Key
    name: String
    n: Int

  obj KeyView
    name: ?String
    n: Int

  m = Map[Key, Int].new()
  !m.put(Key(name: String("a"), n: 1), 10)
  c = (!m).ensure(Key(name: String("b"), n: 2), 0)
  c += 5
  print(m.get(Key(name: String("a"), n: 1)), m.get(Key(name: String("b"), n: 2)), m.has(Key(name: String("a"), n: 2)))

  t = String("a")
  v = Map[KeyView, Int].new()
  !v.put(KeyView(name: ?t, n: 1), 10)
  w = (!v).ensure(KeyView(name: "b", n: 2), 0)
  w += 5
  print(v.get(KeyView(name: "a", n: 1)), v.get(KeyView(name: "b", n: 2)), v.has(KeyView(name: "a", n: 2)))

test "hash ensure chain", "[5, 6] 1"
  # The write view `ensure` returns takes a write call in the same
  # statement, with no `!` before the receiver it already lends.


  b = Map[Int, List[Int]].new()
  (!b).ensure(1, List()).push(5)
  (!b).ensure(1, List()).push(6)
  print(b.get(1), b.len)

fail "hash ensure keeps lent", "use of `m.len` while a write loan on `m` is live"
  # The write view `ensure` returns is `from @`: it keeps the Map lent
  # to write, so the Map cannot be read or written while the view lives.


  m = Map[Int, Int].new()
  c = (!m).ensure(1, 0)
  print(m.len)
  c += 1

test "hash ensure with", '''
  ab true
  cd true
  ab false
  ab false
  ef true
  cd false
  3 3
  ab ["ab!", "ab", "ab", "ab"]
  cd ["cd!", "cd", "cd"]
  ef ["ef!", "ef"]
  10 10 13 85
'''
  # `ensure_with` lends the value under a key to write, making it with
  # `make` only when the key is new: a `|!count|` capture counts the calls,
  # and a `|!added|` capture reports whether the key was new. Values that
  # own memory are made, kept, and dropped clean.


  fun make(k: ?String, count: !Int, added: !Bool) -> List[String]
    count += 1
    added = true
    l = List[String]()
    !l.push(String(k, "!"))
    l

  count = 0
  m = Map[String, List[String]].new()
  for w in ["ab", "cd", "ab", "ab", "ef", "cd"]
    added = false
    g = (!m).ensure_with(String(w), |!count, !added, k| make(k, !count, !added))
    !g.push(String(w))
    print(w, added)
  print(count, m.len)
  for e in ?m.items()
    print(e.key, e.value)

  calls = 0
  sq = Map[Int, Int].new()
  for i in 0..40
    v = (!sq).ensure_with(i % 10, |!calls, k| square(k, !calls))
    v += 1
  print(calls, sq.len, sq.get(3), sq.get(9))

  fun square(k: ?Int, calls: !Int) -> Int
    calls += 1
    k * k

fail "hash ensure with no map", "cannot lend `m` to write while a read loan is live"
  # `ensure_with` holds the Map lent to write while `make` runs, so `make`
  # cannot capture the Map.


  m = Map[Int, Int].new()
  v = (!m).ensure_with(1, |?m, k| m.len + k)
  v += 1

test "hash ensure by", '''
  {"to": 2, "be": 2, "or": 1, "not": 1} 4
  {"to": 2, "be": 1}
  10 [3, 13, 23, 33]
'''
  # `ensure_by` takes the key viewed and makes the key to put with `key`
  # only when it is new: four words make four keys. A buffer cleared and
  # refilled each time counts too, since a String key is a clone that
  # views nothing. Values that own memory are made, kept, and dropped
  # clean.

  fun keyed(s: ?String, made: !Int) -> String
    made += 1
    +s

  made = 0
  counts = Map[String, Int].new()
  for w in ["to", "be", "or", "not", "to", "be"]
    (!counts).ensure_by(w, |!made, s| keyed(s, !made), 0) += 1
  print(counts, made)

  m = Map[String, Int].new()
  buf = String()
  for w in ["to", "be", "to"]
    !buf.clear()
    !buf.add(w)
    (!m).ensure_by(?buf, |s| +s, 0) += 1
  print(m)

  sq = Map[Int, List[Int]].new()
  for i in 0..40
    k = i % 10
    l = (!sq).ensure_by(?k, |n| n, List[Int]())
    !l.push(i)
  if sq.get(3) as l
    print(sq.len, l)

fail "hash ensure by view keys stay lent", "cannot lend `buf` to write while a read loan is live"
  # A Map of view keys keeps what `key` made from the viewed key, so the
  # buffer stays lent while the Map is used.

  m = Map[?String, Int].new()
  buf = String("to")
  (!m).ensure_by(?buf, |s| s, 0) += 1
  !buf.clear()
  print(m)

fail "hash get keeps lent", "cannot lend `m` to write while a read loan is live"
  # The view `get` returns is `from @`: it keeps the Map lent to read,
  # so the Map cannot be written while the view lives.


  m = Map[String, Int].new()
  r = ?m.get("a")
  !m.put(String("b"), 1)
  print(r)

fail "hash items then put", "cannot lend `m` to write while a read loan is live"
  # The iterator `items` returns views the Map, which stays lent to read
  # while the loop walks it.


  m = Map[String, Int].new()
  !m.put(String("a"), 1)
  for e in ?m.items()
    !m.put(String("c"), 2)

fail "hash key no eq", "cannot use `K = List[Int]`"
  # A key is a value `.hash()` takes, and a List has no `==`.


  m = Map[List[Int], Int].new()
  print(m.len)

fail "hash key same type", "type mismatch: expected `?Key`, got `KeyView`"
  # A lookup takes a view of the Map's own key type: an object with the
  # same parts, its text viewed rather than owned, is another type.


  obj Key
    name: String
    n: Int

  obj KeyView
    name: ?String
    n: Int

  m = Map[Key, Int].new()
  print(m.get(KeyView(name: "a", n: 1)))

fail "hash len read only", "7:9: `len` is a field of `Map[String, Int]`, not a method: write `m.len`", "7:18: `len` is a field of `Set[Int]`, not a method: write `s.len`", "8:3: cannot assign to `m.len`: field `len` of `Map` is read-only outside the methods of `Map`", "9:3: cannot assign to `s.len`: field `len` of `Set` is read-only outside the methods of `Set`", errors: 4
  # A Map's and a Set's `len` is a field, read anywhere and written only
  # by their own methods; `len()` is no method.


  m = Map[String, Int]()
  s = Set[Int]()
  print(m.len(), s.len())
  m.len = 3
  s.len += 1

test "hash map", '''
  0 false none
  2 uno two false
  two none
  dos
  uno none 2
  b dos
  c tres!
  a again
  b
  c
  a
  dos
  tres!
  again
  0 none
  666 332667 true true none
  1000 1000
  7
  to 4
  be 4
  or 3
  not 4
  a b false
  1 2 none
  true true false 2
  true false x none 1
  y
  z
  x
  0 false
  true false 1 1 0 0
  0 false
'''
  # Map and Set: every member, over owned and viewed text keys,
  # integers, objects, and enums, through growth, taking, and clearing,
  # with values that own memory, in the order keys were first put in.
  # `Map[K, V]()` and `Set[K]()` make empty ones, also as a
  # field's default, and `len` is a field read anywhere.


  obj Pt
    x: Int
    y: Int

  enum Key
    name(s: String)
    num(n: Int)

  sub bump(k: ?String, v: !Int)
    v += k.len

  obj Binder
    ids: Map[U32, U32] = Map[U32, U32]()
    seen: Set[U32] = Set[U32]()

  m = Map[String, String].new()
  print(m.len, m.has("a"), m.get("a"))
  !m.put(String("a"), String("one"))
  !m.put(String("b"), String("two"))
  !m.put(String("a"), String("uno"))
  print(m.len, m.get("a"), m.get("b"), m.has("c"))
  old = (!m).replace(String("b"), String("dos"))
  print(old, (!m).replace(String("c"), String("tres")))
  if (!m).edit("c") as v
    !v.add("!")
  t = String("b")
  print(m.get(?t))
  print((!m).take("a"), (!m).take("a"), m.len)
  !m.put(String("a"), String("again"))
  for e in ?m.items()
    print(e.key, e.value)
  for k in ?m.keys()
    print(k)
  for v in ?m.values()
    print(v)
  !m.clear()
  print(m.len, m.get("b"))

  ints = Map[Int, Int].new()
  for i in 0..1000
    !ints.put(i * 7, i)
  for i in 0..1000
    if i % 3 == 0
      _ = (!ints).take(i * 7)
  sum = 0
  for i in 0..1000
    if ints.get(i * 7) as v
      sum += v
  print(ints.len, sum, ints.has(7), ints.has(14), ints.get(6993))
  for i in 0..1000
    !ints.put(i * 7, 1)
  count = 0
  for e in ?ints.items()
    count += e.value
  print(ints.len, count)
  first = 0
  for k in ?ints.keys()
    first = k
    break
  print(first)

  counts = Map[?String, Int].new()
  words = ["to", "be", "or", "not", "to", "be"]
  for w in words
    if (!counts).edit(w) as c
      c += 1
    else
      !counts.put(w, 1)
  !counts.update(bump)
  for e in ?counts.items()
    print(e.key, e.value)

  pts = Map[Pt, ?String].new()
  !pts.put(Pt(x: 1, y: 2), "a")
  !pts.put(Pt(x: 2, y: 1), "b")
  print(pts.get(?Pt(x: 1, y: 2)), pts.get(?Pt(x: 2, y: 1)), pts.has(?Pt(x: 1, y: 1)))

  keyed = Map[Key, Int].new()
  !keyed.put(Key.name(s: String("x")), 1)
  !keyed.put(Key.num(n: 5), 2)
  print(keyed.get(Key.name(s: String("x"))), keyed.get(Key.num(n: 5)), keyed.get(Key.num(n: 6)))

  s = Set[String].new()
  print((!s).add(String("x")), (!s).add(String("y")), (!s).add(String("x")), s.len)
  print(s.has("x"), s.has("z"), (!s).take("x"), (!s).take("x"), s.len)
  _ = (!s).add(String("z"))
  _ = (!s).add(String("x"))
  for k in ?s.items()
    print(k)
  !s.clear()
  print(s.len, s.has("y"))
  bd = Binder()
  other = Binder()
  !bd.ids.put(1, 10)
  print((!bd.seen).add(1), (!bd.seen).add(1), bd.ids.len, bd.seen.len, other.ids.len, other.seen.len)
  e = Map[Int, Int]()
  print(e.len, e.has(1))

test "hash results", '''
  new a
  new b
  new c
  3 1 3
  0 a 3
  1 b 1
  2 c 1
  after take c 1
'''
  # `Map.ensure_added` lends the value under a key to write, with whether
  # the key was new; `Map.at` gives the entry at an index, in order.

  sub count(m: !Map[String, Int], word: ?String)
    w, added = (!m).ensure_added(String(word), 0)
    w += 1
    print("new", word) if added

  m = Map[String, Int]()
  for word in ["a", "b", "a", "c", "a"]
    count(!m, word)
  print(m.get("a") ?? 0, m.get("b") ?? 0, m.len)
  i = 0
  while m.at(i) as k, v
    print(i, k, v)
    i += 1
  _ = (!m).take("b")
  if m.at(1) as k, v
    print("after take", k, v)
  if m.at(2) as k, v
    print("past the end", k, v)
  if m.at(-1) as k, v
    print("below the start", k, v)

fail "hash retain no map", "cannot lend `m` to write while a read loan is live"
  # `retain` holds the Map lent to write while its closure runs, so the
  # closure cannot capture the Map, to read it or to write it.


  m = Map[Int, Int].new()
  !m.put(1, 1)
  !m.retain(|?m, k, v| m.len > 1)
  print(m.len)

test "hash write drops", '''
  0 true
  drop 2
  a false
  drop 3
  b 11
  c 11
  make 2
  d 200
  e true
  drop 11
  f 4
  drop 200
  g 1
  drop 4
'''
  # `put_new` and `ensure` drop the key and value they do not store at
  # the call, `ensure_with` does not call `make` for a key already there,
  # and `retain` drops an entry it rejects then.

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  fun mk(k: ?Int) -> Res
    print("make", k)
    Res(n: k * 100)

  m = Map[Int, Res].new()
  print(m.len, (!m).put_new(1, Res(n: 1)))
  print("a", (!m).put_new(1, Res(n: 2)))
  c = (!m).ensure(1, Res(n: 3))
  c.n += 10
  print("b", c.n)
  d = (!m).ensure_with(1, mk)
  print("c", d.n)
  e = (!m).ensure_with(2, mk)
  print("d", e.n)
  t = (!m).take(1)
  print("e", t != none)
  <t
  f = (!m).ensure(1, Res(n: 4))
  print("f", f.n)
  !m.retain(|k, r| k == 1)
  print("g", m.len)

test "hash writes", '''
  to 3
  be 2
  or 1
  not 1
  2 ["to", "be", "or", "to", "be", "to"]
  3 ["not"]
  ["to", "be", "or", "not"] 0 1 4
  ab abab+
  cd cdcd
  drop 31
  drop 71
  drop 101
  drop 111
  kept 8
  0 1
  1 11
  2 21
  4 41
  5 51
  6 61
  8 81
  9 91
  false true
  9 true
  16 false true [1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13, 14, 16, 17, 18, 19]
  end
  drop 1
  drop 91
  drop 81
  drop 61
  drop 51
  drop 41
  drop 21
  drop 11
  drop 1
'''
  # Map's writes beyond `put`: `ensure` lends the value under a key,
  # putting one first when the key is new; `put_new` puts only a new key,
  # so the first value wins; `edit` then `put` makes a value only for a
  # new key; and `retain` keeps, in order, the entries a closure says to,
  # writing values as it goes and dropping each entry it rejects then.


  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  words = ["to", "be", "or", "not", "to", "be", "to"]

  counts = Map[String, Int].new()
  for w in words
    c = (!counts).ensure(String(w), 0)
    c += 1
  for e in ?counts.items()
    print(e.key, e.value)

  groups = Map[Int, List[String]].new()
  for w in words
    g = (!groups).ensure(w.len, List())
    !g.push(String(w))
  for e in ?groups.items()
    print(e.key, e.value)

  seen = Map[?String, Int].new()
  order = List[?String]()
  for i in 0..words.len
    if (!seen).put_new(words[i], i)
      !order.push(words[i])
  print(order, seen.get("to"), seen.get("be"), seen.len)

  made = Map[String, String].new()
  for w in ["ab", "cd", "ab"]
    if (!made).edit(w) as s
      !s.add("+")
    else
      !made.put(String(w), String(w, w))
  for e in ?made.items()
    print(e.key, e.value)

  res = Map[Int, Res].new()
  for i in 0..12
    !res.put(i, Res(n: i * 10))
  !res.retain(|k, r| keep(k, !r))
  print("kept", res.len)
  for e in ?res.items()
    print(e.key, e.value.n)
  print(res.has(3), res.get(4) != none)
  !res.put(30, Res(n: 1))
  print(res.len, res.has(30))

  nums = Set[Int].new()
  for i in 0..20
    _ = (!nums).add(i)
  !nums.retain(|k| k % 5 != 0)
  out = List[Int]()
  for k in ?nums.items()
    !out.push(k)
  print(nums.len, nums.has(5), nums.has(6), out)
  print("end")

  fun keep(k: ?Int, r: !Res) -> Bool
    r.n += 1
    k % 4 != 3 and k < 10

test "hash built in", '''
  1 true
  Map[String, Int]
'''
  # Map and Set are part of the language, named with no import, and
  # their types print with no module.

  m: Map[String, Int] = Map()
  !m.put(String("a"), 1)
  s = Set[Int].new()
  _ = (!s).add(2)
  print(m.get("a"), s.has(2))
  print($name(Map[String, Int]))

test "hash word keys", '''
  true true
  20000 20000 3 true
'''
  # An object whose parts are integers, plain enums, and Bools, nested or
  # not, hashes its words two at a time, one multiply a pair: equal keys
  # hash alike, a signed part as its value whatever its width, and keys
  # that differ only in one part or by swapped parts hash apart.

  enum Tint
    red
    green
    blue

  obj Inner
    x: U8
    y: I64

  obj Key
    a: I32
    b: Bool
    c: Tint
    d: Inner

  obj Two
    lo: U64
    hi: U64

  k1 = Key(a: -5, b: true, c: .green, d: Inner(x: 7, y: -1))
  k2 = Key(a: -5, b: true, c: .green, d: Inner(x: 7, y: -1))
  m = Map[Key, Int]()
  !m.put(k1, 1)
  print(k1.hash() == k2.hash(), (m.get(k2) ?? 0) == 1)
  seen = Set[U64]()
  packed = Set[U64]()
  for i in 0..20000
    _ = (!seen).add(Two(lo: U64(i), hi: 0).hash())
    _ = (!packed).add(Two(lo: (U64(i % 100) << 32) | U64(i / 100), hi: 7).hash())
  swapped = Set[U64]()
  _ = (!swapped).add(Two(lo: 1, hi: 2).hash())
  _ = (!swapped).add(Two(lo: 2, hi: 1).hash())
  _ = (!swapped).add(Two(lo: 1, hi: 3).hash())
  print(seen.len, packed.len, swapped.len, Two(lo: 0, hi: 0).hash() != Two(lo: 0, hi: 1).hash())

test "hash own map", "2 0"
  # A module's own `Map` hides the built-in one; `Set` stays built in.

  obj Map
    n: Int

  sub main()
    m = Map(n: 2)
    s: Set[Int] = Set()
    print(m.n, s.len)

test "hash prelude beside a program's own", '''
  {"a": 42} 7
'''
  # A program's own module named `prelude`, with a type named `Map`, is
  # its own: the built-in Map and Set stay reachable beside it.

  use prelude

  sub main()
    m = Map[String, Int]()
    !m.put(String("a"), prelude.greet())
    p = prelude.make(7)
    print(m, p.n)

  file "prelude.rig"
    pub fun greet() -> Int
      42

    pub obj Map
      pub n: Int

    pub fun make(n: Int) -> Map
      Map(n: n)

fail "hash prelude needs no use", "4:1: every program has `std.prelude`, its `Map` and `Set`, already: remove the `use`"
  # The prelude, which holds Map and Set, is every program's: importing
  # it is rejected.

  use std.prelude

  sub main()
    print(1)

fail "hash no module", "3:1: the standard library has no module `hash`"
  # Map and Set need no import, and no module holds them.

  use std.hash

  sub main()
    print(1)
