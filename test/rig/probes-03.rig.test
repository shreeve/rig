test "assignthrough-b1", "[3, 100, 100]"
  fun slot(v: !List[Int], i: Int) -> !Int from v
    !v[i]

  fun grow(v: !List[Int]) -> Int
    !v.push(100)
    v.len

  v: List[Int] = List()
  !v.push(10)
  slot(!v, 0) += 1
  slot(!v, 0) += grow(!v)
  slot(!v, 0) = grow(!v)
  print(v)

fail "assignthrough-b18", "cannot store a view of `d` through `w`: what `w` views outlives it"
  obj H
    s: ?String

  sub set(w: !H)
    d = String("local")
    w = H(s: ?d)

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

test "assignthrough-b2", '''
  [2, 7]
  [2, 7, 7]
  [10, 7, 7, 7]
'''
  fun slot(v: !List[Int], i: Int) -> !Int from v
    !v.push(7)
    !v[i]

  v: List[Int] = List()
  !v.push(1)
  slot(!v, 0) += v.len
  print(v)
  slot(!v, 0) = v.len
  print(v)
  n = v.len
  slot(!v, 0) = n + v[1]
  print(v)

fail "assignthrough-b20", "cannot store a view of `d` through `w ?? return`: `w` outlives it"
  obj H
    s: ?String

  sub set(w: (!H)?)
    d = String("local")
    (w ?? return).s = ?d

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

fail "assignthrough-b21", "cannot store a view of `d` through `w ?? return`: `h` outlives it"
  obj H
    s: ?String

  sub set(h: !H)
    w: (!H)? = <h
    d = String("local")
    (w ?? return).s = ?d

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

