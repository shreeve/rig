  drop R 10
  drop R 2
  drop R 1
  drop R 3
  drop R 4
  drop R 12
  drop R 20
'''
  obj R
    n: Int
    drop(!@)
      print("drop R", @n)

  obj S
    a: ^R
    b: R?
    xs: List[^R]

  s = S(a: ^R(n: 1), b: R(n: 2), xs: List())
  !s.xs.push(^R(n: 3))
  !s.xs.push(^R(n: 4))
  old = replace(!s.a, ^R(n: 10))
  print(old.n, s.a.n)
  !s.xs.swap(0, 1)
  for e in ?s.xs
    print(e.n)
  t = <s.b
  print(t == none, s.b == none)
  u = ^R(n: 20)
  swap(!s.a, !u)
  print(s.a.n, u.n)
  x = 1
  y = 2
  swap(!x, !y)
  print(x, y)
  q = replace(!s.b, R(n: 12))
  print(q == none)

