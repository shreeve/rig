# Probes from past reviews and audits, 3 of 41: R3c1-f_nan_slice to audit-emit-q1.

test "R3c1-f nan slice", "false false false false"
  obj S
    v: Float

  nan = 0.0 / 0.0
  xs = [nan, 1.0]
  ys = [nan, 1.0]
  ss = [S(v: nan)]
  print(xs == xs, ?xs[0..2] == ?xs[0..2], ?xs[0..2] == ?ys[0..2], ?ss[0..1] == ?ss[0..1])

fail "R3c1-m2", "`==` is not defined for `[1]?T`: `?T` is a view"
  use geo

  obj Wrap[T]
    item: T

  fun eqT[T](a: ?T, b: ?T) -> Bool
    a == b

  fun wrapEq[T](a: ?T, b: ?T) -> Bool
    x: T? = none
    x == none and [a] == [b]

  sub main()
    t = geo.Tagged(id: 1, h: *geo.Node(n: 1))
    print(eqT(?t, ?t))
    n = *geo.Node(n: 1)
    print(wrapEq(?n, ?n))

  file "geo.rig"
    pub obj Node
      n: Int

    obj Wrap[T]
      item: T
      id: Int

    enum Opt[T]
      some(value: T)
      nothing

    pub obj Point
      x: Int
      y: Int

    pub obj Tagged
      id: Int
      h: *Node

    fun same[T](a: T, b: T) -> Bool
      Wrap(item: a, id: 1) == Wrap(item: b, id: 1)

    pub fun check(a: Point, b: Point) -> Bool
      o: Opt[Point] = .some(value: a)
      p: Opt[Point] = .some(value: b)
      o == p and same(a, b) and Wrap(item: [a], id: 2) == Wrap(item: [b], id: 2)

test "R3c1-t01 nested", '''
  true false false true true false
  true false true true
  true true
  true true
  true false
'''
  obj Tag
    name: ?String
    code: U8

  enum Box
    full(items: [2]Tag)
    empty

  obj Holder
    b: Box?
    arr: [2]Box

  t1 = Tag(name: "a", code: 1)
  t2 = Tag(name: "b", code: 2)
  x: Box? = .full(items: [t1, t2])
  y: Box? = .full(items: [t1, t2])
  z: Box? = .full(items: [t2, t1])
  e: Box? = none
  print(x == y, x == z, x == e, e == none, x != none, x != y)
  h1 = Holder(b: x, arr: [.empty, .full(items: [t1, t1])])
  h2 = Holder(b: y, arr: [.empty, .full(items: [t1, t1])])
  h3 = Holder(b: none, arr: [.empty, .full(items: [t1, t1])])
  print(h1 == h2, h1 == h3, h3 == h3, h1 != h3)
  hs = [h1, h2]
  gs = [h2, h1]
  print(?hs[0..2] == ?gs[0..2], hs == gs)
  print(t1 == Tag(name: "a", code: 1), Tag(name: "a", code: 1) == t1)
  print(x == .full(items: [t1, t2]), .empty == x)

test "R3c1-t02 err", '''
  true true false true true false
  true false true
  true false false false
  false false false
  true false
  0 0
'''
  error E
    bad
    worse

  error F
    bad

  obj R
    e: E
    oe: E?

  fun fail(n: Int) -> Int!
    return E.bad if n < 0
    return F.bad if n == 0
    n

  a: E = .bad
  b: E? = .bad
  c: E? = none
  print(a == b, b == a, b == c, c == none, b == .bad, b == E.worse)
  r1 = R(e: .bad, oe: .worse)
  r2 = R(e: .bad, oe: .worse)
  r3 = R(e: .bad, oe: none)
  print(r1 == r2, r1 == r3, r3 == R(e: .bad, oe: none))
  x = fail(-1) catch |err|
    print(err == E.bad, err == F.bad, err == .worse, err != a)
    0
  y = fail(0) catch |err|
    print(err == E.bad, err == a, a == err)
    0
  opts = [b, c]
  print(opts == [b, c], opts == [c, b])
  print(x, y)

test "R3c1-t03 float", '''
  true true
  false true true
  false true
  false false true
  true false
  false false
  false true true true
  true
'''
  obj F
    v: Float
    w: F32

  obj B
    b: U8
    i: I64

  enum Val
    num(x: Float)
    pair(a: U8, b: U8)

  nan = 0.0 / 0.0
  z = 0.0
  nz = -0.0
  print(F(v: z, w: 0.0) == F(v: nz, w: -0.0), F(v: nan, w: 1.0) != F(v: nan, w: 1.0))
  fa = [nan, 1.0]
  print(fa == fa, fa != fa, [z] == [nz])
  print(?fa[0..2] == ?fa[0..2], ?fa[1..2] == ?fa[1..2])
  o: Float? = nan
  print(o == o, o == nan, o != o)
  bb = B(b: 255, i: -1)
  print(bb == B(b: 255, i: -1), bb == B(b: 254, i: -1))
  v1: Val = .num(x: nan)
  print(v1 == v1, v1 == .num(x: nan))
  p1: Val = .pair(a: 1, b: 2)
  p2: Val = .pair(a: 1, b: 3)
  p3: Val = .pair(a: 1, b: 2)
  print(p1 == p2, p1 == p3, p1 == .pair(a: 1, b: 2), p1 != .pair(a: 2, b: 1))
  n0: Val = .num(x: 0.0)
  print(n0 == .num(x: -0.0))

test "R3c1-t04 str", '''
  false true false true false true
  false true true false 3
  true false true true true true
  false true
  true false false true
  true false false
  false true true
'''
  obj W
    s: ?String

  a = "abc"
  b = "abcd"
  z1 = "a\x00b"
  z2 = "a\x00c"
  z3 = "a"
  print(a == b, a < b, b < a, a <= a, a >= b, b > a)
  print(z1 == z2, z1 < z2, z3 < z1, z1 == z3, z1.len)
  e = "é"
  f = "z"
  print(e > f, e < f, "" < "a", "" == "", "" <= "", "a" > "")
  print(W(s: z1) == W(s: z2), W(s: z1) == W(s: "a\x00b"))
  print("ab" < "abc", "abc" < "ab", "b" < "abc", "B" < "a")
  print("a" == "a", "ab" != "ab", "a" < "a")
  xs: [3]U8 = [1, 2, 3]
  ys: [2]U8 = [1, 2]
  print(?xs[0..3] < ?ys[0..2], ?xs[0..2] <= ?ys[0..2], ?xs[0..3] > ?ys[0..2])

test "R3c1-t05 view", '''
  true true true true true
  true
  true
  true
  true
'''
  obj P
    x: Int
    y: Int

  enum S
    c(p: P)
    n

  fun eqb(a: ?P, b: ?P) -> Bool
    a == b

  fun eqm(a: !P, b: P) -> Bool
    a == b and b == a

  fun ords(a: ?String, b: ?String) -> Bool
    a < b and not (b < a) and a <= ?b

  fun eqs(a: ?S, b: ?S) -> Bool
    a == b and a != .n

  fun eqarr(a: ?[2]P, b: [2]P) -> Bool
    a == b

  fun eqopt(a: ?P?, b: P) -> Bool
    a == b and b == a and a != none

  p = P(x: 1, y: 2)
  q = P(x: 1, y: 2)
  print(eqb(?p, ?q), eqm(!p, q), p == ?q, ?p == q, ?p == ?q)
  print(ords(?"a", "b"))
  s: S = .c(p: p)
  print(eqs(?s, ?s))
  arr = [p, q]
  print(eqarr(?arr, arr))
  o: P? = p
  print(eqopt(?o, q))

test "R3c1-t06 side", '''
  mk a
  mk b
  false
  name x
  name y
  name p
  name q
  true true
  true
  true
  true
  true true false
'''
  error E
    bad

  obj P
    x: Int
    s: ?String

  fun mk(tag: ?String, x: Int) -> P
    print("mk", tag)
    P(x: x, s: tag)

  fun name(tag: ?String) -> ?String
    print("name", tag)
    tag

  fun get(n: Int) -> P!
    return E.bad if n < 0
    P(x: n, s: "g")

  fun getS(n: Int) -> (?String)!
    return E.bad if n < 0
    "s"

  fun getO(n: Int) -> P?
    return none if n < 0
    P(x: n, s: "g")

  fun run() -> Bool!
    a = get(1)! == get(1)!
    b = getS(1)! <= getS(2)!
    c = get(1)! != P(x: 1, s: "g")
    a and b and not c

  fun runo() -> Bool?
    getO(1)? == getO(1)?

  print(mk("a", 1) == mk("b", 1))
  print(name("x") < name("y"), name("p") != name("q"))
  print(run() catch false)
  print(runo() == true)
  print((get(1) catch P(x: 0, s: "")) == P(x: 1, s: "g"))
  print(getO(2) == P(x: 2, s: "g"), getO(-1) == none, getO(-1) == P(x: 1, s: "g"))

test "R3c1-t07 retview", '''
  true false false
  true true
  true true
  true true true
'''
  obj P
    x: Int
    s: ?String

  obj Bag
    items: List[P]

    fun first(?@) -> ?P
      ?@items[0]

  fun pick(a: ?P, b: ?P, f: Bool) -> ?P
    a if f else b

  fun slot(a: !P) -> !P
    a

  fun pickS(a: ?String, b: ?String) -> ?String
    a

  p = P(x: 1, s: "a")
  q = P(x: 1, s: "a")
  r = P(x: 2, s: "b")
  print(pick(?p, ?r, true) == pick(?q, ?r, true), pick(?p, ?r, false) == q, p == pick(?p, ?r, false))
  print(slot(!p) == q, q != slot(!r))
  u = "u"
  v = "v"
  print(pickS(?u, ?v) < pickS(?v, ?u), pickS(?u, ?v) == "u")
  bag = Bag(items: List[P]())
  !bag.items.push(P(x: 1, s: "a"))
  print(bag.first() == p, bag.items[0] == p, ?bag.items[0] == ?p)

test "R3c1-t08 vec", '''
  true true true true
  true true true true
  true true
  true
'''
  obj P
    x: Int
    s: ?String

  v = List[P]()
  !v.push(P(x: 1, s: "a"))
  !v.push(P(x: 1, s: "a"))
  w = List[?String]()
  !w.push("hi")
  !w.push("hi")
  b = List[U8]()
  !b.push(1)
  !b.push(2)
  print(?v[0..1] == ?v[1..2], ?w[0..1] == ?w[1..2], ?b[0..1] < ?b[1..2], ?b[0..2] == ?b[0..2])
  s = "hello"
  t = s[1..3]
  k = P(x: 0, s: t)
  print(k == P(x: 0, s: "el"), t < s, s[0..0] == "", s[0..5] == s)
  e: [0]Int = []
  f: [0]Int = []
  print(e == f, ?e[0..0] == ?f[0..0])
  empty = List[P]()
  print(?empty[0..0] == ?v[0..0])

