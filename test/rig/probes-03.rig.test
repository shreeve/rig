test "audit-emit-g1", '''
  2 2 4
  20
  23
  20
  7
  5 5
  drop R 7
  drop R 2
  drop R 1
'''
  obj R
    n: Int
    drop(!@)
      print("drop R", @n)

  obj Node
    v: Int
    r: R
    next: ^Node?

    sub bump(!@)
      @v += 1

    fun total(?@) -> Int
      t = @v
      if ?@next as n
        t += n.total()
      t

  fun read(n: ?Node) -> Int
    n.v

  sub write(n: !Node)
    n.v *= 10

  obj W[T]
    item: T

    fun get(?@) -> ?T
      ?@item

  fun first[T](w: ?W[T]) -> ?T
    w.get()

  b = ^Node(v: 1, r: R(n: 1), next: ^Node(v: 2, r: R(n: 2), next: none))
  !b.bump()
  print(b.v, read(?b), b.total())
  write(!b)
  print(b.v)
  if !b.next as n
    !n.bump()
  print(b.total())
  node = <b.unbox()
  print(node.v)
  w = W(item: ^R(n: 7))
  print(first(?w).n)
  wb = ^W(item: 5)
  print(wb.item, wb.get())

