test "R3c1-t27 opt", '''
  true true false true true true
  true true true false true
  true false true
  true true false
  true true
  true
'''
  obj P
    x: Int

  fun sl(xs: []Int, n: Int) -> ([]Int)?
    return none if n < 0
    xs[0..n]

  a: ([2]Int)? = [1, 2]
  b: ([2]Int)? = none
  two = [1, 2]
  print(a == two, two == a, a == b, b == none, none == b, a != [2, 1])
  s: (?String)? = "hi"
  print(s == "hi", "hi" == s, s != "ho", s == none, none != s)
  p: P? = none
  q: P? = none
  print(p == q, p == P(x: 1), P(x: 1) != p)
  arr = [1, 2, 3]
  print(sl(?arr[0..3], 2) == sl(?arr[0..3], 2), sl(?arr[0..3], -1) == none, sl(?arr[0..3], 2) == sl(?arr[0..3], 3))
  ps: [2]P? = [P(x: 1), none]
  print(ps[1] == none, ps[0] == P(x: 1))
  qs: [2]P? = [P(x: 1), none]
  print(ps == qs)

test "R3c1-t28 num", '''
  true true true true true
  false
  true false
  true true
'''
  fun f(n: ?Int, m: !U8) -> Bool
    n < 3 and m >= 2 and 1 < n and n <= 9

  fun g[T](a: ?T, b: T) -> Bool
    a < b and b > a and a <= 5

  x: U8 = 3
  y: I8 = -3
  print(x < 4, 2 < x, y < 0, 3 < 4, 3.5 > 2)
  k = 3
  z: U8 = 2
  print(f(?k, !z))
  print(g(?k, 7), g(?x, x))
  big: U64 = 18446744073709551615
  print(big > 1, big == 18446744073709551615)

test "R3c1-t31 ring", '''
  true true false true
  false true true
'''
  obj Ring[T, n: Int]
    items: [n]T
    len: Int

    fun same(?@, o: ?Self) -> Bool
      @ == o and @items == o.items

  enum Res[T, E]
    ok(v: T)
    err(e: E)

  error Bad
    no

  a = Ring(items: [1, 2, 3], len: 3)
  b = Ring(items: [1, 2, 3], len: 3)
  c = Ring(items: ["x", "y"], len: 2)
  print(a == b, a.same(?b), c == Ring(items: ["x", "z"], len: 2), c.same(?c))
  r: Res[Int, Bad] = .ok(v: 1)
  s: Res[Int, Bad] = .err(e: .no)
  print(r == s, s == .err(e: Bad.no), r != .ok(v: 2))

test "R3c1-t32 ctn", '''
  true false
  false true
  true true true
'''
  fun f[n: Int](a: [n]Int, b: [n]Int) -> Bool
    a == b

  fun g[T, n: Int](a: [n]T, b: [n]T) -> Bool
    a != b

  fun h[T](a: T?, b: T) -> Bool
    a != none

  print(f([1, 2], [1, 2]), f([1], [2]))
  print(g(["a", "b"], ["a", "b"]), g([1.5], [2.5]))
  x: Int? = 3
  s: (?String)? = "s"
  print(h(x, 3), h(s, "s"), h(s, "t"))

