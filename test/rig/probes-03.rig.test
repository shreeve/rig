test "audit-emit-mod", '''
  10 .green x 0.5 [] 18446744073709551615
  26 8 4
  4 s
  3 3.0
  6 13
'''
  use lib

  limit = 3

  fun local(x: Int, by: Int = limit) -> Int
    x + by

  sub main()
    c = lib.Cfg()
    print(c.n, c.c, c.s, c.f, c.v, c.m)
    print(lib.scale(2), lib.scale(2, by: 1), local(1))
    print(lib.ident(4), lib.ident("s"))
    p = lib.Pair(a: 1, b: 2)
    print(p.sum(), lib.Pair[Float](a: 1, b: 2).sum())
    k: U8 = U8(lib.Color.blue)
    print(k, lib.limit + limit)

  file "lib.rig"
    pub limit = 10
    pub big: U64 = 18446744073709551615

    pub enum Color
      red
      green = 5
      blue

    pub obj Cfg
      pub n: Int = limit
      pub c: Color = .green
      pub s: ?String = "x"
      pub f: Float = .5
      pub v: List[Int] = List()
      pub m: U64 = big

    pub fun scale(x: Int, by: Int = limit, c: Color = .blue, top: U64 = big) -> Int
      x * by + Int(c)

    pub fun ident[T](x: T) -> T
      x

    pub obj Pair[T]
      pub a: T
      pub b: T

      pub fun sum(?@) -> T
        @a + @b

