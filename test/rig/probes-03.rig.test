test "audit-emit-c1", '''
  true true true
  false false false
  true
'''
  obj P
    x: Int
    y: Int

  obj Q
    name: ?String
    v: List[Int]

  fun same(a: ?P, b: ?P) -> Bool
    a == b

  fun sameq(a: ?Q, b: ?Q) -> Bool
    a.name == b.name

  fun eqopt(a: ?P?, b: ?P?) -> Bool
    a == b

  p = P(x: 1, y: 2)
  q = P(x: 1, y: 2)
  print(same(?p, ?q), p == q, ?p == ?q)
