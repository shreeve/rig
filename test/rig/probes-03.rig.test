test "R3c1-t12 ctx2", '''
  true
  false true
  drop 1
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  enum A
    v(items: List[Int])
    e

  enum D
    r(res: R)
    e

  a: A = .e
  print(a == .e)
  d: D = .r(res: R(n: 1))
  print(d == .e, .e != d)

test "R3c1-t13 drop", "1"
  obj R
    n: Int

    sub drop(!@)
      print("drop", @n)

  enum D
    r(res: R)
    e

  d: D = .r(res: R(n: 1))
  match d
    .r(res) => print(res.n)
    .e => print("e")

test "R3c1-t13b", '''
  5
  false
'''
  obj R
    n: Int

    sub drop(!@)
      print("drop", @n)

  enum D
    r(res: R)
    e

  x = R(n: 5)
  print(x.n)
  d: D = .r(res: R(n: 1))
  print(d == .e)

test "R3c1-t19 ctx", '''
  if-eq
  elif-lt
  2 d
  guard
  yes
  true false true
  true false
  true
  true
  true
  2
  true
'''
  obj P
    x: Int
    s: ?String

  obj Flags
    same: Bool
    less: Bool

  enum K
    a(p: P)
    b

  p = P(x: 1, s: "a")
  q = P(x: 1, s: "a")
  if p == q
    print("if-eq")
  if p != q
    print("bad")
  else if "a" < "b"
    print("elif-lt")
  s = "a"
  n = 0
  while s <= "c" and n < 3 : n += 1
    s = "d" if n == 1 else "b"
  print(n, s)
  print("guard") if [p] == [q]
  t = "yes" if p == q and not ("x" >= "y") else "no"
  print(t)
  f = Flags(same: p == q, less: p.s < q.s)
  print(f.same, f.less, f == Flags(same: true, less: false))
  print((p == q) == ("a" < "b"), not (p == q))
  eq: fun(P, P) -> Bool = |a, b| a == b
  print(eq(p, q))
  k: K = .a(p: p)
  print(k == .a(p: q) and k != .b)
  m = match k
    .a(r) => r == p
    .b => false
  print(m)
  cnt = 0
  for c in [p, q, P(x: 2, s: "z")]
    cnt += 1 if c == p else 0
  print(cnt)
  xs = [P(x: 0, s: "")]
  xs[0] = p if xs[0] == P(x: 0, s: "") else q
  print(xs[0] == p)

