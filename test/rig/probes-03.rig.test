  a = Q(name: "a", v: List())
  b = Q(name: "a", v: List())
  print(sameq(?a, ?b))

test "audit-emit-d1", '''
  mk 1
  small
  mk 0
  tall 2 3
  .rect(w: 10, h: 1)
  pos 1
'''
  enum Sh
    circle(r: Int)
    rect(w: Int, h: Int)
    dot

  obj Box2
    s: Sh
    tag: ?String

  fun mk(k: Int) -> Sh
    print("mk", k)
    .circle(r: k) if k > 0 else .rect(w: 2, h: 3)

  res = match mk(1)
    .circle(r) if r > 5 => "big"
    .circle(r) if r > 0 => "small"
    .rect(w, h) if w == h => "square"
    _ => "other"
  print(res)
  match mk(0)
    .circle(r) if r > 5 => print("big")
    .rect(w, h) if w < h => print("tall", w, h)
    _ => print("other")
  b = Box2(s: .circle(r: 9), tag: "t")
  b.s = .rect(w: 1, h: 1)
  match !b.s
    .rect(w, _) if w == 1 => w = 10
    _ => print("x")
  print(b.s)
  xs = [1, 2, 3]
  i = 0
  match xs[i]
    x if x > 0 => print("pos", x)
    _ => print("np")

test "audit-emit-dd1", '''
  10
  60
  30
  8
  75 6.0
  [7, 8, 9]
'''
  obj P
    x: Int
    y: Int

  obj W[T]
    v: T

    fun with(?@, f: ?fun(?T) -> Int) -> Int
      f(?@v)

  fun apply[T](xs: []T, f: ?fun(?T) -> Int) -> Int
    t = 0
    for x in xs
      t += f(?x)
    t

  fun twice[T](x: T, f: ?fun(T) -> T) -> T
    g = |?f, a: T| f(f(a))
    g(x)

  arr = [P(x: 1, y: 2), P(x: 3, y: 4)]
  print(apply(?arr[..], |p| p.x + p.y))
  nums = [1, 2, 3]
  k = 10
  print(apply(?nums[..], |+k, n| n * k))
  w = W(v: P(x: 5, y: 6))
  print(w.with(|p| p.x * p.y))
  wi = W(v: 7)
  print(wi.with(|n| n + 1))
  print(twice(3, |n| n * 5), twice(1.5, |f| f * 2))
  buf = [0, 0, 0]
  s = !buf[..]
  fill = |!s, v: Int|
    for i in 0..s.len
      s[i] = v + i
  fill(7)
  print(buf)

