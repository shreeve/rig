test "audit-emit-aa1", '''
  6 4
  40
  20
  true true
'''
  obj Big
    a: Int
    b: Int
    c: Int

  obj Two
    x: Big
    y: Big

    fun pick(?@, first: Bool) -> ?Big
      ?@x if first else ?@y

    fun pickw(!@, first: Bool) -> !Big
      if first
        !@x
      else
        !@y

  fun total(b: ?Big) -> Int
    b.a + b.b + b.c

  t = Two(x: Big(a: 1, b: 2, c: 3), y: Big(a: 4, b: 5, c: 6))
  print(total(t.pick(true)), t.pick(false).a)
  w = (!t).pickw(false)
  w.a = 40
  print(t.y.a)
  ((!t).pickw(true)).b = 20
  print(t.x.b)
  r = ?t.pick(true)
  print(r == t.x, r.a == 1)

