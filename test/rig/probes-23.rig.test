  fun st(n: Int, c: Int) -> Int
    print("s", n, c)
    c + 1

  fun adv(n: Int, c: Int, g: Bool) -> Int?
    print("s", n, c)
    none if g else c + 1

  fun lim(c: Int, n: Int) -> Int?
    c if c < n else none

  fun limf(c: Int, n: Int, bad: Bool) -> Int?!
    return E.bad if bad
    lim(c, n)

  fun mkd(k: Int, c: Int, n: Int) -> D?
    D(n: 1000 * (k + 1) + c) if c < n else none

  fun gate(b: Bool) -> Int?
    none if b else 1

  fun mkvec(k: Int, n: Int) -> List[D]
    v: List[D] = List()
    for i in 0..n
      !v.push(D(n: 2000 * (k + 1) + i))
    v

  fun grow(v: !List[Int], n: Int, c: Int) -> Int
    print("s", n, c)
    for i in 0..20
      !v.push(i)
    c + 1

  fun ints(n: Int) -> List[Int]
    v: List[Int] = List()
    for i in 0..n
      !v.push(10 + i)
    v

  guard = 0
  z0 = "abc"
  p0 = 0
  for ch0, c0 in z0
    guard += 1
    if guard > 300
      print("cap")
      return
    p0 += 1
    _ = p0
    defer print("d0", c0)
    _ = ch0
    print("b0", c0)
    $a: match c0
      _
        o1 = ints(1)
        c1 = 0
        p1 = 0
        $l1: while (limf(c1, 2, false) catch continue) as h1: c1 = grow(!o1, 1, c1)
