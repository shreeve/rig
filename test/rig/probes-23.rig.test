fail "review-never-data-1-a02 inner copy out", "`h.inner` is a unique `Inner`, which can't be copied by `=`: write `?h.inner` to view it"
  obj Inner
    c: Cell[Int] = Cell(0)

  obj S
    inner: Inner

  h = *S(inner: Inner())
  !h.inner.c.set(3)
  y = h.inner
  !y.c.set(7)
  print(h.inner.c.get())

