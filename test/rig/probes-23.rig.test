test "review-lend-base-3-k-k01", "1 5 1 1 1 2 2 2 0 0"
  obj P
    x: Int
    arr: [3]Int
    items: List[Int]

  fun id(p: !P) -> !P
    p

  fun mk(n: Int) -> P
    P(x: n, arr: [n, n, n], items: List[Int]())

  p = mk(1)
  q = mk(2)
  c = true
  d = false
  _ = c
  _ = d
  w = !q
  (!p if d else <w).x = 5
  print(p.x, q.x, p.arr[0], p.arr[1], p.arr[2], q.arr[0], q.arr[1], q.arr[2], p.items.len, q.items.len)

