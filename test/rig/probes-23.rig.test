test "review-move-done-2-e02 take index effects", "false 101"
  # A take whose index writes the List it takes from.
  fun mkv(n: Int) -> List[Int]
    xs: List[Int] = List()
    !xs.push(n)
    xs

  fun grow(v: !List[List[Int]?]) -> Int
    for i in 0..100
      !v.push(mkv(i))
    0

  v: List[List[Int]?] = List()
  !v.push(mkv(1))
  x = <v[grow(!v)]
  print(x == none, v.len)

  # oracle: mkv accept
  # oracle: grow accept

fail "review-move-done-2-e05 take args order", "cannot lend `s.o` to write while a read loan is live"
  # A take beside a lend of the same place in one call.
  obj S
    o: List[Int]?

    sub set(!@, x: List[Int]?)
      @o = <x

  fun mkv(n: Int) -> List[Int]
    xs: List[Int] = List()
    !xs.push(n)
    xs

  fun both(a: ?List[Int]?, b: List[Int]?) -> Int
    n = 0
    if a as x
      n += x.len
    if b as y
      n += y.len
    n

  fun both2(b: List[Int]?, a: ?S) -> Int
    n = 0
    if b as y
      n += y.len
    if a.o as x
      n += x.len
    n

  sub one()
    s = S(o: mkv(1))
    print(both(?s.o, <s.o))

  sub two()
    s = S(o: mkv(1))
    print(both2(<s.o, ?s))

  sub three()
    s = S(o: mkv(1))
    !s.set(<s.o)
    print(s.o == none)

  sub four()
    v: List[List[Int]?] = List()
    !v.push(mkv(1))
    !v.push(<v[0])
    print(v.len, v[0] == none)

  one()
  two()
  three()
  four()

  # oracle: S.set accept
  # oracle: mkv accept
  # oracle: both accept
  # oracle: both2 accept
  # oracle: one reject C4
  # oracle: two accept
  # oracle: three reject C4
  # oracle: four reject C4
  # oracle: main accept

fail "review-move-done-2-g03 generic leaf", "`<` here would copy `a` out without moving it; move it inside the branch: `<a`"
  # Generic leaves: `<(a if c else b)` with T params, `<(o ?? a)`.
  fun pick[T](c: Bool, a: T, b: T) -> T
    <(a if c else b)

  fun orr[T](o: T?, a: T) -> T
    <(o ?? a)

  fun mkv(n: Int) -> List[Int]
    xs: List[Int] = List()
    !xs.push(n)
    xs

  print(pick(true, mkv(1), mkv(2)).len)
  print(orr(mkv(1), mkv(2)).len)

  # oracle: pick reject C3
  # oracle: orr reject C3
  # oracle: mkv accept

