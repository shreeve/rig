    xs

  sub a()
    e: E = .one(s: S(o: mkv(1)))
    match !e
      .one(s) => print(<s.o == none)
      .none_ => print(0)
    match e
      .one(s) => print(s.o == none)
      .none_ => print(0)

  sub b()
    v: List[S] = List()
    !v.push(S(o: mkv(1)))
    !v.push(S(o: mkv(2)))
    for s in <v
      x = <s.o
      print(x == none)

  sub c()
    s = S(o: mkv(3))
    k = 0
    while <s.o as x
      k += x.len
    print(k, s.o == none)

  a()
  b()
  c()

  # oracle: mkv accept
  # oracle: a accept
  # oracle: b accept
  # oracle: c accept
  # oracle: main accept

test "review-move-done-2-v01 branch of view bindings", '''
  false true false
  false true true
'''
  # A take through a branching value whose leaves are write views held in
  # bindings, and through a view binding's field. (A read lend of `s` before
  # `<(!s if c else !t).o` is rejected, as it should be: not kept here.)
  obj S
    o: List[Int]?

  fun mkv(n: Int) -> List[Int]
    xs: List[Int] = List()
    !xs.push(n)
    xs

  sub a(c: Bool)
    s = S(o: mkv(1))
    t = S(o: mkv(2))
    r1 = !s
    r2 = !t
    x = <(r1 if c else r2).o
    print(x == none, r1.o == none, r2.o == none)

  sub d(c: Bool)
    s = S(o: mkv(1))
    r1 = !s
    x = <r1.o
    y = <(r1).o
    print(x == none, y == none, s.o == none)

  a(true)
  d(true)

  # oracle: mkv accept
  # oracle: a accept
  # oracle: d accept
  # oracle: main accept

