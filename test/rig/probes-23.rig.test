    for i in 0..n
      !v.push(10 + i)
    v

  guard = 0
  c0 = 0
  p0 = 0
  $a: while (limf(c0, 3, false) catch continue) as h0: c0 = adv(0, c0, p0 == 2) ?? continue
    guard += 1
    if guard > 300
      print("cap")
