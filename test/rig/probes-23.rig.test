test "review-move-done-p73 advice works", '''
  1
  one
  3
  4
  1 1 1 5 1
  1
'''
  # the advised fix ("drop the `<`") for each carrier the reject test covers
  obj P
    x: Int

  obj S
    n: Int
    p: P
    arr: [2]Int

  sub show(n: Int)
    print(n)

  fun ret(s: ?S) -> Int
    return s.n

  s = S(n: 1, p: P(x: 2), arr: [3, 4])
  show(s.n)
  match s.n
    1 => print("one")
    _ => print("other")
  q = S(n: s.n, p: s.p, arr: [s.n, 0])
  i = 0
  j = while i < 2 : i += 1
    break s.n
  else
    0
  for x in s.arr
    print(x)
  h = *S(n: 5, p: P(x: 6), arr: [0, 0])
  print(q.n, j, ret(?s), h.n, s.n)
  print(s.n)

  # oracle: show accept
  # oracle: ret accept
  # oracle: main accept

fail "review-move-done-p74 print read then write lend", "cannot lend `s` to write while a read loan is live"
  # aside (pre-existing, not this branch): a copied-out read of `id(?s).n`
  # keeps `s` lent for the rest of the call's arguments
  obj S
    n: Int

  fun bump(s: !S) -> Int
    s.n += 1
    s.n

  fun id(s: ?S) -> ?S
    s

  s = S(n: 1)
  print(id(?s).n, bump(!s))

  # oracle: main accept

test "review-needs50-equality", '''
  false true true true
  true false false true
  false false false false
  true true
'''
  # A variant literal compared with a `?Q` view on either side of `==`
  # and `!=`, bare and with a payload, after being lent as the argument
  # that made the view. Runs sanitizer-clean.
  enum Q
    Num(n: Int)
    Str(s: String)
    Empty

  sub check(v: ?Q)
    print(v == .Empty, v == .Num(n: 3), .Num(n: 3) == v, v != .Str(s: String("x")))

  check(.Num(n: 3))
  check(.Empty)
  check(.Str(s: String("x")))
  q = Q.Num(n: 3)
  print(q == .Num(n: 3), ?q == .Num(n: 3))

test "review-needs50-generic-enum", '''
  some 2
  nothing
  some 3
  nothing
'''
  # A variant literal of a generic enum, bare and with a payload, lent
  # where `?Opt[List[Int]]` and `?Opt[Int]` go. Runs sanitizer-clean.
  enum Opt[T]
    Some(v: T)
    Nothing

  fun three() -> List[Int]
    xs = List[Int]()
    !xs.push(1)
    !xs.push(2)
    return <xs

  sub show(o: ?Opt[List[Int]])
    match o
      .Some(v) => print("some", v.len)
      .Nothing => print("nothing")

  sub count(o: ?Opt[Int])
    match o
      .Some(v) => print("some", v)
      .Nothing => print("nothing")

  show(.Some(v: three()))
  show(.Nothing)
  count(.Some(v: 3))
  count(.Nothing)

test "review-needs50-generic-view", '''
  2 1 0
  true false
  .Str(s: "id")
'''
  # A variant literal lent where a generic `?T` goes once `T` is known:
  # from an earlier argument, from a generic object's receiver, and from
  # the view the call's result is lent to. Runs sanitizer-clean.
  enum Q
    Num(n: Int)
    Str(s: String)
    Empty

  obj Box[T]
    x: T

  fun Box[T].same(?@, y: ?T) -> Bool
    @x == y

  fun count[T](xs: ?List[T], x: ?T) -> Int
    n = 0
    for y in xs
      n += 1 if y == x
    return n

  fun id[T](x: ?T) -> ?T
    return x

  sub show(q: ?Q)
    print(q)

  xs = List[Q]()
  !xs.push(.Num(n: 1))
  !xs.push(.Str(s: String("a")))
  !xs.push(.Num(n: 1))
  print(count(?xs, .Num(n: 1)), count(?xs, .Str(s: String("a"))), count(?xs, .Empty))
  b = Box[Q](x: .Str(s: String("z")))
  print(b.same(.Str(s: String("z"))), b.same(.Empty))
  show(id(.Str(s: String("id"))))

test "review-needs50-jumps", '''
  table 3
  num 0
  table 3
  num 2
  table 3
  num 0
  table 3
  num 2
  -1 2
'''
  # A variant literal lent to a `?Val` argument, owning a List, is made
  # before a later argument jumps out of the statement (`continue`,
  # `break`, `return` through `??`): the temporary is dropped on every
  # path. Runs sanitizer-clean.
  enum Val
    Num(n: Int)
    Table(m: List[Int])

  fun three() -> List[Int]
    xs = List[Int]()
    !xs.push(1)
    !xs.push(2)
    !xs.push(3)
    return <xs

  sub show(v: ?Val)
    match v
      .Num(n) => print("num", n)
      .Table(m) => print("table", m.len)

  fun both(a: ?Val, b: ?Val) -> Int
    show(a)
    show(b)
    2

  fun opt(i: Int) -> Int?
    none if i == 1 else i

  fun early(i: Int) -> Int
    return both(.Table(m: three()), .Num(n: opt(i) ?? return -1))

  for i in 0..3
    _ = both(.Table(m: three()), .Num(n: opt(i) ?? continue))
  for i in 0..3
    _ = both(.Table(m: three()), .Num(n: opt(i) ?? break))
  print(early(1), early(2))

test "review-needs50-module", '''
  a 1
  drop 1
  b 0
  c
  a 2
  drop 2
  some 3
  drop 3
  none
  end
'''
  # A variant literal of an enum imported from another module, plain and
  # generic, lent where `?lib.E` and `?lib.G[lib.R]` go, also by keyword.
  # Runs sanitizer-clean, dropping each `lib.R` at its statement's end.
  use lib

  sub mine(e: ?lib.E, k: Int = 0)
    lib.look(e)

  sub main()
    lib.look(.A(r: lib.R(n: 1)))
    lib.look(.B(xs: List()))
    lib.look(.C)
    mine(k: 2, e: .A(r: lib.R(n: 2)))
    lib.lookg(.Some(v: lib.R(n: 3)))
    lib.lookg(.None_)
    print("end")

  file "lib.rig"
    pub obj R
      pub n: Int

      drop(!@)
        print("drop", @n)

    pub enum E
      A(r: R)
      B(xs: List[Int])
      C

    pub enum G[T]
      Some(v: T)
      None_

    pub sub look(e: ?E)
      match e
        .A(r) => print("a", r.n)
        .B(xs) => print("b", xs.len)
        .C => print("c")

    pub sub lookg(g: ?G[R])
      match g
        .Some(v) => print("some", v.n)
        .None_ => print("none")

test "review-needs50-nested", '''
  box 1
  pair 3 0
  pair 1 1
  4
  6
'''
  # Nested variant literals under a view: an outer literal lent to
  # `?Outer` whose owned payloads are themselves literals (with keyword
  # arguments reordered), and a tree of boxed literals lent to `?Tree`.
  # Runs sanitizer-clean.
  enum Outer
    Box(v: Inner)
    Pair(a: Inner, b: Inner)

  enum Inner
    L(xs: List[Int])
    S(s: String)
    E

  enum Tree
    Leaf(n: Int)
    Node(l: ^Tree, r: ^Tree, tag: String)

  fun mk() -> List[Int]
    xs = List[Int]()
    !xs.push(4)
    return <xs

  fun inner(i: ?Inner) -> Int
    match i
      .L(xs) => xs.len
      .S(s) => s.len
      .E => 0

  sub look(o: ?Outer)
    match o
      .Box(v) => print("box", inner(v))
      .Pair(a, b) => print("pair", inner(a), inner(b))

  fun sum(t: ?Tree) -> Int
    match t
      .Leaf(n) => n
      .Node(l, r, _) => sum(l) + sum(r)

  look(.Box(v: .L(xs: mk())))
  look(.Pair(a: .S(s: String("hey")), b: .E))
  look(.Pair(b: .L(xs: mk()), a: .L(xs: mk())))
  print(inner(.S(s: String("abcd"))))
  print(sum(.Node(l: ^.Leaf(n: 1), r: ^.Node(l: ^.Leaf(n: 2), r: ^.Leaf(n: 3), tag: String("in")), tag: String("out"))))

test "review-needs50-payload-kinds", '''
  sh 1
  sh 1
  bx 2
  st hi
  rs 3
  drop 3
  after
  vw view
  rs 4
  drop 4
  rs 5
  drop 5
  end
'''
  # A variant literal lent to a `?H` argument, for each kind of payload:
  # a `*T` cloned and moved, a `^T`, a String, an object with a `drop`, a
  # `?String`, and a box of a nested literal. Each temporary is dropped
  # at the end of its statement. Runs sanitizer-clean.
  obj N
    n: Int

  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  enum H
    Sh(p: *N)
    Bx(b: ^N)
    St(s: String)
    Rs(r: R)
    Vw(s: ?String)
    Nest(h: ^H)

  sub look(x: ?H)
    match x
      .Sh(p) => print("sh", p.n)
      .Bx(b) => print("bx", b.n)
      .St(s) => print("st", s)
      .Rs(r) => print("rs", r.n)
      .Vw(s) => print("vw", s)
      .Nest(h) => look(h)

  p = *N(n: 1)
  look(.Sh(p: +p))
  look(.Sh(p: <p))
  look(.Bx(b: ^N(n: 2)))
  look(.St(s: String("hi")))
  look(.Rs(r: R(n: 3)))
  print("after")
  look(.Vw(s: "view"))
  look(.Nest(h: ^H.Rs(r: R(n: 4))))
  look(.Nest(h: ^.Rs(r: R(n: 5))))
  print("end")

test "review-needs50-positions", '''
  closure 3
  4 3
  postfix 3
  loop 0
  loop 1
  loop 2
  9
  3
  defer 3
'''
  # A variant literal owning a List, lent to a `?Val` view in statement
  # positions other than a plain call: a closure and an owned closure, a
  # `?fun` value, a `defer`, a postfix `if`, a `while` condition and step,
  # a method's argument by keyword, and a view the call returns, read in
  # the same statement. Runs sanitizer-clean.
  enum Val
    Num(n: Int)
    Table(m: List[Int])

  obj Bag
    n: Int

  fun three() -> List[Int]
    xs = List[Int]()
    !xs.push(1)
    !xs.push(2)
    !xs.push(3)
    return <xs

  fun size(v: ?Val) -> Int
    match v
      .Table(m) => m.len
      .Num(n) => n

  fun keep(v: ?Val) -> ?Val
    return v

  fun apply(f: ?fun(?Val) -> Int) -> Int
    f(.Table(m: three()))

  fun Bag.size(?@, v: ?Val, extra: Int = 0) -> Int
    size(v) + extra + @n

  defer print("defer", size(.Table(m: three())))
  c = true
  f = |v: ?Val| print("closure", size(v))
  f(.Table(m: three()))
  g = *|v: ?Val| size(v) + 1
  print(g(.Table(m: three())), apply(size))
  print("postfix", size(.Table(m: three()))) if c
  i = 0
  while size(.Table(m: three())) > i: i += size(.Num(n: 1))
    print("loop", i)
  b = Bag(n: 1)
  print(b.size(extra: 5, v: .Table(m: three())))
  print(size(keep(.Table(m: three()))))

fail "review-needs50-view-escapes", "a view of the temporary `.Table(m: List())` outlives its statement, which drops it; bind the value to a name first"
  # A view of a variant literal lent to a call, returned by that call, may
  # not outlive the statement that drops the literal: bound by `if ... as`,
  # read by the arms of `match`, or iterated by `for`. Rejected.
  enum Val
    Num(n: Int)
    Table(m: List[Int])

  fun keep(v: ?Val) -> ?Val
    return v

  fun keep2(v: ?Val) -> (?Val)?
    return v

  fun items(v: ?Val, other: ?List[Int]) -> ?List[Int]
    match v
      .Table(m) => m
      .Num(_) => other

  ys = List[Int]()
  if keep2(.Table(m: List())) as v
    print(v)
  match keep(.Table(m: List()))
    .Table(m) => print("t", m.len)
    .Num(n) => print(n)
  for x in items(.Table(m: List()), ?ys)
    print(x)

