test "review-loop-lowering-a02-cond-break-step-reads-binding", "6 6"
  # Control: a `break` in the condition with a step reading the binding.
  #
  # oracle: odd accept
  # oracle: some accept
  # oracle: main accept
  fun odd(i: Int) -> Int?
    none if i % 2 == 1 else i

  fun some(i: Int) -> Int?
    i if i < 6 else none

  steps = 0
  i = 0
  while some(odd(i) ?? break) as h: steps += h
    i += 2
  print(steps, i)

test "review-loop-lowering-a03-cond-continue-in-value-loop", "9 6"
  # A `continue` that targets a loop nested inside the condition (a loop
  # used as a value in a call argument), not the `while` itself.
  #
  # oracle: some accept
  # oracle: first accept
  # oracle: main accept
  fun some(i: Int) -> Int?
    i if i < 6 else none

  fun first(i: Int) -> Int
    w = for t in 0..3
      continue if t == 0
      break t + i
    else
      0
    w

  steps = 0
  i = 0
  while some(first(i)) as h: steps += h
    i += 2
  print(steps, i)

test "review-loop-lowering-b01-value-loop-break-in-step", '''
  defer 0
  drop 0
  defer 1
  drop 1
  defer 2
  drop 2
  defer 3
  drop 3
  a 103 3
  defer 0
  drop 10
  defer 1
  drop 11
  defer 2
  drop 12
  defer 3
  drop 13
  b 203 3
'''
  # Control: a `break v` in a step (and `-1` as a statement-loop else) is
  # rejected by both main and the branch.
  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun nxt(i: Int) -> Int?
    i + 1 if i < 3 else none

  fun some(i: Int) -> Int?
    i if i < 9 else none

  i = 0
  a = while i < 10: i = nxt(i) ?? break 100 + i
    d = D(n: i)
    defer print("defer", i)
  else
    -1
  print("a", a, i)
  j = 0
  b = while some(j) as h: j = nxt(h) ?? break 200 + h
    d = D(n: 10 + j)
    defer print("defer", j)
  else
    -1
  print("b", b, j)

test "review-loop-lowering-b02-return-in-step-and-cond", '''
  defer 0
  drop 10
  defer 1
  drop 11
  defer 2
  drop 12
  drop 1
  f 7
  body 50
  drop 20
  body 51
  drop 21
  drop 2
  g 8
  body 50
  defer 0
  drop 30
  body 51
  defer 1
  drop 31
  body 52
  defer 2
  drop 32
  drop 3
  h 52
'''
  # `return` from a step and from a condition, with owned locals before the
  # loop and in the body.
  #
  # oracle: D.drop accept
  # oracle: nxt accept
  # oracle: mk accept
  # oracle: f accept
  # oracle: h3 accept
  # oracle: main accept
  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun nxt(i: Int) -> Int?
    i + 1 if i < 2 else none

  fun mk(i: Int) -> Int?
    50 + i if i < 5 else none

  fun f(lim: Int) -> Int
    keep = D(n: 1)
    i = 0
    while i < 10: i = nxt(i) ?? return 7
      d = D(n: 10 + i)
      defer print("defer", i)
    0

  fun g(lim: Int) -> Int
    keep = D(n: 2)
    i = 0
    while mk(i) as h and (nxt(i) ?? return 8) > 0: i += 1
      d = D(n: 20 + i)
      print("body", h)
    0

  fun h3(lim: Int) -> Int
    keep = D(n: 3)
    i = 0
    while mk(i) as h: i = nxt(h - 50) ?? return h
      d = D(n: 30 + i)
      defer print("defer", i)
      print("body", h)
    0

  print("f", f(0))
  print("g", g(0))
  print("h", h3(0))

test "review-loop-lowering-b03-propagate-from-step-cond-body", '''
  defer 0
  drop 10
  defer 1
  drop 11
  defer 2
  drop 12
  defer 3
  drop 13
  drop 1
  f 4
  defer 0
  drop 10
  defer 1
  drop 11
  defer 2
  drop 12
  errdefer f
  drop 1
  f -1
  body 50
  drop 20
  drop 50
  body 51
  drop 21
  drop 51
  body 52
  drop 22
  drop 52
  body 53
  drop 23
  drop 53
  drop 2
  g 4
  body 50
  drop 20
  drop 50
  errdefer g
  drop 2
  g -1
  defer 0
  drop 30
  defer 1
  drop 31
  defer 2
  drop 32
  defer 3
  drop 33
  drop 3
  h 4
  defer 0
  drop 30
  defer 1
  drop 31
  defer 2
  drop 32
  drop 3
  h -1
  body 50
  drop 40
  drop 50
  body 51
  drop 41
  drop 51
  body 52
  drop 42
  drop 52
  body 53
  drop 43
  drop 53
  drop 4
  k 4
  body 50
  drop 40
  drop 50
  body 51
  drop 41
  drop 51
  drop 4
  k -1
'''
  # `!` and `?` propagation out of a step, a condition, and a body, with a
  # body `defer`, an `errdefer`, owned locals, and an owning binding.
  #
  # oracle: D.drop accept
  # oracle: nx accept
  # oracle: mk accept
  # oracle: opt accept
  # oracle: f accept
  # oracle: g accept
  # oracle: h3 accept
  # oracle: k accept
  # oracle: main accept
  error E
    bad

  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun nx(i: Int, bad: Int) -> Int!
    return E.bad if i == bad
    i + 1

  fun mk(i: Int, bad: Int) -> D?!
    return E.bad if i == bad
    D(n: 50 + i) if i < 4 else none

  fun opt(i: Int, gone: Int) -> Int?
    none if i == gone else i + 1

  fun f(bad: Int) -> Int!
    keep = D(n: 1)
    errdefer print("errdefer f")
    i = 0
    while i < 4: i = nx(i, bad)!
      y = D(n: 10 + i)
      defer print("defer", i)
    i

  fun g(bad: Int) -> Int!
    keep = D(n: 2)
    errdefer print("errdefer g")
    i = 0
    while mk(i, bad)! as h: i += 1
      y = D(n: 20 + i)
      print("body", h.n)
    i

  fun h3(bad: Int) -> Int!
    keep = D(n: 3)
    i = 0
    for t in 0..4
      y = D(n: 30 + t)
      defer print("defer", t)
      i = nx(t, bad)!
    i

  fun k(gone: Int) -> Int?
    keep = D(n: 4)
    i = 0
    while (mk(i, 99) catch none) as h: i = opt(i, gone)?
      y = D(n: 40 + i)
      print("body", h.n)
    i

  print("f", f(9) catch 0 - 1)
  print("f", f(2) catch 0 - 1)
  print("g", g(9) catch 0 - 1)
  print("g", g(1) catch 0 - 1)
  print("h", h3(9) catch 0 - 1)
  print("h", h3(2) catch 0 - 1)
  print("k", k(9) ?? 0 - 1)
  print("k", k(1) ?? 0 - 1)

test "review-loop-lowering-b04-step-moves-repoints", '''
  defer 10
  step 10 0
  drop 10
  defer 11
  step 11 1
  drop 11
  defer 12
  step 12 2
  drop 12
  tail 4
  defer 13
  step 13 3
  drop 13
  o 14
  t 0
  view 1
  t 0
  view 1
  t 0
  view 2
  t 0
  view 1
  k 5
  drop 14
'''
  # Steps that move an owned value and re-point a view, which the body's
  # `defer` reads, with `continue` from the body, from an inner loop's
  # `else`, and from a labeled inner loop; a joined condition whose binding
  # the step reads.
  #
  # oracle: D.drop accept
  # oracle: mv accept
  # oracle: pick accept
  # oracle: lim accept
  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun mv(d: D, c: Int) -> D
    print("step", d.n, c)
    D(n: d.n + 1)

  fun pick(a: ?List[Int], b: ?List[Int], c: Int) -> []Int
    ?a[..] if c % 2 == 0 else ?b[..]

  fun lim(c: Int, n: Int) -> Int?
    c if c < n else none

  o = D(n: 10)
  c = 0
  $outer: while lim(c, 4) as h and h >= 0: o = mv(<o, h)
    c += 1
    defer print("defer", o.n)
    continue if c == 1
    for t in 0..2
      continue $outer if c == 3 and t == 1
    else
      continue if c == 2
    print("tail", c)
  print("o", o.n)
  a: List[Int] = List()
  !a.push(1)
  b: List[Int] = List()
  !b.push(2)
  s = pick(?a, ?b, 0)
  k = 0
  i = 0
  while lim(i, 4) as g: s = pick(?a, ?b, g)
    i += 1
    defer print("view", s[0])
    k += s[0]
    for t in 0..1
      print("t", t)
    else
      continue if i == 2
  print("k", k)

test "review-loop-lowering-c02-step-closure-reads-binding", '''
  body 1 0
  0 1
'''
  # The step reads the condition binding only through a closure capture
  # (`|+h, x: Int| x + h`): no jump in the condition.
  #
  # oracle: odd accept
  # oracle: some accept
  # oracle: apply accept
  # oracle: main accept
  fun odd(i: Int) -> Int?
    none if i % 2 == 1 else i

  fun some(i: Int) -> Int?
    i if i < 6 else none

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  steps = 0
  i = 0
  while some(odd(i) ?? break) as h: steps = apply(|+h, x: Int| x + h, steps)
    i += 1
    print("body", i, h)
  print(steps, i)

test "review-loop-lowering-d01-constant-conditions", "3"
  # Loops whose condition is a compile-time constant other than `true`.
  #
  # oracle: main accept
  DONE = false

  sub main()
    n = 0
    while false
      n += 1
    while DONE
      n += 10
    while 1 > 2
      n += 100
    k = false
    while k: n += 1000
      n += 1000
    while not true
      n += 7
    while (true)
      n += 1
      break if n > 2
    print(n)

test "review-loop-lowering-d02-while-true-else", "6 6"
  # `while true` with an `else`, which never runs: every `break` leaves the
  # loop's result block, so nothing leaves the Zig `while (true)` itself.
  #
  # oracle: main accept
  n = 0
  while true
    n += 1
    break if n > 2
  else
    print("never")
  x = while true
    n += 1
    break n if n > 5
  else
    0
  print(n, x)

test "review-loop-lowering-d03-while-true-step-else", "3 2"
  # `while true: step` with an `else` and a `continue`.
  #
  # oracle: main accept
  n = 0
  k = 0
  while true: k += 1
    n += 1
    continue if n == 1
    break if n > 2
  else
    print("never")
  print(n, k)

test "review-loop-lowering-d04-loops-in-defer-and-closure", '''
  defer 0 1
  defer 1 1
  6
  defer 0 1
  errdefer 1 0
  errdefer 1 2
  errdefer 1 3
  defer 1 1
  -1
'''
  # Loops inside a `defer` block, an `errdefer` block, and a closure, each
  # with labels that repeat an enclosing loop's and jumps of their own.
  #
  # oracle: opt accept
  # oracle: run accept
  # oracle: work accept
  # oracle: main accept
  error E
    bad

  fun opt(j: Int) -> Int?
    j + 1 if j != 1 else none

  fun run(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  fun work(fail: Bool) -> Int!
    n = 0
    $a: for i in 0..2
      defer
        $a: for j in 0..3
          continue $a if j == 0
          print("defer", i, j)
          break $a if j == 1
      errdefer
        k = 0
        $a: while (opt(k) ?? continue) > 0: k += 1
          print("errdefer", i, k)
          break $a if k > 2
      n += run(x: 3, f: |x: Int|
        t = 0
        $a: for q in 0..x
          continue $a if q == 0
          t += q
        t
      )
      return E.bad if fail and i == 1
      continue $a
    n

  print(work(false) catch 0 - 1)
  print(work(true) catch 0 - 1)

test "review-loop-lowering-e01-jump-in-for-source", '''
  else range 0
  after range 0
  drop 100
  drop 101
  else range 2
  after range 2
  drop 102
  else vec 0
  after vec 0
  drop 200
  drop 201
  else vec 2
  after vec 2
  drop 202
  d 0
  drop 0
  d 1
  drop 1
  else arr 0
  after arr 0
  drop 300
  drop 301
  11
'''
  # A jump in a `for` source targets the loop around the `for`, for a range,
  # a List in place, a consumed List a call makes, and an array a call makes;
  # the inner `for` has an `else` and an owned local in its body.
  #
  # oracle: D.drop accept
  # oracle: opt accept
  # oracle: vec accept
  # oracle: arr accept
  # oracle: main accept
  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun opt(i: Int) -> Int?
    none if i == 1 else i

  fun vec(i: Int) -> List[Int]?
    if i == 1
      return none
    v: List[Int] = List()
    !v.push(i)
    !v.push(i + 1)
    v

  fun arr(i: Int) -> ([2]D)?
    none if i == 1 else [D(n: 10 * i), D(n: 10 * i + 1)]

  n = 0
  for i in 0..3
    y = D(n: 100 + i)
    for j in (opt(i) ?? continue)..3
      n += j
    else
      print("else range", i)
    print("after range", i)
  for i in 0..3
    y = D(n: 200 + i)
    for x in (vec(i) ?? continue)
      n += x
    else
      print("else vec", i)
    print("after vec", i)
  for i in 0..3
    y = D(n: 300 + i)
    for d in (arr(i) ?? break)
      print("d", d.n)
    else
      print("else arr", i)
    print("after arr", i)
  print(n)

test "review-loop-lowering-e02-value-loop-owned-break", '''
  drop 100
  drop 0
  drop 101
  drop 3
  drop 2
  a 1
  drop 10
  drop 12
  b 11
  drop 200
  drop 20
  drop 201
  drop 21
  drop 202
  c 22
  drop 20
  drop 21
  drop 22
  drop 23
  d 96
  drop 96
  drop 22
  drop 11
  drop 1
'''
  # Loops used as values that hand out an owned value: a consumed List's
  # element, an element of an array the source makes, and a while binding;
  # the remaining elements drop when the loop is left.
  #
  # oracle: D.drop accept
  # oracle: mkvec accept
  # oracle: arr accept
  # oracle: mk accept
  # oracle: main accept
  obj D
    n: Int
    drop(!@)
      print("drop", @n)

  fun mkvec(n: Int) -> List[D]
    v: List[D] = List()
    for i in 0..n
      !v.push(D(n: i))
    v

  fun arr() -> [3]D
    [D(n: 10), D(n: 11), D(n: 12)]

  fun mk(i: Int) -> D?
    D(n: 20 + i) if i < 4 else none

  q = mkvec(4)
  a = for e, i in <q
    y = D(n: 100 + i)
    continue if i == 0
    break <e if i == 1
  else
    D(n: 99)
  print("a", a.n)
  b = for e in arr()
    break <e if e.n == 11
  else
    D(n: 98)
  print("b", b.n)
  i = 0
  c = while mk(i) as h: i += 1
    y = D(n: 200 + i)
    break <h if i == 2
  else
    D(n: 97)
  print("c", c.n)
  i = 0
  d = while mk(i) as h: i += 1
    break <h if i == 9
  else
    D(n: 96)
  print("d", d.n)

