fail "review-lend-base-3-k-k09", "`?p if c else ?q.items` owns a `List[Int]`, which can't be copied by `=`: write `+?p if c else ?q.items` to clone it or `??p if c else ?q.items` to view it"
  obj P
    x: Int
    arr: [3]Int
    items: List[Int]

  fun id(p: !P) -> !P
    p

  fun mk(n: Int) -> P
    P(x: n, arr: [n, n, n], items: List[Int]())

  p = mk(1)
  q = mk(2)
  c = true
  d = false
  _ = c
  _ = d
  y = (?p if c else ?q).items
  print(y.len)
  print(p.x, q.x, p.arr[0], p.arr[1], p.arr[2], q.arr[0], q.arr[1], q.arr[2], p.items.len, q.items.len)

fail "review-lend-base-3-k-k13", "cannot move out of `(!p if d else !q).items`: it is reached through `!p if d else !q`, a view, which gives up nothing of what it views; exchange the part where it is owned, with `swap`"
  obj P
    x: Int
    arr: [3]Int
    items: List[Int]

  fun id(p: !P) -> !P
    p

  fun mk(n: Int) -> P
    P(x: n, arr: [n, n, n], items: List[Int]())

  p = mk(1)
  q = mk(2)
  c = true
  d = false
  _ = c
  _ = d
  y = <(!p if d else !q).items
  print(y.len)
  print(p.x, q.x, p.arr[0], p.arr[1], p.arr[2], q.arr[0], q.arr[1], q.arr[2], p.items.len, q.items.len)

