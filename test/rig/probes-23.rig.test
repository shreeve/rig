  guard = 0
  z0 = "abc"
  p0 = 0
  $l0: for ch0, c0 in z0
    guard += 1
    if guard > 300
      print("cap")
      return
    p0 += 1
    _ = p0
    y0 = D(n: 0 + c0)
    defer print("d0", c0)
    _ = ch0
    print("b0", c0)
    z1 = "ab"
    p1 = 0
    $l1: for ch1, c1 in z1
      guard += 1
      if guard > 300
        print("cap")
        return
      p1 += 1
      _ = p1
      defer print("d1", c1)
      _ = ch1
      print("b1", c0, c1)
      continue $l0 if c0 == 1 and c1 == 1
      c2 = 0
      p2 = 0
      $l2: while (limf(c2, 2, false) catch break) as h2: c2 = st(2, h2)
        guard += 1
        if guard > 300
          print("cap")
          return
        p2 += 1
        _ = p2
        y2 = D(n: 200 + c2)
        print("b2", c0, c1, c2, h2)
        print("t2", c0, c1, c2)
      else
        print("e2", c0, c1)
      print("t1", c0, c1)
    print("t0", c0)
  print("end")

