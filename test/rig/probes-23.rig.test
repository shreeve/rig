test "review-lend-base-3-n-n01", "6 3"
  obj Bag[T]
    items: List[T]
    n: Int

    sub add(!@, x: T)
      (!@items).push(<x)
      @n += 1

    fun count(?@) -> Int
      @items.len + @n

  sub fill[T](b: !Bag[T], x: T, y: T)
    (!b).add(<x)
    !b.add(<y)

  b = Bag[Int](items: List(), n: 0)
  fill(!b, 3, 4)
  (!b).add(5)
  print((?b).count(), b.items.len)

