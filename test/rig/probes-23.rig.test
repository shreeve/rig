test "review-lend-base-3-n-n06", "1 2"
  sub put[T](v: !List[T], x: T)
    (!v).push(<x)

  obj Bag[T]
    items: List[T]

    sub add(!@, x: T)
      (!@).addraw(<x)

    sub addraw(!@, x: T)
      !@items.push(<x)

    fun size(?@) -> Int
      (?@).count()

    fun count(?@) -> Int
      @items.len

  v = List[String]()
  put(!v, String("a"))
  b = Bag[String](items: List())
  (!b).add(String("x"))
  !b.add(String("y"))
  print(v.len, b.size())

