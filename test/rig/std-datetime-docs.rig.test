# std.datetime: the examples in Jiff 1.0.0's documentation (MIT) of
# `Date`, `Time`, `DateTime`, and `Weekday`, for each behavior Rig keeps;
# each case names the file and line of the examples it ports. The
# record (docs/history/records/2026-11/datetime-phase2/doc-examples.md)
# lists every example, ported or left out, and why.

use std.datetime
use std.time

test "date examples: making one and its readers", '''
  2024 2 29 range
  2024 -2024 0 3 29 Thursday 4
  236 365 366 2024-02-01 2024-02-29 29 28 31
'''
  # jiff civil/date.rs:229, 240 (`new`), 405, 478, 495 (`year`, `month`,
  # `day`), 510 (`weekday`; its offsets other than ISO's are not Rig's),
  # 534 (`day_of_year`), 587, 602, 621 (`first_of_month`,
  # `last_of_month`, `days_in_month`).
  fun try_date(y: Int, m: Int, d: Int) -> ?String
    _ = datetime.Date.new(y, m, d) catch return "range"
    "ok"

  d = datetime.Date.new(2024, 2, 29)!
  print(d.year(), d.month(), d.day(), try_date(2023, 2, 29))
  print(datetime.Date.new(2024, 3, 9)!.year(), datetime.Date.new(-2024, 3, 9)!.year(), datetime.Date.new(0, 3, 9)!.year(), datetime.Date.new(2024, 3, 9)!.month(), d.day(), datetime.Date.new(1970, 1, 1)!.weekday(), datetime.Date.new(1970, 1, 1)!.weekday().iso_number())
  print(datetime.Date.new(2006, 8, 24)!.day_of_year(), datetime.Date.new(2023, 12, 31)!.day_of_year(), datetime.Date.new(2024, 12, 31)!.day_of_year(), d.first_of_month(), datetime.Date.new(2024, 2, 5)!.last_of_month(), datetime.Date.new(2024, 2, 10)!.days_in_month(), datetime.Date.new(2023, 2, 10)!.days_in_month(), datetime.Date.new(2024, 8, 15)!.days_in_month())

test "date examples: with", '''
  2024-11-30 2024-07-31 2007 range 6 range 10 29 range range
'''
  # jiff civil/date.rs:381 (`with`), 3024 to 3212 (`DateWith::year`,
  # `month`, `day`, and that changing one alone can fail). A `with`
  # replaces the fields given at once, so 2024-10-31 with month 11 and
  # day 30 is 2024-11-30.
  fun change(d: datetime.Date, year: Int? = none, month: Int? = none, day: Int? = none) -> String
    r = d.with(year: year, month: month, day: day) catch return String("range")
    String(r)

  print(change(datetime.Date.new(2024, 10, 31)!, month: 11, day: 30), change(datetime.Date.new(2024, 4, 30)!, day: 31, month: 7), datetime.Date.new(2005, 11, 5)!.with(year: 2007)!.year(), change(datetime.Date.new(2024, 2, 29)!, year: 2023), datetime.Date.new(2005, 11, 5)!.with(month: 6)!.month(), change(datetime.Date.new(2024, 10, 31)!, month: 11), datetime.Date.new(2024, 2, 5)!.with(day: 10)!.day(), datetime.Date.new(2024, 2, 5)!.with(day: 29)!.day(), change(datetime.Date.new(2023, 2, 5)!, day: 29), change(datetime.Date.new(2023, 9, 5)!, day: 31))

test "date examples: the nth weekday", '''
  2017-03-10 2024-03-28 2024-03-21 2024-03-25 range range
  Sunday 2024-03-11 2024-03-17 2024-03-21 2024-03-09 2024-03-03 2024-02-29
  Friday range Monday range 2024-03-29
  2024-03-10 2024-03-11 2024-03-10 2024-03-10
'''
  # jiff civil/date.rs:774, 787, 805 (`nth_weekday_of_month`), 851, 877,
  # 902, 920 (Israel's summer time), 938, 956 (the start of the week,
  # `tomorrow()` being `add(days: 1)`).
  fun nth(d: datetime.Date, n: Int, w: datetime.Weekday) -> String
    r = d.nth_weekday(n, w) catch return String("range")
    String(r)

  fun nthm(d: datetime.Date, n: Int, w: datetime.Weekday) -> String
    r = d.nth_weekday_of_month(n, w) catch return String("range")
    String(r)

  mar = datetime.Date.new(2024, 3, 1)!
  print(nthm(datetime.Date.new(2017, 3, 1)!, 2, .friday), nthm(mar, -1, .thursday), nthm(mar, -2, .thursday), nthm(datetime.Date.new(2024, 3, 25)!, 4, .monday), nthm(datetime.Date.new(2024, 3, 25)!, 5, .monday), nthm(datetime.Date.new(2024, 3, 25)!, -5, .monday))
  d = datetime.Date.new(2024, 3, 10)!
  print(d.weekday(), nth(d, 1, .monday), nth(d, 1, .sunday), nth(d, 2, .thursday), nth(d, -1, .saturday), nth(d, -1, .sunday), nth(d, -2, .thursday))
  top = datetime.Date.new(9999, 12, 31)!
  low = datetime.Date.new(-9999, 1, 1)!
  print(top.weekday(), nth(top, 1, .saturday), low.weekday(), nth(low, -1, .sunday), mar.nth_weekday_of_month(-1, .sunday)!.nth_weekday(-1, .friday)!)
  print(datetime.Date.new(2024, 3, 15)!.add(days: 1).nth_weekday(-1, .sunday)!, datetime.Date.new(2024, 3, 15)!.add(days: 1).nth_weekday(-1, .monday)!, d.add(days: 1).nth_weekday(-1, .sunday)!, datetime.Date.new(2024, 3, 16)!.add(days: 1).nth_weekday(-1, .sunday)!)

test "date examples: add and the counts", '''
  2024-04-30 2024-05-31 2024-04-30 2024-02-29 range range
  4543 -4543 8456 23 1 24 4543
  1 29 2024-03-03 60 2024-03-02
'''
  # jiff civil/date.rs:1269 to 1314 (`checked_add`: months clamp, the
  # operator, negative amounts, overflow; its hours on a date are a
  # compile error in Rig, §6.2), 1522, 1543, 1596 (`until`), 1650
  # (`since`, the days between). Rounding a count (1568) and adding a
  # `Duration` to a date (1328) are not Rig's.
  fun step(d: datetime.Date, years: Int) -> String
    r = d.checked_add(years: years) catch return String("range")
    String(r)

  fun ymd(a: datetime.Date, b: datetime.Date) -> String
    m = b.months_since(a)
    `{m / 12} {m % 12} {b.days_since(a.add(months: m))}`

  d = datetime.Date.new(2024, 3, 31)!
  print(d.checked_add(months: 1)!, d.checked_add(months: 2)!, d.add(months: 1), d.add(months: -1, days: -1).add(days: 1), step(d, 9000), step(d, -19000))
  early = datetime.Date.new(2006, 8, 24)!
  late = datetime.Date.new(2019, 1, 31)!
  print(late.days_since(early), early.days_since(late), datetime.Date.new(2019, 1, 31)!.days_since(datetime.Date.new(1995, 12, 7)!), ymd(datetime.Date.new(1995, 12, 7)!, datetime.Date.new(2019, 1, 31)!), late.days_since(early))
  a = datetime.Date.new(2024, 3, 2)!
  b = datetime.Date.new(2024, 5, 1)!
  m = b.months_since(a)
  print(m, b.days_since(a.add(months: m)), b.add(months: -m, days: -b.days_since(a.add(months: m))), b.days_since(a), b.add(days: -b.days_since(a)))

test "time examples", '''
  15:22:45 23:59:59 true 22:00:00 00:00:00
  21 30 5 123456789 range 15:30:24.01 14:27:30 range
  22:00:00 22:35:03.5 22:00:00 20:10:01 00:00:00 00:00:00
  22:35:03.5 22:00:00 20:10:01 23:59:59.999999999 range range 23:30:00 22:30:00 23:00:00.000000001
  2s 500ms -2s 500ms 12h 5m 29s 999ms 996us 500ns 21h 30m 1h 49m 59s
  15:45:10 15:45:11 15:45:11 15:45:10 15:25:00 15:30:00 00:00:00 15:00:00 15:00:00
'''
  # jiff civil/time.rs:45, 80 (text, `:60`), 95 (order), 123 (adding), 205
  # (`round`), 259, 273 (`new`), 374, 2896, 2907 (`with`), 624 to 691
  # (`wrapping_add`, which is Rig's `add`), 831 to 902 (`checked_add`),
  # 1183, 1201, 1245, 143 (`until` and `since`, one exact `Duration`),
  # 1430 to 1494 (`round` and `floor`, a half to the later, wrapping).
  fun checked(t: datetime.Time, d: time.Duration) -> String
    r = t.checked_add(d) catch return String("range")
    String(r)

  fun hour_of(t: datetime.Time, h: Int) -> String
    r = t.with(hour: h) catch return String("range")
    String(r)

  fun made(h: Int, m: Int, s: Int) -> String
    r = datetime.Time.new(h, m, s) catch return String("range")
    String(r)

  t = datetime.Time.new(20, 10, 1)!
  print(datetime.Time.parse("15:22:45")!, datetime.Time.parse("23:59:60")!, datetime.Time.new(7, 30, 1)! < datetime.Time.new(8, 10)!, t.add(hours: 1, minutes: 49, seconds: 59), datetime.Time.new(23, 59, 59, 999_999_999)!.add(ns: 1))
  n = datetime.Time.new(21, 30, 5, 123_456_789)!
  print(n.hour(), n.minute(), n.second(), n.nanosecond(), made(21, 30, 60), datetime.Time.new(0, 0, 24)!.with(hour: 15, minute: 30, ns: 10_000_000)!, datetime.Time.new(14, 27, 30, 123_456_789)!.with(ns: 0)!, hour_of(datetime.Time.new(14, 27, 30)!, 24))
  last = datetime.Time.new(23, 59, 59, 999_999_999)!
  print(t.add(hours: 1, minutes: 49, seconds: 59), datetime.Time.new(22, 35, 1)!.add(2.5), t.add(minutes: 109, seconds: 59), t.add(0), last.add(ns: 1), datetime.Time.new(0, 0)!.add(hours: 24))
  half = time.duration(minutes: 30)
  print(checked(datetime.Time.new(22, 35, 1)!, time.duration(2.5)), checked(t, time.duration(hours: 1, minutes: 49, seconds: 59)), checked(t, time.duration(0)), checked(datetime.Time.new(23, 59, 59, 999_999_998)!, time.duration(ns: 1)), checked(last, time.duration(ns: 1)), checked(datetime.Time.new(0, 0)!, time.duration(hours: 24)), checked(datetime.Time.new(23, 0)!, half), checked(datetime.Time.new(23, 0)!, half.neg()), checked(datetime.Time.new(23, 0)!, time.duration(ns: 1)))
  print(datetime.Time.new(22, 35, 3, 500_000_000)!.since(datetime.Time.new(22, 35, 1)!), datetime.Time.new(22, 35, 1)!.since(datetime.Time.new(22, 35, 3, 500_000_000)!), datetime.Time.new(15, 30)!.since(datetime.Time.new(3, 24, 30, 3500)!), datetime.Time.new(22, 30)!.since(datetime.Time.new(1, 0)!), datetime.Time.new(22, 0)!.since(t))
  print(datetime.Time.new(15, 45, 10, 123_456_789)!.round(seconds: 1), datetime.Time.new(15, 45, 10, 500_000_001)!.round(seconds: 1), datetime.Time.new(15, 45, 10, 999_999_999)!.round(seconds: 1), datetime.Time.new(15, 45, 10, 999_999_999)!.floor(seconds: 1), datetime.Time.new(15, 27, 29, 999_999_999)!.round(minutes: 5), datetime.Time.new(15, 27, 30)!.round(minutes: 5), last.round(hours: 1), datetime.Time.new(16, 27, 29, 999_999_999)!.floor(hours: 3), datetime.Time.new(16, 27, 29, 999_999_999)!.round(hours: 3))

test "datetime examples", '''
  2024-06-19T15:22:45 2016-12-31T23:59:59 true 2024-03-03T15:45:00
  2024 2 29 21 30 5 123456789 range range range
  2024-11-30T00:00:00 2024-07-31T00:00:00 2023-12-31T12:00:00 2024-12-31T12:00:00 range range
  2016-04-07T03:24:30.000004 2019-02-28T15:30:00 2024-02-29T19:05:59.999999999 range range
  2024-03-01T01:00:00 2024-02-27T23:00:00
  4542 22h 30m 8456 12h 5m 29s 999ms 996us 500ns 23 1 24 1 29 2024-03-03T00:00:00 60
  2024-06-20T00:00:00 2024-06-19T00:00:00 2024-06-19T00:00:00 2024-06-19T15:25:00 2024-06-19T15:30:00 9999-12-31T00:00:00 -009999-01-01T00:00:00 2024-06-20T16:25:00 2024-06-20T16:24:59 2024-06-19T15:00:00
'''
  # jiff civil/datetime.rs:43, 81 (text), 96 (order), 120 (a week later),
  # 197 (`round`), 277, 294 (`new`), 427, 3700, 3724 (`with`; day of year
  # is not Rig's: Dec 31 by `with(month: 12, day: 31)`), 1609 to 1665
  # (`checked_add`), 1892, 1917, 1968, 2022 (`until` and `since`: the
  # counts, the recipe of §6.4, and a `Duration`), 2221 to 2297 (`round`
  # and `floor`, `days: 1`, the ends), 3399, 3418 (`DateTimeRound`).
  fun step(dt: datetime.DateTime, years: Int) -> String
    r = dt.checked_add(years: years) catch return String("range")
    String(r)

  fun try_dt(y: Int, m: Int, d: Int, h: Int, mi: Int, s: Int, ns: Int) -> String
    r = datetime.DateTime.new(y, m, d, h, mi, s, ns) catch return String("range")
    String(r)

  fun change(dt: datetime.DateTime, year: Int? = none, month: Int? = none, day: Int? = none) -> String
    r = dt.with(year: year, month: month, day: day) catch return String("range")
    String(r)

  print(datetime.DateTime.parse("2024-06-19 15:22:45")!, datetime.DateTime.parse("2016-12-31 23:59:60")!, datetime.DateTime.new(2024, 3, 11, 1, 25, 15)! < datetime.DateTime.new(2025, 1, 31, 0, 30)!, datetime.DateTime.new(2024, 2, 25, 15, 45)!.add(weeks: 1))
  n = datetime.DateTime.new(2024, 2, 29, 21, 30, 5, 123_456_789)!
  print(n.year(), n.month(), n.day(), n.hour(), n.minute(), n.second(), n.nanosecond(), try_dt(2023, 2, 29, 21, 30, 5, 0), try_dt(2015, 6, 30, 23, 59, 60, 0), try_dt(2024, 6, 20, 19, 58, 0, 1_000_000_000))
  print(change(datetime.DateTime.new(2024, 10, 31)!, month: 11, day: 30), change(datetime.DateTime.new(2024, 4, 30)!, day: 31, month: 7), change(datetime.DateTime.new(2023, 1, 1, 12)!, month: 12, day: 31), change(datetime.DateTime.new(2024, 1, 1, 12)!, month: 12, day: 31), change(datetime.DateTime.new(2024, 11, 30, 15, 30)!, day: 31), change(datetime.DateTime.new(2024, 2, 29, 15, 30)!, year: 2023))
  e = datetime.DateTime.new(1995, 12, 7, 3, 24, 30, 3_500)!
  m31 = datetime.DateTime.new(2024, 3, 31, 13, 13, 13, 13)!
  print(e.add(ns: 500, years: 20, months: 4), datetime.DateTime.new(2019, 1, 31, 15, 30)!.add(months: 1), datetime.DateTime.new(2024, 3, 31, 19, 5, 59, 999_999_999)!.add(months: -1), step(m31, 9000), step(m31, -19000))
  f = datetime.DateTime.new(2024, 2, 29)!
  print(f.checked_add(hours: 25)!, f.checked_add(hours: -25)!)
  early = datetime.DateTime.new(2006, 8, 24, 22, 30)!
  late = datetime.DateTime.new(2019, 1, 31, 21)!
  b = datetime.DateTime.new(2019, 1, 31, 15, 30)!
  nb = b.days_since(e)
  d0 = e.date()
  mb = d0.add(days: nb).months_since(d0)
  x = datetime.DateTime.new(2024, 3, 2)!
  y = datetime.DateTime.new(2024, 5, 1)!
  mx = y.months_since(x)
  print(late.days_since(early), late.since(early.add(days: late.days_since(early))), nb, b.since(e.add(days: nb)), mb / 12, mb % 12, d0.add(days: nb).days_since(d0.add(months: mb)), mx, y.date().days_since(x.date().add(months: mx)), y.add(months: -mx, days: -y.date().days_since(x.date().add(months: mx))), y.days_since(x))
  r = datetime.DateTime.parse("2024-06-20 16:24:59.5")!
  print(datetime.DateTime.new(2024, 6, 19, 15)!.round(days: 1), datetime.DateTime.new(2024, 6, 19, 10)!.round(days: 1), datetime.DateTime.new(2024, 6, 19, 15)!.floor(days: 1), datetime.DateTime.new(2024, 6, 19, 15, 27, 29, 999_999_999)!.round(minutes: 5), datetime.DateTime.new(2024, 6, 19, 15, 27, 30)!.round(minutes: 5), datetime.DateTime.new(9999, 12, 31, 23, 59, 59, 999_999_999)!.floor(days: 1), datetime.DateTime.new(-9999, 1, 1, 0, 0, 0, 1)!.floor(days: 1), r.round(seconds: 1), r.floor(seconds: 1), datetime.DateTime.new(2024, 6, 19, 16, 27, 29, 999_999_999)!.round(hours: 3))

test "weekday examples", '''
  Monday 1 Sunday 7 true
'''
  # jiff civil/weekday.rs, `Weekday` (its order) and
  # `to_monday_one_offset`, which is Rig's `iso_number`; the other offsets
  # and the arithmetic on weekdays are not Rig's (§4.1).
  print(datetime.Weekday.monday, datetime.Weekday.monday.iso_number(), datetime.Weekday.sunday, datetime.Weekday.sunday.iso_number(), datetime.Weekday.monday < .sunday)

test "type-level examples: text, order, sums, counts", '''
  2024-06-19 true 2024-03-03 7 0 2 8
  21h 30m 1h 49m 59s 990
  2024-06-19T15:22:45 true 2024-03-03T15:45:00 68 16h 30m 2 8
  2024-06-20T03:26:00 03:26:00 03:20:00 2024-06-20T03:20:00
'''
  # jiff civil/date.rs:37, 73, 96, 108, 120 (`Date`: text, order, a week
  # later, days between, years and months between); time.rs:143, 158,
  # 1374 (`Time`'s differences, a `Duration`); datetime.rs:43, 96, 120,
  # 132, 147 (`DateTime`'s; where Jiff's `since` measures back from the
  # later value, 2 months 7 days, Rig counts forward from the earlier,
  # 2 months 8 days, §9 item 3); and the rounding builders' examples,
  # time.rs:2702, 2776 and datetime.rs:3468, 3548. The rounded
  # differences (date.rs:135, time.rs:173, datetime.rs:162) and the modes
  # Rig lacks (`Ceil`, time.rs:2730, datetime.rs:3499) are left out.
  fun md(a: datetime.Date, b: datetime.Date) -> String
    m = a.months_since(b)
    `{m} {a.days_since(b.add(months: m))}`

  d1 = datetime.Date.new(2024, 5, 3)!
  d2 = datetime.Date.new(2024, 2, 25)!
  print(datetime.Date.parse("2024-06-19")!, datetime.Date.new(2024, 3, 11)! < datetime.Date.new(2025, 1, 31)!, datetime.Date.new(2024, 2, 25)!.add(weeks: 1), datetime.Date.new(2024, 3, 3)!.days_since(d2), d1.years_since(d2), md(d1, d2))
  print(datetime.Time.new(22, 30)!.since(datetime.Time.new(1, 0)!), datetime.Time.new(22, 0)!.since(datetime.Time.new(20, 10, 1)!), datetime.Time.new(23, 30)!.since(datetime.Time.new(7, 0)!).minutes())
  a = datetime.DateTime.new(2024, 5, 3, 23, 30)!
  b = datetime.DateTime.new(2024, 2, 25, 7)!
  n = a.days_since(b)
  print(datetime.DateTime.parse("2024-06-19 15:22:45")!, datetime.DateTime.new(2024, 3, 11, 1, 25, 15)! < datetime.DateTime.new(2025, 1, 31, 0, 30)!, datetime.DateTime.new(2024, 2, 25, 15, 45)!.add(weeks: 1), n, a.since(b.add(days: n)), a.months_since(b), b.date().add(days: n).days_since(b.date().add(months: a.months_since(b))))
  print(datetime.DateTime.new(2024, 6, 20, 3, 25, 30)!.round(minutes: 1), datetime.Time.new(3, 25, 30)!.round(minutes: 1), datetime.Time.parse("03:24:59")!.round(minutes: 10), datetime.DateTime.parse("2024-06-20 03:24:59")!.round(minutes: 10))

test "readers, joining, and with by field", '''
  13 35 56 123456789 0 0 0 0
  2024-06-06T06:00:00 2010-03-14T02:30:00 2024-03-14 18:45:00 2024-02-29T21:30:05.123456789
  3 3 3 123 2017-10-31T15:30:00 2005-11-05T23:59:59.123456789 2007 6 range 10 range
'''
  # jiff civil/time.rs:394 to 503 (`hour` to `subsec_nanosecond`, which is
  # Rig's `nanosecond()`; Jiff's `millisecond`, `microsecond`, and
  # three-digit `nanosecond` are not Rig's, §2), 341 (`midnight`);
  # datetime.rs:398, 549, 1233, 1248 (`from_parts`, `at`, `date`, `time`),
  # 343, 360 (`constant`, which is `new`); time.rs:2975 to 3176 and
  # datetime.rs:3748 to 4386 (`with` by field: `hour`, `minute`,
  # `second`, and `ns:` for the whole fraction; the date and the time
  # replaced at once are `d.at(t)` and `dt.date().at(t)`).
  fun change(dt: datetime.DateTime, year: Int? = none, month: Int? = none, day: Int? = none) -> String
    r = dt.with(year: year, month: month, day: day) catch return String("range")
    String(r)

  t = datetime.Time.new(13, 35, 56, 123_456_789)!
  m = datetime.Time.new(0, 0)!
  print(t.hour(), t.minute(), t.second(), t.nanosecond(), m.hour(), m.minute(), m.second(), m.nanosecond())
  dt = datetime.Date.new(2024, 3, 14)!.at(datetime.Time.new(18, 45)!)
  print(datetime.Date.new(2024, 6, 6)!.at(datetime.Time.new(6, 0)!), datetime.Date.new(2010, 3, 14)!.at(datetime.Time.new(2, 30)!), dt.date(), dt.time(), datetime.DateTime.new(2024, 2, 29, 21, 30, 5, 123_456_789)!)
  e = datetime.DateTime.new(2005, 11, 5, 15, 30)!
  w = datetime.Time.new(15, 21, 59)!
  print(w.with(hour: 3)!.hour(), w.with(minute: 3)!.minute(), w.with(second: 3)!.second(), w.with(ns: 123)!.nanosecond(), datetime.Date.new(2017, 10, 31)!.at(e.time()), e.date().at(datetime.Time.new(23, 59, 59, 123_456_789)!), e.with(year: 2007)!.year(), e.with(month: 6)!.month(), change(datetime.DateTime.new(2024, 2, 29, 1, 30)!, year: 2023), datetime.DateTime.new(2024, 2, 5, 21, 59, 1, 999)!.with(day: 10)!.day(), change(datetime.DateTime.new(2023, 9, 5, 22, 58, 58, 9_999)!, day: 31))

test "datetime readers", '''
  2024 -2024 0 3 29 3 4 5 Thursday 4
  236 365 366 29 28 31 2024-02-01 2024-02-29
'''
  # jiff civil/datetime.rs:451, 515, 532, 549, 566, 583, 703, 727, 857
  # (the readers of a `DateTime`); 821 and 838 (`first_of_month` and
  # `last_of_month`, which Rig has on the date, `dt.date()`).
  fun at(y: Int, m: Int, d: Int) -> datetime.DateTime
    datetime.DateTime.new(y, m, d, 7, 30) catch panic("no such date")

  x = datetime.DateTime.new(2000, 1, 2, 3, 4, 5, 123_456_789)!
  print(at(2024, 3, 9).year(), at(-2024, 3, 9).year(), at(0, 3, 9).year(), at(2024, 3, 9).month(), at(2024, 2, 29).day(), x.hour(), x.minute(), x.second(), at(1970, 1, 1).weekday(), at(1970, 1, 1).weekday().iso_number())
  print(at(2006, 8, 24).day_of_year(), at(2023, 12, 31).day_of_year(), at(2024, 12, 31).day_of_year(), at(2024, 2, 10).days_in_month(), at(2023, 2, 10).days_in_month(), at(2024, 8, 15).days_in_month(), at(2024, 2, 29).date().first_of_month(), at(2024, 2, 5).date().last_of_month())
