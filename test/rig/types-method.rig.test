# types: tests whose names start `method`.

fail "method body return type", "type mismatch: expected `?String`, got `Int`"
  # Method bodies are type-checked against the declared return type.

  obj User
    name: ?String

    fun greet(?@) -> ?String
      42

  u = User(name: "Steve")
  print(u.greet())

fail "method consume through view", "cannot consume through a view"
  # A consuming method cannot be called on a viewed value, even when the
  # view comes from a call's `?User` result. (A view of a value that copies
  # is copied out instead.)

  obj User
    name: String

    sub consume(<@)
      print(@name)

  fun get_ref(u: ?User) -> ?User
    u

  u = User(name: String("Steve"))
  get_ref(?u).consume()

fail "method consume without move", "method `consume` consumes the receiver; write `<u.consume()`"
  # A method that consumes self (`<@`), called on a value that moves,
  # needs an explicit move at the call site: `<u.consume()`, not
  # `u.consume()`. (A receiver whose value copies is taken as a copy, as
  # an argument is.)

  obj User
    name: String

    sub consume(<@)
      print(@name)

  u = User(name: String("Steve"))
  u.consume()

test "method consumes self", "Steve"
  # A method that takes self by value (`<@`) consumes it; the call site
  # must spell the move as `<u.consume()`.

  obj User
    name: ?String

    sub consume(<@)
      print(@name)

  u = User(name: "Steve")
  <u.consume()

fail "method member without self", "11:5: use of unbound name `age`; did you mean `@age`?", "14:5: use of unbound name `double`; did you mean `@double(...)`?", "17:5: `get` takes no self: write `fun get(?@)`, `(!@)`, or `(<@)`"
  # Inside a method, a field or another method is reached through self:
  # a bare name is unbound, and the message names `@`.

  obj Person
    age: Int

    fun double(?@) -> Int
      @age * 2

    fun older(?@) -> Int
      age + 1

    fun quad(?@) -> Int
      double() * 2

    fun get() -> Int
      @age

  p = Person(age: 3)
  print(p.older(), p.quad(), Person.get())

test "method on enum", '''
  true
  false
'''
  # Enums get instance methods with the same receiver rules as structs.

  enum Color
    red
    green
    blue

    fun is_red(?@) -> Bool
      match @
        .red => true
        .green => false
        .blue => false

  c1 = Color.red
  c2 = Color.blue
  print(c1.is_red())
  print(c2.is_red())

fail "method on int", "type `Int` has no method `twice`"
  # Only nominal types have methods.

  x = 3
  print(x.twice())

test "method reads self", "Steve"
  # A `?@` method reads self; `u.greet()` lends `u` implicitly.

  obj User
    name: ?String

    fun greet(?@) -> ?String
      @name

  u = User(name: "Steve")
  print(u.greet())

fail "method self at dot", "7:5: a member of self is written `@name`, the name touching the `@`"
  # A member of self is `@n`, the name touching the `@`.

  obj P
    n: Int

    fun get(?@) -> Int
      @.n

fail "method self names nothing else", "6:3: `@` is a method's self and names nothing else", "8:5: `@` is a method's self and names nothing else", "11:7: `@` is a method's self and names nothing else", "15:3: `@` is a method's self and names nothing else", "16:8: `@` is a method's self and names nothing else", "17:7: `@` is a method's self and names nothing else"
  # `@` is a method's self: no field, function, parameter, local,
  # closure parameter, or loop binding is named `@`.

  obj P
    n: Int
    @: Int

  fun @() -> Int
    1

  fun f(@: Int) -> Int
    1

  sub main()
    @ = 1
    g = |@: Int| 1
    for @ in 0..2
      pass

fail "method self typed", "7:9: self takes no type: write `?@`, `!@`, or `<@`"
  # Self is written with its sigil, `?@`, `!@`, or `<@`, and no
  # type.

  obj P
    n: Int

    fun f(@: ?Self) -> Int
      1

test "method receivers on two types", '''
  Steve
  2
'''
  # Two nominal types each have a `@` method with a different return
  # type; each call's result is formatted by its own type.

  obj User
    name: ?String

    fun greet(?@) -> ?String
      @name

  enum Color
    red
    green
    blue

    fun code(?@) -> Int
      match @
        .red => 1
        .green => 2
        .blue => 3

  u = User(name: "Steve")
  c = Color.green
  print(u.greet())
  print(c.code())

fail "method reference generic or mismatch", "16:10: method `Wrap.get` of a generic type must be called", "17:22: type mismatch: expected `fun(Int) -> Int`, got `fun(?P) -> Int`"
  # A method of a generic type cannot be named as a value, and a method
  # value has the method's full signature, receiver first.

  obj Wrap[T]
    v: T

    fun get(?@) -> T
      @v

  obj P
    x: Int

    fun get(?@) -> Int
      @x

  g = Wrap.get
  f: fun(Int) -> Int = P.get

test "method reference value", '''
  P(x: 4)
  4
  5
  5
  15
  5
  drop 7
  7
'''
  # `Type.method` is a function value whose first parameter is the
  # receiver, however the method takes it.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  obj P
    x: Int

    fun make(x: Int) -> P
      P(x: x)

    fun get(?@) -> Int
      @x

    sub bump(!@)
      @x += 1

    fun total(<@, k: Int) -> Int
      @x + k

  obj H
    b: B

    fun take(<@) -> Int
      @b.n

  fun apply(f: fun(Int) -> P, x: Int) -> P
    f(x)

  fun read(f: fun(?P) -> Int, p: ?P) -> Int
    f(p)

  sub write(f: sub(!P), p: !P)
    f(!p)

  p = apply(P.make, 4)
  print(p)
  print(read(P.get, ?p))
  write(P.bump, !p)
  print(p.x)
  g = P.get
  print(g(?p))
  t: fun(P, Int) -> Int = P.total
  print(t(p, 10))
  fs = [P.get, P.get]
  print(fs[1](?p))
  h = H(b: B(n: 7))
  k = H.take
  print(k(<h))

test "method returns self", "guest"
  # An associated method (no `@`) returning `Self`; `User.make(...)`
  # types as `User`.

  obj User
    name: ?String

    fun make(default: ?String) -> Self
      User(name: default)

  u: User = User.make("guest")
  print(u.name)

test "method self as a name", "5 4"
  # `self` is an ordinary name: a parameter beside `@`, a
  # local, a closure's capture, and a binding of the program.

  obj P
    n: Int

    inline fun add(?@, self: Int) -> Int
      @n + self

    fun twice(?@) -> Int
      self = @n
      f = |?@, +self| @n + self
      f()

  self = P(n: 2)
  print(self.add(3), self.twice())

fail "method self second position", "self, `@`, must be the first parameter of a method"
  # `@` must be the first parameter of a method.

  obj User
    name: ?String

    fun bad(other: Int, ?@) -> Int
      other

  u = User(name: "x")
  print(u.bad(42))

fail "method self without sigil", "self is declared with how the method takes it"
  # A bare `@` parameter says nothing of how the method takes self:
  # write `?@`, `!@`, or `<@`.

  obj User
    name: ?String

    fun greet(@) -> ?String
      "hi"

  u = User(name: "Steve")
  print(u.greet())

fail "method static as instance", "method `make` takes no self; call as `User.make(...)`"
  # A method that takes no self can't be called on an instance.

  obj User
    name: ?String

    fun make(default: ?String) -> User
      User(name: default)

  u = User(name: "Steve")
  v = u.make()
  print(v.name)

test "method writes self", '''
  Steve
  Bob
'''
  # A `!@` method writes self; the call site must write the view
  # explicitly as `!u.modify(...)`. The body may read fields.

  obj User
    name: ?String

    sub modify(!@, new_name: ?String)
      print(@name)
      print(new_name)

  u = User(name: "Steve")
  !u.modify("Bob")

fail "method write without bang", "method `rename` needs its receiver lent to write"
  # A method that writes self (`!@`) needs its receiver lent to write
  # at the call: `!u.rename(...)`.

  obj User
    name: ?String

    sub rename(!@, new_name: ?String)
      print(new_name)

  u = User(name: "Steve")
  u.rename("Bob")
