test "ctfun arrays at the value limit", "8388610 2097152"
  fun bytes[n: Int] -> Int
    t = [n of U8(1)]
    t[n - 1] = 2
    t.len + Int(t[n - 1])

  fun ints[n: Int] -> Int
    t = [n of 0]
    u = t
    u.len + t.len

  print(bytes[8388608], ints[1048576])

fail "ctfun array past the value limit", "compile-time call `bytes[8388609]` makes an array of 8388609 bytes; a value takes at most 8388608 (8 MiB)"
  fun bytes[n: Int] -> Int
    t = [n of U8(1)]
    t.len

  print(bytes[8388609])
