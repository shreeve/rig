  sub main()
    print(sh[8])

test "ctfun arrays are values in branches", ''', whole: true
  1 1 [1, 2] 3
  1
'''
  fun f[n: Int] -> Int
    b = [1, 2]
    a = b if n > 0 else b
    a[0] = 9
    b[0]

  fun g[n: Int] -> Int
    b = [1, 2]
    a = match n
      0 => b
      _ => b
    a[0] = 9
    b[0]

  fun h[n: Int] -> [2]Int
    b = [1, 2]
    a = [b, b]
    a[0][0] = 9
    b

  fun k[n: Int] -> Int
    b = [[1, 2], [3, 4]]
    for _ in b
      pass
    c = b[0]
    c[1] = 7
    b[0][0] + b[0][1]

  sub main()
    print(f[1], g[1], h[1], k[1])
    b = [1, 2]
    a = b if 1 > 0 else b
    a[0] = 9
    print(b[0])

test "ctfun arrays are values in blocks and loops", "1 [1, 2] 1", whole: true
  # array-valued if, then mutate the source through the result
  fun f[n: Int] -> Int
    b = [1, 2]
    c = [3, 4]
    a = if n > 0
      b
    else
      c
    a[0] = 9
    b[0]

  fun g[n: Int] -> [2]Int
    b = [1, 2]
    a = b
    b[0] = 5
    a

  fun w[n: Int] -> Int
    b = [1, 2]
    a = while true
      break b
    a[0] = 9
    b[0]

  sub main()
    print(f[1], g[1], w[1])

test "ctfun discard", "1", whole: true
  fun f[n: Int] -> Int
    _ = n * 2
    n

  sub main()
    print(f[1])

test "ctfun memory counts what is live", "3000", whole: true
  fun g[n: Int] -> [n]Int
    t = [n of 0]
    for i in 0..n
      u = t
      t[i] = u.len
    t
  sub main()
    print(g[3000][0])

test "ctfun loop walks a large array in place", "1000000", whole: true
  fun f[k: Int] -> Int
    t = [k of [k of 1]]
    s = 0
    for r in t
      for x in r
        s += x
    s
  sub main()
    print(f[1000])

fail "ctfun limits ignore earlier calls", "6:17: compile-time call `a[300]` nests more than 256 compile-time calls", whole: true
  fun a[n: Int] -> Int
    if n > 0
      return a[n - 1] + 1
    n
  sub main()
    print(a[255], a[300])

test "ctfun result sized by the caller's parameter", "[1, 1, 1]", whole: true
  fun sq[n: Int] -> [n]Int
    [n of 1]
  fun mine[n: Int] -> [n]Int
    sq[n]
  sub main()
    print(mine[3])

test "ctfun imported, at every use", ''', whole: true
  [0, 1, 4, 9] [.strict, .loose] [0, 1, 4]
  [0, 1, 4] [0, 0, 0, 0] .strict [.strict, .loose, .loose] [[true, false], [true, false]]
  4 16 16 8
  .loose
'''
  use lib

  fun mine[n: Int] -> [n]Int
    t = [n of 0]
    t

  fun gen[T](x: T) -> Int
    s = lib.squares[5]
    s[4]

  sub main()
    lib.show()
    print(lib.squares[3], mine[4], lib.pick[true], lib.modes[3], lib.flags[2])
    a: [lib.usesN[1]]Int = [4 of 0]
    print(a.len, gen(1), gen(true), lib.usesN[2])
    m: lib.Mode = lib.pick[false]
    print(m)

  file "lib.rig"
    pub enum Mode
      loose
      strict

    pub N = 3

    pub fun squares[n: Int] -> [n]Int
      t = [n of 0]
      for i in 0..n
        t[i] = i * i
      t

    pub fun pick[b: Bool] -> Mode
      Mode.strict if b else Mode.loose

    pub fun modes[n: Int] -> [n]Mode
      m = [n of Mode.loose]
      m[0] = .strict
      m

    pub fun flags[n: U8] -> [n][2]Bool
      [n of [true, false]]

    fun hidden[n: Int] -> Int
      n

    pub fun usesN[k: Int] -> Int
      N * k + hidden[k]

    pub sub show()
      print(squares[4], modes[2], squares[3])

