test "ctfun alias of an enum with constant values as a parameter", "6 10 11", whole: true
  type M = Mode
  fun f[m: M] -> Int
    match m
      .a => K
      .b => K + 1
  enum Mode
    a = K * 2
    b
  K = 5
  sub main()
    print(f[.b], Int(Mode.a), Int(Mode.b))

