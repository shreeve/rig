test "ctfun enum method calls a function over its enum", "1 4", whole: true
  fun f[m: Mode] -> Int
    Int(m)
  enum Mode
    a = 1
    b = 2
  fun Mode.twice(?@) -> Int
    f[.b] * 2
  sub main()
    print(f[.a], Mode.a.twice())

test "ctfun enum methods and drop call a function over the enum", "1 4", whole: true
  fun f[m: Mode] -> Int
    Int(m)
  enum Mode
    a = 1
    b = 2
  fun Mode.twice(?@) -> Int
    f[.b] * 2
  sub Mode.drop(!@)
    print("drop")
  sub main()
    print(f[.a], Mode.a.twice())

