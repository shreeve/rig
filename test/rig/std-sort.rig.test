# std.sort: tests whose names start `sort`.
use std.random
use std.sort
use std.task

test "sort keeps equal keys in order through sort_by", "true"
  # Records of equal keys keep the order they had, at every size around
  # the merge's runs of 20, on random keys from few to many values.
  obj Rec
    key: Int
    id: Int

  fun stable(ps: []Rec) -> Bool
    for p, i in ps
      if i > 0
        q = ?ps[i - 1]
        if q.key > p.key or (q.key == p.key and q.id > p.id)
          return false
    true

  r = random.Random.seeded(11)
  ok = true
  for n in [0, 1, 2, 3, 19, 20, 21, 40, 41, 64, 100, 257, 1000, 3000]
    for spread in [1, 2, 8, 1000]
      ps: List[Rec] = List()
      for i in 0..n
        !ps.push(Rec(key: (!r).int(0, spread), id: i))
      sort.sort_by(!ps[..], |x, y| x.key < y.key)
      ok = ok and stable(?ps[..]) and ps.len == n
  print(ok)

test "sort keeps equal keys in order through sort_by_key", "true"
  obj Rec
    name: String
    id: Int

  fun stable(ps: []Rec) -> Bool
    for p, i in ps
      if i > 0
        q = ?ps[i - 1]
        if q.name > p.name or (q.name == p.name and q.id > p.id)
          return false
    true

  r = random.Random.seeded(12)
  ok = true
  for n in [0, 1, 2, 21, 100, 500]
    ps: List[Rec] = List()
    for i in 0..n
      k = (!r).int(0, 6)
      name: String = `k{k}`
      !ps.push(Rec(name: <name, id: i))
    sort.sort_by_key(!ps[..], |p| +p.name)
    ok = ok and stable(?ps[..]) and ps.len == n
  print(ok)

test "sort keeps equal elements of an own order in order", '''
  [1, 1, 1, 2, 2, 3]
  ["c", "a", "e", "b", "f", "d"]
  true
'''
  # `Key` orders by `n` alone, so two keys `<` finds equal can differ in
  # `tag`: `sort` keeps them in the order they had, as it does an object
  # whose derived order reaches such a key.
  obj Key: Ord
    n: Int
    tag: String
    id: Int

    fun order(?@, other: ?Key) -> Order
      @n.order(?other.n)

  obj Outer: Ord
    k: Key

  ks = [Key(n: 2, tag: String("b"), id: 0), Key(n: 1, tag: String("c"), id: 0), Key(n: 3, tag: String("d"), id: 0), Key(n: 1, tag: String("a"), id: 0), Key(n: 2, tag: String("f"), id: 0), Key(n: 1, tag: String("e"), id: 0)]
  sort.sort(!ks)
  print([ks[0].n, ks[1].n, ks[2].n, ks[3].n, ks[4].n, ks[5].n])
  print([+ks[0].tag, +ks[1].tag, +ks[2].tag, +ks[3].tag, +ks[4].tag, +ks[5].tag])

  r = random.Random.seeded(13)
  os: List[Outer] = List()
  for i in 0..300
    !os.push(Outer(k: Key(n: (!r).int(0, 5), tag: String("t"), id: i)))
  sort.sort(!os[..])
  ok = true
  for o, i in ?os[..]
    if i > 0
      p = ?os[i - 1]
      if p.k.n > o.k.n or (p.k.n == o.k.n and p.k.id > o.k.id)
        ok = false
  print(ok)

test "sort orders plain values at every size and pattern", "true"
  # Ints, text, plain enums, and objects ordered by their fields (all of
  # which `sort` sorts without keeping equal ones' order, since it cannot
  # be seen) against an insertion sort, on random, sorted, reversed,
  # sawtooth, organ-pipe, all-equal, and few-valued input.
  enum Size: Ord
    small
    medium
    large

  obj Pt: Ord
    x: Int
    name: ?String

  sub reference(xs: ![]Int)
    i = 1
    while i < xs.len : i += 1
      j = i
      while j > 0 and xs[j] < xs[j - 1] : j -= 1
        !xs.swap(j, j - 1)

  fun same(a: []Int, b: []Int) -> Bool
    if a.len != b.len
      return false
    for x, i in a
      if x != b[i]
        return false
    true

  fun make(n: Int, pattern: Int, r: !random.Random) -> List[Int]
    v: List[Int] = List()
    for i in 0..n
      x = 0
      if pattern == 0
        x = !r.int(-1000000, 1000000)
      else if pattern == 1
        x = i
      else if pattern == 2
        x = n - i
      else if pattern == 3
        x = i % 17
      else if pattern == 4
        x = i if i < n / 2 else n - i
      else if pattern == 5
        x = 7
      else if pattern == 6
        x = !r.int(0, 4)
      else
        x = i if i % 64 != 0 else !r.int(0, n + 1)
      !v.push(x)
    v

  names = ["a", "b", "c", "d"]
  r = random.Random.seeded(14)
  ok = true
  for n in [0, 1, 2, 3, 7, 8, 24, 25, 49, 50, 51, 64, 65, 100, 129, 1000, 4000]
    for pattern in 0..8
      v = make(n, pattern, !r)
      want = make(0, 0, !r)
      for x in ?v
        !want.push(x)
      reference(!want[..])
      sort.sort(!v[..])
      ok = ok and same(?v[..], ?want[..])

      texts: List[String] = List()
      for x in ?want
        t: String = `{x + 2000000}`
        !texts.push(<t)
      (!r).shuffle(!texts[..])
      sort.sort(!texts[..])
      for i in 1..texts.len
        if texts[i - 1] > texts[i]
          ok = false

      sizes: List[Size] = List()
      pts: List[Pt] = List()
      for x in ?v
        !sizes.push(Size.large if x % 3 == 0 else Size.small if x % 3 == 1 else Size.medium)
        !pts.push(Pt(x: x % 5, name: names[((x / 5) % 4 + 4) % 4]))
      (!r).shuffle(!sizes[..])
      (!r).shuffle(!pts[..])
      sort.sort(!sizes[..])
      sort.sort(!pts[..])
      for i in 1..sizes.len
        if sizes[i - 1] > sizes[i] or pts[i - 1] > pts[i]
          ok = false
  print(ok)

test "sort matches a reference on random input", "true", seeds: 4
  # Many sizes and value ranges, against an insertion sort, for `sort`
  # and for `sort_by` with a reversed order.
  sub reference(xs: ![]Int)
    i = 1
    while i < xs.len : i += 1
      j = i
      while j > 0 and xs[j] < xs[j - 1] : j -= 1
        !xs.swap(j, j - 1)

  r = random.Random.new()
  ok = true
  for _ in 0..40
    n = (!r).int(0, 600)
    spread = (!r).int(1, 2000)
    v: List[Int] = List()
    want: List[Int] = List()
    down: List[Int] = List()
    for _ in 0..n
      x = (!r).int(0, spread)
      !v.push(x)
      !want.push(x)
      !down.push(x)
    reference(!want[..])
    sort.sort(!v[..])
    sort.sort_by(!down[..], |a, b| a > b)
    for x, i in ?v[..]
      ok = ok and x == want[i] and down[n - 1 - i] == x
  print(ok)

test "sort of owned text drops nothing twice", '''
  ["", "a", "a", "ab", "b", "ba"]
  ["ba", "b", "ab", "a", "a", ""]
'''
  # Owned Strings are swapped, never copied: the run is clean under the
  # sanitizer and the leak check.
  xs = [String("b"), String("a"), String(""), String("ba"), String("a"), String("ab")]
  sort.sort(!xs)
  print(xs)
  sort.sort_by(!xs, |a, b| a > b)
  print(xs)

test "sort of many Ints", "true", release: true
  # Large enough for every path of both quicksorts: Ints through the
  # integer kernel, and objects ordered by an Int through
  # pattern-defeating quicksort, with its block partitions, its split of
  # equal elements, and sorted and reversed runs found in one pass.
  obj Key: Ord
    k: Int

  r = random.Random.seeded(15)
  ok = true
  for pattern in 0..4
    v: List[Int] = List()
    keys: List[Key] = List()
    for i in 0..200000
      x = (!r).int(0, 1 << 40)
      if pattern == 1
        x = i
      else if pattern == 2
        x = -i
      else if pattern == 3
        x = (!r).int(0, 10)
      !v.push(x)
      !keys.push(Key(k: x))
    sort.sort(!v[..])
    sort.sort(!keys[..])
    for x, i in ?v[..]
      if i > 0 and (v[i - 1] > x or keys[i - 1].k > keys[i].k)
        ok = false
      if keys[i].k != x
        ok = false
  print(ok)

test "sort of integers agrees with the stable sort at every width, size, and pattern", "true", release: true
  # Integers sort by their own kernel (std/sort.zig, `unstable_int`):
  # here against the stable merge by `<`, at every width, signed and
  # unsigned, with each type's least and greatest values. Lengths lie on
  # both sides of the networks (9, 13), the merge of two (18), the small
  # sort (32), the pseudomedian (64), and a yield check's budget
  # (16,384); patterns random, few-valued, rising, falling, sawtooth,
  # organ pipe, all equal, and extremes.
  fun agrees[T: Ord + Copy](xs: ![]T) -> Bool
    want: List[T] = List()
    for x in ?xs
      !want.push(x)
    sort.sort_by(!want[..], |a, b| a < b)
    sort.sort(!xs)
    for x, i in ?xs
      if x != want[i]
        return false
    true

  fun bits(r: !random.Random, pattern: Int, i: Int, n: Int) -> U64
    return (!r).next() if pattern == 0
    return U64((!r).int(0, 4)) if pattern == 1
    return U64(i) if pattern == 2
    return U64(n - i) if pattern == 3
    return U64(i % 37) if pattern == 4
    return U64(i if i < n / 2 else n - i) if pattern == 5
    return 5 if pattern == 6
    c = (!r).int(0, 4)
    0 if c == 0 else U64.max if c == 1 else U64(1) << 63 if c == 2 else (U64(1) << 63) - 1

  r = random.Random.seeded(3)
  ok = true
  for n in [0, 1, 2, 3, 8, 9, 12, 13, 17, 18, 19, 31, 32, 33, 63, 64, 65, 100, 1000, 16383, 16384, 16385, 40000, 200000]
    for pattern in 0..8
      a: List[U8] = List()
      b: List[I8] = List()
      c: List[U16] = List()
      d: List[I16] = List()
      e: List[U32] = List()
      f: List[I32] = List()
      g: List[U64] = List()
      h: List[Int] = List()
      u: List[U128] = List()
      v: List[I128] = List()
      for i in 0..n
        x = bits(!r, pattern, i, n)
        y = bits(!r, pattern, i, n)
        !a.push(U8.wrap(x))
        !b.push(I8.wrap(x))
        !c.push(U16.wrap(x))
        !d.push(I16.wrap(x))
        !e.push(U32.wrap(x))
        !f.push(I32.wrap(x))
        !g.push(x)
        !h.push(Int.wrap(x))
        !u.push(U128(x) << 64 | U128(y))
        !v.push(I128.wrap(U128(x) << 64 | U128(y)))
      ok = ok and agrees(!a[..]) and agrees(!b[..]) and agrees(!c[..]) and agrees(!d[..]) and agrees(!e[..])
      ok = ok and agrees(!f[..]) and agrees(!g[..]) and agrees(!h[..]) and agrees(!u[..]) and agrees(!v[..])
  print(ok)

test "sort of integers in tasks sorts through its yield checks", "true true", seeds: 20
  # In a seeded run the integer kernel checks every 16,384 elements, as
  # a loop checks every 1,024 turns, and a seed may yield at each: two
  # tasks sort on one worker, taking turns mid-sort.
  fun sorted(seed: U64, spread: Int) -> Bool
    r = random.Random.seeded(seed)
    xs: List[I32] = List()
    for _ in 0..100000
      !xs.push(I32((!r).int(0, spread)))
    sort.sort(!xs[..])
    for i in 1..xs.len
      if xs[i - 1] > xs[i]
        return false
    true

  a = sorted(1, 1 << 30)&
  b = sorted(2, 7)&
  print(>a, >b)

test "sort of integers yields to a local task at its checks", "2 1"
  # Local tasks take turns on one thread at their yield checks: the
  # watcher, waiting for the sort to start, runs while it sorts, at the
  # kernel's checks, and the sorter sees its mark as the sort returns.
  obj Node
    v: Int

  fun sorter(n: ?*Node, c: *Cell[Int], xs: List[Int]) -> Int
    new xs = <xs
    !c.add(1)
    sort.sort(!xs[..])
    seen = c.get()
    for i in 1..xs.len
      if xs[i - 1] > xs[i]
        return -1
    seen + n.v - 1

  fun watcher(n: ?*Node, c: *Cell[Int]) -> Int
    spins = 0
    while c.get() == 0
      spins += 1
    !c.add(1)
    n.v + spins % 1

  task.workers(1)
  r = random.Random.seeded(5)
  xs: List[Int] = List()
  for _ in 0..200000
    !xs.push((!r).int(0, 1000000))
  n = *Node(v: 1)
  c = *Cell(0)
  w = watcher(?n, +c)&
  s = sorter(?n, +c, <xs)&
  print(>s, >w)

test "sort compares objects by their fields as order does", "true"
  # `<` and its kin on an object ordered by its fields agree with
  # `order` on every field kind: numbers, Bool, plain enums, text, an
  # optional, and a nested object with an order of its own.
  enum Tone: Ord
    low
    high

  obj Inner: Ord
    n: Int

    fun order(?@, other: ?Inner) -> Order
      other.n.order(?@n)

  obj Mix: Ord
    a: Int
    b: Bool
    t: Tone
    s: ?String
    o: Int?
    i: Inner
    u: U8

  r = random.Random.seeded(16)
  words = ["", "a", "b"]
  ms: List[Mix] = List()
  for _ in 0..200
    o: Int? = none
    if (!r).int(0, 2) == 1
      o = (!r).int(0, 2)
    !ms.push(Mix(a: (!r).int(0, 2), b: (!r).int(0, 2) == 1, t: Tone.low if (!r).int(0, 2) == 0 else Tone.high, s: words[(!r).int(0, 3)], o: o, i: Inner(n: (!r).int(0, 2)), u: U8((!r).int(0, 2))))
  ok = true
  for x in ?ms
    for y in ?ms
      ord = x.order(?y)
      ok = ok and (x < y) == (ord == .less) and (x > y) == (ord == .greater)
      ok = ok and (x <= y) == (ord != .greater) and (x >= y) == (ord != .less)
  sort.sort(!ms[..])
  for i in 1..ms.len
    ok = ok and not (ms[i] < ms[i - 1])
  print(ok)

test "sort orders an enum whose variants carry fields", "true"
  # Its payloads are numbers and text, so equal values are the same and
  # `sort` takes the quicksort; the stable merge of `sort_by` agrees.
  enum Shape: Ord
    dot
    circle(r: Int)
    label(text: ?String, size: Int)

  r = random.Random.seeded(7)
  words = ["", "a", "b"]
  xs: List[Shape] = List()
  for _ in 0..3000
    k = (!r).int(0, 3)
    if k == 0
      !xs.push(Shape.dot)
    else if k == 1
      !xs.push(Shape.circle(r: (!r).int(0, 4)))
    else
      !xs.push(Shape.label(text: words[(!r).int(0, 3)], size: (!r).int(0, 3)))
  ys: List[Shape] = List()
  for x in ?xs
    !ys.push(x)
  sort.sort(!xs[..])
  sort.sort_by(!ys[..], |a, b| a < b)
  ok = xs.len == ys.len
  for i in 0..xs.len
    ok = ok and xs[i] == ys[i]
  print(ok)

test "sort keeps equal keys in order through the merge at every size and pattern", "true"
  # Records of equal keys keep the order they had at the sizes around
  # the runs of 32 and the room's first merge, on random, sorted,
  # reversed, 16-valued, sawtooth, and organ-pipe keys; `sort_by` with
  # a reversed order too, which keeps equal keys in order all the same.
  obj Rec
    key: Int
    id: Int

  fun stable(ps: []Rec, down: Bool) -> Bool
    for p, i in ps
      if p.id < 0
        return false
      if i > 0
        q = ?ps[i - 1]
        if (q.key > p.key if not down else q.key < p.key) or (q.key == p.key and q.id > p.id)
          return false
    true

  r = random.Random.seeded(21)
  ok = true
  for n in [0, 1, 2, 20, 21, 31, 32, 33, 63, 64, 65, 100, 1000, 4096]
    for pattern in 0..6
      for down in [false, true]
        ps: List[Rec] = List()
        for i in 0..n
          k = (!r).int(0, 1 << 40)
          if pattern == 1
            k = i
          else if pattern == 2
            k = n - i
          else if pattern == 3
            k = (!r).int(0, 16)
          else if pattern == 4
            k = i % 37
          else if pattern == 5
            k = i if i < n / 2 else n - i
          !ps.push(Rec(key: k, id: i))
        if down
          sort.sort_by(!ps[..], |x, y| x.key > y.key)
        else
          sort.sort_by(!ps[..], |x, y| x.key < y.key)
        ok = ok and ps.len == n and stable(?ps[..], down)
  print(ok)

test "sort keeps equal keys in order through the quicksort at every size to 33 and at 2^10 and 2^16", "true"
  # Records with no long runs reach the stable quicksort (from 65
  # elements; the small sort and its sorting networks below), whose
  # partitions keep each side in order, and few-valued keys take its
  # split of the elements equal to the last pivot. Sawtooth keys make
  # short runs that merge lazily, and a sorted half beside a random
  # half makes a sorted run merge with a quicksorted one.
  obj Rec
    key: Int
    id: Int

  fun stable(ps: []Rec) -> Bool
    for p, i in ps
      if i > 0
        q = ?ps[i - 1]
        if q.key > p.key or (q.key == p.key and q.id > p.id)
          return false
    true

  r = random.Random.seeded(23)
  ok = true
  sizes: List[Int] = List()
  for n in 0..34
    !sizes.push(n)
  !sizes.push(1 << 10)
  !sizes.push(1 << 16)
  for n in ?sizes
    for pattern in 0..6
      ps: List[Rec] = List()
      for i in 0..n
        k = (!r).int(0, 1 << 40)
        if pattern == 1
          k = (!r).int(0, 4)
        else if pattern == 2
          k = (!r).int(0, 16)
        else if pattern == 3
          k = i % 100
        else if pattern == 4
          k = i if i < n / 2 else (!r).int(0, n)
        else if pattern == 5
          k = 7
        !ps.push(Rec(key: k, id: i))
      sort.sort_by(!ps[..], |x, y| x.key < y.key)
      ok = ok and ps.len == n and stable(?ps[..])
  print(ok)

test "sort keeps every element when the comparator always or never says less", "true"
  # Always `true`: every partition puts all but its pivot below it, so
  # the quicksort runs out of partitions and finishes by merges. Never:
  # every element is equal to every pivot, and the order is kept. Each
  # element ends in the slice once either way.
  obj Tagged
    name: String
    id: Int

  ok = true
  for n in [21, 64, 65, 1000, 70000]
    for always in [true, false]
      ts: List[Tagged] = List()
      for i in 0..n
        name: String = `t{i}`
        !ts.push(Tagged(name: <name, id: i))
      sort.sort_by(!ts[..], |+always, a, b| always)
      seen: List[Bool] = List.filled(n, false)
      for t, i in ?ts
        want: String = `t{t.id}`
        ok = ok and t.name == want and not seen[t.id] and (always or t.id == i)
        seen[t.id] = true
  print(ok)

test "sort orders text by its bytes at every length", "true"
  # `<`, `<=`, `>`, and `>=` on text compare eight bytes at a time from
  # 8 bytes in common: texts of 0 to 24 letters that differ at each
  # letter, or one a prefix of the other, against the letters' codes
  # compared one by one.
  fun before(a: []Int, b: []Int) -> Bool
    n = a.len if a.len < b.len else b.len
    for i in 0..n
      if a[i] != b[i]
        return a[i] < b[i]
    a.len < b.len

  letters = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"]
  ok = true
  for n in 0..25
    ac: List[Int] = List()
    at: String = String()
    for i in 0..n
      !ac.push(i)
      !at.add(letters[i])
    for m in 0..25
      for d in 0..m + 1
        bc: List[Int] = List()
        bt: String = String()
        for i in 0..m
          c = i
          if i == d
            c = i + 1 if i % 2 == 0 else i + 2
          !bc.push(c)
          !bt.add(letters[c])
        lt = before(?ac[..], ?bc[..])
        gt = before(?bc[..], ?ac[..])
        ok = ok and (at < bt) == lt and (at > bt) == gt and (at <= bt) == (not gt) and (at >= bt) == (not lt)
  print(ok)

test "sort moves owned elements through the room and drops each once", '''
  true
  true
  true
'''
  # Strings, and objects holding Strings, are moved out to the room and
  # back by their bits: each ends in the slice once, as the sanitizer
  # and the leak check see; `sort_by_key` and `sort` by an own `order`
  # take the same merge.
  obj Tagged
    name: String
    id: Int

  obj Keyed: Ord
    tag: String
    id: Int

    fun order(?@, other: ?Keyed) -> Order
      @tag.order(?other.tag)

  r = random.Random.seeded(22)
  ok = true
  for n in [33, 100, 4096]
    texts: List[String] = List()
    for _ in 0..n
      t: String = `{(!r).int(0, 1000000) + 1000000}`
      !texts.push(<t)
    sort.sort_by(!texts[..], |a, b| a < b)
    for i in 1..texts.len
      ok = ok and texts[i - 1] <= texts[i]
  print(ok)

  ok2 = true
  for n in [33, 100, 4096]
    ts: List[Tagged] = List()
    for i in 0..n
      name: String = `t{(!r).int(0, 20)}`
      !ts.push(Tagged(name: <name, id: i))
    sort.sort_by_key(!ts[..], |t| +t.name)
    for i in 1..ts.len
      ok2 = ok2 and (ts[i - 1].name < ts[i].name or (ts[i - 1].name == ts[i].name and ts[i - 1].id < ts[i].id))
  print(ok2)

  ok3 = true
  for n in [33, 100, 4096]
    ks: List[Keyed] = List()
    for i in 0..n
      tag: String = `k{(!r).int(0, 16)}`
      !ks.push(Keyed(tag: <tag, id: i))
    sort.sort(!ks[..])
    for i in 1..ks.len
      ok3 = ok3 and (ks[i - 1].tag < ks[i].tag or (ks[i - 1].tag == ks[i].tag and ks[i - 1].id < ks[i].id))
  print(ok3)

test "sort keeps every element under a comparator that is no order", "true"
  # A `less` that contradicts itself orders nothing, but the merge still
  # moves each element exactly once: the slice holds what it held.
  obj Tagged
    name: String
    id: Int

  ok = true
  for n in [21, 33, 100, 4096]
    ts: List[Tagged] = List()
    for i in 0..n
      name: String = `t{i}`
      !ts.push(Tagged(name: <name, id: i))
    sort.sort_by(!ts[..], |a, b| (a.id * 7 + b.id * 3) % 5 < 2)
    seen: List[Bool] = List.filled(n, false)
    for t in ?ts
      want: String = `t{t.id}`
      ok = ok and t.name == want and not seen[t.id]
      seen[t.id] = true
  print(ok)

bomb "sort stops at a comparator's panic mid-partition with nothing dropped twice", "panic: compared too far", prints: "sorting"
  # The 4,096 Strings fit in the room, so the sort is one quicksort of
  # 44,169 comparisons, the first partition's 4,096 starting after some
  # 40 that choose its pivot: the panic comes midway through that
  # partition, with about half the Strings copied to the room and still
  # in the slice. A panic runs no drop, so neither copy is freed.
  xs: List[String] = List()
  for i in 0..4096
    t: String = `{(i * 7919) % 4096 + 10000}`
    !xs.push(<t)
  print("sorting")
  calls = *Cell(0)
  sort.sort_by(!xs[..], |+calls, a, b|
    !calls.set(calls.get() + 1)
    if calls.get() > 2000
      panic("compared too far")
    a < b
  )
  print("not reached")

test "sort stops at a comparator's panic in an isolate and the program goes on", '''
  Stop.panicked
  [1, 2, 3]
'''
  # The panic comes in the first partition, as in the case above; the
  # list, the room, and the Strings in both are left by the panic, not
  # leaked and not freed.
  use std.task

  fun sorted_texts() -> Int
    xs: List[String] = List()
    for i in 0..4096
      t: String = `{(i * 7919) % 4096 + 10000}`
      !xs.push(<t)
    calls = *Cell(0)
    sort.sort_by(!xs[..], |+calls, a, b|
      !calls.set(calls.get() + 1)
      if calls.get() > 2000
        panic("compared too far")
      a < b
    )
    xs.len

  task.isolate(|| sorted_texts()) catch |e|
    print(e)
    -1
  ys = [3, 1, 2]
  sort.sort_by(!ys, |a, b| a < b)
  print(ys)
