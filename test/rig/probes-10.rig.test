test "optwrite-review-l01-self-copy-ok", "a a a a"
  obj H
    s: ?String
    t: ?String

    sub keep(!@, v: ?String) keeps v
      @t = v

  sub set(w: (!H)?, g: (!H)?) keeps w
    x = <w ?? return
    !x.keep(x.s)
    y = <g ?? return
    !y.keep(x.s)
    y.s = x.t

  a = String("a")
  b = String("b")
  h = H(s: ?a, t: "")
  k = H(s: ?b, t: "")
  set(!h, !k)
  print(h.s, h.t, k.s, k.t)

test "own-m1", '''
  1
  5
  5
  3
'''
  obj P
    n: Int

  o: P? = P(n: 1)
  k = 0
  while ?o as x : print(x.n)
    k += 1
    o = P(n: 5) if k < 3 else none
  print(k)

fail "own-m1b", "`k` is assigned but never read; use it, or discard the value with `_ = ...`"
  obj P
    n: Int

  o: P? = P(n: 1)
  if ?o as x
    o = none
    print(x.n)
  k = 0
  while ?o as x
    o = none
    print(x.n)

test "own-m2slice", '''
  8
  5
'''
  obj R
    s: []Int

  obj In
    n: Int

  obj V
    b: ?In

  a = [1, 2]
  loc = [7, 8]
  rs = [R(s: ?a[..])]
  w = !rs[..]
  w[0] = R(s: ?loc[..])
  print(rs[0].s[1])
  x = In(n: 1)
  y = In(n: 5)
  vs = [V(b: ?x), V(b: ?x)]
  wv = !vs
  wv[1].b = ?y
  print(vs[1].b.n)

