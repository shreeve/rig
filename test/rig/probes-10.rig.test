    else if i % 3 == 0
      print("Fizz")
    else if i % 5 == 0
      print("Buzz")
    else
      print(i)

test "purity-newbie-fizzbuzz2", '''
  1
  2
  Fizz
  4
  Buzz
  Fizz
  7
  8
  Fizz
  Buzz
  11
  Fizz
  13
  14
  FizzBuzz
'''
  # FizzBuzz, variant: a function that returns the label.
  # No string building and no int->string, so the label is optional.
  fun label(n: Int) -> (?String)?
    if n % 15 == 0
      "FizzBuzz"
    else if n % 3 == 0
      "Fizz"
    else if n % 5 == 0
      "Buzz"
    else
      none

  for i in 1..16
    if label(i) as s
      print(s)
    else
      print(i)
