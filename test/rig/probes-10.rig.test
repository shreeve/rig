# Probes from past reviews and audits, 10 of 41: optwrite-review-a03-cross-plain-ok to purity-newbie-fizzbuzz2.

test "optwrite-review-a03-cross-plain-ok", "caller"
  obj H
    n: String

  obj G
    r: ?String

  sub set(w: !H, g: (!G)?) keeps w
    (g ?? return).r = ?w.n

  h = H(n: String("caller"))
  g = G(r: "")
  set(!h, !g)
  print(g.r)

fail "optwrite-review-a04-slice-opt", "cannot store a view of `d` in `x[0]`: `x` outlives it"
  sub set(w: (![]?String)?)
    d = String("local")
    x = <w ?? return
    x[0] = ?d

  t = String("outer")
  a = [?t, ?t]
  set(!a[..])
  print(a)

fail "optwrite-review-a05-slice-opt-direct", "cannot store a view of `d` through `w ?? return`: `w` outlives it"
  sub set(w: (![]?String)?)
    d = String("local")
    (w ?? return)[0] = ?d

  t = String("outer")
  a = [?t, ?t]
  set(!a[..])
  print(a)

fail "optwrite-review-a06-list-opt", "cannot let this call store a view of `d` in `w`: `w` outlives it"
  sub set(w: (!List[?String])?)
    d = String("local")
    x = <w ?? return
    !x.push(?d)

  t = String("outer")
  a: List[?String] = List()
  set(!a)
  print(a)

