    drop(!@)
      print("drop", @id)

  fun maybe(k: Int) -> N?
    N(id: k) if k > 0 else none

  a = maybe(1) ?? N(id: 10)
  b = maybe(0) ?? N(id: 20)
  o = maybe(3)
  c = <o ?? N(id: 30)
  y = N(id: 40)
