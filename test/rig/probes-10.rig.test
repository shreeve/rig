    n: String

  fun name(w: (!H)?) -> ?String
    x = <w ?? return ""
    ?x.n

  h = H(n: String("caller"))
  print(name(!h))

fail "optwrite-review-f01-owned-closure-clone-capture", "cannot store a view of `d` through `k ?? return`: `k` outlives it"
  obj H
    s: ?String

  fun mk() -> *sub((!H)?)
    d = String("local")
    *|+d, k| (k ?? return).s = ?d

  h = H(s: "x")
  g = mk()
  g(!h)
  <g
  print(h.s)

fail "optwrite-review-f01b-owned-closure-clone-plain", "cannot store a view of `d` in `k.s`: `k` outlives it"
  obj H
    s: ?String

  fun mk() -> *sub(!H)
    d = String("local")
    *|+d, k| k.s = ?d

  h = H(s: "x")
  g = mk()
  g(!h)
  <g
  print(h.s)

