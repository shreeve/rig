test "p-it", '''
  a b
  c
  x
  y
  Cut(before: "a", after: "b,c") a,b,c
  a,b,c!
'''
  fun find(s: ?String, pat: ?String) -> Int?
    i = 0
    while i + pat.len <= s.len
      if s[i..i + pat.len] == pat
        return i
      i += 1
    none

  obj Split
    rest: ?String
    sep: ?String
    done: Bool

    fun next(!@) -> (?String)?
      return none if @done
      at = find(@rest, @sep) ?? -1
      if at < 0
        @done = true
        return @rest
      part = @rest[..at]
      @rest = @rest[at + @sep.len..]
      part

  obj Lines
    rest: ?String

    fun next(!@) -> (?String)?
      return none if @rest.len == 0
      end = find(@rest, "\n") ?? -1
      if end < 0
        line = @rest
        @rest = ""
        return line
      line = @rest[..end]
      @rest = @rest[end + 1..]
      strip_suffix(line, "\r") ?? line

  obj Cut
    before: ?String
    after: ?String

  fun strip_suffix(s: ?String, suffix: ?String) -> (?String)?
    return none if suffix.len > s.len or s[s.len - suffix.len..] != suffix
    s[..s.len - suffix.len]

  fun cut(s: ?String, sep: ?String) -> Cut?
    i = find(s, sep)?
    Cut(before: s[..i], after: s[i + sep.len..])

  fun split(s: ?String, sep: ?String) -> Split
    Split(rest: s, sep: sep, done: false)

  fun trim(s: ?String) -> ?String
    s

  t = String("a,b,c")
  it = split(?t, ",")
  a = (!it).next()
  b = (!it).next()
  print(a, b)
  while (!it).next() as part
    print(part)
  c = cut(?t, ",")
  ls = Lines(rest: "x\r\ny")
  while (!ls).next() as l
    print(l)
  w = trim(?t)
  print(c, w)
  !t.add("!")
  print(t)

fail "p-it2", "cannot lend `t` to write while a read loan is live"
  fun trim(s: ?String) -> ?String
    s

  obj Split
    rest: ?String

    fun next(!@) -> (?String)?
      return none if @rest.len == 0
      part = @rest[..1]
      @rest = @rest[1..]
      part

  obj Cut
    before: ?String

  fun cut(s: ?String) -> Cut?
    Cut(before: s[..1])

  t = String("abc")
  w = trim(?t)
  !t.add("x")
  print(w)
  u = String("abc")
  it = Split(rest: ?u[..])
  a = (!it).next()
  <it
  !u.clear()
  print(a)
  v = String("v")
  c = cut(?v)
  <v
  print(c)
  x = String("xyz")
  o: (?String)? = ?x[1..]
  if o as s
    <x
    print(s)

