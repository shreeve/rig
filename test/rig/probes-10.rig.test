fail "optwrite-review-c02-closure-param-capture", "cannot store a view of `d` through `k ?? return`: `k` outlives it"
  obj H
    s: ?String

  sub set(w: (!H)?)
    d = String("local")
    f = |?d, k: (!H)?| (k ?? return).s = d
    f(<w)

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

fail "optwrite-review-c02b-closure-plain-capture", "cannot store a view of `d` in `k.s`: `k` outlives it"
  obj H
    s: ?String

  sub set(w: !H)
    d = String("local")
    f = |?d, k: !H| k.s = d
    f(<w)

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

fail "optwrite-review-c04-defer", "cannot store a view of `d` in `x.s`: `x` outlives it"
  obj H
    s: ?String

  sub set(w: (!H)?)
    x = <w ?? return
    d = String("local")
    defer x.s = ?d
    print("body")

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

fail "optwrite-review-c05-for-loop", "cannot store a view of `d` through `e`: `e` views `x`, which outlives it"
  obj H
    items: List[?String]

  sub set(w: (!H)?)
    d = String("local")
    x = <w ?? return
    for e in !x.items
      e = ?d

  t = String("outer")
  h = H(items: List())
  !h.items.push(?t)
  set(!h)
  print(h.items)

fail "optwrite-review-c08-swap-fields", "cannot let this call store a view of `k` in `w`: `w` outlives it"
  obj In
    s: ?String

  obj H
    inner: In

  sub set(w: (!H)?)
    d = String("local")
    x = <w ?? return
    k = In(s: ?d)
    swap(!x.inner, !k)

  t = String("outer")
  h = H(inner: In(s: ?t))
  set(!h)
  print(h.inner.s)

fail "optwrite-review-d01-generic-put", "cannot let this call store a view of `d` in `w`: `w` outlives it"
  obj In
    s: ?String

  sub put[T](w: (!T)?, v: T)
    x = <w ?? return
    x = v

  sub set(w: (!In)?)
    d = String("local")
    put(<w, In(s: ?d))

  t = String("outer")
  h = In(s: ?t)
  set(!h)
  print(h.s)

fail "optwrite-review-d03-owned-closure-call", "cannot let this call store a view of `d` in `w`: `w` outlives it"
  obj H
    s: ?String

  sub set(w: (!H)?, g: *sub((!H)?, ?String))
    d = String("local")
    g(<w, ?d)

  t = String("outer")
  h = H(s: ?t)
  g: *sub((!H)?, ?String) = *|k, v| (k ?? return).s = v
  set(!h, +g)
  print(h.s)

fail "optwrite-review-d11-or-local", "cannot store a view of `d` through `x`: `w` outlives it"
  obj H
    s: ?String

  sub set(w: (!H)?)
    k = H(s: "k")
    d = String("local")
    x = <w ?? !k
    x.s = ?d
    print(k.s)

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

fail "optwrite-review-d15-call-result-view", "cannot store a view of `d` through `inner(<w) ?? return`: `w` outlives it"
  obj In
    s: ?String

  obj H
    inner: In

  fun inner(w: (!H)?) -> (!In)?
    x = <w ?? return none
    !x.inner

  sub set(w: (!H)?)
    d = String("local")
    (inner(<w) ?? return).s = ?d

  t = String("outer")
  h = H(inner: In(s: ?t))
  set(!h)
  print(h.inner.s)

fail "optwrite-review-d18-byvalue-self", "cannot store a view of `@` through `w ?? return`: `w` outlives it"
  obj H
    s: ?String

  obj Src
    n: String

    sub give(<@, w: (!H)?)
      (w ?? return).s = ?@n

  t = String("outer")
  h = H(s: ?t)
  src = Src(n: String("src"))
  <src.give(!h)
  print(h.s)

test "optwrite-review-e01-return-sub-plain-ok", "new"
  obj In
    s: ?String

  obj H
    inner: In

  fun inner(w: !H) -> !In
    x = <w
    !x.inner

  t = String("outer")
  h = H(inner: In(s: ?t))
  (inner(!h)).s = "new"
  print(h.inner.s)

