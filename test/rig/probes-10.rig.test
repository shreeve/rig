fail "optwrite-review-j05-generic-owned-param", "cannot let this call store a view of `v` in `w`: `w` outlives it"
  sub stash[T](w: (!List[?T])?, v: T)
    x = <w ?? return
    !x.push(?v)

  l: List[?String] = List()
  stash(!l, String("gone"))
  print(l)

fail "optwrite-review-j05b-generic-owned-plain", "cannot let this call store a view of `v` in `w`: `w` outlives it"
  sub stash[T](w: !List[?T], v: T)
    !w.push(?v)

  l: List[?String] = List()
  stash(!l, String("gone"))
  print(l)

test "optwrite-review-k01-read-then-local-store-ok", '''
  outer local
  outer
'''
  obj H
    s: ?String

  obj K
    a: ?String
    b: ?String

    sub put(!@, v: ?String) keeps v
      @b = v

  sub set(w: (!H)?)
    d = String("local")
    k = K(a: "", b: "")
    if w as r
      k.a = r.s
    !k.put(?d)
    print(k.a, k.b)

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

test "optwrite-review-k03-local-holds-param-ok", '''
  outer local
  outer
'''
  obj H
    s: ?String

  obj K
    a: ?String
    b: ?String

    sub put(!@, v: ?String) keeps v
      @b = v

  sub set(w: (!H)?)
    d = String("local")
    x = <w ?? return
    k = K(a: x.s, b: "")
    !k.put(?d)
    k.b = ?d
    print(k.a, k.b)

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

