fail "optwrite-review-h04-break-value", "cannot store a view of `d` in `x.s`: `x` outlives it"
  obj H
    s: ?String

  sub set(w: (!H)?)
    d = String("local")
    o = <w
    x = while true
      break <o ?? return
    else
      return
    x.s = ?d

  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

