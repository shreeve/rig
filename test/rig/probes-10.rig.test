test "optwrite-review-b03-readparam-into-opt-ok", "caller"
  obj H
    n: String

  obj G
    r: ?String

  sub set(w: ?H, g: (!G)?) keeps w
    (g ?? return).r = ?w.n

  h = H(n: String("caller"))
  g = G(r: "")
