test "optwrite-review-f05-reads-ok", '''
  1 outer
  2 new
  new 2
'''
  obj H
    s: ?String
    n: Int

    fun len(?@) -> Int
      @n

  sub set(w: (!H)?, v: ?String) keeps v
    if w as r
      print(r.len(), r.s)
    (w ?? return).s = v
    (w ?? return).n += 1
    if w as r
      print(r.len(), r.s)

  t = String("outer")
  u = String("new")
  h = H(s: ?t, n: 1)
  set(!h, ?u)
  set(none, ?u)
  print(h.s, h.n)

fail "optwrite-review-g01-caller-branch", "`u` does not live long enough"
  obj H
    s: ?String

  sub set(w: (!H)?, v: ?String) keeps v
    (w ?? return).s = v

  t = String("outer")
  h = H(s: ?t)
  c = t.len > 0
  if true
    u = String("new")
    set(!h if c else none, ?u)
  print(h.s)

fail "optwrite-review-g02-caller-local-opt", "`u` does not live long enough"
  obj H
    s: ?String

  sub set(w: (!H)?, v: ?String) keeps v
    (w ?? return).s = v

  t = String("outer")
  h = H(s: ?t)
  if true
    u = String("new")
    o: (!H)? = !h
    set(<o, ?u)
  print(h.s)

fail "optwrite-review-g03-method-param-caller", "`src` does not live long enough"
  obj H
    s: ?String

  obj Src
    n: String

    sub give(?@, w: (!H)?) keeps @
      (w ?? return).s = ?@n

  t = String("outer")
  h = H(s: ?t)
  if true
    src = Src(n: String("src"))
    ?src.give(!h)
  print(h.s)

test "optwrite-review-g04-method-param-ok", "src"
  obj H
    s: ?String

  obj Src
    n: String

    sub give(?@, w: (!H)?) keeps @
      (w ?? return).s = ?@n

  src = Src(n: String("src"))
  t = String("outer")
  h = H(s: ?t)
  ?src.give(!h)
  print(h.s)

test "optwrite-review-g05-two-opt-params-ok", "outer outer"
  obj H
    s: ?String

  sub copy(a: (!H)?, b: (!H)?) keeps a
    x = <a ?? return
    y = <b ?? return
    y.s = x.s

  t = String("outer")
  u = String("u")
  h = H(s: ?t)
  k = H(s: ?u)
  copy(!h, !k)
  print(h.s, k.s)

