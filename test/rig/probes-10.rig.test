  sub set(w: !H, g: !G)
    x = <w
    g.r = ?x.n

  h = H(n: String("caller"))
  g = G(r: "")
  set(!h, !g)
  print(g.r)

fail "optwrite-review-b02-unwrap-direct-ok", "cannot store a view of `x` in `g.r`: `g` outlives it"
  obj H
    n: String

  obj G
    r: ?String

  sub set(w: (!H)?, g: !G)
