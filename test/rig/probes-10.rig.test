test "optwrite-review-k04b-plain-list-of-reads-ok", '''
  ["outer", "local"]
  outer
'''
  obj H
    s: ?String

  sub set(w: !H)
    d = String("local")
    l: List[?String] = List()
    !l.push(w.s)
