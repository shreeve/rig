fail "optwrite-review-i05-match-arm-value", "cannot store a view of `d` in `x.s`: `x` outlives it"
  obj H
    s: ?String

  sub set(w: (!H)?, c: Bool)
    d = String("local")
    v = match c
      true => ?d
      false => "x"
    x = <w ?? return
    x.s = v

  t = String("outer")
  h = H(s: ?t)
  set(!h, true)
  print(h.s)

