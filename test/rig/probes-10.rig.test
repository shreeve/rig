test "purity-newbie-bank", '''
  Ada has 70
  could not withdraw 500: BankError.insufficient_funds
  Ada has 70
'''
  # Bank account "class", Python/TS habits
  error BankError
    insufficient_funds
    invalid_amount

  obj Account
    owner: ?String
    balance: Int = 0

    sub deposit(!@, amount: Int)!
      if amount <= 0
        return BankError.invalid_amount
      @balance += amount

    sub withdraw(!@, amount: Int)!
      if amount > @balance
        return BankError.insufficient_funds
      @balance -= amount

  acct = Account(owner: "Ada")
  !acct.deposit(100)!
  !acct.withdraw(30)!
  print(acct.owner, "has", acct.balance)
  !acct.withdraw(500) catch |e|
    print("could not withdraw 500:", e)
  print(acct.owner, "has", acct.balance)

test "purity-newbie-bank2", '''
  ada 65
  bob 40
'''
  # Bank, part 2: transfer between accounts held in a List
  error BankError
    insufficient_funds

  obj Account
    owner: ?String
    balance: Int = 0

    sub deposit(!@, amount: Int)
      @balance += amount

    sub withdraw(!@, amount: Int)!
      return BankError.insufficient_funds if amount > @balance
      @balance -= amount

  sub transfer(from: !Account, to: !Account, amount: Int)!
    !from.withdraw(amount)!
    !to.deposit(amount)

  accounts: List[Account] = List()
  !accounts.push(Account(owner: "ada", balance: 100))
  !accounts.push(Account(owner: "bob"))
  !accounts[0].deposit(5)
  # two write views into one List are rejected, so copy out and back
  a = accounts[0]
  b = accounts[1]
  transfer(!a, !b, 40)!
  accounts[0] = a
  accounts[1] = b
  for acct in ?accounts
    print(acct.owner, acct.balance)

test "purity-newbie-expr", '''
  -20.0
  error: EvalError.divide_by_zero
  0.0
'''
  # Recursive expression evaluator with an enum.
  # The compiler suggested `*Expr`, but a shared handle cannot be matched,
  # so this follows SPEC §10 Box instead.
  error EvalError
    divide_by_zero

  enum Expr
    num(value: Float)
    add(left: ^Expr, right: ^Expr)
    mul(left: ^Expr, right: ^Expr)
    div(left: ^Expr, right: ^Expr)
    neg(inner: ^Expr)

  fun eval(e: ?^Expr) -> Float!
    match e
      .num(v) => v
      .add(l, r) => eval(?l)! + eval(?r)!
      .mul(l, r) => eval(?l)! * eval(?r)!
      .neg(x) => -eval(?x)!
      .div(l, r)
        d = eval(?r)!
        return EvalError.divide_by_zero if d == 0.0
        eval(?l)! / d

  fun num(v: Float) -> ^Expr
    ^.num(v)

  fun add(l: ^Expr, r: ^Expr) -> ^Expr
    ^.add(left: <l, right: <r)

  fun mul(l: ^Expr, r: ^Expr) -> ^Expr
    ^.mul(left: <l, right: <r)

  fun div(l: ^Expr, r: ^Expr) -> ^Expr
    ^.div(left: <l, right: <r)

  fun neg(x: ^Expr) -> ^Expr
    ^.neg(inner: <x)

  # (2 + 3) * -4
  e = mul(add(num(2), num(3)), neg(num(4)))
  print(eval(?e)!)
  bad = div(num(1), add(num(2), neg(num(2))))
  result = eval(?bad) catch |err|
    print("error:", err)
    0.0
  print(result)

test "purity-newbie-expr shared", "-20.0"
  # Recursive expression evaluator with an enum (following the compiler's hint: *Expr)
  enum Expr
    num(value: Float)
    add(left: *Expr, right: *Expr)
    mul(left: *Expr, right: *Expr)
    neg(inner: *Expr)
    div(left: *Expr, right: *Expr)

  fun eval(e: ?*Expr) -> Float
    match e
      .num(v) => v
      .add(l, r) => eval(?l) + eval(?r)
      .mul(l, r) => eval(?l) * eval(?r)
      .neg(x) => -eval(?x)
      .div(l, r) => eval(?l) / eval(?r)

  # (2 + 3) * -4
  e = *Expr.mul(left: *Expr.add(left: *Expr.num(2), right: *Expr.num(3)), right: *Expr.neg(*Expr.num(4)))
  print(eval(?e))

