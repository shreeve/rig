  panic("a")
  print(1)

fail "print keyword arguments", "4:12: `print` takes no keyword arguments", "5:11: `warn` takes no keyword arguments", "6:12: `panic` takes no keyword arguments", errors: 3
  # `print`, `warn`, and `panic` take values to write, separated by a
  # space and ended by a newline; they take no keyword arguments.

  print("a", sep: "x")
  warn("a", end: "")
  panic("a", sep: "x")

fail "propagate in defer", "6:13: cannot use `!` inside `defer`; a deferred expression cannot propagate failure, so handle it with `catch`"
  # A deferred expression cannot propagate with `!`.

  fun g() -> Int!
    3

  defer print(g()!)
  print(1)

fail "propagate in drop", "a `drop` body cannot propagate failure; handle it with `catch`"
  # A `drop` body cannot fail, so it cannot propagate with `!`.

  error E
    bad

  fun check(n: Int) -> Int!
    return E.bad if n < 0
    n

  obj P
    n: Int

    drop(!self)
      print(check(self.n)!)

  p = P(n: 1)
  print(p.n)

fail "propagate in method main", "use of `!` propagation requires the enclosing `main` to be fallible: `sub main(...)!`"
  # Only the top-level `sub main` can fail; a method named `main` is an
  # ordinary `sub` and cannot propagate with `!`.

  error E
    bad

  fun check(n: Int) -> Int!
    return E.bad if n < 0
    n

  obj P
    n: Int

    sub main(?self)
      print(check(self.n)!)

  p = P(n: 1)
  p.main()

test "propagate none", '''
  36 none
  leaving both
  72
  leaving both
  none
  3 none none
  5 none
'''
  # `e?` is the value inside optional `e`; when `e` is `none`, the enclosing
  # function returns `none`. Deferred code runs on that path, and owning
  # values made earlier in the expression are dropped.

  obj User
    name: ?String
    age: Int

  obj Wrap
    n: Int

  fun find(id: Int) -> User?
    return User(name: "ada", age: 36) if id == 1
    none

  fun age_of(id: Int) -> Int?
    find(id)?.age

  fun both(a: Int, b: Int) -> Int?
    defer print("leaving both")
    find(a)?.age + find(b)?.age

  fun boxed(n: Int) -> *Wrap?
    return *Wrap(n: n) if n > 0
    none

  fun pair(a: *Wrap, b: *Wrap) -> Int
    a.n + b.n

  fun sum_boxes(x: Int, y: Int) -> Int?
    pair(boxed(x)?, boxed(y)?)

  fun moved(x: Int) -> Int?
    m = boxed(x)
    b = (<m)?
    b.n

  print(age_of(1), age_of(2))
  print(both(1, 1))
  print(both(1, 2))
  print(sum_boxes(1, 2), sum_boxes(1, 0), sum_boxes(0, 1))
  print(moved(5), moved(0))

test "propagate none chains", '''
  10 none none
  20 7 none
  20 none
  4 5 10
  none none none
'''
  # `e?` chains through fields, works in a function returning `T?!`,
  # leaves a loop with the function, and reads through a viewed optional.

  error Bad
    odd

  obj Node
    next: Int?
    val: Int

  fun get(i: Int) -> Node?
    return none if i < 0
    Node(next: i - 1 if i > 0 else none, val: i * 10)

  fun second(i: Int) -> Int?
    get(get(i)?.next?)?.val

  fun checked(i: Int) -> Int?!
    return Bad.odd if i % 2 == 1
    v = get(i)?
    v.val

  fun first_even(xs: ?[3]Int) -> Int?
    for x in xs
      n = get(x)?
      return n.val if n.val % 20 == 0
    none

  fun bump(m: !(Int?)) -> Int?
    v = m?
    m = v + 1
    v

  fun peek(m: ?(Int?)) -> Int?
    m? * 2

  print(second(2), second(0), second(-1))
  print(checked(2) catch 7, checked(1) catch 7, checked(-2) catch 7)
  print(first_even(?[1, 2, 3]), first_even(?[1, -1, 2]))
  x: Int? = 4
  print(bump(!x), x, peek(?x))
  y: Int? = none
  print(bump(!y), y, peek(?y))

fail "propagate none in closure", "5:12: a closure body returns `none` with `?` only when its type returns an optional"
  # A closure body cannot return `none` from the function around it; its
  # type, inferred here, returns no optional.

  fun f(m: Int?) -> Int?
    g = |+m| m? + 1
    g()

  print(f(1))

fail "propagate none in defer", "4:15: cannot use `?` inside `defer`"
  # Deferred code runs as the function exits and cannot return.

  fun f(m: Int?) -> Int?
    defer print(m?)
    m

  print(f(1))

fail "propagate none needs optional return", "5:3: use of `?` requires the enclosing function `f` to return an optional (`-> T?`)", "9:9: `?` returns `none` from `main`, which returns no value; handle the missing value with `x ?? fallback`, or `if x as value`", "14:9: use of `?` requires the enclosing function to return an optional"
  # `e?` returns `none` from the enclosing function, which must be able to
  # return it: a `-> T?` function. `sub main` and tests cannot.

  fun f(m: Int?) -> Int
    m? + 1

  sub main()
    x: Int? = 1
    print(x?)
    print(f(2))

  test "t"
    y: Int? = none
    print(y?)

fail "propagate none on fallible", "12:3: `?` propagates `none`, and `f(1)` fails with an error instead: propagate the failure with `f(1)!`, or handle it with `catch`"
  # `?` propagates `none`; a failure is propagated with `!`. One error
  # names the fix.

  error E
    bad

  fun f(n: Int) -> Int!
    return E.bad if n < 0
    n

  fun g() -> Int!
    f(1)? + 1

  print(g()!)

fail "raw cast constants", "integer value `300` does not fit in `U8` (0..255)", "integer value `-1` does not fit in `U8` (0..255)", "`@fromBackingInt` of a constant: name the variant instead", "`1e300` does not fit in `I8`", "integer value `16777217` does not fit exactly in `F32`"
  # A cast builtin converts a constant operand when Zig compiles it, so
  # the value must convert.

  enum C
    a
    b

  raw
    a: U8 = @intCast(300)
    b: U8 = @intCast(-1)
    c: C = @fromBackingInt(1)
    d: I8 = @trunc(1e300)
    e: F32 = @floatFromInt(16777217)
    print(a, b, c, d, e)

fail "raw cast mismatch", "`@truncate` cannot turn `Int` into `U8`: both must be signed, or both unsigned", "`@bitCast` cannot turn `I32` into `U64`: both must have the same size", "`@intCast` cannot turn `Float` into `U8`: it converts one integer type to another", "`@floatFromInt` cannot turn `Float` into `F32`: it converts an integer to a float"
  # The cast builtins available in `raw` are checked like Zig checks them,
  # so an accepted cast compiles.

  x: I64 = 300
  f = 1.5
  i: I32 = 1
  raw
    a: U8 = @truncate(x)
    b: U64 = @bitCast(i)
    c: U8 = @intCast(f)
    d: F32 = @floatFromInt(f)

test "raw casts", "44 1 4609434218613702656 1.5 7.0 7"
  # The cast builtins convert between number types inside `raw`.

  x: U64 = 300
  f = 1.5
  n: I64 = 7
  raw
    a: U8 = @truncate(x)
    b: I32 = @trunc(f)
    c: U64 = @bitCast(f)
    d: F32 = @floatCast(f)
    e: F64 = @floatFromInt(n)
    g: U8 = @intCast(n)
    print(a, b, c, d, e, g)

test "raw from backing int", '''
  .ok
  .missing
'''
  # `@fromBackingInt` turns an integer of any type into a plain enum
  # inside `raw`.

  enum Status
    ok = 200
    missing = 404

  fun of(n: Int) -> Status
    raw
      @fromBackingInt(n)

  fun ofSmall(n: U16) -> Status
    raw
      s: Status = @fromBackingInt(n)
      s

  print(ofSmall(200))
  print(of(404))

test "results fail midway", '''
  abc 7
  none
'''
  # A later result that fails after an earlier one was made: the earlier
  # one is dropped on the way out, and nothing leaks.

  error E
    bad

  fun num(ok: Bool) -> Int!
    return E.bad if not ok
    7

  fun two(ok: Bool) -> (String, Int)!
    s = String("abc")
    return s, num(ok)!

  fun three(ok: Bool) -> (String, Int)?
    s = String("abc")
    n = num(ok) catch return none
    return s, n

  a, n = two(true) catch return
  print(a, n)
  if three(false) as b, m
    print(b, m)
  else
    print("none")
  c, k = two(false) catch return
  print(c, k)

test "results fallible", '''
  1 one
  10
  -1
'''
  # Fallible and optional results are consumed whole: `!` and `?` test
  # before anything is bound, as does a fallback that jumps.

  error E
    bad

  fun f(ok: Bool) -> (Int, String)!
    return E.bad if not ok
    return 1, String("one")

  fun g(ok: Bool) -> (Int, Int)?
    return none if not ok
    return 2, 3

  fun h(ok: Bool) -> (Int, Int)?
    a, b = g(ok)?
    return b, a

  fun run(ok: Bool) -> Int!
    n, s = f(ok)!
    print(n, s)
    a, b = g(ok) ?? return 0
    c, d = h(ok) ?? return 0
    a + b + c + d

  print(run(true) catch -1)
  print(run(false) catch -1)
  x, y = f(false) catch return
  print(x, y)

fail "return inside defer", "6:7: cannot `return` inside `defer`; the deferred code runs as the function exits", errors: 1
  # A deferred block runs as the function exits; it cannot return.

  fun f(c: Bool) -> Int
    defer
      if c
        return 3
    1

  print(f(true))

test "rig builtins", '''
  8 1 8 16
  2 2 4
  Bool I16
  8 8 2 2
  bool Bool 2 2
'''
  # Rig's builtins work anywhere: `@size(T)` and `@align(T)` are a type's
  # size and alignment in bytes, `@name(T)` its name, and `@type(x)`, as
  # their argument, the type of `x`. Inside `raw` they work too, as do
  # Zig's names for them (`@sizeOf`, `@alignOf`, `@typeName`, `@TypeOf`);
  # Zig's `@typeName` is the emitted Zig's name for the type.

  obj P
    a: I32
    b: I64

  fun width[T]() -> Int
    @size(T)

  x: I16 = 5
  print(@size(I64), @size(U8), @align(P), @size(P))
  print(@size(@type(x)), @align(@type(x)), width[U32]())
  print(@name(Bool), @name(@type(x)))
  raw
    print(@sizeOf(I64), @size(I64), @alignOf(@TypeOf(x)), @align(@type(x)))
    print(@typeName(Bool), @name(Bool), @sizeOf(@type(x)), @size(@TypeOf(x)))

test "safe builtin outside raw", "8"
  # Rig's builtins (`@size`, `@type`, ...) need no `raw` block.

  x: I64 = 7
  n = @size(@type(x))
  print(n)

fail "swap signal whole", "7:8: `swap` moves values whole, and a `Signal[Int]` changes only by its marked calls", errors: 1
  # `swap` and `replace` move values whole. A Signal changes only by its
  # marked calls, which may be running its subscribers, so the Signals two
  # handle parameters lend are not exchanged; handles of local bindings,
  # which `!` lends themselves, still are.

  sub trade(s: *Signal[Int], t: *Signal[Int])
    swap(!s, !t)

  a: *Signal[Int] = *Signal(0)
  b: *Signal[Int] = *Signal(1)
  swap(!a, !b)
  trade(+a, +b)
  print(a.get(), b.get())

fail "unknown builtin", "builtin `@min` is not supported; the builtins are `@size`"
  # A builtin Rig does not have is reported once, with the list of the
  # builtins it has.

  x = @min(1, 2)
  print(x)

test "unsafe builtin in raw", "4294967295"
  # A builtin outside the safe whitelist (`@bitCast`) is allowed inside a
  # `raw` block.

  x: I32 = -1
  raw
    y: U32 = @bitCast(x)
    print(y)

fail "unsafe builtin outside raw", "builtin `@bitCast` is not in the safe whitelist"
  # A builtin outside the safe whitelist needs a `raw` block; the
  # diagnostic names the builtin.

  x: I32 = -1
  y: U32 = @bitCast(x)
  print(y)

test "void fallible ends with statement", '''
  1
  3
  caught E.bad
  caught E.bad
  7
  caught E.bad
'''
  # A `Void!` function has no value to end with: its last statement may
  # be a guard, an `if` with no `else`, an assignment, or a loop.

  error E
    bad

  sub check(i: Int)!
    print(i)
    return E.bad if i == 3

  sub block_guard(i: Int)!
    if i == 3
      return E.bad

  sub ends_in_set(c: !Int, i: Int)!
    return E.bad if i == 3
    c = i

  sub ends_in_loop(i: Int)!
    for k in 0..i
      return E.bad if k == 3

  check(1) catch |e| print("caught", e)
  check(3) catch |e| print("caught", e)
  block_guard(2) catch |e| print("caught", e)
  block_guard(3) catch |e| print("caught", e)
  n = 0
  ends_in_set(!n, 7) catch |e| print("caught", e)
  print(n)
  ends_in_loop(2) catch |e| print("caught", e)
  ends_in_loop(5) catch |e| print("caught", e)

test "while condition jumps", '''
  break in condition 0
  catch break 0 0
  catch break 1 1
  catch break 2 2
  continue in condition 1 4
  continue in step 6 1
  break in step 3 1
  step reads a binding 6 0
  continue with the step inside 209 0
'''
  # A jump in a `while` condition or step targets that loop: `?? break`
  # and `catch break` leave it, `?? continue` in the condition runs the
  # step and tests again, and in the step `continue` ends the step and
  # `break` leaves the loop.

  error E
    bad

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun p(k: Int) -> Int!
    return E.bad if k == 0
    k

  n = 3
  while (get(n) ?? break) > 0
    n -= 1
  print("break in condition", n)

  for i in 0..3
    m = 3
    while (p(m) catch break) > i
      m -= 1
    print("catch break", i, m)

  n = 5
  seen = 0
  while (get(n % 3) ?? continue) > 0 : n -= 1
    seen += 1
    break if n < 2
  print("continue in condition", n, seen)

  c = 0
  n = 3
  while c < 6 : n = get(n - 1) ?? continue
    c += 1
  print("continue in step", c, n)

  c = 0
  n = 3
  while c < 6 : n = get(n - 1) ?? break
    c += 1
  print("break in step", c, n)

  n = 3
  total = 0
  while get(n) as x and x > 0 : n = x - 1
    total += x
  print("step reads a binding", total, n)

  n = 6
  odd = 0
  @outer while get(n) as x and x > 0 : n = x - 1
    for _ in 0..2
      continue @outer if x % 2 == 0
    odd += x
    continue if x == 3
    odd += 100
  print("continue with the step inside", odd, n)

fail "while step binding condition continue", "13:47: the loop step reads `h`, a binding of the condition, which a `continue` in the condition leaves unbound", errors: 1
  # A `continue` in a `while` condition goes on to the step, so a step that
  # reads a binding of the condition cannot have one, joined or not: the
  # `continue` leaves the binding unbound.

  fun odd(i: Int) -> Int?
    none if i % 2 == 1 else i

  fun some(i: Int) -> Int?
    i if i < 10 else none

  steps = 0
  i = 0
  while some(odd(i) ?? continue) as h: steps += h
    i += 1
  print(steps, i)

fail "while step capture condition continue", "16:54: the loop step reads `h`, a binding of the condition, which a `continue` in the condition leaves unbound", errors: 1
  # A step that reads the condition's binding through a closure's capture
  # reads it too, so a `continue` in the condition, which goes on to the
  # step, would leave it unbound.

  fun odd(i: Int) -> Int?
    none if i % 2 == 1 else i

  fun some(i: Int) -> Int?
    i if i < 6 else none

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  steps = 0
  i = 0
  while some(odd(i) ?? continue) as h: steps = apply(|+h, x: Int| x + h, steps)
    i += 1
  print(steps, i)

test "while step propagates", '''
  0
  1
  2
  0
  1
  2
  3
  4
  5
  6
  -1
'''
  # A `while` step may be a call that propagates its failure.

  error E
    bad

  fun ok(n: !Int) -> Int!
    return E.bad if n > 5
    n += 1
    n

  fun run(limit: Int) -> Int!
    i = 0
    while i < limit : ok(!i)!
      print(i)
    i

  print(run(2) catch 0)
  print(run(9) catch -1)

fail "zig builtin name outside raw", "10:7: write `@size(I64)`: Rig's builtin is `@size`; Zig's `@sizeOf` works only inside `raw`", "10:21: write `@align(P)`: Rig's builtin is `@align`; Zig's `@alignOf` works only inside `raw`", "10:34: write `@name(Int)`: Rig's builtin is `@name`; Zig's `@typeName` works only inside `raw`", "11:13: write `@type(x)`: Rig's builtin is `@type`; Zig's `@TypeOf` works only inside `raw`", "11:26: write `@size(@type(x))`: Rig's builtin is `@size`; Zig's `@sizeOf` works only inside `raw`", errors: 5
  # Outside `raw`, a type query takes Rig's name: `@size`, `@align`,
  # `@type`, `@name`. Zig's names (`@sizeOf`, `@alignOf`, `@TypeOf`,
  # `@typeName`) work only inside `raw`; the fix-it rewrites the call,
  # its argument included, once.

  obj P
    a: Int

  x = 5
  print(@sizeOf(I64), @alignOf(P), @typeName(Int))
  print(@size(@TypeOf(x)), @sizeOf(@TypeOf(x)))
