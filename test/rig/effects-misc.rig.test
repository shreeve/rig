test "extern sub call", "true"
  # A body-less `extern sub` declares a C function returning void; calls
  # still require a `raw` block. Reseeding with the same seed repeats the
  # sequence.

  extern sub srand(seed: U32)
  extern fun rand() -> I32

  raw
    srand(7)
    a = rand()
    srand(7)
    b = rand()
    print(a == b)

fail "fallible call without bang", "fallible call to `loadUser` must be wrapped with `!` (propagate) or `catch` (handle)"
  # A call to a fallible function must be wrapped with `!` (propagate) or
  # `catch` (handle); a bare call would hide the failure path.

  obj User
    name: ?String

  fun loadUser(id: U64) -> User!
    User(name: "Steve")

  x = loadUser(1)
  print(x.name)

test "fallible errors", '''
  3
  -1
  100
  empty too long long enough short
  5 -9
  3 7
  failed with ParseError.empty
  0
  3
'''
  # A `-> T!` function fails by returning an error value: a member of an
  # error set, named with its set (`return E.name`), or an error it
  # caught. `catch |err|` names the error, which may be any error: it is
  # matched and compared with error-set members.

  error ParseError
    empty
    too_long

  error NetError
    timeout

  fun parse_len(s: ?String) -> Int!
    if s == ""
      return ParseError.empty
    if s.len > 5
      return ParseError.too_long
    s.len

  fun fetch(n: Int) -> Int!
    e: NetError = .timeout
    return e if n < 0
    parse_len("ab")! + n

  fun describe(s: ?String) -> ?String
    n = parse_len(s) catch |err|
      match err
        .empty => return "empty"
        .too_long => return "too long"
        _ => return "other"
    if n > 2
      "long enough"
    else
      "short"

  fun retry(n: Int) -> Int!
    fetch(n) catch |err|
      return err if err == NetError.timeout
      0

  print(parse_len("abc") catch -1)
  print(parse_len("") catch -1)
  print(parse_len("abcdefg") catch |err| 100 if err == .too_long else 200)
  print(describe(""), describe("abcdefgh"), describe("abcd"), describe("a"))
  print(fetch(3) catch 0, fetch(-1) catch |e| -9 if e == .timeout else -8)
  print(retry(1) catch 7, retry(-1) catch 7)
  x = parse_len("") catch |err|
    print("failed with", err)
    0
  print(x)
  print(fetch(1)!)

fail "fallible instance method without bang", "must be wrapped with `!` (propagate) or `catch` (handle)"
