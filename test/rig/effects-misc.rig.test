# effects: the rest of its tests.

test "bare literal is success variant", '''
  .red .missing .red
  .red
'''
  # Where a `T!` is expected, a bare `.name` is a variant of `T` even when
  # an error set has a member of the same name: the function succeeds with
  # it. Failing names the set.

  enum Color
    red
    missing

  error E
    missing

  fun pick(n: Int) -> Color!
    return E.missing if n < 0
    return .missing if n == 0
    .red

  print(pick(1) catch .red, pick(0) catch .red, pick(-1) catch .red)
  e = pick(-1) catch |err| .red if err == E.missing else .missing
  print(e)

test "closure propagation", '''
  3
  failed Parse.empty
  6 -1
  3 0
  104 0
  len 4
  no
'''
  # A closure whose type can fail propagates with `!` to its caller, and
  # one whose type returns an optional returns `none` with `?`.

  error Parse
    empty

  fun parse(s: ?String) -> Int!
    if s.len == 0
      return Parse.empty
    s.len

  fun first(s: ?String) -> U8?
    s.get(0)

  sub each(xs: []?String, f: ?sub(?String)!)!
    for x in xs
      f(x)!

  fun apply(s: ?String, f: ?fun(?String) -> Int!) -> Int
    f(s) catch -1

  fun lead(s: ?String, f: ?fun(?String) -> Int?) -> Int
    f(s) ?? 0

  total = *Cell(0)
  each(["ab", "c"], |+total, l| !total.set(total.get() + parse(l)!)) catch print("failed")
  print(total.get())
  each(["ab", ""], |+total, l| !total.set(total.get() + parse(l)!)) catch |e| print("failed", e)
  print(apply("abc", |l| parse(l)! * 2), apply("", |l| parse(l)! * 2))
  g: *fun(?String) -> Int! = *|l| parse(l)! + 1
  print(g("xy") catch 0, g("") catch 0)
  print(lead("hi", |s| Int(first(s)?)), lead("", |s| Int(first(s)?)))
  h: *sub(?String)! = *|l| print("len", parse(l)!)
  h("abcd") catch print("no")
  h("") catch print("no")

fail "closure propagation type", "11:17: use of `!` propagation requires a fallible enclosing function; a closure body propagates failure only when its type can fail (`?fun(A) -> T!`), so handle it with `catch`", "12:18: use of `!` propagation requires a fallible enclosing function", "13:34: a closure body returns `none` with `?` only when its type returns an optional"
  # A closure propagates with `!` only when its type can fail, and returns
  # `none` with `?` only when its type returns an optional; a closure
  # whose type is inferred can do neither.

  fun parse(s: ?String) -> Int!
    s.len

  fun apply(f: ?fun(?String) -> Int) -> Int
    f("x")

  print(apply(|l| parse(l)!))
  g = |l: ?String| parse(l)!
  k: fun(?String) -> Int = |s| Int(s.get(0)?)
  print(g("a"), k("b"))

test "coalesce chain jump", '''
  2 -1 1
  30 0 10
  4
'''
  # A jump fallback ends a chain of `??`: `a ?? b ?? return v` tries `a`,
  # then `b`, and leaves when both are `none`.

  fun f(a: Int?, b: Int?) -> Int
    a ?? b ?? return -1

  fun g(a: Int?, b: Int?, c: Int?) -> Int
    n = a ?? b ?? c ?? return 0
    n * 10

  fun odd(k: Int) -> Int?
    k if k % 2 == 1 else none

  print(f(none, 2), f(none, none), f(1, none))
  print(g(none, none, 3), g(none, none, none), g(1, 2, 3))
  total = 0
  for k in 0..4
    total += odd(k) ?? odd(k + 2) ?? continue
  print(total)

fail "defer statement declares", "9:12: a deferred statement runs at scope exit and cannot declare `x`; use an indented `errdefer` block", "14:7: a deferred statement runs at scope exit and cannot declare `t`; use an indented `defer` block", "15:11: cannot declare `s`", "16:7: cannot declare `u`", errors: 4
  # A one-line `defer` or `errdefer` runs its statement at scope exit, so
  # that statement cannot declare a name: nothing after it could see one.
  # An indented block may declare names of its own.

  error E
    bad

  fun f(k: Int) -> Int!
    errdefer x =! 1
    return E.bad if k > 0
    k

  s = 1
  defer t = s
  defer new s = 3
  defer u: Int = 1
  defer
    v = s
    print(v)
  print(f(0) catch -1)

fail "entry point call", "13:5: `main` is the program's entry point; it cannot be called or used as a value", "16:5: `main` is the program's entry point; it cannot be called or used as a value"
  # The root module's `main` is the program's entry point: it may
  # propagate a failure out of the program, so no Rig code calls it or
  # holds it as a value.

  error E
    bad

  fun g() -> Int!
    3

  sub again(n: Int)
    if n > 0
      main()

  x = g()!
  f = main
  again(x)

fail "enum from int", "builtin `@enumFromInt` is not supported; an integer becomes a plain enum with `@fromBackingInt`", errors: 1
  # Rig's builtins are Zig's: an integer becomes a plain enum with
  # `@fromBackingInt`, and `@enumFromInt` names it.

  enum Status
    ok = 200
    missing = 404

  fun of(n: Int) -> Status
    raw
      s: Status = @enumFromInt(n)
      s

  print(of(404))

fail "errdefer cannot fail", "6:3: `errdefer` runs only when the function fails, and `next` cannot fail; use `defer`", "10:3: `errdefer` runs only when the function fails, and `show` cannot fail; use `defer`", "18:5: `errdefer` runs only when the function fails, and a `drop` body cannot fail; use `defer`", "22:5: an `errdefer` inside deferred code never runs, since deferred code cannot fail; write its statement in the block directly", "26:3: `errdefer` runs only when the function fails, and this closure cannot fail; use `defer`", "29:3: `errdefer` runs only when the function fails, and this closure cannot fail; use `defer`", errors: 6
  # `errdefer` runs only when its function fails, so a function, closure,
  # or `drop` body that cannot fail takes `defer` instead, and one inside
  # deferred code would never run.

  fun next(x: Int) -> Int
    errdefer print("never")
    x + 1

  sub show(x: Int)
    errdefer
      print("never")
    print(x)

  obj D
    n: Int

    drop(!self)
      errdefer print("never")

  fun later() -> Int!
    defer
      errdefer print("never")
    1

  k = ||
    errdefer print("never")
  k()
  c: sub() = ||
    errdefer print("never")
  c()
  show(next(1))
  print(later()!)
  d = D(n: 1)
  print(d.n)

test "errdefer in failing value block", '''
  branch inner 1
  branch outer 1
  -1
  0
  arm 1
  -1
  2
  nested inner 9
  nested outer 9
  -1
  2
'''
  # A function fails with `return` of an error value, also from inside an
  # `if` branch or `match` arm block: the `errdefer`s of that block run,
  # and so do those of the blocks and function around it. A block that
  # ends in a plain value leaves its `errdefer`s unrun.

  error E
    bad

  fun branch(k: Int) -> Int!
    errdefer print("branch outer", k)
    if k > 0
      errdefer print("branch inner", k)
      return E.bad
    else
      k

  fun arm(k: Int) -> Int!
    match k
      0 => 0
      1
        errdefer print("arm", k)
        return E.bad
      _
        errdefer print("arm ok", k)
        k

  fun nested(k: Int) -> Int!
    if k > 0
      errdefer print("nested outer", k)
      if k > 5
        errdefer print("nested inner", k)
        return E.bad
      else
        k
    else
      0

  print(branch(1) catch -1)
  print(branch(0) catch -1)
  print(arm(1) catch -1)
  print(arm(2) catch -1)
  print(nested(9) catch -1)
  print(nested(2) catch -1)

test "errdefer in fallible functions", '''
  parse failed
  closure failed
  1 0
  parse failed
  save failed
  caught
'''
  # `errdefer` is accepted wherever a failure can leave: a `fun ... -> T!`,
  # a `sub f()!`, `sub main`, a closure whose type can fail, and a test.

  error E
    bad

  fun parse(k: Int) -> Int!
    errdefer print("parse failed")
    return E.bad if k < 0
    k

  sub save(k: Int)!
    errdefer print("save failed")
    _ = parse(k)!

  sub main()
    errdefer print("main failed")
    f: fun(Int) -> Int! = |k|
      errdefer print("closure failed")
      parse(k)!
    print(f(1) catch 0, f(-1) catch 0)
    save(-1) catch print("caught")

  test "a test may fail"
    errdefer print("test failed")
    _ = parse(1)!

test "errdefer on failure", '''
  defer 1
  2
  errdefer -1
  defer -1
  -1
  inner errdefer 11
  errdefer 11
  defer 11
  -1
  defer 2
  defer 2
  6
  errdefer -2
  defer -2
  twice errdefer -2
  -1
'''
  # `errdefer` runs only when the function exits with an error, whether it
  # fails with `return` or propagates a failure with `!`; `defer` runs on
  # every exit. Both run in reverse order, including those of inner scopes
  # the failure leaves.

  error E
    bad

  fun check(n: Int) -> Int!
    return E.bad if n < 0
    n

  fun step(n: Int) -> Int!
    defer print("defer", n)
    errdefer print("errdefer", n)
    if n > 10
      errdefer print("inner errdefer", n)
      return E.bad
    check(n)! + 1

  fun twice(n: Int) -> Int!
    errdefer print("twice errdefer", n)
    step(n)! + step(n)!

  print(step(1) catch -1)
  print(step(-1) catch -1)
  print(step(11) catch -1)
  print(twice(2) catch -1)
  print(twice(-2) catch -1)

test "error identity by set", '''
  1 net timeout net timeout
  2 disk not a net timeout
  3 disk not a net timeout
  4 other not a net timeout
  5 ok ok
  Disk.timeout false true true
  Disk.timeout Net.timeout true true
  0 1
'''
  # Each error belongs to its error set: `Net.timeout` and `Disk.timeout`
  # are different errors. They compare apart, a match arm for one does
  # not catch the other, and each prints with its set.

  error Net
    timeout
    refused

  error Disk
    timeout
    full

  fun fetch(n: Int) -> Int!
    return Net.timeout if n == 1
    return Disk.timeout if n == 2
    return Disk.full if n == 3
    return Net.refused if n == 4
    n

  fun describe(n: Int) -> ?String
    _ = fetch(n) catch |e|
      match e
        Net.timeout => return "net timeout"
        Disk.timeout, .full => return "disk"
        _ => return "other"
    "ok"

  fun only_net(n: Int) -> ?String
    _ = fetch(n) catch |e|
      match e
        Net.timeout => return "net timeout"
        _ => return "not a net timeout"
    "ok"

  for n in 1..6
    print(n, describe(n), only_net(n))
  x = fetch(2) catch |e|
    print(e, e == Net.timeout, e == Disk.timeout, e != Net.timeout)
    0
  d: Disk = .timeout
  n: Net = .timeout
  print(d, n, d == Disk.timeout, n == .timeout)
  y = fetch(4) catch |e| 1 if e == .refused else 2
  print(x, y)

