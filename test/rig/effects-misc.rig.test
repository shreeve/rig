fail "module main propagate", "use of `!` propagation requires the enclosing `main` to be fallible: `sub main(...)!`"
  # A `main` in an imported module is not the entry point, so it cannot
  # propagate failure with `!`.
  use tool

  sub main()
    tool.main()

  file "tool.rig"
    error E
      oops

    fun f() -> Int!
      return E.oops

    # Only the root module's `main` is the entry point; here `main` is an
    # ordinary `sub`, which cannot propagate.
    pub sub main()
      x = f()!
      print(x)

fail "panic as value", "5:5: `panic` ends the program and gives no value, so it stands as a statement or as a branch's value", "11:10: `panic` ends the program and gives no value, so it stands as a statement or as a branch's value", "14:7: `panic` ends the program and gives no value, so it stands as a statement or as a branch's value", "15:5: `panic` ends the program and gives no value, so it stands as a statement or as a branch's value", "16:7: `panic` ends the program and gives no value, so it stands as a statement or as a branch's value", errors: 5
  # `panic` gives no value, so it stands only as a statement or as a
  # branch's value: not as an operand, an argument, a binding's value, a
  # `return` value, or a module constant.

  X = panic("module")

  sub f(n: Int)
    print(n)

  fun g() -> Int
    return panic("returned")

  sub main()
    a = panic("a") + 1
    f(panic("argument"))
    b = panic("bound")
    print(a, b, g(), X)

fail "panic in defer", "9:12: `panic` cannot stand in deferred code, which runs as its scope ends; check before the scope ends instead", "12:7: `panic` cannot stand in deferred code, which runs as its scope ends; check before the scope ends instead", errors: 2
