  # A `break` as a fallback is checked as the statement is: it must be
  # inside a loop.

  fun get(k: Int) -> Int?
    k if k > 0 else none

  n = get(1) ?? break
  print(n)

fail "jump fallback outside loop", "10:17: `continue` is not inside a loop", "14:22: `continue` is not inside a loop"
  # `?? continue` and `catch continue` must be inside a loop.

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun parse(k: Int) -> Int!
    k

  sub first()
    m = get(2) ?? continue
    print(m)

  sub second()
    n = parse(3) catch continue
    print(n)

  first()
  second()

