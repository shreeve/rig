fail "joined while step bindings", "18:45: the loop step reads `x`, a binding of the condition, so each binding there must be plain data; `r` is a `Res`", "21:54: the loop step reads `y`, a binding of the condition, which a `continue` in the condition leaves unbound"
  # A step that reads a binding of a joined `while` condition runs after
  # the body, inside the `if`s that bind it: every binding there must be
  # plain data, and no `continue` in the condition may skip binding one.

  obj Res
    id: Int

    drop(!self)
      print(self.id)

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun make(k: Int) -> Res?
    Res(id: k) if k > 0 else none

  n = 3
  while make(n) as r and get(r.id) as x : n = x - 1
    print(x)
  m = 3
  while (get(m) ?? continue) > 0 and get(m) as y : m = y - 1
    print(y)

test "jump as fallback", '''
  found 4
  drop 4
  1
  drop 5
  -1
  30 -1
  ok error
  at 2
  total 6
  seen 3
  step 0 102
  drop 102
  step 1 104
  drop 104
  step 2 106
  drop 106
  step 3 108
  drop 108
  drop 110
  first 2
'''
  # A jump is a fallback: `?? return`, `?? break`, `?? continue`, and the
  # same after `catch`. It leaves as the statement would, dropping what
  # the scope owns.

  error E
    missing
    bad

  obj Noisy
    id: Int

    drop(!self)
      print("drop", self.id)

  fun find(xs: ?List[Int], k: Int) -> Int?
    for x, i in xs
      return i if x == k
    none

  fun parse(s: ?String) -> Int!
    return E.bad if s == "x"
    s.len

  fun index_of(xs: ?List[Int], k: Int) -> Int!
    guard = Noisy(id: k)
    i = find(xs, k) ?? return E.missing
    print("found", guard.id)
    i

  fun size(s: ?String) -> Int
    n = parse(s) catch return -1
    n * 10

  fun describe(s: ?String) -> ?String
    n = parse(s) catch |e| return "error" if e == E.bad else "other"
    "ok" if n > 0 else "empty"

  sub report(xs: ?List[Int], k: Int)
    i = find(xs, k) ?? return
    print("at", i)

  xs: List[Int] = List()
  for n in 1..5
    !xs.push(n * 2)
  print(index_of(?xs, 4) catch -1)
  print(index_of(?xs, 5) catch -1)
  print(size("abc"), size("x"))
  print(describe("ab"), describe("x"))
  report(?xs, 6)
  report(?xs, 7)

  total = 0
  for k in 0..10
    i = find(?xs, k) ?? continue
    total += i
  print("total", total)

  words = ["1", "22", "x", "4444"]
  seen = 0
  for w in words
    n = parse(w) catch break
    seen += n
  print("seen", seen)

  j = 2
  while true
    held = Noisy(id: 100 + j)
    i = find(?xs, j) ?? break
    print("step", i, held.id)
    j += 2

  first = for w in words
    n = parse(w) catch continue
    break n if n > 1
  else
    0
  print("first", first)

fail "jump fallback checked", "11:24: expected `Int`, got `Static`", "15:17: `return` needs a value of type `Int`", "19:17: expected `Int`, got", "23:24: a `sub` returns no value"
  # A `return` as a fallback is checked as the statement is, against the
  # function's result. A bare error value is no fallback for `??`.

  error E
    missing

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun wrong(k: Int) -> Int
    n = get(k) ?? return "none"
    n

  fun empty(k: Int) -> Int
    n = get(k) ?? return
    n

  fun err(k: Int) -> Int!
    n = get(k) ?? E.missing
    n

  sub nothing(k: Int)
    n = get(k) ?? return 0
    print(n)

  n = get(1) ?? 0
  print(n, wrong(1), empty(1), err(1) catch 0)
  nothing(1)

