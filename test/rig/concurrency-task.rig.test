test "task many", seeds: 20, release: true, '''
  101152559
'''
  # Tasks held in a List, each waited for in turn.
  fun spin(n: Int) -> Int
    total = 0
    for i in 0..n
      total = (total + i * 7) % 1000003
    total

  tasks: List[Task[Int]] = List()
  for i in 0..200
    !tasks.push(spin(100000 + i)&)
  sum = 0
  for t in <tasks
    sum += >t
  print(sum)

test "task dropped waits", seeds: 20, '''
  started
  end
  drop 1
'''
  # A task no one waits for is waited for where its scope ends, and its
  # result dropped.
  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  fun make(n: Int) -> Res
    Res(n: n)

  t = make(1)&
  print("started")
  print("end")

test "task fallible", seeds: 20, '''
  2
  -1
'''
  error Parity
    odd

  fun half(x: Int) -> Int!
    return Parity.odd if x % 2 == 1
    x / 2

  fun both(a: Int, b: Int) -> Int!
    t = half(a)&
    u = half(b)&
    x = >t!
    y = >u!
    x + y

  print(both(2, 2) catch -1)
  print(both(4, 3) catch -1)

fail "task print", "`t` is a task, which `print` cannot show: wait for what it gives, `>t`"
  # A task shows nothing of what it gives: printing one is a slip for
  # `>t`, one key from `<t`.
  fun half(x: Int) -> Int
    x / 2

  t = half(4)&
  print(<t)

