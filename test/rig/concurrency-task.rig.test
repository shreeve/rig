  n = 5
  print(run(|+n, x| x + n))

fail "task callable forwarded from a function", "views a closure or function lent for a call", errors: 1
  # A `?fun` may view a closure, whatever the caller lent; a named
  # function goes to a task by value.
  fun inc(x: Int) -> Int
    x + 1

  fun work(f: ?fun(Int) -> Int) -> Int
    f(1)

  fun run(f: ?fun(Int) -> Int) -> Int
    t = work(f)&
    >t

  print(run(inc))

