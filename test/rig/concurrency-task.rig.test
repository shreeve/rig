# concurrency: tests whose names start `task`.

test "task wait", seeds: 20, '''
  16 3
'''
  # `f(x)&` starts the call as a task and gives a `Task[T]` at once;
  # `<t.wait()` waits for it to end and takes its result.
  fun sq(x: Int) -> Int
    x * x

  fun total(xs: ?List[Int]) -> Int
    n = 0
    for x in xs
      n += x
    n

  xs: List[Int] = List()
  !xs.push(3)
  t = sq(4)&
  u = total(?xs)&
  print(<t.wait(), <u.wait())

test "task read loan ends at wait", seeds: 20, '''
  1
'''
  # A task keeps its loans until it is waited for; then `xs` can be
  # lent to write again.
  fun total(xs: ?List[Int]) -> Int
    xs.len

  xs: List[Int] = List()
  u = total(?xs)&
  n = <u.wait()
  !xs.push(n)
  print(xs.len)

test "task write loan", seeds: 20, release: true, '''
  3
  3 4
'''
  # A task lent to write runs where it is bound, and is waited for there.
  sub fill(xs: !List[Int], n: Int)
    for i in 0..n
      !xs.push(i)

  fun add(xs: !List[Int], n: Int) -> Int
    !xs.push(n)
    n

  xs: List[Int] = List()
  t = fill(!xs, 3)&
  <t.wait()
  print(xs.len)
  u = add(!xs, 3)&
  n = <u.wait()
  print(n, xs.len)

test "task methods", seeds: 20, '''
  3
  3
  n is 3
'''
  # A method runs as a task with its receiver lent as the method takes
  # it: `(!c).bump(2)&` to write, `?c.get()&` to read, `(<c).into()&`
  # moved in.
  obj Counter
    n: Int

    sub bump(!@, by: Int)
      @n += by

    fun get(?@) -> Int
      @n

    fun into(<@) -> String
      String("n is ", @n)

  c = Counter(n: 1)
  t = (!c).bump(2)&
  <t.wait()
  print(c.n)
  g = ?c.get()&
  print(<g.wait())
  v = (<c).into()&
  print(<v.wait())

test "task generic", seeds: 20, "[7, 7]"
  fun twice[T](x: T) -> List[T]
    out: List[T] = List()
    !out.push(x)
    !out.push(x)
    out

  w = twice[Int](7)&
  <w.wait()

test "task many", seeds: 20, release: true, '''
  101152559
'''
  # Tasks held in a List, each waited for in turn.
  fun spin(n: Int) -> Int
    total = 0
    for i in 0..n
      total = (total + i * 7) % 1000003
    total

  tasks: List[Task[Int]] = List()
  for i in 0..200
    !tasks.push(spin(100000 + i)&)
  sum = 0
  for t in <tasks
    sum += <t.wait()
  print(sum)

test "task dropped waits", seeds: 20, '''
  started
  end
  drop 1
'''
  # A task no one waits for is waited for where its scope ends, and its
  # result dropped.
  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  fun make(n: Int) -> Res
    Res(n: n)

  t = make(1)&
  print("started")
  print("end")

test "task fallible", seeds: 20, '''
  2
  -1
'''
  error Parity
    odd

  fun half(x: Int) -> Int!
    return Parity.odd if x % 2 == 1
    x / 2

  fun both(a: Int, b: Int) -> Int!
    t = half(a)&
    u = half(b)&
    x = <t.wait()!
    y = <u.wait()!
    x + y

  print(both(2, 2) catch -1)
  print(both(4, 3) catch -1)

test "task print", seeds: 20, '''
  <task>
  2
'''
  fun half(x: Int) -> Int
    x / 2

  t = half(4)&
  print(t)
  print(<t.wait())

test "task defer before", seeds: 20, "0"
  # A defer declared before the task runs after the task is dropped.
  fun total(xs: ?List[Int]) -> Int
    xs.len

  sub clear(xs: !List[Int])
    !xs.clear()

  xs: List[Int] = List()
  defer clear(!xs)
  u = total(?xs)&
  print(<u.wait())

test "task prints", seeds: 20, '''
  in the task
  done
'''
  sub say()
    print("in the task")

  t = say()&
  <t.wait()
  print("done")

test "task amp spacing", seeds: 20, '''
  2 2 16
'''
  # `&` touching a `)` with nothing touching its other side starts a
  # task; with an operand touching it, or spaced, it is `and`.
  fun six() -> Int
    6

  fun sq(x: Int) -> Int
    x * x

  b = 3
  t = sq(4)& # runs while this goes on
  print(six()&b, six() & b, <t.wait())

fail "task dropped at once", "1:1: this task is dropped as soon as it starts, which waits for it to end: bind it, `t = sq(3)&`"
  sq(3)&
  fun sq(x: Int) -> Int
    x * x

fail "task results", "a call that gives several results cannot be a task", errors: 1
  fun divmod(a: Int, b: Int) -> (Int, Int)
    return a / b, a % b

  t = divmod(17, 5)&

fail "task targets", "a task runs a call of a function or a method: `f(x)&`, `(!v).m(x)&`", errors: 2
  # A closure or a constructor is not a task's target.
  obj Node
    v: Int

  f = |x: Int| x + 1
  u = f(2)&
  v = Node(v: 3)&

fail "task crossing", "a task may run on another core, and `?n` is lent to it to read: `?*Node` views a `*` handle whose count is not atomic, so two cores could change it at once", errors: 1
  # What a task is lent to read must share: another core reads it while
  # this one may too (docs/CONCURRENCY.md, "What may cross cores").
  obj Node
    v: Int

  fun val(n: ?*Node) -> Int
    n.v

  n = *Node(v: 1)
  t = val(?n)&
  print(<t.wait())

fail "task crossing given", "a task may run on another core, and `n` is given to it: `*Node` is a `*` handle whose count is not atomic, so two cores could change it at once", errors: 1
  # What a task is given must move.
  obj Node
    v: Int

  fun val(n: *Node) -> Int
    n.v

  n = *Node(v: 1)
  t = val(n)&
  print(<t.wait())

fail "task crossing inside", "a task may run on another core, and `?ns` is lent to it to read: `?List[*Node]` holds `*Node`, a `*` handle whose count is not atomic, so two cores could change it at once", errors: 1
  # A value that holds a handle anywhere inside stays on this core.
  obj Node
    v: Int

  fun count(ns: ?List[*Node]) -> Int
    ns.len

  ns = List[*Node]()
  t = count(?ns)&
  print(<t.wait())

fail "task crossing task lent", "a task may run on another core, and `?a` is lent to it to read: `?Task[Int]` views a task, which only the one that holds it may wait for", errors: 1
  # A task moves to another task, but is never lent: only the one that
  # holds it may wait for it.
  fun one() -> Int
    1

  fun peek(t: ?Task[Int]) -> Int
    2

  a = one()&
  t = peek(?a)&
  print(<t.wait(), <a.wait())

test "task crossing passed", seeds: 20, '''
  6
  3
  5
  7
'''
  # Each argument, and a method's self (`@`), crosses as it is passed: a
  # List lent to read shares, one lent to write moves, and self as the
  # method takes it, `?@` or `!@`.
  obj Counter
    n: Int

    fun get(?@) -> Int
      @n

    sub bump(!@, k: Int)
      @n += k

  fun total(xs: ?List[Int]) -> Int
    s = 0
    for x in xs
      s += x
    s

  sub fill(xs: !List[Int], n: Int)
    for i in 0..n
      !xs.push(i)

  xs = List[Int]()
  !xs.push(1)
  !xs.push(2)
  !xs.push(3)
  a = total(?xs)&
  print(<a.wait())
  ys = List[Int]()
  b = fill(!ys, 3)&
  <b.wait()
  print(ys.len)
  c = Counter(n: 5)
  d = ?c.get()&
  print(<d.wait())
  e = (!c).bump(2)&
  <e.wait()
  print(c.n)

test "task moved into a task", seeds: 20, "17"
  # A task moves to another task, which waits for it.
  fun square(n: Int) -> Int
    n * n

  fun later(t: Task[Int]) -> Int
    <t.wait() + 1

  t = square(4)&
  u = later(<t)&
  print(<u.wait())

