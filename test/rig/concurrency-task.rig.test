test "task returned with from", seeds: 20, "2 3"
  # A task with read loans only is returned as any result is: `from v`
  # says it views `v`, so the caller keeps `xs` lent to read until it
  # waits for the task.
  # oracle: start accept
  # oracle: main accept
  fun total(v: ?List[Int]) -> Int
    n = 0
    for x in v
      n += x
    n

  fun start(v: ?List[Int]) -> Task[Int] from v
    total(v)&

  xs: List[Int] = List()
  !xs.push(1)
  !xs.push(2)
  t = start(?xs)
  print(xs.len, >t)

test "task returned", seeds: 20, "6"
  # Without `from`, the result keeps the loans of each parameter whose
  # type could hold what a task views, which may be anything.
  # oracle: start accept
  fun total(v: ?List[Int]) -> Int
    n = 0
    for x in v
      n += x
    n

  fun start(v: ?List[Int], k: Int) -> Task[Int]
    total(v)&

  xs: List[Int] = List()
  !xs.push(6)
  t = start(?xs, 1)
  print(>t)

