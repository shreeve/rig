test "task returned through a lent closure literal", seeds: 20, "3"
  # The closure's capture `?xs` is the task's loan, which `t` keeps
  # until it is waited for; the closure ends with its statement.
  # oracle: call accept
  # oracle: main accept
  fun total(v: ?List[Int]) -> Int
    n = 0
    for x in v
      n += x
    n

  fun call(f: ?fun() -> Task[Int]) -> Task[Int]
    f()

  xs: List[Int] = List()
  !xs.push(1)
  !xs.push(2)
  t = call(|?xs| total(?xs)&)
  print(>t)

fail "task returned through a lent closure literal keeps its loan", "cannot lend `xs` to write while a read loan is live", errors: 1
  # oracle: main reject C4
  fun total(v: ?List[Int]) -> Int
    v.len

  fun call(f: ?fun() -> Task[Int]) -> Task[Int]
    f()

  xs: List[Int] = List()
  t = call(|?xs| total(?xs)&)
  !xs.push(5)
  print(>t)

