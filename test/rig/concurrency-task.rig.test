test "task returned from a write view reads", seeds: 20, '''
  1
  1
'''
  # A task lent to read through a write view the function was lent is
  # returned as a result that holds no write view: the caller's write
  # lend ends at the call, and `xs` is read, not written, while the task
  # lives.
  # oracle: main accept
  fun total(v: ?List[Int]) -> Int
    v.len

  fun start(v: !List[Int]) -> Task[Int]
    !v.push(4)
    total(?v)&

  xs: List[Int] = List()
  t = start(!xs)
  print(xs.len)
  print(>t)

fail "task returned from a write view keeps it read", "cannot lend `xs` to write while a read loan is live", errors: 1
  # oracle: main reject C4
  fun total(v: ?List[Int]) -> Int
    v.len

  fun start(v: !List[Int]) -> Task[Int]
    total(?v)&

  xs: List[Int] = List()
  t = start(!xs)
  !xs.push(4)
  print(>t)

