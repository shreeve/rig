# concurrency: tests whose names start `task`.

test "task wait", seeds: 20, '''
  16 3
'''
  # `f(x)&` starts the call as a task and gives a `Task[T]` at once;
  # `>t` waits for it to end and takes its result.
  fun sq(x: Int) -> Int
    x * x

  fun total(xs: ?List[Int]) -> Int
    n = 0
    for x in xs
      n += x
    n

  xs: List[Int] = List()
  !xs.push(3)
  t = sq(4)&
  u = total(?xs)&
  print(>t, >u)

test "task read loan ends at wait", seeds: 20, '''
  1
'''
  # A task keeps its loans until it is waited for; then `xs` can be
  # lent to write again.
  fun total(xs: ?List[Int]) -> Int
    xs.len

  xs: List[Int] = List()
  u = total(?xs)&
  n = >u
  !xs.push(n)
  print(xs.len)

test "task write loan", seeds: 20, release: true, '''
  3
  3 4
'''
  # A task lent to write runs where it is bound, and is waited for there.
  sub fill(xs: !List[Int], n: Int)
    for i in 0..n
      !xs.push(i)

  fun add(xs: !List[Int], n: Int) -> Int
    !xs.push(n)
    n

  xs: List[Int] = List()
  t = fill(!xs, 3)&
  >t
  print(xs.len)
  u = add(!xs, 3)&
  n = >u
  print(n, xs.len)

test "task methods", seeds: 20, '''
  3
  3
  n is 3
'''
  # A method runs as a task with its receiver lent as the method takes
  # it: `(!c).bump(2)&` to write, `?c.get()&` to read, `(<c).into()&`
  # moved in.
  obj Counter
    n: Int

    sub bump(!@, by: Int)
      @n += by

    fun get(?@) -> Int
      @n

    fun into(<@) -> String
      String("n is ", @n)

  c = Counter(n: 1)
  t = (!c).bump(2)&
  >t
  print(c.n)
  g = ?c.get()&
  print(>g)
  v = (<c).into()&
  print(>v)

