  # The same, built for release, where the yield checks keep the
  # registers the loops hold their values in.
  fun make(n: Int) -> List[Int]
    xs: List[Int] = List()
    for i in 0..n
      !xs.push(i * 7 % 1000)
    xs

  fun fill(n: Int) -> Table[Int, 4096]
    t: Table[Int, 4096] = Table()
    for i in 0..n
      !t.push(i % 13)
    t

  fun scan(xs: ?List[Int], t: ?Table[Int, 4096]) -> Int
    total = 0
    for i in 0..xs.len
      continue if i % 3 == 0
      total += xs[i] * t[i]
    total

  fun find(xs: ?List[Int], k: Int) -> Int
    for i in 0..xs.len
      return i if xs[i] == k
    -1

  fun nested(n: Int) -> Int
    count = 0
    for i in 0..n
      for j in i..n
        count += 1 if (i + j) % 5 == 0
    count

  xs = make(3000)
  t = fill(3000)
  a = scan(?xs, ?t)&
  c = find(?xs, 993)&
  f = nested(300)&
  print(>a, >c, >f)

fail "task loan holds across yields", "15:11: cannot lend `xs` to write while a read loan is live"
  # A task reading a List in a loop holds its loan across every yield
  # check, so no task may write the List until it is done.
  sub grow(xs: !List[Int])
    !xs.push(1)

  fun sum(xs: ?List[Int]) -> Int
    total = 0
    for i in 0..xs.len
      total += xs[i]
    total

  xs: List[Int] = List()
  !xs.push(0)
  s = sum(?xs)&
  t = grow(!xs)&
  print(>s)
  >t

test "task yield keeps registers", seeds: 20, release: true, "62493449 8377345"
  # A loop's yield check calls the scheduler through a function that
  # keeps every register (`rig.callKeeping`), so the values a loop holds
  # in registers, integers, floats and vectors, come through every yield
  # to another task as they were.
  fun mix(n: Int, k: Int) -> Int
    a = k
    b = k * 3
    c = k * 5
    d = k * 7
    e = k * 11
    f = k * 13
    g = k * 17
    h = k * 19
    x = Float(k) / 3.0
    y = Float(k) / 7.0
    v = Simd[Int, 4].splat(k)
    for i in 0..n
      a = (a * 31 + i) % 1000003
      b = (b * 37 + a) % 1000033
      c = (c * 41 + b) % 1000037
      d = (d * 43 + c) % 1000039
      e = (e * 47 + d) % 1000081
      f = (f * 53 + e) % 1000099
      g = (g * 59 + f) % 1000117
      h = (h * 61 + g) % 1000121
      x = x * 0.999 + 1.0
      y = y * 0.998 + 2.0
      v = (v *% 3 ^ Simd[Int, 4].splat(i)) & Simd[Int, 4].splat(1048575)
    a + b + c + d + e + f + g + h + Int(x * 1000.0) + Int(y * 1000.0) + v[0] + v[1] + v[2] + v[3]

  ts = Tasks[Int]()
  for k in 1..9
    !ts.add(mix(50000, k)&)
  rs = >ts
  total = 0
  for r in rs
    total += r
  print(total, mix(50000, 1))

code "task free spawns free", ".spawn(spin, "
  # A task given only what crosses cores starts free, to run on any
  # worker (test/cli/task_spread.sh checks that it does).
  fun spin(n: Int) -> Int
    n

  t = spin(3)&
  print(>t)

code "task local spawns local", ".spawnLocal(peek, "
  # A task given a `*T` starts local, pinned with its maker.
  obj Node
    v: Int

  fun peek(n: ?*Node) -> Int
    n.v

  n = *Node(v: 1)
  t = peek(?n)&
  print(>t)

test "task.workers takes effect only before the first task", seeds: 20, '''
  true
  false
  false
  1
'''
  use std.task
  fun one() -> Int
    1
  print(task.workers(3))
  t = one()&
  print(task.workers(2))
  print(task.workers(0))
  print(>t)

test "task function value given", seeds: 20, "42 9 4"
  # A function value is a named function's address and holds nothing, so
  # it goes to a task on any core, alone or inside what is given or lent.
  fun inc(x: Int) -> Int
    x + 1

  fun dec(x: Int) -> Int
    x - 1

  fun use_it(f: fun(Int) -> Int) -> Int
    f(41)

  obj Box
    f: fun(Int) -> Int

  fun use_box(b: Box) -> Int
    b.f(8)

  type F = fun(Int) -> Int

  fun use_all(fs: ?List[F]) -> Int
    s = 0
    for f in fs
      s += f(1)
    s

  t = use_it(inc)&
  u = use_box(Box(f: inc))&
  fs = List[F]()
  !fs.push(inc)
  !fs.push(dec)
  !fs.push(inc)
  v = use_all(?fs)&
  print(>t, >u, >v)

code "task function value spawns", ".spawn(use_it, .{"
  fun inc(x: Int) -> Int
    x + 1

  fun use_it(f: fun(Int) -> Int) -> Int
    f(41)

  t = use_it(inc)&
  print(>t)

test "task function value results and writes", seeds: 20, "4 1 7"
  # A task gives back a function value, a fallible one crosses, and a
  # write view of a function local is lent to a task that sets it.
  fun inc(x: Int) -> Int
    x + 1

  fun dec(x: Int) -> Int
    x - 1

  error Bad
    odd

  fun half(x: Int) -> Int!
    return Bad.odd if x % 2 == 1
    x / 2

  fun pick() -> fun(Int) -> Int
    inc

  fun try_it(f: fun(Int) -> Int!) -> Int!
    f(8)!

  sub set(f: !fun(Int) -> Int)
    f = dec

  t = pick()&
  g = >t
  u = try_it(half)&
  h: fun(Int) -> Int = inc
  w = set(!h)&
  >w
  print(g(3), h(2), (>u)! + 3)

test "task function value through a channel", seeds: 20, "10"
  fun inc(x: Int) -> Int
    x + 1

  type F = fun(Int) -> Int

  fun worker(ch: *Chan[F]) -> Int!
    f = (!ch).recv()! ?? inc
    f(9)

  ch = *Chan[F](1)
  t = worker(+ch)&
  !ch.send(inc)!
  print((>t)!)

