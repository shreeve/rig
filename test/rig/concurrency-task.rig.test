# concurrency: tests whose names start `task`.

test "task wait", seeds: 20, '''
  16 3
'''
  # `f(x)&` starts the call as a task and gives a `Task[T]` at once;
  # `>t` waits for it to end and takes its result.
  fun sq(x: Int) -> Int
    x * x

  fun total(xs: ?List[Int]) -> Int
    n = 0
    for x in xs
      n += x
    n

  xs: List[Int] = List()
  !xs.push(3)
  t = sq(4)&
  u = total(?xs)&
  print(>t, >u)

test "task read loan ends at wait", seeds: 20, '''
  1
'''
  # A task keeps its loans until it is waited for; then `xs` can be
  # lent to write again.
  fun total(xs: ?List[Int]) -> Int
    xs.len

  xs: List[Int] = List()
  u = total(?xs)&
  n = >u
  !xs.push(n)
  print(xs.len)

test "task write loan", seeds: 20, release: true, '''
  3
  3 4
'''
  # A task lent to write runs where it is bound, and is waited for there.
  sub fill(xs: !List[Int], n: Int)
    for i in 0..n
      !xs.push(i)

  fun add(xs: !List[Int], n: Int) -> Int
    !xs.push(n)
    n

  xs: List[Int] = List()
  t = fill(!xs, 3)&
  >t
  print(xs.len)
  u = add(!xs, 3)&
  n = >u
  print(n, xs.len)

test "task methods", seeds: 20, '''
  3
  3
  n is 3
'''
  # A method runs as a task with its self lent as the method takes
  # it: `(!c).bump(2)&` to write, `?c.get()&` to read, `(<c).into()&`
  # moved in.
  obj Counter
    n: Int

    sub bump(!@, by: Int)
      @n += by

    fun get(?@) -> Int
      @n

    fun into(<@) -> String
      String("n is ", @n)

  c = Counter(n: 1)
  t = (!c).bump(2)&
  >t
  print(c.n)
  g = ?c.get()&
  print(>g)
  v = (<c).into()&
  print(>v)

test "task generic", seeds: 20, "[7, 7]"
  fun twice[T](x: T) -> List[T]
    out: List[T] = List()
    !out.push(x)
    !out.push(x)
    out

  w = twice[Int](7)&
  >w

test "task many", seeds: 20, release: true, '''
  101152559
'''
  # Tasks held in a List, each waited for in turn.
  fun spin(n: Int) -> Int
    total = 0
    for i in 0..n
      total = (total + i * 7) % 1000003
    total

  tasks: List[Task[Int]] = List()
  for i in 0..200
    !tasks.push(spin(100000 + i)&)
  sum = 0
  for t in <tasks
    sum += >t
  print(sum)

test "task dropped waits", seeds: 20, '''
  started
  end
  drop 1
'''
  # A task no one waits for is waited for where its scope ends, and its
  # result dropped.
  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  fun make(n: Int) -> Res
    Res(n: n)

  t = make(1)&
  print("started")
  print("end")

test "task fallible", seeds: 20, '''
  2
  -1
'''
  error Parity
    odd

  fun half(x: Int) -> Int!
    return Parity.odd if x % 2 == 1
    x / 2

  fun both(a: Int, b: Int) -> Int!
    t = half(a)&
    u = half(b)&
    x = >t!
    y = >u!
    x + y

  print(both(2, 2) catch -1)
  print(both(4, 3) catch -1)

fail "task print", "`t` is a task, which `print` cannot show: wait for what it gives, `>t`"
  # A task shows nothing of what it gives: printing one is a slip for
  # `>t`, one key from `<t`.
  fun half(x: Int) -> Int
    x / 2

  t = half(4)&
  print(<t)

test "task defer before", seeds: 20, "0"
  # A defer declared before the task runs after the task is dropped.
  fun total(xs: ?List[Int]) -> Int
    xs.len

  sub clear(xs: !List[Int])
    !xs.clear()

  xs: List[Int] = List()
  defer clear(!xs)
  u = total(?xs)&
  print(>u)

test "task prints", seeds: 20, '''
  in the task
  done
'''
  sub say()
    print("in the task")

  t = say()&
  >t
  print("done")

test "task amp spacing", seeds: 20, '''
  2 2 16
'''
  # `&` touching a `)` with nothing touching its other side starts a
  # task; with an operand touching it, or spaced, it is `and`.
  fun six() -> Int
    6

  fun sq(x: Int) -> Int
    x * x

  b = 3
  t = sq(4)& # runs while this goes on
  print(six()&b, six() & b, >t)

fail "task dropped at once", "1:1: this task is dropped as soon as it starts, which waits for it to end: bind it, `t = sq(3)&`"
  sq(3)&
  fun sq(x: Int) -> Int
    x * x

fail "task results", "a call that gives several results cannot be a task", errors: 1
  fun divmod(a: Int, b: Int) -> (Int, Int)
    return a / b, a % b

  t = divmod(17, 5)&

fail "task targets", "a task runs a call of a function or a method: `f(x)&`, `(!v).m(x)&`", errors: 2
  # A closure or a constructor is not a task's target.
  obj Node
    v: Int

  f = |x: Int| x + 1
  u = f(2)&
  v = Node(v: 3)&

fail "task targets where the type is known", "a task runs a call of a function or a method", errors: 4
  # A constructor typed by where it goes is no task's target either.
  obj P[T]
    x: T

  enum E
    v(x: Int)

  v: List[Int] = List()&
  m: Map[Int, Int] = Map()&
  p: P[Int] = P(x: 1)&
  e: E = .v(x: 1)&
  print(v.len, m.len, p.x, e)

test "task local", seeds: 20, '''
  1
  1
  3
  5050
'''
  # A task given or lent a value that stays on one thread (a `*` handle
  # whose count is not atomic, anywhere inside what it is passed) is
  # local: it and the task making it run on one thread from then on
  # (docs/design/concurrency.md, "Local tasks").
  obj Node
    v: Int

  fun val(n: ?*Node) -> Int
    n.v

  fun keep(n: *Node, k: Int) -> Int
    n.v + k

  fun count(ns: ?List[*Node]) -> Int
    ns.len

  n = *Node(v: 1)
  t = val(?n)&
  print(>t)
  u = keep(+n, 0)&
  print(>u)
  ns = List[*Node]()
  for 0..3
    !ns.push(+n)
  c = count(?ns)&
  print(>c)
  ts = Tasks[Int]()
  for k in 0..100
    !ts.add(keep(+n, k)&)
  xs = >ts
  s = 0
  for x in xs
    s += x
  print(s)

test "task local signal", seeds: 20, '''
  set 1
  set 2
  2
'''
  # A Signal and a function given stay on one thread too.
  fun inc(x: Int) -> Int
    x + 1

  sub ping(s: *Signal[Int], f: fun(Int) -> Int)
    !s.set(f(s.get()))

  sig: *Signal[Int] = *Signal(0)
  !sig.subscribe(*|~sig|
    if *sig as s
      print("set", s.get())
  )
  t = ping(+sig, inc)&
  >t
  u = ping(+sig, inc)&
  >u
  print(sig.get())

fail "task local task lent", "`?a` is lent to a task to read: `?Task[Int]` views a task, which only the one that holds it may wait for", errors: 1
  # A task moves to another task, but is never lent: only the one that
  # holds it may wait for it, even on one thread.
  fun one() -> Int
    1

  fun peek(t: ?Task[Int]) -> Int
    2

  a = one()&
  t = peek(?a)&
  print(>t, >a)

fail "task local tasks given", "`!ts` is lent to a task to write: `!Tasks[Int]` views a set of tasks, which stays with the task that made it", errors: 1
  # A set of tasks stays with the task that made it, even on one thread.
  fun one() -> Int
    1

  sub more(ts: !Tasks[Int])
    !ts.add(one()&)

  ts = Tasks[Int]()
  t = more(!ts)&
  >t

fail "task local function lent", "`?f` is lent to a task to read: `?fun(Int) -> Int` views a closure or function lent for a call, whose captures its type does not show", errors: 1
  # A function lent to read could lend what it captures to write, which
  # no two tasks may hold at once, even on one thread.
  fun call(f: ?fun(Int) -> Int) -> Int
    f(1)

  f = |x: Int| x + 1
  t = call(?f)&
  print(>t)

fail "task closure literal lent", "10:14: this closure is lent to a task to read: `?fun(Int) -> Int` views a closure or function lent for a call, whose captures its type does not show", errors: 1
  # A closure literal written in the call is lent to it, as `?f` is: its
  # captures live in the caller's block, which ends before the task does.
  fun apply(n: Int, f: ?fun(Int) -> Int) -> Int
    s = 0
    for i in 0..n
      s += f(i)
    s

  k = 7
  t = apply(3, |+k, x| x + k)&
  print(>t)

fail "task closure literal writes a capture", "this closure is lent to a task to read: `?fun(Int) -> Int` views a closure or function lent for a call", errors: 1
  # Lent to a task, a closure that writes `total` would race the maker's
  # own writes to it.
  fun apply(n: Int, f: ?fun(Int) -> Int) -> Int
    s = 0
    for i in 0..n
      s += f(i)
    s

  total = 0
  t = apply(1000, |!total, x|
    total += 1
    x
  )&
  total += 1
  print(>t, total)

fail "task result moves", "`make(1)&` may run on another core, so what it gives must be sent to the task that waits for it: `*Node` is a `*` handle whose count is not atomic, so two cores could change it at once", errors: 1
  # A task that may run on another core hands what it gives back to the
  # task that waits for it, so it moves, as `par.map`'s values do.
  obj Node
    v: Int

  fun make(v: Int) -> *Node
    *Node(v: v)

  t = make(1)&
  print((>t).v)

fail "task result holds a local task's handle", "`make()&` may run on another core, so what it gives must be sent to the task that waits for it: `Pair` holds `*Node`", errors: 1
  # A free task gives `+n` to a local task, pinned to its worker, and
  # returns `n`: the waiter, on another core, would change its count
  # while the local task does.
  obj Node
    v: Int

  obj Pair
    n: *Node
    t: Task[Int]

  fun churn(n: *Node) -> Int
    m = +n
    m.v

  fun make() -> Pair
    n = *Node(v: 1)
    t = churn(+n)&
    Pair(n: <n, t: <t)

  f = make()&
  p = >f
  print(p.n.v)

test "task local result", seeds: 20, "3"
  # A local task runs on the thread that waits for it, so what it gives
  # need not move.
  obj Node
    v: Int

  fun bump(n: *Node) -> *Node
    *Node(v: n.v + 2)

  n = *Node(v: 1)
  t = bump(+n)&
  print((>t).v)

fail "task local channel", "`+ch` is given to a task: `*Chan[*Node]` holds `*Node`, a `*` handle whose count is not atomic, so two cores could change it at once", errors: 1
  # A channel's elements go to any task that holds a handle of it, so a
  # local task's channel still carries only what crosses cores.
  obj Node
    v: Int

  fun take(ch: *Chan[*Node]) -> Int
    1

  ch = *Chan[*Node](4)
  t = take(+ch)&
  print(>t)

test "task crossing passed", seeds: 20, '''
  6
  3
  5
  7
'''
  # Each argument, and a method's self (`@`), crosses as it is passed: a
  # List lent to read shares, one lent to write moves, and self as the
  # method takes it, `?@` or `!@`.
  obj Counter
    n: Int

    fun get(?@) -> Int
      @n

    sub bump(!@, k: Int)
      @n += k

  fun total(xs: ?List[Int]) -> Int
    s = 0
    for x in xs
      s += x
    s

  sub fill(xs: !List[Int], n: Int)
    for i in 0..n
      !xs.push(i)

  xs = List[Int]()
  !xs.push(1)
  !xs.push(2)
  !xs.push(3)
  a = total(?xs)&
  print(>a)
  ys = List[Int]()
  b = fill(!ys, 3)&
  >b
  print(ys.len)
  c = Counter(n: 5)
  d = ?c.get()&
  print(>d)
  e = (!c).bump(2)&
  >e
  print(c.n)

