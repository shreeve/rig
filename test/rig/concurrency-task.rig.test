test "task returned in a set", seeds: 20, "[3, 3]"
  # A set of tasks is returned as a task is, keeping each task's loans.
  fun total(v: ?List[Int]) -> Int
    n = 0
    for x in v
      n += x
    n

  fun group(v: ?List[Int]) -> Tasks[Int] from v
    ts = Tasks[Int]()
    !ts.add(total(v)&)
    !ts.add(total(v)&)
    ts

  xs: List[Int] = List()
  !xs.push(3)
  ts = group(?xs)
  print(>ts)

fail "task returned in a set keeps its loans", "cannot lend `xs` to write while a read loan is live", errors: 1
  fun total(v: ?List[Int]) -> Int
    v.len

  fun group(v: ?List[Int]) -> Tasks[Int]
    ts = Tasks[Int]()
    !ts.add(total(v)&)
    ts

  xs: List[Int] = List()
  ts = group(?xs)
  !xs.push(3)
  print(>ts)

test "task added to a set by a function", seeds: 20, "[6]"
  # A function that adds a task lent its parameter keeps that parameter.
  fun total(v: ?List[Int]) -> Int
    n = 0
    for x in v
      n += x
    n

  sub add(ts: !Tasks[Int], v: ?List[Int]) keeps v
    !ts.add(total(v)&)

  xs: List[Int] = List()
  !xs.push(6)
  ts = Tasks[Int]()
  add(!ts, ?xs)
  print(>ts)

fail "task added to a set keeps its parameter", "`add` stores a view of `v` in `ts`, which its caller reaches, but its signature does not keep `v`; say so: `keeps v`", errors: 1
  fun total(v: ?List[Int]) -> Int
    v.len

  sub add(ts: !Tasks[Int], v: ?List[Int])
    !ts.add(total(v)&)

  print(1)

fail "task added to a set by a function keeps its loan", "cannot lend `xs` to write while a read loan is live", errors: 1
  fun total(v: ?List[Int]) -> Int
    v.len

  sub add(ts: !Tasks[Int], v: ?List[Int]) keeps v
    !ts.add(total(v)&)

  xs: List[Int] = List()
  ts = Tasks[Int]()
  add(!ts, ?xs)
  !xs.push(6)
  print(>ts)

test "task returned in an object", seeds: 20, "5"
  # oracle: mk accept
  # oracle: main accept
  obj Job
    t: Task[Int]

  fun total(v: ?List[Int]) -> Int
    n = 0
    for x in v
      n += x
    n

  fun mk(v: ?List[Int]) -> Job
    Job(t: total(v)&)

  xs: List[Int] = List()
  !xs.push(5)
  j = mk(?xs)
  t = <j.t
  print(>t)

