test "task hogs", release: true, '''
  chain 380
  waited true
  hogs 32
'''
  # Loops and recursion that never wait leave a worker often enough for
  # the work that waits behind them: a loop counts its turns toward a
  # yield check, and a recursive call checks for work left waiting
  # (docs/internals/scheduler.md). Each step queues a long loop on
  # main's worker ahead of `a`, which would wait for all of it.
  use std.time

  fun spin(n: Int) -> Int
    total = 0
    for i in 0..n
      total = (total + i * 7) % 1000003
    total

  fun fib(n: Int) -> Int
    if n < 2
      return n
    fib(n - 1) + fib(n - 2)

  fun leaf(i: Int) -> Int
    i

  hogs = Tasks[Int]()
  for i in 0..32
    if i % 2 == 0
      !hogs.add(spin(20000000 + i)&)
    else
      !hogs.add(fib(27)&)
  slices = Tasks[Int]()
  start = time.now()
  sum = 0
  for i in 0..20
    !slices.add(spin(10000000 + i)&)
    a = leaf(i)&
    b = leaf(i)&
    sum += >a
    sum += >b
  took = start.elapsed()
  print("chain", sum)
  print("waited", took < time.SECOND)
  xs = >hogs
  ys = >slices
  print("hogs", xs.len)

bomb "task stack overflow frame", "rig: stack overflow", prints: "before"
  # A task's frame larger than its whole stack stops the program with a
  # stack-overflow error before it writes anything past the stack: the
  # guard below a task's stack is at least twice the program's largest
  # frame (docs/internals/scheduler.md, "Stacks"), here `big`'s.

  fun take(a: [800000]Int, k: Int) -> Int
    a[k]

  called sub big(i: Int)
    a = [800000 of i]
    s = 0
    s += take(a, 0)
    s += take(a, 1)
    s += take(a, 2)
    s += take(a, 3)
    s += take(a, 4)
    s += take(a, 5)
    s += take(a, 6)
    s += take(a, 7)
    s += take(a, 8)
    s += take(a, 9)
    s += take(a, 10)
    s += take(a, 11)
    s += take(a, 12)
    s += take(a, 13)
    s += take(a, 14)
    s += take(a, 15)
    print(s)

  fun run(i: Int) -> Int
    big(i)
    i

  sub main()
    print("before")
    t = run(1)&
    print(>t)

bomb "task stack overflow deep frames", "rig: stack overflow", prints: "before", release: true
  # Recursion in a task whose frames are large runs out of stack in the
  # guard below it, sized from those frames, and stops the program with a
  # stack-overflow error. `--release=fast` folds the levels into a loop
  # that never ends, so the test does not build it.

  fun dive(depth: Int, prev: ?[300000]Int) -> Int
    a = [300000 of depth]
    a[depth % 1000] = prev[0]
    a[0] + dive(depth + 1, ?a)

  fun start() -> Int
    first = [300000 of 0]
    dive(0, ?first)

  sub main()
    print("before")
    t = start()&
    print(>t)

code "task free spawns free", ".spawn(spin, "
  # A task given only what crosses cores starts free, to run on any
  # worker (test/cli/task_spread.sh checks that it does).
  fun spin(n: Int) -> Int
    n

  t = spin(3)&
  print(>t)

code "task local spawns local", ".spawnLocal(peek, "
  # A task given a `*T` starts local, pinned with its maker.
  obj Node
    v: Int

  fun peek(n: ?*Node) -> Int
    n.v

  n = *Node(v: 1)
  t = peek(?n)&
  print(>t)

test "task.workers takes effect only before the first task", seeds: 20, '''
  true
  false
  false
  1
'''
  use std.task
  fun one() -> Int
    1
  print(task.workers(3))
  t = one()&
  print(task.workers(2))
  print(task.workers(0))
  print(>t)
