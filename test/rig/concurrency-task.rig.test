test "task hogs", release: true, '''
  chain 380
  waited true
  hogs 32
'''
  # Loops and recursion that never wait leave a worker often enough for
  # the work that waits behind them: a loop counts its turns toward a
  # yield check, and a recursive call checks for work left waiting
  # (docs/internals/scheduler.md). Each step queues a long loop on
  # main's worker ahead of `a`, which would wait for all of it.
  use std.time

  fun spin(n: Int) -> Int
    total = 0
    for i in 0..n
      total = (total + i * 7) % 1000003
    total

  fun fib(n: Int) -> Int
    if n < 2
      return n
    fib(n - 1) + fib(n - 2)

  # A cycle of two functions, which only one of checks.
  fun up(n: Int) -> Int
    if n < 2
      return n
    down(n - 1) + down(n - 2)

  fun down(n: Int) -> Int
    if n < 2
      return n
    up(n - 1) + up(n - 2)

  fun leaf(i: Int) -> Int
    i

  hogs = Tasks[Int]()
  for i in 0..32
    if i % 3 == 0
      !hogs.add(spin(20000000 + i)&)
    else if i % 3 == 1
      !hogs.add(fib(27)&)
    else
      !hogs.add(up(27)&)
  slices = Tasks[Int]()
  start = time.now()
  sum = 0
  for i in 0..20
    !slices.add(spin(10000000 + i)&)
    a = leaf(i)&
    b = leaf(i)&
    sum += >a
    sum += >b
  took = start.elapsed()
  print("chain", sum)
  print("waited", took < time.SECOND)
  xs = >hogs
  ys = >slices
  print("hogs", xs.len)

bomb "task stack overflow frame", "rig: stack overflow", prints: "before"
  # A task's frame larger than its whole stack stops the program with a
  # stack-overflow error before it writes anything past the stack: the
  # guard below a task's stack is at least twice the program's largest
  # frame (docs/internals/scheduler.md, "Stacks"), here `big`'s.

  fun take(a: [800000]Int, k: Int) -> Int
    a[k]

  called sub big(i: Int)
    a = [800000 of i]
    s = 0
    s += take(a, 0)
    s += take(a, 1)
    s += take(a, 2)
    s += take(a, 3)
    s += take(a, 4)
    s += take(a, 5)
    s += take(a, 6)
    s += take(a, 7)
    s += take(a, 8)
    s += take(a, 9)
    s += take(a, 10)
    s += take(a, 11)
    s += take(a, 12)
    s += take(a, 13)
    s += take(a, 14)
    s += take(a, 15)
    print(s)

  fun run(i: Int) -> Int
    big(i)
    i

  sub main()
    print("before")
    t = run(1)&
    print(>t)

bomb "task stack overflow deep frames", "rig: stack overflow", prints: "before", release: true
  # Recursion in a task whose frames are large runs out of stack in the
  # guard below it, sized from those frames, and stops the program with a
  # stack-overflow error. `--release=fast` folds the levels into a loop
  # that never ends, so the test does not build it.

  fun dive(depth: Int, prev: ?[300000]Int) -> Int
    a = [300000 of depth]
    a[depth % 1000] = prev[0]
    a[0] + dive(depth + 1, ?a)

  fun start() -> Int
    first = [300000 of 0]
    dive(0, ?first)

  sub main()
    print("before")
    t = start()&
    print(>t)

code "task one check on a cycle of calls", '''
  pub fn odd(n: i64) bool {
      @setEvalBranchQuota(rig.eval_quota);
      if (n == 0) {
'''
  # Every cycle of calls passes through a function that checks for work
  # left waiting, and only those check: of `even` and `odd`, one
  # (docs/internals/scheduler.md, "Yield checks").
  fun even(n: Int) -> Bool
    if n == 0
      return true
    odd(n - 1)

  fun odd(n: Int) -> Bool
    if n == 0
      return false
    even(n - 1)

  t = even(10)&
  print(>t)

code "task a turn counts as the next begins", "while (true) : (rig.turn(&"
  # A loop counts a turn in its continue expression, so a turn that
  # leaves the loop counts nothing.
  fun find(xs: []Int, k: Int) -> Int
    i = 0
    while i < xs.len
      if xs[i] == k
        return i
      i += 1
    -1

  t = find([1, 2, 3], 2)&
  print(>t)

test "task loops over lent containers", seeds: 20, "6100091 6100091 999 1999 1143 9030 24884"
  # Loops over a List and a Table lent to several tasks at once, long
  # enough to pass many yield checks, with `continue`, `return`, a loop
  # value's `break` and `else`, a nested loop, and small and negative
  # bounds.
  fun make(n: Int) -> List[Int]
    xs: List[Int] = List()
    for i in 0..n
      !xs.push(i * 7 % 1000)
    xs

  fun fill(n: Int) -> Table[Int, 4096]
    t: Table[Int, 4096] = Table()
    for i in 0..n
      !t.push(i % 13)
    t

  fun scan(xs: ?List[Int], t: ?Table[Int, 4096]) -> Int
    total = 0
    for i in 0..xs.len
      continue if i % 3 == 0
      total += xs[i] * t[i]
    total

  fun find(xs: ?List[Int], k: Int) -> Int
    for i in 0..xs.len
      return i if xs[i] == k
    -1

  fun first(xs: ?List[Int], k: Int) -> Int
    at = for i in 1000..xs.len
      break i if xs[i] == k
    else
      -1
    at

  fun nested(n: Int) -> Int
    count = 0
    for i in 0..n
      for j in i..n
        count += 1 if (i + j) % 5 == 0
    count

  fun small() -> Int
    total = 0
    for b in U8(0)..U8(255)
      total += Int(b)
    for i in -3000..-500
      total += i % 7
    total

  xs = make(3000)
  t = fill(3000)
  a = scan(?xs, ?t)&
  b = scan(?xs, ?t)&
  c = find(?xs, 993)&
  d = first(?xs, 993)&
  e = first(?xs, 1)&
  f = nested(300)&
  g = small()&
  print(>a, >b, >c, >d, >e, >f, >g)

