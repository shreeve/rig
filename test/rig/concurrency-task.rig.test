test "task.worker_count is at least one, deterministic runs among them", seeds: 20, "true true"
  # A deterministic run counts its one thread, so the number itself
  # differs between the runs `seeds` compares.
  use std.task
  fun one() -> Int
    1
  before = task.worker_count()
  t = one()&
  _ = >t
  print(before >= 1, task.worker_count() >= 1)

test "task.fast_cores is at least one and at most one per logical core", "true true"
  # A program with a task has one worker per logical core.
  use std.task
  fun one() -> Int
    1
  t = one()&
  _ = >t
  n = task.fast_cores()
  print(n >= 1, n <= task.worker_count())

test "task.fast_cores needs no task and gives one answer", seeds: 20, "true true"
  use std.task
  n = task.fast_cores()
  print(n >= 1, n == task.fast_cores())

test "task function value given", seeds: 20, "42 9 4"
  # A function value is a named function's address and holds nothing, so
  # it goes to a task on any core, alone or inside what is given or lent.
  fun inc(x: Int) -> Int
    x + 1

  fun dec(x: Int) -> Int
    x - 1

  fun use_it(f: fun(Int) -> Int) -> Int
    f(41)

  obj Box
    f: fun(Int) -> Int

  fun use_box(b: Box) -> Int
    b.f(8)

  type F = fun(Int) -> Int

  fun use_all(fs: ?List[F]) -> Int
    s = 0
    for f in fs
      s += f(1)
    s

  t = use_it(inc)&
  u = use_box(Box(f: inc))&
  fs = List[F]()
  !fs.push(inc)
  !fs.push(dec)
  !fs.push(inc)
  v = use_all(?fs)&
  print(>t, >u, >v)

code "task function value spawns", ".spawn(use_it, .{"
  fun inc(x: Int) -> Int
    x + 1

  fun use_it(f: fun(Int) -> Int) -> Int
    f(41)

  t = use_it(inc)&
  print(>t)

test "task function value results and writes", seeds: 20, "4 1 7"
  # A task gives back a function value, a fallible one crosses, and a
  # write view of a function local is lent to a task that sets it.
  fun inc(x: Int) -> Int
    x + 1

  fun dec(x: Int) -> Int
    x - 1

  error Bad
    odd

  fun half(x: Int) -> Int!
    return Bad.odd if x % 2 == 1
    x / 2

  fun pick() -> fun(Int) -> Int
    inc

  fun try_it(f: fun(Int) -> Int!) -> Int!
    f(8)!

  sub set(f: !fun(Int) -> Int)
    f = dec

  t = pick()&
  g = >t
  u = try_it(half)&
  h: fun(Int) -> Int = inc
  w = set(!h)&
  >w
  print(g(3), h(2), (>u)! + 3)

