    n = 0
    for x in v
      n += x
    n

  fun start(v: ?List[Int]) -> Task[Int] from v
    total(v)&

  fun later(t: Task[Int]) -> Int
    >t + 1

  fun chain(t: Task[Int]) -> Task[Int] from t
    later(<t)&

