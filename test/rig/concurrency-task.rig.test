test "task local", seeds: 20, '''
  1
  1
  3
  5050
'''
  # A task given or lent a value that stays on one thread (a `*` handle
  # whose count is not atomic, anywhere inside what it is passed) is
  # local: it and the task making it run on one thread from then on
  # (docs/design/concurrency.md, "Local tasks").
  obj Node
    v: Int

  fun val(n: ?*Node) -> Int
    n.v

  fun keep(n: *Node, k: Int) -> Int
    n.v + k

  fun count(ns: ?List[*Node]) -> Int
    ns.len

  n = *Node(v: 1)
  t = val(?n)&
  print(>t)
  u = keep(+n, 0)&
  print(>u)
  ns = List[*Node]()
  for 0..3
    !ns.push(+n)
  c = count(?ns)&
  print(>c)
  ts = Tasks[Int]()
  for k in 0..100
    !ts.add(keep(+n, k)&)
  xs = >ts
  s = 0
  for x in xs
    s += x
  print(s)

test "task local signal", seeds: 20, '''
  set 1
  set 2
  2
'''
  # A Signal and a function given stay on one thread too.
  fun inc(x: Int) -> Int
    x + 1

  sub ping(s: *Signal[Int], f: fun(Int) -> Int)
    !s.set(f(s.get()))

  sig: *Signal[Int] = *Signal(0)
  !sig.subscribe(*|~sig|
    if *sig as s
      print("set", s.get())
  )
  t = ping(+sig, inc)&
  >t
  u = ping(+sig, inc)&
  >u
  print(sig.get())

