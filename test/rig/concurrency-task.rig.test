  # A task moved to another keeps its loans for the other's whole life.
  fun total(xs: ?List[Int]) -> Int
    xs.len

  fun later(t: Task[Int]) -> Int
    <t.wait() + 1

  xs = List[Int]()
  t = total(?xs)&
  u = later(<t)&
  !xs.push(2)
  print(<u.wait())

