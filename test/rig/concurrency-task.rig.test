fail "task generic instance owned closure", "`spawn[*fun() -> Int]` cannot use `T = *fun() -> Int`: a value that holds a `T` is given to a task in the generic body, and `*fun() -> Int` is an owned closure, whose captures its type does not show", errors: 1
  # A generic body gives a task its `T`; an instance whose `T` holds an
  # owned closure is rejected where it is made, as the known type is.
  fun use1[T](x: T) -> Int
    1

  fun spawn[T](x: T) -> Int
    t = use1(<x)&
    >t

  cb: *fun() -> Int = *|| 4
  print(spawn(<cb))

