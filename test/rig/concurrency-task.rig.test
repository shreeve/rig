fail "task result holds a local task's handle", "`make()&` may run on another core, so what it gives must be sent to the task that waits for it: `Pair` holds `*Node`", errors: 1
  # A free task gives `+n` to a local task, pinned to its worker, and
  # returns `n`: the waiter, on another core, would change its count
  # while the local task does.
  obj Node
    v: Int

  obj Pair
    n: *Node
    t: Task[Int]

  fun churn(n: *Node) -> Int
    m = +n
    m.v

  fun make() -> Pair
    n = *Node(v: 1)
    t = churn(+n)&
    Pair(n: <n, t: <t)

  f = make()&
  p = >f
  print(p.n.v)

