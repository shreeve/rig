# ownership: a call through a bound is checked with the API method's
# `from` and `keeps`, which every implementation is within, never the
# instance's (docs/design/apis.md, Stage 3).

fail "apis a result from the API's parameter", "16:4: cannot drop `t` while it is lent"
  # `pick`'s result views `other`, as the API declares, so `t` stays lent
  # while `v` lives.

  api Store
    fun pick(?@, other: ?String) -> ?String from other

  obj Shelf: Store
    n: Int

    fun pick(?@, other: ?String) -> ?String from other
      other

  fun take[T: Store](s: ?T) -> Int
    t = String("ab")
    v = s.pick(?t)
    <t
    v.len

  print(take(?Shelf(n: 1)))

fail "apis the API's keeps, not the instance's", "16:3: cannot let this call store a view of `t` in `w`: `w` outlives it", "22:3: cannot let this call store a view of `t` in `y`, a `T`: a generic body tracks no view a value of a type parameter holds"
  # `Log.watch` keeps nothing, but a call through `Watcher` keeps what the
  # API says it may: `s`, stored in self, the caller's value or one this
  # body owns.

  api Watcher
    sub watch(!@, s: ?String) keeps s

  obj Log: Watcher
    n: Int

    sub watch(!@, s: ?String)
      @n += s.len

  fun run[T: Watcher](w: !T) -> Int
    t = String("ab")
    !w.watch(?t)
    t.len

  sub mine[T: Watcher](x: T)
    new y = <x
    t = String("ab")
    !y.watch(?t)

  l = Log(n: 0)
  print(run(!l))

fail "apis the API's keeps, said by the caller", "`pass_on` stores a view of `s` in `w`, which its caller reaches, but its signature does not keep `s`; say so: `keeps s`"
  # A view the caller passed in, stored through the API, is kept by the
  # signature that passes it on.

  api Watcher
    sub watch(!@, s: ?String) keeps s

  sub pass_on[T: Watcher](w: !T, s: ?String)
    !w.watch(s)

  print(1)

test "apis a bounded owner moves through a witness", '''
  closed a
  closed c
  kept b
'''
  # A `T` that owns a resource moves into a method that consumes self, and
  # one never moved is dropped where its body ends.

  api Closer
    sub close(<@)

    fun name(?@) -> ?String from @

  obj File: Closer
    title: String

    sub close(<@)
      print("closed", @title)

    fun name(?@) -> ?String from @
      ?@title

  sub shut[T: Closer](x: T)
    <x.close()

  sub keep[T: Closer](x: T, also: T)
    <also.close()
    print("kept", x.name())

  shut(File(title: String("a")))
  keep(File(title: String("b")), File(title: String("c")))

# ---- through an API object (Stage 4) ----

fail "apis object a result from self keeps the owner's loan", "cannot lend `sq` to write while a read loan is live"
  # The object carries `sq`'s loan, and the result `from @` carries the
  # object's, so `sq` stays lent while `l` lives.

  api Shape
    fun label(?@) -> ?String from @
    sub grow(!@, by: Float)

  obj Square: Shape
    name: String
    side: Float

    fun label(?@) -> ?String from @
      ?@name

    sub grow(!@, by: Float)
      @side += by

  fun label_of(s: ?{Shape}) -> ?String from s
    s.label()

  sq = Square(name: String("sq"), side: 1.0)
  l = label_of(?sq)
  !sq.grow(1.0)
  print(l)

fail "apis object keeps through a write view", "cannot drop `t` while it is lent"
  # `keeps t` through a `!{Watcher}` stores the loan in the owner the
  # object views.

  api Watcher
    sub watch(!@, t: ?String) keeps t

  obj Log: Watcher
    seen: List[?String]

    sub watch(!@, t: ?String) keeps t
      !@seen.push(t)

  sub hook(w: !{Watcher}, t: ?String) keeps t
    !w.watch(t)

  log = Log(seen: List())
  t = String("x")
  hook(!log, ?t)
  <t
  print(log.seen.len)

fail "apis object the API's keeps, not the implementation's", "`hook` stores a view of `t` in `w`, which its caller reaches, but its signature does not keep `t`; say so: `keeps t`", "cannot let this call store a view of `s` in `w`: `w` outlives it"
  # `Count.watch` keeps nothing, but a call through `!{Watcher}` keeps
  # what the API says it may: a view the caller passed in, said by the
  # signature, and none of a local.

  api Watcher
    sub watch(!@, t: ?String) keeps t

  obj Count: Watcher
    n: Int

    sub watch(!@, t: ?String)
      @n += t.len

  sub hook(w: !{Watcher}, t: ?String)
    !w.watch(t)

  sub local(w: !{Watcher})
    s = String("x")
    !w.watch(?s)

  c = Count(n: 0)
  local(!c)
  print(c.n)

fail "apis object of a temporary past its statement", "a view of the temporary `Square(side: 1.0)` outlives its statement, which drops it; bind the value to a name first"
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  s: ?{Shape} = ?Square(side: 1.0)
  print(s.area())

test "apis object ends its loan at its last use", "2.0"
  api Shape
    fun area(?@) -> Float
    sub grow(!@, by: Float)

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

    sub grow(!@, by: Float)
      @side += by

  sq = Square(side: 1.0)
  s: ?{Shape} = ?sq
  a = s.area()
  !sq.grow(a)
  print(sq.side)

# ---- Stage 4, phase 3: boxes of API objects ----
# A `^{A}`'s loans last to its drop, which may run the hidden type's
# `drop` body and read them (Core §4, sentence 6); `+ Owned` holds none.

fail "apis object box keeps a loan to its drop", "cannot lend `t` to write while a read loan is live"
  # The box's last use is before `!t.push`, but its drop, at the end of
  # the block, may read `t`.

  api Shape
    fun area(?@) -> Float

  obj Note: Shape
    text: ?String

    fun area(?@) -> Float
      1.0

  t = String("hi")
  b: ^{Shape} = ^Note(text: ?t)
  print(b.area())
  !t.push("x")
  print(t)

test "apis object box a plain box's loan ends at its last use", '''
1.0
hix
'''
  # The same value boxed as itself: its type shows no `drop` body.

  api Shape
    fun area(?@) -> Float

  obj Note: Shape
    text: ?String

    fun area(?@) -> Float
      1.0

  t = String("hi")
  b = ^Note(text: ?t)
  print(b.area())
  !t.push("x")
  print(t)

test "apis object box Owned lets the owner change after its last use", '''
1.0
hix
'''
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  t = String("hi")
  b: ^{Shape + Owned} = ^Square(side: 1.0)
  print(b.area())
  !t.push("x")
  print(t)

test "apis object box ended, its loans end", "1 1"
  api Watcher
    sub watch(!@, t: ?String) keeps t
    fun n(?@) -> Int

  obj Log: Watcher
    seen: List[?String]

    sub watch(!@, t: ?String) keeps t
      !@seen.push(t)

    fun n(?@) -> Int
      @seen.len

  t = String("hi")
  b: ^{Watcher} = ^Log(seen: List())
  !b.watch(?t)
  n = b.n()
  <b
  <t
  print(n, 1)

fail "apis object box keeps through a call", "cannot drop `t` while it is lent"
  # `!b.watch(?t)` with `keeps t`: `b` carries `t`'s loan.

  api Watcher
    sub watch(!@, t: ?String) keeps t
    fun n(?@) -> Int

  obj Log: Watcher
    seen: List[?String]

    sub watch(!@, t: ?String) keeps t
      !@seen.push(t)

    fun n(?@) -> Int
      @seen.len

  t = String("hi")
  b: ^{Watcher} = ^Log(seen: List())
  !b.watch(?t)
  print(b.n())
  <t
  print(1)

fail "apis object box made from a view keeps it", "cannot drop `t` while it is lent"
  # H1: a result `^{Shape}` of a value holding the view `t` carries its
  # loan, whatever the erased type's fields.

  api Shape
    fun area(?@) -> Float

  obj Note: Shape
    text: ?String

    fun area(?@) -> Float
      1.0

  fun mk(t: ?String) -> ^{Shape}
    ^Note(text: t)

  t = String("abc")
  b = mk(?t)
  <t
  print(b.area())

fail "apis object box a drop that reads a view", "`t` is dropped before `shapes`, whose `drop` body could still read it through this view"
  # H2: `shapes` outlives `t`, and a box's drop may read what it views.

  api Shape
    fun area(?@) -> Float

  obj Logger: Shape
    out: ?String

    fun area(?@) -> Float
      1.0

    drop(!@)
      print(@out)

  shapes: List[^{Shape}] = List()
  t = String("log")
  !shapes.push(^Logger(out: ?t))
  print(shapes.len)
