fail "r3-s36-loans-a09 match binding of view", "cannot reassign `n` while it is lent"
  enum H
    has(r: ?Int)
    no

  n = 1
  h: H = .has(r: ?n)
  match h
    .has(r)
      n = 2
      print(r)
    .no => print("no")

