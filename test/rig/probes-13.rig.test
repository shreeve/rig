  fun at(i: Int, what: ?String) -> Int
    print(what)
    i

  g: [2][2]Int = [[0, 0], [0, 0]]
  g[at(1, "first index")][at(0, "second index")] = at(5, "value")
  print(g)

test "r3-s36-emit-f09 return binding", "-1"
  # `return e` where e is an error binding: fails, but reads as returning a value.
  error E
    bad

  fun f() -> Int!
    e = E.bad
    return e

  print(f() catch -1)

test "r3-s36-emit-f13 main fail", exit: 1, '''
  1
  drop 1
'''
  # A failure that leaves main prints `error: E.name` and exits 1, after drops.
  error E
    bad

  obj N
    id: Int
    drop(!self)
      print("drop", self.id)

  fun g() -> Int!
    return E.bad

  a = N(id: 1)
  print(a.id)
  x = g()!
  print("never", x)

test "r3-s36-emit-f24 dot name", ".ok .bad .ok"
  # A bare `.bad` where `Int!` is expected: rejected per SPEC; but in a value of an enum type?
  error E
    bad

  enum C
    bad
    ok

  fun f(n: Int) -> C!
    return E.bad if n < 0
    .bad if n == 0 else .ok

  print(f(-1) catch .ok, f(0) catch .ok, f(1) catch .ok)

test "r3-s36-emit-g03 for source", "1"
  error E
    bad

  fun a() -> List[Int]!
    v = List[Int]()
    !v.push(1)
    <v

  for x in a() catch List[Int]()
    print(x)

test "r3-s36-emit-g05 opt fallible", '''
  1
  0
  99
'''
  error E
    bad

  fun a(n: Int) -> Int?!
    return E.bad if n < 0
    return none if n == 0
    n

  print(a(1)! ?? 0)
  print(a(0)! ?? 0)
  x = a(-1) catch 99
  print(x ?? 0)

test "r3-s36-emit-g06 method", '''
  0
  -1
'''
  error E
    bad

  obj S
    n: Int
    fun take(!self) -> Int!
      return E.bad if self.n == 0
      self.n -= 1
      self.n

  s = S(n: 1)
  print((!s).take() catch -1)
  print((!s).take() catch -1)

test "r3-s36-emit-s18 eqbang not", "false"
  # C habit: `ok =! done` means `ok = !done` (not). Rig: a fixed binding of `done`.
  done = false
  ok =! done
  print(ok)

