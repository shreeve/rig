test "r3-s36-loans-a11 fallible result view", "1"
  error E
    bad

  fun pick(a: ?Int, ok: Bool) -> (?Int)!
    return E.bad if not ok
    a

  n = 1
  r = pick(?n, true) catch return
  n = 2
  print(r)

fail "r3-s36-loans-a12 write loan number twice", "cannot lend `n` to write while a write loan is live"
  n = 1
  w1 = !n
  w2 = !n
  w1 += 1
  w2 += 1
  print(n)

fail "r3-s36-loans-a13 fallible view result", "cannot drop `x` while it is lent"
  error E
    bad

  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  fun pick(a: ?R, ok: Bool) -> (?R)!
    return E.bad if not ok
    a

  fun find(a: ?R, ok: Bool) -> (?R)?
    return none if not ok
    a

  x = R(n: 1)
  r = pick(?x, true) catch return
  s = find(?x, true) ?? return
  <x
  print(r.n, s.n)

test "r3-s36-loans-c01 share struct with view", '''
  1
  drop 1
'''
  # `*x` makes a counted box any handle reaches: a value holding a loan
  # may not go in.
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  a = R(n: 1)
  h = *V(r: ?a)
  print(h.r.n)

fail "r3-s36-loans-c02 share escapes scope", "`a` does not live long enough"
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  h2: *V? = none
  if true
    a = R(n: 1)
    vv = V(r: ?a)
    h = *(<vv)
    h2 = +h
  if h2 as h3
    print(h3.r.n)

fail "r3-s36-loans-c06 owned closure captures view holder", "an owned closure cannot capture `vv`, which holds a view of `a`; capture an owned value, or use a stack closure (`|...|`)"
  obj R
    n: Int

  obj V
    r: ?R

  a = R(n: 1)
  vv = V(r: ?a)
  f = *|<vv| vv.r.n
  print(f())

test "r3-s36-loans-c07 owned closure literal string", "hi rig"
  # An owned closure capturing a literal String (static on main).
  name = "rig"
  f = *|+name| print("hi", name)
  f()

fail "r3-s36-loans-c12 shared view weak upgrade", "`a` does not live long enough"
  # A weak handle to a box holding a view, upgraded after the viewed
  # value's scope ended.
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  keep = R(n: 0)
  w: ~V? = none
  hold = *V(r: ?keep)
  if true
    a = R(n: 1)
    h = *V(r: ?a)
    w = ~h
    hold = +h
  if w as ww
    if *ww as s
      print(s.r.n)
  print(hold.r.n)

fail "r3-s36-loans-c13 shared view in vec", "`a` does not live long enough"
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  hs: List[*V] = List()
  if true
    a = R(n: 1)
    !hs.push(*V(r: ?a))
  print(hs[0].r.n)

fail "r3-s36-loans-c14 owned closure captures shared view", "an owned closure cannot capture `h`, which holds a view of `a`; capture an owned value, or use a stack closure (`|...|`)"
  obj R
    n: Int

  obj V
    r: ?R

  a = R(n: 1)
  h = *V(r: ?a)
  f = *|+h| h.r.n
  print(f())

fail "r3-s36-loans-c16 shared view through fn", "`a` does not live long enough"
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  obj Keep
    h: *V

  fun wrap(h: *V) -> Keep
    Keep(h: <h)

  k: Keep? = none
  if true
    a = R(n: 1)
    k = wrap(*V(r: ?a))
  if k as kk
    print(kk.h.r.n)

fail "r3-s36-loans-f01 coalesce return keeps loan", "cannot drop `r` while it is lent"
  # `?? return` leaves; the rest stays reachable and a loan taken
  # before it must stay in force after.
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  fun f(o: Int?) -> Int
    r = R(n: 1)
    b = ?r
    k = o ?? return 0
    <r
    print(b.n, k)
    k

  print(f(3))

fail "r3-s36-loans-f02 labeled break stores inner view", "`inner` does not live long enough"
  # A labeled block's break leaves a scope; a view of a var declared
  # in it, stored into an outer var before the break, must be reported.
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  keep = R(n: 0)
  v = V(r: ?keep)
  $blk: match 1
    1
      inner = R(n: 7)
      v = V(r: ?inner)
      break $blk
    _ => print("x")
  print(v.r.n)

fail "r3-s36-loans-f03 continue stores body view", "`inner` does not live long enough"
  # `continue` leaves the body scope: a view of a body local held by
  # an outer var is used on the next iteration.
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  keep = R(n: 0)
  v = V(r: ?keep)
  i = 0
  while i < 3 : i += 1
    print(v.r.n)
    inner = R(n: i + 10)
    v = V(r: ?inner)
    if i < 5
      continue

fail "r3-s36-loans-f04 catch handler view", "`inner` does not live long enough"
  # A catch handler's local, viewed into an outer var.
  error E
    bad

  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  fun fail() -> Int!
    return E.bad

  keep = R(n: 0)
  v = V(r: ?keep)
  k = fail() catch |err|
    inner = R(n: 5)
    v = V(r: ?inner)
    0
  print(v.r.n, k)

fail "r3-s36-loans-f07 while as view escapes", "`r` does not live long enough"
  # `while … as` binding's view stored outward then the iteration ends.
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  fun next(i: !Int) -> R?
    i += 1
    if i < 3
      R(n: i)
    else
      none

  keep = R(n: 0)
  v = V(r: ?keep)
  i = 0
  while next(!i) as r
    v = V(r: ?r)
  print(v.r.n)

fail "r3-s36-loans-f08 defer stores later local", "`a` does not live long enough"
  # A defer that stores a view of a local declared after it.
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj V
    r: ?R

  keep = R(n: 0)
  v = V(r: ?keep)
  if true
    a = R(n: 1)
    defer v = V(r: ?a)
    print("in")
  print(v.r.n)

test "r3-s36-loans-f12 and rhs move", '''
  end
  drop 1
'''
  # `and` runs its right side only sometimes: a move there is a move on
  # one path only. The checker treats it as always moved; does the
  # emitted code drop `x` when the move did not happen?
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  fun take(r: R) -> Bool
    print("take", r.n)
    true

  x = R(n: 1)
  c = false
  if c and take(<x)
    print("both")
  print("end")

fail "r3-s36-loans-m01 match write copy payload", "cannot reassign `h` while it is lent"
  # A `match !h` payload of plain data is a write view into `h`; `h`
  # may not be replaced while it is live.
  enum H
    has(n: Int)
    no

  h: H = .has(n: 1)
  match !h
    .has(n)
      h = .no
      n += 1
    .no => print("no")
  print(h)

fail "r3-s36-loans-m02 if write as copy", "cannot reassign `o` while it is lent"
  o: Int? = 1
  if !o as v
    o = none
    v += 1
  print(o)

test "r3-s36-loans-m03 match read string payload", "a"
  enum H
    has(s: ?String)
    no

  h: H = .has(s: "a")
  match ?h
    .has(s)
      h = .no
      print(s)
    .no => print("no")

test "r3-s36-loans-m04 match read int payload", "1"
  # Sentence 5 says a read loan excludes a write "for numbers too", but a
  # `match ?h` payload of plain data is a copy and holds no loan.
  enum H
    has(n: Int)
    no

  h: H = .has(n: 1)
  match ?h
    .has(n)
      h = .no
      print(n)
    .no => print("no")

fail "r3-s36-loans-m05 for read int elem", "cannot assign to `xs[0]` while `xs` is lent"
  # Loop element of a read loop over plain data: a copy; the source stays
  # lent to read for the loop.
  xs = [1, 2, 3]
  for x in ?xs
    xs[0] = 9
    print(x)

test "r3-s36-loans-o01 plain read through then grow", "7 7 65"
  # A read-through of plain data ends its loan at once; a later argument
  # may then grow the List. Does the call still read the old element?
  obj P
    a: Int
    b: Int
    c: Int
    d: Int
    e: Int
    f: Int
    g: Int
    h: Int

  fun at0(ps: ?List[P]) -> ?P
    ?ps[0]

  fun grow(ps: !List[P]) -> Int
    for i in 0..64
      !ps.push(P(a: i, b: i, c: i, d: i, e: i, f: i, g: i, h: i))
    ps.len

  sub show(p: P, n: Int)
    print(p.a, p.h, n)

  ps: List[P] = List()
  !ps.push(P(a: 7, b: 7, c: 7, d: 7, e: 7, f: 7, g: 7, h: 7))
  show(at0(?ps), grow(!ps))

test "r3-s36-loans-r01 overlend key", "b 2"
  # Sentence 7 over-lends: the result views `key` too, though no
  # `?Entry` can come from a `?Key`. Editing the key while the entry is
  # in use is rejected.
  obj Entry
    name: ?String
    hits: Int

  obj Key
    id: Int

  obj Table
    rows: [3]Entry

  fun lookup(t: ?Table, k: ?Key) -> ?Entry
    ?t.rows[k.id]

  t = Table(rows: [Entry(name: "a", hits: 1), Entry(name: "b", hits: 2), Entry(name: "c", hits: 3)])
  k = Key(id: 1)
  e = lookup(?t, ?k)
  k.id = 2
  print(e.name, k.id)

test "r3-s36-loans-r02 overlend int param", "a 1"
  # The result views the `?Int` argument as well.
  obj Entry
    name: ?String

  obj Table
    rows: [2]Entry

  fun at(t: ?Table, i: ?Int) -> ?Entry
    ?t.rows[i]

  t = Table(rows: [Entry(name: "a"), Entry(name: "b")])
  i = 0
  e = at(?t, ?i)
  i += 1
  print(e.name, i)

test "r3-s36-loans-r03 overlend method arg", "a 1"
  # A `?self` method whose result can only view self still views
  # every viewed argument.
  obj Entry
    name: ?String

  obj Pick
    which: Int

  obj Table
    rows: [2]Entry

    fun get(?self, p: ?Pick) -> ?Entry
      ?self.rows[p.which]

  t = Table(rows: [Entry(name: "a"), Entry(name: "b")])
  p = Pick(which: 0)
  e = ?t.get(?p)
  p.which = 1
  print(e.name, p.which)

test "r3-s36-loans-r04 overlend write arg", '''
  1
  b
'''
  # A lent to write counter argument stays lent to write while the
  # result lives, so it cannot even be read.
  obj Entry
    name: ?String

  obj Table
    rows: [2]Entry

  fun get_counted(t: ?Table, i: Int, count: !Int) -> ?Entry
    count += 1
    ?t.rows[i]

  t = Table(rows: [Entry(name: "a"), Entry(name: "b")])
  n = 0
  e = get_counted(?t, 1, !n)
  print(n)
  print(e.name)

test "r3-s36-loans-t04 closure captures module const", "hello"
  GREETING = "hello"

  sub main()
    f = *|| print(GREETING)
    f()

test "r3-s36-loans-t11 owned closure args", "true"
  args = os.args()
  first = args[0]
  g = *|+first| print(first != "")
  g()
