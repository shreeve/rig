test "r3-s36-docs-p02 return bare moves", '''
  1
  drop 1
'''
  # WELCOME "From Rust and Zig": "a bare name never moves an owning value"
  obj Res
    n: Int

    drop(!self)
      print("drop", self.n)

  fun make(n: Int) -> Res
    r = Res(n: n)
    r

  fun pass_on(r: Res) -> Res
    return r

  a = pass_on(make(1))
  print(a.n)

fail "r3-s36-docs-p10 star bare name", "`x` owns an `S`, which can't be copied into a counted handle: write `<x` to move it"
  # Core sentence 8 says `*x` moves x; SPEC §9 requires `*<x` for a named owner
  obj S
    n: Int

    drop(!self)
      print("drop", self.n)

  x = S(n: 1)
  h = *x
  print(h.n)

