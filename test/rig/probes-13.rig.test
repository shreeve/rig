test "r3-s36-docs-p17 handle lends view", '''
  4 9
  16
'''
  # Core §4: one `fun area(s: ?Shape)` serves a Shape, a ^Shape, and a *Shape
  obj Shape
    w: Int

  fun area(s: ?Shape) -> Int
    s.w * s.w

  a = Shape(w: 2)
  b = ^Shape(w: 3)
  h = *Shape(w: 4)
  print(area(?a), area(?b))
  print(area(?h))

test "r3-s36-docs-p19 print ternary owners", '''
  R(n: 1)
  1 2
  drop 2
  drop 1
'''
  # Core §3: `print(a if c else b)` moves nothing
  obj R
    n: Int

    drop(!self)
      print("drop", self.n)

  a = R(n: 1)
  b = R(n: 2)
  c = true
  print(a if c else b)
  print(a.n, b.n)

test "r3-s36-docs-p20 print nullish owner", '''
  R(n: 1)
  false
  drop 1
'''
  # Core §3: `print(o ?? d)` moves nothing
  obj R
    n: Int

    drop(!self)
      print("drop", self.n)

  o: R? = R(n: 1)
  print(o ?? R(n: 9))
  print(o == none)

