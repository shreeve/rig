test "r3-s36-containers-br x10 split ifas", '''
  a
  b
  c
'''
  obj Split
    rest: ?String
    sep: ?String
    done: Bool

    fun next(!self) -> (?String)?
      return none if self.done
      if text.find(self.rest, self.sep) as at
        part = self.rest[..at]
        self.rest = self.rest[at + self.sep.len..]
        return part
      self.done = true
      self.rest

  t = String("a,b,c")
  s = Split(rest: ?t, sep: ",", done: false)
  while (!s).next() as p
    print(p)

test "r3-s36-containers-br x11 parse bool bare", "true false"
  print(text.parse_bool("true") catch false, text.parse_bool("x") catch false)

fail "r3-s36-containers-f02 field take", "`h.d` owns a `D`, which can't be copied by `=`: write `?h.d` to view it"
  obj D
    n: Int
    drop(!self)
      print("drop", self.n)

  obj H
    d: D
    o: D?

  h = H(d: D(n: 1), o: D(n: 2))
  h.d = D(n: 3)
  print("assigned")
  t = <h.o
  print("took")
  x = h.d

test "r3-s36-containers-f03 field owner ok", '''
  1 1
  drop 1
  assigned
  took true
  2
  drop 2
  drop 3
'''
  obj D
    n: Int
    drop(!self)
      print("drop", self.n)

  obj H
    d: D
    o: D?

  fun n_of(d: ?D) -> Int
    d.n

  h = H(d: D(n: 1), o: D(n: 2))
  print(h.d.n, n_of(?h.d))
  h.d = D(n: 3)
  print("assigned")
  t = <h.o
  print("took", h.o == none)
  if ?t as d
    print(d.n)

