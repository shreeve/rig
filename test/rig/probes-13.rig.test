test "r3-s36-containers-o02 order more", '''
  value self-vec
  index self-vec
  value self-compound
  value borrowed-vec
  index borrowed-vec
  value optional-binding
  value match-payload
  value local-wb-vec
  index local-wb-vec
  1 [2] P(x: 3, v: []) .a(n: 4) [5]
'''
  obj P
    x: Int
    v: List[Int]

    sub set(!self)
      self.v[ix(0, "self-vec")] = val(1, "self-vec")
      self.x += val(1, "self-compound")

  enum E
    a(n: Int)
    b

  fun val(n: Int, what: ?String) -> Int
    print("value", what)
    n

  fun ix(i: Int, what: ?String) -> Int
    print("index", what)
    i

  sub through_vec(w: !List[Int])
    w[ix(0, "borrowed-vec")] = val(2, "borrowed-vec")

  p = P(x: 0, v: List())
  !p.v.push(0)
  !p.set()
  through_vec(!p.v)
  o: P? = P(x: 0, v: List())
  if !o as q
    q.x = val(3, "optional-binding")
  e = E.a(n: 0)
  match !e
    .a(n) => n = val(4, "match-payload")
    .b => pass
  ws: List[Int] = List()
  !ws.push(0)
  w = !ws
  w[ix(0, "local-wb-vec")] += val(5, "local-wb-vec")
  print(p.x, p.v, o, e, ws)

fail "r3-s36-containers-o03 order moves root", "use of `v` after move"
