test "owned closure write param reentrant", '''
  rec 3 0
  rec 2 1
  rec 1 2
  rec 0 3
  rec 0 back
  rec 1 back
  rec 2 back
  rec 3 back
  4
  rec 0 4
  rec 0 back
  5
'''
  # A stored closure that writes what it is lent calls, through that, a
  # second handle to itself, three levels deep. Re-entry only reads the
  # environment, and the innermost call replaces the stored handle while
  # the outer calls run, each on a handle of its own.

  obj Checker
    n: Int
    hook: *sub(!Checker, Int)

  tag = String("rec")
  rec: *sub(!Checker, Int) = *|+tag, k, n|
    print(tag, n, k.n)
    k.n += 1
    if n > 0
      f = +k.hook
      f(!k, n - 1)
    else
      k.hook = *|j, m| j.n += 100
    print(tag, n, "back")
  c = Checker(n: 0, hook: +rec)
  rec(!c, 3)
  print(c.n)
  c.hook = <rec
  f = +c.hook
  f(!c, 0)
  print(c.n)

bomb "panic branch values", "panic: negative -1", prints: "2 zero é\n7 8\n3\n3 1", stderr: "panic_branch_values.rig:15:28: panic: negative -1", release: true
  # `panic` gives no value, so it stands for any: as a branch of a
  # ternary, a match arm, the right side of `??`, a `catch` handler, and a
  # destructuring fallback. The column counts runes: the `é` before the
  # panic counts once.

  error Bad
    no

  fun half(n: Int) -> Int
    n / 2 if n % 2 == 0 else panic("odd:", n)

  fun sign(n: Int) -> Static
    match n
      0 => "zero"
      _ => "é" if n > 0 else panic("negative", n)

  fun get(n: Int) -> Int!
    return Bad.no if n < 0
    n

  fun divmod(a: Int, b: Int) -> (Int, Int)?
    return none if b == 0
    return a / b, a % b

  sub main()
    print(half(4), sign(0), sign(2))
    o: Int? = none
    print(o ?? 7, (o ?? 7) + 1)
    x = get(3) catch panic("no value")
    print(x)
    q, r = divmod(7, 2) ?? panic("divide by zero")
    print(q, r)
    print(sign(-1))

bomb "panic statement", "panic: index 5 past 3", prints: "before 2", stderr: "panic_statement.rig:13:5: panic: index 5 past 3 [\"é\"]", release: true
  # `panic(a, b)` ends the program where it stands: what `print`
  # buffered is written out, then stderr gets `file.rig:L:C: panic: ` and
  # the line `print` would write, and the program exits 134 in every build
  # mode. No drop, `defer`, or leak check runs.

  obj Res
    name: ?String
    drop(!@)
      print("dropping", @name)

  fun pick(xs: []Int, i: Int) -> Int
    if i >= xs.len
      panic("index", i, "past", xs.len, ["é"])
    xs[i]

  sub main()
    r = Res(name: "r")
    defer print("deferred")
    xs = [1, 2, 3]
    print("before", pick(?xs[..], 1))
    list: List[Int] = List()
    !list.push(1)
    print(pick(?xs[..], 5))
    print("after", r.name)

