bomb "stack overflow frame", "rig: stack overflow", prints: "before"
  # A frame larger than the whole stack stops the program with a
  # stack-overflow error before it writes anything past the stack. `big`
  # keeps one 6.4 MB array, but a debug build holds a copy of it for each
  # argument passed by value, so its frame takes 109 MB. The stack holds
  # 64 MiB, and below it the runtime keeps a guard of 64 GiB.

  fun take(a: [800000]Int, k: Int) -> Int
    a[k]

  called sub big(i: Int)
    a = [800000 of i]
    s = 0
    s += take(a, 0)
    s += take(a, 1)
    s += take(a, 2)
    s += take(a, 3)
    s += take(a, 4)
    s += take(a, 5)
    s += take(a, 6)
    s += take(a, 7)
    s += take(a, 8)
    s += take(a, 9)
    s += take(a, 10)
    s += take(a, 11)
    s += take(a, 12)
    s += take(a, 13)
    s += take(a, 14)
    s += take(a, 15)
    print(s)

  sub main()
    print("before")
    big(1)
    print("after")

bomb "stack overflow recursion", "rig: stack overflow", prints: "before", release: true
  # Recursion that runs out of stack stops the program with a
  # stack-overflow error. Each level lends its array to the next, so debug
  # and release builds keep a frame per level. `--release=fast` folds the
  # levels into a loop that never ends, so the test does not build it.

  fun dive(depth: Int, prev: ?[1000]Int) -> Int
    a = [1000 of depth]
    a[depth % 1000] = prev[0]
    a[0] + dive(depth + 1, ?a)

  print("before")
  first = [1000 of 0]
  print(dive(0, ?first))

test "string add shapes", '''
  abcdef7x1y 10
  110
  0 true
  again!
  oneagain!
'''
  # String.add with one slice, one String, one number, and mixed parts, and
  # push across growth, give the same bytes; clear keeps the buffer for reuse.

  s = String("")
  !s.add("abc")
  !s.add(String("def"))
  !s.add(7)
  !s.add("x", 1, "y")
  print(s, s.len)
  i = 0
  while i < 100 : i += 1
    !s.push(65)
  print(s.len)
  !s.clear()
  print(s.len, s == "")
  !s.add("again")
  !s.push(33)
  print(s)
  t = String("one")
  !t.add(?s[..])
  print(t)

test "string push boundaries", release: true, '''
  true
  120860
'''
  # Every append writes at the end of the live bytes and grows when the
  # room runs out: right after `reserve`, exactly filling the reserved
  # room, one past it, and a wide push that straddles the end of it.

  ok = true
  for room in 0..40
    s = String()
    !s.reserve(room)
    for i in 0..room
      !s.push(U8(i))
    !s.push(U8(200))
    !s.push[U32, .big](0x01020304)
    !s.push[U16, .little](0xbeef)
    !s.push[U64, .little](0x1122334455667788)
    !s.add("xy")
    !s.add(String("z"))
    v: ?String = ?s
    if v.len != room + 1 + 4 + 2 + 8 + 3
      ok = false
    for i in 0..room
      if v[i] != U8(i)
        ok = false
    if v[room] != 200 or v.read[U32, .big](room + 1) != 0x01020304
      ok = false
    if v.read[U16, .little](room + 5) != 0xbeef or v.read[U64, .little](room + 7) != 0x1122334455667788
      ok = false
    if v[room + 15] != 120 or v[room + 17] != 122
      ok = false
  print(ok)

  # A List appends the same way.
  total = 0
  for room in 0..40
    l: List[Int] = List()
    !l.reserve(room)
    for i in 0..room
      !l.push(i)
    !l.push(1000)
    !l.push(2000)
    total += l.len + l[room] + l[room + 1]
  print(total)

test "string push keep", release: true, '''
  0
  abABCCD
  0
  1
  16
'''
  # `!t.push(v, keep: k)` appends the first `k` bytes of a vector, and
  # `!t.push[T, e](w, keep: k)` the first `k` of an integer's bytes, for
  # every `k` from 0 to the size, at each distance from the capacity
  # (none reserved, exactly full, one short, one over). The bytes stored
  # past the new length are spare room: a later push overwrites them, and
  # the String never shows them.

  # 32 bytes counting up from `base`.
  fun counting(base: Int) -> String
    s = String()
    for i in 0..32
      !s.push(U8(base + i))
    s

  fun block16(base: Int) -> Simd[U8, 16]
    s = counting(base)
    v: ?String = ?s
    v.read[Simd[U8, 16]](0)

  fun block32(base: Int) -> Simd[U8, 32]
    s = counting(base)
    v: ?String = ?s
    v.read[Simd[U8, 32]](0)

  bad = 0
  for room in 0..70
    for k in 0..17
      s = String()
      !s.reserve(room)
      for i in 0..room
        !s.push(U8(i))
      !s.push(block16(100), keep: k)
      !s.push(U8(7))
      v: ?String = ?s
      bad += 1 if v.len != room + k + 1
      for i in 0..room
        bad += 1 if v[i] != U8(i)
      for i in 0..k
        bad += 1 if v[room + i] != U8(100 + i)
      bad += 1 if v[room + k] != 7
    for k in 0..33
      s = String()
      !s.reserve(room)
      for i in 0..room
        !s.push(U8(i))
      !s.push(block32(50), keep: k)
      !s.add("z")
      v: ?String = ?s
      bad += 1 if v.len != room + k + 1
      for i in 0..k
        bad += 1 if v[room + i] != U8(50 + i)
      bad += 1 if v[room + k] != 122
    for k in 0..9
      s = String()
      !s.reserve(room)
      for i in 0..room
        !s.push(U8(i))
      !s.push[U64, .little](0x0807060504030201, keep: k)
      !s.push[U64, .big](0x0102030405060708, keep: k)
      v: ?String = ?s
      bad += 1 if v.len != room + 2 * k
      for i in 0..k
        bad += 1 if v[room + i] != U8(1 + i)
        bad += 1 if v[room + k + i] != U8(1 + i)
  print(bad)

  # A kept run is a prefix, appended after what is there.
  t = String("ab")
  !t.push(block16(65), keep: 3)
  !t.push[U32, .big](0x43444546, keep: 2)
  !t.push[U16, .little](0x4948, keep: 0)
  print(t)

  # The length never counts the spare bytes, and a clone copies none.
  u = String()
  !u.push(block32(200), keep: 0)
  print(u.len)
  !u.push(block32(200), keep: 1)
  w = +u
  print(w.len)
  !u.clear()
  !u.push(block16(1), keep: 16)
  print(u.len)

bomb "string push keep negative", "`keep: -1` is outside 0..16, the bytes pushed", prints: "before"
  # `keep:` outside 0..size panics, and nothing is appended first.

  s = String("abcdefghijklmnopqrstuvwxyz0123456789")
  v: ?String = ?s
  block = v.read[Simd[U8, 16]](0)
  k = s.len - 37
  print("before")
  !s.push(block, keep: k)
  print("unreachable")

bomb "string push keep over vector", "`keep: 17` is outside 0..16, the bytes pushed", prints: "before"
  # `keep:` outside 0..size panics, and nothing is appended first.

  s = String("abcdefghijklmnopqrstuvwxyz0123456789")
  v: ?String = ?s
  block = v.read[Simd[U8, 16]](0)
  k = s.len - 19
  print("before")
  !s.push(block, keep: k)
  print("unreachable")

bomb "string push keep over word", "`keep: 9` is outside 0..8, the bytes pushed", prints: "before"
  # `keep:` outside 0..size panics, and nothing is appended first.

  s = String("abcdefghijklmnopqrstuvwxyz0123456789")
  v: ?String = ?s
  word = v.read[U64, .little](0)
  k = s.len - 27
  print("before")
  !s.push[U64, .little](word, keep: k)
  print("unreachable")

test "string push wide", '''
  7 51966 3735928559 -1
  0
  0
  ABC
  34
  258 258
  16909060 16909060
  72623859790382856 72623859790382856
  -2 -2
  2200
  true
  2200
  7
'''
  # `!t.reserve(n)` makes room for `n` more bytes without changing the
  # length, and `!t.push[T, e](v)` appends the bytes of the integer `v` in
  # byte order `e`, in one write. A one-byte `T` needs no byte order.

  fun intact(v: ?String) -> Bool
    ok = true
    for i in 0..300
      if v.read[U32, .big](1000 + 4 * i) != U32(i) * 1000003
        ok = false
    for i in 0..1000
      if v[i] != U8(i % 256)
        ok = false
    ok

  sub put[T](t: !String, v: T)
    !t.push[T, .big](v)

  obj Frame
    body: String

  f = Frame(body: String())
  !f.body.reserve(8)
  !f.body.push[U16, .big](0xcafe)
  put(!f.body, U32(0xdeadbeef))
  put(!f.body, I8(-1))
  g: ?String = ?f.body
  print(g.len, g.read[U16, .big](0), g.read[U32, .big](2), g.read[I8](6))

  s = String()
  !s.reserve(0)
  print(s.len)
  !s.reserve(3)
  print(s.len)
  !s.push[U8](65)
  !s.push[I8](66)
  !s.push[U8](67)
  print(s)

  b = String()
  !b.push[U16, .little](0x0102)
  !b.push[U16, .big](0x0102)
  !b.push[U32, .little](0x01020304)
  !b.push[U32, .big](0x01020304)
  !b.push[U64, .little](0x0102030405060708)
  !b.push[U64, .big](0x0102030405060708)
  !b.push[I16, .big](-2)
  !b.push[I32, .little](-2)
  print(b.len)
  v: ?String = ?b
  print(v.read[U16, .little](0), v.read[U16, .big](2))
  print(v.read[U32, .little](4), v.read[U32, .big](8))
  print(v.read[U64, .little](12), v.read[U64, .big](20))
  print(v.read[I16, .big](28), v.read[I32, .little](30))

  # Growth boundaries: reserve, then push many, and push many unreserved.
  r = String()
  !r.reserve(1000)
  for i in 0..1000
    !r.push(U8(i % 256))
  for i in 0..300
    !r.push[U32, .big](U32(i) * 1000003)
  print(r.len)
  print(intact(?r))
  !r.reserve(5000)
  print(r.len)
  !r.push[U64, .little](7)
  w: ?String = ?r
  print(w.read[U64, .little](w.len - 8))

test "struct drop field order", '''
  built
  2
  1
'''
  # Generated drop glue drops resource fields in reverse declaration
  # order: `b` (declared second) is dropped before `a`.

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  obj Pair
    a: *Noisy
    b: *Noisy

  na = *Noisy(id: 1)
  nb = *Noisy(id: 2)
  p: Pair = Pair(a: <na, b: <nb)
  print("built")

test "struct drop glue shared field", '''
  built
  9
'''
  # A struct with a shared-handle field and no user `drop` still gets
  # compiler-generated drop glue: dropping `r` drops the Noisy it holds.

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  obj Reactor
    count: *Noisy

  n = *Noisy(id: 9)
  r: Reactor = Reactor(count: <n)
  print("built")

test "warn to stderr", stderr: "careful: 1.5 [1, 2] P(x: 3, name: \"p\")\n\na\"b [\"a\\\"b\"]", release: true, '''
  one
  two
  three
'''
  # `warn(a, b)` writes the line `print` would, to stderr, once what
  # `print` buffered is written out; the program goes on.

  obj P
    x: Int
    name: ?String

  sub main()
    print("one")
    warn("careful:", 1.5, [1, 2], P(x: 3, name: "p"))
    print("two")
    warn()
    warn("a\"b", ["a\"b"])
    print("three")

test "weak basic", '''
  7
  done
'''
  # `~rc` makes a weak handle from a shared one. Dropping the strong
  # handle first and the weak one second frees the box exactly once.

  obj Node
    value: Int

  rc = *Node(value: 7)
  w  = ~rc
  print(rc.value)
  <rc
  <w
  print("done")

test "weak owned closure", '''
  2 20
  0
  hi
  hi
  gone
'''
  # A weak handle to an owned closure (`~fun(...)`, `~sub()`) works as a
  # capture, an annotated local, a struct field, a parameter, and a List
  # element; it upgrades while the closure is alive.

  obj H
    cb: ~sub()

  sub call(w: ?~sub())
    if *w as g
      g()
    else
      print("gone")

  f: *fun(Int) -> Int = *|a| a + 1
  g: *fun(Int) -> Int = *|~f, a|
    if *f as h
      return h(a) * 10
    0
  w: ~fun(Int) -> Int = ~f
  if *w as h
    print(h(1), g(1))
  <f
  print(g(1))

  s: *sub() = *|| print("hi")
  holder = H(cb: ~s)
  call(?holder.cb)
  v: List[~sub()] = List()
  !v.push(~s)
  for x in ?v
    call(?x)
  <s
  call(?holder.cb)

test "weak star closure signal", '''
  2
  30
  true 0
  now 7
  true
'''
  # A weak handle to an owned closure (`~f`, `w: ~fun(...)`) and a signal
  # captured weakly (`|~sig|`) upgrade as every weak handle does: `*w`, a
  # new handle while the closure or signal lives, `none` after.

  f: *fun(Int) -> Int = *|a| a + 1
  w: ~fun(Int) -> Int = ~f
  if *w as g
    print(g(1))
  g: *fun(Int) -> Int = *|~f, a|
    if *f as h
      return h(a) * 10
    0
  print(g(2))
  <f
  print(*w == none, g(2))

  sig: *Signal[Int] = *Signal(0)
  !sig.subscribe(*|~sig|
    if *sig as s
      print("now", s.get())
  )
  !sig.set(7)
  ws = ~sig
  <sig
  print(*ws == none)

test "weak star upgrade", '''
  6
  true 6
  7 true
  18
  taken 7
  either 6
  gone
  false -1 true
  true
  true
  true
  true
'''
  # `*w` upgrades a weak handle: a `*T?`, a new count while the value
  # lives and `none` after. It reads `w`, a name or a view `?~T`, which
  # stays usable; `*<w` upgrades and takes `w`, which is dropped. The
  # result binds like any `*T?`: stored, defaulted with `??`, and
  # propagated with `(*w)?`.

  obj Point
    x: Int
    y: Int

  fun x_of(w: ?~Point) -> Int?
    p = (*w)?
    p.x

  fun alive(w: ?~Point) -> Bool
    if *w as p
      return p.y > 0
    false

  s = *Point(x: 6, y: 7)
  w = ~s
  if *w as p
    print(p.x)
  print(alive(?w), x_of(?w) ?? -1)
  kept = *w
  fallback = *Point(x: 0, y: 0)
  q = *w ?? +fallback
  print(q.y, kept != none)
  <q
  <kept
  ws: List[~Point] = List()
  for _ in 0..3
    !ws.push(~s)
  total = 0
  for v in ?ws
    if *v as p
      total += p.x
  print(total)
  t = ~s
  if *<t as p
    print("taken", p.y)
  t2 = ~s
  c = total > 0
  if *(?w if c else ?t2) as p
    print("either", p.x)
  <s
  if *w as p
    print(p.x)
  else
    print("gone")
  print(alive(?w), x_of(?w) ?? -1, *w == none)
  for v in ?ws
    print(*v == none)
  u = ~fallback
  <fallback
  print(*<u == none)

test "weak upgrade result dropped", '''
  rc dropped
  1
'''
  # The `*T?` returned by `*w` owns a strong handle: `m` keeps
  # the Noisy alive after `<rc` and drops it at scope exit.

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  rc = *Noisy(id: 1)
  w  = ~rc
  m = *w
  <rc
  print("rc dropped")               # `m` still holds the Noisy
  <w
  # scope exit drops `m`, the last strong handle: prints 1
