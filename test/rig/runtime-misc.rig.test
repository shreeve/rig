test "print nested text quoted", release: true, '''
  a"b\c é
  ["a\"b\\c\nd\te\rf\x01g\x7fh\xffi\u{85}j\u{202e}ké"]
  ["", "plain", "it's"]
  Note(title: "t\t", tags: ["x\ny"], by: "q\"")
  .said(text: "tab\t") .quiet
  maybe ["maybe", none]
  true
'''
  # Text printed on its own is written as it is. Text inside another value
  # (a list, an object's field, a payload, an optional) is quoted and
  # escaped, so it reads back as a Rig literal: `"` and `\` take a
  # backslash; a newline, tab, and carriage return are `\n`, `\t`, `\r`;
  # any other control byte and each byte of invalid UTF-8 is `\xHH`; a C1
  # control and a bidirectional control are `\u{h}`; every other character
  # is written as is. An object prints every field.

  obj Note
    title: String
    tags: List[String]
    by: ?String

  enum Ev
    said(text: ?String)
    quiet

  print("a\"b\\c é")
  s = "a\"b\\c\nd\te\rf\x01g\x7fh\xffi\u{85}j\u{202e}k\u{e9}"
  print([s])
  print(["", "plain", "it's"])
  tags: List[String] = List()
  !tags.push(String("x\ny"))
  n = Note(title: String("t\t"), tags: <tags, by: "q\"")
  print(n)
  print(Ev.said(text: "tab\t"), Ev.quiet)
  o: Static? = "maybe"
  p: Static? = none
  print(o, [o, p])
  print(String([s]) == "[\"a\\\"b\\\\c\\nd\\te\\rf\\x01g\\x7fh\\xffi\\u{85}j\\u{202e}k\u{e9}\"]")

test "print pieces", '''
  side 3
  side 4
  a 30 b 40
  7 rig 3 -5 false true x 7


    |
  side 1
  side 2
  before 10 5 20
  side 1
  failed
  side 5
  s7truerig 50
  s7truerig 50|7|rig|2.5|s7truerig 50  |
'''
  # `print` writes its pieces in order: every argument runs before a byte
  # is written, so a call that prints inside an argument list prints its
  # line first; a failing argument writes nothing. Constant text, Ints and
  # Bools, the spaces between arguments, and the newline join into runs of
  # text; and `String(...)` and `!t.add(...)` take the same pieces with no
  # spaces.

  N = 7
  NAME = "rig"

  error E
    bad

  fun side(n: Int) -> Int
    print("side", n)
    n * 10

  fun parse(ok: Bool) -> Int!
    if not ok
      return E.bad
    5

  sub show(ok: Bool)!
    print("before", side(1), parse(ok)!, side(2))

  sub main()
    print("a", side(3), "b", side(4))
    print(N, NAME, 1 + 2, -5, not true, 3 > 2, "x", N)
    print()
    print("")
    print("", "", "|")
    show(true) catch print("failed")
    show(false) catch print("failed")
    s = String("s", N, true, NAME, " ", side(5))
    print(s)
    t = String()
    !t.add(s, "|", N, "|", NAME, "|", 2.5, "|", s)
    print(t, String(), "|")

test "print renamed names", '''
  .rig .std .os .debug .var
  .rig(std: 1, var: 2) .os .__rig_x(v: 3)
  O(rig: 1, std: 2, debug: 3, u8: 4)
  .rig O(rig: 1, std: 2, debug: 3, u8: 4)
  .rig
  .std
  .os
  .debug
  .var
'''
  # A name the emitted Zig renames (`rig` is `@"rig'"`) prints as the
  # program wrote it: a variant, a payload variant, a field, and through
  # `String(x)` and `$variants`.

  enum K
    rig
    std
    os
    debug
    var

  enum P
    rig(std: Int, var: Int)
    os
    __rig_x(v: Int)

  obj O
    rig: Int
    std: Int
    debug: Int
    u8: Int

  print(K.rig, K.std, K.os, K.debug, K.var)
  print(P.rig(std: 1, var: 2), P.os, P.__rig_x(v: 3))
  o = O(rig: 1, std: 2, debug: 3, u8: 4)
  print(o)
  print(String(K.rig), String(o))
  for v in $variants(K)
    print(v)

test "print values", '''
  User(name: "ada", age: 36)
  hi none
  ["a", "b"] [1, 2]
  [3, 4]
  .green
  .rect(w: 2, h: 3)
  User(name: "bo", age: 5)
  true 2.5 -3
'''
  # `print` writes Rig values readably: text as is (quoted inside other
  # values), `none` for an absent optional, structs as `Name(field: value)`,
  # enums as `.variant`, and Vecs and arrays as `[a, b]`.

  obj User
    name: ?String
    age: Int

  enum Color
    red
    green

  enum Shape
    circle(radius: Int)
    rect(w: Int, h: Int)

  u = User(name: "ada", age: 36)
  print(u)
  m: (?String)? = "hi"
  n: Int? = none
  print(m, n)
  print(["a", "b"], [1, 2])
  v: List[Int] = List()
  !v.push(3)
  !v.push(4)
  print(?v)
  c: Color = .green
  print(c)
  s: Shape = .rect(w: 2, h: 3)
  print(s)
  b = *User(name: "bo", age: 5)
  print(b)
  print(true, 2.5, -3)

test "reactive canary", '''
  1
  3
  13 26
  sig 7
  sig 99
  111
  124
'''
  # The reactive substrate end to end: a Cell shared by closures, stack and
  # owned closures, a List of closures, and Signals with subscribers. A
  # subscriber that reads its own Signal holds it weakly (`|~sig|`), so the
  # Signal and its subscriber do not keep each other alive.

  # Cell: interior mutability through a shared handle.
  count: *Cell[Int] = *Cell(0)
  !count.set(1)
  print(count.get())                # 1

  # A stack closure clone-captures the cell.
  bump = |+count| !count.set(count.get() + 1)
  bump()
  bump()
  print(count.get())                # 3

  # An owned closure can be stored and passed around; this one takes an
  # argument, and the next returns a value.
  add: *sub(Int) = *|+count, n| !count.set(count.get() + n)
  add(10)
  scaled: *fun(Int) -> Int = *|+count, n| count.get() * n
  print(count.get(), scaled(2))     # 13 26

  # A Signal calls every subscriber on `set`. This subscriber reads the
  # Signal it listens to, so it holds it weakly.
  sig: *Signal[Int] = *Signal(0)
  !sig.subscribe(*|~sig|
    if *sig as s
      print("sig", s.get())
  )
  !sig.set(7)                        # sig 7
  !sig.set(99)                       # sig 99

  # A List of closures, walked by viewed slot.
  notes: *Cell[Int] = *Cell(0)
  steps: List[*sub()] = List()
  !steps.push(*|+notes| !notes.set(notes.get() + 1))
  !steps.push(*|+notes| !notes.set(notes.get() + 10))
  !steps.push(*|+notes| !notes.set(notes.get() + 100))
  for step in ?steps
    step()
  print(notes.get())                # 111

  # Subscribers run in subscription order, each with its own captures.
  tally: *Cell[Int] = *Cell(0)
  multi: *Signal[Int] = *Signal(0)
  for weight in [1, 10, 100]
    !multi.subscribe(*|+tally, +weight| !tally.set(tally.get() * 2 + weight))
  !multi.set(42)
  print(tally.get())                # ((0*2 + 1)*2 + 10)*2 + 100 = 124

test "reactive cascade", '''
  10
  70
  70
'''
  # Two reactive sources chained by a subscriber that reads one and sets
  # the other (count -> total -> print). Subscribers hold their sources
  # weakly (`|~count, ~total|`), so no source is kept alive by its own
  # subscriber list.

  type Subscribers = List[*sub()]

  obj IntSource
    value: Cell[Int]
    subs: Cell[Subscribers]

    fun new(initial: Int) -> *IntSource
      *IntSource(value: Cell(initial), subs: Cell(List()))

    fun get(?@) -> Int
      @value.get()

    sub subscribe(!@, cb: *sub())
      !@subs.push(<cb)

    # A Cell lends no view of the List inside it, so the list is swapped
    # out to be walked, and swapped back.
    sub set(!@, v: Int)
      !@value.set(v)
      subs = (!@subs).swap(List())
      for notify in ?subs
        notify()
      _ = !@subs.swap(<subs)

  count = IntSource.new(0)
  total = IntSource.new(0)

  !count.subscribe(*|~count, ~total|
    if *count as c
      if *total as t
        !t.set(c.get() * 10)
  )
  !total.subscribe(*|~total|
    if *total as t
      print(t.get())
  )

  !count.set(1)        # total becomes 10, prints 10
  !count.set(7)        # total becomes 70, prints 70
  print(total.get())  # 70

test "reactive int source", '''
  1
  7
'''
  # A userland reactive source: a `*Cell` value plus a list of subscriber
  # closures, notified on every `set`. The subscriber holds the source
  # weakly (`|~count|`), so the source's list and the closure do not keep
  # each other alive.

  type Subscribers = List[*sub()]

  obj IntSource
    value: Cell[Int]
    subs: Cell[Subscribers]

    fun new(initial: Int) -> *IntSource
      *IntSource(value: Cell(initial), subs: Cell(List()))

    fun get(?@) -> Int
      @value.get()

    sub subscribe(!@, cb: *sub())
      !@subs.push(<cb)

    # A Cell lends no view of the List inside it, so the list is swapped
    # out to be walked, and swapped back.
    sub set(!@, v: Int)
      !@value.set(v)
      subs = (!@subs).swap(List())
      for notify in ?subs
        notify()
      _ = !@subs.swap(<subs)

  count = IntSource.new(0)
  !count.subscribe(*|~count|
    if *count as c
      print(c.get())
  )
  !count.set(1)
  !count.set(7)

