  sub use_rc(rc: *Wrap)
    print(rc.payload)
    <rc

  rc = *Wrap(payload: 42)
  use_rc(<rc)
  print("moved")

bomb "signal subscribe reentrant panics", "Signal.subscribe called while notifying subscribers", prints: "before\nnotified"
  # Subscribing to a signal from inside one of its subscribers panics: the
  # subscriber list is being walked. Subscribers before the panic still ran.

  sig: *Signal[Int] = *Signal(0)
  !sig.subscribe(*|~sig|
    print("notified")
    if *sig as s
      !s.subscribe(*|| print("late"))
  )
  print("before")
  !sig.set(1)
  print("unreachable")

test "signal subscribers", '''
  0
  111
  222
'''
  # `Signal.subscribe` takes the handle the caller passes (`+cb` keeps
  # the caller's own); every subscriber runs on `set`, and all are freed
  # with the signal.

  notes: *Cell[Int] = *Cell(0)
  one:   *sub() = *|+notes| !notes.set(notes.get() + 1)
  ten:   *sub() = *|+notes| !notes.set(notes.get() + 10)
  cent:  *sub() = *|+notes| !notes.set(notes.get() + 100)

  sig: *Signal[Int] = *Signal(0)
  !sig.subscribe(+one)
  !sig.subscribe(+ten)
  !sig.subscribe(+cent)

  print(notes.get())                # 0: no notification yet
  !sig.set(1)                        # calls all three: 0 -> 111
  print(notes.get())                # 111
  !sig.set(2)                        # again: 111 -> 222
  print(notes.get())                # 222

