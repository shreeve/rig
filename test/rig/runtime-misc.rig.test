# runtime: the rest of its tests.

test "box deep list drop", "200000"
  # A singly linked list of 200,000 boxed nodes is built, counted, and
  # dropped without deep recursion: releasing a box that releases boxes is
  # queued past a fixed depth.

  obj Node
    value: Int
    next: ^Node?

  fun count(list: ?^Node?) -> Int
    n = 0
    cur = list
    while cur as node
      n += 1
      cur = ?node.next
    n

  head: ^Node? = none
  i = 0
  while i < 200000 : i += 1
    head = ^Node(value: i, next: <head)
  print(count(?head))

bomb "bytes read past end", "byte read out of range: 2 bytes at offset 3 of 4", prints: "772"
  # A `read` whose bytes run past the end panics, even by one byte.

  fun rt(n: Int) -> Int
    n

  b: [4]U8 = [1, 2, 3, 4]
  print(b.read[U16, .big](rt(2)))
  print(b.read[U16, .big](rt(3)))

bomb "bytes write past end", "byte write out of range: 2 bytes at offset -1 of 3"
  # A `write` whose bytes run past the end panics, and so does a negative
  # offset.

  fun rt(n: Int) -> Int
    n

  b: [4]U8 = [0, 0, 0, 0]
  w = !b[1..]
  !w.write[U16, .little](rt(-1), 7)

test "clone user method names", "hi hi surprise 42 7"
  # `+x` clones an object field by field, whatever its methods are named:
  # a method named like one of the runtime's (`cloneWeak`, `cloneStrong`,
  # `dropWeak`, `upgrade`) is no hook for it.

  obj O
    s: String

    fun cloneWeak(?@) -> O
      O(s: String("surprise"))

    fun cloneStrong(?@) -> Int
      42

    fun upgrade(?@) -> Int
      7

  o = O(s: String("hi"))
  xs: List[O] = List()
  !xs.push(+o)
  ys = +xs
  p = +o
  print(p.s, ys[0].s, o.cloneWeak().s, o.cloneStrong(), o.upgrade())

test "closure args", '''
  5 8
  7
  104 101
  6
  6
  tick 3
  tick 2
  tick 1
  drop 7
  8
  50
  10
  4
  end
  drop 4
  drop 9
'''
  # A `?fun` / `?sub` parameter takes a callable view: a closure
  # literal written in the call, a named stack closure lent as `?f`, a
  # function, or an owned closure lent as `?cb`. The callee calls it and
  # forwards it, here into a recursive helper. A literal's environment
  # lives for the call: one that moved a resource in drops it when the
  # call returns.

  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  sub each(xs: ?List[Int], f: ?sub(Int))
    for x in xs
      f(x)

  sub countdown(n: Int, f: ?sub(Int))
    if n > 0
      f(n)
      countdown(n - 1, f)

  sub twice_each(xs: ?List[Int], f: ?sub(Int))
    g = f
    each(xs, g)
    each(xs, f)

  fun double(n: Int) -> Int
    n * 2

  fun found(f: ?fun() -> ?Res) -> ?Res
    f()

  k = 3
  print(apply(|a| a + 1, 4), apply(double, 4))
  add_k = |+k, a: Int| a + k
  print(apply(?add_k, 4))
  inc: *fun(Int) -> Int = *|a| a + 100
  print(apply(?inc, 4), inc(1))
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  !v.push(3)
  total = 0
  each(?v, |!total, n| total += n)
  print(total)
  seen = 0
  twice_each(?v, |!seen, n| seen += 1)
  print(seen)
  countdown(3, |n| print("tick", n))
  r = Res(id: 7)
  n = apply(|<r, a| a + r.id, 1)
  print(n)
  scale = 10
  scaled = |?scale, a: Int| a * scale
  print(apply(?scaled, 5))
  owner = Res(id: 9)
  show = |<owner, a: Int| a + owner.id
  print(apply(?show, 1))
  kept = Res(id: 4)
  got = found(|?kept| kept)
  print(got.id)
  print("end")

test "closure capture calls methods", "3"
  # A closure that clone-captures a `*Cell[Int]` may call read and write
  # methods on the captured handle; each call sees the shared cell.

  count: *Cell[Int] = *Cell(0)
  bump: *sub() = *|+count| !count.set(count.get() + 1)
  bump()
  bump()
  bump()
  print(count.get())                # 3

test "closure capture clone", '''
  0
  0
  0
'''
  # `|+rc|` clone-captures a shared handle: the closure owns its own
  # strong handle, and the outer `rc` stays usable.

  rc: *Cell[Int] = *Cell(0)
  read = |+rc|
    rc.get()
  print(read())
  print(read())
  print(rc.get())

test "closure capture copy", '''
  14
  7
'''
  # `|+n|` captures a copy of a Copy value; the outer binding is
  # unaffected and still readable.

  n =! 7
  add = |+n|
    n * 2
  print(add())
  print(n)

test "closure capture move", "42"
  # `|<rc|` moves a shared handle into a stack closure; the closure can
  # be invoked and drops the handle when it goes out of scope.

  rc: *Cell[Int] = *Cell(42)
  owned = |<rc|
    rc.get()
  print(owned())

test "closure capture plain values", "4 10 5"
  # `|+x|` copies any plain value into a closure: a struct of numbers, an
  # enum, an array. Later changes to the original are not seen.

  obj Wrap
    n: Int

  enum Color
    red
    green

  b = Wrap(n: 1)
  c: Color = .green
  arr = [1, 2]
  f = |+b, +c, +arr| b.n + arr[1] + (1 if c == .green else 0)
  g: *fun() -> Int = *|+b| b.n * 10
  b.n = 5
  print(f(), g(), b.n)

test "closure capture weak", '''
  observing weak
  observing weak
  1
'''
  # `|~rc|` weak-captures a shared handle without consuming it. The
  # closure survives several calls and its weak handle is dropped before
  # the outer strong handle.

  rc: *Cell[Int] = *Cell(1)
  watch = |~rc|
    print('observing weak')
  watch()
  watch()
  print(rc.get())

test "closure captures write view", '''
  21
  84
  85
'''
  # A write view moved into a closure (`|<w|`) writes through to the
  # viewed value, on every call; a moved read view reads it.

  obj Wrap
    n: Int

  b = Wrap(n: 1)
  if true
    w = !b
    f = |<w|
      w.n += 10
    f()
    f()
  print(b.n)
  if true
    v = !b
    g = |<v|
      v.n *= 2
    g()
    g()
  print(b.n)
  r = ?b
  k = |<r| r.n + 1
  print(k())

test "closure clone captures viewed handle", '''
  vec gone
  10
  20
  300
  drop 3
  drop 2
  drop 1
'''
  # `|+b|` of a viewed handle (a `for b in ?v` element, a `?*B`
  # parameter) clones the handle into the closure, which then outlives the
  # view and the List.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  fun keep(b: ?*B) -> *fun() -> Int
    *|+b| b.n * 100

  v: List[*B] = List()
  !v.push(*B(n: 1))
  !v.push(*B(n: 2))
  fs: List[*fun() -> Int] = List()
  for b in ?v
    !fs.push(*|+b| b.n * 10)
  <v
  print("vec gone")
  for f in ?fs
    print(f())
  x = *B(n: 3)
  g = keep(?x)
  print(g())

test "closure ends with if", '''
  peek 13
  flag
'''
  # A closure body may end with an `if` that has no `else`; the closure
  # then returns nothing. Here it upgrades a weak capture.

  c: *Cell[Int] = *Cell(13)
  peek = |~c|
    if *c as h
      print("peek", h.get())
  peek()
  flag = true
  say = |+flag|
    if flag
      print("flag")
  say()

test "closure return statements", '''
  7 100 6
  4 0
  zero other
'''
  # `return` inside a closure body leaves the closure with a value. A
  # closure with no type from context returns the type of its last value,
  # or of its `return`s when it ends in one; `return` in a closure nested
  # inside another leaves only the inner one.

  clamp = |x: Int|
    if x > 100
      return 100
    x
  triple = |x: Int|
    return x * 3
  outer = |x: Int|
    inner: *fun(Int) -> Int = *|y|
      if y > 100
        return 0
      y + 1
    return inner(x) * 2
  label: *fun(Int) -> ?String = *|n|
    if n == 0
      return "zero"
    "other"
  print(clamp(7), clamp(700), triple(2))
  print(outer(1), outer(500))
  print(label(0), label(1))

test "closure returns and arity", '''
  42 2.5 5 6
  15
  negative zero positive
  5 -1
  false true
'''
  # Closures take any number of parameters and may return a value: Int,
  # Float, Bool, String, a plain enum, or an optional of one. A `return`
  # inside the body leaves the closure, not the enclosing function.

  enum Sign
    neg
    zero
    pos

  none_args: *fun() -> Int = *|| 42
  one: *fun(Float) -> Float = *|x| x / 2.0
  three: *fun(Int, Int, Bool) -> Int = *|a, b, sum| a + b if sum else a * b
  five: *fun(Int, Int, Int, Int, Int) -> Int = *|a, b, c, d, e| a + b + c + d + e
  sign: *fun(Int) -> Sign = *|n|
    if n < 0
      return .neg
    if n == 0
      return .zero
    .pos
  name: *fun(Sign) -> ?String = *|s|
    match s
      .neg => "negative"
      .zero => "zero"
      .pos => "positive"
  half: *fun(Int) -> Int? = *|n| n / 2 if n % 2 == 0 else none
  is_big = |n: Int| n > 100

  print(none_args(), one(5.0), three(2, 3, true), three(2, 3, false))
  print(five(1, 2, 3, 4, 5))
  print(name(sign(-3)), name(sign(0)), name(sign(9)))
  print(half(10) ?? -1, half(7) ?? -1)
  print(is_big(7), is_big(700))

test "consuming loop break drops rest in reverse", '''
  got 1
  drop 1
  got 2
  drop 2
  drop 4
  drop 3
  end
'''
  # A consuming loop that leaves early drops the elements it did not reach
  # last first, as dropping the List would.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  v: List[*B] = List()
  for i in 1..5
    !v.push(*B(n: i))
  for b in <v
    print("got", b.n)
    break if b.n == 2
  print("end")

bomb "convert fixed float out of range", "integer part of floating point value out of bounds", prints: "2"
  # Converting a `=!` binding is checked when the program runs, like any
  # other value: an out-of-range float panics.

  small =! 2.75
  huge =! 1e300
  print(Int(small))
  print(Int(huge))

test "deep drop keeps field order", '''
  depth 253
  drop 2
  drop 1
  depth 254
  drop 2
  drop 1
  depth 255
  drop 2
  drop 1
  depth 256
  drop 2
  drop 1
  depth 257
  drop 2
  drop 1
'''
  # Fields are dropped last first at any depth, including past the depth
  # where the runtime queues releases instead of recursing.

  obj N
    id: Int

    drop(!@)
      print("drop", @id)

  obj Node
    next: *Node?
    a: *N?
    b: *N?

  fun chain(depth: Int) -> *Node
    n = *Node(next: none, a: *N(id: 1), b: *N(id: 2))
    for _ in 0..depth
      n = *Node(next: <n, a: none, b: none)
    n

  for d in 253..258
    print("depth", d)
    h = chain(d)

test "deep list drop", "dropped down to 0"
  # Dropping a 200,000-node `*Node` list does not overflow the stack: the
  # runtime queues boxes released too deep inside other drops. Every
  # node's drop still runs exactly once, in list order, head first.

  obj Node
    value: Int
    seen: *Cell[Int]
    next: *Node?

    drop(!@)
      if @seen.get() != @value + 1
        print("out of order at", @value)
      !@seen.set(@value)

  n = 200000
  seen: *Cell[Int] = *Cell(n)
  head: *Node? = none
  i = 0
  while i < n
    head = *Node(value: i, seen: +seen, next: <head)
    i += 1
  <head
  print("dropped down to", seen.get())

test "deep stack", "2501", release: true
  # The program's stack holds 64 MiB: recursion 20 MB deep, more than the
  # 16 MiB a thread's stack holds by default, runs to the end.

  fun deep(n: Int, prev: ?[1000]Int) -> Int
    a = [1000 of n]
    a[1] = prev[1] + 1
    if n == 0
      return a[1]
    deep(n - 1, ?a)

  first = [1000 of 0]
  print(deep(2500, ?first))

test "empty array drop glue", '''
  0
  0
  true
  []
  0
  0
  0
  h
  0
'''
  # A zero-length array of a type with drop glue drops, clones, compares,
  # prints, sits in an object, passes as a slice, and returns.

  obj Holder
    tag: String
    none: [0]String

  obj Guard
    n: Int

    drop(!@)
      print("guard dropped")

  fun count(args: []String) -> Int
    args.len

  fun count_g(gs: []Guard) -> Int
    gs.len

  fun make() -> [0]String
    []

  no_args: [0]String = []
  print(count(no_args))
  copy = +no_args
  print(copy.len)
  print(no_args == copy)
  print(no_args)
  r = make()
  print(r.len)
  h = Holder(tag: String("h"), none: [])
  print(h.none.len)
  gs: [0]Guard = []
  print(count_g(gs))
  h2 = +h
  print(h2.tag)
  empty: [0]Int = []
  print(empty.len)

test "empty array drop glue more", '''
  []
  0
  0
  0
  Holder(tag: "h", none: [], lists: [], shared: [])
  0
  0
  0
  2
'''
  obj Holder
    tag: String
    none: [0]String
    lists: [0]List[Int]
    shared: [0]*Int

  fun take(a: []List[Int]) -> Int
    a.len

  fun give() -> [0]List[Int]
    []

  a: [0]List[Int] = []
  b = +a
  print(a)
  print(take(a))
  c = give()
  print(c.len)
  s: [0]*Int = []
  s2 = +s
  print(s2.len)
  h = Holder(tag: String("h"), none: [], lists: [], shared: [])
  print(h)
  h2 = +h
  print(h2.lists.len)
  nested: [0][0]String = []
  print(nested.len)
  o: [0]?String = []
  print(o.len)
  m: [2][0]String = [[], []]
  print(m.len)

test "float literal arithmetic", '''
  0.30000000000000004
  0.30000000000000004
  0.3333333333333333
'''
  # Float literal arithmetic gives the same result as the same arithmetic
  # on 64-bit values at run time.

  print(0.1 + 0.2)
  a = 0.1
  print(a + 0.2)
  print(1.0 / 3.0)

test "if as weak upgrade", '''
  alive 7
  drop 7
  gone
'''
  # `if *w as n` binds a strong handle while the value is alive;
  # the binding owns the handle and drops it when the branch ends.

  obj Noisy
    id: Int

    drop(!@)
      print("drop", @id)

  sub show(w: ?~Noisy)
    if *w as n
      print("alive", n.id)
    else
      print("gone")

  rc = *Noisy(id: 7)
  w = ~rc
  show(?w)
  <rc
  show(?w)

bomb "index wide integers", "index out of bounds", prints: "20 30\n5\n99\n[10, 30, 20]"
  # An index of any integer type, 128-bit ones included, is checked and
  # converted when the program runs.

  fun rt(n: I128) -> I128
    n

  xs = [10, 20, 30]
  i: I128 = 1
  j: U128 = 2
  print(xs[i], xs[j])
  v: List[Int] = List()
  !v.push(5)
  k: U128 = 0
  print(v[k])
  s = "abc"
  print(s[j])
  !xs.swap(i, j)
  print(xs)
  print(xs[rt(-1)])

test "main exit status", '''
  body g
  drop g
'''
  # `fun main -> Int` returns the exit status; `main`'s drops run first,
  # and the status of 0 here lets the program pass.

  obj Guard
    name: ?String

    drop(!@)
      print("drop", @name)

  fun main() -> Int
    g = Guard(name: "g")
    print("body", g.name)
    if g.name == "x"
      return 1
    0

test "main fails with error", exit: 1, stderr: "error: IoErr.eof", '''
  2 2 1
  drop 1
'''
  # A failure that leaves `main` ends the program: what it printed is
  # written out, what it owns is dropped and checked for leaks, and the
  # error is reported as Rig shows it, `IoErr.eof`, with exit status 1.
  use lib

  obj Tok
    n: Int

    drop(!@)
      print("drop", @n)

  sub main()
    t = Tok(n: 1)
    names = ["a", "b"]
    print(lib.read(2)!, names.len, t.n)
    print(lib.read(0)!)
    print("unreachable")

  file "lib.rig"
    pub error IoErr
      eof

    pub fun read(n: Int) -> Int!
      return IoErr.eof if n == 0
      n

test "main status fails", "4"
  # `fun main -> Int!` returns the exit status, or fails; one that returns
  # 0 passes.

  error Oops
    bad

  fun half(n: Int) -> Int!
    if n % 2 != 0
      return Oops.bad
    n / 2

  fun main() -> Int!
    print(half(8)!)
    half(0)!

test "main status propagates", "4"
  # `fun main -> Int` may propagate a failure with `!`, as `sub main` may.

  error Oops
    bad

  fun half(n: Int) -> Int!
    if n % 2 != 0
      return Oops.bad
    n / 2

  fun main() -> Int
    print(half(8)!)
    0

test "main sub fails", '''
  4
  0
'''
  # `sub main!` may fail; one that does not runs as `sub main` does.

  error Oops
    bad

  fun half(n: Int) -> Int!
    if n % 2 != 0
      return Oops.bad
    n / 2

  sub main()!
    print(half(8)!)
    x = half(3) catch 0
    print(x)

bomb "module constant overflow", "integer overflow", prints: "9223372036854775806"
  # Arithmetic on a module-level constant is checked when it runs, as
  # for any value.

  big = 9223372036854775807

  fun one() -> Int
    1

  sub main()
    n = one()
    print(big - n)
    print(big + n)

test "nested closure capture", '''
  2
  4
  25
  14
  2
  8
  13
  up 7
  drop 7
'''
  # A closure nested in another captures from the scope where it is created:
  # the outer closure's captures, parameters, and locals.

  obj B
    n: Int
    drop(!@)
      print("drop", @n)

  rc: *Cell[Int] = *Cell(0)
  outer = |+rc|
    inner = |+rc|
      !rc.set(rc.get() + 2)
      rc.get()
    print(inner())
    inner()
  print(outer())
  n = 3
  f = |+n, k: Int|
    m = k * 10
    g = |+n, +m, +k| n + m + k
    g()
  print(f(2))
  b = *B(n: 7)
  h: *fun() -> Int = *|+b|
    q = *|+b| b.n * 2
    q()
  print(h())
  x = Wrap(v: 1)
  r = ?x
  rd = |a: ?Wrap|
    k = a.v
    rd2 = |+k| k + 1
    rd2()
  print(rd(<r))
  wr = |+n|
    y = Wrap(v: n)
    lw = !y
    wr2 = |<lw|
      lw.v += 5
      print(lw.v)
    wr2()
    wr2()
  wr()
  w = |+b|
    ww = |~b|
      if *b as s
        print("up", s.n)
    ww()
  w()

  obj Wrap
    v: Int

test "nested struct drop glue", '''
  built
  5
'''
  # Drop glue nests: `Outer` owns an `Inner` value that owns a `*Noisy`
  # handle, so dropping `o` at scope exit drops the Noisy (its drop body
  # prints the id).

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  obj Inner
    r: *Noisy

  obj Outer
    inner: Inner

  n = *Noisy(id: 5)
  i: Inner = Inner(r: <n)
  o: Outer = Outer(inner: <i)
  print("built")

test "nested struct drop glue reversed", '''
  built
  5
'''
  # Drop glue nests even when `Outer` is declared before the `Inner` it
  # contains: dropping `o` still reaches the `*Noisy` inside `Inner`.

  obj Outer
    inner: Inner

  obj Inner
    r: *Noisy

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  n = *Noisy(id: 5)
  i: Inner = Inner(r: <n)
  o: Outer = Outer(inner: <i)
  print("built")

test "owned closure clone", "2"
  # Cloning a `*sub()` handle shares one environment: dropping the
  # original handle early leaves the clone callable, and the captured
  # cell is released only when the last handle drops.

  count: *Cell[Int] = *Cell(0)
  cb: *sub() = *|+count| !count.set(count.get() + 1)
  cb2 = +cb
  <cb
  cb2()
  cb2()
  print(count.get())                # 2

test "owned closure failure drops", '''
  drop 1
  -1
  drop 2
  2
  drop 4
  3
  drop 5
  -2
'''
  # An owned closure drops what it is given to own once, whether its body
  # returns, fails, or omits the parameter.

  obj Gone
    n: Int

    drop(!@)
      print("drop", @n)

  error Bad
    oops

  fun boom() -> Int!
    return Bad.oops

  fun later() -> Int!
    f: *fun(Gone, Int) -> Int = *|g, n| g.n + n
    f(Gone(n: 5), boom()!)

  check: *fun(Gone) -> Int! = *|g|
    if g.n == 1
      return Bad.oops
    g.n
  skip: *fun(Int, Gone) -> Int = *|a| a
  print(check(Gone(n: 1)) catch -1)
  print(check(Gone(n: 2)) catch -1)
  print(skip(3, Gone(n: 4)))
  print(later() catch -2)

test "owned closure move capture", '''
  101
  101
  end
  100
'''
  # `|<n|` moves a handle into an owned closure's environment. The closure
  # is then the only owner; the Noisy is dropped (printing its id) when the
  # closure's last handle drops at scope exit.

  obj Noisy
    id: Int

    drop(!@)
      print(@id)

  n = *Noisy(id: 100)
  cb: *sub() = *|<n| print(n.id + 1)
  cb()
  cb()
  print("end")

test "owned closure move vec", '''
  3
  3
'''
  # An owned closure that move-captures a List frees it when the last handle
  # to the closure drops.

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  !v.push(3)
  cb: *sub() = *|<v| print(v.len)
  cb()
  again = +cb
  <cb
  again()

