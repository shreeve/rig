  9
  4
  30
  now set
  hi ada
  hi ada
'''
  # Owned closures are ordinary shared handles: held in a struct field and
  # called through it, stored in a List and called for their values, held
  # in an optional, and given several parameters of different types.

  obj Button
    on_click: *sub(Int)

    sub click(?@, n: Int)
      @on_click(n)

