fail "const arithmetic unknown", "10:9: the operands of a module constant's arithmetic must be values Rig computes when it checks the program, and it does not compute `HUGE`", errors: 1
  # A module constant that branches on an enum has no value Rig computes,
  # so arithmetic on it in another constant is rejected: Zig would compute
  # it when it compiles, and stop there at an overflow Rig did not see.
  enum Mode
    fast
    slow

  MODE: Mode = .fast
  HUGE = Int.max if MODE == .fast else 0
  TWICE = HUGE * 2

  sub main()
    print(TWICE)

