test "module constant branch", '''
  4 4 big 0.5
  1 200 8 2
'''
  # A module constant may pick a branch on a constant condition, as a local
  # `=!` binding may; it folds, so a type can use it as an array length.
  # A constant picked this way is itself constant, so a later branch may
  # test it.

  N = 3
  D = 4 if N > 2 else 2
  S = "big" if N > 2 else "small"
  F = 1.5 if N > 9 else 0.5 if N > 2 else 0.25
  G = 1 if D > 3 else 0
  L: U8 = 200 if G > 0 else 100
  M: Int = D * 2 if D < 10 else -1

  sub main()
    d: [D]Int = [D of 3]
    g: [G + 1]Int = [G + 1 of 7]
    print(D, d.len, S, F)
    print(G, L, M, g.len)

fail "module constant write", "10:9: cannot lend constant `LIMIT` to write"
  # A module constant cannot be lent to write from a function: it is named a
  # constant, not a `=!` binding, in what the checkers say.

  LIMIT = 4

  sub bump(x: !Int)
    x += 1

  sub main()
    bump(!LIMIT)
    print(LIMIT)

fail "module constant write ownership", "7:3: cannot reassign constant `LIMIT`"
  # A module constant cannot be reassigned from a function: it is named a
  # constant, not a `=!` binding, in what the checkers say.

  LIMIT = 4

  sub main()
    LIMIT += 1
    print(LIMIT)

test "module constants", '''
  10 5 rig 2.5 true .slow 200 [1, 2, 3] -10
  2 30 1.25 20
  11
  3
'''
  # A module-level constant, `name = value`, is known at compile time and
  # readable from every function, wherever it is declared.

  enum Mode
    fast
    slow

  fun early(k: Int) -> Int
    k * limit

  limit = 10
  half = limit / 2
  name = "rig"
  ratio = 2.5
  on = true
  mode: Mode = .slow
  small: U8 = 200
  xs = [1, 2, 3]
  neg = -limit

  fun rep[n: Int](x: Int) -> Int
    x * n

  fun scale(k: Float) -> Float
    ratio / k

  sub main()
    print(limit, half, name, ratio, on, mode, small, xs, neg)
    print(xs[1], rep[limit](3), scale(2.0), early(2))
    f = |a: Int| a + limit
    print(f(1))
    new limit = 3
    print(limit)

test "module constants fold", '''
  4 1024 255
  4 1024 255
'''
  # A module constant folds as a local `=!` binding does, so a type can
  # use it as an array length: wrapping literals take its declared type, a
  # shift is in its left operand's type, and an alias of a number type
  # names its limits.

  type Byte = U8

  A: U8 = 250 +% 10
  B: I128 = 1 << 70
  C = B >> 60
  E = Byte.max

  sub main()
    a: [A]Int = [A of 1]
    c: [C]Int = [C of 2]
    e: [E]Int = [E of 4]
    print(A, C, E)
    print(a.len, c.len, e.len)

fail "module level binding", "14:5: a module-level constant needs a value known at compile time", "15:5: a module-level constant needs a value known at compile time", "19:8: does not fit in `Int`", "20:1: a module-level binding is a constant; write `k = value`", "22:10: parameter `big` has the same name as the module-level declaration `big`", "26:3: local `over` has the same name as the module-level declaration `over`", "28:5: a module-level constant needs a value known at compile time"
  # A module-level binding is a constant whose value is known at compile
  # time, bound once, and whose name no function reuses.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  fun f() -> Int
    3

  k = 3
  h = *B(n: 1)
  c = f()
  d = later
  later = 1
  big = 9223372036854775807
  over = big + 1
  k += 1

  fun uses(big: Int) -> Int
    big

  sub main()
    over =! 2

  t = 1 if k > 2 else f()

