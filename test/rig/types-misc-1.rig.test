test "for write copied array", "[1, 2] [2, 3] [1, 12] [2, 4, 6] [6, 7, 8]"
  # `for x in !xs` writes `xs`, however `xs` was made: a copy, an index
  # loop, a field, and a generic body's copy of a parameter.

  obj Wrap
    items: [3]Int

  fun inc[n: Int](xs: [n]Int) -> [n]Int
    out = xs
    for x in !out
      x += 1
    out

  a = [1, 2]
  out = a
  for x in !out
    x += 1
  idx = a
  for x, i in !idx
    x += i * 10
  b = Wrap(items: [1, 2, 3])
  c = b
  for x in !c.items
    x *= 2
  print(a, out, idx, c.items, inc([5, 6, 7]))

test "for write iteration", '''
  1 13
  3 9
  7
  8
  drop 1
  drop 2
  11
  12
  end
  drop 12
  drop 11
'''
  # `for x in !xs` views each element of a List or array for writing:
  # assigning `x` (or its fields) writes the element in place, and a
  # resource element that is replaced is dropped.

  obj P
    x: Int

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  obj H
    v: List[Int]

  sub bump(xs: !List[Int])
    for x in !xs
      x += 1

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  for x in !v
    x += 10
  for x, i in !v
    x = x * i
  bump(!v)
  print(v[0], v[1])

  a = [1, 2, 3]
  for y in !a
    y *= 3
  print(a[0], a[2])

  ps: List[P] = List()
  !ps.push(P(x: 1))
  for p in !ps
    p.x = 7
  print(ps[0].x)

  h = H(v: List())
  !h.v.push(4)
  for e in !h.v
    e *= 2
  print(h.v[0])

  bs: List[*B] = List()
  !bs.push(*B(n: 1))
  !bs.push(*B(n: 2))
  for b in !bs
    b = *B(n: b.n + 10)
  for b in ?bs
    print(b.n)
  for b in !bs
    <b
  print("end")

test "forward view param", "1"
  # A lent to read parameter can be forwarded: `?b` with `b: ?B` lends on
  # as `?B` rather than nesting.

  obj B
    n: Int

  fun g(b: ?B) -> Int
    b.n

  fun f(b: ?B) -> Int
    g(?b)

  x = B(n: 1)
  print(f(?x))

fail "frame guard", "10:5: `two_arrays` keeps 14400008 bytes of values on its stack; a function keeps at most 13631488 (13 MiB). Its largest: `a` (7200000 bytes), `b` (7200000 bytes)", "15:5: `two_calls` keeps 28800008 bytes", "20:5: a closure keeps 14400008 bytes"
  # A function keeps at most 13 MiB of values on its stack, so that large
  # data lives on the heap, in a box or a List. Two arrays of 7.2 MB
  # are over it, a call result a binding takes counts twice (a debug build
  # holds it in a temporary first), and a closure's body is a frame of its
  # own. The error names the largest locals.

  fun make(k: Int) -> [900000]Int
    [900000 of k]

  fun two_arrays(i: Int) -> Int
    a = [900000 of 1]
    b = [900000 of 2]
    a[i] + b[i]

  fun two_calls(i: Int) -> Int
    a = make(i)
    b = make(i + 1)
    a[i] + b[i]

  f = |k: Int|
    p = [900000 of k]
    q = [900000 of k]
    p[0] + q[0]
  print(two_arrays(1), two_calls(1), f(1))

test "frame guard limit", '''
  3 1700000
  15 800000
  7
'''
  # A function may keep up to 13 MiB of values on its stack: two arrays of
  # 6.8 MB, call results a binding takes (counted twice), and a function
  # whose frame an inlined callee would push over the limit all run.

  fun make(k: Int) -> [400000]Int
    [400000 of k]

  fun bump(i: Int) -> Int
    t = [4000 of i]
    t[i % 4000] + 1

  sub two_arrays(i: Int)
    a = [850000 of 1]
    b = [850000 of 2]
    b[i] += a[i]
    print(b[i], a.len + b.len)

  sub two_calls(i: Int)
    a = make(i)
    b = make(i + 1)
    print(a[i] + b[i], a.len + b.len)

  # `bump` is small enough to inline, but would take the frame over 13 MiB,
  # so it is called.
  sub near_limit(i: Int)
    a = [850000 of 1]
    b = [850000 of 2]
    print(bump(i) + a[i] + b[i])

  two_arrays(849999)
  two_calls(7)
  near_limit(3)

fail "frame reach", "11:5: `many` makes or copies 140800184 bytes of values, and a build may hold each in a temporary of its own on the stack, 4 times over at most; a function's code may take at most 536870912 bytes (512 MiB) of stack", errors: 1
  # A function's code may take at most 512 MiB of stack, half the smallest
  # guard below the program's stack: `reach_factor` (4) times the values it
  # keeps and every value it makes or copies, since a build may hold each
  # in a temporary of its own. `many` keeps one 6.4 MB array, within the
  # 13 MiB a frame keeps, but copies it for each of 21 arguments passed by
  # value.

  fun take(a: [800000]Int, k: Int) -> Int
    a[k]

  sub many(i: Int)
    a = [800000 of i]
    s = 0
    s += take(a, 0)
    s += take(a, 1)
    s += take(a, 2)
    s += take(a, 3)
    s += take(a, 4)
    s += take(a, 5)
    s += take(a, 6)
    s += take(a, 7)
    s += take(a, 8)
    s += take(a, 9)
    s += take(a, 10)
    s += take(a, 11)
    s += take(a, 12)
    s += take(a, 13)
    s += take(a, 14)
    s += take(a, 15)
    s += take(a, 16)
    s += take(a, 17)
    s += take(a, 18)
    s += take(a, 19)
    s += take(a, 20)
    print(s)

  many(1)

fail "frame reach defer", "8:5: `many` makes or copies", errors: 1
  # Zig writes a `defer` body again at each exit it covers, so the body
  # counts in a frame's reach once for each: here at 10 returns and the
  # end, each copying a 6.4 MB array for 3 arguments passed by value.

  fun take(a: [800000]Int, k: Int) -> Int
    a[k]

  fun many(i: Int) -> Int
    a = [800000 of i]
    defer print(take(a, 0) + take(a, 1) + take(a, 2))
    return 0 if i == 100
    return 1 if i == 101
    return 2 if i == 102
    return 3 if i == 103
    return 4 if i == 104
    return 5 if i == 105
    return 6 if i == 106
    return 7 if i == 107
    return 8 if i == 108
    return 9 if i == 109
    i

  print(many(1))

