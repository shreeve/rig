test "name of type query use", '''
  Int
  Int
  Int
  ?Int true
'''
  # `$name($type(x))` reads `x` as `$size($type(x))` does, though its name
  # is known where it is written: a binding read only there (a method's
  # `@`, a `for` capture, a closure's capture) is used.

  obj W
    v: Int

    sub show(?@)
      print($name($type(@v)))

  sub loops(xs: []Int)
    for x in xs
      print($name($type(x)))

  w = W(v: 1)
  w.show()
  xs = [1, 2]
  loops(xs)
  n = 4
  g = |?n| print($name($type(n)), $align($type(n)) > 0)
  g()

test "name of unusual instances", '''
  Node? (Node?)?
  (Node?)? ((Node?)?)?
  (Int?)? ((Int?)?)?
  [2]Int? ([2]Int?)?
  Color Color?
  fun(Int) -> Int (fun(Int) -> Int)?
  fun(Int) -> Int! (fun(Int) -> Int!)?
  ?String (?String)?
  Int Wrap[Int]
  *(Node?) ~(Node?) ^(Node?)
  *(Node?)? List[(Node?)?] ?Node?
  *[2]Int? ~[2]Int? ^[2]Int?
  (*[2]Int?)? List[([2]Int?)?] ?[2]Int?
  *((Int?)?) ~((Int?)?) ^((Int?)?)
  *((Int?)?)? List[((Int?)?)?] ?(Int?)?
  true true
  (?Node)? ?Node !Node true
'''
  # `$name` of a type parameter names its instance as the printer spells
  # it: an optional of an optional, an array of optionals, an enum, a function
  # type, one that may fail, and a generic object's own instance, each
  # under a suffix or a handle's sigil with the printer's parentheses;
  # `$size` and `$align` take the same instances, an optional of a view too.

  obj Node
    v: Int

  obj Wrap[T]
    v: T

    fun name(?@) -> ?String
      $name(T)

    fun self_name(?@) -> ?String
      $name(Self)

  enum Color
    red
    green

  sub show[T](x: T)
    print($name(T), $name(T?))

  sub shapes[T](x: T)
    print($name(*T), $name(~T), $name(^T))
    print($name((*T)?), $name(List[T?]), $name(?T))

  sub sized[T](x: T)
    print($size(T) > 0, $align(T) > 0)

  fun inc(a: Int) -> Int
    a + 1

  fun fails(a: Int) -> Int!
    a

  a: Node? = none
  show(a)
  b: (Node?)? = none
  show(b)
  c: (Int?)? = none
  show(c)
  d: [2]Int? = [1, none]
  show(d)
  show(Color.green)
  show(inc)
  show(fails)
  l: Static = "lit"
  show(l)
  w = Wrap(v: 3)
  print(w.name(), w.self_name())
  shapes(a)
  shapes(d)
  shapes(c)
  n = Node(v: 1)
  e: (?Node)? = ?n
  sized(e)
  print($name((?Node)?), $name(?Node), $name(!Node), $size((?Node)?) > 0)

fail "name of view instance", "26:1: `show[(?Node)?]` cannot use `T = (?Node)?`: the generic body names a type that holds a `T` with `$name`, which spells no view or slice in a type parameter's instance but a `?String`, and `(?Node)?` holds `?Node`", "28:1: `show[(?Int)?]` cannot use `T = (?Int)?`", "30:1: `show[[]Int]` cannot use `T = []Int`: the generic body names a type that holds a `T` with `$name`, which spells no view or slice in a type parameter's instance but a `?String`, and `[]Int` is one", "31:1: `show[fun(?Node) -> Int]` cannot use `T = fun(?Node) -> Int`", "32:5: `Wrap[(?Node)?]` cannot use `T = (?Node)?`", "35:1: `list_name[(?Int)?]` cannot use `T = (?Int)?`", errors: 6
  # `$name` of a type parameter names its instance from the instance's Zig
  # type, where a read view of a number is the number and a `[]U8` is a
  # `?String`'s bytes: an instance that holds a view or a slice, at any
  # depth, is rejected where it is made, not left to fail in Zig.

  obj Node
    v: Int

  obj Wrap[T]
    v: T

    fun name(?@) -> ?String
      $name(T)

  sub show[T](x: T)
    print($name(T))

  sub list_name[T](xs: ?List[T])
    print($name(List[T]))

  fun look(n: ?Node) -> Int
    n.v

  n = Node(v: 1)
  b: (?Node)? = ?n
  show(b)
  i: (?Int)? = none
  show(i)
  xs = [1, 2, 3]
  show(xs[0..2])
  show(look)
  w = Wrap(v: b)
  print(w.v == none)
  ys: List[(?Int)?] = List()
  list_name(ys)

