test "coalesce view value", '''
  5 7 none 6 0
  1 0 none
  4 9
  5
  .green .red
  16 3
  1 2
  none 4 9 1
  0
'''
  # `a ?? b` where `a` holds a view `?T` or `!T` of a `T` that copies, and
  # `b` is a `T`, not a view, gives a `T`: the viewed value copied out on
  # a hit, `b` on a miss, as `if a as v` then `v` else `b` would. The copy
  # keeps no loan, so the Map changes after it. `catch` does the same for
  # a fallible view, and a view held by address (a plain object) copies
  # as one held by value (an Int) does.


  error Bad
    oops

  enum Color
    red
    green

  obj P
    x: Int
    y: Int

  fun count(m: ?hash.Map[String, Int], k: ?String) -> Int
    m.get(k) ?? 0

  fun pick(r: ?P, ok: Bool) -> (?P)!
    return Bad.oops if not ok
    r

  m = hash.Map[String, Int]()
  !m.put(String("a"), 5)
  n = m.get("a") ?? 0
  k: Int = m.get("b") ?? 7
  o: Int? = m.get("b") ?? none
  !m.put(String("a"), 6)
  print(n, k, o, count(?m, "a"), count(?m, "z"))
  q = hash.Map[String, P]()
  !q.put(String("a"), P(x: 1, y: 2))
  p = q.get("a") ?? P(x: 0, y: 0)
  z = q.get("z") ?? P(x: 0, y: 0)
  w: P? = q.get("z") ?? none
  !q.put(String("a"), P(x: 3, y: 4))
  print(p.x, z.x, w)
  print((q.get("a") ?? P(x: 0, y: 0)).y, (q.get("b") ?? P(x: 8, y: 9)).y)
  c = n > 5
  print((q.get("a") ?? P(x: 0, y: 0) if c else P(x: 5, y: 5)).x)
  e = hash.Map[String, Color]()
  !e.put(String("a"), .green)
  print(e.get("a") ?? .red, e.get("b") ?? .red)
  if (!m).edit("a") as v
    v += 10
  t = (!m).edit("a") ?? 0
  !m.put(String("a"), 0)
  print(t, (!m).edit("zz") ?? 3)
  a = P(x: 1, y: 1)
  print((pick(?a, true) catch P(x: 2, y: 2)).x, (pick(?a, false) catch P(x: 2, y: 2)).x)
  nm = hash.Map[String, Int?]()
  !nm.put(String("a"), none)
  !nm.put(String("b"), 4)
  print(nm.get("a") ?? 9, nm.get("b") ?? 9, nm.get("c") ?? 9, (nm.get("a") ?? 9) ?? 1)
  print(m.get("x") ?? m.get("a") ?? 2)

fail "coalesce view value generic", "8:3: `m.get(k) ?? d` would copy out the `T` that `m.get(k)` views, since its fallback is a value, not a view; only a value that copies is copied out of a view, and `T` may not copy in every instance: lend the fallback, so the result is the view: `m.get(k) ?? ?d`", "12:5: only a value that copies is copied out of a view, and `T` may not copy in every instance", "21:3: `T` may not copy in every instance", errors: 3
  # In a generic body, `m.get(k) ?? d` with `d: T` would copy out the `T`
  # the view reaches, and a `T` may not copy in every instance, so it is
  # rejected, as the copy out `if m.get(k) as v` then `v` else `d` is,
  # whatever the instances: lend the fallback to keep the view.


  fun lookup[T](m: ?hash.Map[String, T], k: ?String, d: T) -> T
    m.get(k) ?? d

  fun lookup2[T](m: ?hash.Map[String, T], k: ?String, d: T) -> T
    if m.get(k) as v
      v
    else
      d

  fun head[T](v: ?List[T]) -> (?T)? from v
    return none if v.len == 0
    ?v[0]

  fun first_or[T](v: ?List[T], d: T) -> T
    head(v) ?? d

  m = hash.Map[String, Int]()
  e: List[Int] = List()
  print(lookup(?m, "a", 0), lookup2(?m, "a", 0), first_or(?e, 4))

fail "coalesce view value owner", "18:5: `m.get(\"a\") ?? String(\"none\")` would copy out the `String` that `m.get(\"a\")` views, since its fallback is a value, not a view; only a value that copies is copied out of a view, and a `String` owns a resource: lend the fallback, so the result is the view, and clone that for a `String` of its own: `+(m.get(\"a\") ?? ?String(\"none\"))`", "20:5: a `List[Int]` owns a resource: lend the fallback", "22:5: an `Own` owns a resource: lend the fallback, so the result is the view, and clone that for an `Own` of its own: `+(o.get(\"a\") ?? ?Own(items: List()))`", "24:5: `+(pick(?t, true) catch ?String(\"u\"))`", errors: 4
  # `a ?? b` and `a catch b` copy out the value a view on the left reaches
  # only when it copies: a String, a List, and an owning object do not,
  # and the diagnostic shows the fallback lent, which gives the view, and
  # that cloned.


  error Bad
    oops

  obj Own
    items: List[Int]

  fun pick(r: ?String, ok: Bool) -> (?String)!
    return Bad.oops if not ok
    r

  m = hash.Map[String, String]()
  s = m.get("a") ?? String("none")
  l = hash.Map[String, List[Int]]()
  e = l.get("a") ?? List[Int]()
  o = hash.Map[String, Own]()
  w = o.get("a") ?? Own(items: List())
  t = String("t")
  u = pick(?t, true) catch String("u")
  print(s, e, w.items, u)

test "coalesce view value shorthand", '''
  .circle(r: 2) .circle(r: 3) .point .point
  .circle(r: 1) .point
  P(x: 1)
'''
  # A fallback whose type only its context gives, a variant shorthand, is a
  # value made there, never a view: `m.get(k) ?? .point` copies out the
  # enum the view reaches, also for an enum with payloads, whose view is
  # held by address, in a binding, a function's last value, and `catch`.
  # A `??` in a fallback decides the same with or without its context:
  # `?q.get("y") ?? none` there gives the view.


  error Bad
    oops

  enum Shape
    circle(r: Int)
    point

  obj P
    x: Int

  fun get(m: ?hash.Map[String, Shape], k: ?String) -> Shape
    m.get(k) ?? .point

  fun pick(s: ?Shape, ok: Bool) -> (?Shape)!
    return Bad.oops if not ok
    s

  m = hash.Map[String, Shape]()
  !m.put(String("a"), .circle(r: 2))
  b: Shape = m.get("b") ?? .circle(r: 3)
  a = m.get("a") ?? .point
  !m.put(String("a"), .point)
  print(a, b, get(?m, "a"), get(?m, "z"))
  s = Shape.circle(r: 1)
  print(pick(?s, true) catch .point, pick(?s, false) catch .point)
  q = hash.Map[String, P]()
  !q.put(String("y"), P(x: 1))
  x: (?P)? = ?q.get("z") ?? (?q.get("y") ?? none)
  print(x)

