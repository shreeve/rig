test "frame runtime fill", "7"
  # A fill of a value known only when the program runs (`[800000 of i]`)
  # is built where the binding keeps it, so `f` keeps 12.8 MB of values on
  # its stack, as the frame check counts, and runs within it.

  sub f(i: Int)
    a = [800000 of i]
    b = [800000 of i + 1]
    print(a[i] + b[i])

  f(3)

fail "frame too large", "15:5: `big` keeps 24000008 bytes of values on its stack; a function keeps at most 13631488 (13 MiB)", "21:5: `params` keeps 16800000 bytes", "24:5: `temps` keeps 16800008 bytes", "33:5: `main` keeps", "37:7: a closure keeps 16800008 bytes", "43:44: `triple` keeps 16800008 bytes of values on its stack in `triple[700000]`", "42:11: `spread` keeps 16800008 bytes of values on its stack in `Ring[Int, 700000]`"
  # The values a function keeps on its stack (its locals, its by-value
  # parameters, the arrays it does not bind, and its call results) take at
  # most 13 MiB together. Closures, `main`, and each instance of a generic
  # function or type are checked the same way.

  obj Ring[T, n: Int]
    items: [n]T

    fun spread(?@) -> Int
      a = [n of 0]
      b = [n of 1]
      c = [n of 2]
      a[0] + b[0] + c[0]

  fun big(k: Int) -> Int
    a0: [1000000]Int = [1000000 of k]
    a1: [1000000]Int = [1000000 of k]
    a2: [1000000]Int = [1000000 of k]
    a0[k] + a1[k] + a2[k]

  fun params(a: [700000]Int, b: [700000]Int, c: [700000]Int) -> Int
    a[0] + b[0] + c[0]

  fun temps(k: Int) -> Int
    [700000 of k][0] + [700000 of k][1] + [700000 of k][2]

  fun triple[n: Int](k: Int) -> Int
    a = [n of k]
    b = [n of k]
    c = [n of k]
    a[0] + b[0] + c[0]

  sub main()
    x: [700000]Int = [700000 of 1]
    y: [700000]Int = [700000 of 2]
    z: [700000]Int = [700000 of 3]
    f = |k: Int|
      p: [700000]Int = [700000 of k]
      q: [700000]Int = [700000 of k]
      r: [700000]Int = [700000 of k]
      p[0] + q[0] + r[0]
    ring = *Ring[Int, 700000](items: [700000 of 0])
    print(big(1), params(x, y, z), temps(1), triple[700000](1), f(1), ring.spread())

