test "bytes read write", '''
  4660 13330
  305419896 2018915346
  1311768467463790320 17356517385562371090
  -8464 -16 240
  13330 22136 4041129114 305419896
  [190, 239, 239, 190, 254, 255, 255, 255]
  48879 48879 -2 4294967294
  [128, 0, 0, 0, 0, 0, 0, 0] -9223372036854775808
  [0, 0, 0, 0, 0, 0, 240, 63] 1.0
  -0.5 191 0 0 0
  true
  true
  16909060 1027
  7 7
  1 2 2
'''
  # `bytes.read[T, e](at)` reads the integer or float `T` from the
  # `$size(T)` bytes at `at`, in byte order `e`, and
  # `!bytes.write[T, e](at, v)` stores one. Bytes are a `[N]U8`, a
  # `[]U8` or `![]U8`, a `List[U8]`, or (to read) a String.

  fun first(b: []U8, e: Int) -> U16
    if e == 0
      b.read[U16, .little](0)
    else
      b.read[U16, .big](0)

  fun get[e: Endian](b: []U8) -> U32
    b.read[U32, e](0)

  ORDER = Endian.big

  sub main()
    b: [8]U8 = [0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0xde, 0xf0]
    print(b.read[U16, .big](0), b.read[U16, .little](0))
    print(b.read[U32, .big](0), b.read[U32, .little](0))
    print(b.read[U64, .big](0), b.read[U64, .little](0))
    print(b.read[I16, .big](6), b.read[I8](7), b.read[U8](7))
    print(first(?b[..], 0), first(?b[2..], 1), get[.little](?b[4..]), get[ORDER](?b[..]))
    w: [8]U8 = [8 of 0]
    !w.write[U16, .big](0, 0xbeef)
    !w.write[U16, .little](2, 0xbeef)
    !w.write[I32, .little](4, -2)
    print(w)
    print(w.read[U16, .big](0), w.read[U16, .little](2), w.read[I32, .little](4), w.read[U32, .little](4))
    !w.write[I64, .big](0, -9223372036854775807 - 1)
    print(w, w.read[I64, .big](0))
    !w.write[F64, .little](0, 1.0)
    print(w, w.read[F64, .little](0))
    !w.write[F32, .big](0, -0.5)
    print(w.read[F32, .big](0), w[0], w[1], w[2], w[3])
    nan: [8]U8 = [1, 0, 0, 0, 0, 0, 0xf0, 0x7f]
    x = nan.read[F64, .little](0)
    print(x != x)
    !w.write[F64, .little](0, x)
    print(w == nan)
    s = "\x01\x02\x03\x04"
    print(s.read[U32, .big](0), s[1..].read[U16, .little](1))
    v: List[U8] = List()
    for byte in b
      !v.push(byte)
    !v.write[U32, .big](4, 7)
    print(v.read[U32, .big](4), v.read[U8](7))
    t = !w[6..]
    !t.write[U16, .big](0, 0x0102)
    print(w[6], w[7], w.read[U8](7))

test "bytes wide", '''
  25349139336640152510827936922714113284 5342995718973904978025459041719882259
  28018020645823983596815188745708373766 8011877028157736064012710864714142741
  650777868590383874 144964032628459529
  1084818905618843912 579005069656919567
  -1 -1 -1
  0 1 2 16 0 0 16 15 1 0
  255 255 254 14 -2 -1329227995784915872903807060280344577
  0 1 8 8 7 254 255 255
  72623859790382856 18303195151386150664 -2
  2674114409790073892038207218725621777 25349139336640152510827936922714113284
'''
  # Reads and writes of 8- and 16-byte integers at unaligned offsets, in
  # both byte orders, agree with the bytes themselves.

  b: [40]U8 = [40 of 0]
  for i in 0..40
    b[i] = U8(i + 1)

  print(b.read[U128, .little](3), b.read[U128, .big](3))
  print(b.read[I128, .little](5), b.read[I128, .big](5))
  print(b.read[U64, .little](1), b.read[U64, .big](1))
  print(b.read[U64, .little](7), b.read[U64, .big](7))

  c: [40]U8 = [40 of 255]
  print(c.read[I128, .little](1), c.read[I128, .big](1), c.read[I64, .big](32))

  d: [40]U8 = [40 of 0]
  !d.write[U128, .little](3, 0x100f_0e0d_0c0b_0a09_0807_0605_0403_0201)
  !d.write[U128, .big](21, 0x100f_0e0d_0c0b_0a09_0807_0605_0403_0201)
  print(d[2], d[3], d[4], d[18], d[19], d[20], d[21], d[22], d[36], d[37])
  !d.write[I128, .big](0, -2)
  print(d[0], d[14], d[15], d[16], d.read[I128, .big](0), d.read[I128, .little](0))
  e: [24]U8 = [24 of 0]
  !e.write[U64, .big](1, 0x0102_0304_0506_0708)
  !e.write[U64, .little](9, 0x0102_0304_0506_0708)
  !e.write[I64, .little](16, -2)
  print(e[0], e[1], e[8], e[9], e[10], e[16], e[17], e[23])
  print(e.read[U64, .big](1), e.read[U64, .little](9), e.read[I64, .little](16))

  m: List[U8] = List()
  for i in 0..20
    !m.push(U8(i))
  print(m.read[U128, .big](2), m.read[U128, .little](4))

fail "bytes write read only", "5:3: cannot `write` a `[]U8`; its elements are read-only", "6:4: cannot lend a `[]U8` to write: its elements are read-only", "10:1: cannot `write` a `[]U8`; its elements are read-only", "12:1: cannot `write` a `?String`; a `?String` is read-only", "14:7: `read` works on bytes: a `[]U8`, an `![]U8`, a `[N]U8`, a `List[U8]`, or a `?String`; got `[4]Int`", "15:1: `write` writes the elements; lend `self` with `!`"
  # `write` needs writable bytes: not those of a read slice, a String, or
  # anything but a byte buffer; and `read` reads bytes only.

  sub f(r: []U8)
    r.write[U16, .big](0, 1)
    !r.write[U16, .big](0, 1)

  page: [8]U8 = [8 of 0]
  r = ?page[..]
  r.write[U32, .little](0, 1)
  s = "abcd"
  !s.write[U16, .big](0, 1)
  a = [1, 2, 3, 4]
  print(a.read[U16, .big](0))
  page.write[U16, .big](0, 1)

