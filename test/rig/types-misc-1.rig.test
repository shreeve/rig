fail "equality void", "6:7: `==` is not defined for `Void`: `Void` has no `==`"
  # `Void` is no value, so it has no `==`.

  sub f()
    print("f")

  print(f() == f())

test "error any type", '''
  0
  0
  3
  Net.timeout net
  Disk.full disk
  2 2 Disk.full
  first Net.timeout
  1
  true disk
  Disk.full
  error error List[error]?
  0 true
'''
  # `error` holds an error of any set, wherever a type goes: a parameter,
  # a field, a result, an optional, and a List's element. It is owning in
  # every program: `<e` moves it, `+e` clones it, and a read lends it.

  error Net
    timeout

  error Disk
    full

  fun fetch(n: Int) -> Int!
    return Net.timeout if n == 1
    return Disk.full if n == 2
    n

  obj Failure
    at: Int
    err: error

  fun describe(e: ?error) -> ?String
    match e
      Net.timeout => "net"
      Disk.full => "disk"
      _ => "other"

  fun first(fs: ?List[Failure]) -> error?
    return none if fs.len == 0
    +fs[0].err

  fun refail(e: error) -> Int!
    return e

  fun name[T]() -> ?String
    $name(T)

  fun pick(n: Int) -> error
    return Net.timeout if n == 1
    Disk.full

  seen: List[error] = List()
  log: List[Failure] = List()
  for n in [1, 2, 3]
    v = fetch(n) catch |e|
      !log.push(Failure(at: n, err: +e))
      !seen.push(<e)
      0
    print(v)
  for e in seen
    print(e, describe(?e))
  print(log.len, log[1].at, log[1].err)
  if first(?log) as f
    print("first", f)
    r = refail(<f) catch |e| 1 if e == Net.timeout else 2
    print(r)
  d = pick(2)
  print(d == Disk.full, describe(?d))
  kept: error? = none
  kept = <d
  print(kept)
  print($name(error), name[error](), name[List[error]?]())
  more = List[error]()
  print(more.len, $size(error) > 0)

test "error compare branch", '''
  true false
  true false
'''
  # `==` reads an `error` operand where it is, a branching one too: the
  # value is compared, and nothing moves.

  error X
    one
    two

  fun same(o: error?, b: error, a: error) -> Bool
    (o ?? b) == a

  fun pick(c: Bool, a: error, b: error) -> Bool
    (a if c else b) == X.one

  print(same(none, X.one, X.one), same(X.two, X.one, X.one))
  print(pick(true, X.one, X.two), pick(false, X.one, X.two))

fail "error is a type", "3:5: `error` is a type, not a value"
  # `error` is a type, not a value.

  x = error
  print(1)

test "error match move", '''
  1 10 100
  2 30 200
  2 20 300
'''
  # `match <e` takes the error a handler names: an arm naming one member,
  # alternatives, a binding of the whole, and a guarded match.

  error A
    x
    y

  error B
    z

  fun f(n: Int) -> Int!
    return A.x if n == 0
    return A.y if n == 1
    return B.z

  for n in [0, 1, 2]
    r = f(n) catch |e|
      match <e
        A.x => 1
        A.y, B.z => 2
        _ => 3
    s = f(n) catch |e|
      match <e
        A.x => 10
        other => 20 if other == B.z else 30
    t = f(n) catch |e|
      match <e
        A.x if n == 0 => 100
        q => 200 if q == A.y else 300
    print(r, s, t)

fail "error name needs its set", "28:6: error sets `Net` and `Disk` both have a member `timeout`; name the set: `Net.timeout` or `Disk.timeout`", "29:9: no member `bogus` on type `Net`", "31:5: duplicate arm for variant `Net.refused`", "33:35: error sets `Net` and `Disk` both have a member `timeout`; name the set: `Net.timeout` or `Disk.timeout`", "36:3: type mismatch: expected `Net`, got `Disk`", "41:3: a pattern names a variant without its enum: `.red`", "45:3: `s.err` is a value, which a pattern cannot name", "47:11: type mismatch: expected `Disk`, got `Net`", "48:13: cannot compare `Net` with `Disk`", errors: 9
  # An error belongs to its set. Against any error (`catch |e|`), a bare
  # `.name` is the member of the one error set that has it; when two sets
  # have it, the match arm or comparison that one of them used to satisfy
  # must name the set. A qualified pattern names a member of an error set,
  # and only one the subject can hold; a rejected `Color.red` arm still
  # covers `.red`, so it brings no second error.

  error Net
    timeout
    refused

  error Disk
    timeout

  enum Color
    red
    green

  obj S
    err: Net

  fun fetch(n: Int) -> Int!
    return Disk.timeout if n == 0
    n

  a = fetch(0) catch |e|
    match e
      .timeout => 1
      Net.bogus => 2
      Net.refused => 3
      Net.refused => 4
      _ => 5
  b = fetch(0) catch |e| 1 if e == .timeout else 2
  n: Net = .refused
  match n
    Disk.timeout => print("disk")
    .timeout => print("timeout")
    .refused => print("refused")
  c = Color.red
  match c
    Color.red => print("red")
    .green => print("green")
  s = S(err: .refused)
  match n
    s.err => print("same")
    _ => pass
  d: Disk = Net.timeout
  print(a, b, n == Disk.timeout, d)

fail "error set members", "only enums declare payload variants", "error set members have no values; write `reset`", "an error set cannot declare methods"
  # An error set lists plain members: no payloads, values, or methods.

  error NetErr
    timeout
    refused(code: Int)
    reset = 3

    fun describe(?@) -> ?String
      "err"

  e: NetErr = .timeout
  print(e)

fail "error value only through return", "11:3: an error value meets `Int!` only as the operand of `return`: write `return E.bad`", "15:5: write `return E.bad`", "22:10: write `return E.bad`", "25:3: write `return E.bad`", "30:3: write `return e`", "34:3: write `return which()`", "40:7: write `return E.bad`", errors: 7
  # Failing is always written: an error value meets a `T!` only as the
  # operand of `return`, or a branch of it, and nowhere deeper.

  error E
    bad

  fun which() -> E
    E.bad

  fun tail() -> Int!
    E.bad

  fun branch(k: Int) -> Int!
    if k > 0
      E.bad
    else
      k

  fun arm(k: Int) -> Int!
    match k
      0 => 0
      _ => E.bad

  fun ternary(k: Int) -> Int!
    E.bad if k > 0 else k

  fun named(k: Int) -> Int!
    e = E.bad
    return k if k > 0
    e

  fun called(k: Int) -> Int!
    return k if k > 0
    which()

  fun deeper(k: Int) -> Int!
    return match k
      0
        print("zero")
        E.bad
      _ => k

  print(tail() catch 0, branch(1) catch 0, arm(1) catch 0, ternary(1) catch 0)
  print(named(0) catch 0, called(0) catch 0, deeper(1) catch 0)

fail "error values checked", "type mismatch: expected `Int`, got `ParseError`", "no error set has a member `missing`", "`match` on `error` is not exhaustive; add `_ =>`", "type mismatch: expected `Int`, got `error`", "operator `+` requires numeric operands; got `error`", "cannot compare `error` with `Int`", "an error has no payload to destructure; match it as `.empty`"
  # Only a fallible function fails with an error value. The error
  # `catch |err|` names may be any error: it is matched by the names of
  # error-set members, with a default arm, and it
  # is not a number or the fallback value.

  error ParseError
    empty

  fun plain(n: Int) -> Int
    return ParseError.empty if n < 0
    n

  fun parse(s: ?String) -> Int!
    return ParseError.empty if s == ""
    s.len

  fun kind(s: ?String) -> Int
    parse(s) catch |err|
      match err
        .empty => 1
        .missing => 2

  a = parse("") catch |err| err
  b = parse("") catch |err| err + 1
  c = parse("") catch |err| 0 if err == 3 else 1
  d = parse("") catch |err|
    match err
      .empty(n) => 1
      _ => 2
  print(plain(1), kind("x"), a, b, c, d)

test "explicit type args", '''
  2 4
  3
  .some(value: 7) .nothing
  1 x x 1
  1 5
  1 8
  1 1 true
  2
'''
  # A generic type's arguments may be named in an expression, in brackets:
  # a constructor (`Wrap[Int](v: 3)`, `List[Int]()`), a variant
  # (`Option[Int].some(...)`, `Option[Int].nothing`), and an associated
  # function (`Pair[Int, ?String].make(...)`). The arguments nest, and may
  # be any type an expression can spell.

  obj Wrap[T]
    v: T

    fun get(?@) -> T
      @v

  obj Pair[T, U]
    a: T
    b: U

    fun make(a: T, b: U) -> Pair[T, U]
      Pair(a: a, b: b)

    fun swap(?@) -> Pair[U, T]
      Pair[U, T](a: @b, b: @a)

  enum Option[T]
    some(value: T)
    nothing

  obj Node
    n: Int

  obj Holder[T]
    h: T

  v = List[Int]()
  !v.push(3)
  !v.push(4)
  print(v.len, v[1])
  b = Wrap[Int](v: 3)
  print(b.get())
  o = Option[Int].some(value: 7)
  e = Option[?String].nothing
  print(o, e)
  p = Pair[Int, ?String].make(1, "x")
  q = ?p.swap()
  print(p.a, p.b, q.a, q.b)
  log = *Cell[List[Int]](value: List())
  !log.push(5)
  print(log.len, log[0])
  boxes = List[Wrap[Int]]()
  !boxes.push(Wrap(v: 8))
  print(boxes.len, boxes[0].v)
  node = *Node(n: 9)
  held = Holder[~Node](h: ~node)
  nodes = List[*Node]()
  !nodes.push(<node)
  maybe = List[Int?](capacity: 2)
  !maybe.push(none)
  print(nodes.len, maybe.len, *held.h != none)
  s = *Signal[Int](1)
  !s.set(2)
  print(s.get())

