fail "callable view types", "9:6: a callable view `?fun(Int) -> Int` is only a parameter's, a local's, or a result's type", "17:1: a callable view `?fun(Int) -> Int` lives only as long as what it views, so it cannot be a module-level binding", "26:11: a callable view `?fun(Int) -> Int` is only a parameter's", "27:9: a callable view `[2]?fun(Int) -> Int` is only a parameter's", "28:7: a callable view `?fun(Int) -> Int` is only a parameter's", "29:7: `Wrap` cannot take a callable view for `T`", "33:15: `?fun(Int) -> Int` views a closure for the call; write the closure without `*` (remove the `*`)", "34:25: a closure literal is lent as `?fun(Int) -> Int` only as a call's argument; bind the closure", "35:12: this call's result may hold the callable it is lent", "38:7: a call never changes what a closure captures, so a closure is lent to read: write `?l`"
  # A callable view `?fun(...)` is only a parameter's, a local's, or a
  # result's type: no field, List, array, optional, or type argument holds
  # one, and neither does a module-level binding. A call never changes a
  # closure's environment, so a closure is not lent to write. A closure
  # literal is lent only as a call's argument, without `*`, and not to a
  # call whose result could hold it.

  obj Holder
    f: ?fun(Int) -> Int

  obj Wrap[T]
    v: T

  fun double(n: Int) -> Int
    n * 2

  keep: ?fun(Int) -> Int = double

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  fun echo(f: ?fun(Int) -> Int) -> ?fun(Int) -> Int
    f

  sub store(f: ?fun(Int) -> Int)
    v: List[?fun(Int) -> Int] = List[Int]()
    arr = [f, f]
    o: (?fun(Int) -> Int)? = f
    w = Wrap(v: f)
    print(arr.len, o == none, w.v(1), v.len)

  sub main()
    print(apply(*|a| a + 1, 2))
    g: ?fun(Int) -> Int = |a| a
    h = echo(|a| a + 1)
    k = 1
    l = |+k, a: Int| a + k
    m = !l
    print(g(1), h(1), m(1))

test "callable vs function views", '''
  1 1
  6
  4
  2
  2
  3
'''
  # Only a `?fun(...)` / `?sub(...)` written as such is a viewed
  # callable. A `?T` whose `T` is a function type is a read view of a
  # function value, in a generic function, field, or payload, and a
  # function value may be lent to write and reassigned through `!T`. A
  # closure captured with `|?f|` is lent, and can be passed on.

  obj View[T]
    w: ?T

  enum Opt[T]
    some(v: ?T)
    nothing

  fun double(n: Int) -> Int
    n * 2

  fun inc(n: Int) -> Int
    n + 1

  fun use_it[T](x: ?T) -> Int
    1

  sub set(dst: !fun(Int) -> Int, v: fun(Int) -> Int)
    dst = v

  sub put[T](dst: !T, v: T)
    dst = v

  sub run(f: ?sub())
    f()

  g: fun(Int) -> Int = double
  print(use_it(?double), use_it(?g))
  v = View(w: ?g)
  h = v.w
  print(h(3))
  o = Opt.some(v: ?g)
  match o
    .some(p) => print(p(2))
    .nothing => print(0)
  set(!g, inc)
  print(g(1))
  put(!g, double)
  print(g(1))
  x = 1
  f = |!x| x += 1
  twice = |?f|
    f()
    run(f)
  twice()
  print(x)

