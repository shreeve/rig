  # A handle keeps a value alive, and a view is no value it could keep:
  # a handle to a view is rejected as a type, as a type argument, and
  # when a view is shared.

  obj P
    x: Int

    fun boxed(?@) -> Int
      h = *@
      1

  fun f(a: *(?Int), b: ~(!P)) -> Int
    1

  y = 3
  h = *(?y)
  c = Cell[*(?Int)](none)

fail "handle to optional", "10:15: `none` needs an optional type; `*(Node?)` is not optional (write `*(Node?)?`)", "11:10: a handle to an optional has no expression spelling: as a type argument in an expression, name it with a `type` alias, or annotate the binding instead", "12:10: a handle to an optional has no expression spelling", "13:14: expected `?*Node?`", "14:10: a handle to an optional has no expression spelling", "15:10: a handle to an optional has no expression spelling", "16:10: a fallible type `*Node!` stands only where a call's result is named"
  # A handle binds tighter than a suffix, so a handle to an optional is
  # written with parentheses, `*(Node?)`, and is not itself optional. As a
  # type argument in an expression it has no spelling: an expression reads
  # `*Node?` as an optional handle, so `*(Node?)` there is rejected with the
  # ways to name it.

  obj Node
    value: Int

  c: *(Node?) = none
  d = Cell[*(Node?)](none)
  f = Cell[~(Node?)?](none)
  e: ?*Node? = 1
  g = Cell[*(~Node?)](none)
  h = Cell[*~(Node?)](none)
  i = Cell[*Node!](none)

