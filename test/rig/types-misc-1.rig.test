  p = P(x: 1, w: 2.0)
  print(p.hash())
  m = hash.Map[Float, Int].new()
  print(m.len)

test "hash follows eq", '''
  true true true
  true true true
  true true true
  true true true
  true true
  true true false
  true true false
  true true false
  true false
  true
  true true false
  true true true
  true true true true
  true true
  true true
  6383968201797696812 6785948958033419204 17309069474865104009
'''
  # `x.hash()` gives a `U64` on exactly the types `==` compares, less a
  # float: values `==` calls equal hash equal, across types too. Text
  # hashes its bytes whatever its type (String, `?String`, `Static`, a
  # boxed String), an optional holding a value hashes as that value, an
  # integer as its value whatever its width, and objects, enums, arrays,
  # and slices by their parts. The seed is fixed, so a hash is the same
  # from run to run.

  obj P
    x: Int
    name: String

  obj Q
    p: P
    tag: ?String
    n: I8?

  enum Shape
    dot
    box(w: Int, h: Int)
    named(name: String)

  enum Color
    red
    green

  error Oops
    bad

  fun same[T](a: ?T, b: ?T) -> Bool
    a == b and a.hash() == b.hash()

  fun h[K](k: ?K) -> U64
    k.hash()

  fun ho[K](k: ?K?) -> U64
    k.hash()

  t = String("q")
  u = String("q")
  v = ?u
  bx = ^String("q")
  print(t.hash() == "q".hash(), v.hash() == t.hash(), bx.hash() == t.hash())
  o: String? = String("q")
  vo: (?String)? = ?t
  print(o.hash() == t.hash(), vo.hash() == "q".hash(), o == ?t)
  n: Int? = 3
  m: Int? = none
  k: (Int?)? = 3
  print(n.hash() == 3.hash(), k.hash() == n.hash(), m.hash() == m.hash())
  print(I8(-1).hash() == (-1).hash(), U8(200).hash() == 200.hash(), I128(-5).hash() == I64(-5).hash())
  print((U128(1) << 70).hash() != U128(0).hash(), true.hash() != false.hash())
  a = P(x: 1, name: String("q"))
  b = P(x: 1, name: String("q"))
  c = P(x: 2, name: String("q"))
  print(a == b, a.hash() == b.hash(), a.hash() == c.hash())
  qa = Q(p: P(x: 1, name: String("a")), tag: "t", n: 4)
  qb = Q(p: P(x: 1, name: String("a")), tag: ?t, n: none)
  qc = Q(p: P(x: 1, name: String("a")), tag: "t", n: 4)
  print(qa == qc, qa.hash() == qc.hash(), qa.hash() == qb.hash())
  s1 = Shape.box(w: 2, h: 3)
  s2 = Shape.box(w: 2, h: 3)
  s3 = Shape.named(name: String("q"))
  s4 = Shape.named(name: String("q"))
  print(s1.hash() == s2.hash(), s3.hash() == s4.hash(), s1.hash() == Shape.dot.hash())
  print(Color.red.hash() == Color.red.hash(), Color.red.hash() == Color.green.hash())
  print(Oops.bad.hash() == Oops.bad.hash())
  xs = [1, 2, 3]
  ys = [1, 2, 3]
  print(xs.hash() == ys.hash(), ?xs[0..2].hash() == ?ys[0..2].hash(), ?xs[0..2].hash() == ?xs[1..3].hash())
  print(same(?a, ?b), same(?s3, ?s4), same(?t, ?u))
  print(h(?t) == "q".hash(), h(?a) == a.hash(), h[?String]("q") == t.hash(), h(?n) == 3.hash())
  print(ho[String](?o) == t.hash(), ho[Int](?m) == m.hash())
  print(String("q").hash() == t.hash(), "".hash() == String().hash())
  print(t.hash(), 7.hash(), P(x: 1, name: String("q")).hash())

test "hash int widths", '''
  true true
  true true true
  true
  true true
  true true
'''
  # An integer hashes as its value whatever its width or signedness: a
  # value from the least `I64` to the greatest `U64` hashes the same in a
  # 64-bit type as in a 128-bit one, signed or not.

  a: U64 = 18446744073709551615
  b: I128 = 18446744073709551615
  c: U128 = 18446744073709551615
  print(c == U128(a), c.hash() == a.hash())
  print(b == I128(a), b.hash() == a.hash(), b.hash() == c.hash())
  d: I128 = 9223372036854775808
  e: U64 = 9223372036854775808
  print(d.hash() == e.hash())
  f: I128 = -9223372036854775807 - 1
  g: I64 = -9223372036854775807 - 1
  print(f.hash() == g.hash(), I8(-3).hash() == I128(-3).hash())
  big: U128 = 18446744073709551616
  print(big.hash() != U128(0).hash(), big.hash() != a.hash())

fail "hash shared text", "8:7: `.hash()` does not take a `*String`", "9:7: cannot compare `String?` with `*String`"
  # A shared handle has no `==` and no `.hash()`, whatever it holds, so a
  # `*String` is not text to compare with an optional or to hash: compare
  # or hash what it holds through a view, `?s`.

  s = *String("q")
  t = String("q")
  o: String? = String("q")
  print(s.hash() == t.hash())
  print(o == s)

fail "heap stacked alias", "8:6: `^^Int` stacks one heap holding on another", "9:6: `*^Int` stacks one heap holding on another", "10:6: `^*Int` stacks one heap holding on another"
  # Stacking arrives through an alias as it does in a written type: the
  # rule is on the resolved type, not on the spelling.

  type Boxed = ^Int
  type Counted = *Int

  obj Holder
    a: ^Boxed
    b: *Boxed
    c: ^Counted

  pass

fail "heap stacked generic", "12:4: `Wrap[*Int]` holds `**Int`, which stacks one heap holding on another", "13:5: `boxed` at these types has `^^Int` in its signature"
  # Stacking arrives through a generic as it does in a written type: a
  # generic type's instance whose field would stack two holdings, and a
  # generic function whose signature would, are rejected where they are
  # made.

  obj Wrap[T]
    inner: *T

  fun boxed[T](x: T) -> ^T
    ^<x

  w: Wrap[*Int]? = none
  b = boxed(^3)
  print(b)

fail "heap stacked types", "6:6: `^^Int` stacks one heap holding on another", "7:6: `^*Int` stacks one heap holding on another", "8:6: `*^Int` stacks one heap holding on another", "9:6: `^~Int` stacks one heap holding on another", "10:6: `**Int` stacks one heap holding on another"
  # A value is held one way on the heap: a box, a counted handle, or a
  # weak handle. A second holding sigil over it is rejected, wherever the
  # type is written.

  obj Holder
    a: ^^Int
    b: ^*Int
    c: *^Int
    d: ^~Int
    e: *(*Int)

  pass

fail "heap stacked values", "7:10: this value is already `^Int`; `^` would hold it twice", "8:10: this value is already `*Int`; `^` would hold it twice", "9:12: this value is already `^Int`; `*` would hold it twice"
  # A value already held on the heap is not put there again: `^<b` of a
  # box, `^<h` of a counted handle, and `*<c` of a box.

  b = ^1
  h = *2
  c = ^3
  twice = ^<b
  again = ^<h
  counted = *<c

fail "held optional stacked", "10:11: `*(~P?)` stacks one heap holding on another", "13:4: `*(~P?)` stacks one heap holding on another", "14:4: `*(*P?)` stacks one heap holding on another", "15:4: `^(~P?)` stacks one heap holding on another", "16:4: `^(*P?)` stacks one heap holding on another", "18:6: `o` is an optional weak handle `~P?`, and `*` upgrades a weak handle, not an optional: take the handle out first, `if o as w`, then `*w`", "20:6: `q` is an optional weak handle `~P?`, and `*` upgrades a weak handle, not an optional: take the handle out first, `if q as w`, then `*w`", errors: 7
  # A holding sigil over an optional of a held value stacks one heap
  # holding on another, as one over the held value itself does: rejected
  # written, through an alias, and in a value's type (`*<o` of an
  # optional weak handle). `*` of an optional weak handle points at
  # taking the handle out first.

  obj P
    n: Int

  type OW = *(~P?)

  s = *P(n: 1)
  a: *(~P?) = none
  b: *(*P?) = none
  c: ^(~P?) = none
  d: ^(*P?) = none
  o: (~P)? = ~s
  p = *<o
  q: (~P)? = ~s
  r = *q

