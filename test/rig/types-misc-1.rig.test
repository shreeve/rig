fail "default field heap constructor", "4:19: a default field value must be a literal", "5:19: a default field value must be a literal", "6:15: a default field value must be a literal"
  # A field default is evaluated where the field is, with no allocation:
  # a constructor that allocates (a box or a shared handle) is not one.
  obj S
    a: ^List[Int] = ^List[Int]()
    b: *List[Int] = *List[Int]()
    c: String = String("x")

  s = S()
  print(s.c)

fail "default value forms", "11:12: a default field value must be a literal, a module constant, a number type's limit, or an empty or literal constructor: `List()`, `String()`, `Cell(0)`, `[n of 0]`", "12:18: a default field value must be a literal", "13:18: a default field value must be a literal", "16:19: a default field value must be a literal", "18:30: a default parameter value must be a literal, a module constant, or a number type's limit", "21:24: a default parameter value must be a literal, a module constant, or a number type's limit"
  # A default is a literal or a module constant; a field's may also be an
  # empty or literal constructor. Anything computed, a local, or a
  # parameter's constructor is rejected.

  LIMIT = 4

  fun seed() -> Int
    1

  obj S
    a: Int = seed()
    b: List[Int] = List(capacity: 2)
    c: Cell[Int] = Cell(LIMIT + 1)
    d: Int = LIMIT
    h: [LIMIT]Int = [LIMIT of LIMIT]
    e: [LIMIT]Int = [LIMIT of seed()]

  fun f(n: Int, v: List[Int] = List(), k: Int = LIMIT) -> Int
    n + k + v.len

  fun g[m: Int](x: Int = m) -> Int
    x

  sub main()
    s = S()
    print(s.d, f(1), g[2]())

