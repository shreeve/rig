  a = List.filled(3, String("a"))
  b = List.filled(2, Named(name: String("x")))
  c: List[^Int] = List.filled(2, ^1)
  h = *Cell(0)
  d = List.filled(2, h)
  e = List.filled(3, none)
  f = List.filled("3", 0)
  g = List.filled(2, !y)
  i = make(2, String("q"))
  j = List.filled(3)
  print(a, b, c, d, e, f, g, i, j)

