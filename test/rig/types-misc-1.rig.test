  # the binding as a callable view.

  fun apply(f: ?*fun(Int) -> Int, x: Int) -> Int
    f(x)

  inc: *fun(Int) -> Int = |x| x + 1
  print(apply(?inc, 1))

fail "owned closure literal to view param", "type mismatch: expected `?*fun(Int) -> Int`, got `*fun(Int) -> Int`", "`?*fun(Int) -> Int` is an owned closure; write `*|...| body` to make one"
