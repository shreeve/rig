# types: the rest of its tests, part 1.

use std.hash

fail "alias constructor", "9:5: `S` is a type alias for `?String`, which has no constructor", "10:5: `O` is a type alias for `Int?`, which has no constructor", "11:5: `N` is a type, not a value"
  # A call through an alias constructs the struct it names or converts to
  # the number type it names; an alias of any other type has no
  # constructor, and an alias is not a value.

  type S = ?String
  type O = Int?
  type N = Int

  s = S("x")
  o = O(5)
  n = N
  print(s, o, n)

test "alias constructs any type", '''
  3 4 0 0 5 7
  8 true
  true true true 2.0 -5 -128
'''
  # An alias names its type in every role: a call through an alias of a
  # generic instance, of `List`, `Cell`, or `Signal`, constructs a
  # value of it, as naming the instance does, and one through an alias of
  # a number type converts to it. An alias of a float type names its
  # limits, which a default value may be.

  obj Wrap[T]
    v: T

    fun make(n: T) -> Wrap[T]
      Wrap(v: n)

  enum Mode
    a
    b(n: Int)

  type IW = Wrap[Int]
  type IV = List[Int]
  type IC = Cell[Int]
  type IS = Signal[Int]
  type M = Mode
  type Real = F32
  type Small = I8

  obj D
    hi: Real = Real.max
    lo: Real = Real.min

  fun low(x: Real = Real.min) -> Bool
    x < -3.0e38

  w = IW(v: 3)
  u = IW.make(4)
  v = IV(capacity: 2)
  e: IV = IV()
  c = *IC(5)
  s = *IS(7)
  m = M.b(n: 8)
  print(w.v, u.v, v.len, e.len, c.get(), s.get())
  match m
    .b(n) => print(n, M.a == Mode.a)
    .a => print("a")
  d = D()
  print(d.hi > 3.0e38, d.lo < -3.0e38, low(), Real(2), Small(-5), Small.min)

test "alias enum variant", '''
  green
  2
'''
  # An alias of an enum names its variants, with or without a payload.

  enum Color
    red
    green

  enum Shape
    circle(r: Int)
    dot

  type C = Color
  type S = Shape

  c = C.green
  s = S.circle(r: 2)
  match c
    .green
      print("green")
    .red
      print("red")
  match s
    .circle(r)
      print(r)
    .dot
      print("dot")

test "alias limit default", "255 0 255"
  # An integer type's alias names its limits, which are constants: a
  # default value may be one, as `U8.max` may.

  type Byte = U8

  obj P
    lo: Byte = Byte.min
    hi: U8 = U8.max

  fun f(n: U8 = Byte.max) -> U8
    n

  p = P()
  print(f(), p.lo, p.hi)

test "alias struct constructor", "3 4 0"
  # An alias of a struct is the struct: it constructs values and reaches
  # the struct's associated functions.

  obj Point
    x: Int
    y: Int

    fun origin() -> Point
      Point(x: 0, y: 0)

  type P2 = Point

  p = P2(x: 3, y: 4)
  o = P2.origin()
  q: Point = p
  print(q.x, q.y, o.x)

test "alias transparent", "6"
  # A type alias is transparent: `UserId` is `Int`, so an Int literal
  # initializes it and it takes part in arithmetic.

  type UserId = Int

  fun next(a: UserId) -> Int
    a + 1

  x: UserId = 5
  print(next(x))

fail "arch reserved", "3:6: `Arch` is a reserved built-in nominal name and cannot be redefined"
  # `Arch` is a built-in type: a module cannot declare its own.

  enum Arch
    intel
    arm

  print(Arch.intel)

fail "arch variants", "5:14: no variant `amd64` on enum `Arch`", "8:19: `Int(x)` takes a declared enum's value; the built-in enum `Arch` has no integer value", "8:37: `Int(x)` takes a declared enum's value; the built-in enum `Endian` has no integer value", errors: 3
  # `Arch`'s variants are Zig's names for the architectures, no others,
  # and like `Endian`'s they have no integer value.

  fun pick() -> Bool
    x: Arch = .amd64
    x == .x86_64

  print(pick(), Int(Arch.x86_64), Int(Endian.big))

fail "arith mixed int sizes", "operands have different types `I32` and `Int`"
  # Arithmetic operands must have one type; `I32 + I64` is rejected
  # (`I64` is `Int`).

  a: I32 = 1
  b: I64 = 2
  print(a + b)

test "array as slice", '''
  9 6 33 6
  1 7 6
  [9, 8, 1]
  [0, 0, 0]
  [1, 2, 0, 0]
  [1, 2, 3]
  3
'''
  # Where a `[]T` argument is expected, a temporary array (a literal, a
  # fill, or a call's result) is lent for the call, and `?a` of a named
  # array means `?a[..]`; where a `![]T` is expected, `!a` means `!a[..]`.

  fun total(xs: []Int) -> Int
    n = 0
    for x in xs
      n += x
    n

  fun first[T](xs: []T) -> T
    xs[0]

  sub zero(s: ![]Int)
    !s.fill(0)

  fun three(k: Int) -> [3]Int
    [k, k + 1, k + 2]

  obj View
    xs: []Int

  fun head(a: ?[3]Int) -> Int
    total(?a)

  a = [1, 2, 3]
  print(total([4, 5]), total([3 of 2]), total(three(10)), total(?a))
  print(first(?a), first([7, 8]), head(?a))
  b = [0, 0, 0]
  !b[..2].copy([9, 8])
  !b[2..].copy(?a[..1])
  print(b)
  zero(!b)
  print(b)
  bytes: [4]U8 = [0, 0, 0, 0]
  !bytes[..2].copy([1, 2])
  print(bytes)
  v = View(xs: ?a)
  print(v.xs)
  s: []Int = ?a
  print(s.len)

fail "array as slice is rejected", "20:6: type mismatch: expected `![]Int`, got `[3]Int`; write `!a` or `!a[..]`", "22:14: a temporary array is lent as a `[]Int` only to a call that keeps no view of it; bind it to a name and pass `?name`"
  # A bare named array where a `![]T` is expected would be written unseen:
  # it is written `!a`. A temporary array kept in a field is lent nowhere.
  # (A bare array, or a temporary one, as a `[]T` argument is lent to
  # read: test/behavior/types/implicit_argument_lends.rig.)

  fun total(xs: []Int) -> Int
    xs.len

  fun id(xs: []Int) -> []Int
    xs

  sub zero(s: ![]Int)
    !s.fill(0)

  obj View
    xs: []Int

  a = [1, 2, 3]
  print(total(a))
  zero(a)
  r = id([1, 2])
  v = View(xs: [1, 2])
  print(r, v.xs)

fail "array constant index out of bounds", "index `3` is out of bounds for an array of length 3", "index `5` is out of bounds for an array of length 3", "index `-1` is out of bounds for an array of length 3"
  # An array's length is part of its type, so a constant index outside it
  # is rejected (including through a constant binding).

  xs = [1, 2, 3]
  print(xs[3])
  i = 5
  print(xs[i])
  print(xs[-1])

test "array fill", '''
  [7, 7, 7, 7, 7, 7] 2 [[1, 1], [1, 1], [1, 1]] [none, none, none] 0 [1.5, 1.5] [9, 9, 9, 9] [0, 0, 0, 0]
  [5, 5, 5] 0 2
'''
  # `[n of x]` is an array of `n` copies of `x`: `n` is any compile-time
  # integer, and the element is plain data. Without an expected type its
  # type is `[n]T` for `x`'s type.

  N = 3
  ZEROS = [4 of 0]

  obj Point
    x: Int
    y: Int

  fun filled[n: Int](v: Int) -> [n]Int
    a = [n of v]
    a

  sub main()
    a = [N * 2 of 7]
    b: [2]Point = [2 of Point(x: 1, y: 2)]
    c = [3 of [2 of 1]]
    d: [3]Int? = [3 of none]
    e = [0 of 0]
    f = [2 of 1.5]
    g: [4]U8 = [4 of 9]
    print(a, b[1].y, c, d, e.len, f, g, ZEROS)
    print(filled[3](5), [3 of 0][1], [2 of 2].len)

fail "array fill rejected", "11:6: an array length must be known at compile time; `k` is not", "12:11: the element of `[n of x]` needs a type", "13:10: type mismatch: expected `Int`, got `[3]Int`", "14:6: array length -1 is out of range", "15:13: `[3 of 0]` has length `3`; `[4]Int` needs `4`", "16:11: `[n of x]` copies its element into every slot, and a `List[Int]` owns a resource, so it cannot be copied: write a loop that makes each element with `+x` (`for 0..n` with `!xs.push(+x)`, into a List), or write the elements out, `[+x, +x]`", "17:11: `[n of x]` copies its element into every slot, and a `!Int` holds a write view, which has one holder, so it cannot be copied", "18:5: `make[List[Int]]` cannot use `T = List[Int]`"
  # `[n of x]` copies a value that copies into each of its `n` slots, where `n` is
  # known at compile time; with no expected type, `x` gives the element
  # type.

  fun make[T](x: T) -> [3]T
    [3 of x]

  k = 3
  v = List[Int]()
  y = 5
  a = [k of 0]
  b = [3 of none]
  c: Int = [3 of 0]
  d = [-1 of 0]
  e: [4]Int = [3 of 0]
  f = [2 of <v]
  g = [2 of !y]
  h = make(List[Int]())
  print(a, b, c, d, e, f, g, h)

test "array for with index", '''
  80
  7
  9
'''
  # `for x, i in xs` walks an array (or a List) with each element's index.

  xs = [10, 20, 30]
  total = 0
  for x, i in xs
    total += x * i
  print(total)
  v: List[Int] = List()
  !v.push(7)
  !v.push(8)
  for n, k in ?v
    print(n + k)

fail "array length mismatch", "array literal has 2 elements; `[3]Int` needs 3"
  # An array literal must have the annotated length.

  xs: [3]Int = [1, 2]
  print(xs[0])

test "array literal equality", "true true true true false"
  # An array literal compared with an array takes its element type from
  # the other operand, as a number literal does.

  xs: [2]U8 = [1, 2]
  fs: [2]Float = [1.0, 2.0]
  grid: [2][2]I32 = [[1, 2], [3, 4]]
  print(xs == [1, 2], [1, 3] != xs, fs == [1, 2], grid == [[1, 2], [3, 4]], xs == [2 of 0])

fail "array mixed elements", "incompatible types `Int` and `Static`"
  # Array literal elements share one type.

  xs = [1, "two"]
  print(1)

fail "array too large", "32:11: `[9000000]Color?` takes 18000000 bytes", "12:5: `Two` takes 9600000 bytes; a value takes at most 8388608 (8 MiB)", "34:7: `[4000000000]Int` takes 32000000000 bytes", "44:6: `[4294967295]U8` takes 4294967295 bytes", "45:6: `[2]Half` takes 9600000 bytes", "47:7: `Ring[Int, 1048577]` makes `[1048577]Int`, which takes 8388616 bytes", "48:7: `zeros[1048577]` makes `[1048577]Int`", "49:3: `fill[1048577]` makes `[1048577]Int`", "50:6: `Wrap[Half]` makes `[2]Half`", "51:6: `Pair[Half]` takes 9600000 bytes", "52:6: `[9000000]U8` takes 9000000 bytes", "53:79: `[1048577]Int` takes 8388616 bytes"
  # A value takes at most 8 MiB, since it may live on the stack: larger
  # data belongs in a `List`. Each instance of a generic declaration is
  # checked for the arrays it makes and for its own size. A type that
  # holds a type too large is not reported again.

  obj Ring[T, n: Int]
    items: [n]T

  obj Half
    a: [600000]Int

  obj Two
    a: [600000]Int
    b: [600000]Int

  obj Outer
    t: Two
    more: [2]Two

  obj Wrap[T]
    items: [2]T

  obj Pair[T]
    a: T
    b: T

  enum Color
    red
    green

  obj Paint
    shades: [9000000]Color?

  BIG = [4000000000 of 7]

  fun zeros[n: Int]() -> [n]Int
    [n of 0]

  sub fill[n: Int]()
    a = [n of 1]
    print(a.len)

  sub main()
    a: [4294967295]U8 = []
    b: [2]Half = [Half(a: [600000 of 0]), Half(a: [600000 of 0])]
    c: [1048576]Int = [1048576 of 0]
    r = Ring[Int, 1048577](items: [1048577 of 0])
    z = zeros[1048577]()
    fill[1048577]()
    w: Wrap[Half]? = none
    p: Pair[Half]? = none
    d: [9000000]U8 = [9000000 of 165]
    print(a.len, b.len, c.len, r.items.len, z.len, w == none, p == none, d.len, [1048577 of 0].len)

fail "assign field of plain param", "cannot assign to parameter `p`"
  # A field of a plain parameter cannot be assigned: the parameter is an
  # immutable value. Take `p: !Point` to write through to the caller.

  obj Point
    x: Int

  sub reset(p: Point)
    p.x = 0

  reset(Point(x: 1))

test "assign field through write param", "0"
  # A field of a `!T` parameter is assigned in the caller's value.

  obj Point
    x: Int

  sub reset(p: !Point)
    p.x = 0

  q = Point(x: 1)
  reset(!q)
  print(q.x)

fail "assign into temporary", "13:1: cannot assign to a field or element of a temporary; bind the value first", "14:1: cannot assign to a field or element of a temporary", "16:1: cannot assign to a field or element of a temporary"
  # A field or element of a value no binding holds is gone after the
  # statement, so assigning to it is rejected.

  obj P
    x: Int

  fun mk() -> P
    P(x: 1)

  fun pair() -> [2]Int
    [1, 2]

  mk().x = 5
  pair()[0] = 3
  c: Cell[P] = Cell(P(x: 1))
  c.get().x = 99
  print(c.get().x)

fail "assign loop binding", "cannot assign to `n`: it is a copy of an element of `v`; to change the elements in place, loop with `for n in !v`"
  # Loop bindings are immutable: a copy of an element is written in place
  # through `for x in !xs`.

  v: List[Int] = List()
  !v.push(1)
  for n in ?v
    n = n + 1
    print(n)

fail "assign parameter", "cannot assign to parameter `n`"
  # Parameters are immutable; assigning to one is rejected.

  fun bump(n: Int) -> Int
    n = n + 1
    n

  print(bump(1))

fail "assign read view param", "cannot assign to parameter `c`"
  # Only `!T` parameters are assignable; a `?T` parameter is a read view.

  sub bump(c: ?Int)
    c = c + 1

  n = 1
  bump(?n)

fail "assign through call no write view", "15:1: cannot assign through a read view (`?T`), which this call returns; a call that returns a write view (`!T`) is assigned through", "16:1: cannot assign to a call's result, an `Int`; only a write view (`!T`) a call returns is assigned through", "17:1: cannot assign to a `![]Int` a call returns; write its elements with `all(!v)[i] = v`", errors: 3
  # Only a write view `!T` a call returns is assigned through: not a read
  # view, not a value, and not a `![]T`, whose elements are written instead.

  fun first(v: ?List[Int]) -> ?Int from v
    ?v[0]

  fun count(v: ?List[Int]) -> Int
    v.len

  fun all(v: !List[Int]) -> ![]Int from v
    !v[..]

  v: List[Int] = List()
  !v.push(1)
  first(?v) = 2
  count(?v) += 1
  all(!v) = !v[..]

fail "assign through non call", "19:3: cannot assign to `w?`: only a call that returns a write view (`!T`), or that call's `!` or `?`, is assigned through", "20:3: cannot assign to `w?`", "25:3: cannot assign to `w?`", "27:3: cannot assign to `x?`: only a call that returns a write view (`!T`), or that call's `!` or `?`, is assigned through", "32:3: cannot assign to `(maybe(!a) if c else maybe(!b))?`", "36:3: cannot assign to `pick(!h)!?`", errors: 6
  # `?` or `!` around anything but a call is not assigned through: not a
  # parameter's or local's optional write view, not an optional value,
  # not a branching value of calls, and not a call's `?` or `!` nested in
  # another.

  obj H
    r: Int

  error Bad
    oops

  fun pick(h: !H) -> ((!H)?)! from h
    h

  fun maybe(h: !H) -> (!H)? from h
    h

  fun opt(w: (!Int)?) -> Int?
    w? = 5
    w? += 1
    0

  fun local(h: !H) -> Int?
    w: (!H)? = h
    w? = H(r: 2)
    x: Int? = 3
    x? = 4
    print(w, x)
    0

  fun branch(a: !H, b: !H, c: Bool) -> Int?
    (maybe(!a) if c else maybe(!b))? = H(r: 1)
    0

  fun nested(h: !H) -> Int!
    pick(!h)!? = H(r: 3)
    0

  n = 1
  h = H(r: 0)
  g = H(r: 0)
  print(opt(!n), local(!h), branch(!h, !g, true), nested(!h) catch 0)

fail "assign through optional view", "10:3: cannot assign to `w?`: only a call that returns a write view (`!T`), or that call's `!` or `?`, is assigned through", errors: 1
  # Only a call's write view, or that call's `!` or `?`, is assigned
  # through. `w?` of a parameter `w: (!H)?` is not: assigning it would
  # store a view of local `d` in the caller's `H`, which outlives `d`.

  obj H
    s: ?String

  fun set(w: (!H)?) -> Int?
    d = String("local")
    w? = H(s: ?d)
    0

  t = String("outer")
  h = H(s: ?t)
  print(set(!h))
  print(h.s)

fail "bare literal does not fail", "14:4: `.missing` is not a variant of `Color`; to fail, name the error set: `E.missing`", "17:11: `.missing` is not a variant of `Color`; to fail, name the error set: `E.missing`", "24:6: `.missing` is not a value of `Int`; to fail, name the error set: `E.missing`", "29:11: `.missing` is not a variant of `Color`; to fail, name the error set: `E.missing`", "32:23: `.missing` is not a variant of `Color`; to fail, name the error set: `E.missing`", "35:11: a `sub` returns no value; to fail, name the error set: `E.missing`", "41:11: `.missing` is not a variant of `Color`; to fail, name the error set: `E.missing`", errors: 7
  # A bare `.name` where a `T!` is expected is always a variant of `T`: a
  # fallible function fails only by naming the error set (`E.missing`),
  # so `.missing` is rejected wherever `T` has no such variant, with a
  # hint that names the set.

  enum Color
    red
    green

  error E
    missing

  fun tail(n: Int) -> Color!
    .missing

  fun early(n: Int) -> Color!
    return .missing if n < 0
    .red

  fun branch(n: Int) -> Int!
    if n > 0
      n
    else
      .missing

  fun arm(n: Int) -> Color!
    match n
      0 => .red
      _ => .missing

  fun ternary(n: Int) -> Color!
    .red if n > 0 else .missing

  sub save(n: Int)!
    return .missing if n < 0
    print(n)

  sub each(f: ?fun(Int) -> Color!)
    print(f(1) catch .red)

  each(|n| .missing)
  print(tail(1) catch .red, early(1) catch .red, branch(1) catch 0, arm(1) catch .red, ternary(1) catch .red)
  save(1)!

test "binding visible after declaration", '''
  1
  one
'''
  # A use of `x` before a later `new x = ...` in the same block reads the
  # earlier binding.

  x = 1
  print(x)
  new x = "one"
  print(x)

fail "bit method non integer", "6:9: type `Float` has no method `count_ones`", "6:25: type `Bool` has no method `leading_zeros`", "6:44: type `Static` has no method `trailing_zeros`", "6:64: type `Float` has no method `swap_bytes`", "7:9: `count_ones` takes no arguments; got 1"
  # The bit methods are for integers.

  f = 1.5
  b = true
  s = "ab"
  print(f.count_ones(), b.leading_zeros(), s.trailing_zeros(), f.swap_bytes())
  print(5.count_ones(1))

fail "bitwise on bool", "requires integer operands; got `Bool`"
  # Bitwise operators need integer operands.

  print(true & false)

test "bitwise ops", '''
  8
  14
  6
  24
'''
  # Bitwise operators work on integers of one type.

  a: U8 = 12
  b: U8 = 10
  print(a & b)
  print(a | b)
  print(a ^ b)
  print(a << 1)

fail "builtin enum values", "5:14: `Endian.from_int(n)` takes a declared enum; the built-in enum `Endian` has no integer value", "6:12: `Arch.from_int(n)` takes a declared enum; the built-in enum `Arch` has no integer value", "7:17: `$variants(T)` takes a declared enum; `Endian` is a built-in enum", "8:17: `$variants(T)` takes a declared enum; `Arch` is a built-in enum", errors: 4
  # The built-in enums `Endian` and `Arch` have no payloads, but no
  # integer values either (`Arch`'s variants are Zig's), so neither has
  # `from_int` or `$variants`, as neither converts with `Int(x)`.

  print(Endian.from_int(0))
  print(Arch.from_int(0))
  print($variants(Endian))
  print($variants(Arch).len)

test "builtin needs routes", '''
  1 2 1
  7 7 7
  [5, 5, 8] [6, 9, 4] 5 4 none 5
  ["ab", "ab", "ab"] ab ab
  3
'''
  # The built-in methods that copy a `T` take one that copies, as
  # `xs.m(...)` and as `Type.m(xs, ...)` through the type, and in a generic
  # body: an `Int`, plain data, and a read view, which carries its loan.

  obj P
    x: Int
    y: Int

  type Ints = List[Int]

  fun first[T](xs: ?List[T]) -> T?
    List.get(xs, 0)

  fun peek[T](c: ?Cell[T]) -> T
    Cell[T].get(c)

  fun look[T](s: ?Signal[T]) -> T
    s.get()

  sub grow[T](xs: !List[T], x: T)
    List.resize(!xs, 3, x)

  c = *Cell(P(x: 1, y: 2))
  a = c.get()
  b = Cell[P].get(?c)
  print(a.x, b.y, peek(?c).x)
  s = *Signal(7)
  print(s.get(), Signal[Int].get(?s), look(?s))
  xs = List.filled(2, 5)
  ys = List[Int].filled(1, 6)
  !xs.resize(3, 8)
  List.resize(!ys, 2, 9)
  Ints.resize(!ys, 3, 4)
  grow(!xs, 0)
  print(xs, ys, xs.get(1), List.get(?ys, 2), Ints.get(?ys, 7), first(?xs))
  name = String("ab")
  views = List.filled(2, ?name)
  !views.resize(3, ?name)
  print(views, views.get(2), List.get(?views, 0))
  bx = ^List.filled(2, 3)
  print(bx.get(1))

fail "builtin needs routes is rejected", "22:7: `Cell.get` returns a copy of the value, and a `String` owns what it must release, so it can't be copied; write `(!cell).swap(<new)`", "23:18: `Cell.get` returns a copy of the value, and a `String` owns what it must release", "26:8: `List.get` would copy an element out of a `List` of `String`, which a copy cannot share", "27:10: `List.get` would copy an element out of a `List` of `String`", "28:11: `List.get` would copy an element out of a `List` of `String`", "30:8: `List.get` would copy an element out of a `List` of `String`", "31:5: `resize` copies its value into every element it adds, and a `String` owns a resource, so it cannot be copied: write a loop that makes each element with `+x` (`for xs.len..n` with `!xs.push(+x)`); `!xs.keep(n)` shrinks any List", "32:14: `resize` copies its value into every element it adds, and a `String` owns a resource", "33:10: `List.filled` copies its value into every element, and a `String` owns a resource, so it cannot be copied: write a loop that makes each element with `+x` (`for 0..n` with `!xs.push(+x)`)", "34:18: `List.filled` copies its value into every element, and a `String` owns a resource", "35:7: `first[String]` cannot use `T = String`: the generic body copies an element out of a List", "35:19: `peek[String]` cannot use `T = String`: the generic body copies out with `Cell.get` a value", "35:29: `look[String]` cannot use `T = String`: the generic body copies out with `Cell.get` a value", "36:1: `grow[String]` cannot use `T = String`: the generic body copies into every element `resize` adds a value", errors: 14
  # A built-in method that copies a `T` declares that `T` must copy, and
  # every call meets it, as `xs.m(...)` and as `Type.m(xs, ...)` through
  # the type, and in a generic body for each instance: `Cell.get` and
  # `List.get` copy a value out of what they keep, `List.filled` and
  # `resize` copy one into every element they make.

  type Names = List[String]

  fun first[T](xs: ?List[T]) -> T?
    List.get(xs, 0)

  fun peek[T](c: ?Cell[T]) -> T
    Cell[T].get(c)

  fun look[T](c: ?Cell[T]) -> T
    c.get()

  sub grow[T](xs: !List[T], x: T)
    List.resize(!xs, 3, x)

  c = *Cell(String("a"))
  a = c.get()
  b = Cell[String].get(?c)
  xs: List[String] = List()
  !xs.push(String("x"))
  d = xs.get(0)
  e = List.get(?xs, 0)
  f = Names.get(?xs, 0)
  bx = ^List[String]()
  g = bx.get(0)
  !xs.resize(2, String("y"))
  List[String].resize(!xs, 2, String("z"))
  h = List.filled(2, String("w"))
  k = List[String].filled(2, String("v"))
  print(first(?xs), peek(?c), look(?c))
  grow(!xs, String("u"))
  print(a, b, d, e, f, g, h, k)

