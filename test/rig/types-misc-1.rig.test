test "int128", '''
  340282366920938463463374607431768211455 -170141183460469231731687303715884105728 1267650600228229401496703205376 170141183460469231731687303715884105727 -170141183460469231731687303715884105727
  55340232221128654845 55340232221128654844 42 1.2676506002282294e30
  2 true [1, 2, 3]
'''
  # `U128` and `I128` are sized integers like the others: literals up to
  # their bounds, checked arithmetic and conversions, and printing.

  obj Wide
    hi: U128
    lo: I128

  a: U128 = 340282366920938463463374607431768211455
  b: I128 = -170141183460469231731687303715884105728
  c = U128(1) << 100
  w = Wide(hi: a / 2, lo: b + 1)
  print(a, b, c, w.hi, w.lo)
  d = U128(18446744073709551615) * 3
  print(d, I128(d) - 1, Int(U128(42)), Float(c))
  v = List[I128]()
  !v.push(-5)
  !v.push(170141183460469231731687303715884105727)
  print(v.len, v[1] > v[0], [U128(1), 2, 3])

fail "integer operator on float literals", "11:7: `half[Float]` cannot use `T = Float`: the generic body applies `+%` to `T`", "12:10: operator `+%` is for integers, and its literal operands here take the type `Float`", "13:12: operator `*%` is for integers", "14:12: operator `-%` is for integers", "16:10: operator `<<` is for integers"
  # Wrapping, bitwise, and shift operators are for integers. Literal
  # operands take their type from the context, so where that type is a
  # float, or a type parameter a float instantiates, they cannot use one.

  fun half[T](x: T) -> T
    x / (2 +% 1)

  fun mx[T](a: T, b: T) -> T
    a if a > b else b

  print(half(5.0))
  print(mx(3 +% 1, 2.5))
  f: Float = 2 *% 3
  g = 1.5 + (2 -% 1)
  h: Float = 0.5
  h = h + (1 << 2)
  print(f, g, h)

test "is empty", '''
  true false
  true
  false false
  false true
  false true true
  true false true
  false true
  true false
  true
  false
  true
  false
  true false
  not empty
'''
  # `x.is_empty()` is `x.len == 0` on everything with a built-in `len`:
  # it reads its receiver, and a type's own `is_empty` method wins.

  obj Bag
    n: Int

    fun is_empty(?@) -> Bool
      @n == 99

  fun list_empty[T](xs: ?List[T]) -> Bool
    xs.is_empty()

  fun slice_empty(xs: []Int) -> Bool
    xs.is_empty()

  fun wslice_empty(xs: ![]Int) -> Bool
    xs.is_empty()

  fun text_empty(s: ?String) -> Bool
    s.is_empty()

  obj Holder
    items: List[Int]

  s = ""
  t = "abc"
  print(s.is_empty(), t.is_empty())
  v: List[Int] = List()
  print(v.is_empty())
  !v.push(1)
  print(v.is_empty(), list_empty(?v))
  a = [1, 2, 3]
  z: [0]Int = []
  print(a.is_empty(), z.is_empty())
  print(slice_empty(?a[..]), slice_empty(?a[0..0]), slice_empty(?z[..]))
  print(text_empty(s), text_empty(t), text_empty(t[1..1]))
  w = [5]
  print(wslice_empty(!w[..]), wslice_empty(!w[0..0]))
  e: List[Int] = List()
  print(list_empty(?e), list_empty(?v))
  c: *Cell[List[Int]] = *Cell(<e)
  print(c.is_empty())
  !c.push(4)
  print(c.is_empty())
  h = Holder(items: List())
  print(h.items.is_empty())
  !h.items.push(1)
  print(h.items.is_empty())
  b = Bag(n: 99)
  print(b.is_empty(), Bag(n: 0).is_empty())
  if not t.is_empty()
    print("not empty")

