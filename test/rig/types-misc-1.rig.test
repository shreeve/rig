fail "pub generic chain self nesting", "7:9: `f0[T]` leads to ever deeper instances of generic functions (through `f0[Wrap[T]]`)"
  # A public generic that nests itself is reported where it is declared,
  # not at the public generics that call it.

  obj Wrap[T]
    v: T

  pub fun f0[T](x: T) -> Int
    f0(Wrap(v: x))

  pub fun f1[T](x: T) -> Int
    f0(x)

  pub fun f2[T](x: T) -> Int
    f1(x)

  print(1)

fail "pub generic method nests own type", "13:7: `deep[U]` leads to ever deeper instances of generic types (through `List[Pair[T, U]]`)"
  # A generic method of a public generic type that calls itself on an
  # instance of its type nested in its own and the method's parameters
  # (`Chain[Pair[T, U]]` from `Chain[T]`) nests ever deeper; it is reported
  # where it is declared.

  pub obj Pair[A, B]
    a: A
    b: B

  pub obj Chain[T]
    items: List[T]

    fun deep[U](?@, u: U) -> Int
      out: List[Pair[T, U]] = List()
      l = Chain(items: <out)
      l.deep(u)

  v: List[Int] = List()
  l = Chain(items: <v)
  print(l.items.len)

test "pub generic method own param", "2 b 2"
  # A generic method of a public generic type may use an instance of its
  # own type at the method's own parameter (`Chain[Pair[T, U]]` in
  # `zip[U]`): each call makes one instance, which does not nest further.

  pub obj Pair[A, B]
    a: A
    b: B

  pub obj Chain[T]
    items: List[T]

    fun zip[U](?@, other: ?Chain[U]) -> Chain[Pair[T, U]]
      out: List[Pair[T, U]] = List()
      i = 0
      while i < @items.len and i < other.items.len
        !out.push(Pair(a: @items[i], b: other.items[i]))
        i += 1
      Chain(items: <out)

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  w: List[?String] = List()
  !w.push("a")
  !w.push("b")
  l = Chain(items: <v)
  m = Chain(items: <w)
  z = ?l.zip(?m)
  zz = ?z.zip(?l)
  print(zz.items[1].a.a, zz.items[1].a.b, zz.items[1].b)

fail "pub generic mutual self nesting", "8:9: `ping[T]` leads to ever deeper instances of generic functions (through `ping[Wrap[T]]`)"
  # A public generic function that nests itself through a private one
  # (`ping[T]` calls `pong[T]`, which calls `ping[Wrap[T]]`) is reported
  # where it is declared.

  obj Wrap[T]
    v: T

  pub fun ping[T](x: T, n: Int) -> Int
    0 if n == 0 else pong(x, n - 1)

  fun pong[T](x: T, n: Int) -> Int
    ping(Wrap(v: x), n)

  print(1)

fail "pub generic self nesting through method", "14:9: `f[T]` leads to ever deeper instances of generic types (through `Hidden[T]`)"
  # A public generic function that nests itself through a private generic
  # type's method (`f[T]` calls `Hidden[T].m`, which calls `f[Wrap[T]]`)
  # is reported where it is declared.

  obj Wrap[T]
    v: T

  obj Hidden[T]
    v: T

    fun m(?@) -> Int
      f(Wrap(v: @v))

  pub fun f[T](x: T) -> Int
    Hidden(v: x).m()

  print(1)

fail "pub generic type self nesting", "5:9: `Deep[T]` leads to ever deeper instances of generic types (through `Deep[Deep[T]]`); a generic type's body cannot nest itself in its own type arguments"
  # A public generic type whose methods use ever deeper instances of
  # itself is reported where it is declared, even when no instance is made
  # here: other modules would make them.

  pub obj Deep[T]
    v: T

    fun deeper(?@) -> Int
      d: Deep[Deep[T]]? = none
      print(d == none)
      1

  print(1)

