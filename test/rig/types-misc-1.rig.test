  f = |+m|
    print(m ?? 0)
  f()

test "capture type shared local name", '''
  hello
  3
'''
  # A closure capture takes the type of the binding in scope, not of a
  # same-named local elsewhere.

  sub other()
    s = 3
    print(s)

  s =! "hello"
  f = |+s|
    print(s)
  f()
  other()

