  # A labeled `match` or `raw` block is a statement, so it cannot be the
  # value a function ends with.

  fun f(n: Int) -> Int
    $done: match n
      0 => 1
      _ => 2

  fun g(n: Int) -> Int
    $blk: raw
      n + 1

  print(f(0), g(1))

test "lasting lend forms", '''
  [1] [3] [1] 2 1 1 [3]
  1 [3] 2 1
  [2, 3] ello he!
'''
  # A lend kept past its statement is written; one that ends with the
  # statement lends implicitly (test/reject/types/lasting_lend_written.rig
  # rejects the unwritten kept forms).

  obj Bag
    items: List[Int]

    fun all(?@) -> []Int
      ?@items[..]

    fun size(?@) -> Int
      @items.len

  obj Holder
    seen: []Int

  fun head(xs: []Int) -> []Int
    xs[0..1]

  fun count(xs: []Int) -> Int
    xs.len

  fun window(b: ?Bag) -> []Int
    head(?b.items[..])

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  b = Bag(items: List())
  !b.items.push(3)
  r = head(?v)
  xs = ?b.all()
  h = Holder(seen: head(?v))
  n = count(v)
  m = b.all().len
  s = b.size()
  print(r, xs, h.seen, n, m, s, window(b))
  print(head(v).len, b.all(), count(v), head(v)[0])
  w = [1, 2, 3]
  t = String("hello")
  print(w[1..3], t[1..], String(t[..2], "!"))

test "lasting lend stored", "1 1 [7]"
  # A result stored by a callee keeps its argument lent, so the lend is
  # written (test/reject/types/lasting_lend_stored.rig); one the call only
  # reads lends implicitly.

  fun head(xs: []Int) -> []Int
    xs[0..1]

  fun count(xs: []Int) -> Int
    xs.len

  v: List[Int] = List()
  !v.push(7)
  xs: List[[]Int] = List()
  !xs.push(head(?v))
  print(count(head(v)), xs.len, xs[0])

fail "lasting lend stored is rejected", "19:15: `head(v)` keeps `v` lent in what `push` stores; write `head(?v)`", "21:16: `head(v)` keeps `v` lent in what `push` stores; write `head(?v)`", "22:28: `head(v)` keeps `v` lent in what `push` stores; write `head(?v)`", errors: 3
  # A lend kept beyond its statement is written, also when a callee stores
  # it: a result handed to a call that may store it keeps its argument
  # lent inside what the call stores into. A result the call only reads
  # lends implicitly.

  obj Holder
    seen: []Int

  fun head(xs: []Int) -> []Int
    xs[0..1]

  fun count(xs: []Int) -> Int
    xs.len

  v: List[Int] = List()
  !v.push(1)
  xs: List[[]Int] = List()
  hs: List[Holder] = List()
  !xs.push(head(v))
  !xs.push(head(?v))
  !xs.push([head(v)][0])
  !hs.push(Holder(seen: head(v)))
  print(count(head(v)), xs.len, hs.len)

fail "lasting lend written", "26:8: `head(b.items[..])` keeps `b.items[..]` lent in the value it returns; write `head(?b.items[..])`", "35:10: `head(v)` keeps `v` lent while `r` lives; write `head(?v)`", "36:6: `b.all()` keeps `b` lent while `xs` lives; write `?b.all()`", "37:23: `head(v)` keeps `v` lent while `h` lives; write `head(?v)`", "38:15: `head(v)` keeps `v` lent while `h.seen` lives; write `head(?v)`", "44:20: `head(v)` keeps `v` lent while `nested` lives; write `head(?v)`", errors: 6
  # A lend kept in a binding is written (Core sentence 4). A call whose
  # result keeps an argument or its receiver lent, and whose result is
  # stored in a binding, a field, or a return, writes that lend: the loan
  # outlives the statement. A result used within its statement lends
  # implicitly, and so does a result that keeps nothing.

  obj Bag
    items: List[Int]

    fun all(?@) -> []Int
      ?@items[..]

    fun size(?@) -> Int
      @items.len

  obj Holder
    seen: []Int

  fun head(xs: []Int) -> []Int
    xs[0..1]

  fun count(xs: []Int) -> Int
    xs.len

  fun first(b: ?Bag) -> []Int
    head(b.items[..])

  fun window(v: ?List[Int]) -> []Int
    head(v)

  v: List[Int] = List()
  !v.push(1)
  b = Bag(items: List())
  !b.items.push(2)
  r = head(v)
  xs = b.all()
  h = Holder(seen: head(v))
  h.seen = head(v)
  n = count(v)
  m = b.all().len
  s = b.size()
  ok = head(?v)
  ys = ?b.all()
  nested = head(head(v))
  print(r, xs, h.seen, n, m, s, ok, ys, nested)
  print(head(v).len, b.all(), count(v))

fail "len is a field", "5:6: no method `len` on type `[]Int`; `len` is a field: write `xs.len`", "10:9: no method `len` on type `List[Int]`; `len` is a field: write `v.len`", "10:18: no method `len` on type `Static`; `len` is a field: write `s.len`", "10:27: `len` is a field: write `a.len`", "10:37: `len` is a field: write `v.len`", errors: 5
  # The length of a List, String, array, or slice is the field `len`, not a
  # method.

  fun count(xs: []Int) -> Int
    xs.len()

  v: List[Int] = List()
  s = "abc"
  a = [1, 2]
  print(v.len(), s.len(), a.len(), ?v.len(), count(?a[..]))

fail "lent closure to generic view", "13:7: `use_it` cannot take a lent closure for `T`", "14:5: `View` cannot take a lent closure for `T`", "16:5: a call never changes what a closure captures, so a closure is lent to read: write `?f`"
  # A closure is lent only where a `?fun(...)` / `?sub(...)` is declared:
  # a `?T` of a generic function, field, or payload takes a read view of
  # a value, and a stack closure is not one. `!f` does not lend it.

  obj View[T]
    w: ?T

  fun use_it[T](x: ?T) -> Int
    1

  k = 5
  f = |+k, a: Int| a + k
  print(use_it(?f))
  v = View(w: ?f)
  print(v.w(1))
  w = !f

fail "list filled rejected", "13:10: `List.filled` copies its value into every element, and a `String` owns a resource, so it cannot be copied: write a loop that makes each element with `+x` (`for 0..n` with `!xs.push(+x)`)", "14:10: `List.filled` copies its value into every element, and a `Named` owns a resource", "15:22: `List.filled` copies its value into every element, and a `^Int` owns a resource", "17:10: `List.filled` copies its value into every element, and a `*Cell[Int]` owns a resource", "18:10: cannot infer `T` for `List` from the arguments", "19:17: type mismatch: expected `Int`, got `Static`", "20:20: `!y` here is read, not held", "21:5: `make[String]` cannot use `T = String`", "22:10: cannot infer `T` for `List` from the arguments", errors: 9
  # `List.filled(n, x)` copies `x` into every element, so the element must
  # copy (docs/CORE.md): an owner, a box, a handle, or an object holding
  # one is made once per element by a loop that says so. The element
  # needs a type, and the count is an `Int`.

  obj Named
    name: String

  fun make[T](n: Int, x: T) -> List[T]
    List.filled(n, x)

