test "elements are places", '''
  [5, 6] 2 2 2
  ["zz"] zz true zz
  y 4
  o
  [none]
  drop 1
  after
  drop 5
  q
  [["r"]]
  end
  drop 6
  drop 4
  drop 2
  drop 3
'''
  # Every element of a List, an array, or a slice is a place, as a field
  # is (Core §5): it is read in place, lent with `?v[i]` and `!v[i]`, and
  # assigning it drops the value it held, once.

  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  obj Rec
    name: String
    n: Int

  fun size(v: ?List[Int]) -> Int
    v.len

  fun first(v: ?List[String]) -> ?String
    ?v[0]

  rows: List[List[Int]] = List()
  r: List[Int] = List()
  !r.push(5)
  !rows.push(<r)
  !rows[0].push(6)
  print(rows[0], rows[0].len, size(?rows[0]), size(rows[0]))
  ts: List[String] = List()
  !ts.push(String("a"))
  !ts[0].add("b")
  ts[0] = String("zz")
  print(ts, first(?ts), ts[0] == ts[0], +ts[0])
  rs: List[Rec] = List()
  !rs.push(Rec(name: String("x"), n: 1))
  rs[0].n = 4
  rs[0].name = String("y")
  print(rs[0].name, rs[0].n)
  os: List[String?] = List()
  !os.push(String("o"))
  if <os[0] as t
    print(t)
  print(os)
  ds: List[D] = List()
  !ds.push(D(n: 1))
  !ds.push(D(n: 2))
  ds[0] = D(n: 3)
  print("after")
  a = [D(n: 4), D(n: 5)]
  a[1] = D(n: 6)
  m: List[List[String]] = List()
  row: List[String] = List()
  !row.push(String("q"))
  !m.push(<row)
  for t in m[0]
    print(t)
  for t in !m[0]
    !t.add("!")
  m[0][0] = String("r")
  print(m)
  print("end")

fail "endian misuse", "5:20: no variant `native` on enum `Endian`", "6:19: type mismatch: expected `Endian`, got `Int`", "8:19: compile-time argument 2 of `read` must be known at compile time", "9:14: `.big` is not a type", "10:7: `read` of a `U16` takes a byte order too: `read[U32, .little](at)`", "11:9: `read` takes the type and the byte order in brackets", "12:14: `read` reads an integer or float type, or a `Simd` of them; got `Bool`", "13:24: integer value `70000` does not fit in `U16`", "14:14: no variant `native` on enum `Endian`"
  # `read` and `write` take the type, then a compile-time `Endian`, in
  # brackets: `.little` or `.big` (there is no `.native`).

  b: [8]U8 = [8 of 0]
  print(b.read[U16, .native](0))
  print(b.read[U16, 1](0))
  e: Endian = .big
  print(b.read[U16, e](0))
  print(b.read[.big, U16](0))
  print(b.read[U16](0))
  print(b.read(0))
  print(b.read[Bool, .big](0))
  !b.write[U16, .big](0, 70000)
  x: Endian = .native
  print(x)

fail "endian reserved", "3:6: `Endian` is a reserved built-in nominal name and cannot be redefined"
  # `Endian` is a built-in type: a module cannot declare its own.

  enum Endian
    little
    big
    native

  print(Endian.big)

fail "eq shared handle", "8:7: `==` is not defined for `*String`: `*String` is a handle, which could compare by identity or by content", "9:7: cannot compare `*String` with `String`"
  # A handle has no `==`: it could compare by identity or by content. Two
  # `*String`s, or a `*String` and a String, compare their content through
  # a view, `?a == ?b`.

  s = *String("q")
  r = *String("q")
  t = String("q")
  print(s == r)
  print(s == t)

test "eq shared through view", '''
  true false true true
  true false
'''
  # Two shared handles' contents compare through views, `?a == ?b`, and
  # a handle's content with a value, `?s == t`: a handle itself has no
  # `==`.

  obj P
    n: Int
    name: String

  s = *String("q")
  r = *String("q")
  u = *String("z")
  t = String("q")
  print(?s == ?r, ?s == ?u, ?s == t, ?s == "q")
  a = *P(n: 1, name: String("x"))
  b = *P(n: 1, name: String("x"))
  c = *P(n: 2, name: String("x"))
  print(?a == ?b, ?a == ?c)

test "equality claims", '''
  false true
  true false true
'''
  # `==` never calls a method named `eq`: it compares fields. A write
  # viewed operand compares as the value it reaches, like a read view.

  obj P
    x: Int
    y: Int

    fun eq(?@, o: ?P) -> Bool
      true

  fun same(a: !P, b: ?P) -> Bool
    a == b

  fun differ(a: !P, b: P) -> Bool
    b != a

  a = P(x: 1, y: 2)
  b = P(x: 3, y: 4)
  print(a == b, a.eq(?b))
  c = a
  print(same(!c, ?a), same(!c, ?b), differ(!c, b))

fail "equality drop struct", "12:7: `!=` is not defined for `File`: `File` declares `drop`"
  # A struct with a `drop` body owns a resource and has no `==`, even when
  # its fields compare.

  obj File
    fd: Int

    drop(!@)
      print("close", @fd)

  a = File(fd: 3)
  b = File(fd: 3)
  print(a != b)

fail "equality function field", "12:7: `==` is not defined for `Op`: field `run` is a function value", "14:7: `==` is not defined for `fun(Int) -> Int`: `fun(Int) -> Int` is a function value"
  # A struct holding a function value has no `==`, nor does a function.

  obj Op
    name: ?String
    run: fun(Int) -> Int

  fun inc(n: Int) -> Int
    n + 1

  a = Op(name: "inc", run: inc)
  b = Op(name: "inc", run: inc)
  print(a == b)
  f = inc
  print(f == inc)

fail "equality handle field", "13:7: `==` is not defined for `Link`: field `to` is a handle `*Node`"
  # A struct holding a handle has no `==`: it could compare the handles or
  # the values behind them. The diagnostic names the field.

  obj Node
    n: Int

  obj Link
    id: Int
    to: *Node

  a = Link(id: 1, to: *Node(n: 1))
  b = Link(id: 1, to: *Node(n: 1))
  print(a == b)

fail "equality nested offender", "26:7: `==` is not defined for `Outer`: field `inner.items` is a `List[Int]`, which has no `==`", "29:7: `==` is not defined for `Rack`: field `slots.full.held` is a `Res`: `Res` declares `drop`"
  # The diagnostic names the field path to what has no `==`, through
  # nested structs, arrays, optionals, and enum payloads; a List has none.

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  obj Inner
    items: List[Int]

  obj Outer
    tag: Int
    inner: Inner

  enum Slot
    empty
    full(held: Res)

  obj Rack
    slots: [2]Slot?

  a = Outer(tag: 1, inner: Inner(items: List()))
  b = Outer(tag: 1, inner: Inner(items: List()))
  print(a == b)
  r = Rack(slots: [none, none])
  s = Rack(slots: [none, none])
  print(r == s)

fail "equality no eq kinds", "11:7: `==` is not defined for `~N`: `~N` is a handle, which could compare by identity or by content", "13:7: `==` is not defined for `Cell[Int]`: `Cell[Int]` has no `==`", "15:7: `==` is not defined for `*Signal[Int]`: `*Signal[Int]` is a handle", "17:7: `==` is not defined for `*fun(Int) -> Int`: `*fun(Int) -> Int` is an owned closure"
  # A weak handle, a Cell, a Signal, and an owned closure have no `==`.

  obj N
    n: Int

  obj H
    c: Cell[Int]

  s = *N(n: 1)
  w = ~s
  print(w == w)
  h = *H(c: Cell(1))
  print(h.c == h.c)
  g = *Signal(1)
  print(g == g)
  f = *|x: Int| x + 1
  print(f == f)

