test "fail through return", '''
  2 10
  3 10
  5 10 10
  2 10
'''
  # A function fails with `return` of an error value: a member of an error
  # set, a binding of one, an error it caught, or a branch of the returned
  # value, of a ternary or a `match`.

  error E
    bad
    worse

  fun named(k: Int) -> Int!
    e = E.worse
    return k if k > 0
    return e

  fun ternary(k: Int) -> Int!
    return k if k > 0 else E.bad

  fun arm(k: Int) -> Int!
    return match k
      0 => E.bad
      1 => E.worse
      _ => k

  fun caught(k: Int) -> Int!
    n = ternary(k) catch |err|
      return err
    n + 1

  print(named(2) catch -1, named(0) catch |e| 10 if e == E.worse else 20)
  print(ternary(3) catch -1, ternary(0) catch |e| 10 if e == E.bad else 20)
  print(arm(5) catch -1, arm(0) catch |e| 10 if e == E.bad else 20, arm(1) catch |e| 10 if e == E.worse else 20)
  print(caught(1) catch -1, caught(0) catch |e| 10 if e == E.bad else 20)

fail "fallback not fresh", "15:16: `e` owns a `String`, which can't be copied by `=`: write `<e` to move it, `+e` to clone it, or `?e` to view it", "15:28: `g` owns a `String`, which can't be copied by `=`: write `<g` to move it, `+g` to clone it, or `?g` to view it", errors: 2
  # A binding takes the value of `??`, and so each of its operands: a
  # fallback that may be an owner a name holds needs `<`. A read of `o?`
  # takes nothing.

  fun mko(k: Int) -> String?
    String("o") if k > 0 else none

  fun f(o: String?) -> Int?
    print(o?)
    1

  e = String("e")
  g = String("g")
  c = true
  y = mko(0) ?? (e if c else g)
  print(y, f(none))

fail "fallback variant literal lent hint", "18:6: lend the fallback, so the result is the view, and clone that for a `Val` of its own: `+(o ?? ?(Val.empty))`", "19:6: lend the fallback, so the result is the view, and clone that for a `Val` of its own: `+(o ?? ?(Val.table(m: List())))`"
  # A `??` whose fallback is a value copies out what its left side views;
  # the hint lends the fallback in a form that parses and types: a
  # variant literal names its enum, and a call through a type is
  # parenthesized, since `?Val.table(...)` would lend `Val`.

  enum Val
    num(n: Int)
    table(m: List[Int])
    empty

  sub show(v: ?Val)
    match v
      .num(n) => print(n)
      .table(m) => print(m.len)
      .empty => print("empty")

  o: (?Val)? = none
  show(o ?? .empty)
  show(o ?? Val.table(m: List()))

