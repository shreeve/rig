test "fallible sub", '''
  ok 1
  ok 3
  failed Bad.neg
  ok 1
  ok 2
  stopped Bad.neg
  ok 4
  add failed Bad.full
  [1, 2]
'''
  # A `sub` that may fail is declared `sub f(...)!`: it fails with
  # `return E.name` or by propagating with `!`, and its type is
  # `sub(...)!`. A method, a function value, and a callable view
  # parameter all take that form.

  error Bad
    neg
    full

  sub check(n: Int)!
    return Bad.neg if n < 0
    print("ok", n)

  sub twice(n: Int)!
    check(n)!
    check(n - 5)!

  sub each(xs: []Int, f: ?sub(Int)!)!
    for x in xs
      f(x)!

  obj Bin
    items: List[Int]

    sub add(!@, n: Int)!
      return Bad.full if @items.len >= 2
      !@items.push(n)

  check(1)!
  twice(3) catch |e|
    print("failed", e)
  a = [1, 2, -3]
  each(?a, check) catch |e|
    print("stopped", e)
  h: sub(Int)! = check
  h(4)!
  b = Bin(items: List())
  !b.add(1)!
  !b.add(2)!
  !b.add(3) catch |e|
    print("add failed", e)
  print(b.items)

fail "fallible sub hints", "11:3: use of `!` propagation requires the enclosing `w` to be fallible: `sub w()!`", "14:10: a `sub` that cannot fail returns no error; declare it fallible to fail: `sub f(n: Int)!`", "25:5: `M` has one field, given by position alone (`M(x)`) or by name (`M(v: x)`)", "26:5: `Empty` has no fields: `Empty()`"
  # A `sub` that is not fallible cannot propagate or return an error; the
  # fix is `sub f(...)!`. A type with one field takes one value.

  error Bad
    neg

  fun g() -> Int!
    return Bad.neg

  sub w()
    g()!

  sub f(n: Int)
    return Bad.neg if n > 0

  obj M
    v: Int

  obj Empty
    sub hi(?@)
      print("hi")

  w()
  f(1)
  m = M(1, 2)
  e = Empty(1)
  print(m.v)
  e.hi()

test "fallible sub statement ends", '''
  zero
  d failed Bad.neg
  big 3
  0
'''
  # A fallible `sub` yields no value, whatever its last statement is: a
  # propagated call, a handled call, a method call, or an `if` without an
  # `else`. So does a closure lent as a `?sub(Int)!`.

  error Bad
    neg

  fun get(n: Int) -> Int!
    return Bad.neg if n < 0
    n

  sub a(n: Int)!
    get(n)!

  sub b(n: Int)!
    get(n) catch 0

  sub c(v: !List[Int])!
    !v.pop()

  sub d(n: Int)!
    if n < 0
      return Bad.neg
    else if n == 0
      print("zero")

  sub run(f: ?sub(Int)!)!
    f(3)!

  fun sq(n: Int) -> Int
    n * n

  a(1)!
  b(-1)!
  v: List[Int] = List()
  !v.push(7)
  c(!v)!
  d(0)!
  d(-1) catch |e|
    print("d failed", e)
  run(|x| sq(x))!
  run(|x|
    if x > 2
      print("big", x)
    else if x < 0
      print("negative")
  )!
  print(v.len)

