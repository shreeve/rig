test "read locals", '''
  0
  took 0
  1
  5
  tick
  tick
  circle
  some
  0
  unlock 1
'''
  # Every local is read, in any way: an argument, a view, a move, a
  # clone, a field write, a closure capture, or a drop. `_` binds nothing,
  # `_ = e` discards a value, and a value with drop glue is read by its
  # own release, so a guard held to the end of its scope needs no other
  # use. Parameters need not be read.

  obj Lock
    id: Int

    drop(!@)
      print("unlock", @id)

  obj P
    n: Int

  enum Shape
    circle(r: Int)
    dot

  error E
    bad

  fun maybe(n: Int) -> Int?
    n if n > 0 else none

  fun fails() -> Int!
    return E.bad

  fun ignore(n: Int) -> Int
    0

  sub take(v: List[Int])
    print("took", v.len)

  lock = Lock(id: 1)
  v: List[Int] = List()
  r = ?v
  print(r.len)
  w: List[Int] = List()
  take(<w)
  p = P(n: 1)
  q = +p
  print(q.n)
  s = P(n: 2)
  s.n = 3
  c = 4
  f = |+c| c + 1
  print(f())
  d = ?c
  <d
  for _ in 0..2
    print("tick")
  sh: Shape = .circle(r: 1)
  match sh
    .circle(_) => print("circle")
    _ => print("other")
  if maybe(1) as _
    print("some")
  _ = fails() catch |_|
    0
  _ = maybe(2)
  print(ignore(7))

fail "read only field without pub", "5:3: `?` before a field means other modules may read it but not write it, which only a `pub` field allows"
  # `?` before a field means other modules may read it but not write it,
  # which only a `pub` field allows.

  obj Tally
    ?count: Int

  print(Tally(count: 1).count)

fail "read receiver where result view expected", "15:13: `?p.shifted(4)` reads `p` for the call; write `?(p.shifted(4))` to lend the call's result", "17:13: write `?(h.shifted(1))` to lend the call's result"
  # `?p.m()` reads `p` for the call; where a view of the call's result
  # is kept (a binding), the hint puts the view around the call. (As an
  # argument, the result is lent as a temporary of the statement.)

  obj Point
    x: Int

    fun shifted(?@, d: Int) -> Point
      Point(x: @x + d)

  sub show(p: ?Point)
    print(p.x)

  p = Point(x: 1)
  r: ?Point = ?p.shifted(4)
  h = *Point(x: 9)
  s: ?Point = ?h.shifted(1)
  show(r)
  show(s)

test "read viewed int", "3"
  # A view of a Copy value reads as the value in arithmetic.

  fun inc(n: ?Int) -> Int
    n + 1

  x = 2
  print(inc(?x))

test "rebind view local", '''
  1
  2
  1 2
'''
  # A local holding a view can be rebound to lend something else.

  a = 1
  b = 2
  r = ?a
  print(r)
  r = ?b
  print(r)
  print(a, b)

fail "self move sigil misuse", "6:4: sigil-prefixed member (`?other` / `!other` / `<other`) is not allowed in a nominal body", "11:17: self, `@`, must be the first parameter of a method", "11:17: sigil-prefixed parameter sugar (`?@` / `!@` / `<@`) is only allowed at the first parameter position", "14:9: `drop` takes self lent to write: `drop(!@)`", "17:8: sigil-prefixed parameter is only allowed for self, `@`", "20:8: `<@` is only allowed in a method body"
  # `<@` is only a method's first parameter, and only `@` takes it; a
  # drop body views its receiver, so it cannot take `<@`.

  obj Conn
    name: ?String
    <other

    fun close(<@) -> Int
      @name.len

    fun both(?@, <@) -> Int
      1

    drop(<@)
      print("bye")

  fun f(<x) -> Int
    1

  fun g(<@) -> Int
    1

  print(f(1), g(2))

fail "receiver sigil bool result", "16:6: write `(!s).checked(3)`: a write call whose value is used puts its `!` in parentheses", "21:4: write `(!set).insert(1)`: a write call whose value is used puts its `!` in parentheses", "23:7: write `(!set).insert(2)`: a write call whose value is used puts its `!` in parentheses", "25:17: write `(!set).insert(3)`: a write call whose value is used puts its `!` in parentheses", "26:14: write `(!set).insert(4)`: a write call whose value is used puts its `!` in parentheses", "27:5: write `(!set).insert(5)`: a write call whose value is used puts its `!` in parentheses", "28:9: write `(!set).insert(6)`: a write call whose value is used puts its `!` in parentheses", "29:10: write `(!set).insert(7)`: a write call whose value is used puts its `!` in parentheses", "32:4: write `(!set).insert(8)`: a write call whose value is used puts its `!` in parentheses", "34:14: write `(!set).insert(9)`: a write call whose value is used puts its `!` in parentheses", "35:10: write `(!set).insert(10)`: a write call whose value is used puts its `!` in parentheses", "36:15: write `(!set).insert(11)`: a write call whose value is used puts its `!` in parentheses", "37:10: write `(!set).insert(12)`: a write call whose value is used puts its `!` in parentheses"
  # A write call whose value is used is written with the lend in
  # parentheses, `(!s).m(...)`, so a leading `!` never reads as negation:
  # here, a `Bool` in a condition and an operand of `and`, `or`, or `not`.

  obj Set
    items: List[Int]
    fun insert(!@, k: Int) -> Bool
      for x in ?@items
        return false if x == k
      !@items.push(k)
      true
    fun checked(!@, k: Int) -> Bool!
      @insert(k)

  fun fill(s: !Set) -> Int!
    if !s.checked(3)!
      return 1
    0

  set = Set(items: List())
  if !set.insert(1)
    print("new")
  while !set.insert(2)
    print("again")
  print("dup") if !set.insert(3)
  a = true and !set.insert(4)
  b = !set.insert(5) or false
  c = not !set.insert(6)
  d = 1 if !set.insert(7) else 0
  print(a, b, c, d)
  print(fill(!set) catch 0)
  if !set.insert(8) == false
    print("seen")
  e = true and !set.insert(9) == true
  f = not (!set.insert(10) == true)
  print("x") if !set.insert(11) != false
  g = 1 if !set.insert(12) == true else 2
  print(e, f, g)

fail "receiver sigil bool used", "14:5: write `(!@).insert(k)`: a write call whose value is used puts its `!` in parentheses", "17:10: write `(!s).insert(k)`: a write call whose value is used puts its `!` in parentheses", "20:3: write `(!s).insert(k)`: a write call whose value is used puts its `!` in parentheses", "23:11: write `(!s).checked(3)`: a write call whose value is used puts its `!` in parentheses", "27:9: write `(!set).insert(1)`: a write call whose value is used puts its `!` in parentheses", "28:7: write `(!set).insert(1)`: a write call whose value is used puts its `!` in parentheses", "29:7: write `(!set).insert(2)`: a write call whose value is used puts its `!` in parentheses", "32:25: write `(!set).insert(3)`: a write call whose value is used puts its `!` in parentheses", "33:6: write `(!set).checked(4)`: a write call whose value is used puts its `!` in parentheses", errors: 9
  # A write call whose value is used is written `(!s).m(...)` wherever
  # the value goes, not only where its `!` could read as negation: here a
  # `Bool` in a binding, an argument, a `return`, a body's value, a
  # `match` subject, a ternary's branch, a `catch` value that is used.

  obj Set
    items: List[Int]
    fun insert(!@, k: Int) -> Bool
      for x in ?@items
        return false if x == k
      !@items.push(k)
      true
    fun checked(!@, k: Int) -> Bool!
      !@insert(k)

  fun add(s: !Set, k: Int) -> Bool
    return !s.insert(k)

  fun again(s: !Set, k: Int) -> Bool
    !s.insert(k)

  fun fill(s: !Set) -> Int!
    added = !s.checked(3)!
    1 if added else 0

  set = Set(items: List())
  fresh = !set.insert(1)
  print(!set.insert(1))
  match !set.insert(2)
    true => print("new")
    false => print("old")
  n = fresh if fresh else !set.insert(3)
  ok = !set.checked(4) catch false
  !set.insert(5)
  print(fresh, n, ok)

test "catch statement handler gives nothing", '''
  failed Parse.empty
  then Parse.empty
  no name
  named Parse.empty
  owned failed Parse.empty
  done 3
'''
  # A `catch` whose value goes nowhere, a statement's or `_ =`'s, may
  # have a handler that gives nothing; a handler that gives a value gives
  # the fallback, as anywhere: `0`, a call, or a block's last value.
  error Parse
    empty

  fun parse(s: ?String) -> Int!
    return Parse.empty if s.len == 0
    s.len

  fun name(s: ?String) -> String!
    return Parse.empty if s.len == 0
    String(s)

  fun fallback() -> Int
    7

  parse("") catch |e| print("failed", e)
  parse("ok") catch |e|
    print("never", e)
  parse("") catch 0
  parse("") catch fallback()
  parse("") catch 1 + 2
  parse("") catch |e|
    print("then", e)
    -1
  parse("") catch print("no name")
  _ = parse("") catch |e| print("named", e)
  _ = name("") catch |e| print("owned failed", e)
  _ = name("yes") catch |e| print("never", e)
  x = parse("abc") catch 0
  print("done", x)

test "catch statement handler gives nothing released", release: true, "ok 2"
  # The same in Zig's safe mode: the value is dropped, the handler runs
  # on an error.
  error Parse
    empty

  fun name(s: ?String) -> String!
    return Parse.empty if s.len == 0
    String(s)

  _ = name("yes") catch |e| print("never", e)
  _ = name("") catch |e| print("ok", 2)

fail "catch statement owned", "`name(\"\")` gives a `String`, which owns what it must release, and this `catch` throws it away: drop it by name, `_ = name(\"\") catch ...`", errors: 1
  # An owned value is dropped visibly, by `_ =`.
  error Parse
    empty

  fun name(s: ?String) -> String!
    return Parse.empty if s.len == 0
    String(s)

  name("") catch |e| print("failed", e)
