test "comptime param args", '''
  3
  4
  true
  15 20
'''
  # A compile-time parameter, `[n: Int]`, accepts literals, enum values,
  # compile-time parameters, and `=!` bindings of compile-time values. A
  # call gives those arguments in brackets, before its run-time ones.

  enum Mode
    fast
    safe

  sub show[n: Int]()
    print(n)

  sub mode[m: Mode]()
    print(m == .safe)

  fun scale[factor: Int](x: Int) -> Int
    x * factor

  fun twice[factor: Int](x: Int) -> Int
    scale[factor](scale[factor](x))

  show[3]()
  k =! 4
  show[k]()
  mode[.safe]()
  print(scale[3](5), twice[2](5))

test "comptime param calls", '''
  true false true
  3
  4
  lax 2 true
  strict 2 false
  35 14
  7
'''
  # Compile-time arguments go in brackets before the run-time ones, for a
  # function, a method called on a value or through its type, and an
  # associated function. A compile-time parameter can be passed on to
  # another, and a function with no run-time parameters is called with
  # empty parentheses: `show[3]()`.

  enum Mode
    strict
    lax

  fun check[mode: Mode](n: Int) -> Bool
    if mode == .strict
      return n > 3
    n > 0

  fun both[mode: Mode](a: Int, b: Int) -> Bool
    check[mode](a) and check[mode](b)

  sub show[n: Int]()
    print(n)

  sub report[mode: Mode, n: Int](label: ?String)
    print(label, check[mode](n))

  obj Scale
    k: Int

    fun times[n: Int](?@) -> Int
      @k * n

    sub bump[by: Int](!@)
      @k += by

    fun unit[n: Int]() -> Scale
      Scale(k: n)

  print(check[.strict](5), check[.lax](0), both[.strict](4, 9))
  show[3]()
  show[4]()
  report[.lax, 2]("lax 2")
  report[.strict, 2]("strict 2")
  s = Scale.unit[6]()
  !s.bump[1]()
  print(s.times[5](), Scale.times[2](?s))
  limit =! 7
  show[limit]()

