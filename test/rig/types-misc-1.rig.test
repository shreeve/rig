fail "capture module constant", "6:9: only a local can be captured; `k` is declared at module level, so use it in the closure directly"
  # A module-level constant is not captured; a closure reads it directly.

  k = 5

  sub main()
    c = |+k| k + 1
    print(c())

fail "capture module function", "only a local can be captured; `dbl` is declared at module level"
