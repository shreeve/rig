test "constant run time arithmetic", '''
  250 205
  30
  98 122
'''
  # Arithmetic that Rig does not compute ahead of time runs when the
  # program runs, even on constants: a value chosen by a run-time
  # condition, a compile-time parameter, and an index into a string. (Overflow
  # there is a run-time panic, not a Zig compile error.)

  sub scaled[n: U8](k: U8)
    print(n + k)

  fun pick(big: Bool) -> U8
    x: U8 = 200
    x + (50 if big else 5)

  print(pick(true), pick(false))
  scaled[10](20)
  s = "abc"
  i = 1
  print(s[i], "xyz"[2])

fail "consume receiver part", "19:7: method `into` takes its self with `<@`, and `<` cannot move `k.d` out of the value that holds it; exchange it out first: `swap(!k.d, v).into(...)`", "19:19: method `into` takes its self with `<@`, and `<` cannot move `ds[0]` out of the value that holds it; exchange it out first: `swap(!ds[0], v).into(...)`", "19:33: method `into` consumes `self`, and `mk().d` is a part of a temporary its statement drops; bind the value to a name first", errors: 3
  # A method that consumes its receiver cannot take a field or element
  # that moves: the owner keeps it, and `<` cannot move it out, nor out of
  # a temporary. (One that copies is taken as a copy.)

  obj D
    v: List[Int]

    fun into(<@) -> Int
      @v.len

  obj K
    d: D

  fun mk() -> K
    K(d: D(v: List()))

  k = K(d: D(v: List()))
  ds: List[D] = List()
  print(k.d.into(), ds[0].into(), mk().d.into())

test "consuming method on temporary", '''
  drop 4
  8
'''
  # A method that consumes its receiver (`<@`) may take a
  # temporary: the method owns it and drops it.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

    fun take(<@) -> Int
      @n * 2

  fun mk(n: Int) -> B
    B(n: n)

  print(mk(4).take())

test "containers hold owners", '''
  1
  1 2
  [B(n: 2)]
  0 1
  x
  y
  drop 2
  drop 1
'''
  # Vecs, arrays, and slices hold values that own resources, and drop
  # each once (Core §5).

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  obj A
    items: [2]C

  obj C
    h: *Int

  obj Bag
    items: List[Int]

  fun total(s: []Bag) -> Int
    n = 0
    for b in s
      n += b.items.len
    n

  a = *B(n: 1)
  xs = [<a]
  print(xs.len)
  holder = A(items: [C(h: *1), C(h: *2)])
  print(holder.items[0].h, holder.items[1].h)
  v: List[*B] = List()
  !v.push(*B(n: 2))
  print(v[0..1])
  rows: List[List[Int]] = List()
  bags: List[Bag] = List()
  b: List[Int] = List()
  !b.push(7)
  !bags.push(Bag(items: <b))
  print(rows.len, total(?bags[..]))
  ts = [String("x"), String("y")]
  for t in <ts
    print(t)

test "contents declared later", "1 2"
  # What a type holds does not depend on the order of declarations: a
  # shared Cell of an owning struct, a List of plain data, and an owned
  # closure over a plain enum, each spelled before the type it names is
  # declared.

  obj A
    c: *Cell[B]
    v: List[P]
    f: *fun(Color) -> Int

  obj B
    h: *Int

  obj P
    n: Int

  enum Color
    red
    green

  f: *fun(Color) -> Int = *|c| 1 if c == .red else 2
  a = A(c: *Cell(B(h: *5)), v: List(), f: <f)
  !a.v.push(P(n: 3))
  print(a.v.len, a.f(.green))

test "conversion typed argument", "5 5 2 5"
  # The literals inside a typed conversion argument are values of the
  # argument's own type: only the converted value must fit the target.

  fun id(x: Int) -> Int
    x

  v = id(5)
  c: Int = -1
  print(U8(v + 300 - 300), U8(v * -1 + 10), U8(v % -3), U8(v ^ c ^ c))

fail "copies clone write view holder", "7:6: a write view is never stored inside a value, and `!Int` cannot stand here", errors: 1
  # No value holds a write view, so none is copied or cloned by `+x` or
  # `|+x|`, in an optional, an array, or a generic instance: a write view
  # is never stored inside a value, and the field is rejected where it is
  # declared.

  obj H
    w: !Int

  n = 1
  print(n)

test "copies fallback none view", "P(x: 1) 3 2 4"
  # A `??` or `catch` whose left side gives a view of a value that copies,
  # and whose fallback is no view, copies the value out: `none` where an
  # optional of the value is expected gives that optional, whether the
  # view is held by address (`?P`) or by value (`!Int`, read through).

  obj P
    x: Int

  a = P(x: 1)
  i: (?P)? = ?a
  f: P? = i ?? none
  a.x = 2
  n = 3
  w: (!Int)? = !n
  g: Int? = <w ?? none
  n = 4
  print(f, g, a.x, n)

test "copy from write view", "2"
  # Binding a `!Int` parameter's value to a local copies the Int.

  sub bump(c: !Int)
    old = c
    c = old + 1

  n = 1
  bump(!n)
  print(n)

fail "counted weak handle", "10:16: `*~S` stacks one heap holding on another", "18:14: `Wrap[~S]` holds `*~S`, which stacks one heap holding on another", "22:4: `*~S` stacks one heap holding on another", "23:5: `count` at these types has `*~S` in its signature, which stacks one heap holding on another", "24:17: type mismatch: expected `*~S`, got `*S?`"
  # A value is held one way on the heap, so no counted handle holds a weak
  # one: `*~T` is rejected wherever the type comes from, written, named by
  # an alias, or reached through a generic's parameter. `*` of a weak
  # handle upgrades it instead (test/behavior/runtime/weak_star_upgrade.rig),
  # so it makes no `*~T` where one is expected.

  obj S
    n: Int

  type Counted = *~S

  obj Wrap[T]
    h: *T

  fun count[T](x: T) -> *T
    *<x

  sub look(c: ?Wrap[~S])
    print(1)

  s = *S(n: 1)
  a: *~S = *~s
  b = count(~s)
  c = Wrap[~S](h: *~s)

