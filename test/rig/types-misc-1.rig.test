test "function name as result", '''
  hi
  wave
  42
'''
  # A function name whose value is used, such as a fun's last line or a
  # branch value, is the function itself; only a discarded one is an error.

  sub greet()
    print("hi")

  sub wave()
    print("wave")

  fun pick(polite: Bool) -> sub()
    if polite
      greet
    else
      wave

  fun twice(n: Int) -> Int
    n * 2

  fun doubler() -> fun(Int) -> Int
    twice

  f = pick(true)
  f()
  pick(false)()
  print(doubler()(21))

test "function type arrow", '''
  3 -1
  8
  20
'''
  # A function type writes its result after `->`. A suffix belongs to the
  # result (`fun(Int) -> Int!` is fallible), an optional function type is
  # parenthesized, and a result may itself be a function type.

  error Bad
    negative

  fun check(n: Int) -> Int!
    return Bad.negative if n < 0
    n

  fun double(n: Int) -> Int
    n * 2

  fun twice(f: fun(Int) -> Int) -> *fun(Int) -> Int
    *|<f, x| f(f(x))

  f: fun(Int) -> Int! = check
  print(f(3) catch -1, f(-3) catch -1)
  g: (fun(Int) -> Int)? = double
  if g as h
    print(h(4))
  t = twice(double)
  print(t(5))

