fail "marker frame over limit", "10:5: `near_limit` keeps 13632024 bytes of values on its stack", errors: 1
  # A function may keep 13 MiB of values on its stack, counting the
  # functions inlined in it. The compiler leaves a function it chose to
  # inline as a call where that would pass the limit; a marked `inline` one
  # stays inlined, so the caller is an error.

  inline fun bump(i: Int) -> Int
    t = [4000 of i]
    t[i % 4000] + 1

  sub near_limit(i: Int)
    a = [850000 of 1]
    b = [850000 of 2]
    print(bump(i) + a[i] + b[i])

  near_limit(3)

fail "marker frame siblings", "22:5: `values` keeps", "25:5: `methods` keeps", "30:5: `deferred` keeps", "35:7: a closure keeps", "38:5: `chain` keeps", errors: 5
  # Every way a call inlines a marked `inline` function adds its values to
  # the frame the call is in: an instance of a compile-time value parameter,
  # a method of a generic object type, directly and through a shared handle,
  # a call in `defer`, and a call in a closure, whose frame is its own. An
  # `inline` function in the middle of a chain is no frame of its own: only
  # the function the chain is inlined into is reported.

  inline fun bign[n: Int](i: Int) -> Int
    t = [1000000 of n]
    t[i % 1000000]

  obj G[T]
    v: T

    inline fun big(?@, i: Int) -> Int
      t = [1000000 of i]
      t[i % 1000000]

  inline fun mid(i: Int) -> Int
    bign[1](i) + bign[2](i)

  sub values(i: Int)
    print(bign[1](i) + bign[2](i))

  sub methods(i: Int)
    g = G[Int](v: 1)
    h = *G[Int](v: 2)
    print(g.big(i) + h.big(i))

  sub deferred(i: Int)
    defer print(bign[1](i))
    print(bign[2](i))

  sub closure(i: Int)
    f = |+i| bign[1](i) + bign[2](i)
    print(f())

  sub chain(i: Int)
    print(mid(i))

  values(1)
  methods(1)
  deferred(1)
  closure(1)
  chain(1)

fail "marker generic frame", "10:5: `near_limit` keeps 13632032 bytes of values on its stack", errors: 1
  # A function marked `inline` that is generic over a type adds its values
  # to the frame of each function it is inlined into, at the instance the
  # call makes: `near_limit` is under 13 MiB without `bump`'s 32 KB, and
  # over with it.

  inline fun bump[T](x: T, i: Int) -> T
    t = [4000 of x]
    t[i % 4000]

  sub near_limit(i: Int)
    a = [850000 of 1]
    b = [850000 of 2]
    print(bump(7, i) + a[i] + b[i])

  near_limit(3)

test "marker generic instances", "1 true"
  # A generic function that inlines a marked one is checked at each
  # instance, with the marked function's values at that instance: `run[Bool]`
  # and `run[Int]` both fit, and run.

  inline fun big[T](x: T, i: Int) -> T
    t = [100000 of x]
    t[i % 100000]

  fun run[T](x: T) -> T
    big(x, 1)

  print(run(1), run(true))

fail "marker inline method recursive", "7:14: `Node.deeper` is `inline` and calls itself", errors: 1
  # A method marked `inline` that calls itself through its receiver is a
  # cycle as a function's call of itself is.

  obj Node
    depth: Int

    inline fun deeper(?@, n: Int) -> Int
      @depth if n == 0 else @deeper(n - 1) + 1

  print(Node(depth: 1).deeper(2))

fail "marker inline recursive", "6:12: `count` is `inline` and calls itself, so no call of it can be inlined", "9:12: `even` is `inline` and calls itself through `odd`, also `inline`", errors: 2
  # Zig cannot inline a call into the function it is in: an `inline`
  # function that calls itself, or a cycle of `inline` functions, is an
  # error at the function the cycle returns to. A cycle through a function
  # that is not `inline` is a call there, and is fine.

  inline fun count(n: Int) -> Int
    0 if n == 0 else 1 + count(n - 1)

  inline fun even(n: Int) -> Bool
    true if n == 0 else odd(n - 1)

  inline fun odd(n: Int) -> Bool
    false if n == 0 else even(n - 1)

  inline fun down(n: Int) -> Int
    0 if n == 0 else up(n - 1)

  fun up(n: Int) -> Int
    down(n)

  print(count(3), even(4), down(5))

fail "marker inline value", "17:13: `next` is `inline`, inlined at every call, so it can only be called, not used as a value", "18:13: `Counter.get` is `inline`, inlined at every call, so it can only be called, not used as a value", errors: 2
  # An `inline` function is inlined at every call and has no address, so it
  # is only called: naming it as a value, or a method through its type, is
  # an error. A closure that calls it is a value.

  inline fun next(n: Int) -> Int
    n + 1

  obj Counter
    n: Int

    inline fun get(?@) -> Int
      @n

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  print(apply(next, 1))
  g = Counter.get
  print(apply(|x: Int| next(x), 2))

