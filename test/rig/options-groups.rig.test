use std.datetime
use std.time

test "a group's fields are the function's options, by name", '''
  a 30 3 true
  b 30 5 true
  c 2 3 false
'''
  # docs/design/options.md, section 2.
  obj Net
    timeout: Int = 30
    retries: Int = 3
    follow: Bool = true

  sub fetch(url: ?String, ..net: Net)
    print(url, net.timeout, net.retries, net.follow)

  fetch("a")
  fetch("b", retries: 5)
  fetch("c", follow: false, timeout: 2)

test "a field without a default is a required name-only argument", '''
  a.txt -> b.txt false
  a.txt -> c.txt true
'''
  obj CopyArgs
    src: Static
    dst: Static
    overwrite: Bool = false

  sub copy(..a: CopyArgs)
    print(a.src, "->", a.dst, a.overwrite)

  copy(src: "a.txt", dst: "b.txt")
  copy(dst: "c.txt", src: "a.txt", overwrite: true)

code "a call with a group passes its fields as arguments, defaults filled", "fetch(\"a\", 30, 9)"
  obj Net
    timeout: Int = 30
    retries: Int = 3

  sub fetch(url: ?String, ..net: Net)
    print(url, net.timeout, net.retries)

  fetch("a", retries: 9)

code "a spread is field reads as arguments", "fetch(\"b\", cfg.net.timeout, 9)"
  obj Net
    timeout: Int = 30
    retries: Int = 3

  obj Config
    name: Static
    net: Net

  sub fetch(url: ?String, ..net: Net)
    print(url, net.timeout, net.retries)

  cfg = Config(name: "prod", net: Net(retries: 5))
  fetch("b", ..cfg.net, retries: 9)

test "inline options and several groups", "1 2 3 4"
  obj A
    a: Int = 0
    b: Int = 0

  obj B
    c: Int = 0

  fun sum(x: Int, scale: Int = 1, ..p: A, ..q: B) -> Int
    (x + p.a + p.b + q.c) * scale

  print(sum(1), sum(1, a: 1), sum(1, b: 1, c: 1), sum(1, scale: 2, a: 1))

test "a body that uses its group whole binds it", "show 7 3\nw 7"
  obj Net
    timeout: Int = 30
    retries: Int = 3

  sub show(n: Net)
    print("show", n.timeout, n.retries)

  sub fetch(url: ?String, ..net: Net)
    show(net)
    print(url, net.timeout)

  fetch("w", timeout: 7)

test "a closure captures its group whole", "4"
  obj Net
    retries: Int = 3

  sub fetch(..net: Net)
    f = |?net| net.retries + 1
    print(f())

  fetch()

test "a group's fields are no names of the body, which may declare them", "1 99"
  obj Net
    timeout: Int = 30

  sub fetch(..net: Net)
    new timeout = 99
    print(net.timeout, timeout)

  fetch(timeout: 1)

fail "a group's field named in the body by itself", "5:9: `timeout` is a field of group `net`, not a name of the body: read it as `net.timeout`", errors: 1
  obj Net
    timeout: Int = 30

  sub fetch(..net: Net)
    print(timeout)

  fetch()

fail "a group's field is not assigned", "5:3: cannot assign to `net.timeout`; group `net` is a parameter, and parameters are immutable", errors: 1
  obj Net
    timeout: Int = 30

  sub fetch(..net: Net)
    net.timeout = 4

  fetch()

fail "the group's declaration refuses collisions", "14:42: `retries` is both a parameter of `post` and a field of its group `net`, a `Net`", "17:20: `timeout` is a field of both group `a`, a `Net`, and group `b`, a `Wait`, of `both`", "20:23: `net` is both group `net` of `named` and a field of its group `w`, a `Wrap`: name the group otherwise", errors: 3
  obj Net
    timeout: Int = 30
    retries: Int = 3

  obj Wait
    timeout: Int = 5

  obj Wrap
    net: Int = 0

  sub fetch(url: ?String, ..net: Net)
    print(url)

  sub post(url: ?String, retries: Int = 0, ..net: Net)
    print(url)

  sub both(..a: Net, ..b: Wait)
    print(a.timeout)

  sub named(..net: Net, ..w: Wrap)
    print(w.net)

  fetch("u")

fail "a group holds an object's plain data", "8:16: group `n` of `count` is a `Int`, which is not an object", "11:10: group `r` of `send` is a `Req`, which holds `body: ?String`, a view; a group holds plain data", "14:10: group `o` of `keep` is a `Own`, which holds `name: String`, an owner; a group holds plain data", errors: 3
  obj Req
    body: ?String
    retries: Int = 0

  obj Own
    name: String

  sub count(..n: Int)
    print(n)

  sub send(..r: Req)
    print(r.retries)

  sub keep(..o: Own)
    print(o.name)

  count()

fail "a pub function's group has pub fields", "7:15: `fetch` is `pub`, so the fields of its group `net`, a `Net`, are public too: declare `timeout` `pub`", errors: 1
  obj Net
    timeout: Int = 30

  sub main()
    fetch()

  pub sub fetch(..net: Net)
    print(net.timeout)

fail "a required parameter after a group", "4:23: `n` has no default but follows the group `net`, so it could only be given by name", errors: 1
  obj Net
    timeout: Int = 30

  sub fetch(..net: Net, n: Int)
    print(n)

  fetch(1)

fail "a group is a parameter of a fun or a sub", "5:3: a group, `..net: Net`, is a parameter of a `fun` or `sub`, whose options its fields become", errors: 1
  obj Net
    timeout: Int = 30

  obj Holder
    ..net: Net

  print(1)

