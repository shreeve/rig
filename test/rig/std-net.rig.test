# std.net: tests whose names start `net`.
use std.net

test "net echo", seeds: 20, '''
  true
  hello
  5
'''
  # A listener takes a connection, and a task echoes what it reads until
  # the other end closes, which reads as 0.
  fun serve(l: net.Listener) -> Int!
    c = l.accept()!
    buf = String()
    total = 0
    while true
      n = (!c).read(!buf, 4096)!
      if n == 0
        break
      total += n
      (!c).write(?buf)!
      buf = String()
    total

  l = net.listen("127.0.0.1:0")!
  port = l.port()
  print(port > 0)
  t = serve(<l)&
  c = net.connect(String("127.0.0.1:", port))!
  (!c).write("hello")!
  got = String()
  while got.len < 5
    _ = (!c).read(!got, 100)!
  print(got)
  _ = <c
  print(>t!)

test "net many connections", seeds: 20, "20000 20000"
  # Each connection is a task of its own; every byte comes back.
  fun conn(c: net.Stream) -> Int!
    new s = <c
    total = 0
    buf = String()
    while true
      n = (!s).read(!buf, 4096)!
      if n == 0
        break
      total += n
      (!s).write(?buf)!
      buf = String()
    total

  fun serve(l: net.Listener, conns: Int) -> Int!
    ts = Tasks[Int!]()
    for 0..conns
      !ts.add(conn(l.accept()!)&)
    xs = >ts!
    sum = 0
    for x in xs
      sum += x
    sum

  fun client(port: Int, msgs: Int) -> Int!
    c = net.connect(String("127.0.0.1:", port))!
    back = 0
    for 0..msgs
      (!c).write("0123456789")!
      got = String()
      while got.len < 10
        _ = (!c).read(!got, 64)!
      back += got.len
    back

  l = net.listen("127.0.0.1:0")!
  port = l.port()
  s = serve(<l, 40)&
  cs = Tasks[Int!]()
  for 0..40
    !cs.add(client(port, 50)&)
  ys = >cs!
  back = 0
  for y in ys
    back += y
  print(back, >s!)

test "net errors", seeds: 20, '''
  NetError.refused
  Stop.timeout
  NetError.address
'''
  # Connecting where no one listens is refused; an accept past its
  # deadline fails with `Stop.timeout`; an address must parse.
  use std.time

  fun try_connect(port: Int) -> Int
    c = net.connect(String("127.0.0.1:", port)) catch |e|
      print(e)
      return -1
    1

  fun wait_accept(l: ?net.Listener) -> Int
    c = time.within(20 * time.MS, |?l| l.accept()!) catch |e|
      print(e)
      return -1
    1

  l = net.listen("127.0.0.1:0")!
  port = l.port()
  _ = <l
  _ = try_connect(port)
  m = net.listen("127.0.0.1:0")!
  _ = wait_accept(?m)
  _ = net.listen("nonsense") catch |e|
    print(e)
    net.listen(":0")!

test "net without tasks", "ping"
  # A program that makes no tasks waits on its own thread.
  l = net.listen("127.0.0.1:0")!
  c = net.connect(String("127.0.0.1:", l.port()))!
  (!c).write("ping")!
  s = l.accept()!
  got = String()
  while got.len < 4
    _ = (!s).read(!got, 10)!
  print(got)

test "net read keeps only the bytes that came", seeds: 20, "5 true"
  # A read into a String without room for `max` more grows it by the
  # bytes that came, not by `max`.
  use std.os

  fun idle() -> Int
    0

  t = idle()&
  l = net.listen("127.0.0.1:0")!
  c = net.connect(String("127.0.0.1:", l.port()))!
  s = l.accept()!
  (!c).write("hello")!
  got = String()
  before = os.memory().live
  n = (!s).read(!got, 16384)!
  grew = os.memory().live - before
  _ = >t
  print(n, grew < 1024)

test "net read of more than a block", seeds: 20, "100000 true"
  # A read of more than the worker's block takes what is waiting behind
  # it too, and every byte comes in order.
  fun send(port: Int) -> Int!
    c = net.connect(String("127.0.0.1:", port))!
    text = String()
    for i in 0..100000
      !text.push(U8(48 + i % 10))
    (!c).write(?text)!
    0

  l = net.listen("127.0.0.1:0")!
  t = send(l.port())&
  s = l.accept()!
  got = String()
  while true
    n = (!s).read(!got, 65536)!
    if n == 0
      break
  _ = >t!
  ok = true
  bytes = ?got[..]
  for i in 0..bytes.len
    if bytes[i] != U8(48 + i % 10)
      ok = false
  print(got.len, ok)

test "net small writes go at once", "true"
  # A stream sends each write at once (TCP_NODELAY): a request written
  # in two pieces is not held back for the acknowledgment of the first,
  # which the other end delays, about 40 ms a round on Linux.
  use std.time

  fun serve(l: net.Listener, rounds: Int) -> Int!
    s = l.accept()!
    for 0..rounds
      got = String()
      while got.len < 2
        _ = (!s).read(!got, 16)!
      (!s).write("ok")!
    0

  l = net.listen("127.0.0.1:0")!
  port = l.port()
  t = serve(<l, 20)&
  c = net.connect(String("127.0.0.1:", port))!
  start = time.now()
  for 0..20
    (!c).write("x")!
    (!c).write("y")!
    got = String()
    while got.len < 2
      _ = (!c).read(!got, 16)!
  ms = start.elapsed() / 1000000
  _ = >t!
  print(ms < 300)
