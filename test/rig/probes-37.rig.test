bomb "rvtests-w1-bytes", "byte read out of range: 4 bytes at offset 1 of 4"
  fun rt(n: Int) -> Int
    n

  b: [4]U8 = [1, 2, 3, 4]
  print(b.read[U32, .big](rt(1)))

bomb "rvtests-w1-convert", "integer does not fit in destination type"
  fun rt(n: Int) -> Int
    n

  print(I8(rt(300)))

bomb "rvtests-w1-copy", "copy between slices of different lengths"
  fun rt(n: Int) -> Int
    n

  a = [1, 2, 3]
  b = [4, 5, 6]
  !a.copy(?b[..rt(2)])

bomb "rvtests-w1-index", "index out of bounds"
  fun rt(n: Int) -> Int
    n

  a = [1, 2, 3]
  print(a[rt(3)])

bomb "rvtests-w1-slice", "slice bounds out of range"
  fun rt(n: Int) -> Int
    n

  s = "abc"
  print(s[0..rt(4)])

bomb "rvtests-w1-swap", "index out of bounds"
  fun rt(n: Int) -> Int
    n

  a = [1, 2, 3]
  !a.swap(0, rt(3))

test "sb-adv2", '''
  5 30 40
  7
'''
  obj P
    x: Int

    sub bump(!self)
      self.x += 1

  sub inc(n: !Int)
    n += 1

  sub go(s: ![]P)
    s[0].x = 5
    !s[1].bump()
    inc(!s[2].x)
    for p in !s[1..]
      p.x *= 10

  ps = [P(x: 1), P(x: 2), P(x: 3)]
  go(!ps[..])
  print(ps[0].x, ps[1].x, ps[2].x)
  w = !ps[..]
  w[2] = P(x: 7)
  print(w[2].x)
