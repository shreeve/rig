fail "review258-p108 generic assign nomove", "`setit[String]` cannot use `T = String`: the generic body copies a `T`, which would duplicate the resource `String` owns"
  fun gslot[T](v: !List[T], i: Int) -> !T from v
    !v[i]

  sub setit[T](v: !List[T], x: T)
    gslot(!v, 0) = x
    print(x)

  v: List[String] = List()
  !v.push(String("a"))
  setit(!v, String("b"))
  print(v)

