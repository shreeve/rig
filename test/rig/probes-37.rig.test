fail "review258-p111 generic assign twice", "use of `x` after move"
  fun gslot[T](v: !List[T], i: Int) -> !T from v
    !v[i]

  sub setit[T](v: !List[T], x: T)
    gslot(!v, 0) = <x
    gslot(!v, 1) = <x

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("a"))
  setit(!v, String("b"))
  print(v)

