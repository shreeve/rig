fail "review258-p130 summary plain", "`go` stores a view of `u` in `v`, which its caller reaches, but its signature does not keep `u`; say so: `keeps u`"
  obj H
    s: ?String

  fun slot(v: !List[H]) -> !H from v
    !v[0]

  sub go(v: !List[H], u: ?String)
    slot(!v) = H(s: u)

  t = String("t")
  v: List[H] = List()
  !v.push(H(s: ?t))
  u = String("u")
  go(!v, ?u)
  !u.add("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")
  print(v[0].s)

fail "review258-p131 summary opt", "`go` stores a view of `u` in `v`, which its caller reaches, but its signature does not keep `u`; say so: `keeps u`"
  obj H
    s: ?String

  fun pick(v: !List[H]) -> (!H)? from v
    return none if v.len == 0
    !v[0]

  fun go(v: !List[H], u: ?String) -> Int?
    pick(!v)? = H(s: u)
    0

  t = String("t")
  v: List[H] = List()
  !v.push(H(s: ?t))
  u = String("u")
  print(go(!v, ?u) ?? 1)
  <u
  print(v[0].s)

fail "review258-p132 summary fallible", "`go` stores a view of `u` in `v`, which its caller reaches, but its signature does not keep `u`; say so: `keeps u`"
  error Bad
    oops

  obj H
    s: ?String

  fun must(v: !List[H]) -> (!H)! from v
    return Bad.oops if v.len == 0
    !v[0]

  fun go(v: !List[H], u: ?String) -> Int!
    must(!v)! = H(s: u)
    0

  t = String("t")
  v: List[H] = List()
  !v.push(H(s: ?t))
  u = String("u")
  print(go(!v, ?u) catch 1)
  <u
  print(v[0].s)

fail "review258-p134 summary method", "`set` stores a view of `u` in `self`, which its caller reaches, but its signature does not keep `u`; say so: `keeps u`"
  obj H
    s: ?String

  obj Bag
    items: List[H]

    fun first(!self) -> !H
      !self.items[0]

    sub set(!self, u: ?String)
      (!self).first() = H(s: u)

  t = String("t")
  b = Bag(items: List())
  !b.items.push(H(s: ?t))
  u = String("u")
  !b.set(?u)
  <u
  print(b.items[0].s)

