test "review258-p141 loop binding ok", "u 10 20"
  obj H
    s: ?String
    n: Int

  fun wrap(h: !H) -> !H from h
    h

  t = String("t")
  u = String("u")
  v: List[H] = List()
  !v.push(H(s: ?t, n: 1))
  !v.push(H(s: ?t, n: 2))
  for x in !v
    wrap(!x) = H(s: ?u, n: x.n * 10)
  print(v[0].s, v[0].n, v[1].n)

bomb "review258-p142 wrap ops", "left shift overflowed bits", prints: "4\n250\n238"
  fun sl(v: !List[U8], i: Int) -> !U8 from v
    !v[i]

  fun nx(c: !Int) -> Int
    c += 1
    c

  v: List[U8] = List()
  !v.push(U8(250))
  sl(!v, 0) +%= 10
  print(v[0])
  sl(!v, 0) -%= 10
  print(v[0])
  sl(!v, 0) *%= 3
  print(v[0])
  c = 0
  sl(!v, 0) <<= nx(!c)
  print(v[0], c)
  sl(!v, 0) +|= 250
  print(v[0])

bomb "review258-p144 shift var held", "index out of bounds"
  fun sl(v: !List[I64], i: Int) -> !I64 from v
    !v[i]

  fun nx(c: !Int) -> Int
    c += 1
    c

  v: List[I64] = List()
  !v.push(1)
  !v.push(1)
  c = 0
  sl(!v, nx(!c)) <<= nx(!c)
  print(v, c)
  sl(!v, nx(!c) - 3) >>= 1
  print(v, c)

