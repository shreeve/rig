test "rt-a", '''
  98 2 none
  a
  b

  c
  6 true a
'''
  obj Split
    rest: ?String
    sep: ?String
    done: Bool

    pub fun next(!self) -> (?String)?
      if self.done
        return none
      i = find(self.rest, self.sep) ?? -1
      if i < 0
        self.done = true
        return self.rest
      part = self.rest[0..i]
      self.rest = self.rest[i + self.sep.len..]
      part

  fun find(s: ?String, pat: ?String) -> Int?
    if pat.len > s.len
      return none
    i = 0
    while i + pat.len <= s.len : i += 1
      if s[i..i + pat.len] == pat
        return i
    none

  fun split(s: ?String, sep: ?String) -> Split
    Split(rest: s, sep: sep, done: false)

  b: U8 = "abc"[1]
  print(b, find("hello", "ll"), find("x", "yy"))
  it = split("a,b,,c", ",")
  while (!it).next() as part
    print(part)
  x = "héllo"
  print(x.len, x < "i", 'a')

fail "rust164250-repoint-declared-first", "cannot drop `l` while it is lent"
  # rust-lang/rust#164250's Rig analog: a struct whose drop body reads a
  # read-view field re-pointed at a shorter-lived local must be rejected.

  obj Q
    f: ?String

    drop(!self)
      print(self.f)

  l = String("inner")
  s = String("outer")
  q = Q(f: ?s)
  q.f = ?l
  <l

fail "rust164250-repoint-drop-local", "cannot drop `l` while it is lent"
  # rust-lang/rust#164250's Rig analog: a struct whose drop body reads a
  # read-view field re-pointed at a shorter-lived local must be rejected.

  obj Q
    f: ?String

    drop(!self)
      print(self.f)

  s = String("outer")
  q = Q(f: ?s)
  l = String("inner")
  q.f = ?l
  <l
  print("end")

fail "rust164250-repoint-scope-end", "`l` does not live long enough"
  # rust-lang/rust#164250's Rig analog: a struct whose drop body reads a
  # read-view field re-pointed at a shorter-lived local must be rejected.

  obj Q
    f: ?String

    drop(!self)
      print(self.f)

  s = String("outer")
  q = Q(f: ?s)
  if true
    l = String("inner")
    q.f = ?l
  print("end")

