# Probes from past reviews and audits, 37 of 41: review-while-step-w38-value-loop-step to sb-adv2.

test "review-while-step-w38-value-loop-step", "7 209 4"
  # A loop used as a value whose step reads the condition's binding.
  #
  # oracle: mk accept
  # oracle: main accept
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(3)
  k = 0
  i = 0
  x = while mk(?v, i) as h: k += h.s[0]
    i += 1
    break 7 if i == 4
    continue if i == 2
    k += 100
  else
    9
  print(x, k, i)

  # expect: 7 209 4

test "review-while-step-w41-joined-drop-binding-step-grows-ok", '''
  drop 2
  drop 2
  drop 2
  3 4
'''
  # Valid: the step reads no binding, so it runs after `x` dropped.
  #
  # oracle: D.drop accept
  # oracle: mkd accept
  obj D
    s: []Int
    drop(!self)
      print("drop", self.s[0])

  fun mkd(w: ?List[Int], i: Int) -> D?
    if i < 3
      return D(s: ?w[..])
    none

  w: List[Int] = List()
  !w.push(2)
  i = 0
  while i >= 0 and mkd(?w, i) as x: !w.push(9)
    i += 1
  print(i, w.len)

fail "review-while-step-w42-step-temp-view", "a view of the temporary `mkv(i)` outlives its statement, which drops it; bind the value to a name first"
  # The step stores a view of a temporary in an outer slice, which the
  # body reads on the next iteration.
  #
  # oracle: mkv accept
  # oracle: all accept
  # oracle: main reject C5
  fun mkv(i: Int) -> List[Int]
    v: List[Int] = List()
    !v.push(i)
    v

  fun all(v: ?List[Int]) -> []Int
    ?v[..]

  e = [0]
  s: []Int = ?e[..]
  k = 0
  i = 0
  while i < 3: s = all(?mkv(i))
    k += s[0]
    i += 1
  print(k)

test "review-while-step-w46-body-shadows-h", "303"
  # The body shadows `h` with `new h`, viewing a body-local List; the step's
  # `h` must be the condition's binding.
  #
  # oracle: mk accept
  # oracle: main accept
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  while mk(?v, i) as h: k += h.s[0]
    local: List[Int] = List()
    !local.push(100)
    new h = S(s: ?local[..])
    k += h.s[0]
    i += 1
  print(k)

  # expect: 303

fail "review-while-step-w48-grow-then-return-ok", "cannot lend `v` to write while a read loan is live"
  # Valid: the body grows `v` only on a path that returns, which never
  # reaches the step.
  #
  # oracle: mk accept
  # oracle: run accept
  # oracle: main accept
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun run() -> Int
    v: List[Int] = List()
    !v.push(1)
    k = 0
    i = 0
    while mk(?v, i) as h: k += h.s[0]
      i += 1
      if i == 3
        !v.push(2)
        return k + v.len
    k

  print(run())

  # expect: 4

fail "review-while-step-w51-step-stores-h-via-call", "cannot lend `v` to write while a read loan is live"
  # The step passes `h` to a function that stores it in `last`; after the
  # loop, `v` grows and `last` is read.
  #
  # oracle: mk accept
  # oracle: keep accept
  # oracle: main reject C4
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  sub keep(o: !S, h: S)
    o.s = h.s

  v: List[Int] = List()
  !v.push(1)
  e = [0]
  last = S(s: ?e[..])
  i = 0
  while mk(?v, i) as h: keep(!last, h)
    i += 1
  !v.push(2)
  print(last.s[0])

fail "review-while-step-w54-step-grows-via-h-cond-reads", "cannot lend `w` to write while a read loan is live"
  # The step writes `w` through a call, while `h` views `w` and the step
  # reads `h` after the call in the same statement.
  #
  # oracle: mk accept
  # oracle: grow accept
  # oracle: main reject C4
  obj S
    s: []Int

  fun mk(w: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?w[..])
    none

  fun grow(w: !List[Int]) -> Int
    for j in 0..40
      !w.push(j)
    0

  w: List[Int] = List()
  !w.push(1)
  k = 0
  i = 0
  while mk(?w, i) as h: k += grow(!w) + h.s[0]
    i += 1
  print(k)

fail "review-while-step-w55-optional-view-binding", "cannot lend `v` to write while a read loan is live"
  # The condition binds an optional slice; the step reads through it with
  # `??`; the body grows the List.
  #
  # oracle: mk accept
  # oracle: first accept
  # oracle: main reject C4
  fun mk(v: ?List[Int], i: Int) -> (([]Int)?)?
    if i < 40
      return ?v[..]
    none

  fun first(s: ([]Int)?) -> Int?
    if s as t
      return t[0]
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  while mk(?v, i) as h: k += first(h) ?? 0
    i += 1
    !v.push(2)
  print(k)

test "review258-p04 order", '''
  [1, 99]
