fail "review-copies-2-q01b-return-local-view-fallible-direct", "cannot return a view of `p`, which this function was not lent"
  error Bad
    oops

  obj P
    x: Int

  fun leak(ok: Bool) -> (?P)!
    p = P(x: 7)
    return Bad.oops if not ok
    ?p

  v = leak(true)!
  print(v.x)

fail "review-copies-2-q01c-return-local-write-view-fallible", "cannot return a view of `p`, which this function was not lent"
