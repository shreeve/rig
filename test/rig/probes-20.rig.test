# Probes from past reviews and audits, 20 of 41: review-copies-2-g-E-optcatch-fieldopt to review-copies-2-q08b-nested-opt-fallible-return.

test "review-copies-2-g-E-optcatch-fieldopt", "true"
  error Bad
    oops

  enum T
    a
    b

  obj H
    t: T

  obj HO
    t: T?

  fun get(r: ?T, ok: Bool) -> (?T)!
    return Bad.oops if not ok
    r

  fun opt(r: ?T, k: Int) -> (?T)?!
    return Bad.oops if k == 0
    return none if k == 1
    r

  fun idv(t: T) -> T
    t

  fun unopt(t: T?, d: T) -> T
    if t as v
      return v
    d

  fun retv(o: (?T)?, a: ?T, b: ?T) -> T
    o ?? b

  a = T.a
  b = T.b
  h = HO(t: (opt(?a, 2) catch ?b) ?? ?b)
  print((unopt(h.t, b) == T.a))

test "review-copies-2-g-E-optcatch-typedopt", "true"
  error Bad
    oops

  enum T
    a
    b

  obj H
    t: T

  obj HO
    t: T?

  fun get(r: ?T, ok: Bool) -> (?T)!
    return Bad.oops if not ok
    r

  fun opt(r: ?T, k: Int) -> (?T)?!
    return Bad.oops if k == 0
    return none if k == 1
    r

  fun idv(t: T) -> T
    t

  fun unopt(t: T?, d: T) -> T
    if t as v
      return v
    d

  fun retv(o: (?T)?, a: ?T, b: ?T) -> T
    o ?? b

  a = T.a
  b = T.b
  c: T? = (opt(?a, 2) catch ?b) ?? ?b
  print((unopt(c, b) == T.a))

