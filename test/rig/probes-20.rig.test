test "review-copies-2-q03m-ret-opt-fallible-forms", '''
  2
  none
  1
'''
  error Bad
    oops

  obj P
    x: Int

  obj Q
    p: P
    n: Int

  fun opt(r: ?P, k: Int) -> (?P)?!
    return Bad.oops if k == 0
    return none if k == 1
    r

  a = P(x: 1)
  b = P(x: 2)
  for k in 0..3
    q = opt(?a, k) catch ?b
    if q as p
      print(p.x)
    else
      print("none")

test "review-copies-2-q03n-ret-opt-fallible-propagate", '''
  2 -1
  -1 -1
  1 1
'''
  error Bad
    oops

  obj P
    x: Int

  obj Q
    p: P
    n: Int

  fun opt(r: ?P, k: Int) -> (?P)?!
    return Bad.oops if k == 0
    return none if k == 1
    r

  fun via(r: ?P, k: Int) -> (?P)?!
    opt(r, k)!

  fun via2(r: ?P, k: Int) -> (?P)?!
    q = opt(r, k)!
    q

  a = P(x: 1)
  b = P(x: 2)
  for k in 0..3
    q = via(?a, k) catch ?b
    s = via2(?a, k) catch none
    x = -1
    y = -1
    if q as p
      x = p.x
    if s as p
      y = p.x
    print(x, y)

