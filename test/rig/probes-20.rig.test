fail "review-copies-2-q02-catch-result-keeps-loans", "cannot assign to `a.x` while `a` is lent"
  # The view a `catch` gives carries the loans of both sides.
  error Bad
    oops

  obj P
    x: Int

  fun get(r: ?P, ok: Bool) -> (?P)!
    return Bad.oops if not ok
    r

  a = P(x: 1)
  b = P(x: 2)
  v = get(?a, true) catch ?b
  a.x = 5
  print(v.x)

fail "review-copies-2-q02b-catch-result-keeps-handler-loan", "cannot assign to `b.x` while `b` is lent"
  error Bad
    oops

  obj P
    x: Int

  fun get(r: ?P, ok: Bool) -> (?P)!
    return Bad.oops if not ok
    r

  a = P(x: 1)
  b = P(x: 2)
  v = get(?a, false) catch ?b
  b.x = 5
  print(v.x)

fail "review-copies-2-q02d-write-catch-two-writers", "cannot assign to `b.x` while `b` is lent"
  error Bad
    oops

  obj P
    x: Int

  fun wget(w: !P, ok: Bool) -> (!P)!
    return Bad.oops if not ok
    w

  a = P(x: 1)
  b = P(x: 2)
  w = wget(!b, true) catch !a
  b.x = 7
  w.x = 9
  print(a.x, b.x)

fail "review-copies-2-q02e-write-catch-read-owner", "use of `a.x` while a write loan on `a` is live"
  error Bad
    oops

  obj P
    x: Int

  fun wget(w: !P, ok: Bool) -> (!P)!
    return Bad.oops if not ok
    w

  a = P(x: 1)
  b = P(x: 2)
  w = wget(!b, false) catch !a
  print(a.x)
  w.x = 9
  print(a.x, b.x)

