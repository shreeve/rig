test "review-copies-2-g-S-catch-branch", "1"
  error Bad
    oops

  obj T
    s: ?String
    x: Int

  obj H
    t: T

  obj HO
    t: T?

  fun get(r: ?T, ok: Bool) -> (?T)!
    return Bad.oops if not ok
    r

  fun opt(r: ?T, k: Int) -> (?T)?!
    return Bad.oops if k == 0
    return none if k == 1
    r

  fun idv(t: T) -> T
    t

  fun unopt(t: T?, d: T) -> T
    if t as v
      return v
    d

  fun retv(o: (?T)?, a: ?T, b: ?T) -> T
    o ?? b

  a = T(s: "a", x: 1)
  b = T(s: "b", x: 2)
  k = true
  c: T = (get(?a, true) catch ?b) if k else T(s: "b", x: 2)
  print(c.x)

