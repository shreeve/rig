test "review-copies-2-q08a-nested-opt-coalesce", "1 2 1"
  error Bad
    oops

  obj P
    x: Int

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  fun vx(o: (?P)?) -> Int
    if o as p
      return p.x
    -1

  a = P(x: 1)
  b = P(x: 2)
  i: (?P)? = ?a
  o: ((?P)?)? = i
  n: ((?P)?)? = none
  c: P = (o ?? none) ?? ?b
  d: P = (n ?? none) ?? ?b
  f: P? = i ?? ?b
  print(c.x, d.x, px(f))

test "review-copies-2-q08b-nested-opt-fallible-return", '''
  0 none
  1 none
  2 inner none
  3 1
'''
  error Bad
    oops

  obj P
    x: Int

  fun g(r: ?P, k: Int) -> ((?P)?)?!
    return Bad.oops if k == 0
    return none if k == 1
    i: (?P)? = none
    return i if k == 2
    r

  a = P(x: 1)
  for k in 0..4
    o = g(?a, k) catch none
    if o as i
      if i as p
        print(k, p.x)
      else
        print(k, "inner none")
    else
      print(k, "none")
