  fun wopt(w: !P, k: Int) -> (!P)?!
    return Bad.oops if k == 0
    return none if k == 1
    w

  a = P(x: 1)
  for k in 0..3
    q = wopt(!a, k) catch none
    if !q as p
      p.x += 10
  print(a.x)

