# Probes from past reviews and audits, 41 of 41: t-mv4 to viewvalue-f2.

use std.hash
use std.random

fail "t-mv4", "cannot move out of `v[0]`: it copies, so `<` would leave it as it was; remove the `<` to copy it"
  obj P
    n: Int

  sub eat(p: P)
    print(p.n)

  v: List[P] = List()
  !v.push(P(n: 7))
  eat(<v[0])

  # oracle: main reject C3

test "t-p2", "2 1 2"
  obj P
    x: Int
    y: Int

  obj S
    a: List[Int]
    b: Int

  obj Q
    a: P
    b: Int

  fun grow(v: !List[Int]) -> Int
    !v.push(7)
    2

  fun bump(p: !P) -> Int
    p.x += 1
    0

  fun rd(v: ?List[Int], n: Int) -> Int
    v.len + n

  fun rp(p: P, n: Int) -> Int
    p.x + n

  fun rs(s: []Int, n: Int) -> Int
    s.len + n

  v: List[Int] = List()
  !v.push(0)
  print(rd(?v, v.len), v.len, grow(!v))

