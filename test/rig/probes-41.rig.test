test "take-p3", '''
  Node(v: 1, next: none) Node(v: 2, next: none)
  4 W(x: none)
'''
  obj Node
    v: Int
    next: ^Node?

    drop(!@)
      cur = <@next
      while <cur as n
        cur = <n.next

  obj W[T]
    x: T?

    fun grab(!@) -> T?
      <@x

  head: ^Node? = none
  i = 0
  while i < 100000 : i += 1
    head = ^Node(v: i, next: <head)
  b = ^Node(v: 1, next: ^Node(v: 2, next: none))
  rest = <b.next
  print(b, rest)
  w = W[Int](x: 4)
  print((!w).grab(), w)

