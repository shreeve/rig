fail "viewvalue-a6", "a view of the temporary `mk()` outlives its statement, which drops it; bind the value to a name first"
  obj Bag
    items: List[Int]
    name: String

    fun label(!@) -> !String
      !@name

  fun mk() -> Bag
    Bag(items: List(), name: String("a"))

  w = (!mk()).label()
  w = String("zzz")
  print("ok")

test "viewvalue-b1", '''
  handler Bad.oops
  handler Bad.worse
  h2 Bad.oops
  1 50 -1 1 -1
  7 99 8 3 [Bad.oops]
'''
  error Bad
    oops
    worse

  obj P
    x: Int

  fun pick(r: ?P, n: Int) -> (?P)! from r
    return Bad.oops if n == 1
    return Bad.worse if n == 2
    r

  fun wpick(r: !P, n: Int) -> (!P)! from r
    return Bad.oops if n == 1
    r

  fun go(a: ?P, n: Int) -> Int
    q = pick(a, n) catch |e|
      print("handler", e)
      return -1 if e == Bad.worse
      P(x: 50)
    q.x

  fun go2(a: ?P, n: Int) -> Int
    q = pick(a, n) catch |e|
      print("h2", e)
      return -1
    q.x

  a = P(x: 1)
  seen: List[error] = List()
  print(go(?a, 0), go(?a, 1), go(?a, 2), go2(?a, 0), go2(?a, 1))
  b = pick(?a, 1) catch |e|
    !seen.push(<e)
    P(x: 7)
  c = wpick(!a, 0) catch P(x: 8)
  c.x = 99
  d = wpick(!a, 1) catch P(x: 8)
  a.x = 3
  print(b.x, c.x, d.x, a.x, seen)

fail "viewvalue-c2", "cannot lend `v` to write while a read loan is live"
  obj N
    name: String
    s: ?String

  fun nslot(v: !List[N], i: Int) -> !N from v
    !v[i]

  v: List[N] = List()
  !v.push(N(name: String("a"), s: "x"))
  !v.push(N(name: String("b"), s: "y"))
  nslot(!v, 0).s = ?v[1].name
  !v.push(N(name: String("c"), s: "z"))
  print(v[0].s)

fail "viewvalue-c3", "cannot assign to `v[0].s` while `v` is lent"
  obj N
    name: String
    s: ?String

  v: List[N] = List()
  !v.push(N(name: String("a"), s: "x"))
  !v.push(N(name: String("b"), s: "y"))
  v[0].s = ?v[1].name
  !v.push(N(name: String("c"), s: "z"))
  print(v[0].s)

test "viewvalue-c6", '''
  P(x: 1, y: 2) P(x: 1, y: 2) P(x: 3, y: 4) P(x: 9, y: 9)
  1
  1
  1
'''
  error Bad
    oops

  obj P
    x: Int
    y: Int

  fun mk() -> hash.Map[String, P]
    q = hash.Map[String, P]()
    !q.put(String("a"), P(x: 1, y: 2))
    q

  fun head(v: ?List[P]) -> (?P)! from v
    return Bad.oops if v.len == 0
    ?v[0]

  fun mkl() -> List[P]
    l: List[P] = List()
    !l.push(P(x: 3, y: 4))
    l

  x = mk().get("a") ?? P(x: 0, y: 0)
  y = (!mk()).edit("a") ?? P(x: 0, y: 0)
  z = head(?mkl()) catch P(x: 9, y: 9)
  w = head(?List[P]()) catch P(x: 9, y: 9)
  print(x, y, z, w)
  for _ in 0..3
    t = mk().get("a") ?? P(x: 0, y: 0)
    print(t.x)

test "viewvalue-d7", '''
  4928
  .rect(w: 2, h: 3) .circle(r: 9)
'''
  enum Shape
    circle(r: Int)
    rect(w: Int, h: Int)
    point

  fun noise(n: Int) -> Int
    a: [64]Int = [64 of n]
    s = 0
    for k in 0..64
      s += a[k]
    s

  m = hash.Map[String, Shape]()
  !m.put(String("a"), .rect(w: 2, h: 3))
  a = ?m.get("a") ?? .point
  b = ?m.get("b") ?? .circle(r: 9)
  print(noise(77))
  print(a, b)

fail "viewvalue-e5", "cannot drop `s` while it is lent"
  error Bad
    oops

  obj H
    s: ?String

  fun pick(r: ?H, ok: Bool) -> (?H)! from r
    return Bad.oops if not ok
    r

  fun wpick(r: !H, ok: Bool) -> (!H)! from r
    return Bad.oops if not ok
    r

  s = String("abc")
  h = H(s: ?s)
  c = pick(?h, true) catch H(s: "x")
  d = wpick(!h, true) catch H(s: "y")
  h = H(s: "z")
  <s
  print(c.s, d.s)

test "viewvalue-e7", '''
  f
  2 new value long enough!!
'''
  error Bad
    oops

  obj O
    n: Int
    s: String

  fun of(o: !O, ok: Bool) -> (!O)! from o
    return Bad.oops if not ok
    o

  sub put(o: !O, ok: Bool)!
    of(!o, ok)!.s = String("new value long enough!!")
    of(!o, ok)!.n += 1

  o = O(n: 1, s: String("a"))
  put(!o, true) catch print("f")
  put(!o, false) catch print("f")
  print(o.n, o.s)

test "viewvalue-f2", ".point"
  error Bad
    oops

  enum Shape
    circle(r: Int)
    point

  fun pick(r: ?Shape, ok: Bool) -> (?Shape)! from r
    return Bad.oops if not ok
    r

  s: Shape = .circle(r: 1)
  a: Shape = pick(?s, false) catch .point
  print(a)
