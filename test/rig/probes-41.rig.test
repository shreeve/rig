test "t1-lo", '''
  [2, 1, 3]
  [1, 2, 3]
  3
'''
  obj R
    s: U64

    sub touch(!@, xs: ![]Int)
      @s += 1
      !xs.swap(0, 1)

    sub gtouch[T](!@, xs: ![]T)
      @s += 1
      !xs.swap(0, 1)

  r = R(s: 1)
  a = [1, 2, 3]
  !r.touch(!a)
  print(a)
  !r.gtouch(!a)
  print(a)
  print(r.s)

test "t1-lo2", '''
  [2, 1, 3]
  [1, 2, 3]
  [2, 1, 3]
  1
'''
  obj R
    s: U64

  sub t1(xs: ![]Int)
    !xs.swap(0, 1)

  sub t2(r: !R, xs: ![]Int)
    !xs.swap(0, 1)

  r = R(s: 1)
  a = [1, 2, 3]
  t1(!a)
  print(a)
  t2(!r, !a)
  print(a)
  t2(!r, !a[..])
  print(a)
  print(r.s)

