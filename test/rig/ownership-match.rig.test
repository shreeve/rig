  9
  5
  drop
  end
'''
  # A payload field of `match <s` may be moved out; the variant's other
  # fields are plain data.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  sub eat(rc: *Wrap)
    print(rc.payload)

  enum Slot
    tagged(box: *Wrap, tag: Int)
    empty

  rc = *Wrap(payload: 5)
  s: Slot = .tagged(box: <rc, tag: 9)
  match <s
    .tagged(box, tag)
      print(tag)
      eat(<box)
    .empty => print(0)
  print("end")

