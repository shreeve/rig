# ownership: tests whose names start `match`.

use std.text

test "match arm drop statement", '''
  one
  end 1
  drop 1
  drop 2
  end 2
  -5
'''
  # `=> <name` in a match used as a statement drops `name` in that arm;
  # `-a` is negation, also as the value of an arm whose match is used.

  obj N
    id: Int

    drop(!@)
      print("drop", @id)

  sub run(k: Int)
    a = N(id: k)
    match k
      1 => print("one")
      _ => <a
    print("end", k)

  fun pick(k: Int) -> Int
    a = 5
    return match k
      1 => 1
      _ => -a

  run(1)
  run(2)
  print(pick(2))

test "match arm statement liveness", '''
  simple 11
  block 5 21 5
  21
'''
  # A `match` arm's body is a statement of its own, as a block's line is:
  # a write view last used in the subject is no longer live there, so the
  # arm may lend what it viewed, as a block arm may.
  enum Shape
    circle(r: Int)
    point

  fun grow(v: !List[Shape]) -> Int
    for _ in 0..10
      !v.push(.point)
    v.len

  v: List[Shape] = List()
  !v.push(.circle(r: 5))
  x = !v
  match ?x[0]
    .circle(_) => print("simple", grow(!v))
    .point => pass
  y = !v
  match ?y[0]
    .circle(r)
      print("block", r, grow(!v), r)
    .point => pass
  print(v.len)

fail "match bare payload move", "23:17: cannot move `v` out of `o`: `match o` reads `o`; write `match <o` to take its fields", "28:27: cannot move `box` out of `s`: `match s` reads `s`; write `match <s` to take its fields", "32:23: cannot drop `box` out of `t`: `match t` reads `t`; write `match <t` to take its fields"
  # A bare `match e` on a value that owns a resource reads it: moving a
  # payload out takes `match <e`, which consumes `e`.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  enum Slot
    tagged(box: *B, tag: Int)
    empty

  enum Opt
    some(v: *B)
    nothing

  sub eat(b: *B)
    print(b.n)

  fun get(o: Opt, d: *B) -> *B
    match o
      .some(v) => v
      .nothing => <d

  s: Slot = .tagged(box: *B(n: 1), tag: 2)
  match s
    .tagged(box, _) => eat(<box)
    .empty => print(0)
  t: Slot = .tagged(box: *B(n: 3), tag: 4)
  match t
    .tagged(box, _) => <box
    .empty => print(0)
  g = get(.some(v: *B(n: 5)), *B(n: 6))
  print(g.n)

fail "match branch copies write view", "21:10: cannot lend `getw(!x) if c else y`: it may be `y`, a value a name holds, which lending the branching value would copy; lend each branch: `getw(!x) if c else ?y`", "26:10: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?a if c else ?b`", "36:10: cannot lend `a if c else !d`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?a if c else !d`", "42:9: cannot lend `o?`: it may be `o`, a value a name holds, which lending the branching value would copy; lend what it unwraps, and unwrap it in a header: `if ?o as x`", "49:9: cannot lend `o ?? !d`: it may be `o`, a value a name holds, which lending the branching value would copy; lend each branch: `?o ?? !d`", errors: 5
  # A branch a `match` reads in place is lent there (every in-place read
  # of a branch is a lend), and a leaf that is a name holding a write view
  # would be copied by lending the branching value, a second writer that
  # holds no loan on it: bare write views, a call beside a name, `??` and
  # `?` of an optional write view. None is lent on (`sema.makesWriteView`
  # lends on only write lends and calls), so no binding writes through a
  # copy. The hint lends each leaf.

  obj Res
    n: Int
    v: List[Int]

  enum E
    a(r: Res)
    b

  fun getw(e: !E) -> !E
    e

  sub call_and_name(x: !E, y: !E, c: Bool)
    match (getw(!x) if c else y)
      .a(r) => !r.v.push(1)
      .b => pass

  sub bare_write_views(a: !E, b: !E, c: Bool)
    match (a if c else b)
      .a(r)
        s = ?r.v[..]
        match !a
          .a(r2) => !r2.v.push(1)
          .b => pass
        print(s)
      .b => pass

  sub bare_and_lend(a: !E, d: !E, c: Bool)
    match (a if c else !d)
      .a(r) => print(r.n)
      .b => pass

  fun unwrapped(e: !E) -> Int?
    o: (!E)? = <e
    match o?
      .a(r) => print(r.n)
      .b => pass
    1

  sub coalesce(e: !E, d: !E)
    o: (!E)? = <e
    match o ?? !d
      .a(r) => print(r.n)
      .b => pass

  pass

fail "match captured payload move", "cannot move captured resource `e`", "cannot drop captured resource `e2`"
  # A closure owns what it captured and may be called again: a payload of
  # a captured value cannot be moved or dropped out of it.

  enum E
    full(c: *Cell[Int])
    empty

  sub eat(c: *Cell[Int])
    print(c.get())

  e: E = .full(c: *Cell(1))
  f = |<e|
    match e
      .full(c) => eat(<c)
      .empty => print(0)
  f()
  e2: E = .full(c: *Cell(2))
  g = *|<e2|
    match e2
      .full(c)
        <c
      .empty => print(0)
    print("matched")
  g()

test "match consume", '''
  kept 1
  drop 1
  arm end 2
  drop 2
  after
  kept 4
  drop 4
  drop 3
  other
  drop 5
  drop 7
  6
  three
  empty
  end
  drop 6
'''
  # `match <e` consumes `e`: each payload binding owns its field and may
  # move it on, and what an arm does not move (a binding it leaves, a `_`
  # field, a value no binding names) is dropped at the end of the arm.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  enum Pair
    two(a: *B, b: *B)
    one(a: *B)
    empty

  enum Opt
    some(v: *B)
    nothing

  sub keep(b: *B)
    print("kept", b.n)

  fun get(o: Opt, d: *B) -> *B
    match <o
      .some(v) => v
      .nothing => <d

  p: Pair = .two(a: *B(n: 1), b: *B(n: 2))
  match <p
    .two(a, b)
      keep(<a)
      print("arm end", b.n)
    .one(a) => keep(<a)
    .empty => print("empty")
  print("after")
  q: Pair = .two(a: *B(n: 3), b: *B(n: 4))
  match <q
    .two(_, b) => keep(<b)
    _ => print("other")
  r: Pair = .one(a: *B(n: 5))
  match <r
    .two(a, b) => print("two", a.n, b.n)
    _ => print("other")
  o: Opt = .some(v: *B(n: 6))
  x = get(<o, *B(n: 7))
  print(x.n)
  n = 3
  match <n
    3 => print("three")
    _ => print("not three")
  r = .empty
  match <r
    .empty => print("empty")
    _ => print("full")
  print("end")

test "match consume binding writes", '''
  12
  drop 12
  end
'''
  # A binding of `match <s` owns what it binds: a resource it holds can
  # be written and lent for writing, like an owned `as` binding.

  obj B
    n: Int

    sub bump(!@)
      @n += 1

    drop(!@)
      print("drop", @n)

  enum Slot
    full(b: B)
    empty

  s: Slot = .full(b: B(n: 1))
  match <s
    .full(b)
      !b.bump()
      b.n += 10
      print(b.n)
    .empty => print("e")
  print("end")

fail "match consume view", "9:9: `match <s` consumes an owned value, and `s` is a view (`?Shape`); match what it views with `match s`", "16:7: a `match` reaches the value inside a box by lending the box: `match ?b` or `match !b`; to take the value out, bind it first: `v = <b.unbox()`"
  # `match <e` consumes an owned value: a view owns no fields to hand
  # over, and a box is matched through a view of it.

  enum Shape
    circle(r: Int)
    square(s: Int)

  sub show(s: ?Shape)
    match <s
      .circle(r) => print(r)
      .square(q) => print(q)

  c: Shape = .circle(r: 1)
  show(?c)
  b = ^Shape.square(s: 2)
  match <b
    .circle(r) => print(r)
    .square(q) => print(q)

test "match copy payload tail", '''
  drop 1
  3
'''
  # Yielding a Copy payload field from a match arm does not consume the
  # scrutinee; it is still dropped.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  enum S
    one(a: *B, k: Int)
    empty

  fun go(s: S) -> Int
    match s
      .one(_, k) => k
      .empty => 0

  s: S = .one(a: *B(n: 1), k: 3)
  print(go(<s))

fail "match field overwrite while payload live", "cannot assign to `h.s` while `h.s` is lent", "cannot reassign `h` while it is lent"
  # The matched value stays lent while a payload binding is in use:
  # overwriting it would drop the value the payload views.

  obj Tok
    v: List[Int]

  enum Slot
    empty
    full(t: *Tok)

  obj Holder
    s: Slot

  sub clear(h: !Slot)
    match h
      .full(t)
        h = .empty
        print(t.v[0])
      .empty => print("empty")

  t0 = Tok(v: List())
  !t0.v.push(1)
  h = Holder(s: .full(*<t0))
  match h.s
    .full(t)
      h.s = .empty
      print(t.v[0])
    .empty => print("empty")

fail "match field payload move", "cannot move `t` out of `h.s`", "cannot drop `t` out of `o.h.s`"
  # A payload of a matched field views the field: moving or dropping it
  # out would leave the parent owning it too.

  obj Tok
    n: Int

  enum Slot
    empty
    full(t: *Tok)

  obj Holder
    s: Slot

  obj Outer
    h: Holder

  sub eat(t: *Tok)
    print(t.n)

  h = Holder(s: .full(*Tok(n: 1)))
  match h.s
    .full(t) => eat(<t)
    .empty => print("empty")
  o = Outer(h: Holder(s: .full(*Tok(n: 2))))
  match o.h.s
    .full(t)
      <t
    .empty => print("empty")

fail "match field payload through view", "cannot move out of `t`: it is a view of `h`", "cannot drop out of `t`: `sh` is a shared handle"
  # A payload of a field reached through a view or a shared handle is
  # owned by someone else: it cannot be moved or dropped.

  obj Tok
    n: Int

  enum Slot
    empty
    full(t: *Tok)

  obj Holder
    s: Slot

  sub eat(t: *Tok)
    print(t.n)

  sub peek(h: ?Holder)
    match h.s
      .full(t) => eat(<t)
      .empty => print("empty")

  h = Holder(s: .full(*Tok(n: 1)))
  peek(?h)
  sh = *Holder(s: .full(*Tok(n: 2)))
  match sh.s
    .full(t)
      <t
    .empty => print("empty")

fail "match generic branch of places", "16:9: a `match` reads a place or takes a call's result; bind this `Opt[T]` to a name first", "26:9: a `match` reads a place or takes a call's result", "35:9: a `match` reads a place or takes a call's result", errors: 3
  # A `match` on a value that branches over bare places is a copy of the
  # place it takes, so a binding that views it would view the copy, or
  # carry no loan on the place: the match is rejected, as for a value that
  # moves, when the value may move, in a generic body (`sema.moves` is
  # `depends`), guarded or not (the review-b4b-2 probes p63 to p70). A
  # branch over lends (`?o1 if c else ?o2`) is matched where it points.

  enum Opt[T]
    some(v: T)
    nothing

  sub guarded[T](a: T, b: T, k: T, c: Bool)
    o1 = Opt.some(v: <a)
    o2 = Opt.some(v: <b)
    saved = ?k
    match o1 if c else o2
      .some(x) if c => print(x)
      .some(x) => saved = ?x
      .nothing => pass
    print(saved)

  sub plain[T](a: T, b: T, k: T, c: Bool)
    o1 = Opt.some(v: <a)
    o2 = Opt.some(v: <b)
    saved = ?k
    match o1 if c else o2
      .some(x) => saved = ?x
      .nothing => pass
    o2 = Opt[T].nothing
    print(saved)

  sub whole[T](a: T, b: T, c: Bool)
    o1 = Opt.some(v: <a)
    o2 = Opt.some(v: <b)
    match o2 if c else o1
      x => print(?x)

  guarded(1, 2, 3, true)

fail "match guard stores", "24:27: `x` does not live long enough", "35:3: cannot reassign `y` while it is lent"
  # A guard that fails runs on the way to the later arms: a view it
  # stored in an outer value is still there after the match, even when
  # the guarded arm's body never falls through.

  obj Big
    v: List[Int]

  obj View
    b: ?Big

  enum O
    some(x: Big)
    nothing

  fun put(v: !View, t: ?Big) -> Bool keeps t
    v.b = t
    false

  sub payload()
    x0 = Big(v: List())
    vw = View(b: ?x0)
    o: O = .some(x: Big(v: List()))
    match <o
      .some(x) if put(!vw, ?x) => return
      _ => print("other")
    print(vw.b.v.len)

  sub outer(n: Int)
    x0 = Big(v: List())
    vw = View(b: ?x0)
    y = Big(v: List())
    match n
      3 if put(!vw, ?y) => return
      _ => print("other")
    y = Big(v: List())
    print(vw.b.v.len, y.v.len)

  payload()
  outer(3)

fail "match guard stores payload loan", "21:23: `v` does not live long enough", errors: 1
  # A guard that fails leaves its arm's scope: a loan on the arm's own
  # payload binding, stored in an outer value, cannot survive it, even
  # when the arm leaves a labeled `match`.
  obj H
    r: ?List[Int]

  enum S
    a(v: List[Int])
    b

  fun store(h: !H, r: ?List[Int]) -> Bool keeps r
    h.r = r
    false

  z: List[Int] = List()
  h = H(r: ?z)
  w: List[Int] = List()
  !w.push(1)
  s = S.a(v: <w)
  $m: match <s
    .a(v) if store(!h, ?v) => break $m
    _ => pass
  print(h.r.len)

test "match guards after subject", '''
  false 2 1 101 100
  2 false 201 200
  other 301
'''
  # A match's subject stays lent through its guards and arms, and no
  # longer: a guard may read the subject's owner, lend anything else, or
  # change an unrelated value; after the match, its owner may change.

  enum Shape
    circle(r: Int)
    point

  fun grow(v: !List[Shape]) -> Bool
    for _ in 0..100
      !v.push(.point)
    false

  fun count(v: ?List[Shape]) -> Int
    v.len

  fun bump(n: !Int) -> Bool
    n += 1
    n > 1

  v: List[Shape] = List()
  !v.push(.circle(r: 5))
  other: List[Shape] = List()
  hits = 0
  n = match ?v[0]
    .point => 0
    .circle(r) if r > count(?v) and bump(!hits) => r
    .circle(_) if grow(!other) => 1
    .circle(_) => 2
  print(grow(!v), n, hits, v.len, other.len)
  w = !v
  m = match ?w[0]
    .point => 0
    .circle(_) if grow(!other) => 1
    .circle(_) => 2
  print(m, grow(!v), v.len, other.len)
  k = v[0]
  match k
    .circle(r) if grow(!v) => print("grew", r)
    _ => print("other", v.len)

test "match made part cell holder", '''
  1
  4
  6
  8
  2
'''
  # A `match` on a part of a value its header makes holds that value for
  # the match (Core §3, docs/INTERNALS.md "Header subjects"): `H(...).e`,
  # `mkh(n).e`, `[...][0]`, and `mk(n)[0]` are held, so each payload is
  # read where it is, a `*Counter` handle through which a `!@` method
  # or a marked `Cell.set` changes a Cell (Core s9).
  #
  # oracle: main accept

  obj Counter
    hits: Cell[Int]

    sub hit(!@)
      !@hits.set(@hits.get() + 1)

  enum E
    a(c: *Counter)
    b

  obj H
    e: E

  fun mkh(n: Int) -> H
    H(e: E.a(c: *Counter(hits: Cell(n))))

  fun mk(n: Int) -> [1]E
    [E.a(c: *Counter(hits: Cell(n)))]

  match H(e: E.a(c: *Counter(hits: Cell(0)))).e
    .a(c)
      !(+c).hit()
      print(c.hits.get())
    .b => pass
  match mkh(3).e
    .a(c)
      !(+c).hit()
      print(c.hits.get())
    .b => pass
  match [E.a(c: *Counter(hits: Cell(5))), E.b][0]
    .a(c)
      !(+c).hit()
      print(c.hits.get())
    .b => pass
  match mk(7)[0]
    .a(c)
      !(+c).hit()
      print(c.hits.get())
    .b => pass
  match H(e: E.a(c: *Counter(hits: Cell(0)))).e
    .a(c)
      !c.hits.set(2)
      print(c.hits.get())
    .b => pass

test "match made write view lent on", release: true, '''
  .a(r: Res(n: 60, t: "x"))
  .a(r: Res(n: 60, t: "x")) .a(r: Res(n: 3, t: "y!"))
  .a(r: Res(n: 10, t: "x")) .a(r: Res(n: 20, t: "y!")) .a(r: Res(n: 30, t: "z"))
  .a(r: Res(n: 20, t: "y!")) .a(r: Res(n: 40, t: "z"))
'''
  # A write view a `match` subject makes is lent on, as `if … as` lends one
  # on: a call's result, or a branch whose every leaf is a write lend, a
  # call's result, or a write view taken with `<w` (`sema.makesWriteView`),
  # through `if`, `??`, and `catch`, nested too. The bindings write
  # through it, as under `match !e`, and the lend keeps what it views lent
  # while they live.

  obj Res
    n: Int
    t: String

  enum E
    a(r: Res)
    b

  error Bad
    nope

  fun getw(e: !E) -> !E
    e

  fun tryw(e: !E, ok: Bool) -> (!E)!
    return Bad.nope if not ok
    e

  fun optw(e: !E, ok: Bool) -> (!E)?
    return none if not ok
    e

  e = E.a(r: Res(n: 1, t: String("x")))
  match getw(!e)
    .a(r) => r.n = 60
    .b => pass
  print(e)
  f = E.a(r: Res(n: 2, t: String("y")))
  c = e == f
  match (!e if c else !f)
    .a(r)
      r.n += 1
      !r.t.add("!")
    .b => pass
  print(e, f)
  g = E.a(r: Res(n: 3, t: String("z")))
  match (!e if c else (!f if c else !g))
    .a(r) => r.n = 30
    .b => pass
  match tryw(!e, false) catch !f
    .a(r) => r.n = 20
    .b => pass
  match optw(!e, true) ?? !f
    .a(r) => r.n = 10
    .b => pass
  print(e, f, g)
  wa = !f
  wb = !g
  match (<wa if c else <wb)
    .a(r) => r.n = 40
    .b => pass
  print(f, g)

test "match move in two arms", '''
  1
  2
'''
  # A resource may be moved in each of two match arms: the arms are
  # alternatives, and whichever runs consumes it.

  obj Wrap
    payload: Int

  sub eat(rc: *Wrap)
    print(rc.payload)

  sub go(n: Int)
    rc = *Wrap(payload: n)
    match n
      1 => eat(<rc)
      _ => eat(<rc)

  go(1)
  go(2)

fail "match pattern binding move twice", "19:7: use of `s` after move"
  # `match <s` consumes the matched value, so a second match on `s` is a
  # use after move.

  obj Wrap
    payload: Int

  enum Slot
    full(b: *Wrap)
    empty

  sub eat(rc: *Wrap)
    print(rc.payload)

  rc = *Wrap(payload: 5)
  s: Slot = .full(b: <rc)
  match <s
    .full(b) => eat(<b)
    .empty => print(0)
  match s
    .full(b) => print(b.payload)
    .empty => print(0)

test "match payload by name", release: true, '''
  kept 1
  drop 1
  arm end
  after 1
  two 0
  arm end
  drop 2
  after 2
  three
  drop 3
  after 3
  xs 0
  drop 4
  after 4
  five
  viewed
  abc
  drop 5
  changed
  taken big none
  end
  drop 6
'''
  # A consuming match that binds some fields by name owns them; every
  # field it leaves out is dropped once, at the end of the arm, as a `_`
  # field is. A read match's view of a field bound by name outlives the
  # arm as a positional one does, and a write match writes it in place.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  enum Bag
    three(a: *B, label: String, xs: List[Int])
    one(b: *B)
    empty

  obj Res
    t: String

  enum E
    pair(r: Res, k: Int)
    nothing

  sub keep(b: *B)
    print("kept", b.n)

  fun label(e: ?Bag, d: ?String) -> ?String from e, d
    match e
      .three(label: t) => ?t
      _ => d

  fun res(e: ?E, d: ?Res) -> ?Res from e, d
    match e
      .pair(r: r) if r.t.len > 3 => ?r
      .pair(r: r) => r
      .nothing => d

  fun take(e: E) -> Res
    match <e
      .pair(k: k) if k > 10 => Res(t: String("big"))
      .pair(r: r) => <r
      .nothing => Res(t: String("none"))

  x: Bag = .three(a: *B(n: 1), label: String("one"), xs: List())
  match <x
    .three(a: a)
      keep(<a)
      print("arm end")
    _ => pass
  print("after 1")
  y: Bag = .three(a: *B(n: 2), label: String("two"), xs: List())
  match <y
    .three(xs: v, label: t)
      print(t, v.len)
      print("arm end")
    _ => pass
  print("after 2")
  z: Bag = .three(a: *B(n: 3), label: String("three"), xs: List())
  match <z
    .three(label: t) => print(t)
    _ => pass
  print("after 3")
  w: Bag = .three(a: *B(n: 4), label: String("four"), xs: List())
  match <w
    .three(label: t) if t.len > 9 => print("long")
    .three(xs: v) => print("xs", v.len)
    _ => pass
  print("after 4")
  # A read match's view of a field bound by name, past the arm.
  blank = String("")
  dr = Res(t: String(""))
  g: Bag = .three(a: *B(n: 5), label: String("five"), xs: List())
  print(label(?g, ?blank))
  e: E = .pair(r: Res(t: String("viewed")), k: 1)
  print(res(?e, ?dr).t)
  f: E = .pair(r: Res(t: String("abc")), k: 2)
  print(res(?f, ?dr).t)
  # A write match on owning fields, by name.
  match !g
    .three(label: t, a: a)
      t = String("changed")
      a = *B(n: 6)
    _ => pass
  print(label(?g, ?blank))
  print(take(.pair(r: Res(t: String("taken")), k: 1)).t, take(.pair(r: Res(t: String("x")), k: 20)).t, take(.nothing).t)
  print("end")

fail "match payload copy escapes", "24:6: a view of the temporary `mkh(7)` outlives its statement", "27:6: a view of the temporary `mk(7)` outlives its statement"
  # A match on a part of a made value holds that value for the match, and
  # each payload is a view of it there: the view does not outlive the
  # match.

  obj Counter unique
    hits: Int

  enum E
    a(c: Counter)
    b

  obj H
    e: E

  fun mkh(n: Int) -> H
    H(e: E.a(c: Counter(hits: n)))

  fun mk(n: Int) -> [1]E
    [E.a(c: Counter(hits: n))]

  one = [Counter(hits: 1)]
  saved = ?one[0]
  match mkh(7).e
    .a(c) => saved = c
    .b => pass
  match mk(7)[0]
    .a(c) => saved = c
    .b => pass
  print(saved.hits)

