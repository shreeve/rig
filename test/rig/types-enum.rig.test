test "enum values constants", "5 6 255 1024 110"
  # A variant's value is a constant integer expression: it may name module
  # constants, declared before or after the enum, and a number type's
  # limits, directly or through an alias.

  type Byte = U8

  K = 5

  enum E
    a = K
    b
    c = Byte.max
    d = 1 << 10
    e = K * 2 + LATER

  LATER = 100

  sub main()
    print(Int(E.a), Int(E.b), Int(E.c), Int(E.d), Int(E.e))

test "enum values in range", '''
  .created true false
  .big
'''
  # Explicit enum values are constant integers from 0 to 2^32 - 1; a
  # variant without one takes the value after the previous variant's.

  enum Status
    ok = 200
    created
    moved = 0x12D
    missing = 400 + 4
    big = 4294967295

  s: Status = .created
  print(s, s == .created, s == .ok)
  print(Status.big)

fail "enum variant none", "8:3: a variant cannot be named `none`: `none` is the absent value of an optional", errors: 1
  # A variant cannot be named `none`: `.none` would read as `none`, the
  # absent value of an optional, and in a `K?` could be taken for it. The
  # variant is still declared, so each use of it below (a field default,
  # a binding, a match arm, a comparison, an argument, a return, and
  # `K.none` written out) draws no further error.

  enum K
    none = 0
    some = 1

  obj Box
    k: K = .none

  fun id(k: K) -> K
    k

  fun mk() -> K
    .none

  b = Box()
  print(Int(b.k))
  k: K = .none
  match k
    .none => print("n")
    .some => print("s")
  print(k == .none)
  print(Int(id(.none)))
  print(Int(mk()))
  print(Int(K.none))
  o: K? = .none
  print(o)

fail "enum variant none kinds", "6:3: a variant cannot be named `none`", "10:3: a variant cannot be named `none`", "14:3: a variant cannot be named `none`", "18:3: a variant cannot be named `none`", "21:3: a variant cannot be named `none`", "24:3: an error cannot be named `none`", errors: 6
  # No enum names a variant `none`, nor an error set an error: a plain
  # variant, one with a value, a payload variant, and one of a generic
  # enum, with payload or without.

  enum A
    none

  enum B
    one = 1
    none = 2

  enum C
    some(v: Int)
    none(why: String)

  enum D[T]
    some(v: T)
    none

  enum E[T]
    none(v: T)

  error Bad
    none

  pass

test "enum view payload match", '''
  tt tt d
  tt tt tt d
  tt
  4 0
  2
'''
  # A match binds a payload field that is itself a view (an enum
  # instantiated at a view type, `Opt[?T]`) as the view it is, not as a
  # view of the field: in a plain arm, a guarded one, beside a field that
  # is no view, at a concrete instance, a slice, and in a write match.

  enum Opt[T]
    some(v: T)
    nothing

  enum Pair[A, B]
    both(a: A, b: B)
    neither

  fun wrap[T](x: ?T) -> Opt[?T] from x
    Opt.some(v: x)

  fun first[T](x: ?T, d: ?T) -> ?T from x, d
    match wrap(x)
      .some(v) => v
      .nothing => d

  fun pick[T](x: ?T, d: ?T, ok: Bool) -> ?T from x, d
    match wrap(x)
      .some(v) if ok => v
      _ => d

  fun mk[T](x: ?T, n: Int) -> Pair[?T, Int] from x
    Pair.both(a: x, b: n)

  fun left[T](x: ?T, d: ?T) -> ?T from x, d
    match mk(x, 2)
      .both(a, _) => a
      .neither => d

  fun wrapText(x: ?String) -> Opt[?String] from x
    Opt.some(v: x)

  fun firstText(x: ?String, d: ?String) -> ?String from x, d
    match wrapText(x)
      .some(v) => v
      .nothing => d

  fun longer(x: ?String, d: ?String) -> ?String from x, d
    match wrapText(x)
      .some(v) if v.len > 1 => v
      _ => d

  fun held(o: !Opt[?String], d: ?String) -> ?String from o, d
    match o
      .some(v) => v
      .nothing => d

  fun wrapSlice(xs: []Int) -> Opt[[]Int] from xs
    Opt.some(v: xs)

  t = String("tt")
  u = String("u")
  d = String("d")
  print(first(?t, ?d), pick(?t, ?d, true), pick(?t, ?d, false))
  print(left(?t, ?d), firstText(?t, ?d), longer(?t, ?d), longer(?u, ?d))
  o = wrapText(?t)
  print(held(!o, ?d))
  n = 4
  m = 0
  print(first(?n, ?m), pick(?n, ?m, false))
  v = [1, 2, 3]
  match wrapSlice(?v[..])
    .some(s) => print(s[1])
    .nothing => pass

test "enum a variant with an empty payload is bare", "true 1 true 0 1"
  # `a()` declares a bare variant, as `a` does: the enum is plain, so its
  # variants compare, order, and convert to their values alike.
  enum E
    a()
    b

  x = E.b
  print(x > E.a, Int(x), x == E.b, Int(E.a), $variants(E).len - 1)

test "a payload variant written short as a fallback in print's arguments", '''
  .circle(r: 1) .circle(r: 2)
  .circle(r: 3) .circle(r: 4)
'''
  enum Shape
    circle(r: Int)
    dot

  error Oops
    bad(at: Int)

  fun fails() -> Shape!Oops
    return Oops.bad(at: 0)

  fun maybe() -> Shape?!Oops
    return Oops.bad(at: 0)

  sub main()
    o: Shape? = none
    print(o ?? .circle(r: 1), fails() catch .circle(r: 2))
    print(maybe() catch .circle(r: 3), fails() catch .circle(4))

test "a short form a fallback gives through a branch, a block, or a bound catch", '''
  .err(e: E.bad)
  .red
  .idle
  E.bad
  .ip(n: 7) .ip(n: 4)
'''
  error E
    bad

  enum Out
    ip(n: Int)
    err(e: E)
    idle

  enum Color
    red
    blue

  fun handle(n: Int) -> Out?!E
    return E.bad if n < 0
    return none if n == 0
    .ip(n)

  sub main()
    out = handle(-1) catch |e| .err(e)
    print(out)
    n = 1
    o: Color? = none
    print(o ?? (.red if n == 1 else .blue))
    c = handle(-2) catch |e|
      match e
        E.bad => .idle
    print(c)
    d = handle(-3) catch |e|
      print(e)
      .ip(7)
    print(d, handle(4) catch |e| (.err(e) if n == 1 else .idle))
