test "R15-p-k1", '''
  [4, 3, 2, 1]
  [0.5, 0.5]
  [4, 3, 2, 1]
'''
  sub rev[T](s: ![]T)
    i = 0
    j = s.len - 1
    while i < j
      !s.swap(i, j)
      i += 1
      j -= 1

  sub fillall[T](s: ![]T, v: T)
    !s.fill(v)

  sub cp[T](d: ![]T, s: []T)
    !d.copy(s)

  a = [1, 2, 3, 4]
  rev(!a[..])
  print(a)
  f = [1.5, 2.5]
  fillall(!f[..], 0.5)
  print(f)
  b = [0, 0, 0, 0]
  cp(!b[..], ?a[..])
  print(b)

