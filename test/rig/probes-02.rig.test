  take(|?v| v.len, |<v| v.len)

test "R16-n1", '''
  6
  90
'''
  sub rec(n: Int, f: ?sub(Int))
    if n == 0
      f(0)
    else
      rec(n - 1, |?f, +n, k| f(k + n))

  sub each(xs: ?List[Int], f: ?sub(Int))
    for x in xs
      f(x)

  total = 0
  rec(3, |!total, k|
    total += k
  )
  print(total)
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  w: List[Int] = List()
  !w.push(10)
  !w.push(20)
  sum = 0
  each(?v, |?w, !sum, a|
    each(?w, |!sum, +a, b|
      sum += a * b
    )
  )
  print(sum)

