test "R16-c5", '''
  31
  10
'''
  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  sub outer(f: ?fun(Int) -> Int)
    g = |?f, a: Int| apply(f, a) + 1
    print(apply(?g, 3))
    h = |?f| f(1)
    print(h())

  outer(|a| a * 10)

fail "R16-c6", "cannot move-capture view parameter `f`; the caller still owns what it views. Capture the view with `|?f|`"
