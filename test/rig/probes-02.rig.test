test "R15-p-x1", '''
  5 3 0
  257 7 [1, 1, 1, 1]
'''
  obj Pkt
    hdr: [4]U8
    body: List[U8]
    fun len(?@) -> U16
      @hdr.read[U16, .big](0)
    fun tag(?@) -> U8
      @body.read[U8](0)
    sub set(!@, n: U16)
      !@hdr.write[U16, .big](0, n)
      !@body.write[U8](0, 7)
      !@hdr.fill(1)
      !@body.swap(0, 0)

  fun peek(p: ?Pkt) -> U16
    p.hdr.read[U16, .little](2)

  b: List[U8] = List()
  !b.push(3)
  p = Pkt(hdr: [0, 5, 0, 0], body: <b)
  print(p.len(), p.tag(), peek(?p))
  !p.set(258)
  print(p.len(), p.tag(), p.hdr)

