test "R15-p-qs", "true 0 999 2000"
  sub qsort(s: ![]Int)
    if s.len < 2
      return
    p = s[s.len - 1]
    i = 0
    j = 0
    while j < s.len - 1 : j += 1
      if s[j] < p
        !s.swap(i, j)
        i += 1
    !s.swap(i, s.len - 1)
    qsort(!s[..i])
    qsort(!s[i + 1..])

  sub msort(s: ![]Int, tmp: ![]Int)
    if s.len < 2
      return
    m = s.len / 2
    msort(!s[..m], !tmp[..m])
    msort(!s[m..], !tmp[m..])
    i = 0
    j = m
    k = 0
    while k < s.len : k += 1
      if j >= s.len or (i < m and s[i] <= s[j])
        tmp[k] = s[i]
        i += 1
      else
        tmp[k] = s[j]
        j += 1
    !s.copy(?tmp[..s.len])

  v: List[Int] = List()
  x = 12345
  n = 0
  while n < 2000 : n += 1
    x = (x * 1103515245 + 12345) % 2147483648
    !v.push(x % 1000)
  w: List[Int] = List()
  t: List[Int] = List()
  for e in v
    !w.push(e)
    !t.push(0)
  qsort(!v[..])
  msort(!w[..], !t[..])
  ok = true
  k = 1
  while k < v.len : k += 1
    if v[k - 1] > v[k] or v[k] != w[k]
      ok = false
  print(ok, v[0], v[v.len - 1], v.len)

