  16909060 1027
'''
  fun get[T, e: Endian](b: []U8, at: Int) -> T
    b.read[T, e](at)

  sub put[T, e: Endian](b: ![]U8, at: Int, v: T)
    !b.write[T, e](at, v)

  buf: [8]U8 = [8 of 0]
  put[U32, .big](!buf[..], 0, 0x01020304)
  print(buf)
  print(get[U32, .big](?buf[..], 0), get[U16, .little](?buf[..], 2))

