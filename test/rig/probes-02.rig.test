test "R16-em2", '''
  drop 3
  8
  drop 0
  -1
'''
  error E
    bad

  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun may(n: Int) -> Int!
    return E.bad if n < 0
    n

  fun apply(x: Int, f: ?fun(Int) -> Int, y: Int) -> Int
    f(x + y)

  fun go(n: Int) -> Int!
    r = Res(id: n)
    apply(may(n)!, |<r, a| a + r.id, may(n - 1)!)

  print(go(3) catch -1)
  print(go(0) catch -1)

test "R16-em3", '''
  4
  -1
  3
  3
  99
  7
'''
  error E
    bad

  fun may(n: Int) -> Int!
    return E.bad if n < 0
    n

  fun apply(f: ?fun(Int) -> Int!, x: Int) -> Int!
    f(x)!

  fun appo(f: ?fun(Int) -> Int?, x: Int) -> Int
    f(x) ?? 99

  fun appq(f: ?fun(Int) -> Int?, x: Int) -> Int?
    f(x)? + 1

  print(apply(|a| a + 1, 3) catch -1)
  print(apply(may, -3) catch -1)
  print(apply(may, 3) catch -1)
  print(appo(|a| a if a > 0 else none, 3))
  print(appo(|a| a if a > 0 else none, -3))
  print(appq(|a| a if a > 0 else none, -3) ?? 7)

