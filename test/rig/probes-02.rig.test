test "R16-g7", '''
  8
  a
'''
  fun call_it[T](x: T, f: ?fun(T) -> T) -> T
    f(x)

  fun twice[T](x: T, f: ?fun(T) -> T) -> T
    call_it(call_it(x, f), f)

  fun thrice[T](x: T, f: ?fun(T) -> T) -> T
    twice(call_it(x, f), f)

  k = 2
  print(thrice(1, |+k, a| a * k))
  print(thrice("a", |s| s))

test "R16-gg1", '''
  3 6
  false true
  6

  zero
  101
'''
  fun map[T, U](xs: []T, f: ?fun(T) -> U) -> List[U]
    out: List[U] = List()
    for x in xs
      !out.push(f(x))
    out

  fun map2[T, U](xs: []T, f: ?fun(T) -> U) -> List[U]
    map(xs, f)

  fun map3[T, U](xs: []T, f: ?fun(T) -> U) -> List[U]
    k = 1
    map2(xs, |?f, +k, x| f(x))

  fun fold[T, A](xs: []T, init: A, f: ?fun(A, T) -> A) -> A
    acc = init
    for x in xs
      acc = f(acc, x)
    acc

  sub apply0(f: ?sub())
    f()

  a = [1, 2, 3]
  m = map3(?a[..], |x| x * 2)
  print(m.len, m[2])
  s = map3(?a[..], |x| x > 1)
  print(s[0], s[2])
  print(fold(?a[..], 0, |acc, x| acc + x))
  print(fold(?a[..], "", |acc, x| acc))
  apply0(|| print("zero"))
  n = map(xs: ?a[..], f: |x| x + 100)
  print(n[0])

