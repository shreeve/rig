    id: Int

    drop(!@)
      print("drop", @id)

  r = Res(id: 1)
  r = Res(id: 2)
  f = |!r|
    <r
    print("dropped")
  f()
  print("end")

fail "R16-rs5", "cannot move out of `b.r`: `b` is a view; exchange it instead: `replace(!b.r, v)`"
  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  obj Box
    r: Res

  b = Box(r: Res(id: 1))
  b = Box(r: Res(id: 2))
  g = |!b|
    x = <b.r
    print(x.id)
  g()
  print("end")

fail "R16-rv2", "cannot lend `b` to write while a read loan is live"
  obj Bag
    items: List[Int]

    sub grow(!@, f: ?fun(Int) -> Int)
      n = @items.len
      i = 0
      while i < n
        !@items.push(f(i))
        i += 1

  b = Bag(items: List())
  !b.items.push(1)
  !b.grow(|?b, n| b.items.len + n)
  print(b.items.len)

