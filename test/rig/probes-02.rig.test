test "R16-rs1", '''
  drop 1
  drop 2
  drop 3
  mid 3
  0
  drop 3
  end
  drop 4
'''
  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  sub run(f: ?sub())
    f()

  r = Res(id: 1)
  r = Res(id: 2)
  swap = |!r|
    r = Res(id: 3)
  swap()
  swap()
  print("mid", r.id)
  v: List[Int] = List()
  !v.push(1)
  run(|!v|
    v = List()
  )
  print(v.len)
  run(|!r|
    r = Res(id: 4)
  )
  print("end")

