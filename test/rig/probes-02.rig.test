test "R16-ls1", '''
  101
  6
  6
  103
  1
'''
  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  obj H
    cb: *fun(Int) -> Int

  fun viaparam(g: fun(Int) -> Int) -> Int
    apply(g, 1) + apply(?g, 2)

  fun viaref(f: ?fun(Int) -> Int) -> Int
    apply(f, 1) + apply(?f, 2)

  fun viahandle(c: ?*fun(Int) -> Int) -> Int
    apply(?c, 3)

  fun double(n: Int) -> Int
    n * 2

  h = H(cb: *|a| a + 100)
  print(apply(?h.cb, 1))
  print(viaparam(double))
  print(viaref(double))
  print(viahandle(?h.cb))
  w = ~h.cb
  print(1)

test "R16-m1", '''
  3
  2 20
  6
  42
  s
'''
  obj Bag[T]
    items: List[T]

    sub each(?@, f: ?sub(T))
      for x in ?@items
        f(x)

    fun map[U](?@, f: ?fun(T) -> U) -> List[U]
      out: List[U] = List()
      for x in ?@items
        !out.push(f(x))
      out

    sub mutate(!@, f: ?fun(T) -> T) keeps f
      i = 0
      while i < @items.len
        @items[i] = f(@items[i])
        i += 1

  obj Counter
    n: Int

    sub bump(!@, f: ?fun(Int) -> Int)
      @n = f(@n)

  b = Bag[Int](items: List())
  !b.items.push(1)
  !b.items.push(2)
  total = 0
  b.each(|!total, x|
    total += x
  )
  print(total)
  m = b.map(|x| x * 10)
  print(m.len, m[1])
  k = 5
  !b.mutate(|+k, x| x + k)
  print(b.items[0])
  c = Counter(n: 1)
  !c.bump(|a| a + 41)
  print(c.n)
  s = ?b.map(|x| "s")
  print(s[0])

