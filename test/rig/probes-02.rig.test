    print(h())

  outer(|a| a * 10)

test "R16-ctx1", '''
  chk 0
  chk 1
  chk 2
  chk 3
  3
  true
  6
  two
  drop 1
  2
  drop 9
  14
  7
'''
  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun chk(f: ?fun(Int) -> Bool, x: Int) -> Bool
    print("chk", x)
    f(x)

  fun val(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  fun pos(n: Int) -> Int?
    n if n > 0 else none

  fun first() -> Int
    r = Res(id: 1)
    return val(|<r, a| a + r.id, 1)

  n = 0
  while chk(|a| a < 3, n)
    n += 1
  print(n)
  if false and chk(|a| a > 0, 99)
    print("no")
  b = true or chk(|a| a > 0, 98)
  print(b)
  o = pos(-1) ?? val(|a| a * 3, 2)
  print(o)
  match val(|a| a + 1, 1)
    2 => print("two")
    _ => print("other")
  print(first())
  defer print(val(|a| a + 7, 0))
  x = 5
  c = Res(id: 9)
  y = val(|<c, a| a + c.id, x) if x > 3 else 0
  print(y)

