test "review-labels-1-h01 header break outer defer", '''
  0 0
  e 0
  0 1
  e 1
  d 0
  9
'''
  fun get(i: Int) -> Bool?
    (i < 9) if i < 2 else none

  $o: for k in 0..3
    defer print("d", k)
    i = 0
    while get(i) ?? break $o : i += 1
      defer print("e", i)
      print(k, i)
    print("after", k)
  print(9)

