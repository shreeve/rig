# Probes from past reviews and audits, 22 of 41: review-errors-m7-main4 to review-lend-base-3-j-j14.

test "review-errors-m7-main4", '''
  alias full
  true
  0 Disk.full Disk.full
'''
  use lib

  type D = lib.Disk

  sub main()
    x = lib.fail() catch |e|
      match e
        D.full => print("alias full")
        _ => print("other")
      print(e == D.full)
      0
    d: D = .full
    print(x, d, D.full)

  file "lib.rig"
    pub error Disk
      full

    pub DEF = Disk.full

    pub fun fail() -> Int!
      return Disk.full

test "review-errors-m8", '''
  E.eof true
  1
'''
  use b

  error Mine
    other

  sub main()
    x = b.g() catch |e|
      print(e, e == .eof)
      match e
        .eof => 1
        _ => 2
    print(x)

  file "a.rig"
    pub error E
      eof

    pub fun f() -> Int!
      return E.eof

  file "b.rig"
    use a

    pub fun g() -> Int!
      a.f()! + 1

test "review-errors-m9", '''
  true
  1 Disk.full
'''
  use lib

  sub main()
    x = lib.f() catch |e|
      print(e == lib.D.full)
      match e
        lib.D.full => 1
        _ => 2
    print(x, lib.D.full)

  file "lib.rig"
    pub error Disk
      full

    pub type D = Disk

    pub fun f() -> Int!
      return D.full

fail "review-header-paths-1-o01 store readview of self into arg", "cannot reassign `h` while it is lent"
  obj H
    n: Int
    v: List[Int]

    sub put(!self, dst: !List[?List[Int]]) keeps self
      !self.v.push(1)
      !dst.push(?self.v)

  v: List[Int] = List()
  h = H(n: 1, v: <v)
  d: List[?List[Int]] = List()
  (!h).put(!d)
  h = H(n: 2, v: List())
  print(d.len)
  print(d[0])

fail "review-header-paths-1-t01 for branch part readview local owner", "cannot lend `z` to write while a read loan is live"
  obj RV
    rv: ?List[Int]
    n: Int

  z: List[Int] = List()
  !z.push(1)
  !z.push(2)
  q: List[Int] = List()
  !q.push(3)
  x = RV(rv: ?z, n: 1)
  y = RV(rv: ?q, n: 2)
  a = !x
  b = !y
  c = true
  n = 0
  for e in (a if c else b).rv
    for _ in 0..100
      !z.push(1)
    n += e
  print(n)

