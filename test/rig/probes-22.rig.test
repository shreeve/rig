test "review-lang4-q3", "3"
  obj S
    n: Int

    sub hook(!self, k: Int)
      pass

  sub f()!
    pass

  sub cb(n: Int, xs: List[Int])
    pass

  f()!
  cb(1, List())
  s = S(n: 1)
  !s.hook(3)
  t: sub(Int) = |k|
    pass
  t(1)
  i = 0
  while i < 3 : i += 1
    pass
  print(i)

test "review-lend-base-2-p-a09", "[1, 7]"
  obj Set
    items: List[Int]

    fun insert(!self, k: Int) -> Bool
      !self.items.push(k)
      true

    fun count(?self) -> Int
      self.items.len

    sub put[k: Int](!self, x: Int)
      !self.items.push(x * k)

  obj Q
    n: Int

    sub bump(!self)
      self.n += 1

    fun get(?self) -> Int
      self.n

  obj P
    x: Int
    o: Int?
    a: [2]Int
    v: List[Int]
    q: Q
    s: Set

  fun mk() -> P
    P(x: 1, o: 3, a: [1, 2], v: List(), q: Q(n: 1), s: Set(items: List()))

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  (<(!v[..]))[1] += 5
  print(v)

