# proofs: a fill whose every element is written before any is read is
# not made (docs/internals/INTERNALS.md, "Fills written before they are
# read").

test "fill written", "4950", release: true
  fun total() -> Int
    t = [100 of 0] # proves: fill written
    for k in 0..100
      t[k] = k
    s = 0
    for v in t
      s += v
    s

  print(total())

test "fill written by length", "[2, 3, 4, 5]", release: true
  fun shifted(i: Int) -> [4]Int
    t: [4]Int = [4 of 0] # proves: fill written
    for k in 0..t.len
      t[k] = k + i
    t

  print(shifted(2))

test "fill read in the loop", "[1, 1, 1, 2]", release: true
  # The loop reads `t` before it is all written: the fill is made.

  fun steps() -> [4]Int
    t = [4 of 0] # keeps: fill written
    for k in 0..4
      t[k] = t[(k + 1) % 4] + 1
    t

  print(steps())

test "fill partly written", "[7, 7, 7, 0]", release: true
  fun part() -> [4]Int
    t = [4 of 0] # keeps: fill written
    for k in 0..3
      t[k] = 7
    t

  print(part())

test "fill and a break", "[7, 7, 0, 0]", release: true
  fun part() -> [4]Int
    t = [4 of 0] # keeps: fill written
    for k in 0..4
      t[k] = 7
      break if k == 1
    t

  print(part())

test "fill of an inclusive range", "[7, 7, 7, 7]", release: true
  fun all7() -> [4]Int
    t = [4 of 0] # keeps: fill written
    for k in 0..=3
      t[k] = 7
    t

  print(all7())
