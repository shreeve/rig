fail "name grid flag none", "`none` is the absent optional"
  fun take0(s: String) -> Int
    s.len

  fun fl0(c: Bool) -> Int
    none = String("ab")
    k = 0
    if c
      k += take0(<none)
    none_2 = String("cde")
    if not c
      k += take0(<none_2)
    k

  sub t0()
    print(fl0(true), fl0(false))

  sub main()
    t0()

