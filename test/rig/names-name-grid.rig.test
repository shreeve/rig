fail "name grid error none", "none"
  error E0
    zz
    none

  fun f0(k: Int) -> Int!
    if k == 1
      return E0.none
    if k == 2
      return E0.zz
    k

  sub t0()
    t = 0
    $none: for a in 0..3
      for j in 0..3
        if j == 2
          continue $none
        if a == 2
          break $none
        t += 1
    print(t)
    _ = f0(1) catch |e|
      print(e, e == E0.none, e == E0.zz)
      0
    c = f0(1) catch |e|
      match e
        E0.none => 7
        _ => 8
    print(c)

  sub main()
    t0()

