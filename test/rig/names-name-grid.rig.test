fail "name grid tparam none", "`none` is the absent optional"
  obj GT0[none]
    x: none

    fun first(?@) -> none
      @x

  enum HT0[none]
    one(v: none)
    two

  fun id0[none](x: none) -> none
    x

  fun sz0[none]() -> Int
    $size(none)

  sub t0()
    g = GT0[Int](x: 4)
    h = HT0[Int].one(v: 7)
    match h
      .one(v) => print(v)
      .two => print("two")
    print(g.first(), id0[Int](5), id0(6), sz0[U8](), g, $name(GT0[Int]))

  sub main()
