fail "name grid method none", "`none` is the absent optional"
  obj M0
    v: Int

    fun none(?@) -> Int
      @v

    fun b(?@) -> Int
      none = @v + 1
      none + @none()

    fun c(?@, none: Int) -> Int
      none + @none()

    fun d(?@) -> Int
      g = |?@|
        none = @v + 2
        none
      g()

    sub none2(!@)
      @v += 1

  obj GM0[T]
    v: T

    fun none(?@) -> Int
      1

    fun b(?@, none: Int) -> Int
      none + @none()

  sub t0()
    m = M0(v: 1)
    !m.none2()
    h = |?m| m.none()
    print(m.none(), m.b(), m.c(10), m.d(), h(), GM0[Int](v: 0).b(5))

  sub main()
    t0()

