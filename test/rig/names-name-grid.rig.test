fail "name grid tparam addrspace", "a type parameter starts with a capital letter"
  obj GT0[addrspace]
    x: addrspace

    fun first(?@) -> addrspace
      @x

  enum HT0[addrspace]
    one(v: addrspace)
    two

  fun id0[addrspace](x: addrspace) -> addrspace
    x

  fun sz0[addrspace]() -> Int
    $size(addrspace)

  sub t0()
    g = GT0[Int](x: 4)
    h = HT0[Int].one(v: 7)
    match h
      .one(v) => print(v)
      .two => print("two")
    print(g.first(), id0[Int](5), id0(6), sz0[U8](), g, $name(GT0[Int]))

  sub main()
    t0()

fail "name grid tparam align", "a type parameter starts with a capital letter"
  obj GT0[align]
    x: align

    fun first(?@) -> align
      @x

  enum HT0[align]
    one(v: align)
    two

  fun id0[align](x: align) -> align
    x

  fun sz0[align]() -> Int
    $size(align)

  sub t0()
    g = GT0[Int](x: 4)
    h = HT0[Int].one(v: 7)
    match h
      .one(v) => print(v)
      .two => print("two")
    print(g.first(), id0[Int](5), id0(6), sz0[U8](), g, $name(GT0[Int]))

  sub main()
    t0()

