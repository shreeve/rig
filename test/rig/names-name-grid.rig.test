    from_int(w: Int)

  enum G0[T]
    gg(v: T)
    from_int(w: T)

  obj B0
    k: K0 = .from_int
    v: V0 = .from_int

  fun pick0(k: K0 = .from_int) -> Int
    Int(k)

  fun pv0(p: P0) -> Int
    match p
      .from_int(w: x) => x
      .pp(v) => v

  fun gv0(g: G0[Int]) -> Int
    match g
      .from_int(w) => w
      _ => 0

  sub t0()
    b = B0()
    k: K0 = .from_int
    print(Int(b.k), Int(b.v), pick0(), pick0(.zz), k == .from_int, k == K0.from_int, b.v == .from_int)
    match k
      .from_int => print("m1")
      .zz => print("m0")
    print(Int(V0.from_int(7) ?? V0.aa), pv0(P0.from_int(w: 5)), pv0(.pp(v: 6)), gv0(G0[Int].from_int(w: 8)))
    n = 0
    for x in $variants(V0)
      n += Int(x)
    print(n, K0.from_int, V0.from_int, P0.from_int(w: 1), String(k))
    for x in $variants(K0)
      print(x)

  sub main()
    t0()

