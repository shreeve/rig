# names: each name a place where a name stands rejects, with the
# diagnostic it gives. Written by test/cli/_name_grid.py --cases;
# test/cli/name_grid.sh checks it is what that writes. A keyword of
# Rig's own may draw any diagnostic, "".

fail "name grid local none", "`none` is the absent optional"
  error LE0
    bad

  fun lfail0() -> Int!
    return LE0.bad

  enum LP0
    pp(v: Int)
    qq

  fun lp0(none: Int) -> Int
    none + 1

  fun lf0() -> Int
    s = 0
    for none in 0..3
      s += none
    s

  fun lo0(o: Int?) -> Int
    if o as none
      return none
    0

  fun lc0() -> Int
    none = 41
    g = |+none| none + 1
    g()

  fun lm0(p: LP0) -> Int
    match p
      .pp(v: none) => none
      .qq => 0

  sub lb0(none: !Int)
    none += 1

  sub t0()
    x = lfail0() catch |none|
      print(none)
      7
    k = 1
    lb0(!k)
    print(lp0(41), lf0(), lo0(5), lc0(), x, lm0(.pp(v: 9)), k)

  sub main()
    t0()

