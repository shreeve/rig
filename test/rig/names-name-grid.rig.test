fail "name grid module none", "`none` is the absent optional"
  use lib
  use none

  fun pv0(p: lib.P0) -> Int
    match p
      .none(w) => w
      .pp(v) => v

  fun gv0(g: lib.G0[Int]) -> Int
    match g
      .none(w: x) => x
      _ => 0

  sub t0()
    b = lib.Box0()
    print(Int(b.k), b.none, b.none2(), lib.pick0(), lib.pick0(.zz), lib.none(1), none.two())
    k: lib.K0 = .none
    print(k == lib.K0.none, k == .none)
    match k
      .none => print("m")
      .zz => print("z")
    print(pv0(lib.P0.none(w: 5)), gv0(lib.G0[Int].none(w: 6)))
    x = lib.fails0(0) catch |e|
      print(e == lib.E0.none, e)
      -1
    print(x, lib.Box0(none: 9).none)

  sub main()
    t0()
  file "lib.rig"
    pub enum K0
      zz
      none

    pub enum P0
      pp(v: Int)
      none(w: Int)

    pub enum G0[T]
      gg(v: T)
      none(w: T)

    pub obj Box0
      pub k: K0 = .none
      pub none: Int = 4

      pub fun none2(?@) -> Int
        @none + 1

    pub error E0
      zz
      none

    pub fun pick0(k: K0 = .none) -> Int
      Int(k)

    pub fun fails0(k: Int) -> Int!
      if k == 0
        return E0.none
      k

    pub fun none(x: Int) -> Int
      x + 100
  file "none.rig"
    pub fun two() -> Int
      2

