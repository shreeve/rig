fail "name grid variant none", "none"
  enum K0
    zz
    none

  enum V0
    aa = 3
    none = 7

  enum P0
    pp(v: Int)
    none(w: Int)

  enum G0[T]
    gg(v: T)
    none(w: T)

  obj B0
    k: K0 = .none
    v: V0 = .none

  fun pick0(k: K0 = .none) -> Int
    Int(k)

  fun pv0(p: P0) -> Int
    match p
      .none(w: x) => x
      .pp(v) => v

  fun gv0(g: G0[Int]) -> Int
    match g
      .none(w) => w
      _ => 0

  sub t0()
    b = B0()
    k: K0 = .none
    print(Int(b.k), Int(b.v), pick0(), pick0(.zz), k == .none, k == K0.none, b.v == .none)
    match k
      .none => print("m1")
      .zz => print("m0")
    print(Int(V0.from_int(7) ?? V0.aa), pv0(P0.none(w: 5)), pv0(.pp(v: 6)), gv0(G0[Int].none(w: 8)))
    n = 0
    for x in $variants(V0)
      n += Int(x)
    print(n, K0.none, V0.none, P0.none(w: 1), String(k))
    for x in $variants(K0)
      print(x)

  sub main()
    t0()

fail "name grid variant from_int", "from_int"
  enum K0
    zz
    from_int

  enum V0
