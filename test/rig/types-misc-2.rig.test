test "variant positional construction", '''
  12 3 .circle(radius: 1) .circle(radius: 1) 27
  .some(value: 7) .some(value: 2.5) .some(value: "hi") .some(value: 4) .nothing .some(value: 9)
  7 5 -1
  1 0 0
'''
  # A variant with exactly one field takes it by position, `.some(7)`, as a
  # pattern binds it; by name, `.some(value: 7)`, is valid too. The field's
  # type is expected of the argument, and a generic enum's argument is
  # inferred from it.

  enum Shape
    circle(radius: Int)
    rect(w: Int, h: Int)

  enum Option[T]
    some(value: T)
    nothing

    fun or(<self, fallback: T) -> T
      match <self
        .some(v) => v
        .nothing => fallback

  fun area(s: Shape) -> Int
    match s
      .circle(r) => 3 * r * r
      .rect(w, h) => w * h

  fun half(n: Int) -> Option[Int]
    return .nothing if n % 2 == 1
    .some(n / 2)

  fun count(o: Option[List[Int]]) -> Int
    match o
      .some(v) => v.len
      .nothing => 0

  a: Shape = .circle(2)
  b = Shape.circle(1)
  c: Shape = .circle(radius: 1)
  print(area(a), area(b), b, c, area(.circle(3)))
  o = Option.some(7)
  f = Option.some(2.5)
  s: Option[?String] = .some("hi")
  print(o, f, s, half(8), half(3), Option[U8].some(9))
  print(<o.or(0), Option.some(5).or(0), half(3).or(-1))
  v: List[Int] = List()
  !v.push(1)
  print(count(.some(<v)), count(Option.some(List[Int]())), count(.nothing))

fail "variant positional construction is rejected", "8:11: a variant with more than one field sets them by name: `.rect(w: ...)`", "9:13: a variant with more than one field sets them by name: `.rect(w: ...)`", "10:13: variant `circle` has one field: write `.circle(value)` or `.circle(radius: value)`", "11:13: variant `circle` has one field: write `.circle(value)` or `.circle(radius: value)`", "12:20: type mismatch: expected `Int`, got `Static`"
  # A variant with one field takes it by position or by name; a variant
  # with more than one field sets them by name, like a struct's.

  enum Shape
    circle(radius: Int)
    rect(w: Int, h: Int)

  a = Shape.rect(2, h: 3)
  b: Shape = .rect(2, 3)
  c: Shape = .circle(2, 3)
  d: Shape = .circle(2, radius: 3)
  e: Shape = .circle("two")
  print(a, b, c, d, e)

test "variant tag equality", '''
  false false true true
  true false true
  false true
  false true
  drop 3
  false true false
'''
  # A bare `.variant` compared with a payload enum tests the variant only,
  # whatever the payloads hold: handles, functions, or a generic `T` that
  # has no `==`. It compares no payload, so it needs none to be equatable.
  # A temporary that owns a resource is dropped once tested.

  obj N
    n: Int

  enum Slot
    held(p: *N)
    empty

  enum Op
    f(g: fun(Int) -> Int)
    none_

  enum Opt[T]
    some(value: T)
    nothing

  obj R
    n: Int

    drop(!self)
      print("drop", self.n)

  enum D
    r(res: R)
    e

  fun make() -> Slot
    .held(p: *N(n: 2))

  fun maybe() -> Slot?
    .empty

  fun owned(n: Int) -> D
    .r(res: R(n: n))

  fun is_nothing[T](o: ?Opt[T]) -> Bool
    o == .nothing

  fun inc(x: Int) -> Int
    x + 1

  s: Slot = .held(p: *N(n: 1))
  e: Slot = .empty
  print(s == .empty, .empty == s, s != .empty, e == .empty)
  o: Slot? = .empty
  n: Slot? = none
  print(o == .empty, n == .empty, n != .empty)
  op: Op = .f(g: inc)
  print(op == .none_, op != .none_)
  a: Opt[fun(Int) -> Int] = .some(value: inc)
  b: Opt[*N] = .nothing
  print(is_nothing(?a), is_nothing(?b))
  print(make() == .empty, maybe() == .empty, owned(3) == .e)

