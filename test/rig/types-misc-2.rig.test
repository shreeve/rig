fail "while header old label", "10:27: a label is written `@name`: the `:` in a `while` header starts the step, so `outer` reads as the step; to name a label, write `break @outer`", "12:30: a label is written `@name`: the `:` in a `while` header starts the step, so `outer` reads as the step; to name a label, write `continue @outer`"
  # A label is written `@name`. In the old spelling, `while x ?? break
  # :outer`, the `:` in the header starts the step, so `outer` reads as the
  # step, and the error says how to write the label.

  fun more(n: Int) -> Bool?
    n > 0 if n < 9 else none

  n = 3
  @outer while true
    while more(n) ?? break :outer
      n -= 1
    while more(n) ?? continue :outer
      n -= 1
    break
  print(n)

fail "while header old label step", "11:26: a label is written `@name`: `@outer for ...`, `break @outer`, `continue @outer`"
  # A label in the old spelling in a `while` header that has a step:
  # `while x ?? break :outer : i += 1` is rejected with the hint, not read
  # as a step named `outer`.

  fun more(n: Int) -> Bool?
    n > 0 if n < 9 else none

  n = 3
  i = 0
  @outer while true
    while more(n) ?? break :outer : i += 1
      n -= 1
    break
  print(n, i)

