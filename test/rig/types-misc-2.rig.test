    return v

  v = Val.Num(n: 1)
  _ = pick(?v, 1) catch return

fail "variant literal where view kept", "33:7: type mismatch: expected `!Val`, got `Val`", "34:7: type mismatch: expected `!Color`, got `Color`", "35:12: type mismatch: expected `?Val`, got `Val`", "36:16: type mismatch: expected `?Val`, got `Val`", "37:11: type mismatch: expected `?Val`, got `Val`", "38:6: `.Num` is an enum variant, but the expected type `?Val?` is not an enum", "27:24: type mismatch: expected `?Val`, got `Val`", "31:10: type mismatch: expected `?Val`, got `Val`", errors: 8
  # A variant literal whose enum comes from where it goes is, where a
  # view held by address goes, the value `Val.V(...)` is, and is rejected
  # where that value is: lent to write, kept in a field, an element, or a
  # binding, returned, a view of an optional, or a parameter's default.

  enum Val
    Num(n: Int)
    Table(m: List[Int])
    Empty

  enum Color
    Red
    Green

  obj Ref
    v: ?Val

  sub write(v: !Val)
    print("write")

  sub paint(c: !Color)
    print("paint")

  sub opt(v: ?Val?)
    print("opt")

  sub fallback(v: ?Val = .Empty)
    print("fallback")

  fun made() -> ?Val
    return .Num(n: 3)

  write(.Num(n: 3))
  paint(.Red)
  r = Ref(v: .Num(n: 3))
  xs: [1]?Val = [.Num(n: 3)]
  v: ?Val = .Table(m: List())
  opt(.Num(n: 3))
  fallback()
  print(r, xs, v, made())

