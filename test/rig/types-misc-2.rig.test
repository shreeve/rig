  # `push` appends one `U8`.

  t = String()
  !t.push("ab")
  !t.push(1, 2)
  !t.push(b: U8(68))

fail "text string plus", "4:7: operator `+` requires numeric operands; got `Static`; Rig has no `+` on text: build it with `String(a, b)` or `!t.add(...)`"
  # Rig has no `+` on text: build it with `String(...)` or `!t.add(...)`.

  a = "x"
  print(a + "y")

test "text values", '''
  abc abcd false true true true false
  abc! 4
  abc!012
  0 true []
  again
  Note(title: "hi", n: 2) hi
  m
  boxed shared shared one 6
  alias 1
  3
  reborn
  done
'''
  # A Text owns its bytes: it moves, clones with `+t`, compares by content
  # with a Text or a String, clears, and prints bare at the top level and
  # quoted inside other values. Every Text is released exactly once.

  type Str = String

  obj Note
    title: String
    n: Int

  fun shout(t: ?String) -> String
    String(t[..], "!")

  sub grow(t: !String, n: Int)
    for i in 0..n
      !t.add(i)

  fun take(t: String) -> Int
    t.len

  a = String("abc")
  b = +a
  !b.add("d")
  print(a, b, a == b, a != b, a == "abc", "abcd" == b, b == ?a[..])
  c = shout(?a)
  print(c, c.len)
  grow(!c, 3)
  print(c)
  !c.clear()
  shown = String("[", c, "]")
  print(c.len, c == "", shown)
  !c.add("again")
  print(c)
  note = Note(title: String("hi"), n: 2)
  print(note, note.title)
  maybe: String? = String("m")
  print(maybe)
  boxed = ^String("boxed")
  shared = *String("shared")
  other = +shared
  cell = *Cell(String("one"))
  old = (!cell).replace(String("two"))
  print(boxed, shared, other, old, shared.len)
  named: Str = Str("alias ", 1)
  print(named)
  print(take(<a))
  a = String("reborn")
  print(a)
  <b
  print("done")

test "text view is string", '''
  5 5 3
  2 true
  3 false
  6
  3 xyz
  7 payload
  held true false
  hello 5
  hello! 6 hello
  true
  hello?
  hello 5
'''
  # The read view of a Text is its bytes, a String: one text view, whether
  # written `?t`, bound by a loop or a pattern, passed through a generic
  # `?T`, or captured. A `?String` written as a type is that String, so a
  # literal goes where one is expected, and `+v` of a String makes a Text.

  obj Item
    name: String

  enum Slot
    full(item: String)
    empty

  fun size(s: ?String) -> Int
    s.len

  fun id[T](x: T) -> T
    x

  fun first[T](xs: []T) -> T
    xs[0]

  fun same[T](a: ?T, b: ?T) -> Bool
    a == b

  fun label(s: ?String) -> ?String
    s

  fun shout(s: ?String) -> String
    v = +s
    !v.add("!")
    v

  t = String("hello")
  v = ?t
  print(size(v), size(?t), size(label("lit")))

  names: List[String] = List()
  !names.push(String("ab"))
  !names.push(String("cde"))
  for x in ?names
    print(size(?x), x == "ab")
  total = 0
  for x, i in ?names
    total += size(?x) + i
  print(total)

  o: String? = String("xyz")
  if ?o as p
    print(size(?p), p)

  slot = Slot.full(item: String("payload"))
  match ?slot
    .full(item) => print(size(?item), item)
    .empty => pass

  held = Item(name: String("held"))
  g: ?String = id(?held.name)
  print(g, same(?t, ?t), same(?t, ?held.name))

  show = |?t| print(t, size(?t))
  show()

  u = shout(v)
  print(u, u.len, v)
  print(v == "hello")
  own = *|+v| print(v, v.len)
  !t.add("?")
  print(t)
  own()

test "text views", '''
  hello world 5 true
  hello 2 world
  11
  hello hello world!
  0
'''
  # `?t[a..b]` and `?t[..]` view a Text's bytes as a String, and `?t`
  # lends the whole Text where a String is expected. A view views the
  # Text: once the view's last use is past, the Text can change again.

  fun first_word(s: ?String) -> ?String
    i = 0
    while i < s.len and s[i] != 32
      i += 1
    s[..i]

  fun count(s: ?String, b: U8) -> Int
    n = 0
    for c in s
      if c == b
        n += 1
    n

  t = String("hello world")
  w = ?t[0..5]
  rest = ?t[6..]
  print(w, rest, w.len, ?t[..] == "hello world")
  print(first_word(?t), count(?t, 111), first_word(?t[6..]))
  print(t.len)
  !t.add("!")
  f = first_word(?t)
  print(f, t)
  !t.clear()
  print(t.len)

test "text views as strings", '''
  padded padded 13
  v none
  97
  98
  99
  lit lit
'''
  # A view of a Text lends its bytes where a String, or a `(?String)?`, is
  # expected, whether written `?t` or returned by a call; a slice of such a
  # view is a view without another `?`; `for b in ?t` walks its bytes;
  # and a part of a temporary is read through it, as by `get`.


  obj S
    t: String

    fun get(?self) -> ?String
      ?self.t

  obj E
    value: String

  fun find(e: ?E, ok: Bool) -> (?String)?
    if ok
      return ?e.value
    none

  fun n(p: ?String) -> Int
    text.trim(p).len + p[1..].len

  obj W
    s: List[?String]

  fun mkw() -> W
    s: List[?String] = List()
    !s.push("lit")
    W(s: <s)

  s = S(t: String(" padded "))
  print(text.trim(s.get()), text.trim(s.get()[1..]), n(s.get()))
  e = E(value: String("v"))
  print(find(?e, true) ?? "none", find(?e, false) ?? "none")
  t = String("ab")
  for b in ?t
    print(b)
  bx = ^String("c")
  for b in ?bx
    print(b)
  print(mkw().s.get(0), mkw().s[0])

fail "type args misuse", "19:7: cannot index a value of type `Int`", "20:7: an index is one value with no trailing comma; a list in brackets gives compile-time arguments", "21:5: generic type `Pair` expects 2 type arguments, got 1", "22:5: `Point` is not a generic type; it takes no type arguments", "23:7: `plain` takes no compile-time arguments; call it with `plain(...)`", "24:7: `scaled` expects 1 compile-time argument, got 2", "25:7: `scaled` takes 1 compile-time argument in brackets: `scaled[...](...)`", "26:10: `3` is not a type", "27:5: `Pair[Int, ?String]` is a type, not a value", "28:1: `scaled[2]` is a function with compile-time arguments; call it with `scaled[2](...)`"
  # Brackets after a name give compile-time arguments only to a generic
  # type or a function that declares them; anything else must be
  # indexable, and a type argument must be a type.

  obj Pair[T, U]
    a: T
    b: U

  obj Point
    x: Int

  fun plain(n: Int) -> Int
    n

  fun scaled[k: Int](n: Int) -> Int
    n * k

  n = 5
  print(n[0])
  print(n[Int, Int])
  p = Pair[Int](a: 1, b: 2)
  q = Point[Int](x: 1)
  print(plain[3](4))
  print(scaled[2, 3](4))
  print(scaled(4))
  b = Pair[3, Int](a: 1, b: 2)
  t = Pair[Int, ?String]
  scaled[2]

fail "type argument cascades", "12:5: type arguments go in brackets: `Wrap[Int](...)`", "13:5: type arguments go in brackets: `Cell[Int](...)`", "14:12: variant of generic enum `Option` needs its type", "16:10: `Int` is a type, not a value", "16:16: `xs[0]` has type `Int` and cannot be called"
  # A mistake with type arguments gets one diagnostic: the old parenthesized
  # form, brackets after an unresolved variant, a type used as an index,
  # and a call through an indexed value.

  obj Wrap[T]
    v: T

  enum Option[T]
    some(value: T)
    nothing

  b = Wrap(Int)(v: 1)
  c = Cell(Int)(value: 1)
  a = Option.some[Int](value: 3)
  xs = [1, 2]
  print(xs[Int], xs[0](1), b, c, a)

test "type names", '''
  Int
  Int
  I8
  I16
  I32
  I128
  U8
  U8
  U16
  U32
  U64
  U128
  Float
  F32
  Float
  Bool
  Void
  ?String
  String
  Endian
  Point
  Shape
  Mode
  Oops
  g.Point
  g.Fault
  g.Wrap[Point]
  Pair[Int, String]
  Ring[Int, 4]
  List[Int]
  *Cell[Bool]
  ^Point
  Signal[F32]
  List[List[I8]]
  Int?
  (Int?)?
  *Point
  ~Point
  *Point?
  [4]Int
  fun(Int, Bool) -> Int!
  sub(Int)
  sub()!
  *fun(Int, Bool) -> Int!
  *(Int?)
  (*fun(Int, Bool) -> Int!)?
  ~Point?
  Point Point Wrap[Int]
  Ring[Int, 2]
  1
  Int ?Int
  ?Point !Point []Int ![]Int ?fun(Int) -> Int ?Int Point
'''
  # `@name(T)` is the type's name as Rig writes it, the spelling the
  # diagnostics print: an alias is the type it names, another module's
  # type is qualified the way this module names that module, and a
  # generic type shows its arguments. Every built-in type and every shape
  # is named twice, where it is written and through a type parameter,
  # whose instance is named per instance, and the two must agree.

  use geo as g

  obj Point
    x: Int

  obj Pair[A, B]
    a: A
    b: B

  obj Ring[T, n: Int]
    items: [n]T

    fun name(?self) -> ?String
      @name(Self)

  enum Shape
    dot
    circle(r: Float)

  enum Mode
    on
    off

  error Oops
    bad

  obj Holder[T]
    v: T

    fun name(?self) -> ?String
      @name(T)

    fun view(?self) -> ?String
      @name(?T)

  type Byte = U8
  type Ints = []Int
  type Four = [4]Int
  type F = fun(Int, Bool) -> Int!
  type S = sub(Int)
  type SF = sub()!
  type OO = (Int?)?
  type RP = ?Point
  type WP = !Point
  type WI = ![]Int
  type CB = ?fun(Int) -> Int
  type HO = *(Int?)
  type HF = *F?

  fun name[T]() -> ?String
    @name(T)

  # Prints the name `@name` gives `T` where it is written, and checks
  # that the name a type parameter gets in a generic body agrees.
  sub show[T](direct: ?String)
    through = name[T]()
    print(direct if direct == through else "{direct} != {through}")

  sub main()
    show[Int](@name(Int))
    show[I64](@name(I64))
    show[I8](@name(I8))
    show[I16](@name(I16))
    show[I32](@name(I32))
    show[I128](@name(I128))
    show[U8](@name(U8))
    show[Byte](@name(Byte))
    show[U16](@name(U16))
    show[U32](@name(U32))
    show[U64](@name(U64))
    show[U128](@name(U128))
    show[Float](@name(Float))
    show[F32](@name(F32))
    show[F64](@name(F64))
    show[Bool](@name(Bool))
    show[Void](@name(Void))
    show[?String](@name(?String))
    show[String](@name(String))
    show[Endian](@name(Endian))
    show[Point](@name(Point))
    show[Shape](@name(Shape))
    show[Mode](@name(Mode))
    show[Oops](@name(Oops))
    show[g.Point](@name(g.Point))
    show[g.Fault](@name(g.Fault))
    show[g.Wrap[Point]](@name(g.Wrap[Point]))
    show[Pair[Int, String]](@name(Pair[Int, String]))
    show[Ring[Int, 4]](@name(Ring[Int, 4]))
    show[List[Int]](@name(List[Int]))
    show[*Cell[Bool]](@name(*Cell[Bool]))
    show[^Point](@name(^Point))
    show[Signal[F32]](@name(Signal[F32]))
    show[List[List[I8]]](@name(List[List[I8]]))
    show[Int?](@name(Int?))
    show[OO](@name(OO))
    show[*Point](@name(*Point))
    show[~Point](@name(~Point))
    show[*Point?](@name(*Point?))
    show[Four](@name(Four))
    show[F](@name(F))
    show[S](@name(S))
    show[SF](@name(SF))
    show[*F](@name(*F))
    show[HO](@name(HO))
    show[HF](@name(HF))
    show[~Point?](@name(~Point?))
    # `geo` names its own types bare; the root module's are bare too.
    print(g.name[g.Point](), g.name[Point](), g.name[g.Wrap[Int]]())
    r: Ring[Int, 2] = Ring(items: [1, 2])
    print(r.name())
    p = Point(x: 1)
    print(p.x)
    h: Holder[Int] = Holder(v: 1)
    print(h.name(), h.view())
    # A type parameter's instance holds no view or slice.
    print(@name(RP), @name(WP), @name(Ints), @name(WI), @name(CB), @name(?Int), @name(@type(p)))

  file "geo.rig"
    # A module whose types `main` names as `g.Point`, and whose generic
    # function names a type as `geo` writes it.

    pub obj Point
      pub x: Int

    pub obj Wrap[T]
      pub v: T

    pub error Fault
      bent

    pub fun name[T]() -> ?String
      @name(T)

