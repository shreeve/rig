test "string ordering", '''
  true false true false
  true true true true false
  true true true
  true false
  b pear 3
  apple fig
  true false
'''
  # `<`, `<=`, `>`, and `>=` order Strings and `[]U8` slices by their bytes:
  # the first byte that differs decides, and a prefix sorts first. A
  # generic body orders a `T` that is a String the same way.

  fun max[T](a: T, b: T) -> T
    a if a > b else b

  fun min_of[T](xs: []T) -> T
    best = xs[0]
    for x in xs
      if x < best
        best = x
    best

  print("abc" < "abd", "abd" < "abc", "abc" <= "abc", "abc" >= "abd")
  print("ab" < "abc", "abc" > "ab", "" < "a", "" <= "", "" > "")
  print("Z" < "a", "é" > "z", "a" < "é")
  s = "hello"
  t = "help"
  print(s < t, s > t)
  print(max("a", "b"), max("pear", "apple"), max(3, 2))
  words = ["pear", "fig", "apple", "fiddle"]
  print(min_of(?words[0..4]), min_of(?words[0..2]))
  bytes: [3]U8 = [1, 2, 3]
  more: [4]U8 = [1, 2, 3, 0]
  print(?bytes[0..3] < ?more[0..4], ?more[0..2] > ?bytes[0..3])

test "string owned and view", '''
  hi! 3 3
  hi! there hi! hi
'''
  # A `String` owns its text and a `?String` views it. Names say what a
  # value is and sigils say how it is held: `?s` lends a `String` as a
  # `?String`, `!s` lends it to write, and `+s` of a `?String` copies it
  # into a new `String`.

  fun length(s: ?String) -> Int
    s.len

  sub shout(s: !String)
    !s.add("!")

  fun copy_of(s: ?String) -> String
    +s

  s = String("hi")
  shout(!s)
  print(s, length(?s), length("lit"))
  t = copy_of(?s)
  !t.add(" there")
  v: ?String = ?t[..2]
  print(t, s, v)

fail "string owner expected", "9:12: type mismatch: expected `String`, got `Static`; a `String` owns its text: write `String(\"x\")` to copy it, or declare the place `?String` to only read it", "10:12: type mismatch: expected `String`, got `?String`; a `String` owns its text: write `String(?t)` to copy it", "11:13: type mismatch: expected `String`, got `Static`; a `String` owns its text: write `String(\"lit\")` to copy it"
  # A `String` owns its text, so a place that expects one is not given a
  # literal or a read view: the hint is a copy, `String(...)`, or a place
  # that only reads, `?String`.

  fun size(s: String) -> Int
    s.len

  t = String("a")
  print(size("x"))
  print(size(?t))
  x: String = "lit"

fail "string place not lent to write", "12:7: cannot lend `a` to write: it holds a read view of text, `?String`", "12:11: cannot lend `b` to write", "14:16: cannot lend `p.left` to write", "17:18: cannot lend `names[0]` to write", "20:6: cannot lend `v` to write", "21:7: cannot lend `a` to write", errors: 6
  # A `?String` is a read view of text, and nothing lends a view's own slot
  # to write: `swap`, `replace`, and `!` on a place that holds one are
  # rejected, as for any read view. Assign to it to point it at other
  # text, or hold a `String` to change the text in place.

  obj Pair
    left: ?String
    right: ?String

  a: ?String = "x"
  b: ?String = "y"
  swap(!a, !b)
  p = Pair(left: "l", right: "r")
  old = replace(!p.left, "z")
  names: List[?String] = List()
  !names.push("n")
  first = replace(!names[0], "m")
  t = String("t")
  v = ?t
  w = !v
  f = |!a| a = "q"
  f()

