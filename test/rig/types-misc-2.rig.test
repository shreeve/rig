fail "static never where written", "12:8: cannot lend `loose` to write: it holds a read view of text, `?String`", "13:15: cannot lend `loose` to write", "14:23: type mismatch: expected `Static`, got `?String`", "15:9: type mismatch: expected `Static`, got `?String`; `fixed` is a `Static`, bound to a literal's text, and a `?String` may view a `String`: declare it `fixed: ?String = ...` to hold other text", errors: 4
  # A `Static` is read as a `?String`, never where the text can be written:
  # a `?String` view cannot be written into a `Static` place, and a `?String`
  # place, which nothing lends to write, is no `!Static`.

  sub reset(w: !Static)
    w = "reset"

  t = String("abcdefghijklmnop")
  view: ?String = ?t[..]
  fixed = "fixed"
  loose: ?String = "loose"
  reset(!loose)
  swap(!fixed, !loose)
  old = replace(!fixed, view)
  fixed = view
  print(fixed, loose, old)

test "static reads as string", release: true, '''
  3 4 lit
  from
  from
  ["lit", "from", "end"] 3
  a true
  lit q b
  none none from
  default true false false false
  from true
  Static ?String ?String
  it padded true 1
'''
  # A `Static` is read as a `?String` where the text is only read: an
  # argument, a field, a return, a branch, `??`, a list literal, a slice
  # of elements, a generic `T` that a `?String` binds too, and a
  # comparison. The result of mixing the two is a `?String`.


  obj Line
    text: ?String

  fun shout(s: ?String) -> Int
    s.len

  fun first_of(xs: []?String) -> ?String
    xs[0]

  fun pick[T](a: T, b: T, left: Bool) -> T
    a if left else b

  fun type_name[T]() -> ?String
    @name(T)

  fun fallback(s: (?String)?) -> ?String
    s ?? "none"

  lit = "lit"
  t = String("from text")
  view: ?String = ?t[..4]

  print(shout(lit), shout("four"), Line(text: lit).text)

  chosen = view if t.len > 3 else "other"
  print(chosen)
  other = "x" if t.len > 99 else view
  print(other)

  both = [lit, view, "end"]
  print(both, both.len)
  words = ["a", "b"]
  print(first_of(?words[..]), first_of(os.args()) != "")

  print(pick(lit, view, true), pick(view, "q", false), pick("a", "b", false))

  maybe: Static? = none
  print(fallback(maybe), fallback(os.env("RIG_STATIC_SURELY_UNSET")), fallback(view))
  print(maybe ?? "default", view == "from", lit == view, "lit" < view, view >= lit)
  mixed = maybe ?? view
  print(mixed, (maybe ?? "same") == "same")

  print(@name(Static), type_name[Static](), type_name[?String]())
  part = lit[1..]
  sub_text = text.trim("  padded  ")
  print(part, sub_text, text.contains(lit, "i"), text.find(part, "t") ?? -1)

fail "string byte and len write", "11:1: cannot assign to a byte of a `?String`; a `?String` is read-only", "12:7: cannot lend a byte of a `?String` to write; a `?String` is read-only", "13:3: cannot assign to `.len`; a length is read-only", "14:8: cannot lend `.len` to write; a length is read-only", "15:3: cannot assign to `.len`; a length is read-only"
  # A String's bytes and every `.len` are read-only.

  sub inc(n: !Int)
    n += 1

  sub bump(b: !U8)
    b += 1

  s = "abc"
  a = [1, 2, 3]
  s[0] = 65
  bump(!s[1])
  a.len = 5
  inc(!a.len)
  s.len += 1
  print(s)

