test "symbol basics", '''
  12 6 0 :rect
  true none
  2 :done done 4
  :triangle :none
  help
  keyword :if :type :match
  [:a, :b] 2
'''
  # A symbol `:name` is a value of the builtin type `Symbol`: equal to
  # the same name, matched with a required `_`, printed as written, its
  # name a `Static` (`s.text`), and found by name with
  # `Symbol.from_text(word)`, which allocates nothing and gives `none` for
  # a name the program never writes.

  fun area(shape: Symbol, w: Int, h: Int) -> Int
    match shape
      :rect => w * h
      :triangle => w * h / 2
      _ => 0

  fun next(s: Symbol) -> Symbol
    match s
      :start => :middle
      :middle => :done
      _ => :done

  print(area(:rect, 3, 4), area(:triangle, 3, 4), area(:circle, 3, 4), :rect)
  print(Symbol.from_text("rect") == :rect, Symbol.from_text("hexagon"))
  s = :start
  steps = 0
  while s != :done : s = next(s)
    steps += 1
  print(steps, s, s.text, s.text.len)
  word = String("triangle")
  print(Symbol.from_text(?word) ?? :none, Symbol.from_text("") ?? :none)
  match Symbol.from_text("help") ?? :unknown
    :help, :usage => print("help")
    _ => print("unknown")
  k: Symbol = :if
  match k
    :if if false => print("never")
    :if, :else => print("keyword", k, :type, :match)
    _ => print("other")
  print([:a, :b], [k, :c].len)

fail "symbol match rules", "6:7: `match` on a `Symbol` is not exhaustive without `_ =>`", "11:7: duplicate arm for symbol `:a`", errors: 2
  # A `match` on a `Symbol` needs `_ =>`: its values are every symbol the
  # whole program writes, so no set of arms covers them. Two arms for one
  # symbol are rejected, as two for one integer are.

  t = :a
  match t
    :a => print(1)
    :b => print(2)
  match t
    :a => print(1)
    :b, :a => print(2)
    _ => print(3)

test "symbol no literals", "none true"
  # A program that writes no symbol still has the type `Symbol`, with no
  # values: `Symbol.from_text(word)` finds none.

  fun find(w: ?String) -> Symbol?
    Symbol.from_text(w)

  w = String("width")
  s = find(?w)
  print(s, s == none)

test "symbol plain", '''
  :one :bumped :one one lit x
  :boxed :shared
  :one
  :x x
  :y y
  :other
  :some :some
  5 4 0 2
  1 true false
  true false
'''
  # A symbol is plain data, as an `Int` is: a bare use copies it, a view
  # reads or writes it in place, and it is boxed, shared, held optional,
  # and kept in a List, a Map (keyed on its id), and a Set like any
  # plain value. Its name, `.text`, is a `Static`, which keeps no loan.


  sub bump(s: !Symbol)
    s = :bumped

  fun look(s: ?Symbol) -> Static
    s.text

  fun name_of(s: Symbol) -> Static
    t = s
    t.text

  a = :one
  b = a
  c = +a
  !bump(!b)
  print(a, b, c, look(?a), look(?:lit), name_of(:x))
  bx = ^:boxed
  sh = *:shared
  print(bx, sh)
  d = <a
  print(d)
  xs = List[Symbol]()
  !xs.push(:x)
  !xs.push(:y)
  for s in xs
    print(s, s.text)
  o: Symbol? = none
  print(o ?? :other)
  o = :some
  print(o, o ?? :other)
  m = hash.Map[Symbol, Int]()
  !m.put(:width, 3)
  !m.put(:height, 4)
  !m.put(:width, 5)
  print(m.get(:width) ?? 0, m.get(:height) ?? 0, m.get(:depth) ?? 0, m.len)
  set = hash.Set[Symbol]()
  !set.add(:a)
  !set.add(:a)
  print(set.len, set.has(:a), set.has(:b))
  w = :width
  print(w.hash() == (:width).hash(), w.hash() == (:height).hash())

fail "symbol reserved name", "4:5: `Symbol` is a reserved built-in nominal name and cannot be redefined"
  # `Symbol` is a builtin type, as `String` and `Static` are, so no module
  # declares a type of that name.

  obj Symbol
    x: Int

  print(Symbol(x: 1).x)

fail "symbol rules", "6:14: `.width` is an enum variant, and a `Symbol` is expected; a symbol is written `:width`", "8:10: operator `<` is not defined for `Symbol`: a symbol has no order; compare with `==` and `!=`", "8:18: operator `>=` is not defined for `Symbol`", "9:11: `U32(x)` converts a number; `x` has type `Symbol`", "9:22: `Symbol` has no function `from_int`; its one function is `Symbol.from_text(word)`", "10:3: cannot assign to `.text`; a symbol's name is read-only", "11:9: a `Symbol` has no field `name`; its one member is its name, `.text`", "11:21: `.a` is an enum variant, and a `Symbol` is expected; a symbol is written `:a`", errors: 8
  # A symbol has one spelling, `:name`, and no order: `.width` where a
  # `Symbol` is expected is an enum variant, `<` is not defined, and a
  # symbol's id stays inside the compiler (no `U32(s)`, no
  # `Symbol.from_int`). Its one member is `.text`, which is read-only.

  s: Symbol = .width
  t = :a
  print(s, t < :b, t >= :a)
  print(U32(t), Symbol.from_int(0))
  t.text = "x"
  print(t.name, t == .a)

