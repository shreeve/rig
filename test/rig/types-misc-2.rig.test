  # A name that is not found is reported with what it was likely meant as:
  # another language's spelling of a Rig one, or a visible name, type,
  # field, or method it is a typo of (one edit for a short name, two for
  # a longer one).

  obj Point
    x: Int
    width: Int

    fun area(?self) -> Int
