test "view and string branches", '''
  false true false
  true 2
  1
  true true
  3 1 3
  S(t: "aa") aa bb
'''
  # A view compared with `==`, whether a call returns it or a branch
  # picks it, owns nothing, so it is read where it stands and nothing is
  # dropped. A String chosen by a branch is one slice type, whether it is
  # a literal or a view.


  obj S
    t: String

    fun get(?self) -> ?String
      ?self.t

  fun pick(a: ?String, ok: Bool) -> (?String)?
    a if ok else none

  fun g(a: ?String) -> Int?
    print(pick(a, true)? == "aa", pick(a, true)?.len)
    1

  fun either(a: ?String, b: ?String, c: Bool) -> Bool
    (a if c else b) == "bb"

  fun f(s: ?String, c: Bool) -> Int
    ("b" if c else s).len

  fun mkt() -> String
    String("made")

  s = S(t: String("aa"))
  print(s.get() == "x", s.get() == s.get(), mkt() == s.get())
  print(g(?s.t))
  a = String("aa")
  b = String("bb")
  c = false
  print((?a if c else ?b) == "bb", either(?a, ?b, c))
  print(f("abc", false), f("abc", true), ("b" if c else text.trim(" abc ")).len)
  print(s, a, b)

test "view lifted to optional", '''
  5
  5 5 5
  5
  7
  4
  1
  5
  5
'''
  # A view held by pointer lifted into an optional of that view stays the
  # pointer: bound, assigned, passed, stored in a field, and returned.

  obj Counter
    hits: Int
    name: String

  obj P
    x: Int

  obj H
    o: (?Counter)?

  enum E
    a(c: Counter, n: Int)
    b

  fun show(o: (?Counter)?) -> Int
    if o as s
      return s.hits
    0

  fun deep(r: ?Counter) -> ((?Counter)?)?
    r

  fun pick(r: ?Counter) -> (?Counter)?
    r

  a = Counter(hits: 5, name: String("c"))
  r = ?a
  saved: (?Counter)? = none
  saved = r
  if saved as s
    print(s.hits)
  decl: (?Counter)? = r
  print(show(decl), show(r), show(pick(r)))
  h = H(o: r)
  h.o = r
  print(show(h.o))
  arr = [Counter(hits: 0, name: String("c")), Counter(hits: 7, name: String("c"))]
  print(show(?arr[1]))
  e = E.a(c: Counter(hits: 4, name: String("c")), n: 1)
  match !e
    .a(c, _) => print(show(c))
    .b => pass
  p = P(x: 1)
  pr = ?p
  ps: (?P)? = none
  ps = pr
  if ps as q
    print(q.x)
  nested: ((?Counter)?)? = r
  nested = r
  if nested as n1
    if n1 as n2
      print(n2.hits)
  if deep(r) as d1
    if d1 as d2
      print(d2.hits)

