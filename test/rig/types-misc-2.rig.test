test "temporary resource operand", '''
  1
  drop 1
  next
'''
  # A temporary that owns a resource, read as an operand (here the value
  # whose field is read), is dropped when its statement ends.

  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  fun mk(n: Int) -> B
    B(n: n)

  print(mk(1).n)
  print("next")

test "temporary resource print", '''
  B(n: 1)
  drop 1
  next
'''
  # A temporary that owns a resource and is only read, as a `print`
  # argument is, is dropped when its statement ends.

  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  fun mk(n: Int) -> B
    B(n: n)

  print(mk(1))
  print("next")

test "text build", '''
  0 true
  n=42 f=2.5 b=true u=200 i=-170141183460469231731687303715884105728
  n=42 f=2.5 b=true u=200 i=-170141183460469231731687303715884105728 nan=nan one=1.0 tiny=0.30000000000000004
  Point(x: 1, y: 2.0) User(name: "ada", age: 36) .circle(r: 1.5) .dot none [1, 2] [1, 2] ["a", "b"] c
  99
  5000 0123456789
'''
  # `String(...)` and `!t.add(...)` write each value as `print` writes it at
  # the top level, with no separators: Strings bare, numbers and floats as
  # `print` shows them, and structs, enums, optionals, arrays, and Vecs
  # with Strings quoted inside them.

  obj Point
    x: Int
    y: Float

  obj User
    name: ?String
    age: Int

  enum Shape
    circle(r: Float)
    dot

  e = String()
  print(e.len, e == "")
  t = String("n=", 42, " f=", 2.5, " b=", true, " u=", U8(200), " i=", I128.min)
  print(t)
  !t.add(" nan=", 0.0 / 0.0, " one=", 1.0, " tiny=", 0.1 + 0.2)
  print(t)
  o: Int? = none
  s = Shape.circle(r: 1.5)
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  u = String(Point(x: 1, y: 2.0), " ", User(name: "ada", age: 36), " ", s, " ", Shape.dot)
  !u.add(" ", o, " ", [1, 2], " ", v, " ", ["a", "b"], " ", 'c')
  print(u)
  print(u.len)
  big = String()
  for i in 0..5000
    !big.add(i % 10)
  print(big.len, big[4990..])

fail "text forms", "5:5: a slice of a String views it; write `?t[0..1]`", "6:6: cannot lend a slice of a String to write", "7:3: cannot assign to `.len`; a length is read-only", "8:3: method `add` needs its receiver lent to write; write `!t.add(\"x\")`", "9:12: `String(...)` takes no keyword arguments", "10:4: has no method `pop`"
  # A Text is changed only through its `!` methods, and viewed only
  # through a visible `?` view.

  t = String("abc")
  a = t[0..1]
  b = !t[..]
  t.len = 2
  t.add("x")
  u = String(first: "x")
  !t.pop()
  print(a, b, u)

test "text friction", '''
  opt1 ok1 4
  1 none
  hi 65
  one  o
  two tw
  oxed true
  3 1 3 2 true true
  1 20 30
  drop 30
  end
  drop 20
  drop 1
'''
  # `!t.push(b)` appends one byte, while `!t.add(b)` writes a `U8` as a
  # number. A `^String` is viewed through its box. A plain element of an
  # owning temporary is read where it stands, and `??` on an owning
  # optional temporary gives its value or the fallback.


  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  fun maybe(k: Int) -> N?
    N(id: k) if k > 0 else none

  obj W
    v: List[Int]
    t: String

  fun mkw() -> W
    W(v: mkv(), t: String("wt"))

  fun mkv() -> List[Int]
    v: List[Int] = List()
    !v.push(3)
    v

  fun mko(k: Int) -> String?
    String("opt", k) if k > 0 else none

  fun mkf(k: Int) -> String!
    String("ok", k)

  fun fresh(k: Int) -> Int?!
    print(mko(k)?, mkf(k)!, mko(k)?.len)
    k

  print(fresh(1) catch 0, fresh(0) catch 0)
  t = String()
  for b in "Hi"
    !t.push(text.to_lower(b))
  !t.add(" ", U8(65))
  print(t)
  texts: List[^String] = List()
  !texts.push(^String(" one "))
  !texts.push(^String("two"))
  for b in ?texts
    print(text.trim(?b), b[..2])
  bx = ^String("boxed")
  print(bx[1..], text.starts_with(?bx, "box"))
  print(mkv()[0], mkv().len, mkw().v[0], mkw().t.len, ?bx == "boxed", bx == String("boxed"))
  a = maybe(1) ?? N(id: 10)
  c = maybe(0) ?? N(id: 20)
  print(a.id, c.id, (maybe(0) ?? N(id: 30)).id)
  print("end")

fail "text hints", "8:7: cannot index a value of type `String`; index its `?String` view: `(?t[..])[i]`", "9:3: `!t` here is read, not held: `f` only reads `t`; write `f(?t)`", errors: 2
  # A Text is indexed through its String view, and lent as a String to
  # read with `?t`: a written `!t` there only reads.

  sub f(s: ?String)
    print(s)

  t = String("abc")
  print(t[0])
  f(!t)

