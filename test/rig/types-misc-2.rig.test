test "shadow reads previous binding", "11"
  # In `new x = x + 10` the right side reads the previous `x`.

  x = 1
  new x = x + 10
  print(x)

test "shadow reassign after fixed", "3"
  # `x =! 1` is fixed, but `new x = 2` introduces a fresh mutable `x`;
  # name lookup finds the newest binding, so `x = 3` reassigns it.

  x =! 1
  new x = x + 1
  x = 3
  print(x)

fail "share of none", "17:3: `*none` makes a handle of nothing; write `none` where a `(*T)?` is expected", "19:5: `*none` makes a handle of nothing", "20:14: `*none` makes a handle of nothing", "21:3: `*none` makes a handle of nothing", "22:10: `*none` makes a handle of nothing", "23:8: `*none` makes a handle of nothing", "23:15: `*none` makes a handle of nothing", "25:9: `*none` makes a handle of nothing", "26:6: `*none` makes a handle of nothing", errors: 9
  # `*none` would make a shared handle of nothing: an optional handle
  # with no value is `none` itself, where a `(*T)?` is expected. Every
  # position is rejected: a binding, a typed binding, an argument, a
  # field, a return, an array element, a List element, and `~*none`. (`none`
  # itself, and a box of an optional, compile: test/behavior/types/
  # optional_handle_none.rig. Where a handle of an optional, `*(T?)`, is
  # expected, `*none` is that handle holding `none`:
  # test/behavior/types/optional_handle_binding.rig.)

  obj S
    h: (*Int)?

  sub f(h: (*Int)?)
    print(h == none)

  fun g() -> (*Int)?
    *none

  a = *none
  b: (*Int)? = *none
  f(*none)
  s = S(h: *none)
  print([*none, *none].len)
  w: List[(*Int)?] = List()
  !w.push(*none)
  k = ~*none
  print(g() == none)

fail "share shared binding", "already a shared handle `*Noisy`"
  # `*x` where `x` is already a shared handle is rejected; `+x` makes
  # another handle to the same value.

  obj Noisy
    id: Int

  inner = *Noisy(id: 4)
  outer = *inner
  print(outer.id)

test "shared literal defaults", "5"
  # `*5` holds an `Int`, like `x = 5`.

  sub take(p: *Int)
    print(p)

  x = *5
  take(<x)

fail "shared of shared type", "8:8: `**Noisy` stacks one heap holding on another"
  # A shared handle cannot itself be shared: `*(*T)` adds a second
  # refcount for nothing. Clone the handle with `+x` instead.

  obj Noisy
    id: Int

  inner = *Noisy(id: 4)
  outer: *(*Noisy) = *(<inner)
  print("wrapped")

fail "shared of shared value", "already a shared handle"
  # Sharing a value that is already a shared handle is rejected, like the
  # `*(*T)` type: use `+x` to get another handle.

  obj Noisy
    id: Int

  inner = *Noisy(id: 4)
  outer = *(<inner)
  print(outer.id)

test "shift amount any integer", '''
  12 16 20 4
  20
'''
  # A shift amount may be any integer type; the result has the type of the
  # shifted value.

  fun sh(a: U8, n: Int) -> U8
    a << n

  fun back(a: Int, n: U8) -> Int
    a >> n

  n: U8 = 2
  x: I32 = 5
  print(sh(3, 2), back(64, n), x << n, 1 << n)
  x <<= n
  print(x)

