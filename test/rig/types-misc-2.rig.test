test "static array as slice", '''
  2 a
  2 a
  3 x
  1 q
  2 a
'''
  # An array or a List of `Static` lends to read as a `[]?String`, as an
  # array of `Int` lends as a `[]Int`: a bare name, `?name`, a temporary
  # array, and a List.
  sub show(xs: []?String)
    print(xs.len, xs[0])

  a: [2]Static = ["a", "b"]
  show(a)
  show(?a)
  show(["x", "y", "z"])
  l = List[Static]()
  !l.push("q")
  show(l)
  show(?a[..])

fail "static array as write slice", "7:6: type mismatch: expected `![]?String`, got `![2]Static`"
  # The elements of a `Static` array are read as `?String`s, never
  # written as them: a write lend holds exactly its element type.
  sub fill(xs: ![]?String)
    pass

  a: [2]Static = ["a", "b"]
  fill(!a)

test "static in holders", release: true, '''
  idle
  busy
  again
  signal go
  go
  hello 1
  hello 2
  2 3
  tag 7
  second 2
  p q
  none
  some
  der true
'''
  # A `Static` is text that lives for the whole program: a literal, or
  # text derived only from literals. It is plain data that carries no
  # loan, so it goes where no loan is tracked: in a `Cell`, a `Signal`, an
  # owned closure, and in a struct field or a generic `T` stored there.

  obj Tag
    name: Static
    n: Int

  obj Pair[T]
    a: T
    b: T

  sub remember(c: !Cell[Static], s: Static)
    !c.set(s)

  sub keep[T](c: !Cell[T], v: T)
    !c.set(v)

  fun greeter(who: Static) -> *fun(Int) -> Int
    *|+who, n: Int|
      print(who, n)
      n + 1

  fun greeter_of(t: Tag) -> *sub()
    *|+t| print(t.name, t.n)

  c = *Cell("idle")
  print(c.get())
  remember(!c, "busy")
  print(c.get())
  keep(!c, "again")
  print(c.get())

  sig = *Signal("start")
  !sig.subscribe(*|~sig|
    if *sig as s
      print("signal", s.get())
  )
  !sig.set("go")
  print(sig.get())

  f = greeter("hello")
  print(f(1), f(2))
  g = greeter_of(Tag(name: "tag", n: 7))
  g()

  tags: *Cell[Tag] = *Cell(Tag(name: "first", n: 1))
  !tags.set(Tag(name: "second", n: 2))
  print(tags.get().name, tags.get().n)

  pairs: *Cell[Pair[Static]] = *Cell(Pair(a: "x", b: "y"))
  !pairs.set(Pair(a: "p", b: "q"))
  print(pairs.get().a, pairs.get().b)

  opt: *Cell[Static?] = *Cell(none)
  print(opt.get())
  !opt.set("some")
  print(opt.get())

  name = "derived"
  !c.set(name)
  !c.set(name[..3])
  print(c.get(), c.get() == "der")

fail "static join is string", "8:13: type mismatch: expected `Static`, got `?String`", "9:13: type mismatch: expected `Static`, got `?String`", "10:17: type mismatch: expected `Static`, got `?String`", "11:35: type mismatch: expected `Static`, got `?String`", errors: 4
  # A branch, `??`, or list literal that mixes a `Static` with a `?String`
  # has the type `?String`: the `Static` is read there, and nothing makes the
  # `?String` a `Static`.

  t = String("abcdef")
  v: ?String = ?t[..]
  q: Static? = none
  a: Static = v if t.len > 1 else "a"
  b: Static = q ?? v
  c: [2]Static = [v, "a"]
  d: Static = "a" if t.len > 1 else v
  print(a, b, c, d)

