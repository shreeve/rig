test "weak upgrade clone and drop", '''
  n alive
  1
'''
  # The `*T?` from `upgrade()` is an owning handle: `+m` clones it, `<m`
  # drops it, and the clone keeps the value alive until it goes.

  obj Noisy
    id: Int

    drop(!self)
      print(self.id)

  rc = *Noisy(id: 1)
  w = ~rc
  m = *w
  n = +m
  <rc
  <m
  print("n alive")
  <w
  # scope exit drops `n`, the last strong handle: prints 1

fail "weak upgrade forms", "12:8: `*w?` is `*(w?)`, and `w` is a weak handle, not an optional: to return `none` once its value is gone, write `(*w)?`", "17:5: `*` only reads the weak handle it upgrades: write `*w`", "22:6: cannot lend `w if c else w2`: it may be `w`, a value a name holds, which lending the branching value would copy; lend each branch: `*(?w if c else ?w2)`", errors: 3
  # `*w` only reads the weak handle it upgrades, so a write lend there is
  # rejected. A suffix binds tighter than `*`: `*w?` is `*(w?)`, which
  # propagates `none` out of the weak handle itself; the hint gives
  # `(*w)?`, which returns `none` once the value is gone. A branching
  # value that may be a name's handle is lent branch by branch, as a
  # receiver is.

  obj Node
    id: Int

  fun id_of(w: ?~Node) -> Int?
    n = *w?
    n.id

  rc = *Node(id: 1)
  w = ~rc
  if *!w as p
    print(p.id)
  print(id_of(?w) ?? 0)
  w2 = ~rc
  c = true
  if *(w if c else w2) as p
    print(p.id)

fail "weak upgrade method", "10:6: a weak handle upgrades with `*w`, not a method: `if *w as s`", "12:10: a weak handle upgrades with `*w`, not a method: `if *w as s`", "13:7: a weak handle upgrades with `*w`, not a method: `if *w as s`", errors: 3
  # A weak handle upgrades with `*w`, a sigil, not a method: `w.upgrade()`
  # is rejected with the form to write, whatever lends the handle and
  # whatever it is given.

  obj User
    name: ?String

  rc = *User(name: "x")
  w = ~rc
  if w.upgrade() as u
    print(u.name)
  m = (?w).upgrade()
  n = w.upgrade(42)

