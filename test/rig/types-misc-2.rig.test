  # would be compared as a float, silently `3.0`: it is rejected.

  print(7 / 2 == 3.5, 3.5 != 7 / 2, 7 / 2 < 3.5, 1 / 2 > 0.1)

fail "whole division float", "9:12: `7 / 2` divides whole numbers (3); for 3.5 write `7.0 / 2`", "10:5: `7 / 2` divides whole numbers (3); for 3.5 write `7.0 / 2`", "11:14: `9 % 4` is a whole-number remainder; write `9.0 % 4` for a Float", "12:10: `1 / 3` divides whole numbers (0); for 0.3333333333333333 write `1.0 / 3`", "14:24: `5 / 2` divides whole numbers (2); for 2.5 write `5.0 / 2`"
  # Dividing whole-number literals is integer division: a literal's
  # context does not reach through `/` or `%`, so where a float is
  # expected, `7 / 2` would silently be 3.0. It is rejected, with the
  # float spelling.

  fun half(x: Float) -> Float
    x / 2

  a: Float = 7 / 2
  b = 7 / 2 + 1.5
  c: F32 = 1 + 9 % 4
  d = half(1 / 3)
  x = 2.0
  print(a, b, c, d, x * (5 / 2))

test "wrapping arithmetic", '''
  4 251 244
  -128 127 1
  -9223372036854775808
  0 true
  170141183460469231731687303715884105727
  65532
  14695981039346656037 12638187200555641996 9948945366585317705
  44 256
'''
  # `+%`, `-%`, and `*%` wrap around on overflow, in two's complement, for
  # any integer type; `+%=`, `-%=`, and `*%=` assign the wrapped result.

  fun fnv1a(s: ?String) -> U64
    h: U64 = 14695981039346656037
    for b in s
      h ^= U64(b)
      h *%= 1099511628211
    h

  a: U8 = 250
  print(a +% 10, a -% 255, a *% 2)
  i: I8 = 127
  print(i +% 1, I8(-128) -% 1, i *% i)
  n = 9223372036854775807
  print(n +% 1)
  m: U128 = 340282366920938463463374607431768211455
  print(m +% 1, U128(0) -% 1 == m)
  k: I128 = -170141183460469231731687303715884105728
  print(k -% 1)
  c: U16 = 65535
  c +%= 2
  c -%= 5
  print(c)
  print(fnv1a(""), fnv1a("a"), fnv1a("rig"))
  # Constants wrap as the program does.
  print(U8(200) +% 100, 255 +% 1)

fail "wrapping float", "4:5: operator `+%` requires integer operands", "5:1: `*%=` requires an integer target", "7:18: integer value `300` does not fit in `U8`"
  # Wrapping arithmetic is for integers: a Float never wraps.

  x = 1.5
  y = x +% 2.0
  x *%= 2.0
  z: U8 = 7
  print(y, x, z +% 300)

test "wrapping nested", '''
  18446744073709551617 18446744073709551616 9223372036854775809
  22 10
  3 3 255
'''
  # Wrapping arithmetic on literals takes the type its context gives the
  # whole expression, however deep it sits in other arithmetic, and wraps
  # in that type.

  a: U128 = 1 + (4294967296 *% 4294967296)
  b: U128 = 4294967296 *% 4294967296
  c: I128 = 1 + (9223372036854775807 +% 1)
  print(a, b, c)
  v: U8 = 5
  d: U8 = (200 +% 100) / 2
  e: U8 = v + (1 + (250 +% 10))
  print(d, e)
  x: I8 = (-128 | 2) -% 127
  y: I8 = -126 -% (127 | 0)
  z: U8 = (1 | 2) -% (4 ^ 0)
  print(x, y, z)

bomb "zero len index fill", "index out of bounds"
  # An index into a `[0 of x]` fill panics when the program runs.

  fun at(i: Int) -> Int
    [0 of 7][i]

  i = 0
  for j in 0..1
    i += j
  print(at(i))

bomb "zero len index read", "index out of bounds", prints: "0 [] [] []"
  # An array of length 0 can be sliced, looped over, and written through
  # a loop; an index into it, which can only be out of range, panics when
  # the program runs.

  Z = 0

  fun zeros[n: Int]() -> [n]Int
    [n of 0]

  fun at(xs: [0]Int, i: Int) -> Int
    xs[i]

  sub main()
    i = 0
    for j in 0..1
      i += j
    a: [Z]Int = []
    for x in !a
      x += 1
    for x in a
      print(x)
    b = zeros[0]()
    print(a.len, b, a[i..i], b[0..i])
    print(at(a, i))

bomb "zero len index write", "index out of bounds", prints: "[]"
  # A write into a field of length 0 panics when the program runs, both
  # through `!self` and through a generic type's instance.

  obj Ring[T, n: Int]
    items: [n]T

  obj S
    xs: [0]Int

    sub put(!self, i: Int)
      self.xs[i] = 1

  i = 0
  for j in 0..1
    i += j
  r = Ring[Int, 0](items: [])
  if i > 0
    r.items[i] = 3
  print(r.items)
  s = S(xs: [])
  !s.put(i)
  print(s.xs)
