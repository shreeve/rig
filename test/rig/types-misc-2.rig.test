test "text lent as string", "5 3 1 2 3"
  # A Text is lent where a String is expected: `?t` means `?t[..]`, a
  # view of one lends it as is, and a bare Text argument is lent to read
  # as `?t` would be.

  fun n(s: ?String) -> Int
    s.len

  fun a(p: ?String) -> Int
    n(?p) + n(?p[1..])

  fun b(p: ?String) -> Int
    n(p)

  t = String("abc")
  print(a(?t), n(t), n(?String("x")), n(String("yz")), b(t))

