test "value size limit", '''
  10 1048576
  2 1048576
  3 1572864
'''
  # A value may take up to 8 MiB, and a function may keep up to 13 MiB of
  # values on its stack: an array local, a struct, and a module constant
  # at the limit all run, and so does a function keeping 12 MiB.

  BIG = [1048576 of 7]
  HALF = [524288 of 1]

  obj Frame
    a: [524288]Int
    b: [524288]Int

  sub array_local(i: Int)
    a = [1048576 of 3]
    a[i] += BIG[i]
    print(a[i], a.len)

  sub struct_local(i: Int)
    f = Frame(a: HALF, b: HALF)
    f.b[i] += f.a[i]
    print(f.b[i], f.a.len + f.b.len)

  sub two_locals(i: Int)
    a = [786432 of 1]
    b = [786432 of 2]
    b[i] += a[i]
    print(b[i], a.len + b.len)

  sub main()
    array_local(5)
    struct_local(1048575 - 524288)
    two_locals(786431)

test "variant keyword construction", '''
  12 6 .rect(w: 2, h: 3)
  7
'''
  # A payload variant is constructed with keyword fields, in any order,
  # through an enum literal or the enum's name; a pattern binds the fields
  # in declaration order.

  enum Shape
    circle(radius: Int)
    rect(w: Int, h: Int)

  enum Option[T]
    some(value: T)
    nothing

  fun area(s: Shape) -> Int
    match s
      .circle(r) => 3 * r * r
      .rect(w, h) => w * h

  a: Shape = .circle(radius: 2)
  b = Shape.rect(h: 3, w: 2)
  print(area(a), area(b), b)
  o = Option.some(value: 7)
  match o
    .some(v) => print(v)
    .nothing => print("none")

fail "variant literal cell payload", "20:6: `.C(c: Cell(1))` makes a `CV`, which holds a Cell, so it lives only behind a shared handle", "21:7: `.O(v: .C(c: Cell(2)))` makes a `Outer`, which holds a Cell, so it lives only behind a shared handle", errors: 2
  # A variant literal of an enum that holds a Cell by value, lent where a
  # `?CV` goes, is rejected as `CV.C(c: Cell(1))` is: a value that holds a
  # Cell lives only behind a shared handle.
  enum CV
    C(c: Cell[Int])
    E

  enum Outer
    O(v: CV)

  sub look(v: ?CV)
    match v
      .C(c) => print("c", c.get())
      .E => print("e")

  sub outer(o: ?Outer)
    match o
      .O(v) => look(v)

  look(.C(c: Cell(1)))
  outer(.O(v: .C(c: Cell(2))))
  look(.E)

test "variant literal equality", '''
  true false true
  true true false false
  1.0
  true
'''
  # A payload variant literal takes its enum type from the other side of
  # `==` or `!=`, on either side, as a bare `.variant` does: through a
  # view and beside an optional too.

  enum Shape
    circle(r: Float)
    square(side: Int)
    empty

