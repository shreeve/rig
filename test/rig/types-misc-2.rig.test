test "shl wrap places", release: true, '''
  130
  pick 0
  pick 1
  [2, 0, 3]
  240
  2 170141183460469231731687303715884105728
  224
'''
  # `<<%=` assigns a wrapping left shift to a name or a place, evaluating the place once;
  # a constant `<<%` wraps in the type its context gives it.

  obj P
    n: U8

  fun pick(i: Int) -> Int
    print("pick", i)
    i

  MASK: U8 = 0xFF <<% 4

  sub main()
    p = P(n: 0b1100_0001)
    p.n <<%= 1
    print(p.n)
    xs: [3]U16 = [0x8001, 0x4000, 3]
    xs[pick(0)] <<%= 1
    xs[pick(1)] <<%= 2
    print(xs)
    print(MASK)
    big: U128 = 0x8000_0000_0000_0000_0000_0000_0000_0001
    print(big <<% 1, big <<% 127)
    k: U8 = 0xF0 <<% 1
    print(k)

test "showcase program", '''
  3
  Steve
  7
  false
  5
  1
'''
  # The original language showcase: fallible functions return plain
  # values, `?input` lends on a view parameter, a compile-time
  # parameter specializes the function, and a user type may be named `Bytes`.

  obj User
    name: ?String
    id: U64

  obj Profile
    name: ?String

  obj UserView
    user: ?User
    profile: ?Profile

  enum ParseMode
    strict
    loose

  obj Ast
    ok: Bool

  obj Bytes
    data: Int

  fun parseStrict(input: ?Bytes) -> Ast
    Ast(ok: input.data > 0)

  fun parseLoose(input: ?Bytes) -> Ast
    Ast(ok: true)

  fun add(a: Int, b: Int) -> Int
    a + b

  fun loadUser(id: U64) -> User!
    User(name: "Steve", id: id)

  fun loadProfile(id: U64) -> Profile!
    Profile(name: "Steve")

  # Compile-time specialization: `[mode: ParseMode]` is Zig's `comptime`.
  fun parse[mode: ParseMode](input: ?Bytes) -> Ast
    if mode == .strict
      parseStrict(?input)
    else
      parseLoose(?input)

  obj Wrap[T]
    value: T

  total = add(1, 2)
  print(total)

  user =! loadUser(1)!         # fixed binding of a propagated result
  print(user.name)

  other = <user                # a move: `user` is done

  u = loadUser(7)!
  p = loadProfile(u.id)!
  view = UserView(user: ?u, profile: ?p)
  print(view.user.id)

  bytes = Bytes(data: 0)
  ast = parse[.strict](?bytes)
  print(ast.ok)

  b: Wrap[Int] = Wrap(value: 5)
  print(b.value)

  print(other.id)              # `other` owns the user now

fail "signal stack field", "stack-local `Signal[T]` is not supported"
  # A struct holds a Signal through a shared handle (`s: *Signal[Int]`).

  obj H
    s: Signal[Int]

  h = H(s: Signal(1))
  print(h.s.get())

fail "signal stack local", "stack-local `Signal[T]` is not supported"
  # A stack-local `Signal[T]` is rejected; signals must be heap-owned
  # (`*Signal[T]`).

  sig: Signal[Int] = Signal(0)

fail "signal stack local inferred", "stack-local `Signal[T]` is not supported"
  # A Signal lives behind a shared handle: an unannotated stack Signal is
  # rejected too.

  sig = Signal(0)
  print(sig.get())

fail "signal stack shared later", "stack-local `Signal[T]` is not supported"
  # A Signal is constructed directly under `*`; sharing a stack one later
  # is rejected.

  s = Signal(1)
  t = *<s
  print(t.get())

test "single field positional", '''
  5 Node(key: 1, next: Node(key: 2, next: none)) 3 7 9 Meters(value: 3.5) Wrap(item: 4) Wrap(item: "hi") 6
'''
  # A type with one field takes it by position, as a variant with one
  # field does: `^x`, `*Cell(0)`, `*Signal(7)`, a one-field struct,
  # and a one-field generic type, whose argument is inferred from the
  # value. The named form stays legal.

  obj Meters
    value: Float

  obj Wrap[T]
    item: T

  obj Node
    key: Int
    next: ^Node?

  b = ^5
  n = ^Node(key: 1, next: ^Node(key: 2, next: none))
  c = *Cell(0)
  !c.set(c.get() + 3)
  s = *Signal(7)
  sh: *Cell[Int] = *Cell(9)
  m = Meters(3.5)
  w = Wrap(4)
  w2 = Wrap[?String]("hi")
  named = ^6
  print(b, n, c.get(), s.get(), sh.get(), m, w, w2, named)

