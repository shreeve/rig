fail "review-step1-p45 grammar", "`w` is a unique `W[Int]`, which can't be copied by `=`: write `<w` to move it or `?w` to view it"
  obj unique
    n: Int

  pub obj S unique # comment
    unique: Int

    fun get(?@) -> Int
      @unique

  obj W[T] unique
    item: T

  obj Z
    unique: Bool

  u = unique(n: 1)
  s = S(unique: 2)
  w = W(item: 3)
  v = <w
  z = Z(unique: true)
  print(u.n, s.get(), v.item, z.unique)
  t = <s
  print(t.unique)
  x = w

