  body
  deferred 2 text that is long enough for the heap
  deferred text that is long enough for the heap
'''
  # temp in a `defer` body, and a hoisted call (keyword arguments out of
  # order) in a `defer` body with a Text temporary lent as `?String`.
  fun g(k: Int) -> Int
    k

  fun pick(s: ?String, n: Int) -> ?String
    s

  defer print(pick(n: g(1), s: ?String("deferred text that is long enough for the heap")))
  defer print(pick(?String("deferred 2 text that is long enough for the heap"), 1))
  print("body")

fail "review-step10-a26 taken array of places", "`a` owns a `String`, which can't be copied into an array: write `<a` to move it or `+a` to clone it"
  # taken: `for x in [a, b]` over an array literal of Text places. The
