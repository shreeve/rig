      print("drop", @n)

  fun maybe(s: (?S)?) -> Int
    if s as x
      return x.n
    -1

  fun mko(n: Int) -> S?
    if n > 5
      return none
    S(n: n, t: String("a"))

  print(maybe(mko(1)), maybe(mko(9)))
  print(maybe(?mko(2)))
  o: S? = S(n: 3, t: String("o"))
  print(maybe(o))

