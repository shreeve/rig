test "review-step3-a01 temp conditional", '''
  0
  false
  5
  mk 4
  4
  drop 4
  true
  end
'''
  obj Bag
    n: Int

    drop(!@)
      print("drop", @n)

  fun size(b: ?Bag) -> Int
    b.n

  fun mk(n: Int) -> Bag
    print("mk", n)
    Bag(n: n)

  c = false
  print(size(mk(1)) if c else 0)
  print(c and size(mk(2)) > 0)
  o: Int? = 5
  print(o ?? size(mk(3)))
  d = true
  print(size(mk(4)) if d else size(mk(5)))
  print(d or size(mk(6)) > 0)
  print("end")

test "review-step3-a02 temp while", '''
  drop 0
  drop 1
  drop 2
  drop 3
  i 3
  drop 9
  nine
  drop 8
  eight
  end
  defer 7
  drop 7
'''
  obj Bag
    n: Int

    drop(!@)
      print("drop", @n)

  fun size(b: ?Bag) -> Int
    b.n

  fun mk(n: Int) -> Bag
    Bag(n: n)

  i = 0
  while size(mk(i)) < 3
    i += 1
  print("i", i)
  match size(mk(9))
    9 => print("nine")
    _ => print("other")
  if size(mk(8)) == 8
    print("eight")
  defer
    print("defer", size(mk(7)))
  print("end")

test "review-step3-a05 temp guard", '''
  drop 1
  drop 2
  two
'''
  obj Bag
    n: Int

    drop(!@)
      print("drop", @n)

  enum E
    a(n: Int)
    b

  fun size(b: ?Bag) -> Int
    b.n

  fun mk(n: Int) -> Bag
    Bag(n: n)

  e = E.a(n: 2)
  match e
    .a(n) if n == size(mk(1)) => print("one")
    .a(n) if n == size(mk(2)) => print("two")
    _ => print("other")

test "review-step3-a06b", '''
  mk 2
  mk 1
  12
  drop 1
  drop 2
  mk 1
  15
  drop 1
  mk 7
  57
  drop 7
  mk 4
  7
  drop 4
  mk 4
  5
  drop 4
  drop 5
'''
  obj Bag
    n: Int

    drop(!@)
      print("drop", @n)

  fun two(a: ?Bag, b: ?Bag) -> Int
    a.n * 10 + b.n

  fun mk(n: Int) -> Bag
    print("mk", n)
    Bag(n: n)

  fun dflt(a: ?Bag, k: Int = 3) -> Int
    a.n + k

  print(two(b: ?mk(2), a: ?mk(1)))
  x = Bag(n: 5)
  print(two(b: x, a: ?mk(1)))
  print(two(b: ?mk(7), a: x))
  print(dflt(?mk(4)))
  print(dflt(k: 1, a: ?mk(4)))

test "review-step3-a08 receiver temp", '''
  5
  drop 3
  drop 2
  9
  drop 5
  drop 1
  drop 1
  2
  drop 1
  -1
  drop 4
'''
  obj Bag
    n: Int

    drop(!@)
      print("drop", @n)

    fun plus(?@, o: ?Bag) -> Int
      @n + o.n

  fun mk(n: Int) -> Bag
    Bag(n: n)

  error Bad
    boom

  fun mkf(n: Int) -> Bag!
    if n > 5
      return Bad.boom
    Bag(n: n)

  fun run(n: Int) -> Int!
    mk(1).plus(mkf(n)!)

  print(mk(2).plus(mk(3)))
  b = Bag(n: 4)
  print(b.plus(mk(5)))
  print(run(1) catch -1)
  print(run(9) catch -1)

test "review-step3-a09 temp positions", '''
  drop 1
  drop 2
  1 2
  drop 3
  3
  drop 4
  4
  drop 5
  5
  w 0
  drop 6
  w 1
  drop 6
  drop 7
  7
'''
  obj Bag
    n: Int

    drop(!@)
      print("drop", @n)

  error Bad
    boom

  fun size(b: ?Bag) -> Int
    b.n

  fun mk(n: Int) -> Bag
    Bag(n: n)

  fun ret() -> Int
    return size(mk(1))

  fun tail() -> Int
    size(mk(2))

  fun fail(n: Int) -> Int!
    if n > 0
      return Bad.boom
    n

  print(ret(), tail())
  x = for i in 0..3
    if i == 1
      break size(mk(3))
  else
    0
  print(x)
  c = true
  y = if c
    size(mk(4))
  else
    0
  print(y)
  z = fail(1) catch size(mk(5))
  print(z)
  i = 0
  while i < 2 : i += size(mk(6)) - 5
    print("w", i)
  o: Int? = none
  w = o ?? size(mk(7))
  print(w)

