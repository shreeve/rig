'''
  # Header exception "a value made in the header": `for` over a List made
  # by a call whose argument is a header temporary (plain elements, and
  # Text elements taken), and over a made array of plain data.
  fun idx(s: ?String) -> Int
    s.len

  fun mkv(k: Int) -> List[Int]
    v: List[Int] = List()
    for i in 0..k
      !v.push(i)
    v

