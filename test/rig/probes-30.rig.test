# Probes from past reviews and audits, 30 of 41: review-stdjson-dangle_drop to review-step3-l12_handle_in_vec.

use std.json
use std.random
use std.random as rnd

fail "review-stdjson-dangle drop", "cannot drop `s` while it is lent"
  doc = json.new_doc()
  s = String("[\"abc\"]")
  if (!doc).parse(?s)
    <s
    print(doc.get_str(1))

fail "review-stdjson-dangle loop", "`s` does not live long enough"
  doc = json.new_doc()
  for _ in 0..2
    s = String("[\"abc\"]")
    ok = (!doc).parse(?s)
    print(ok)
  print(doc.get_str(1))

fail "review-stdjson-dangle mutate", "cannot lend `s` to write while a read loan is live"
  doc = json.new_doc()
  s = String("[\"abc\"]")
  if (!doc).parse(?s)
    !s.clear()
    print(doc.get_str(1))

fail "review-stdjson-dangle reparse", "cannot let this call store a view of `s` in `doc`: `doc` outlives it"
  sub keep(doc: !json.Doc)
    s = String("[\"abc\"]")
    print((!doc).parse(?s))

  doc = json.new_doc()
  keep(!doc)
  print(doc.get_str(1))

fail "review-stdjson-dangle return", "cannot return a view of `s`, which this function was not lent"
  fun make() -> json.Doc
    s = String("[\"abc\"]")
    doc = json.new_doc()
    print((!doc).parse(?s))
    doc

  doc = make()
  print(doc.get_str(1))

fail "review-stdjson-stale view", "cannot lend `doc` to write while a read loan is live"
  doc = json.new_doc()
  a = "[\"a\\n\"]"
  b = "[\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\\n\"]"
  print((!doc).parse(?a))
  v = ?doc.get_str(1)
  print((!doc).parse(?b))
  print(v)

fail "review-step1-p1 store return writeparam", "cannot lend `v` to write while a read loan is live"
  # Inferred or declared result origins must see that `a.r` now views `b`.
  # Today the union default rejects the caller; a recorder that reads the
  # returned value's loans sees only `a` if the store is not in `a`'s flow.
  obj Holder
    r: []Int

  fun f(a: !Holder, b: !List[Int]) -> []Int keeps b
    a.r = ?b[..]
    a.r

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  s = f(!h, !v)
  for i in 0..100
    !v.push(i)
  print(s[0])

fail "review-step1-p29 rng", "`o` is a unique `random.Random?`, which can't be copied by `=`: write `<o` to move it or `?o` to view it"
  obj Wrap[T]
    item: T

  fun dup[T](x: T) -> Int
    y = x
    1

  r = random.Random.seeded(3)
  o: random.Random? = random.Random.seeded(4)
  p = o
  w = Wrap(item: random.Random.seeded(5))
  v = w
  print(dup(<r))

fail "review-step1-p2 store return readparam", "cannot lend `v` to write while a read loan is live"
  obj Holder
    r: []Int

  fun f(a: !Holder, b: []Int) -> []Int keeps b
    a.r = b
    a.r

  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  s = f(!h, ?v[..])
  for i in 0..100
    !v.push(i)
  print(s[0])

fail "review-step1-p33b vec store opt", "bare use of loop view `k` in binding would carry the viewed handle past the loop; a `for x in ?list` element is a read view of the List slot and cannot be cloned, moved, dropped, or stored"
  obj P
    n: Int

  v: List[*P] = List()
  !v.push(*P(n: 4))
  saved: (?*P)? = none
  for k in ?v
    saved = k
  if saved as s
    print(s.n)

