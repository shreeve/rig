test "review-step3-d03 match local drop", '''
  in 1
  after
  in 2
  end
  drop 2
  drop 1
'''
  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  enum E
    a(r: Res)
    b

  e = E.a(r: Res(n: 1))
  match e
    .a(r) => print("in", r.n)
    .b => pass
  print("after")
  b = ^E.a(r: Res(n: 2))
  match ?b
    .a(r) => print("in", r.n)
    .b => pass
  print("end")

