test "review-step45-p06 array param elem assign", '''
  ["a", "z", "c"]
  3
'''
  # array of owners by write view param: assign element; by value param dropped
  sub set(a: ![3]String)
    a[1] = String("z")

  fun total(a: [3]String) -> Int
    a[0].len + a[1].len + a[2].len

  a = [String("a"), String("b"), String("c")]
  set(!a)
  print(a)
  print(total(<a))

