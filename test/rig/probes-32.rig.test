test "review-step45-k10 match take elem", '''
  hi
  [none]
'''
  # match <v[0] on List[E?]... and match on an optional element taken
  enum E
    a(t: String)
    b(n: Int)

  v: List[E?] = List()
  !v.push(E.a(t: String("hi")))
  if <v[0] as e
    match <e
      .a(t) => print(t)
      .b(n) => print(n)
  print(v)

test "review-step45-k11 match elem guard", "long hi"
  # guarded match on an element place, payload used in arm
  enum E
    a(t: String)
    b(n: Int)

  v: List[E] = List()
  !v.push(E.a(t: String("hi")))
  match v[0]
    .a(t) if t.len > 1 => print("long", t)
    .a(t) => print("short", t)
    .b(n) => print(n)

