  w: List[^String] = List()
  !w.push(^String("q"))
  !w.clear()
  print(w.len)

test "review-step45-r13 match elem header temp text", '''
  long hello
  1
'''
  # guarded match on an element with a header temporary; owner payload view used in arm
  enum E
    a(t: String)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[E] = List()
  !v.push(E.a(t: String("hello")))
  match v[idx(?String("a"))]
    .a(t) if t.len > 2 => print("long", t)
    .a(t) => print("short", t)
    .b(n) => print(n)
  print(v.len)

test "review-step45-r15 match write elem header temp", "322"
  # match !v[idx(?Text("a"))] with a guard: a write payload grows the Text in the arm
  enum E
    a(t: String)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[E] = List()
  !v.push(E.a(t: String("hi")))
  match !v[idx(?String("a"))]
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match v[0]
    .a(t) => print(t.len)
    .b(n) => print(n)

