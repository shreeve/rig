test "review-step45-m01 elem receivers", '''
  4 4 false 2 2
  1 2
  12 x+
  a+bb
'''
  # elements as receivers, operands and args
  obj Rec
    name: String
    n: Int

    fun show(?@) -> Int
      @name.len + @n

    sub bump(!@)
      @n += 1
      !@name.add("+")

  fun size(v: ?List[Int]) -> Int
    v.len

  fun nm(s: ?String) -> Int
    s.len

  rs: List[Rec] = List()
  !rs.push(Rec(name: String("a"), n: 1))
  !rs.push(Rec(name: String("bb"), n: 2))
  !rs[0].bump()
  print(rs[0].show(), rs[1].show(), rs[0].name == rs[1].name, nm(rs[1].name), nm(?rs[0].name))
  vv: List[List[Int]] = List()
  !vv.push(List())
  !vv[0].push(vv.len)
  print(size(vv[0]), vv[0][0] + vv[0][0])
  arr = [^Rec(name: String("x"), n: 3)]
  arr[0].n = 9
  !arr[0].bump()
  print(arr[0].show(), arr[0].name)
  if rs[0].n > 1
    print(String(rs[0].name, rs[1].name))

fail "review-step45-m02 elem move field out", "`rs[0].name` owns a `String`, which can't be copied into an argument: write `+rs[0].name` to pass a clone"
