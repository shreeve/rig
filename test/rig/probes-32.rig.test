  print(m[0][0].len)

test "review-step45-r2-a14 while for forms rejected", '''
  q
  q
'''
  # while-as / for read / for write over a place through a temp: each
  # header points at the place, so each binds the place's own
  fun idx(s: ?String) -> Int
    s.len - 1

  v: List[String?] = List()
  !v.push(String("q"))
  m: List[List[String]] = List()
  !m.push(List())
  while v[idx(?String("a"))] as t
    print(t)
    break
  for x in m[idx(?String("a"))]
    print(x)
  for x in !m[idx(?String("a"))]
    !x.add("!")
  if v[idx(?String("a"))] as t
    print(t)
  else
    print("none")
