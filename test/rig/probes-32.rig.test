test "review-step45-m13 take elem write loop", '''
  a
  [[none]]
'''
  # take an element of a write loop binding (for row in !v)
  v: List[List[String?]] = List()
  r: List[String?] = List()
  !r.push(String("a"))
  !v.push(<r)
  for row in !v
    t = <row[0]
    print(t)
  print(v)

test "review-step45-n09 return match error owners", '''
  defer
  errdefer
  caught
  defer
  one
  defer
  held
'''
  # return of a match whose arms yield an error value or an owner, with errdefer
  error Bad
    oops

  fun f(k: Int) -> String!
    held = String("held")
    errdefer print("errdefer")
    defer print("defer")
    return match k
      0 => Bad.oops
      1 => String("one")
      _ => <held

  print(f(0) catch String("caught"))
  print(f(1) catch String("caught"))
  print(f(2) catch String("caught"))

test "review-step45-n10 return block error owner", '''
  errdefer
  []
  ["a"]
'''
  # return of a value-if whose branches build owners before an error
  error Bad
    oops

  fun f(c: Bool) -> List[String]!
    v: List[String] = List()
    !v.push(String("a"))
    errdefer print("errdefer")
    return (Bad.oops if c else <v)

  print(f(true) catch List[String]())
  print(f(false) catch List[String]())

