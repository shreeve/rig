# Probes from past reviews and audits, 32 of 41: review-step45-f01_struct_array_copy to review-step45-r2-a14_while_for_forms_rejected.

use std.sort

fail "review-step45-f01 struct array copy", "`s` owns an `S`, which can't be copied by `=`: write `<s` to move it, `+s` to clone it, or `?s` to view it"
  # a struct holding an array of Text is owning: bare copy must be rejected
  obj S
    arr: [2]String

  s = S(arr: [String("a"), String("b")])
  t = s
  print(t.arr, s.arr)

test "review-step45-f03 write slice assign", '''
  ["z"] ["z", "q"]
'''
  # assign through a write slice of owners drops the old element
  sub set(s: ![]String)
    s[0] = String("z")

  v: List[String] = List()
  !v.push(String("a"))
  set(!v)
  a = [String("p"), String("q")]
  set(!a)
  print(v, a)

fail "review-step45-f05 read slice copy", "`s[0]` owns a `String`, which can't be copied out by `return`: write `+s[0]` to clone it"
  # copying an owner out of a read slice must be rejected
  fun first(s: []String) -> String
    s[0]

  v: List[String] = List()
  !v.push(String("a"))
  print(first(?v))

test "review-step45-f06 sort by owners", '''
  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx xxxxxxxxxxxxxxxxxxxxxxxxxxxxx xxxxxxxxxxxxxxxxxxxxxxxxxxxx 33
  3 2 1
'''
  # sort_by on List[Text] and on an array of Box

  obj P
    n: Int

  fun longer(a: ?String, b: ?String) -> Bool
    a.len > b.len

  fun bigger(a: ?^P, b: ?^P) -> Bool
    a.n > b.n

  v: List[String] = List()
  for i in 0..30
    t = String("")
    for _ in 0..(30 - i)
      !t.add("x")
    !v.push(<t)
  !v.push(String("a"))
  !v.push(String("ccc"))
  !v.push(String("bb"))
  sort.sort_by(!v, longer)
  print(v[0], v[1], v[2], v.len)
  a = [^P(n: 1), ^P(n: 3), ^P(n: 2)]
  sort.sort_by(!a, bigger)
  print(a[0].n, a[1].n, a[2].n)

fail "review-step45-f07 slice of vec then push", "cannot lend `v` to write while a read loan is live"
  # slice view of a List[Text] held, then push (must reject)
  v: List[String] = List()
  !v.push(String("a"))
  s = ?v[..]
  !v.push(String("b"))
  print(s)

test "review-step45-f08 write slice elem view escape", '''
  ["ab"]
'''
  # view of an element through a write slice returned
  fun first(s: ![]String) -> !String
    !s[0]

  v: List[String] = List()
  !v.push(String("a"))
  t = first(!v)
  !t.add("b")
  print(v)

test "review-step45-f09 slice swap", '''
  ["b", "a"]
'''
  # swap through a write slice of owners
  sub flip(s: ![]String)
    !s.swap(0, 1)

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  flip(!v)
  print(v)

fail "review-step45-g01 repoint lend on uaf", "cannot reassign `w` while it is lent"
  # w = !m; r = ?w; w = !n (re-point) then replace m while r still views m
  m = String("mmmm")
  n = String("nnnn")
  w = !m
  r = ?w
  w = !n
  m = String("zzzz")
  print(r)
  w = String("x")
  print(n)

fail "review-step45-g02 repoint branch", "cannot reassign `m` while it is lent"
  # re-point in one branch only, then write m while w may still view it
  m = String("m")
  n = String("n")
  c = n.len == 1
  w = !m
  if c
    w = !n
  m = String("zz")
  !w.add("!")
  print(m, n)

test "review-step45-g03 repoint then use old", "M n2"
  # re-point, then use the old target freely (sound), w then written
  m = String("m")
  n = String("n")
  w = !m
  !w.add("1")
  w = !n
  m = String("M")
  !w.add("2")
  print(m, n)

fail "review-step45-g04 repoint inner scope", "`k` does not live long enough"
  # re-point at an inner-scope local, then write after it is gone
  m = String("m")
  w = !m
  if true
    k = String("k")
    w = !k
  !w.add("!")
  print(m)

test "review-step45-g05 repoint loop elems", '''
  ["a!", "b!"] m
'''
  # re-point at each element of a List in a loop
  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  m = String("m")
  w = !m
  for i in 0..v.len
    w = !v[i]
    !w.add("!")
  print(v, m)

fail "review-step45-g06 repoint loop then push", "use of `v` while a write loan is live"
  # re-point at an element in a loop, then push to the List, then write through w
  v: List[String] = List()
  !v.push(String("a"))
  m = String("m")
  w = !m
  for i in 0..v.len
    w = !v[i]
  !v.push(String("b"))
  !w.add("!")
  print(v)

test "review-step45-g07 repoint move view", "m n!"
  # w = <w2 moves a write view
  m = String("m")
  n = String("n")
  w = !m
  w2 = !n
  w = <w2
  !w.add("!")
  print(m, n)

test "review-step45-g08 repoint fn result", '''
  ["a", "b!"] m
'''
  # w = f(!v) re-points at a returned element view
  fun last(v: !List[String]) -> !String
    !v[v.len - 1]

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  m = String("m")
  w = !m
  w = last(!v)
  !w.add("!")
  print(v, m)

fail "review-step45-g09 repoint closure", "cannot reassign `w` while it is lent"
  # a closure captures w (write), then w re-pointed while the closure lives
  m = 1
  n = 2
  w = !m
  f = |!w| w += 10
  w = !n
  f()
  print(m, n)

test "review-step45-g10 repoint loop while view live", "axx bxx"
  # within a loop, re-point; the loan from the previous iteration must end
  a = String("a")
  b = String("b")
  w = !a
  for i in 0..4
    if i % 2 == 0
      w = !b
    else
      w = !a
    !w.add("x")
  print(a, b)

test "review-step45-h06 wview int rhs", "2 9"
  # w = w2 for !Int: plain value writes through (sound), check meaning
  a = 1
  b = 2
  w = !a
  w2 = !b
  w = w2
  w2 = 9
  print(a, b)

test "review-step45-i01 clone view param", '''
  ["a"] ["a", "b"]
'''
  # +v where v is a read view of a List[Text]
  fun dup(v: ?List[String]) -> List[String]
    +v

  v: List[String] = List()
  !v.push(String("a"))
  w = dup(?v)
  !w.push(String("b"))
  print(v, w)

test "review-step45-i02 clone struct with view", "own viewed"
  # +s where s owns a Text and holds a read view of another Text
  obj S
    own: String
    see: ?String

  t = String("viewed")
  s = S(own: String("own"), see: ?t)
  c = +s
  <s
  print(c.own, c.see)

fail "review-step45-i03 clone vec views loans", "cannot drop `t` while it is lent"
  # +v of a List of views must carry the views' loans
  t = String("viewed")
  v: List[?String] = List()
  !v.push(?t)
  w = +v
  <v
  <t
  print(w)

test "review-step45-i04 clone vec handles", '''
  v gone
  drop 1
  end
'''
  # +v of List[*D]: each handle counted again; D dropped once, after the last
  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  a = *D(n: 1)
  v: List[*D] = List()
  !v.push(+a)
  !v.push(+a)
  w = +v
  <a
  <v
  print("v gone")
  <w
  print("end")

test "review-step45-i05 clone recursive", '''
  2
  a
'''
  # +l of a recursive Box list
  enum Chain
    nil
    cons(head: String, tail: ^Chain)

  fun len(l: ?Chain) -> Int
    match l
      .nil => 0
      .cons(_, t) => 1 + len(?t)

  l = Chain.cons(head: String("a"), tail: ^Chain.cons(head: String("b"), tail: ^Chain.nil))
  c = +l
  <l
  print(len(?c))
  match c
    .cons(h, _) => print(h)
    .nil => print("nil")

test "review-step45-i08 clone weak", '''
  still 1
  drop 1
  gone
  end
'''
  # +v of List[~D] and optionals of handles
  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  a = *D(n: 1)
  v: List[~D] = List()
  !v.push(~a)
  w = +v
  o: (*D)? = +a
  p = +o
  <a
  <o
  print("still", w.len)
  <p
  if *w[0] as h
    print("alive", h.n)
  else
    print("gone")
  <v
  <w
  print("end")

