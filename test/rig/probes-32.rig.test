fail "review-step45-r2-a05 method receiver path", "this `match` reads the view its subject returns after its header drops the temporary `!s` it points into; bind `!s` to a name first"
  # match on a field of a view returned by a method whose argument is a temp
  enum E
    a(t: String)
    b(n: Int)

  obj S
    es: List[E]

    fun at(!@, s: ?String) -> !E
      !@es[s.len - 1]

  s = S(es: List())
  !s.es.push(E.a(t: String("hi")))
  match (!(!s)).at(?String("a"))
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match s.es[0]
    .a(t) => print(t.len)
    .b(n) => print(n)

