test "review-step45-r15d match write local header temp", "322"
  # guarded write match on a local enum (not an element) whose header has a temporary
  enum E
    a(t: String)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  e = E.a(t: String("hi"))
  k = 0
  match !e if idx(?String("a")) == k else !e
    .a(t) if t.len > 0
      for _ in 0..40
        !t.add("xxxxxxxx")
    .a(t)
      !t.add("?")
    .b(n)
      print(n)
  match e
    .a(t) => print(t.len)
    .b(n) => print(n)

test "review-step45-r17 match write arr elem header temp", "[.a(n: 50)]"
  # base-comparable: guarded write match on a struct field reached through an index with a temp
  enum E
    a(n: Int)
    b(n: Int)

  fun idx(s: ?String) -> Int
    s.len - 1

  arr = [E.a(n: 1)]
  match !arr[idx(?String("a"))]
    .a(n) if n > 0
      n = 50
    .a(n)
      n = 60
    .b(n)
      print(n)
  print(arr)

