fail "r3-or-fit-f2 lookup", "`q` does not live long enough"
  obj Var
    name: ?String
    value: ?String

  obj Env
    vars: [3]Var

    fun get(?@, name: ?String) -> (?String)?
      for v in ?@vars
        if v.name == name
          return v.value
      none

  env = Env(vars: [Var(name: "a", value: "1"), Var(name: "b", value: "2"), Var(name: "c", value: "3")])
  out: List[?String] = List()
  for n in ["a", "c"]
    q = String(n)
    if env.get(?q) as v
      !out.push(v)
  print(out)

fail "r3-or-fit-f2b lookup struct", "cannot assign to `probe.id` while `probe` is lent"
  obj Entry
    id: Int
    score: Int

  obj Table
    rows: [3]Entry

    fun find(?@, key: ?Entry) -> (?Entry)?
      for i in 0..3
        if @rows[i].id == key.id
          return ?@rows[i]
      none

  t = Table(rows: [Entry(id: 1, score: 10), Entry(id: 2, score: 20), Entry(id: 3, score: 30)])
  probe = Entry(id: 2, score: 0)
  if t.find(?probe) as hit
    probe.id = 3
    print(hit.score, probe.id)

