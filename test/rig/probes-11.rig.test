test "purity-rustzig-bench-bst bench", "21480720689328"
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      insert(!n.left, key) if key < n.key else insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  fun total(slot: ?^Node?) -> Int
    if slot as n
      return total(?n.left) + n.key + total(?n.right)
    0

  root: ^Node? = none
  x = 12345
  i = 0
  while i < 20000 : i += 1
    x = (x * 1103515245 + 12345) % 2147483648
    insert(!root, x)
  print(total(?root))

test "purity-rustzig-bst", '''
  20
  30
  35
  40
  50
  60
  70
  80
  [20, 30, 35, 40, 50, 60, 70, 80] 8
'''
  # A binary search tree of Ints with owned children.

  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

    sub insert(!@, key: Int)
      if key < @key
        if !@left as l
          !l.insert(key)
        else
          @left = ^Node(key: key, left: none, right: none)
      else
        if !@right as r
          !r.insert(key)
        else
          @right = ^Node(key: key, left: none, right: none)

    sub walk(?@, visit: ?sub(Int))
      if ?@left as l
        l.walk(visit)
      visit(@key)
      if ?@right as r
        r.walk(visit)

  obj Tree
    root: ^Node?
    size: Int

    sub insert(!@, key: Int)
      if !@root as n
        !n.insert(key)
      else
        @root = ^Node(key: key, left: none, right: none)
      @size += 1

    sub each(?@, visit: ?sub(Int))
      if ?@root as n
        n.walk(visit)

    fun sorted(?@) -> List[Int]
      out: List[Int] = List()
      @each(|!out, k| !out.push(k))
      out

  t = Tree(root: none, size: 0)
  for k in [50, 30, 70, 20, 40, 60, 80, 35]
    !t.insert(k)
  t.each(|k| print(k))
  keys = t.sorted()
  print(keys, t.size)

fail "purity-rustzig-family", "cannot store a view of `name` in a `Cell`: every handle to it could reach the view; a value stored in a Cell or Signal may not hold one; if it is only passed literal text, declare the parameter `Static`, which carries no loan"
  # A tree with back-pointers: parents own their children through shared
  # handles, and each child points up weakly, so the cycle does not leak.

  obj Node
    name: ?String
    parent: ~Node?
    children: Cell[List[*Node]]

    drop(!@)
      print("free", @name)

  # Make a child of `parent` and hand back a handle to it.
  fun child(parent: ?*Node, name: ?String) -> *Node
    up = +parent
    kid = *Node(name: name, parent: ~up, children: Cell(List()))
    !up.children.push(+kid)
    kid

  # Walk up through the weak parent links.
  fun depth(n: ?*Node) -> Int
    d = 0
    cur = +n
    while ?cur.parent as w
      up = *w ?? break
      cur = <up
      d += 1
    d

  fun has_parent(n: ?*Node) -> Bool
    if ?n.parent as w
      return *w != none
    false

  root = *Node(name: "root", parent: none, children: Cell(List()))
  a = child(?root, "a")
  b = child(?root, "b")
  a1 = child(?a, "a1")
  print("depth", a1.name, depth(?a1))
  print("root has", root.children.len, "children")
  <a
  <b
  print("a1 still has a parent:", has_parent(?a1))
  <root
  print("a1 after root dropped:", has_parent(?a1))

test "purity-rustzig-probes-bst iter", "true false"
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

  fun contains(root: ?^Node?, key: Int) -> Bool
    cur = root
    while cur as n
      if key == n.key
        return true
      cur = ?n.left if key < n.key else ?n.right
    false

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      insert(!n.left, key) if key < n.key else insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  root: ^Node? = none
  for k in [5, 2, 8, 1]
    insert(!root, k)
  print(contains(?root, 8), contains(?root, 3))

