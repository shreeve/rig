    print(ctx.name, ctx.count, msg)

  ctx = Ctx(name: "app", count: 0)
  for i in 0..3
    log(!ctx, ?String("step ", i))
  print(ctx.count)

test "r3-or-fit-f5d method log", '''
  app: ada
  app: done
  2
'''
  obj Logger
    prefix: ?String
    lines: Int

    sub say(!@, msg: ?String)
      @lines += 1
      print(@prefix, msg)

  log = Logger(prefix: "app:", lines: 0)
  name = String("ada")
  !log.say(?name)
  <name
  !log.say("done")
  print(log.lines)

