test "r3-or-fit-f7 parser cursor", "1 2"
  obj Tok
    kind: Int
    start: Int
    len: Int

  obj Parser
    src: ?String
    toks: []Tok
    pos: Int

    fun next(!@) -> ?Tok
      t = ?@toks[@pos]
      @pos += 1
      t

    fun text(?@, t: ?Tok) -> ?String
      @src[t.start..t.start + t.len]

  src = String("let x")
  toks = [Tok(kind: 1, start: 0, len: 3), Tok(kind: 2, start: 4, len: 1)]
  p = Parser(src: ?src, toks: ?toks, pos: 0)
  a = (!p).next()
  b = (!p).next()
  print(a.kind, b.kind)
