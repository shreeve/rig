test "purity-newbie-shared", '''
  left clicked; total now 1
  right clicked; total now 2
  right clicked; total now 3
  total clicks: 3
'''
  # A counter shared between two owners, attempt 3: a shared Cell
  obj Clicker
    name: ?String
    counter: *Cell[Int]

    sub click(!@)
      !@counter.set(@counter.get() + 1)
      print(@name, "clicked; total now", @counter.get())

  counter = *Cell(0)
  left = Clicker(name: "left", counter: +counter)
  right = Clicker(name: "right", counter: +counter)
  !left.click()
  !right.click()
  !right.click()
  print("total clicks:", counter.get())

test "purity-newbie-shared v1 silent copy", "total clicks: 0"
  # A counter shared between two owners, Python habits: two objects
  # holding a reference to the same counter object.
  obj Counter
    count: Int = 0

    sub increment(!@)
      @count += 1

  obj Clicker
    name: ?String
    counter: Counter

    sub click(!@)
      !@counter.increment()

  counter = Counter()
  left = Clicker(name: "left", counter: counter)
  right = Clicker(name: "right", counter: counter)
  !left.click()
  !right.click()
  !right.click()
  print("total clicks:", counter.count)

test "purity-newbie-todo", '''
  0 [ ] buy milk
  1 [x] write rig program
  2 [ ] walk the dog
'''
  # To-do list, first attempt, Python/TS habits
  obj Todo
    title: ?String
    done: Bool = false

  obj TodoList
    items: List[Todo]

    sub add(!@, title: ?String) keeps title
      !@items.push(Todo(title: title))

    sub complete(!@, index: Int)
      @items[index].done = true

    sub show(?@)
      for item, i in ?@items
        mark = "[x]" if item.done else "[ ]"
        print(i, mark, item.title)

  todos = TodoList(items: List[Todo]())
  !todos.add("buy milk")
  !todos.add("write rig program")
  !todos.add("walk the dog")
  !todos.complete(1)
  todos.show()

