test "r3-or-clone-sound", '''
  [1]
  [1, 2]
'''
  # `+x` of a List, a box, or a struct of owners is a new owner, part by
  # part (Core s2): it carries the loans of the views its value holds, and
  # none on `x`.

  fun mk() -> List[Int]
    v: List[Int] = List()
    !v.push(1)
    v

  sub of_owner()
    v: List[Int] = List()
    !v.push(1)
    w = +v
    !v.push(2)
    <v
    print(w)

  sub of_made()
    c = +mk()
    !c.push(2)
    print(c)

  of_owner()
  of_made()


  # oracle: of_owner accept
  # oracle: of_made accept

test "r3-or-clone-strict", "1 2"
  # `+r` of a `?T` is a new `T` (SPEC "Clone"), which carries the loans
  # of the views it holds and none on what `r` sees (Core s2, s7): `bag`
  # may change while the clone lives. The compiler keeps the clone's loan
  # on `bag` (test/oracle/differences).

  obj Bag
    v: List[?Int]

  a = 1
  bag = Bag(v: List())
  !bag.v.push(?a)
  r = ?bag
  c = +r
  !bag.v.push(?a)
  print(c.v.len, bag.v.len)

  # oracle: main accept

fail "r3-or-clone-unsound", "cannot reassign `a` while it is lent"
  # A clone of a value that holds views carries their loans (Core s2, s6).

  obj Bag
    v: List[?Int]

  sub views_kept()
    a = 1
    v: List[?Int] = List()
    !v.push(?a)
    w = +v
    <v
    a = 2
    print(w)

  sub through_view_kept()
    a = 1
    bag = Bag(v: List())
    !bag.v.push(?a)
    r = ?bag
    c = +r
    <bag
    a = 2
    print(c.v.len)

  views_kept()
  through_view_kept()

  # oracle: views_kept reject C4
  # oracle: through_view_kept reject C4

fail "r3-or-closure-param-store", "cannot store a view of `v` in `out.r`: `out` outlives it"
  # What one call of a closure receives is the caller's, which may outlive
  # the closure: storing what the closure captured there would let the
  # view outlive its loan, since a call passes on none of what a closure
  # that returns no view captured (Core §7). Storing one parameter's view
  # in another is the caller's business, as for any function.
  #
  # oracle: param_to_param accept
  # oracle: capture_to_param reject C6
  # oracle: lent_capture_to_param reject C6

  obj H
    r: (?List[Int])?

  sub run(h: !H, f: ?sub(!H))
    f(!h)

  sub param_to_param()
    v: List[Int] = List()
    !v.push(1)
    h = H(r: none)
    put = |out: !H, x: ?List[Int]| out.r = x
    put(!h, ?v)
    if h.r as r
      print(r.len)

  sub capture_to_param()
    v: List[Int] = List()
    !v.push(1)
    h = H(r: none)
    f = |?v, out: !H| out.r = v
    f(!h)
    !v.push(2)
    if h.r as r
      print(r.len)

  sub lent_capture_to_param()
    v: List[Int] = List()
    !v.push(1)
    h = H(r: none)
    run(!h, |?v, out: !H| out.r = v)
    !v.push(2)
    if h.r as r
      print(r.len)

  param_to_param()

test "r3-or-closure-sound", '''
  5
  1
  2
  3
  8 9
  101 111
  14
  14
  1
'''
  # Closures (Core §7): a capture `?x` or `!x` lends `x` for the closure's
  # life, which ends at its last use; `<x` moves `x` in, and `+x` copies it
  # or adds a count. A stack closure is called, or lent as `?fun`; an
  # owned closure (`*fun`) holds only values that carry no loan (s9). The
  # body is checked as a function whose captures the caller lent.
  #
  # oracle: write_capture accept
  # oracle: read_capture_then_write accept
  # oracle: literal_argument accept
  # oracle: move_capture accept
  # oracle: owned_counter accept
  # oracle: nested accept
  # oracle: lent_closure accept
  # oracle: returns_captured_view accept

  obj Res
    id: Int

  sub each(xs: ?List[Int], f: ?sub(Int))
    for x in xs
      f(x)

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  sub write_capture()
    total = 0
    add = |!total, k: Int| total += k
    add(2)
    add(3)
    print(total)

  sub read_capture_then_write()
    v: List[Int] = List()
    !v.push(1)
    size = |?v| v.len
    print(size())
    !v.push(2)
    print(v.len)

  sub literal_argument()
    v: List[Int] = List()
    !v.push(1)
    !v.push(2)
    total = 0
    each(?v, |!total, n| total += n)
    print(total)

  sub move_capture()
    r = Res(id: 7)
    g = |<r, a: Int| a + r.id
    print(g(1), g(2))

  fun make_counter(start: Int) -> *fun(Int) -> Int
    count: *Cell[Int] = *Cell(start)
    *|+count, step|
      !count.set(count.get() + step)
      count.get()

  sub owned_counter()
    next = make_counter(100)
    print(next(1), next(10))

  sub nested()
    total: *Cell[Int] = *Cell(0)
    add = |+total, k: Int|
      step = |+total, +k| !total.set(total.get() + k)
      step()
      step()
    add(3)
    add(4)
    print(total.get())

  sub lent_closure()
    k = 10
    add_k = |+k, a: Int| a + k
    print(apply(?add_k, 4))

  sub returns_captured_view()
    v: List[Int] = List()
    !v.push(5)
    get = |?v| v
    print(get().len)
    !v.push(6)

  write_capture()
  read_capture_then_write()
  literal_argument()
  move_capture()
  owned_counter()
  nested()
  lent_closure()
  returns_captured_view()

test "r3-or-defer-sound", '''
  2
  0 1
  1 1
  2 1
  0
  failed 0
  1 -1
  failed 1
  1 -1
  0
  failed 0
  2 -1
  body
  1
'''
  # A `defer` runs at every exit of its scope, after the values declared
  # after it are dropped, and an `errdefer` only where the function fails
  # (Core §7): the oracle inlines each body there and checks it as written.
  #
  # oracle: reads_at_end accept
  # oracle: in_a_loop accept
  # oracle: errdefer_failing_only accept
  # oracle: errdefer_maybe accept
  # oracle: errdefer_propagate accept
  # oracle: declares_and_moves accept

  error E
    bad

  sub take(v: List[Int])
    print(v.len)

  sub reads_at_end()
    v: List[Int] = List()
    defer print(v.len)
    !v.push(1)
    !v.push(2)

  sub in_a_loop()
    k = 0
    while k < 4 : k += 1
      v: List[Int] = List()
      defer print(k, v.len)
      !v.push(k)
      continue if k == 1
      break if k == 2

  fun errdefer_failing_only(ok: Bool) -> Int!
    v: List[Int] = List()
    errdefer print("failed", v.len)
    if ok
      take(<v)
      return 1
    return E.bad

  fun errdefer_maybe(n: Int) -> Int!
    v: List[Int] = List()
    errdefer print("failed", v.len)
    !v.push(n)
    return n if n > 0 else E.bad

  fun half(n: Int) -> Int!
    return n / 2 if n % 2 == 0 else E.bad

  fun errdefer_propagate(n: Int) -> Int!
    v: List[Int] = List()
    errdefer print("failed", v.len)
    h = half(n)!
    take(<v)
    h

  sub declares_and_moves()
    defer
      v: List[Int] = List()
      !v.push(1)
      take(<v)
    print("body")

  reads_at_end()
  in_a_loop()
  print(errdefer_failing_only(true) catch -1, errdefer_failing_only(false) catch -1)
  print(errdefer_maybe(1) catch -1, errdefer_maybe(0) catch -1)
  print(errdefer_propagate(4) catch -1, errdefer_propagate(3) catch -1)
  declares_and_moves()

fail "r3-or-defer-strict", "use of `v` while a write loan is live"
  # A `defer` written before a lend runs after the view is done: the
  # view `w` is declared after it, so it is dropped before the deferred
  # code runs (Core §7; SPEC "defer and errdefer"). The compiler checks
  # deferred code where it is written as well, and rejects this.
  #
  # oracle: main accept

  v: List[Int] = List()
  defer !v.push(3)
  w = !v
  !w.push(1)
  print(v.len)

fail "r3-or-defer-unsound", "use of `v` after move"
  # The unsound neighbours of r3-or-defer-sound: deferred code that reads
  # a value moved before the exit it runs at, reads a value declared
  # after it through a view, writes what a later defer still views, or
  # moves what it did not declare (Core §7).
  #
  # oracle: moved_before_exit reject C1
  # oracle: moved_before_failing reject C1
  # oracle: moved_before_propagate reject C1
  # oracle: views_a_later_value reject C5
  # oracle: writes_while_viewed reject C4
  # oracle: moves_outer reject B2
  # oracle: drops_outer reject B2

  error E
    bad

  obj H
    s: ?String

  sub take(v: List[Int])
    print(v.len)

  fun half(n: Int) -> Int!
    return n / 2 if n % 2 == 0 else E.bad

  sub moved_before_exit()
    v: List[Int] = List()
    defer print(v.len)
    take(<v)

  fun moved_before_failing() -> Int!
    v: List[Int] = List()
    errdefer print(v.len)
    take(<v)
    return E.bad

  fun moved_before_propagate(n: Int) -> Int!
    v: List[Int] = List()
    errdefer print(v.len)
    take(<v)
    half(n)!

  sub views_a_later_value()
    h = H(s: "x")
    defer print(h.s)
    t = String("abc")
    h.s = ?t

  sub writes_while_viewed()
    v: List[Int] = List()
    r = ?v
    defer print(r.len)
    defer !v.push(3)
    print("body")

  sub moves_outer()
    v: List[Int] = List()
    defer take(<v)
    print("body")

  sub drops_outer()
    v: List[Int] = List()
    defer <v
    print("body")

  moved_before_exit()

test "r3-or-fit-f1 prefix loop", '''
