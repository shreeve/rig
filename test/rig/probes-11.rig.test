    for v in ?env.vars
      if v.name == name
        return v.value
    none

  env = Env(vars: [Var(name: "a", value: "1"), Var(name: "b", value: "2"), Var(name: "c", value: "3")])
  for n in ["a", "c"]
    q = String(n)
    if get(?env, ?q) as v
      print(v)
  print(env.vars[0].name)

fail "r3-or-fit-f3 two buffers", "cannot assign to `b[1]` while `b` is lent"
  obj Diff
    old: []Int
    cur: []Int

    fun old_at(?@, i: Int) -> Int
      @old[i]

    fun old_view(?@) -> []Int
      @old

  a = [1, 2, 3]
  b = [1, 5, 3]
  d = Diff(old: ?a, cur: ?b)
  o = ?d.old_view()
  b[1] = 9
  print(o[1], b[1])

test "r3-or-fit-f4 callback", "2 5"
  obj Item
    id: Int

  fun find_by(xs: []Item, pred: ?fun(?Item) -> Bool) -> (?Item)?
    for i in 0..xs.len
      if pred(?xs[i])
        return ?xs[i]
    none

  items = [Item(id: 1), Item(id: 2)]
  want = 2
  hit = find_by(?items, |?want, it: ?Item| it.id == want)
  want = 5
  if hit as h
    print(h.id, want)

fail "r3-or-fit-f4b callback ret", "cannot drop `w` while it is lent"
  obj Wrap
    n: Int
    v: List[Int]

  fun call(f: ?fun() -> ?Wrap) -> ?Wrap
    f()

  w = Wrap(n: 1, v: List())
  r = call(|?w| w)
  <w
  print(r.n)

test "r3-or-fit-f4c pick by", "2 10"
  obj Wrap
    n: Int
    v: List[Int]

  fun better(a: ?Wrap, b: ?Wrap, score: ?fun(?Wrap) -> Int) -> ?Wrap
    if score(a) >= score(b)
      a
    else
      b

  x = Wrap(n: 1, v: List())
  y = Wrap(n: 2, v: List())
  bias = 0
  r = better(?x, ?y, |?bias, w: ?Wrap| w.n + bias)
  bias = 10
  print(r.n, bias)

test "r3-or-fit-f4d pick by wrap", "2 10"
  obj Wrap
    n: Int
    v: List[Int]

  fun better(a: ?Wrap, b: ?Wrap, score: ?fun(?Wrap) -> Int) -> ?Wrap
    if score(a) >= score(b)
      a
    else
      b

  x = Wrap(n: 1, v: List())
  y = Wrap(n: 2, v: List())
  bias = Wrap(n: 0, v: List())
  r = better(?x, ?y, |?bias, w: ?Wrap| w.n + bias.n)
  bias.n = 10
  print(r.n, bias.n)

