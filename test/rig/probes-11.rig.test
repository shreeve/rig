  1 4 5
  drop 5
  drop 4
  drop 1
'''
  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  fun pick(c: Bool) -> Res
    a = Res(n: 1)
    b = Res(n: 2)
    if c
      a
    else
      b

  fun pick2(c: Bool) -> Res
    a = Res(n: 3)
    b = Res(n: 4)
    a if c else b

  fun loopy() -> Res
    a = Res(n: 5)
    r = while true
      break <a
    r

  x = pick(true)
  y = pick2(false)
  z = loopy()
  print(x.n, y.n, z.n)

