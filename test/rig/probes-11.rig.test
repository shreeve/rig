test "purity-rustzig-stock", '''
  bolt left 6
  nut short
  gear unknown
  x2 is not a number
  bolt left 0
  shipped 10
  nut left 2
'''
  # A stock room: methods that change it through a write view, fallible
  # operations, and callers that propagate or handle each failure.

  error StockError
    unknown
    short
    bad_qty

  obj Item
    name: ?String
    qty: Int

  obj Stock
    items: List[Item]
    shipped: Int = 0

    sub add(!@, name: ?String, qty: Int) keeps name
      !@items.push(Item(name: name, qty: qty))

    fun find(?@, name: ?String) -> Int?
      for it, i in ?@items
        return i if it.name == name
      none

    # Take `qty` of `name`: fails when the item is unknown or short.
    fun take(!@, name: ?String, qty: Int) -> Int!
      i = @find(name) ?? return StockError.unknown
      return StockError.short if @items[i].qty < qty
      @items[i].qty -= qty
      @shipped += qty
      @items[i].qty

  # Parse a quantity like "12": fails on anything but digits.
  fun parse_qty(s: ?String) -> Int!
    return StockError.bad_qty if s.len == 0
    n = 0
    for b in s
      return StockError.bad_qty if b < 48 or b > 57
      n = n * 10 + Int(b - 48)
    n

  # One order: parse, then take. Either failure propagates.
  fun ship(stock: !Stock, name: ?String, qty: ?String) -> Int!
    n = parse_qty(qty)!
    (!stock).take(name, n)!

  s = Stock(items: List())
  !s.add("bolt", 10)
  !s.add("nut", 3)
  orders = [["bolt", "4"], ["nut", "5"], ["gear", "1"], ["bolt", "x2"], ["bolt", "6"]]
  for o in orders
    left = ship(!s, o[0], o[1]) catch |e|
      match e
        .short => print(o[0], "short")
        .unknown => print(o[0], "unknown")
        _ => print(o[1], "is not a number")
      continue
    print(o[0], "left", left)
  print("shipped", s.shipped)
  ship(!s, "nut", "1")!
  print("nut left", s.items[1].qty)

test "purity-rustzig-words", '''
  The 4
  fox 3
  dog 3
  11 distinct words
'''
  # Count words in a fixed text and print the most frequent ones.
  # No hash map, no string building: words are views into TEXT, counted
  # in a List with a linear scan, and compared without regard to case.

  TEXT = "The quick brown fox jumps over the lazy dog. The dog sleeps; the fox runs. A quick fox, a lazy dog!"

  obj Entry
    word: ?String
    count: Int

  fun is_letter(b: U8) -> Bool
    (b >= 97 and b <= 122) or (b >= 65 and b <= 90)

  fun lower(b: U8) -> U8
    b + 32 if b >= 65 and b <= 90 else b

  fun same_word(a: ?String, b: ?String) -> Bool
    return false if a.len != b.len
    for x, i in a
      return false if lower(x) != lower(b[i])
    true

  sub add(counts: !List[Entry], word: ?String) keeps word
    for e in !counts
      if same_word(e.word, word)
        e.count += 1
        return
    !counts.push(Entry(word: word, count: 1))

  fun tally(text: ?String) -> List[Entry]
    counts: List[Entry] = List()
    start = 0
    for b, i in text
      if not is_letter(b)
        add(!counts, text[start..i]) if i > start
        start = i + 1
    add(!counts, text[start..]) if start < text.len
    counts

  # Insertion sort: most frequent first, ties in first-seen order.
  sub rank(xs: !List[Entry])
    i = 1
    while i < xs.len : i += 1
      j = i
      while j > 0 and xs[j - 1].count < xs[j].count : j -= 1
        !xs.swap(j - 1, j)

  sub main()
    counts = tally(TEXT)
    rank(!counts)
    for e in ?counts[..3]
      print(e.word, e.count)
    print(counts.len, "distinct words")

