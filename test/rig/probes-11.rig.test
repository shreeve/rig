test "purity-newbie-optional fail", '''
  found at 1
  none
  5
  error: MathError.DivideByZero
  0
'''
  # An optional-returning function and a fallible one, TS/Python habits
  fun find_index(xs: ?List[?String], target: ?String) -> Int?
    for x, i in ?xs
      if x == target
        return i
    return none

  error MathError
    DivideByZero

  fun divide(a: Int, b: Int) -> Int!
    if b == 0
      return MathError.DivideByZero
    a / b

  names: List[?String] = List()
  !names.push("ann")
  !names.push("bob")
  idx = find_index(?names, "bob")
  if idx != none
    print("found at", idx)
  missing = find_index(?names, "zed")
  print(missing)
  print(divide(10, 2) catch -1)
  q = divide(1, 0) catch |e|
    print("error:", e)
    0
  print(q)

test "purity-newbie-probe sharedmatch", "-4.0"
  enum Expr
    num(value: Float)
    neg(inner: *Expr)

  fun eval(e: *Expr) -> Float
    match e
      .num(v) => v
      .neg(x) => -eval(+x)

  e = *Expr.neg(*Expr.num(4))
  print(eval(<e))

test "purity-newbie-probe sharedmatch2", "-4.0"
  enum Expr
    num(value: Float)
    neg(inner: *Expr)

  fun eval(e: ?Expr) -> Float
    match e
      .num(v) => v
      .neg(x) => -eval(x)

  e = Expr.neg(*Expr.num(4))
  print(eval(?e))

