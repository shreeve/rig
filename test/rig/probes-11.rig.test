  # `@src`: that field cannot change while the String is used, and the
  # holder's other fields can (Core §5, "A field is a place of its own").

  obj P
    src: String
    pos: Int

    fun word(!@) -> ?String
      w = ?@src[..2]
      @pos += 1
      w

  p = P(src: String("abc"), pos: 0)
  a = (!p).word()
  print(a)

