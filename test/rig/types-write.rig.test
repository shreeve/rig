  # No field is a `!T` that an assignment could write through or point
  # elsewhere: a write view is never stored inside a value, so the field
  # is rejected where it is declared.

  obj H
    w: !List[Int]

  v: List[Int] = List()
  print(v.len)

test "write view bindings", "1112"
  # A write view stands in a parameter, a result, a receiver, and a local
  # or header binding, also as `(!T)?` and `(!T)!`.

  obj P
    n: Int

    fun bump(!@) -> !Int
      @n += 1
      !@n

  error Bad
    bad

  fun pick(a: !P, k: Bool) -> (!P)?
    return none if k
    a

  fun must(a: !P, k: Bool) -> (!P)!
    return Bad.bad if k
    a

  p = P(n: 1)
  o: (!P)? = pick(!p, false)
  if !o as w
    w.n += 10
  w = must(!p, false)!
  w.n += 100
  r = (!p).bump()
  r += 1000
  print(p.n)

test "write view bool", '''
  false
  false
  true
  false
'''
  # A write view of a `Bool` goes where a `!Bool` is expected: a
  # parameter, a field of a struct, a declared binding, forwarded on.

  sub flip(f: !Bool)
    f = not f

  sub twice(f: !Bool)
    flip(!f)
    flip(!f)
    print(f)

  obj Flags
    ready: Bool

  a = true
  flip(!a)
  print(a)
  twice(!a)
  flags = Flags(ready: false)
  flip(!flags.ready)
  print(flags.ready)
  view: !Bool = !a
  print(view)

fail "write view bool as not", "11:7: `!` lends to write; use `not` for negation", "15:6: `!` lends to write; use `not` for negation", "19:13: `!` lends to write; use `not` for negation", "23:20: `!` lends to write; use `not` for negation", "26:13: `!` lends to write; use `not` for negation", "29:15: `!` lends to write; use `not` for negation", "32:9: `ok` does not write `self`; for negation use `not`", "36:6: `!` lends to write; use `not` for negation"
  # `!` is a write view, never negation: a write view of a `Bool`
  # read as a `Bool` is rejected wherever it appears, and so is `!` before
  # a method that only reads its receiver (`!c.ok()`).

  obj C
    n: Int
    fun ok(?@) -> Bool
      @n > 0

  sub bound(a: Bool)
    b = !a
    print(b)

  sub condition(a: Bool)
    if !a
      print("no")

  sub declared(a: Bool)
    x: Bool = !a
    print(x)

  sub operands(a: Int, b: Bool)
    print(a == 1 and !b)

  sub negated(a: Bool)
    print(not !a)

  sub guarded(ok: Bool)
    print(1) if !ok

  sub looped(c: C)
    while !c.ok()
      break

  sub forwarded(f: !Bool)
    if !f
      print("no")

  bound(true)
  condition(true)
  declared(true)
  operands(1, true)
  negated(true)
  guarded(true)
  looped(C(n: 1))
  flag = true
  forwarded(!flag)

test "write view calls mutating method", '''
  5
  3 3
'''
  # A binding that already holds a write view (`x: !T`, `!@`, a local
  # `w = !v`) calls a `!@` method as an owned binding does, `!x.m()`:
  # lending a write view always shows its sigil.

  obj Counter
    n: Int

    sub bump(!@)
      @n += 1

    sub bump_twice(!@)
      !@bump()
      !@bump()

  sub add_three(c: !Counter)
    !c.bump()
    !c.bump_twice()

  sub fill(v: !List[Int])
    !v.push(1)
    !v.push(2)

  c = Counter(n: 0)
  add_three(!c)
  !c.bump()
  w = !c
  !w.bump()
  print(c.n)
  v: List[Int] = List()
  fill(!v)
  b = !v
  !b.push(3)
  print(v.len, v[2])

fail "write view immutable bindings", "cannot lend parameter `n` to write", "cannot lend fixed binding `y` to write", "cannot lend captured `k` to write", "cannot lend `x` to write; loop and pattern bindings are immutable", "cannot lend `v` to write: it is a copy of the value inside `m`; to change that value in place, bind it with `!m as v`"
  # `!x` writes through `x`, so `x` must be mutable: a plain parameter, a
  # fixed binding, a capture, and a loop or `as` binding are not.

  sub bump(c: !Int)
    c = c + 1

  sub f(n: Int)
    bump(!n)

  y =! 1
  bump(!y)
  k = 1
  g = |+k|
    bump(!k)
  g()
  for x in [1, 2]
    bump(!x)
  m: Int? = 3
  if m as v
    bump(!v)
  f(1)

