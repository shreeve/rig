# types: tests whose names start `write`.


fail "write call already lent", "`(!b)` already lends `b` to write: remove the outer `!` and write `(!b).ensure(1, List())`"
  # A receiver already lent to write, `(!b)`, takes no second `!`: the
  # outer one is removed, not parenthesized again.


  b = Map[Int, List[Int]].new()
  !(!b).ensure(1, List()).push(5)
  print(b.len)

fail "write call hint value used", "10:5: write `(!@v).pop()`: a write call whose value is used puts its `!` in parentheses", "18:7: method `pop` needs `self` lent to write; write `(!v).pop()`", "19:3: method `pop` needs `self` lent to write; write `!v.pop()`", "20:5: `pop` does not consume `self`; it writes it: `(!v).pop()`, and its result needs no `<`", "21:5: `pop` writes `self`: write `(!v).pop()`; to lend the call's result, write `?(v.pop())`", "22:5: write `(!w).pop()`: the call writes `w`", "23:5: `take` changes `self`, a temporary no name holds; add `!`: `(!mk()).take()`", errors: 7
  # A hint that writes a write call writes it as the call is used: the
  # long form `(!v).m(...)` where its value is used, and the short form
  # where it is discarded, so following a hint never draws the error that
  # a write call whose value is used puts its `!` in parentheses.

  obj Box2
    v: List[Int]

    fun take(!@) -> Int?
      !@v.pop()

  fun mk() -> Box2
    Box2(v: List())

  v: List[Int] = List()
  w = !v
  b = mk()
  x = v.pop()
  v.pop()
  y = <v.pop()
  z = ?v.pop()
  q = w.pop()
  s = mk().take()
  print(x, y, z, q, s, b.v.len)

fail "write lend constant", "56:7: cannot lend constant `Color.red` to write: it lives for the whole program and never changes", "57:7: cannot lend constant `E.bad` to write", "58:7: cannot lend constant `false` to write", "59:7: cannot lend constant `\"abc\"` to write", "60:7: cannot lend constant `none` to write", "61:6: cannot lend constant `5` to write", "62:6: cannot lend constant `-5` to write", "63:7: cannot lend constant `2 + 3` to write", "64:8: cannot lend constant `not true` to write", "65:8: cannot lend constant `Color.red if f(1) == 1 else Color.green` to write", "66:6: cannot lend constant `Int.max` to write", "67:7: cannot lend constant `U8.max` to write", "68:7: cannot lend constant `Int.max - 1` to write", "69:7: cannot lend constant `f` to write", "70:7: cannot lend constant `P.origin` to write", errors: 15
  # A constant lives for the whole program and never changes (Core
  # sentence 7), so it is never lent to write: a literal, `none`, an enum
  # variant that holds no payload, an error value, a number type's limit,
  # a function or a type's function, a module's constant, an operator
  # applied to constants, or a value that branches, every value of which
  # is a constant. One that may be a value made at run time is a
  # temporary instead, lent to write in its statement's slot
  # (`test/behavior/ownership/write_lend_temporary_branches.rig`); a binding that holds a function is a name like any
  # other (`test/behavior/types/write_lend_function_binding.rig`).
  # (Another module's: `modules/foreign_variant_write`.)

  enum Color
    red
    green

  error E
    bad
    worse

  sub setc(c: !Color)
    c = .green

  sub sete(e: !E)
    e = .worse

  sub setb(b: !Bool)
    b = true

  sub sets(s: !String)
    s = String("x")

  sub seto(o: !Int?)
    o = 1

  sub inc(n: !Int)
    n += 1

  sub setu(u: !U8)
    u = 1

  obj P
    x: Int

    fun origin() -> P
      P(x: 0)

  sub setf(g: !fun(Int) -> Int)
    print(g(1))

  sub setp(g: !fun() -> P)
    print(g().x)

  fun f(n: Int) -> Int
    n

  setc(!Color.red)
  sete(!E.bad)
  setb(!false)
  sets(!"abc")
  seto(!none)
  inc(!5)
  inc(!-5)
  inc(!(2 + 3))
  setb(!(not true))
  setc(!(Color.red if f(1) == 1 else Color.green))
  inc(!Int.max)
  setu(!U8.max)
  inc(!(Int.max - 1))
  setf(!f)
  setp(!P.origin)

test "write lend function binding", '''
  1
  20
'''
  # A binding that holds a function is a name like any other: it may be
  # lent to write, and the callee may re-point it. A function itself is a
  # constant (`test/reject/types/write_lend_constant.rig`).

  fun f(n: Int) -> Int
    n

  fun g(n: Int) -> Int
    n * 10

  sub setf(h: !fun(Int) -> Int)
    print(h(1))
    h = g

  h = f
  setf(!h)
  print(h(2))

fail "write receiver branches", "14:2: method `bump` writes `self`, and `p if c else q` may be `p`, a value a name holds", "15:2: method `bump` writes `self`, and `o ?? q` may be `o`, a value a name holds", "16:3: method `bump` needs `self` lent to write; write `!p.bump()`", errors: 3
  # A `!@` method writes its receiver: a branching value that may be a
  # name's would be written as a copy (plain data too), and a place is
  # lent with `!`.
  obj P
    x: Int

    sub bump(!@)
      @x += 1

  p = P(x: 1)
  q = P(x: 2)
  o: P? = P(x: 3)
  c = true
  (p if c else q).bump()
  (o ?? q).bump()
  p.bump()
  print(p.x, q.x)

test "write self assign", '''
  6
  0
'''
  # `!@` is assignable: a method can replace the whole receiver.

  obj Counter
    n: Int

    sub reset(!@)
      @ = Counter(n: 0)

    sub bump(!@)
      @n += 1

  c = Counter(n: 5)
  !c.bump()
  print(c.n)
  !c.reset()
  print(c.n)

test "write slice", '''
  [9, 9, 3, 4]
  [9, 9, 13, 14]
  [7, 18, 13, 14] 4 52 31
  [7, 99, 13, 14]
  [0, 0, 0, 0]
  [1, 12, 13, 4]
  66
  [11, 20, 35]
  0 0
  [0, 1, 2, 3]
'''
  # `!xs[a..b]` is a `![]T`: a write view of the elements from `a` up to
  # `b`, of an array or a List of plain data. Its elements are assigned
  # with `s[i] = v`, written in a loop with `for x in !s`, and resliced
  # with `!s[a..b]`. It is accepted where a `[]T` is expected.

  obj Grid
    cells: [4]Int

  fun total(xs: []Int) -> Int
    n = 0
    for x in xs
      n += x
    n

  sub fill(s: ![]Int, v: Int)
    for x in !s
      x = v

  sub bump(s: ![]Int)
    i = 0
    while i < s.len : i += 1
      s[i] += 10

  fun tail(s: ![]Int) -> ![]Int
    !s[1..]

  sub clear(a: ![4]Int)
    fill(!a[..], 0)

  a = [1, 2, 3, 4]
  fill(!a[0..2], 9)
  print(a)
  bump(!a[2..])
  print(a)
  w = !a[..]
  w[0] = 7
  w[1] *= 2
  print(w, w.len, total(w), total(?w[1..3]))
  t = tail(!a[..])
  t[0] = 99
  print(a)
  clear(!a)
  print(a)
  g = Grid(cells: [1, 2, 3, 4])
  bump(!g.cells[1..3])
  print(g.cells)
  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  !v.push(3)
  for x in !v[1..]
    x *= 5
  s = !v[..]
  bump(!s)
  bump(!s[2..])
  print(total(s))
  print(v)
  z = !a[2..2]
  print(z.len, total(z))
  for x, i in !a[..]
    x = i
  print(a)

test "write slice as read", '''
  3
  1 [1, 2, 3]
  [5, 2, 3]
'''
  # A `![]T` passed where a `[]T` is expected is lent to read: two reads
  # of it in one call are fine, and so is reading it while a view returned
  # from it lives.

  fun sum2(x: []Int, y: []Int) -> Int
    x[0] + y[1]

  fun id(s: []Int) -> []Int
    s

  a = [1, 2, 3]
  w = !a[..]
  print(sum2(w, w))
  r = id(w)
  print(w[0], r)
  w[0] = 5
  print(a)

test "write slice empty", '''
  0 []
  []
  0
  0
  0 0
  1 [3, 2, 1]
  0
  true
'''
  # Empty and nested write slices: at the end of an array, of an empty array
  # or List or String, reslices down to nothing, and a generic `![]T`.

  fun first[T](s: ![]T) -> T
    t = s[0]
    s[0] = s[s.len - 1]
    s[s.len - 1] = t
    t

  a = [1, 2, 3]
  z = !a[3..]
  print(z.len, z)
  !z.fill(9)
  k = [7]
  !z.copy(?k[1..])
  e: [0]Int = []
  !e.fill(1)
  print(e)
  v: List[Int] = List()
  w = !v[..]
  !w.fill(4)
  print(w.len)
  b: [0]U8 = []
  eb = !b[..]
  print(eb.len)
  s = ""
  print(s[..].len, s[0..].len)
  print(first(!a[..]), a)
  n = !a[1..]
  m = !n[1..]
  o = !m[..0]
  print(o.len)
  print(?a[..] == ?a[..])

