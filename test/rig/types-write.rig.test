test "write view param replaces value", '''
  1
  20
  2
'''
  # Assigning a `!T` parameter replaces the caller's value; the old value is
  # dropped first.

  obj Wrap
    v: Int

    drop(!@)
      print(@v)

  sub replace(b: !Wrap)
    b = Wrap(v: 2)

  x = Wrap(v: 1)
  replace(!x)
  print(x.v * 10)

fail "write view read slice", "8:4: cannot lend a `[]Int` to write: its elements are read-only", "12:6: cannot lend a `[]Int` to write: its elements are read-only", "15:6: cannot lend a `[]Int` to write: its elements are read-only"
  # A `[]T` is read-only, so a write view of one, which would be a
  # writable `![]T`, is rejected: of a local, a parameter, or a field.

  obj View
    xs: []Int

  fun widen(t: []Int) -> ![]Int
    !t

  a = [1, 2, 3]
  t = ?a[..]
  w = !t
  w[0] = 5
  v = View(xs: ?a[..])
  u = !v.xs
  u[0] = 9
  print(a)

