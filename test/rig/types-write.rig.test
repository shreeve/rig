fail "write slice param assign", "5:7: cannot point parameter `s` at another place: parameters are immutable, and `s[i] = v` writes its elements"
  # A `![]T` parameter views the caller's elements: it is written element
  # by element, and never points elsewhere.

  sub f(s: ![]Int, t: ![]Int)
    s = <t
    s[0] = 7

  a = [1, 2]
  b = [3, 4]
  f(!a[..], !b[..])

test "write slice places", '''
  1
  1
  2
  3
  [1, 2]
  [4, 5, 42]
  [[1, 2, 3], [0, 5, 6]]
  [7, 80, 9]
  [1, 20, 3]
  [30]
  0
  [1, 20, 33]
'''
  # A write slice of an array anywhere a place reaches one: a row of a 2D
  # array, a field of an element of a `![]T` or a List, and a parameter.
  # A `![]T` also goes where a generic `[]T` does, is returned from a
  # `!List[T]` parameter, may be empty, and moves with `<`.

  obj S
    arr: [3]Int

  fun first[T](xs: []T) -> T
    xs[0]

  fun head(xs: []S) -> []Int
    ?xs[0].arr[0..2]

  sub poke(s: ![]Int)
    s[0] = 20

  sub setrow(s: ![]S)
    w = !s[1].arr[..]
    w[2] = 42

  fun items(v: !List[Int]) -> ![]Int
    !v[..]

  a = [1, 2, 3]
  w = !a[..]
  print(first(w))
  for x in w
    print(x)
  bs = [S(arr: [1, 2, 3]), S(arr: [4, 5, 6])]
  print(head(?bs[..]))
  setrow(!bs[..])
  print(bs[1].arr)
  grid = [[1, 2, 3], [4, 5, 6]]
  r = !grid[1][..]
  r[0] = 0
  print(grid)
  vs: List[S] = List()
  !vs.push(S(arr: [7, 8, 9]))
  q = !vs[0].arr[1..]
  q[0] = 80
  print(vs[0].arr)
  poke(!a[1..])
  print(a)
  v: List[Int] = List()
  !v.push(3)
  it = items(!v)
  it[0] = 30
  print(v)
  e: [0]Int = []
  z = !e[..]
  print(z.len)
  m = !a[..]
  n = <m
  n[2] = 33
  print(a)

test "write slice quicksort", '''
  [-2, 0, 1, 3, 3, 5, 5, 7, 8, 9]
  [4, 1, 2, 3]
  [7]
'''
  # An in-place quicksort over a `![]Int`: each half is a reslice of the
  # write view, passed on to the recursive call.

  sub quicksort(s: ![]Int)
    if s.len < 2
      return
    last = s.len - 1
    pivot = s[last]
    i = 0
    j = 0
    while j < last : j += 1
      if s[j] < pivot
        !s.swap(i, j)
        i += 1
    !s.swap(i, last)
    quicksort(!s[..i])
    quicksort(!s[i + 1..])

  a = [5, 3, 9, 1, 5, 8, -2, 7, 0, 3]
  quicksort(!a[..])
  print(a)
  v: List[Int] = List()
  for x in [4, 1, 3, 2]
    !v.push(x)
  quicksort(!v[1..])
  print(v)
  e = [7]
  quicksort(!e[..])
  quicksort(!e[1..])
  print(e)

