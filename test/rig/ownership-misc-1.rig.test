fail "coalesce jump checks rest", "14:8: use of `a` after move", "21:3: cannot reassign `a` while it is lent", "29:10: use of `a` after move", "36:10: use of `a` after move"
  # The jump after `??` is taken only when the value is `none`: the code
  # after it still runs, and is checked like any other.

  fun make(k: Int) -> Int?
    k if k > 0 else none

  sub eat(v: List[Int])
    print(v.len)

  fun ret(k: Int) -> Int
    a: List[Int] = List()
    n = make(k) ?? return -1
    eat(<a)
    eat(<a)
    n

  fun lent(k: Int) -> Int
    a: List[Int] = List()
    r = ?a
    n = make(k) ?? return -1
    a = List()
    print(r.len)
    n

  sub brk()
    a: List[Int] = List()
    while true
      n = make(1) ?? break
      eat(<a)
      print(n)

  sub cont()
    a: List[Int] = List()
    for k in 0..3
      n = make(k) ?? continue
      eat(<a)
      print(n)

  print(ret(1), lent(1))
  brk()
  cont()

test "coalesce jump owning", '''
  drop 5
  5 -3
  drop 1
  1 -1
  drop 3
  6 -2
  got 1
  drop 1
  got 2
  drop 2
'''
  # With a jump as its fallback, `??` takes an owning value out of a
  # temporary or a moved optional: nothing is copied, and on `none` the
  # jump leaves.

  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun make(k: Int) -> Res?
    Res(id: k) if k > 0 else none

  fun ident(k: Int) -> Int
    r = make(k) ?? return -1
    r.id

  fun take(k: Int) -> Int
    o = make(k)
    r = <o ?? return -2
    r.id * 2

  obj Holder
    r: Res?

  fun out(h: !Holder) -> Int
    r = <h.r ?? return -3
    r.id

  h = Holder(r: Res(id: 5))
  print(out(!h), out(!h))
  print(ident(1), ident(0))
  print(take(3), take(0))
  for k in 0..3
    r = make(k) ?? continue
    print("got", r.id)

fail "coalesce jump owning place", "11:7: `o` owns a `Res?`, which can't be copied by `=`: write `<o` to move it or `?o` to view it"
  # `??` taking the value out of an optional a binding still holds would
  # copy an owner; move it out with `<o ?? return`.

  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun first(o: Res?) -> Int
    r = o ?? return 0
    r.id

  print(first(Res(id: 1)))

fail "coalesce jump viewed optional", "9:7: a view cannot give up the resource inside it; lend the value inside with `if o as value`", "13:7: a view cannot give up the resource inside it; lend the value inside with `if !o as value`", "22:5: a view cannot give up the resource inside it; lend the value inside with `if lend(?h) as value`"
  # `x ?? return` hands over the optional's value only when `x` owns it.
  # Through a view of an optional the handle inside still belongs to
  # the lender, so taking it out would free it twice.

  obj N
    v: Int

  sub take_read(o: ?*N?)
    n = <o ?? return
    print(n.v)

  sub take_write(o: !*N?)
    n = <o ?? return
    print(n.v)

  fun lend(o: ?*N?) -> ?*N?
    o

  h: *N? = *N(v: 1)
  take_read(?h)
  take_write(!h)
  n = lend(?h) ?? return
  print(n.v)

test "coalesce view jump", '''
  5
  3
  10
  none
  4 -1
'''
  # A jump as the fallback of `??` leaves the view as it is: a binding
  # with no type reads a view of a number as the number, so `n` keeps no
  # loan, while `p`, a view of an object, keeps the Map lent and is
  # written `?q.get(k)`. The view a fallback form gives copies out where
  # its value is expected, so `z: Int` keeps no loan either, and `none`
  # where an optional view is expected keeps the view.


  obj P
    x: Int

  fun total(m: ?Map[String, Int], keys: []Static) -> Int
    t = 0
    for k in keys
      n = m.get(k) ?? continue
      t += n
    t

  fun x_of(q: ?Map[String, P], k: ?String) -> Int
    p = ?q.get(k) ?? return -1
    p.x

  m = Map[String, Int]()
  !m.put(String("a"), 2)
  !m.put(String("b"), 3)
  print(total(?m, ["a", "c", "b"]))
  for k in ["a", "c"]
    n = m.get(k) ?? break
    !m.put(String("d"), n)
  print(m.len)
  d = 10
  z: Int = m.get("x") ?? ?d
  !m.put(String("x"), z)
  print(m.get("x") ?? 0)
  o: (?Int)? = ?m.get("q") ?? none
  print(o)
  q = Map[String, P]()
  !q.put(String("a"), P(x: 4))
  print(x_of(?q, "a"), x_of(?q, "b"))

fail "coalesce view value keeps views", "12:1: cannot lend `s` to write while a read loan is live"
  # A value `??` copies out of a view keeps the loans of the views it
  # holds: `h` holds a view of `s`, so `s` is not changed while `h` lives.


  obj H
    s: ?String

  s = String("held")
  hs = Map[String, H]()
  !hs.put(String("a"), H(s: ?s))
  h = hs.get("a") ?? H(s: "none")
  !s.add("!")
  print(h.s)

test "conditional move no later use", '''
  1
  drop
  after
  after
  drop
'''
