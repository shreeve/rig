test "loop move then break", '''
  42
  42
  drop
  done
'''
  # A move followed by `break` leaves the loop, so the rest of the loop
  # body and later iterations still see the value.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  sub eat(rc: *Wrap)
    print(rc.payload)

  rc = *Wrap(payload: 42)
  i = 0
  while i < 3
    if i == 1
      eat(<rc)
      break
    print(rc.payload + i)
    i += 1
  print("done")

fail "loop move then continue", "15:10: use of `rc` after move", "17:9: use of `rc` after move"
  # A move followed by `continue` reaches the loop head, so the next
  # iteration sees the value moved.

  obj Wrap
    payload: Int

  sub eat(rc: *Wrap)
    print(rc.payload)

  rc = *Wrap(payload: 1)
  i = 0
  while i < 3
    i += 1
    if i == 1
      eat(<rc)
      continue
    print(rc.payload)

test "loop move then reassign", '''
  101
  1
  110
  10
  end
  11
'''
  # A resource moved in a loop body and reassigned before the next
  # iteration is live again at the top of the loop; each value is dropped
  # once.

  obj Wrap
    payload: Int

    drop(!@)
      print(@payload)

  sub eat(rc: *Wrap)
    print(rc.payload + 100)

  rc = *Wrap(payload: 1)
  i = 0
  while i < 2
    eat(<rc)
    rc = *Wrap(payload: i + 10)
    i += 1
  print("end")

test "loop move then return", '''
  42
  42
  drop
  done
'''
  # A move followed by `return` leaves the function, so the rest of the
  # loop body and later iterations still see the value.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  sub eat(rc: *Wrap)
    print(rc.payload)

  sub run()
    rc = *Wrap(payload: 42)
    i = 0
    while i < 3
      if i == 1
        eat(<rc)
        return
      print(rc.payload + i)
      i += 1

  run()
  print("done")

fail "loop value break in closure", "5:5: `break` is not inside a loop (a closure body cannot leave a loop around it)"
  # A closure body cannot leave a loop around it, with or without a value.

  x = for i in 0..3
    f = ||
      break 1
    f()
    break i if i == 2
  else
    0
  print(x)

test "loop value moves out", '''
  2
  true
  5
  6
'''
  # A `break` value leaves its loop like a returned value leaves its
  # function: an owning value moves out (the rest of a consumed List is
  # dropped), and a view keeps what it views lent.

  obj Wrap
    n: Int

  fun pick(boxes: List[*Wrap], want: Int) -> *Wrap?
    for b in <boxes
      break <b if b.n == want
    else
      none

  v: List[*Wrap] = List()
  !v.push(*Wrap(n: 1))
  !v.push(*Wrap(n: 2))
  !v.push(*Wrap(n: 3))
  if pick(<v, 2) as b
    print(b.n)
  w: List[*Wrap] = List()
  !w.push(*Wrap(n: 1))
  print(pick(<w, 9) == none)
  u: List[*Wrap] = List()
  !u.push(*Wrap(n: 4))
  !u.push(*Wrap(n: 5))
  fallback = *Wrap(n: 0)
  r = for b in ?u
    break ?b if b.n == 5
  else
    ?fallback
  print(r.n)
  held = *Wrap(n: 6)
  moved = for i in 0..3
    break <held if i == 1
  else
    *Wrap(n: 7)
  print(moved.n)

fail "loop value owning without move", "8:9: `b` is a `*Wrap` handle, which can't be copied out by `break`: write `<b` to move it or `+b` for another handle"
  # A `break` value is consumed: an owning binding is moved with `<b`.

  obj Wrap
    n: Int

  b = *Wrap(n: 1)
  x = for i in 0..3
    break b if i == 2
  else
    *Wrap(n: 0)
  print(x.n)

fail "loop value views loop local", "10:10: `p` does not live long enough"
  # A `break` value may not lend what the loop declared: it goes out of
  # scope as the loop ends.

  obj P
    n: Int

  q = P(n: 0)
  x = for i in 0..3
    p = P(n: i)
    break ?p if i == 2
  else
    ?q
  print(x.n)

test "loop view call arg", '''
  a
  a
  t
  3.0
  1.0
  3.0
'''
  # A bare loop view passed to a view parameter is lent on for the call, as
  # `?s` lends it: over Lists of Strings, objects, and boxes (a boxed
  # element reaches the boxed value's view).

  obj Circle
    r: Float

    fun area(?@) -> Float
      3.0 * @r * @r

  obj Tag
    name: String

  sub text(s: ?String)
    print(s)

  sub tag(t: ?Tag)
    print(t.name)

  sub round(c: ?Circle)
    print(c.area())

  sub boxed(c: ?Circle)
    print(c.r)

  names: List[String] = List()
  !names.push(String("a"))
  for s in names
    text(s)
  for s in ?names
    text(s)
  tags: List[Tag] = List()
  !tags.push(Tag(name: String("t")))
  for t in tags
    tag(t)
  shapes: List[^Circle] = List()
  !shapes.push(^Circle(r: 1.0))
  for c in shapes
    round(c)
    boxed(c)
  for c in ?shapes
    round(c)

test "method plain receiver keeps no loan", '''
  [2, 1, 3]
  [1, 2, 3] 2
'''
  # A method taking `!@` may store what its arguments view in its
  # receiver only when the receiver's type can hold a view: a receiver
  # of plain data keeps none, so the argument's view ends with the call.

  obj Counter
    n: Int

    sub bump(!@, xs: ![]Int)
      @n += 1
      !xs.swap(0, 1)

    sub bump_each[T](!@, xs: ![]T)
      @n += 1
      !xs.swap(0, 1)

  c = Counter(n: 0)
  a = [1, 2, 3]
  !c.bump(!a)
  print(a)
  !c.bump_each(!a)
  print(a, c.n)

fail "method receiver keeps loan", "cannot lend `a` to write while a read loan is live", errors: 1
  # A `!@` receiver whose type holds a view may keep what the
  # method's arguments view, so the view lives as long as it does,
  # even when the receiver is written through a write view.

  obj View
    xs: []Int

    sub point(!@, ys: []Int) keeps ys
      @xs = ys

  a = [1, 2, 3]
  b = [4, 5]
  v = View(xs: ?b)
  !v.point(?a)
  !a.swap(0, 1)
  print(v.xs)

