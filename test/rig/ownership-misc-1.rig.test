test "auto drop after branch drop", '''
  drop
  dropped early
  end
  7
  end
  drop
'''
  # One branch drops the handle explicitly, the other does not; either
  # way the handle is dropped exactly once (the auto-drop is path-aware).

  obj C
    v: Int

    drop(!@)
      print("drop")

  sub run(cond: Bool)
    rc = *C(v: 7)
    if cond
      <rc
      print("dropped early")
    else
      print(rc.v)
    print("end")

  run(true)
  run(false)

test "auto drop early return", '''
  99
  1
  99
  2
'''
  # An early return from inside a conditional still drops the local
  # shared handle, and so does the fall-through return.

  obj C
    v: Int

    drop(!@)
      print(@v)

  fun pick(cond: Bool) -> Int
    rc = *C(v: 99)
    if cond
      return 1
    return 2

  print(pick(true))
  print(pick(false))

test "auto drop in loop", '''
  0
  100
  1
  101
  2
  102
  done
'''
  # A handle declared inside a loop body is dropped at the end of each
  # iteration.

  obj C
    v: Int

    drop(!@)
      print(@v + 100)

  i = 0
  while i < 3
    rc = *C(v: i)
    print(rc.v)
    i += 1
  print("done")

