test "branch receiver change through leaves", release: true, '''
  2
  4
  2
  4
  5
  11
  13
  6
  2
  6
  4 2 13 5 3 a text long enough to live on the heap
  6
'''
  # A `!@` method that changes its receiver through a Cell, called on a
  # branch of shared handles, or on a field or element of one, reaches the
  # leaf the branch takes where it is, through `??` and `catch` too and when
  # the call's arguments are evaluated first: the change lands in that
  # leaf, never in a copy, and nothing drops the leaf but its owner.

  error Bad
    no

  obj Q
    c: Cell[Int]
    t: String

    fun bump(!@) -> Int
      !@c.set(@c.get() + 1)
      @c.get()

    fun bump2(!@, j: Int, k: Int) -> Int
      !@c.set(@c.get() + j)
      @c.get()

  obj H
    q: Q
    qs: [2]*Q

  fun g(k: Int) -> Int
    k

  fun mkq(n: Int) -> *Q
    *Q(c: Cell(n), t: String("a text long enough to live on the heap"))

  fun mkh(n: Int) -> *H
    *H(q: Q(c: Cell(n), t: String("a text long enough to live on the heap")), qs: [mkq(n), mkq(n)])

  fun maybe(c: Bool) -> (*H)?
    if c
      return mkh(5)
    none

  fun fails(b: Bool) -> (*H)!
    if b
      return Bad.no
    mkh(100)

  fun first(o: (*H)?) -> Int?
    (!o?.q).bump()

  h1 = mkh(1)
  h2 = mkh(10)
  c = g(1) == 1
  print((!(h1 if c else h2).q).bump())
  print((!(h1 if c else h2).q).bump2(k: g(1), j: g(2)))
  qs = [mkq(1), mkq(2)]
  rs = [mkq(3), mkq(4)]
  print((!(qs if c else rs)[0]).bump())
  print((!(qs if c else rs)[g(0)]).bump2(g(2), g(1)))
  print((!(qs if c else rs)[0]).bump())
  print((!(h1 if not c else h2).qs[1]).bump())
  print((!(h1 if not c else h2).qs[g(1)]).bump2(g(2), g(1)))
  o = maybe(true)
  print((!(o ?? h1).q).bump())
  print((!(fails(true) catch h1).qs[0]).bump())
  print(first(maybe(true)) ?? 0)
  print(h1.q.c.get(), h1.qs[0].c.get(), h2.qs[1].c.get(), qs[0].c.get(), rs[0].c.get(), qs[0].t)
  if o as x
    print(x.q.c.get())

