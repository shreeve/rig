  a = gid((?p).items)
  b: List[Int] = (?p).items
  ys = [(?p).items, (?p).items]
  c = <(!p).items
  w: (?List[Int])? = (?p).items
  print((?t)[1..3])
  d = (?t)[1..3]
  print(sum((?p).arr))
  f = || (!mk()).x = 5
  match p.x
    1 => (!mk()).x = 5
    _ => pass
  (?p).x = 5
  e = (?p).v.len()
  (!t).push_str("d")
  g = <(?p).items
  poke(k)
  s: ?String = (?p).name
  yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy = add(1111111111, 2222222222, 3333333333, (?p).x) + add(1111111111, 2222222222, 3333333333, 4)
  h = (
    ?p
  ).x
  ((!p)).x = 6
