  # A write-receiver method cannot be called through a shared handle.

  obj User
    age: Int

    sub set_age(!@, n: Int)
      @age = n

  rc = *User(age: 1)
  rc.set_age(5)
  <rc

fail "signal subscriber view", "an owned closure cannot capture `r`, which holds a view of `a`"
  # A Signal keeps its subscribers, owned closures that any handle to the
  # Signal can run, so a subscriber cannot capture a view.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  sig: *Signal[Int] = *Signal(0)
