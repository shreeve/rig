  !v.push(List())
  !v[0].push(5)
  p = P(qs: List(), bx: ^Q(vals: List()))
  !p.qs.push(Q(vals: List()))
  !p.qs[0].vals.push(5)
  !p.bx.vals.push(5)
  w: List[List[Int?]] = List()
  !w.push(List())
  !w[0].push(5)
  h = *Q(vals: List())
  x = v[0][grow(!v)]
  print(v[0][grow(!v)], x)
  print(p.qs[0].vals[grow_q(!p)])
  print(p.bx.vals[rebox(!p)])
  if v[0][grow(!v)] == 5
    print("five")
  match v[0][grow(!v)]
    5 => print("five")
    _ => print("other")
  y = <w[0][grow_o(!w)]
  print(y, at(!v), h.vals[reh(!h)])
  l: *List[Int] = *List()
  print(l[rel(!l)])
  print(v[0][eat(<v)])

test "index writes place root", '''
  [16] 301
  [8] 101 [3]
  4 4
  8 3 3
  5 none 101
  6
'''
  # An index may grow or replace the storage of its place's root where the
  # place is found after the index runs: an assignment's target, found
  # only after its indexes run, whose store lands in the storage the index
  # left, through an element, a field of an element, or a box; and a read
  # or a take of an element whose List lies in the root's own storage (a
  # local, a field of one, an element of an array, what a write view
  # views), which is found where it was and read after the index runs; and
  # a read past another buffer whose index writes only a sibling field.
  # (Past a List's buffer, a box, or a handle, a read is rejected:
  # test/reject/ownership/index_of_read_place.rig.)

  obj Q
    vals: List[Int]

  obj P
    qs: List[Q]
    bx: ^Q
    v: List[Int]

  fun grow(v: !List[List[Int]]) -> Int
    for _ in 0..100
      !v.push(List())
    0

  fun grow_q(p: !P) -> Int
    for _ in 0..100
      !p.qs.push(Q(vals: List()))
    0

  fun rebox(p: !P) -> Int
    n: List[Int] = List()
    !n.push(1)
    p.bx = ^Q(vals: <n)
    0

  fun refill(p: !P) -> Int
    n: List[Int] = List()
    !n.push(4)
    p.v = <n
    0

  fun grow_o(v: !List[Int?]) -> Int
    for _ in 0..100
      !v.push(none)
    0

  fun swap0(a: ![2]List[Int]) -> Int
    n: List[Int] = List()
    !n.push(6)
    a[0] = <n
    0

  fun pushv(l: !List[Int]) -> Int
    !l.push(0)
    0

  fun at(p: !P) -> Int
    p.v[refill(!p)]

  v: List[List[Int]] = List()
  !v.push(List())
  !v[0].push(5)
  v[0][grow(!v)] = 9
  v[0][grow(!v)] += 7
  v[0][0] += grow(!v)
  print(v[0], v.len)
  p = P(qs: List(), bx: ^Q(vals: List()), v: List())
  !p.qs.push(Q(vals: List()))
  !p.qs[0].vals.push(5)
  !p.bx.vals.push(5)
  !p.v.push(3)
  p.qs[0].vals[grow_q(!p)] = 8
  p.bx.vals[rebox(!p)] += 2
  print(p.qs[0].vals, p.qs.len, p.bx.vals)
  print(p.v[refill(!p)], at(!p))
  print(p.qs[0].vals[pushv(!p.v)], p.bx.vals[pushv(!p.v)], p.v.len)
  o: List[Int?] = List()
  !o.push(5)
  x = <o[grow_o(!o)]
  print(x, o[0], o.len)
  a: [2]List[Int] = [List(), List()]
  !a[0].push(5)
  print(a[0][swap0(!a)])

test "index writes slice root", release: true, '''
  3 [8, 3]
  5 [6, 5]
'''
  # A slice root's index may lend it to write: a lend of a slice writes the
  # elements it views but never moves or frees them, so the element is
  # read after the index runs, as it left it (the sorting shape,
  # `xs[partition(!xs)]`).


  fun partition(xs: ![]Int) -> Int
    t = xs[0]
    xs[0] = xs[1]
    xs[1] = t
    1

  fun pick(xs: ![]Int) -> Int
    xs[partition(!xs)]

  v: List[Int] = List()
  !v.push(3)
  !v.push(8)
  print(pick(!v[..]), v)
  a = [5, 6]
  print(pick(!a[..]), a)

fail "joined as failing part stores", "19:28: `x` does not live long enough", "27:31: `x` does not live long enough"
  # When a later part of `if a as x and ...` or `while a as x and ...`
  # fails, `x` goes out of scope; a view of it that the part stored in
  # an outer value cannot survive, even when the body never falls through.

  obj Big
    v: List[Int]

  obj View
    b: ?Big

  fun put(v: !View, t: ?Big) -> Bool keeps t
    v.b = t
    false

  sub viaIf()
    x0 = Big(v: List())
    vw = View(b: ?x0)
    o: Big? = Big(v: List())
    if <o as x and put(!vw, ?x)
      return
    print(vw.b.v.len)

  sub viaWhile()
    x0 = Big(v: List())
    vw = View(b: ?x0)
    o: Big? = Big(v: List())
    while <o as x and put(!vw, ?x)
      return
    print(vw.b.v.len)

  viaIf()
  viaWhile()

test "jump fallback moves", '''
  1 2
  3
  -1
  0
'''
  # A jump fallback leaves the scope: what it moves (`?? return <v`) is
  # moved only on that path, and `?? break value` gives a loop its value.

  fun pick(o: Int?) -> List[Int]
    v: List[Int] = List()
    !v.push(1)
    n = o ?? return <v
    !v.push(n)
    <v

  fun total(xs: ?List[Int?]) -> Int
    sum = for x in xs
      n = x ?? break -1
      print(n)
    else
      0
    sum

  p1 = pick(none)
  p2 = pick(5)
  print(p1.len, p2.len)
  a: List[Int?] = List()
  !a.push(3)
  !a.push(none)
  print(total(?a))
  b = List[Int?]()
  print(total(?b))

fail "jump outside loop", "`break` is not inside a loop (a closure body cannot leave a loop around it)", "`continue $outer` names no enclosing loop or block (a closure body cannot leave a loop around it)", "`break $nowhere` names no enclosing loop or block", "`continue` is not inside a loop"
  # `break` and `continue` must name an enclosing loop (or, for `break`, a
  # labeled block); a closure body cannot leave a loop around it.

  for i in 0..3
    f = ||
      break
    f()
  $outer: for i in 0..3
    g = ||
      for j in 0..3
        continue $outer
    g()
  while true
    break $nowhere

  sub stray()
    continue

fail "kept lend unwritten function value", "18:7: `f(!b, t)` keeps `t` lent in what `f` stores; write `f(!b, ?t)`"
  # Why: a call through a function value keeps what its type could hold
  # (Core sentence 7), so `f` may keep `t` in `b`; the lend outlasts the
  # statement and is written `?t`.
  # Rule: a lend is written wherever its view may outlast its statement,
  # as when the call it is lent to keeps it (Core sentence 4).
  # From: the keeps Core review (Rust expert).

  obj B
    src: ?String
    n: Int

  sub note(b: !B, s: ?String)
    b.n += s.len

  b = B(src: "", n: 0)
  f: ?sub(!B, ?String) = ?note
  t = String("abc")
  f(!b, t)
  print(b.n)

