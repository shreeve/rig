test "copies clone capture", '''
  1 2
  2 hi!
  3
  3 5
  3
  3
  2
  1 2
  drop 2
  drop 1
'''
  # `|+x|` captures what `+x` gives (Core §7): a copy of a value that
  # copies, read through a view; a handle counted again; and a deep copy
  # of an owner, a Text, or an array of handles, which the closure drops.
  # The owner may change afterward without the closure seeing it.

  obj P
    x: Int

  obj N
    v: Int

    drop(!@)
      print("drop", @v)

  obj S
    r: ?List[Int]

  obj R
    r: ?Int

  # Through a view, the copy keeps what the value holds, not the view's
  # loan on its holder, which may then change.
  sub through_view()
    n = 1
    m = 2
    s = R(r: ?n)
    v = ?s
    f = |+v| v.r
    s = R(r: ?m)
    print(f(), s.r)

  v: List[Int] = List()
  !v.push(1)
  f = |+v| v.len
  !v.push(2)
  print(f(), v.len)
  t = String("hi")
  g = |+t| t.len
  !t.add("!")
  print(g(), t)
  r = ?t
  k = |+r| r.len
  print(k())
  p = P(x: 3)
  rp = ?p
  m = |+rp| rp.x
  n = 4
  rn = ?n
  i = |+rn| rn + 1
  print(m(), i())
  hs = [*N(v: 1), *N(v: 2)]
  c = |+hs| hs[0].v + hs[1].v
  print(c())
  <hs
  print(c())
  s = S(r: ?v)
  l = |+s| s.r.len
  print(l())
  through_view()

test "copies coalesce catch views", '''
  1 1 2
  1 2 2
  9
  1
'''
  # `??` and `catch` whose value is a view are copied out where the value
  # is expected (Core §4), as any view is, and a function returns a
  # fallible view as the view: a `(?P)!` gives the pointer, an error value
  # itself.

  error Bad
    oops

  obj P
    x: Int

  fun pick(o: (?P)?, r: ?P) -> P
    o ?? r

  fun get(r: ?P, ok: Bool) -> (?P)!
    if not ok
      return Bad.oops
    r

  fun get2(r: ?P, ok: Bool) -> (?P)!
    return get(r, ok)!

  fun wget(w: !P) -> (!P)!
    w

  fun opt(r: ?P, ok: Bool) -> (?P)?!
    return Bad.oops if not ok
    r

  a = P(x: 1)
  b = P(x: 2)
  o: (?P)? = ?a
  c: P = o ?? ?b
  print(c.x, pick(o, ?b).x, pick(none, ?b).x)
  v = get(?a, true) catch ?b
  u = get2(?a, false) catch ?b
  d: P = get(?a, false) catch ?b
  print(v.x, u.x, d.x)
  w = wget(!b) catch !a
  w.x = 9
  print(b.x)
  q = opt(?a, true) catch none
  if q as p
    print(p.x)

test "copies fallback into optional", '''
  1 2 1 2
  1 1 2
'''
  # A `??` or `catch` whose value is a view is copied out where an optional
  # of its value is expected (Core §4), as where the value is: a typed
  # binding, an argument, a field, a result. The whole `??` or `catch`
  # gives the view, then its value is copied out.

  error Bad
    oops

  obj P
    x: Int

  obj S
    o: P?

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  fun pick(i: (?P)?, r: ?P) -> P?
    i ?? r

  fun get(r: ?P, ok: Bool) -> (?P)!
    return Bad.oops if not ok
    r

  a = P(x: 1)
  b = P(x: 2)
  i: (?P)? = ?a
  n: (?P)? = none
  f: P? = i ?? ?b
  g: P? = n ?? ?b
  print(px(f), px(g), px(i ?? ?b), px(pick(n, ?b)))
  s = S(o: i ?? ?b)
  o: P? = get(?a, true) catch ?b
  q: P? = get(?a, false) catch ?b
  print(px(s.o), px(o), px(q))

test "copies fill read views", '''
  1
  2 2
  [1, 1, 2]
  5 6
  ab
  abcd
  4
  [2, 2] [3, 2]
'''
  # `[n of x]`, `fill`, and `copy` duplicate values that copy, read views
  # included (Core §5): every copy of a view carries its loan, so the
  # viewed value may not change while the array is used, and may once it
  # is not. `copy` copies the views its source's elements hold, not a view
  # of the source, which may then change. In a generic body, `[n of x]`
  # of a `?T` copies the view.

  fun twice[T](x: ?T) -> [2]?T
    [2 of x]

  n = 1
  m = 2
  a = [3 of ?n]
  print(a[2])
  !a.fill(?m)
  print(a[0], a[2])
  b = [?n, ?n]
  !a[..2].copy(?b[..])
  print(a)
  n = 5
  m = 6
  print(n, m)
  t = String("abc")
  s = [2 of ?t[..2]]
  print(s[1])
  !t.add("d")
  print(t)
  k = 4
  print(twice(?k)[1])
  p = 1
  q = 2
  r = 3
  c = [?p, ?p]
  d = [?q, ?q]
  !c.copy(?d[..])
  d[0] = ?r
  print(c, d)

