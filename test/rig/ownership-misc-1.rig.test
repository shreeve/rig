test "function field through write self", "195 99"
  # A function held in a field is called with its arguments alone, so a
  # `!@` method may lend it a view of a local: nothing of `@` can
  # keep the view.

  obj Map[K]
    hash: fun(?K) -> U64
    n: Int

    sub put(!@, k: K)
      x = @hash(?k)
      @n += Int(x)

    fun slot(!@, k: ?K) -> U64
      @hash(k)

