  N(id: 8, t: "o")
  8
  drop 8
  1
  1
  drop 1
'''
  # A read passes through a branching value to its leaves: a name is read
  # where it is, and a value made there is a temporary. A branching value
  # whose every leaf is made there is one temporary, dropped when its
  # statement ends; `o?` reads `o` in place.

  obj N
    id: Int
    t: String

    drop(!@)
      print("drop", @id)

  fun mk(id: Int) -> N
    N(id: id, t: String("m"))

  fun maybe(id: Int) -> N?
    N(id: id, t: String("o"))

  fun show(o: N?) -> Int?
    print(o?)
    print(o?.id)
    1

  a = mk(1)
  c = true
  print(a if c else mk(2))
  print(a if not c else mk(3), "then")
  print(maybe(4) if c else none, "then")
  print(maybe(5) if not c else none, "then")
  print(mk(6) if c else mk(7), "then")
  print(show(maybe(8)))
  print(a.id)

test "reads pass through branches", '''
  N(id: 1, t: "a")
  N(id: 9, t: "m")
  drop 9
  none none none none
  aaaa
  true 2
  N(id: 6, t: "x") y
  N(id: 6, t: "x") 8
  drop 8
  aaaa aaaa
  aaaa bb 6 7
  drop 7
  drop 6
  drop 2
  drop 1
'''
  # Reading never moves a name: a read passes through `a if c else b`,
  # `??`, `catch`, `e!`, and `e?` to their operands. A name there is read
  # where it is; a value made there is a temporary its statement drops.


  obj N
    id: Int
    t: String

    drop(!@)
      print("drop", @id)

  fun mk() -> N
    N(id: 9, t: String("m"))

  error E
    bad

  fun fails(n: Int) -> N!
    return E.bad if n > 0
    N(id: 8, t: String("f"))

  fun f(o: N?, c: Bool) -> Int?
    print(mk() if c else o?)
    print(o?)
    1

  fun g(o: String?) -> Int?
    print(o?.len)
    print(o? == "hi")
    1

  fun h(o: List[Int]?) -> Int?
    print(o?[0])
    1

  fun k(o: (N?)?) -> Int?
    print(o? ?? N(id: 5, t: String("e")))
    1

  oa: N? = N(id: 1, t: String("a"))
  ob: N? = N(id: 2, t: String("b"))
  c = true
  print((oa if c else ob) ?? N(id: 3, t: String("c")))
  print(f(none, c), g(none), h(none), k(none))
  a = String("aaaa")
  b = String("bb")
  print(a if c else b)
  print((a if c else b) == "aaaa", (b if c else a).len)
  m = N(id: 6, t: String("x"))
  n = N(id: 7, t: String("y"))
  print(m if c else n, (n if c else m).t)
  print(fails(1) catch m, (fails(0) catch n).id)
  print(?a if c else ?b, text.trim(?a if c else ?b))
  print(a, b, m.id, n.id)

test "reassign after move", '''
  101
  1
  2
  2
'''
  # Reassigning a moved binding makes it usable again.

  obj Wrap
    payload: Int

    drop(!@)
      print(@payload)

  sub eat(rc: *Wrap)
    print(rc.payload + 100)

  rc = *Wrap(payload: 1)
  eat(<rc)
  rc = *Wrap(payload: 2)
  print(rc.payload)

fail "reassign fixed binding", "cannot reassign fixed binding `user`"
  # A binding made with `=!` is fixed and cannot be reassigned.

  obj User
    name: ?String

  fun loadUser(id: Int) -> User
    User(name: "Steve")

  user =! loadUser(1)
  user = loadUser(2)

test "reassign shared drops old", '''
  111
  22
  122
'''
  # Reassigning a shared-handle binding drops the previous handle at the
  # reassignment; the new one is dropped at scope exit.

  obj Counter
    value: Int

    drop(!@)
      print(@value + 100)

  rc = *Counter(value: 11)
  rc = *Counter(value: 22)
  print(rc.value)

test "rebind local write view", "11 20"
  # `new w = !y` points the name of a local write view at another value;
  # the first is free again once nothing views it.

  obj Wrap
    n: Int

  x = Wrap(n: 1)
  y = Wrap(n: 2)
  w = !x
  w.n = 10
  new w = !y
  w.n = 20
  x.n += 1
  print(x.n, y.n)

test "rebind local write view by move", "5 3 3"
  # `new w = <w2` points a local write view's name at the place `w2`
  # viewed, as `new w = !n` would; a bare `w = w3` writes the value `w3`
  # reaches through `w`.

  m = 1
  n = 2
  k = 3
  w = !m
  w = 5
  w2 = !n
  new w = <w2
  w = 6
  w3 = !k
  w = w3
  print(m, n, k)

fail "recheck implicit lend argument", "cannot lend `b` to write while a write loan is live"
  # An argument lent implicitly (a closure where a `?fun` goes) in a call
  # that is checked twice, once to classify the assignment it is the
  # right side of, keeps its one use: the check goes on to the ownership
  # rules.

  fun pick(f: ?fun() -> Int, x: !String, y: !String) -> !String
    y

  a = String("a")
  b = String("b")
  w = !a
  f = |?w| w.len
  w = pick(?f, !b, !b)
  print(a)

fail "replace element while sibling lent", "9:13: cannot lend `v` to write while a read loan is live"
  # `swap(!v[1], ...)` writes into `v`'s buffer, and an index is a
  # run-time value, so it may be `v[0]`, which `r` views: `replace` of an
  # element lends the whole list to write.

  v: List[String] = List()
  !v.push(String("a"))
  !v.push(String("b"))
  r = ?v[0]
  old = swap(!v[1], String("c"))
  print(r, old)

test "replace error place", '''
  net disk 2
  disk net
  net disk
  net
'''
  # `error` is owning: `replace` takes it out of a field, local, or list
  # element and hands it back owned, and the place may be written while the
  # value lives; it is dropped once.

  error Net
    timeout

  error Disk
    full

  fun describe(e: ?error) -> ?String
    match e
      Net.timeout => "net"
      Disk.full => "disk"
      _ => "other"

  obj Failure
    at: Int
    err: error

  f = Failure(at: 1, err: Net.timeout)
  old = swap(!f.err, Disk.full)
  f.at = 2
  print(describe(?old), describe(?f.err), f.at)
  e: error = Disk.full
  was = swap(!e, Net.timeout)
  print(describe(?was), describe(?e))
  es: List[error] = List()
  !es.push(Net.timeout)
  first = swap(!es[0], <was)
  print(describe(?first), describe(?es[0]))
  _ = swap(!f.err, <old)
  print(describe(?f.err))

fail "replace place lent during call", "12:22: cannot lend `s` to read while a write loan is live"
  # `swap(!s, v)` lends `s` to write for the call; the argument
  # `make(?s)` reads `s` after that lend, so a view of the old value could
  # meet the new one.

  obj S
    name: String

  fun make(s: ?S) -> S
    S(name: String(s.name, "!"))

  s = S(name: String("a"))
  old = swap(!s, make(?s))
  print(old.name, s.name)

test "replace save restore field", "1 a.ts 1"
  # Saving a field by `replace` and restoring it is a take and two stores:
  # the saved value carries what the field held, not a loan on `@`, so
  # `@` may be written while it is saved (the save-and-restore of a
  # checker's flow state).

  obj Flow
    file: ?String
    labels: List[String]
    stack: List[Int]

  obj Checker
    flow: Flow
    depth: Int

    sub check_cached(!@)
      saved = swap(!@flow, Flow(file: "", labels: List(), stack: List()))
      @depth += 1
      !@flow.stack.push(@depth)
      @flow = <saved

  f = "a.ts"
  c = Checker(flow: Flow(file: ?f, labels: List(), stack: List()), depth: 0)
  !c.flow.stack.push(9)
  !c.check_cached()
  print(c.flow.stack.len, c.flow.file, c.depth)

test "replace take and restore", "abc"
  # `swap(!p, v)` is a take then a store, `t = <p; p = v`: its result
  # carries what `p`'s value held (here the loan on `src`) and no loan on
  # `p`, so `s` may be lent to write again while `taken` lives. The value
  # both holds a view and owns a String, which the view could view by type.

  obj Scanner
    text: ?String
    value: String

  src = "abc"
  s = Scanner(text: ?src, value: String())
  taken = swap(!s, Scanner(text: "", value: String()))
  _ = swap(!s, <taken)
  print(s.text)

fail "replace taken carries source loan", "12:2: cannot drop `src` while it is lent"
  # The value `replace` hands back still views `src`, as `s` did: dropping
  # `src` while it is used would leave `taken.text` dangling. The take
  # leaves no loan on the place, never fewer loans than the value carries.

  obj Scanner
    text: ?String
    value: String

  src = String("abc")
  s = Scanner(text: ?src, value: String())
  taken = swap(!s, Scanner(text: "", value: String()))
  <src
  print(taken.text)

fail "replace taken outlives source", "10:21: cannot return a view of `src`"
  # The scanner `replace` hands back views `src`, a local of `take`:
  # returning it would let the view outlive `src`.

  obj Scanner
    text: ?String
    value: String

  fun take() -> Scanner
    src = String("abc")
    s = Scanner(text: ?src, value: String())
    swap(!s, Scanner(text: "", value: String()))

  print(take().value)

test "replace through holder", "2 abc"
  # A value taken out of a write view by `replace` views only what its
  # fields viewed (`src`), never the place it came from, so it may be owned
  # by a holder for a while and put back.

  obj Scanner
    text: ?String
    pos: Int
    value: String

    sub round_trip(!@)
      taken = swap(!@, Scanner(text: "", pos: 0, value: String()))
      h = Holder(scanner: <taken)
      h.scanner.pos += 1
      back = swap(!h.scanner, Scanner(text: "", pos: 0, value: String()))
      _ = swap(!@, <back)

  obj Holder
    scanner: Scanner

  src = "abc"
  s = Scanner(text: ?src, pos: 1, value: String())
  !s.round_trip()
  print(s.pos, s.text)

fail "replace through read view", "8:15: cannot lend to write through a read view"
  # `replace` writes its place, and a place reached through a read view
  # may not be written.

  obj S
    name: String

  sub reset(s: ?S)
    old = swap(!s.name, String())
    print(old)

  s = S(name: String("a"))
  reset(?s)

test "replace through write local", "v ab"
  # The take-then-store reading of `replace` holds for a place reached
  # through a write-view local as for a name: `saved` carries the loan on
  # `src`, and `w` may be written while it lives.

  obj State
    text: ?String
    value: String

  obj Parser
    state: State
    n: Int

  src = "ab"
  p = Parser(state: State(text: ?src, value: String("v")), n: 0)
  w = !p.state
  saved = swap(!w, State(text: "", value: String()))
  w.value = String("tmp")
  _ = swap(!w, <saved)
  print(p.state.value, p.state.text)

fail "replace use after put back", "13:7: use of `taken` after move"
  # `<taken` moves the value back into `s`; using `taken` afterwards is a
  # use after move.

  obj Scanner
    text: ?String
    pos: Int
    value: String

  src = "abc"
  s = Scanner(text: ?src, pos: 1, value: String())
  taken = swap(!s, Scanner(text: "", pos: 0, value: String()))
  _ = swap(!s, <taken)
  print(taken.pos)

test "repoint local forms", '''
  1 5
  1 9 3
  1 2 9
  1 4
  [1, 2] [3, 0]
'''
  # A `!T` or `![]T` local is pointed at another place by any view: a
  # lend, a moved view, a branch of moved views, or a call returning one.

  fun slot(a: !Int) -> !Int
    a

  sub moved()
    m = 1
    n = 2
    w = !m
    w2 = !n
    w = <w2
    w = 5
    print(m, n)

  sub branches(c: Bool)
    m = 1
    n = 2
    k = 3
    w = !m
    w2 = !n
    w3 = !k
    w = <w2 if c else <w3
    w = 9
    print(m, n, k)

  sub called()
    m = 1
    n = 2
    w = !m
    w = slot(!n)
    w = 4
    print(m, n)

  sub slice()
    a = [1, 2]
    b = [3, 4]
    s = !a
    s2 = !b
    s = <s2
    s[1] = 0
    print(a, b)

  moved()
  branches(true)
  branches(false)
  called()
  slice()

test "repoint releases old view", '''
  axx bxx
  ["p!", "q!"] m
  c d!
'''
  # A write-view local re-pointed by a view ends its old view there: the
  # old one is never used again, so its loan is over (Core sentence 6),
  # also in a loop and when the new view is of the place it viewed.

  a = String("a")
  b = String("b")
  w = !a
  for i in 0..4
    if i % 2 == 0
      w = !b
    else
      w = !a
    !w.add("x")
  print(a, b)
  v: List[String] = List()
  !v.push(String("p"))
  !v.push(String("q"))
  m = String("m")
  u = !m
  for i in 0..v.len
    u = !v[i]
    !u.add("!")
  print(v, m)
  c = String("c")
  d = String("d")
  z: !String = !c
  k = 2
  z = match k
    1 => !c
    _ => !d
  !z.add("!")
  print(c, d)

fail "repointed view outlived", "14:10: `n` does not live long enough", "15:8: `o` does not live long enough"
  # A view pointed elsewhere may not outlive what it views, in a field or
  # a local.

  obj H
    r: ?Int

  m = 1
  k = 1
  h = H(r: ?m)
  w = !k
  if true
    n = 2
    o = 3
    h.r = ?n
    w = !o
  print(h.r)
  w = 4
  print(m, k)

