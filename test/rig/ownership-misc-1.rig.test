test "store into unnamed receiver", '''
  ["one", "two"] ["two"] [] two one
'''
  # A store reached through a write loan that no named place gives (a
  # write view a call returns, a branching receiver) holds the viewed value, as a name would
  # (`test/reject/ownership/store_into_unnamed_receiver.rig`): values that
  # outlive the holder may be stored there.

  obj H
    r: ?String
    rs: List[?String]

    sub keep(!@, r: ?String) keeps r
      !@rs.push(r)

  fun wrap(h: !H) -> !H
    h

  fun wv(v: !List[H]) -> !List[H]
    v

  fun f(n: Int) -> Int
    n

  t = String("one")
  u = String("two")
  h = H(r: "", rs: List())
  a = H(r: "", rs: List())
  b = H(r: "", rs: List())
  v: List[H] = List()
  !v.push(H(r: "", rs: List()))
  c = f(1) == 1
  wrap(!h).keep(?t)
  (!a if c else !b).keep(?u)
  (!wrap(!h).rs).push(?u)
  wrap(!b).r = ?u
  wv(!v)[0].r = ?t
  print(h.rs, a.rs, b.rs, b.r, v[0].r)

fail "store into unnamed receiver is rejected", "48:19: `s` does not live long enough", "56:28: `s` does not live long enough", "62:23: `s` does not live long enough", "68:25: `s` does not live long enough", "74:18: `s` does not live long enough", "81:19: `s` does not live long enough", errors: 6
  # A store reached through a write loan lands in what that loan reaches,
  # whatever the syntax: a write method's receiver that is no named place
  # (a write view a call returns, a branching receiver, one whose
  # arguments run first, a field of a returned view), and an assignment's
  # target that starts from a value no var holds (a write view a call
  # returns, `wrap(!h).r`, an element of one). Each view
  # stored here outlives `s`, whose block ends first.
  # oracle: recv_part reject C5
  # oracle: assign_view reject C5
  # oracle: assign_elem reject C5

  obj S
    n: Int
    t: String

  obj H
    r: ?String
    rs: List[?String]

    sub keep(!@, r: ?String) keeps r
      !@rs.push(r)

    sub keep2(!@, k: Int, r: ?String) keeps r
      !@rs.push(r)

    drop(!@)
      print("dropH sees", @r, @rs)

  fun mk(n: Int) -> S
    S(n: n, t: String("hello"))

  fun mkh() -> H
    H(r: "init", rs: List())

  fun wrap(h: !H) -> !H
    h

  fun wv(v: !List[H]) -> !List[H]
    v

  fun f(n: Int) -> Int
    n

  sub recv_view()
    h = mkh()
    if f(1) == 1
      s = mk(1)
      wrap(!h).keep(?s.t)

  sub recv_branch()
    a = mkh()
    b = mkh()
    c = f(1) == 1
    if c
      s = mk(2)
      (!a if c else !b).keep(?s.t)

  sub recv_hoisted()
    h = mkh()
    if f(1) == 1
      s = mk(3)
      wrap(!h).keep2(r: ?s.t, k: f(1))

  sub recv_part()
    h = mkh()
    if f(1) == 1
      s = mk(4)
      (!wrap(!h).rs).push(?s.t)

  sub assign_view()
    h = mkh()
    if f(1) == 1
      s = mk(7)
      wrap(!h).r = ?s.t

  sub assign_elem()
    v: List[H] = List()
    !v.push(mkh())
    if f(1) == 1
      s = mk(8)
      wv(!v)[0].r = ?s.t

  recv_view()

test "store through local write view", '''
  2
  2
'''
  # A call may store a view through a write view it is given: the
  # store lands in the value the view leads to, which then holds it.

  obj In
    n: Int

  obj Wrap
    r: ?In

  obj View
    b: ?In

  sub fill(w: !View, b: ?In) keeps b
    w.b = b

  sub fill_wrap(t: !Wrap, b: ?In) keeps b
    t.r = b

  a = In(n: 1)
  y = In(n: 2)
  v = View(b: ?a)
  if true
    w = !v
    fill(!w, ?y)
  print(v.b.n)
  x = Wrap(r: ?a)
  fill_wrap(!x, ?y)
  print(x.r.n)

