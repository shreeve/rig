  # A callable view follows the second-class view rules. It may not
  # outlive the closure it lends or what that closure captured, be
  # captured by an owned closure, or be returned from a function that was
  # lent nothing; and a closure literal's captures view for the call, so
  # they conflict with the call's other views.

  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun double(n: Int) -> Int
    n * 2

  fun pick(a: ?fun(Int) -> Int, b: ?fun(Int) -> Int, first: Bool) -> ?fun(Int) -> Int
    if first
      a
    else
      b

  fun leak() -> ?fun(Int) -> Int
    k = 1
    g = |+k, a: Int| a + k
    ?g

  sub keep(f: ?fun(Int) -> Int)
    cb = *|?f| f(1)
    cb2 = *|<f| f(1)
    print(cb(), cb2())

  sub each(xs: ?List[Int], f: ?sub(Int))
    for x in xs
      f(x)

  h: ?fun(Int) -> Int = double
  if true
    k = 1
    l = |+k, a: Int| a + k
    h = ?l
  print(h(1))
  r = Res(id: 1)
  m = |<r, a: Int| a + r.id
  p = pick(?m, double, true)
  <m
  print(p(2))
  c: List[Int] = List()
  each(?c, |!c, n| !c.push(n))
  total = 0
  both = |a: ?sub(Int), b: ?sub(Int)|
    a(1)
    b(2)
  both(|!total, n| print(total + n), |!total, n| print(total - n))

fail "callable view results", "20:6: cannot return a view of `w`, which this function was not lent", "26:14: `b` does not live long enough", "31:13: `c` does not live long enough"
  # What a callable view returns may lend what it captured: a call's
  # result, and what its write views lead to, carry those views, so
