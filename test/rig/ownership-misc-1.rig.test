fail "kept receiver view leaves tail", "35:3: cannot return a view of `mk(42)`, which this function was not lent", "38:10: cannot return a view of `mk(1)`, which this function was not lent", "49:5: a view of the temporary `mkh(42)` outlives its statement", "53:3: a view of the temporary `mkh(43)` outlives its statement", "57:9: a view of the temporary `mkh(44)` outlives its statement", errors: 5
  # A view of a temporary receiver, or of a Cell-holding part of one, of a
  # call whose arguments may run first lives only until the statement that
  # keeps the temporary ends, wherever the call's value is used, not only
  # where a statement binds it: the tail of a function, a `return`, a
  # `break` value, and the tail of a value `if` or `match` block all yield
  # it past that statement.

  obj S
    n: Int
    m: Int

    fun me(?@) -> ?S
      @

  obj Q
    c: Cell[Int]
    n: Int

    fun me(?@, j: Int, k: Int) -> ?Q
      @

  obj H
    q: Q

  fun mk(k: Int) -> S
    S(n: k, m: 6)

  fun mkh(k: Int) -> *H
    *H(q: Q(c: Cell(1), n: k))

  fun g(k: Int) -> Int
    k

  fun view(d: ?S) -> ?S from d
    mk(42).me()

  fun early(d: ?S, c: Bool) -> ?S from d
    return mk(1).me() if c
    d

  y = S(n: 0, m: 0)
  z = S(n: 0, m: 0)
  print(view(?y).n, early(?z, true).n)
  d = *H(q: Q(c: Cell(0), n: 0))
  k = g(0)
  r = match k
    0
      print("arm")
      mkh(42).q.me(k: g(1), j: g(2))
    _ => ?d.q
  s = if k == 0
    print("block")
    mkh(43).q.me(k: g(1), j: g(2))
  else
    ?d.q
  t = while true
    break mkh(44).q.me(k: g(1), j: g(2))
  else
    ?d.q
  print(r.n, s.n, t.n)

