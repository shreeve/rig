  # lend a copy of that owner: lend each branch instead.


  fun size(s: ?String) -> Int
    s.len

  fun g(o: String?) -> Int?
    print(text.trim(?o?))
    1

  a = String("aaaa")
  b = String("bb")
  c = true
  print(size(?(a if c else b)))
