test "bare write view place reads", '''
  11 1 1
  2
  2
  7 3
  3 3 [3, 4]
  6 7
  3
  5
  deferred 6
'''
  # A bare name only reads (Core sentence 1): `x = w` of a `!Int` name
  # reads the Int it sees, and so does an annotated binding (`x: Int = w`).
  # Changing the copy changes nothing else. So does every place that takes
  # the value: an assignment that writes through a write view, a
  # constructor, an argument, arithmetic, a branching value of such names,
  # a return, in a loop, a closure, and deferred code. `x = !w` lends the
  # view on.
  # oracle: bindings accept
  # oracle: lent_on accept
  # oracle: through accept
  # oracle: made accept
  # oracle: loops accept
  # oracle: deferred accept
  # oracle: take accept

  obj P
    n: Int

  fun get(w: !Int) -> Int
    w

  fun take(w: !Int) -> Int
    x = w
    x + 1

  sub bindings()
    n = 1
    m = 9
    w = !m
    v = !n
    x = v
    y: Int = v
    z = w if x > 5 else v
    x += 10
    print(x, y, z)
    v += 1
    print(n)

  sub lent_on()
    n = 1
    v = !n
    z = !v
    z += 1
    print(n)

  sub through()
    n = 1
    m = 2
    h = !n
    g = !m
    h = g
    g += 1
    h += 5
    print(n, m)

  sub made()
    n = 3
    w = !n
    p = P(n: w)
    vs: List[Int] = List()
    !vs.push(w)
    arr = [w, w + 1]
    print(p.n, vs[0], arr)

  sub loops()
    a = 1
    b = 2
    wa = !a
    wb = !b
    total = 0
    for i in 0..2
      x = wa if i == 0 else wb
      total += x
    print(total)

  sub in_closure()
    n = 4
    w = !n
    f = |?w|
      x: Int = w
      print(x + 1)
    f()

  sub deferred()
    n = 5
    w = !n
    defer
      x: Int = w
      print("deferred", x)
    w += 1

  bindings()
  lent_on()
  through()
  made()
  n = 6
  w = !n
  print(get(!w), take(!w))
  loops()
  in_closure()
  deferred()

