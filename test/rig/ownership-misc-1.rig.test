  # closure may run again.

  obj B
    n: Int

  b = *B(n: 1)
  outer = |+b|
    inner = |<b| b.n
    inner()
  outer()

test "nested loops settle quickly", '''
  1
  1 2
'''
  # Deeply nested loops are checked in time that grows with the nesting,
  # not exponentially: each loop settles once for every walk of its body.

  obj Tok
    n: Int

  sub eat(t: *Tok)
    print(t.n)

  t = *Tok(n: 1)
  s = 0
  for _ in 0..1
    for _ in 0..1
      for _ in 0..1
        for _ in 0..1
          for _ in 0..1
            for _ in 0..1
              for _ in 0..1
                for _ in 0..1
                  for _ in 0..1
                    for _ in 0..1
                      for _ in 0..1
                        for _ in 0..1
                          for _ in 0..1
                            for _ in 0..1
                              for _ in 0..1
                                for _ in 0..1
                                  for _ in 0..1
                                    for _ in 0..1
                                      for _ in 0..1
                                        for _ in 0..1
                                          for _ in 0..1
                                            for _ in 0..1
                                              for _ in 0..1
                                                for _ in 0..1
                                                  for _ in 0..1
                                                    for _ in 0..1
                                                      u = +t
                                                      s += u.n
                                                      t = *Tok(n: s + 1)
                                                      eat(<u)
  print(s, t.n)

