    before: ?String

  fun cut(s: ?String) -> Cut?
    Cut(before: s[..1])

  obj Split
    rest: ?String

    fun next(!@) -> (?String)?
      return none if @rest.len == 0
      part = @rest[..1]
      @rest = @rest[1..]
      part

  fun split(s: ?String) -> Split
    Split(rest: s)

  t = String("abc")
  a = trim(?t)
  !t.add("x")
  b = strip(?t)
  !t.add("y")
  c = cut(?t)
  !t.add("z")
  it = split(?t)
  d = (!it).next()
  <it
  !t.clear()
  print(a, b, c, d)

