      ?@inner

  h = Holder(inner: Wrap(payload: 3))
  b = ?h.get()
  print(b.payload)

test "moved loan ends with call", '''
  1
  3
'''
  # The loans of a view moved into a call end when the call returns, so
  # the next statement can write the root again.

  obj Wrap
    v: List[Int]

  sub show(a: ?Wrap)
    print(a.v.len)

  x = Wrap(v: List())
  !x.v.push(1)
  r = ?x
  show(<r)
  !x.v.push(2)
  w = !x
  !w.v.push(3)
  show(?x)

fail "moved view keeps loans in call", "34:13: cannot lend `x` to write while a read loan is live", "39:14: cannot lend `x` to write while a read loan is live", "44:20: cannot move `x` while a read loan is live", "50:3: cannot lend `x` to write while a read loan is live", "55:26: cannot move `x` while a read loan is live"
  # Moving a view (or a value holding one) into an argument or a field
  # keeps its loans in force until the call or construction ends, so a
  # later argument cannot lend or move the same root.

  obj Wrap
    v: List[Int]

    sub eat(!@, r: ?Wrap)
      @v = List()
      print(r.v.len)

  obj Ed
    r: ?Wrap

  obj P
    r: ?Wrap
    b: Wrap

  enum H
    none_
    two(a: Ed, b: Wrap)

  sub race(a: ?Wrap, b: !Wrap)
    print(a.v.len)
    b.v = List()

  sub race2(a: Ed, b: !Wrap)
    print(a.r.v.len)
    b.v = List()

  sub read_then_write()
    x = Wrap(v: List())
    r = ?x
    race(<r, !x)

  sub write_then_write()
    x = Wrap(v: List())
    e = Ed(r: ?x)
    race2(<e, !x)

  sub field_then_move()
    x = Wrap(v: List())
    r = ?x
    p = P(r: <r, b: <x)
    print(p.r.v.len)

  sub receiver_then_moved_arg()
    x = Wrap(v: List())
    r = ?x
    !x.eat(<r)

  sub variant_fields()
    x = Wrap(v: List())
    e = Ed(r: ?x)
    h: H = .two(a: <e, b: <x)
    print(h)

  read_then_write()

