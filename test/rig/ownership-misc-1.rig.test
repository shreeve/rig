  print(m.n, (!m).slot(?key))

test "guarded view subject cell", ".a(c: Counter(hits: Cell(value: 2)))"
  # A guarded match on a view a call returns holds the view as the pointer
  # it is, never a copy of the value it views, so a payload's Cell changed
  # in an arm is the matched value's own: through `!E` lent from a `*E`.

  obj Counter
    hits: Cell[Int]

    sub hit(!@)
      !@hits.set(@hits.get() + 1)

  enum E
    a(c: Counter)
    b

  fun get(e: !E) -> !E
