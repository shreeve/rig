  # elements is live.

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  s = ?v[..]
  !v.keep(1)
  print(s)

test "loan ends at last use", '''
  read 1
  x 3
  view 3
  drop 3
  inner 2
  drop 2
  len 0
  len 1
  len 2
  payload 7
  discard
  drop 7
  y 20
  eat 20
  drop 20
  end
  drop 10
'''
  # A view held by a binding, or by a view holding one, ends at its
  # last use, not at the end of the block: after that the value can be
  # written, moved, dropped, or reassigned.

  obj Wrap
    n: Int

    sub bump(!@)
      @n += 1

    drop(!@)
      print("drop", @n)

  obj View
    box: ?Wrap

  sub eat(b: Wrap)
    print("eat", b.n)

  sub discard(s: Slot)
    print("discard")

  enum Slot
    full(b: Wrap)
    empty

  x = Wrap(n: 1)
  r = ?x
  print("read", r.n)
  !x.bump()
  w = !x
  !w.bump()
  print("x", x.n)
  v = View(box: ?x)
  print("view", v.box.n)
  x = Wrap(n: 10)

  flag = x.n > 5
  if flag
    b = Wrap(n: 2)
    r2 = ?b
    print("inner", r2.n)

  nums: List[Int] = List()
  i = 0
  while i < 3 : i += 1
    seen = ?nums
    print("len", seen.len)
    !nums.push(i)

  s: Slot = .full(b: Wrap(n: 7))
  match s
    .full(p)
      print("payload", p.n)
      discard(<s)
    .empty => print("empty")

  y = Wrap(n: 20)
  ry = ?y
  print("y", ry.n)
  eat(<y)
  print("end")

test "loan ends with scope", '''
  3
  drop
  end
'''
  # A view bound in an inner block ends with the block, so the owner can
  # be dropped afterwards.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  a = Wrap(payload: 3)
  if true
    r = ?a
    print(r.payload)
  <a
  print("end")

test "loan released by drop", '''
  1
  drop
  end
'''
  # Dropping a view binding ends the view.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  b = Wrap(payload: 1)
  r = ?b
  print(r.payload)
  <r
  <b
  print("end")

