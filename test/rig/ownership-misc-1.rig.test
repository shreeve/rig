  # auto-drop guard releases it only on the path where it was not moved.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop")

  sub eat(rc: *Wrap)
    print(rc.payload)

  sub go(c: Bool)
    rc = *Wrap(payload: 1)
    if c
      eat(<rc)
    print("after")

  go(true)
  go(false)

