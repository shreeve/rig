test "assign through returned view", '''
  25
  [43, 40, 100]
  10
  0
  6 bee
  ["c"]
  failed
  ["new"]
  2 none
  3 2
'''
  # A call that returns a write view `!T` is assigned through:
  # `slot(!v, 0) += e` is `__v = e`, `w = slot(!v, 0)`, then `w += __v`.
  # The value runs first, then the call, as a path's base does. So are
  # `f()!` and `f()?` of a fallible or optional write view. A value that
  # owns a resource replaces the old one, which is dropped; one made
  # before a base that fails is dropped too.


  error Bad
    oops

  obj P
    x: Int

  obj Bag
    items: List[Int]
    name: String

    fun first(!@) -> !Int
      !@items[0]

    fun label(!@) -> !String
      !@name

  fun slot(v: !List[Int], i: Int) -> !Int from v
    !v[i]

  fun pslot(v: !List[P], i: Int) -> !P from v
    !v[i]

  fun lslot(v: !List[List[Int]], i: Int) -> !List[Int] from v
    !v[i]

  fun gslot[T](v: !List[T], i: Int) -> !T from v
    !v[i]

  fun grow(v: !List[Int]) -> Int
    !v.push(100)
    v.len

  fun sfail(v: !List[String], ok: Bool) -> (!String)! from v
    return Bad.oops if not ok
    !v[0]

  fun bump(m: !Map[String, Int], k: ?String) -> Int?
    (!m).edit(k)? += 1
    m.get(k)? + 0

  sub count(m: !Map[String, Int], k: String)
    (!m).ensure(<k, 0) += 1

  sub put(v: !List[String], ok: Bool)!
    sfail(!v, ok)! = String("new")

  sub set_first[T](v: !List[T], x: T)
    gslot(!v, 0) = <x

  v: List[Int] = List()
  !v.push(10)
  slot(!v, 0) += 1
  slot(!v, 0) -= 2
  slot(!v, 0) *= 3
  slot(!v, 0) /= 2
  slot(!v, 0) %= 7
  slot(!v, 0) <<= 2
  slot(!v, 0) |= 1
  print(v[0])
  slot(!v, 0) = 40
  !v.push(2)
  slot(!v, 1) = slot(!v, 0)
  slot(!v, 0) += grow(!v)
  print(v)
  ps: List[P] = List()
  !ps.push(P(x: 1))
  pslot(!ps, 0) = P(x: 9)
  pslot(!ps, 0).x += 1
  print(ps[0].x)
  ls: List[List[Int]] = List()
  !ls.push(List())
  !ls[0].push(1)
  lslot(!ls, 0) = List()
  print(ls[0].len)
  b = Bag(items: List(), name: String("a"))
  !b.items.push(5)
  (!b).first() += 1
  (!b).label() = String("bee")
  print(b.items[0], b.name)
  s: List[String] = List()
  !s.push(String("a"))
  set_first(!s, String("b"))
  gslot(!s, 0) = String("c")
  print(s)
  put(!s, true) catch print("failed")
  put(!s, false) catch print("failed")
  print(s)
  m = Map[String, Int]()
  !m.put(String("a"), 1)
  print(bump(!m, "a"), bump(!m, "b"))
  count(!m, String("a"))
  count(!m, String("b"))
  count(!m, String("b"))
  print(m.get("a") ?? 0, m.get("b") ?? 0)

test "assign value before target", release: true, '''
  7 3
  7 201 201
  7 209 201
  7 201 201
  1 9
  2 1
  4 3
  5
'''
  # An assignment is `{ __v = value; place op= __v }`: the value runs to
  # the end, its nested statements included, before the target is found,
  # so a store goes through the view as the value left it, for a name
  # written through as for an element, a field, or a compound.
  obj P
    a: Int
    b: Int

  fun grow(v: !List[Int]) -> Int
    for _ in 0..200
      !v.push(1)
    v.len

  sub name_repointed(k: Int)
    v: List[Int] = List()
    !v.push(7)
    u: List[Int] = List()
    !u.push(8)
    w = !v[0]
    w = match k
      0
        w = !u[0]
        3
      _ => 4
    print(v[0], u[0])

  sub name_repointed_grows_old(k: Int)
    v: List[Int] = List()
    !v.push(7)
    u: List[Int] = List()
    !u.push(8)
    w = !v[0]
    w = match k
      0
        w = !u[0]
        grow(!v)
      _ => 3
    print(v[0], u[0], v.len)

  sub name_compound(k: Int)
    v: List[Int] = List()
    !v.push(7)
    u: List[Int] = List()
    !u.push(8)
    w = !v[0]
    w += match k
      0
        w = !u[0]
        grow(!v)
      _ => 3
    print(v[0], u[0], v.len)

  sub elem_repointed_grows_old(k: Int)
    v: List[Int] = List()
    !v.push(7)
    u: List[Int] = List()
    !u.push(8)
    w = !v[0..1]
    w[0] = match k
      0
        w = !u[0..1]
        grow(!v)
      _ => 3
    print(v[0], u[0], v.len)

  sub field_repointed(k: Int)
    v: List[P] = List()
    !v.push(P(a: 1, b: 2))
    u: List[P] = List()
    !u.push(P(a: 3, b: 4))
    w = !v[0]
    w.a = if k == 0
      w = !u[0]
      9
    else
      0
    print(v[0].a, u[0].a)

  sub swap(k: Int)
    p = P(a: 1, b: 2)
    p = match k
      0
        P(a: p.b, b: p.a)
      _ => P(a: 0, b: 0)
    print(p.a, p.b)
    v: List[P] = List()
    !v.push(P(a: 3, b: 4))
    w = !v[0]
    w = match k
      0
        P(a: w.b, b: w.a)
      _ => P(a: 0, b: 0)
    print(v[0].a, v[0].b)

  sub last_line(k: Bool)
    v: List[Int] = List()
    !v.push(7)
    w = !v[0..1]
    w[0] = 5
    if k
      u: List[Int] = List()
      !u.push(1)
      w = !u[0..1]
      w[0] = 3
    print(v[0])

  name_repointed(0)
  name_repointed_grows_old(0)
  name_compound(0)
  elem_repointed_grows_old(0)
  field_repointed(0)
  swap(0)
  last_line(true)

test "assign value jump leaves target", "7"
  # A jump out of an assignment's value never reaches its target: the
  # view the target reads may point at a local of the scope it leaves, so
  # long as nothing uses the view after.
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  k = 0
  $out: match k
    0
      w[0] = match k
        0
          y: List[Int] = List()
          !y.push(1)
          w = !y[0..1]
          break $out
        _ => 3
    _ => pass
  print(v[0])

