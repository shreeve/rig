fail "errdefer reads moved on failure", "19:18: use of `t` after move", "25:18: use of `t` after move", "32:18: use of `t` after move", "38:18: use of `t` after move"
  # An `errdefer` is checked at every exit that fails: `!`, and a `return`
  # of an error value, also as a branch of the returned value.

  error E
    bad

  obj Tok
    n: Int

  sub eat(t: Tok)
    print("eat", t.n)

  fun check(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun propagated(k: Int) -> Int!
    t = Tok(n: 1)
    errdefer print(t.n)
    eat(<t)
    check(k)!

  fun returned(k: Int) -> Int!
    t = Tok(n: 2)
    errdefer print(t.n)
    eat(<t)
    return E.bad if k > 0
    k

  fun tail(k: Int) -> Int!
    t = Tok(n: 3)
    errdefer print(t.n)
    eat(<t)
    return E.bad if k > 0 else k

  fun caught(k: Int) -> Int!
    t = Tok(n: 4)
    errdefer print(t.n)
    eat(<t)
    n = check(k) catch |err| return err
    n

  print(propagated(1) catch -1, returned(1) catch -1, tail(1) catch -1, caught(1) catch -1)

