test "reach generic field instance", '''
  1
  2 1
'''
  # Rule: a call may store an argument taken by value only where its type
  # could hold what the call's write parameters lead to (Core sentence 7).
  # A `Map[U32, U32]` holds no view: its entries are `Entry[K, V]`
  # instances inside the Map's own fields, whose type parameters stand for
  # the Map's arguments, `U32` and `U32`, not for anything. So `count` can
  # store `t`'s view of `xs` only where `Checker` views a `Program`, and
  # `xs` is free to change after the call.
  # From: Trig NEEDS 11 (.git/revamp/r3/repro/needs11-map-reach.rig).


  obj Program
    xs: List[Int]

  obj Tok
    items: ?List[Int]

  obj Checker
    program: ?Program
    total: Int
    m: Map[U32, U32]
    s: Set[U32]

  fun Checker.count(!@, t: Tok) -> Int
    @total += 1
    t.items.len

  p = Program(xs: List())
  xs: List[Int] = List()
  c = Checker(program: ?p, total: 0, m: Map[U32, U32](), s: Set[U32]())
  !xs.push(1)
  print((!c).count(Tok(items: ?xs)))
  !xs.push(2)
  print(xs.len, c.total)

fail "reach generic field instance views", "25:1: cannot lend `xs` to write while a read loan is live"
  # Why: a `Map[U32, ?List[Int]]` holds views of Lists in its
  # entries, `Entry[K, V]` instances whose `V` is the Map's `?List[Int]`,
  # so `count` may store `t`'s view of `xs` in `c`, and `xs` stays lent to
  # read while `c` is used.
  # Rule: a call may store an argument taken by value wherever its type
  # fits what the call's write parameters lead to, a generic instance's
  # arguments included (Core sentence 7).


  obj Tok
    items: ?List[Int]

  obj Checker
    total: Int
    m: Map[U32, ?List[Int]]

  fun Checker.count(!@, t: Tok) -> Int
    @total += 1
    t.items.len

  xs: List[Int] = List()
  c = Checker(total: 0, m: Map[U32, ?List[Int]]())
  !xs.push(1)
  print((!c).count(Tok(items: ?xs)))
  !xs.push(2)
  print(xs.len, c.total)

fail "read binding write hints", "27:14: cannot assign through a read view (`?T`); `w` is a read view of a field of `e`: to write through it, match with `match !e`", "32:14: cannot assign through a read view (`?T`); `w` is a read view of a field of `mk().e`: to write through it, bind `mk()` to a name first, then match its part with `match !`", "37:14: cannot assign through a read view (`?T`); `w` is a read view of a field of `peek(h)`, which is reached through a read view, so nothing writes through it", "43:5: cannot assign through a read view (`?T`); `x` is a read view of the value inside `o`: to write through it, bind it with `if !o as x`", "47:5: cannot assign through a read view (`?T`); `x` is a read view of the value inside `o`: to write through it, take the parameter to write (`o: !…`), then bind it with `if !o as x`", "51:14: cannot assign through a read view (`?T`); `w` is a read view of a field of `e`, which is reached through a read view, so nothing writes through it", errors: 6
  # A write through a binding that only reads names what writes: a read
  # match of a place, `match !p`; of a part of a value made in the
  # header, that value bound to a name first; of a call that returns a
  # read view, a write view instead; of a value reached through a read
  # view, nothing; and `if o as x` of a local, `if !o as x`, or of a
  # parameter, the parameter taken to write first.

  obj P
    t: String

  enum E
    a(w: P)
    b

  obj H
    e: E

  fun mk() -> H
    H(e: E.a(P(t: String("m"))))

  fun peek(h: ?H) -> ?E from h
    ?h.e

  sub place()
    e = E.a(P(t: String("p")))
    match e
      .a(w) => w.t = String("x")
      .b => pass

  sub held()
    match mk().e
      .a(w) => w.t = String("x")
      .b => pass

  sub viewed_call(h: ?H)
    match peek(h)
      .a(w) => w.t = String("x")
      .b => pass

  sub optional(p: !P)
    o: (!P)? = !p
    if o as x
      x.t = String("x")

  sub optional_param(o: (!P)?)
    if o as x
      x.t = String("x")

  sub read_view(e: ?E)
    match e
      .a(w) => w.t = String("x")
      .b => pass

  pass

