  1
  101
  after
  102
'''
  # A field moved out of an owned local moves as a name does (Core §5):
  # the handle goes to `eat`, and at scope exit the local drops only the
  # field it still holds.

  obj Wrap
    payload: Int

    drop(!@)
      print(@payload + 100)

  obj Pair
    a: *Wrap
    b: *Wrap

  sub eat(rc: *Wrap)
    print(rc.payload)

  p = Pair(a: *Wrap(payload: 1), b: *Wrap(payload: 2))
  eat(<p.a)
