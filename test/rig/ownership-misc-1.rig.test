fail "payload by name", "20:23: cannot move `a` out of `x`: `match x` reads `x`", "23:22: a guard cannot change the value being matched", errors: 2
  # A field bound by name is bound as one bound in order is: a read match
  # cannot move it out, and a guard cannot write it.

  obj B
    n: Int

  enum Bag
    two(a: *B, t: String)
    empty

  sub keep(b: *B)
    print(b.n)

  fun bump(t: !String) -> Bool
    !t.add("!")
    true

  x: Bag = .two(a: *B(n: 1), t: String("x"))
  match x
    .two(a: a) => keep(<a)
    _ => pass
  match !x
    .two(t: t) if bump(!t) => pass
    _ => pass

fail "payload by name flow", "21:7: use of `x` after move", "25:1: cannot reassign `y` while it is lent", "31:5: cannot reassign `z` while it is lent", errors: 3
  # A consuming match that binds fields by name consumes its subject
  # whole, and a read view of a field bound by name ends where the subject
  # changes, as one bound in order does.

  obj B
    n: Int

  enum Bag
    two(a: *B, t: String)
    empty

  fun label(e: ?Bag, d: ?String) -> ?String from e, d
    match e
      .two(t: t) => ?t
      _ => d

  x: Bag = .two(a: *B(n: 1), t: String("x"))
  match <x
    .two(t: t) => print(t)
    _ => pass
  print(x)
  y: Bag = .two(a: *B(n: 2), t: String("y"))
  d = String("")
  v = label(?y, ?d)
  y = .empty
  print(v)
  z: Bag = .two(a: *B(n: 3), t: String("z"))
  match z
    .two(t: t)
      w = ?t
      z = .empty
      print(w)
    _ => pass

test "payload literal compare reads", '''
  true true
  true true
  .line(v: "a") .dot
'''
  # `==` with a payload literal reads both operands: a name, or a name a
  # branching value may be, is read where it is, and a value made there,
  # the literal too, is a temporary the statement drops.
  enum S
    dot
    line(v: String)

  fun mk(t: ?String) -> S
    .line(v: String(t))

  a: S = .line(v: String("a"))
  b: S = .dot
  c = true
  print(a == .line(v: String("a")), (a if c else b) == .line(v: String("a")))
  print(mk("x") == .line(v: String("x")), (b if c else mk("y")) != .line(v: String("y")))
  print(a, b)

