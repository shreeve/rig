  # assignment's value, and a method's index argument. Each is rejected by
  # the one decider that every read of a view as a value passes
  # (`writeLendRead`). A held view (`w`) is read as a bare name is.

  fun opt() -> Int?
    2

  fun unwrap(o: Int?) -> Int?
    p = o
    x = (!p)?
    x

  n = 1
  i = 0
  o = opt()
  arr = [1, 2, 3]
  v: List[Int] = List()
  !v.push(5)
  w = !n
  print(w + 1)
  a = !n + 1
  b = -!n
  c = !n == 1
  d = !n < 2
  e = arr[!i]
  f = ?arr[0..!i]
  g = Float(!n)
  print(!n)
  h = String(!n)
  k = +!n
  l = ?!n
  m = !o ?? 0
  t = 0
  t += !n
  q = v.get(!i)
  r = !arr == [1, 2, 3]
  print(a, b, c, d, e, f, g, h, k, l, m, t, q, r, unwrap(o))

