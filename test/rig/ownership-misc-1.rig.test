  enum E
    a(n: Int)
    b

  obj Set
    items: List[Int]

    fun insert(!@, k: Int) -> Bool
      !@items.push(k)
      true

  obj Q
    n: Int

    sub bump(!@)
      @n += 1

  obj P
    x: Int
    o: Int?
    e: E
    items: List[Int]
    a: [2]Int
