fail "loop move shared", "12:8: use of `rc` after move"
  # A move inside a `while` body is seen by the next iteration.

  obj Wrap
    payload: Int

  sub eat(rc: *Wrap)
    print(rc.payload)

  rc = *Wrap(payload: 42)
  i = 0
