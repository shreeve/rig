test "read view branch value keeps owner", '''
  1
  1
  end
  drop 2
  drop 1
'''
  # A read view as the value of a branch does not move its owner, which
  # is still dropped at scope exit even though it may be moved elsewhere.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  sub eat(b: B)
    print("eat", b.n)

  sub consume(v: List[Int])
    print("consume", v.len)

