  2
  4
  4 10
  2 3
  2 3
'''
  # A method that changes its receiver, through a Cell or a `!@`, called
  # on what each branch lends, changes the value the branch takes, also when
  # its arguments are evaluated first.

  obj Q
    c: Cell[Int]
    n: Int

    fun bump(!@) -> Int
      !@c.set(@c.get() + 1)
      @c.get()

    fun bump2(!@, j: Int, k: Int) -> Int
      !@c.set(@c.get() + j)
      @c.get()

  obj H
    q: Q

  obj P
    n: Int

    fun inc(!@) -> Int
      @n += 1
      @n

  fun g(k: Int) -> Int
    k

  h1 = *H(q: Q(c: Cell(1), n: 1))
  h2 = *H(q: Q(c: Cell(10), n: 2))
  c = g(1) == 1
  print((!h1.q if c else !h2.q).bump())
  print((!h1.q if c else !h2.q).bump2(k: g(1), j: g(2)))
  print(h1.q.c.get(), h2.q.c.get())
  a = P(n: 1)
  b = P(n: 2)
  print((!a if c else !b).inc(), (!b if c else !a).inc())
  print(a.n, b.n)

test "branch write view made leaves", '''
  2 12 2
  6
'''
  # A branch over write views whose every leaf is made there (`!a`, a
  # call's result) is a write view the branch makes: it is passed,
  # matched, and bound as one. A branch of names holding write views of
  # values that copy reads the value.

  enum E
    a(n: Int)
    b

  sub inc(w: !Int)
    w += 1

  error Bad
    bad

  fun getw(w: !Int, k: Bool) -> (!Int)!
    return Bad.bad if k
    w

  sub f(a: !Int, b: !Int, c: Bool)
    inc(!a if c else !b)
    w = getw(!a, true) catch !b
    w += 10
    n = a if c else b
    print(a, b, n)

  sub g(x: !E, y: !E, c: Bool)
    match (!x if c else !y)
      .a(n)
        n += 5
      .b => pass

  x = 1
  y = 2
  f(!x, !y, true)
  e = E.a(n: 1)
  d = E.b
  g(!e, !d, true)
  match e
    .a(n) => print(n)
    .b => pass

