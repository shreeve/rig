  # A write lend `!x` where a plain value goes would be read, its `!`
  # ignored: a generic's inferred `T` (a scalar's or a struct's), a
  # constructor's or variant's field, a declared parameter, a method's
  # parameter, an array element, a typed binding, a result, and each arm or
  # `break` of a value that branches. The diagnostic offers a copy, with
  # every ignored `!` of the call taken off, and, where a write view may
  # stand (a parameter, a binding, a result), a write view kept; it names a
  # parameter as declared (`!T`). A field or a type argument never holds a
  # write view, so there only the copy is offered.


  enum Opt[T]
    some(v: T)
    nothing

  obj H[T]
    r: T

  obj G[T]
    r: T

    sub set(!@, x: T)
      @r = x

  obj P
    x: Int

  obj Q
    a: Int
    b: Int

  fun get[T](x: T) -> T
    x

  fun pair[T](a: T, b: T) -> T
    a

  fun f(x: Int) -> Int
    x

  fun ret(x: !Int) -> Int
    !x

  fun mk() -> P
    P(x: 4)

  n = 1
  m = 2
  c = n > 0
  o: Int? = none
  p = Q(a: 1, b: 2)
  e1 = Opt.some(v: !n)
  e2 = Opt.some(!n)
  e3 = Opt[Int].some(v: !n)
  e4: Opt[Int] = .some(v: !n)
  e5 = Opt.some(v: !p)
  s1 = H(r: !n)
  s2 = H[Int](r: !n)
  s3 = P(x: !n)
  s4 = G(r: !n)
  g1 = get(!n)
  g2 = pair(!n, !m)
  g3 = f(!n)
  g4 = f(!!n)
  g5 = f(<!n)
  g6 = math.max(!n, 3)
  !s4.set(!m)
  v: List[Int] = List()
  !v.push(!m)
  a1 = [!n, 3]
  a2: [1]Int = [!n]
  b1: Int = !n
  b2: Int = !n if c else !m
  b3: Int = o ?? !n
  b4 = match n
    1 => !n
    _ => 0
  b5: Int = !mk().x
  b6 = while true
    break !n if c
    break 0
  print(e1, e2, e3, e4, e5, s1.r, s2.r, s3.x, s4.r, g1, g2, g3, g4, g5, g6, a1, a2, b1, b2, b3, b4, b5, b6, ret(!n))

