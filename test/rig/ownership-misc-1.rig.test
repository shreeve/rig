test "string view iterators", '''
  one two
  three
  x y z done
  4 two
  three
  15 15 one
'''
  # A String-holding struct is a view of what its Strings view. An
  # iterator's `next(!@)` copies a String out of `@` and returns
  # it: the result views what the iterator views, not the iterator, so
  # two parts can be held at once. Literals stay free: `@rest = ""`.

  fun find(s: ?String, pat: ?String) -> Int?
    i = 0
    while i + pat.len <= s.len
      if s[i..i + pat.len] == pat
        return i
      i += 1
    none

  fun strip_suffix(s: ?String, suffix: ?String) -> (?String)?
    return none if suffix.len > s.len or s[s.len - suffix.len..] != suffix
    s[..s.len - suffix.len]

  obj Cut
    before: ?String
    after: ?String

  fun cut(s: ?String, sep: ?String) -> Cut?
    i = find(s, sep)?
    Cut(before: s[..i], after: s[i + sep.len..])

  obj Lines
    rest: ?String

    fun next(!@) -> (?String)?
      return none if @rest.len == 0
      end = find(@rest, "\n") ?? -1
      if end < 0
        line = @rest
        @rest = ""
        return line
      line = @rest[..end]
      @rest = @rest[end + 1..]
      strip_suffix(line, "\r") ?? line

  fun lines(s: ?String) -> Lines
    Lines(rest: s)

  fun view(t: !String) -> ?String
    ?t[..]

  t = String("one\r\ntwo\nthree")
  it = lines(?t)
  a = (!it).next()
  b = (!it).next()
  print(a, b)
  while (!it).next() as line
    print(line)
  more = lines("x\ny\nz")
  print((!more).next() ?? "?", (!more).next() ?? "?", (!more).next() ?? "?", (!more).next() ?? "done")
  c = cut(?t, "\n") ?? Cut(before: "", after: "")
  print(c.before.len, c.after)
  !t.add("!")
  s = view(!t)
  print(t.len, s.len, s[..3])

