fail "copy write view duplicated", "8:13: bare use of write view `w2` in binding would copy a write view, which is unique; use `<w2` to move it", "10:11: bare use of write view `w2` in `break` value would copy a write view, which is unique; use `<w2` to move it", errors: 2
  # A bare write view of a Copy value is read where its context wants
  # the value, but where a `!T` is expected it would be a second writer: a
  # `!T` binding or a `break` value takes it with `<w`. (`new w = w2`
  # copies the value.)

  sub bind(w2: !Int)
    new w = w2
    v: !Int = w2
    u: !Int = while true
      break w2
    w2 += 1
    w += 1
    v += 1
    u += 1
    print(w, v)

  n = 1
  bind(!n)

test "copy write view read or moved", '''
  2 11 102 2 1001 1002 1 1 2
  7
'''
  # A bare write view of a Copy value is read where its context wants
  # the value: a binding, a field or argument of the value's type, a
  # `break` value of a loop whose value is read, or a branch of one.
  # Where a `!T` goes, as a binding of a branch of moves, it is moved
  # with `<w`.

  obj P
    x: Int

  fun read(n: Int) -> Int
    n

  sub copies(w2: !Int, w3: !Int, c: Bool)
    x = w2
    y: Int = w2 if c else w3
    new z = w3
    p = P(x: w2)
    p.x = w3 if c else w2
    u = while true
      break w2
    v = for _ in 0..3
      break w3 if c
    else
      w2
    x += 1
    y += 10
    z += 100
    u += 1000
    v += 1000
    print(x, y, z, p.x, u, v, read(w2), w2, w3)

  sub moves(w2: !Int, w3: !Int, c: Bool)
    t = <w2 if c else <w3
    t += 5

  n = 1
  m = 2
  copies(!n, !m, true)
  moves(!n, !m, false)
  print(m)

