  # Calling a callable gives a result that views what the callable
  # holds, whatever form the callee takes: a closure binding, a viewed
  # callable held by a local, a lent closure called in place, or one a
  # call returned. So `|?c| c` called through any of them cannot outlive
  # `c`, or be returned from the function that owns `c`.

  fun echo(f: ?fun() -> ?List[Int]) -> ?fun() -> ?List[Int]
    f

  fun bad(a: ?List[Int]) -> ?List[Int]
    c: List[Int] = List()
    l = |?c| c
    g = ?l
    g()

  a: List[Int] = List()
  r = ?a
  if true
    c: List[Int] = List()
    l = |?c| c
    g = ?l
    r = g()
  if true
    d: List[Int] = List()
    m = |?d| d
    r = (?m)()
  if true
    e: List[Int] = List()
    n = |?e| e
    r = echo(?n)()
  print(r.len)

