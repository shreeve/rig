test "copies out of view", '''
  1 10
  12 2
  50 12
  2
  [3, 4] [9, 4]
  5 10
  10 1
  7
  8
'''
  # A view of a value that copies is copied out where the value is
  # expected (Core §4): a plain struct, an array, or an optional, as a
  # number is, through a read or a write view, as an argument, a result,
  # a typed binding, an optional, or a branch. The copy carries no loan,
  # so the owner may change while the copy lives. A copy of a value that
  # holds a view carries that view's loans.

  obj P
    x: Int
    y: Int

  obj S
    r: ?Int

  fun copy(p: ?P) -> P
    p

  fun copy_arr(a: ?[2]Int) -> [2]Int
    a

  fun copy_opt(o: ?P?) -> P?
    o

  fun lift(p: ?P) -> P?
    p

  fun sum(p: P) -> Int
    p.x + p.y

  fun pick(a: ?P, b: P, first: Bool) -> P
    a if first else b

  fun keep(s: ?S) -> S
    s

  fun xof(o: P?) -> Int
    if o as p
      return p.x
    0

  a = P(x: 1, y: 2)
  b = copy(?a)
  a.x = 10
  print(b.x, a.x)
  r = ?a
  c: P = r
  print(sum(r), c.y)
  w = !a
  d: P = w
  d.y = 50
  print(d.y, sum(w))
  print(a.y)
  arr = [3, 4]
  e = copy_arr(?arr)
  arr[0] = 9
  print(e, arr)
  o: P? = P(x: 5, y: 6)
  print(xof(copy_opt(?o)), xof(lift(?a)))
  print(pick(?a, b, true).x, pick(?a, b, false).x)
  n = 7
  s = S(r: ?n)
  t = keep(?s)
  print(t.r)
  n = 8
  print(n)

fail "copies view loans", "22:3: cannot reassign `n` while it is lent", "30:3: cannot reassign `m` while it is lent", "39:3: cannot reassign `m` while it is lent", "46:3: cannot reassign `n` while it is lent", "53:3: cannot reassign `n` while it is lent", "61:3: cannot reassign `n` while it is lent", "67:10: an owned closure cannot capture `s`, which holds a view of `n`", errors: 7
  # Every copy of a read view carries its loan (Core §5, sentence 6): an
  # array `[n of ?x]` or `fill`ed with views, a copy of a struct holding
  # a view, and a `|+x|` capture of one keep the viewed value lent while
  # they are used. An owned closure carries no loan (Core sentence 9).
  # oracle: fill_loan reject C4
  # oracle: fill_method_loan reject C4
  # oracle: copy_elements_loan reject C4
  # oracle: copy_loan reject C4
  # oracle: capture_loan reject C4
  # oracle: capture_through_view_loan reject C4
  # oracle: owned_capture reject C8

  obj S
    r: ?Int

  fun keep(s: ?S) -> S
    s

  sub fill_loan()
    n = 1
    a = [3 of ?n]
    n = 5
    print(a[2])

  sub fill_method_loan()
    n = 1
    m = 2
    a = [3 of ?n]
    !a.fill(?m)
    m = 7
    print(a[0])

  sub copy_elements_loan()
    n = 1
    m = 2
    a = [3 of ?n]
    b = [?m, ?m]
    !a[..2].copy(?b[..])
    m = 7
    print(a[0])

  sub copy_loan()
    n = 1
    s = S(r: ?n)
    t = keep(?s)
    n = 2
    print(t.r)

  sub capture_loan()
    n = 1
    s = S(r: ?n)
    f = |+s| s.r
    n = 2
    print(f())

  sub capture_through_view_loan()
    n = 1
    s = S(r: ?n)
    v = ?s
    f = |+v| v.r
    n = 5
    print(f())

  sub owned_capture()
    n = 1
    s = S(r: ?n)
    f = *|+s| s.r + 0
    print(f())

  fill_loan()

test "copies write view reads", '''
  100 7 3 2
  1 1 2 9
  9
'''
  # A bare name only reads (Core sentence 1): a write view of a value that
  # copies, whether a local or a parameter holds it, reads the value it
  # sees where a value is taken, a plain struct as a number does. Changing
  # the copy changes nothing else; assigning one write view from another
  # writes the value through.

  obj P
    x: Int
    y: Int

  fun pick(a: !P, b: !P, first: Bool) -> P
    a if first else b

  a = P(x: 1, y: 2)
  b = P(x: 10, y: 20)
  w = !a
  x = w
  x.x = 100
  v = !b
  z = v
  z.y = 7
  q = P(x: 9, y: 9)
  r = !q
  e = r
  e.x = 3
  c = x.x > 0
  u = w if c else v
  print(x.x, z.y, e.x, u.y)
  v = w
  print(a.x, b.x, b.y, q.x)
  print(pick(!a, !q, false).x)

