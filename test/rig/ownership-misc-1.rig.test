  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  rc = *B(n: 1)
  w = ~rc
  print(*w == none)
  if *w != none
    print("alive")
  <rc
  print(*w == none)

test "none test ternary owners", '''
  some
  1
'''
  # Testing a branching value against `none` reads it, as any `==`
  # operand: a name it may be is read where it is, never dropped.
  v: List[Int] = List()
  !v.push(1)
  a: List[Int]? = <v
  b: List[Int]? = none
  c = true
  if (a if c else b) != none
    print("some")
  if ?a as x
    print(x[0])

fail "nullish continue stores", "15:10: `inner` does not live long enough", errors: 1
  # `?? continue` leaves the body's scope: a loan on a body local stored
  # in an outer value cannot survive it.
  obj H
    r: ?List[Int]

  fun opt(n: Int) -> Int?
    none

  z: List[Int] = List()
  h = H(r: ?z)
  i = 0
  while i < 2 : i += 1
    inner: List[Int] = List()
    !inner.push(9)
    h.r = ?inner
    k = opt(i) ?? continue
    print(k)
  print(h.r[0])

test "operand read order", '''
  1 0
  2
  1 101
  1 201
  5 101
  false 201
  false
  true 205
  true 201
  true 207
  81
  3
'''
  # What an operand reads in place is held only until its consumer runs,
  # and only when the value shares storage: a write that finishes before
  # the read, a read of plain data, a read lend beside the read, a write
  # to another place, and a place indexed after its index runs are all
  # accepted (the rejected shapes are the reject tests named *_read_then_*).

  obj P
    v: List[Int]
    n: Int

    fun sum(?@, k: Int) -> Int
      @v[0] + k

  fun mk(k: Int) -> P
    v: List[Int] = List()
    !v.push(k)
    P(v: <v, n: k)

  fun growp(p: !P) -> Int
    for i in 0..100
      !p.v.push(i)
    0

  fun growv(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    0

  fun grow(t: !String) -> String
    for _ in 0..100
      !t.add("ab")
    String("x")

  fun growi(t: !String) -> Int
    !t.add("ab")
    t.len

  fun look(p: ?P) -> Int
    p.n

  fun reset(f: !*fun(Int) -> Int) -> Int
    f = *|k: Int| k + 2
    1

  a = mk(1)
  b = mk(2)
  c = true
  print((a if c else b).n, growp(!a))
  print((a if c else b).sum(look(?a)))
  z = mk(3)
  print((a if c else b).sum(growp(!z)), z.v.len)
  print(a.v[growp(!a)], a.v.len)
  vs: List[Int] = List()
  !vs.push(5)
  print(vs[growv(!vs)], vs.len)
  t = String("a")
  print(grow(!t) == t, t.len)
  print(t.len == growi(!t))
  print(t == String("x") or growi(!t) > 0, t.len)
  u = String("u")
  print(t != grow(!u), u.len)
  same = t == +t
  print(same, growi(!t))
  base = 40
  f = *|<base, k: Int| base + k
  print(f(f(1)))
  r = reset(!f)
  print(f(r))

test "owned args dropped when later arg fails", '''
  drop 1
  -1
  drop 0
  -1
  drop 2
  -1
  drop 3
  -1
  drop 4
  -1
  drop 5
  -1
  drop 6
  -1
  -1
  drop 8
  -1
  drop 10
  drop 9
  -1
  drop 11
  -5
  take 12 0
  drop 12
  0
'''
  # When an argument fails (`!`, or a `catch` that returns) after an earlier
  # argument produced an owned value, that value is released, and a moved
  # local stays with its owner: nothing leaks and every `drop` body runs.

  error E
    bad

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  obj P
    a: B
    k: Int

  enum Slot
    one(b: B)
    two(b: B, k: Int)

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun mk(k: Int) -> B!
    return E.bad if k > 0
    B(n: k)

  sub take(b: B, n: Int)
    print("take", b.n, n)

  sub pair(a: B, b: B)
    print("pair", a.n, b.n)

  sub share(a: *B, n: Int)
    print("share", a.n, n)

  sub two(a: *B, b: *B)
    print("two", a.n, b.n)

  sub vec(v: List[Int], n: Int)
    print("vec", v.len, n)

  sub call(f: *fun() -> Int, n: Int)
    print("call", f(), n)

  obj S
    b: B

    sub put(!@, b: B, n: Int)
      @b = <b
      print("put", n)

  fun temp() -> Int!
    take(B(n: 1), fail(1)!)
    0

  fun both() -> Int!
    pair(mk(0)!, mk(1)!)
    0

  fun field() -> Int!
    p = P(a: B(n: 2), k: fail(1)!)
    p.k

  fun variant() -> Int!
    s: Slot = .two(b: B(n: 3), k: fail(1)!)
    0

  fun boxed() -> Int!
    share(*B(n: 4), fail(1)!)
    0

  fun moved() -> Int!
    a = *B(n: 5)
    share(<a, fail(1)!)
    0

  fun cloned() -> Int!
    h = *B(n: 6)
    two(+h, *B(n: 7) if fail(1)! > 0 else +h)
    0

  fun buffer() -> Int!
    v: List[Int] = List()
    !v.push(1)
    vec(<v, fail(1)!)
    0

  fun closure() -> Int!
    b = *B(n: 8)
    call(*|<b| b.n, fail(1)!)
    0

  fun method() -> Int!
    s = S(b: B(n: 9))
    !s.put(B(n: 10), fail(1)!)
    0

  fun caught() -> Int
    take(B(n: 11), fail(1) catch |_|
      return -5
    )
    0

  fun ok() -> Int!
    take(B(n: 12), fail(0)!)
    0

  print(temp() catch -1)
  print(both() catch -1)
  print(field() catch -1)
  print(variant() catch -1)
  print(boxed() catch -1)
  print(moved() catch -1)
  print(cloned() catch -1)
  print(buffer() catch -1)
  print(closure() catch -1)
  print(method() catch -1)
  print(caught())
  print(ok() catch -1)

fail "owned closure call stores arg", "11:1: cannot lend `t` to write while a read loan is live"
  # A call of an owned closure stores what its type's origins say: here
  # the `?String` argument into what `!H` reaches.

  obj H
    s: ?String

  put: *sub(!H, ?String) = *|h, s| h.s = s
  h = H(s: "a")
  t = String("x")
  put(!h, ?t)
  !t.add("y")
  print(h.s)

fail "owned closure callee writes self", "14:12: cannot lend `@` to write while the callee's read of `@hook` is in use", "14:5: clone the handle first: `f = +@hook`, then `f(!@)`", "17:16: cannot lend `@` to write while the callee's read of `@hooks` is in use", "17:5: clone the handle first: `f = +@hooks[0]`, then `f(!@)`", "21:8: cannot lend `@` to write while a read loan on `@hook` is live", "25:10: cannot lend `@` to write while a read loan on `@opt` is live", "32:12: cannot lend `@` to write while the callee's read of `@hook` is in use", "32:5: clone the handle first: `f = +@hook`, then `f(!@, x)`", "35:11: cannot lend `b` to write while the callee's read of `b.hook` is in use", "39:11: cannot lend `w` to write while the callee's read of `w.hook` is in use", errors: 7
  # Calling an owned closure reads what holds it until the call returns,
  # so the call may not lend that holder to write: the closure could
  # replace itself there and free the environment it runs in. Each form
  # of the callee is held: a field, an element, a view of the handle, an
  # `as` binding, a field of a generic type, a box, and a write view.

  obj Checker
    n: Int
    hook: *sub(!Checker)
    hooks: List[*sub(!Checker)]
    opt: (*sub(!Checker))?

    sub run(!@)
      @hook(!@)

    sub run_element(!@)
      @hooks[0](!@)

    sub run_view(!@)
      g = ?@hook
      g(!@)

    sub run_as(!@)
      if @opt as f
        f(!@)

  obj H[T]
    n: T
    hook: *sub(!H[T], T)

    sub run(!@, x: T)
      @hook(!@, x)

  sub boxed(b: !^Checker)
    b.hook(!b)

  sub through(c: !Checker)
    w = !c
    w.hook(!w)

  print(1)

fail "owned closure captures view", "an owned closure cannot capture `v`, which holds a view;", "an owned closure cannot capture `w`, which holds a view of `b`", "an owned closure cannot capture `vw`, which holds a view of `b`"
  # An owned closure is a shared handle that can be stored anywhere,
  # including in a Cell or Signal that other handles reach, so it holds no
  # view: it cannot capture a view, a view parameter, or a view.

  obj Wrap
    n: Int

  obj View
    b: ?Wrap

  fun keep(v: View) -> *sub()
    *|<v| print(v.b.n)

  b = Wrap(n: 1)
  w = !b
  g: *sub() = *|<w|
    w.n += 1
  g()
  vw = View(b: ?b)
  f = *|<vw| print(vw.b.n)
  f()

fail "owned closure generic view loan", "23:4: cannot drop `t` while it is lent", "30:4: cannot drop `t` while it is lent", "38:4: cannot drop `t` while it is lent", errors: 3
  # An owned closure's generic `T` may hold a view of a `?String` argument,
  # so what the call returns, or stores through a `!T`, keeps it lent.
  obj K
    s: ?String

  obj H[T]
    f: *fun(?String) -> T

    fun make(?@, s: ?String) -> T
      @f(s)

    sub fill(?@, out: !T, s: ?String) keeps s
      out = @f(s)

  sub run[T](f: ?*sub(!T, ?String), k: !T, s: ?String) keeps s
    f(!k, s)

  sub through_write_param()
    f: *sub(!K, ?String) = *|k, s| k.s = s
    k = K(s: "x")
    t = String("abc")
    run(?f, !k, ?t)
    <t
    print(k.s)

  sub through_result()
    h = H[K](f: *|s| K(s: s))
    t = String("abc")
    k = ?h.make(?t)
    <t
    print(k.s)

  sub through_stored_result()
    h = H[K](f: *|s| K(s: s))
    t = String("abc")
    k = K(s: "x")
    h.fill(!k, ?t)
    <t
    print(k.s)

  through_write_param()
  through_result()
  through_stored_result()

