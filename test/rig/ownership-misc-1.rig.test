# ownership: the rest of its tests, part 1.

use std.math
use std.sort
use std.text

fail "alias capture if expr", "8:5: `count` is captured by the closure, which keeps it for every call, so a binding can't take it; write `+count` for another handle, or `~count` for a weak one", "10:5: `count` is captured by the closure, which keeps it for every call, so a binding can't take it; write `+count` for another handle, or `~count` for a weak one"
  # Inside a closure, choosing a captured resource with an if-expression
  # is still a bare copy of the captured handle; it is rejected like
  # `y = count`.

  count: *Cell[Int] = *Cell(0)
  f = |+count|
    y = if true
      count
    else
      count
    print(y.get())
  f()
  f()

fail "alias deeply nested generic", "12:5: `b` owns a `Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[*P]]]]]]]]]]`, which can't be copied by `=`: write `<b` to move it, `+b` to clone it, or `?b` to view it"
  # A resource nested deep inside generic wrappers still gives the whole
  # value drop glue, so copying it is rejected.

  obj P
    n: Int

  obj Wrap[T]
    value: T

  h: *P = *P(n: 5)
  b: Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[*P]]]]]]]]]] = Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: <h))))))))))
  c = b
  print(c.value.value.value.value.value.value.value.value.value.value.n)

fail "alias enum with resource payload", "13:5: `s` owns a `Slot`, which can't be copied by `=`: write `<s` to move it, `+s` to clone it, or `?s` to view it"
  # An enum whose payload holds a shared handle owns it; copying the enum
  # would drop the handle twice.

  obj Wrap
    n: Int

  enum Slot
    full(b: *Wrap)
    empty

  rc = *Wrap(n: 5)
  s: Slot = .full(b: <rc)
  t = s
  match t
    .full(b) => print(b.n)
    .empty => print(0)

fail "alias field binding", "11:5: `p.a` is a `*Wrap` handle, which can't be copied by `=`: write `+p.a` for another handle or `?p.a` to view it"
  # Binding a shared-handle field (`x = p.a`) would copy the handle without
  # a refcount bump. Clone it (`+p.a`); fields cannot be moved out.

  obj Wrap
    payload: Int

  obj Pair
    a: *Wrap

  p = Pair(a: *Wrap(payload: 1))
  x = p.a
  print(x.payload)

fail "alias field call arg", "15:5: `eat` takes ownership of a `*Wrap`, and `o.inner` can't be copied: write `+o.inner` for another handle; if `eat` only reads it, make its parameter a `?*Wrap`", "16:5: `eat` takes ownership of a `*Wrap`, and `o.inner` can't be copied: write `+o.inner` for another handle; if `eat` only reads it, make its parameter a `?*Wrap`"
  # Passing a shared-handle field as an owned argument would copy the
  # handle without a refcount bump.

  obj Wrap
    payload: Int

  obj Outer
    inner: *Wrap

  sub eat(rc: *Wrap)
    print(rc.payload)

  b = *Wrap(payload: 7)
  o = *Outer(inner: <b)
  eat(o.inner)
  eat(o.inner)

fail "alias generic with resource arg", "12:5: `h` owns a `Holder[*Wrap]`, which can't be copied by `=`: write `<h` to move it, `+h` to clone it, or `?h` to view it"
  # A generic struct instantiated with a resource (`Holder[*Wrap]`) owns it;
  # copying the struct would drop the handle twice.

  obj Holder[T]
    value: T

  obj Wrap
    n: Int

  rc = *Wrap(n: 5)
  h: Holder[*Wrap] = Holder(value: <rc)
  g = h
  print(g.value.n)

fail "alias if expr", "9:3: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it", "11:3: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it"
  # A shared handle chosen by an if-expression is still a bare copy of
  # the handle: each branch must write `<rc` or `+rc`.

  obj Wrap
    payload: Int

  rc = *Wrap(payload: 7)
  x = if true
    rc
  else
    rc
  print(x.payload)

fail "alias match expr", "10:8: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it", "11:8: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it"
  # A shared handle chosen by a match expression is still a bare copy of
  # the handle: each arm must write `<rc` or `+rc`.

  obj Wrap
    payload: Int

  rc = *Wrap(payload: 5)
  n = 1
  x = match n
    1 => rc
    _ => rc
  print(x.payload)

test "alias rule uses local types", '''
  1
  42
'''
  # The shared-handle alias rule classifies each name by its own scope:
  # `rc` is a handle in `holder` but a plain Int in `consumer`, where the
  # bare `print(rc)` is fine.

  obj Wrap
    value: Int

  sub holder(rc: *Wrap)
    print(rc.value)
    <rc

  sub consumer(rc: Int)
    print(rc)

  b = *Wrap(value: 1)
  holder(<b)
  consumer(42)

fail "alias upgrade result", "10:5: `m` is a `*Wrap?` handle, which can't be copied by `=`: write `<m` to move it, `+m` for another handle, or `?m` to view it"
  # The `*T?` from `upgrade()` owns a strong handle; copying it would
  # drop the handle twice.

  obj Wrap
    n: Int

  rc = *Wrap(n: 5)
  w = ~rc
  m = *w
  n = m
  <w

fail "argument field of branch then written", "20:33: cannot lend `a` to write while an earlier argument's read of it is in use", errors: 1
  # A field of a branching argument is read where the branch is: a later
  # argument cannot lend what the branch may be to write.

  obj P
    v: List[Int]

  fun mk(k: Int) -> P
    v: List[Int] = List()
    !v.push(k)
    P(v: <v)

  fun growp(p: !P) -> Int
    for i in 0..100
      !p.v.push(i)
    0

  a = mk(1)
  b = mk(2)
  c = true
  print((a if c else b).v, growp(!a))

test "argument read then written", '''
  1 2 2
  0 2 [0, 7, 7]
  2 [0, 7, 7, 7]
  [0, 7, 7, 7, 4]
  P(x: 1, y: 2) 0 P(x: 2, y: 2)
  4 P(x: 3, y: 2)
  5 2 [7]
  1 2 2
  [7, 7, 2]
  Q(p: P(x: 3, y: 2), n: 0) P(x: 4, y: 2)
  hi 0 0
'''
  # A call's arguments run left to right. An argument that reads plain
  # data (a number, a String, a Copy struct) holds a finished value, so a
  # later argument may write the place it came from, and the call sees
  # the value as it was read. A write that finishes before the read, a
  # read receiver whose call ends before the write, and a write receiver
  # whose argument reads it are fine too.

  obj P
    x: Int
    y: Int

  obj S
    a: List[Int]
    b: Int

    fun count(?@, n: Int) -> Int
      @a.len + n

    sub add(!@, n: Int)
      !@a.push(n)

  obj Q
    p: P
    n: Int

  fun grow(v: !List[Int]) -> Int
    !v.push(7)
    2

  fun bump(p: !P) -> Int
    p.x += 1
    0

  fun sum(p: P, n: Int) -> Int
    p.x + p.y + n

  fun clears(ss: !List[?String]) -> Int
    ss = List()
    0

  v: List[Int] = List()
  !v.push(0)
  print(v.len, grow(!v), v.len)
  print(v[0], grow(!v), v)
  print(grow(!v), v)
  !v.push(v.len)
  print(v)
  p = P(x: 1, y: 2)
  print(p, bump(!p), p)
  print(sum(p, bump(!p)), p)
  s = S(a: List(), b: 5)
  print(s.b, grow(!s.a), s.a)
  print(s.count(0), grow(!s.a), s.count(0))
  !s.add(s.count(0))
  print(s.a)
  q = Q(p: p, n: bump(!p))
  print(q, p)
  ss: List[?String] = List()
  !ss.push("hi")
  print(ss[0], clears(!ss), ss.len)

fail "argument read then written is rejected", "50:16: cannot lend `v` to write while an earlier argument's read of it is in use", "51:15: cannot move `v` while an earlier argument's read of it is in use", "54:16: cannot lend `w` to write while an earlier argument's read of it is in use", "56:16: cannot lend `s.a` to write while an earlier argument's read of `s` is in use", "57:18: cannot lend `s.a` to write while an earlier argument's read of it is in use", "59:18: cannot lend `rc` to write while an earlier argument's read of it is in use", "61:17: cannot lend `b` to write while an earlier argument's read of it is in use", "63:11: cannot lend `x` to write while an earlier argument's read of it is in use", "65:20: cannot lend `z` to write while a read loan is live", "66:26: cannot lend `z` to write while a read loan is live", "67:27: cannot lend `z` to write while a read loan is live", "69:21: cannot lend `s.a` to write while a read loan on `s` is live", "71:17: cannot lend `o` to write while an earlier argument's read of it is in use", errors: 13
  # A call evaluates its arguments left to right and uses them all when
  # it runs. An argument that reads a value owning storage (a List, a Box,
  # a shared handle, or a struct holding one) shares that storage with
  # the place it reads, so a later argument cannot lend to write or move
  # that place: the call would see a stale or freed value. A view, a
  # slice, or a read receiver in an earlier argument holds it the same
  # way.

  obj Node
    n: Int

  obj S
    a: List[Int]
    b: Int

    fun count(?@, n: Int) -> Int
      @a.len + n

  obj View
    r: ?List[Int]
    n: Int

  fun grow(v: !List[Int]) -> Int
    !v.push(7)
    2

  fun eat(v: List[Int]) -> Int
    v.len

  fun reset(r: !*Node) -> Int
    r = *Node(n: 9)
    0

  fun rebox(b: !^Int) -> Int
    b = ^5
    0

  fun clear(o: !List[Int]?) -> Int
    o = none
    0

  fun rd(v: ?List[Int], n: Int) -> Int
    v.len + n

  fun take(s: []Int, n: Int) -> Int
    s.len + n

  v: List[Int] = List()
  !v.push(0)
  print(v, grow(!v), v)
  print(v, eat(<v))
  u: List[Int] = List()
  w = !u
  print(w, grow(!w))
  s = S(a: List(), b: 1)
  print(s, grow(!s.a))
  print(s.a, grow(!s.a))
  rc = *Node(n: 1)
  print(rc, reset(!rc))
  b = ^3
  print(b, rebox(!b))
  x: List[Int] = List()
  print(x, (!x).pop() ?? 0)
  z: List[Int] = List()
  print(rd(?z, grow(!z)))
  print(take(?z[..], grow(!z)))
  vw = View(r: ?z, n: grow(!z))
  print(z.len, vw.n)
  print(s.count(grow(!s.a)))
  o: List[Int]? = List()
  print(o, clear(!o))

fail "argument write loan held", "32:30: cannot lend `b` to read while a write loan is live", "37:19: cannot lend `x` to read while a write loan is live", "42:20: cannot lend `x` to read while a write loan is live", errors: 3
  # A value an argument hands a call that carries a write loan keeps its
  # root lent to write until the call returns, so a later argument cannot
  # lend it, read it, or move it (Core sentence 5).
  # oracle: receiver_result reject C4
  # oracle: moved_view reject C4
  # oracle: closure_arg reject C4

  obj Item
    n: Int

  obj Bag
    items: List[Item]

    fun firstw(!@) -> !Item
      !@items[0]

  fun both(a: !Item, b: ?Bag) -> Int
    a.n += 1
    a.n + b.items[0].n

  fun pair(a: !Item, b: ?Item) -> Int
    a.n += 1
    a.n + b.n

  fun calls(f: ?sub(), b: ?Item) -> Int
    f()
    b.n

  sub receiver_result()
    b = Bag(items: List())
    !b.items.push(Item(n: 7))
    print(both((!b).firstw(), ?b))

  sub moved_view()
    x = Item(n: 1)
    w = !x
    print(pair(<w, ?x))

  sub closure_arg()
    x = Item(n: 1)
    f = |!x| x.n += 1
    print(calls(?f, ?x))

  receiver_result()

test "argument write view value read", '''
  7 1
  8
'''
  # A write view a method's result keeps of its receiver holds the
  # receiver lent to write only while a call holds the view: read where it
  # stands, its value is copied out first, and a later argument may read
  # the receiver (test/reject/ownership/argument_write_loan_held.rig).

  obj Item
    n: Int

  obj Bag
    items: List[Item]

    fun firstw(!@) -> !Item
      !@items[0]

  fun sum(a: Int, b: ?Bag) -> Int
    a + b.items.len

  b = Bag(items: List())
  !b.items.push(Item(n: 7))
  print((!b).firstw().n, b.items.len)
  print(sum((!b).firstw().n, ?b))

test "arm temporary drop reads binding", release: true, '''
  zero
  after 0
  m 12
  drop hi 10
  after 1
  m 22
  drop hi 20
  after 2
  x 10
  drop hp 7
  drop hp 4
  valued 5
  drop hp 5
  5 7
  hc 2 12
  drop hc 12 2
  hc2 6
  drop hc 22 6
  end
  drop d 22
'''
  # A temporary made in a `match` arm whose drop reads a view of the arm's
  # binding: the arm is the temporary's statement, so it is dropped where
  # the arm ends, while the binding is still in scope.
  error E
    bad

  obj P
    n: Int

  obj HI
    v: ?Int
    t: String

    drop(!@)
      print("drop hi", @v)

  obj HP
    v: ?P
    t: String

    drop(!@)
      print("drop hp", @v.n)

  obj D
    c: Cell[Int]

    drop(!@)
      print("drop d", @c.get())

  obj HC
    v: ?D
    c: Cell[Int]

    drop(!@)
      print("drop hc", @v.c.get(), @c.get())

    fun me(!@) -> Int
      !@c.set(@c.get() + 1)
      @c.get()

  enum Bx
    has(p: P)
    nothing

  enum Bd
    has(d: *D)
    nothing

  fun showi(h: ?HI) -> Int
    h.v + h.t.len

  fun showp(h: ?HP) -> Int
    h.v.n + h.t.len

  fun mkbx(n: Int) -> Bx
    return Bx.nothing if n < 0
    Bx.has(P(n: n))

  fun mkhc(v: ?D, n: Int) -> (*HC)!
    return E.bad if n < 0
    *HC(v: v, c: Cell(n))

  fun valued(b: ?Bx) -> Int
    r = match b
      .has(x) => showp(?HP(v: ?x, t: String("a")))
      .nothing => 0
    print("valued", r)
    r

  fun returned(b: ?Bx) -> Int
    match b
      .has(x) => return showp(?HP(v: ?x, t: String("ab")))
      .nothing => pass
    -1

  sub hc1(x: ?*D)
    h = +x
    !h.c.set(x.c.get() + 10)
    print("hc", (!(*HC(v: x, c: Cell(1)))).me(), x.c.get())

  sub hc2(x: ?*D)
    h = +x
    !h.c.set(x.c.get() + 10)
    print("hc2", (!(mkhc(x, -1) catch *HC(v: x, c: Cell(5)))).me())

  sub cells(b: ?Bd)
    match b
      .has(x) => hc1(x)
      .nothing => pass
    match b
      .has(x) => hc2(x)
      .nothing => pass

  for i in 0..3
    match i * 10
      0 => print("zero")
      m => print("m", showi(?HI(v: ?m, t: String("ab"))))
    print("after", i)
  match mkbx(7)
    .has(x) => print("x", showp(?HP(v: ?x, t: String("abc"))))
    .nothing => print("none")
  print(valued(?mkbx(4)), returned(?mkbx(5)))
  d = Bd.has(*D(c: Cell(2)))
  cells(?d)
  print("end")

test "arm temporary views binding", '''
  arm 6
  arm2 2 5
  guarded 5
  caught 5
  none
  none
  none
  none
  5 5 -2 50 -1
  8 5 0
  loop 0 4
  loop 2 4
'''
  # A `match` arm's body is a statement of its own, as a block's line is:
  # a temporary it makes ends with the arm, so it may view the arm's
  # bindings. Here no drop reads the view.
  error E
    bad

  obj P
    n: Int

  obj HT
    v: ?P
    t: String

  fun len2(h: ?HT) -> Int
    h.v.n + h.t.len

  fun mkht(v: ?P) -> HT
    HT(v: v, t: String("ab"))

  fun mkhtf(v: ?P, n: Int) -> HT!
    return E.bad if n < 0
    mkht(v)

  enum Bx
    has(p: P)
    nothing

  sub arms(b: ?Bx)
    match b
      .has(x) => print("arm", len2(?HT(v: ?x, t: String("abc"))))
      .nothing => print("none")
    match b
      .has(x) => print("arm2", mkht(?x).t.len, len2(?mkht(?x)))
      .nothing => print("none")
    match b
      .has(x) if len2(?mkht(?x)) > 4 => print("guarded", len2(?mkht(?x)))
      .has(x) => print("unguarded", x.n)
      .nothing => print("none")
    match b
      .has(x) => print("caught", len2(?(mkhtf(?x, -1) catch mkht(?x))))
      .nothing => print("none")

  fun valued(b: ?Bx) -> Int
    r = match b
      .has(x) => len2(?mkht(?x))
      .nothing => 0
    r

  fun tail(n: Int) -> Int
    match n
      m if m > 0 => len2(?HT(v: ?P(n: m), t: String("q")))
      m => m

  fun returned(b: ?Bx) -> Int
    match b
      .has(x) => return len2(?mkht(?x)) * 10
      .nothing => pass
    -1

  fun nested(b: ?Bx, c: ?Bx) -> Int
    match b
      .has(x) => match c
        .has(y) => len2(?mkht(?x)) + len2(?mkht(?y))
        .nothing => len2(?mkht(?x))
      .nothing => 0

  sub looped(b: ?Bx)
    for i in 0..4
      match b
        .has(_) if i == 1 => continue
        .has(_) if i == 3 => break
        .has(x) => print("loop", i, len2(?HT(v: ?x, t: String("z"))))
        .nothing => pass

  b = Bx.has(P(n: 3))
  c = Bx.has(P(n: 1))
  arms(?b)
  arms(?Bx.nothing)
  print(valued(?b), tail(4), tail(-2), returned(?b), returned(?Bx.nothing))
  print(nested(?b, ?c), nested(?b, ?Bx.nothing), nested(?Bx.nothing, ?c))
  looped(?b)

fail "array of owners copied", "8:5: `a` owns a `[2]String`, which can't be copied by `=`: write `<a` to move it, `+a` to clone it, or `?a` to view it", "9:12: `a` owns a `[2]String`, which can't be copied into an argument: write `<a` to move it or `+a` to pass a clone"
  # An array whose elements own is moved, never copied: a bare use names
  # the array's type.

  obj S
    arr: [2]String

  a = [String("a"), String("b")]
  b = a
  s = S(arr: a)
  print(a, b, s.arr)

fail "as bare write view", "11:9: `as` over a write view lends it on: write `!o` to lend the value inside"
  # `as` over a held write view of an optional lends it on, so it is
  # written `!o`, as when passing it on.

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  sub spin(o: !Res?)
    while o as v
      v.n += 1
      break

  r: Res? = Res(n: 1)
  spin(!r)

fail "as binding lent through body", "19:16: cannot lend `h` to write while a write loan is live", "23:23: cannot lend `g` to write while a write loan is live", errors: 2
  # What `while … as` binds, and what an earlier part of a joined
  # condition binds, view the value they reach while they are used: a
  # write lend of it in the body, or in a later part, is rejected.

  obj H
    o: ^Int?

  fun clear(h: !H) -> Bool
    h.o = none
    false

  fun yes(h: !H) -> Bool
    h.o = none
    true

  h = H(o: ^3)
  z = !h
  while ?z.o as s
    print(clear(!h))
    print(s)
  g = H(o: ^4)
  y = !g
  if ?y.o as s and yes(!g)
    print(s)

test "as chain moves", '''
  take 1
  drop 1
  b 2
  drop 2
  end
  none
  end
  drop 4
  drop 5
  none
  end
'''
  # Each `as` of a joined condition moves only when the parts before it
  # held: an optional not reached stays with its owner, and a binding
  # made before a part that fails is dropped before `else` runs.

  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun make(k: Int) -> Res?
    Res(id: k) if k > 0 else none

  sub take(r: Res)
    print("take", r.id)

  sub try_pair(i: Int, j: Int)
    p: Res? = make(i)
    q: Res? = make(j)
    if <p as a and <q as b
      take(<a)
      print("b", b.id)
    else
      print("none")
    print("end")

  try_pair(1, 2)
  try_pair(0, 4)
  try_pair(5, 0)

test "as lends cell and fresh", '''
  C(hits: Cell(value: 1))
  R(n: 2)
'''
  # An optional handle to a value holding a Cell is lent by `if !o as x`,
  # not copied, so a change through the Cell reaches `o`. A write view a
  # call returns is bound as one, as `!o` is.

  obj C
    hits: Cell[Int]

  obj R
    n: Int

  fun get(h: !R?) -> !R?
    !h

  o: (*C)? = *C(hits: Cell(0))
  if !o as y
    !y.hits.set(y.hits.get() + 1)
  print(o)
  h: R? = R(n: 1)
  if get(!h) as x
    x.n += 1
  print(h)

test "as lends optional value", '''
  read 1
  peek 2
  peek 12
  drop 12
  peek 0
  6
  peek none
  end
  drop 0
'''
  # `as` over a view of an optional views the value inside instead of
  # moving it out: `if ?o as v` reads it and `if !o as v` writes it in
  # place (`v = x` replaces it, dropping the old value), while `o` keeps
  # it. A `?T?` parameter is read the same way; plain data read through
  # a `?T?` is copied.

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  sub peek(o: ?Res?)
    if o as v
      print("peek", v.n)
    else
      print("peek none")

  sub grow(o: !Res?)
    if !o as v
      v.n += 10

  sub reset(o: !Res?)
    if !o as v
      v = Res(n: 0)

  r: Res? = Res(n: 1)
  if ?r as v
    print("read", v.n)
  if !r as v
    v.n += 1
  peek(?r)
  grow(!r)
  peek(?r)
  reset(!r)
  peek(?r)
  n: Int? = 5
  if !n as v
    v += 1
  print(n)
  none_r: Res? = none
  peek(?none_r)
  print("end")

test "as lends through paths", '''
  field 3
  call 4
  local 4
  some
  Res(n: 7)
  drop 7
'''
  # A viewed `as` binding reaches the optional through any place: a
  # field, a call returning a view, a local holding one. `as _` tests
  # without binding, and `while !o as v` changes the value each time.

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  obj Holder
    r: Res?

  fun get(h: ?Holder) -> ?Res?
    ?h.r

  h = Holder(r: Res(n: 3))
  if ?h.r as v
    print("field", v.n)
  if !h.r as v
    v.n = 4
  if get(?h) as v
    print("call", v.n)
  b = ?h.r
  if b as v
    print("local", v.n)
  if ?h.r as _
    print("some")
  count = 0
  while !h.r as v
    v.n += 1
    count += 1
    if count == 3
      break
  print(h.r)

test "as read write view value", release: true, '''
  3 3 5 ello
  6 5 3
  true 6 5 6 5
  10
  hello
  hello 3
  3
  3 bc
  hello! 9
'''
  # `if o as x` and `while o as x` of a `(!T)?` that the header reads,
  # a local or a parameter, bind `x` as the read view of what the write
  # view views: `!P` as `?P`, `![]Int` as `[]Int`, and `!Int` as an Int
  # copied out. Such an `x` is read, passed where a read view goes,
  # captured, cloned, and put in an array, and `if !o as x` writes
  # through it.

  obj P
    t: String
    n: Int

  fun show(q: ?P) -> Int
    q.t.len

  fun total(a: []Int) -> Int
    s = 0
    for x in a
      s += x
    s

  sub params(o: (!P)?, so: (![]Int)?, no: (!Int)?)
    if o as x
      g = |?x| x.n
      arr = [x]
      print(g(), arr[0].n, show(x), x.t[1..])
    if so as s
      print(total(s), total(s[1..]), s.len)
    if no as k
      g = |?k| k == 5
      h = |+k| k + 1
      m: Int = k
      arr = [k, k]
      print(g(), h(), m, k + 1, arr[1])
    while no as k
      print(k * 2)
      break
    while o as x
      print(x.t)
      break

  p = P(t: String("hello"), n: 3)
  o: (!P)? = !p
  a = [1, 2, 3]
  so: (![]Int)? = !a[..]
  n = 5
  no: (!Int)? = !n
  params(o, so, no)
  if o as y
    print(y.t, y.n)
  while o as y
    print(y.n)
    break
  tt = String("abc")
  to: (!String)? = !tt
  if to as t
    print(t.len, t[1..])
  if !o as w
    w.n = 9
    !w.t.add("!")
  print(p.t, p.n)

