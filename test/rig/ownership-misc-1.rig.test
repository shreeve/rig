test "return handle same name as int", '''
  5
  99
  drop
  end
'''
  # Resource classification is per scope: `x` is an Int in one function
  # and a shared handle in another. Returning the handle `x` hands
  # ownership to the caller instead of dropping it at function exit.

  obj U
    v: Int

    drop(!@)
      print("drop")

  sub take_int(x: Int)
    print(x)

  fun make_rc() -> *U
    x = *U(v: 99)
    return x

  take_int(5)
  rc = make_rc()
  print(rc.v)
  <rc
  print("end")

test "return local shared handle", '''
  42
  drop
'''
  # A factory returns a local shared handle with a bare `return rc`; the
  # caller owns it and it is dropped once, at the caller's scope exit.

  obj Counter
    value: Int

    drop(!@)
      print("drop")

  fun make_counter(n: Int) -> *Counter
    rc = *Counter(value: n)
    return rc

  c = make_counter(42)
  print(c.value)

test "return local through if", '''
  20
  1
  10
'''
  # A local returned through an if-expression moves out of the function;
  # the local in the branch not taken is dropped at scope exit.

  obj Wrap
    payload: Int

    drop(!@)
      print(@payload * 10)

  fun pick(c: Bool) -> *Wrap
    a = *Wrap(payload: 1)
    b = *Wrap(payload: 2)
    if c
      a
    else
      b

  x = pick(true)
  print(x.payload)

fail "return shared field", "`o.inner` is a `*Wrap` handle, which can't be copied out by `return`: write `+o.inner` for another handle"
  # Returning a shared-handle field would copy the handle without a
  # refcount bump; clone it with `+o.inner`.

  obj Wrap
    payload: Int

  obj Outer
    inner: *Wrap

  fun take(o: Outer) -> *Wrap
    o.inner

  print(1)

fail "return struct with local view", "cannot return a view of `user`, which this function was not lent"
  # A view of a local stored in a returned struct escapes the function.

  obj User
    age: Int

  obj View
    user: ?User

  fun bad() -> View
    user = User(age: 42)
    View(user: ?user)

  v = bad()
  print(v.user.age)

fail "return view chosen by if", "cannot return a view of `b`, which this function was not lent"
  # A view returned through an if-expression must come from a viewed
  # parameter on every branch.

  obj Wrap
    payload: Int

  fun pick(a: ?Wrap, c: Bool) -> ?Wrap
    b = Wrap(payload: 1)
    if c
      ?b
    else
      a

  print(1)

fail "return view of local", "cannot return a view of `user`, which this function was not lent"
  # A returned view must come from a view parameter, not a local.

  obj User
    name: String

  fun bad() -> ?String
    user = User(name: String("Steve"))
    ?user.name

  fun name(user: ?User) -> ?String
    ?user.name

test "return write view", "5"
  # A function may return a write view it was given; writes through the
  # returned view reach the caller's value.

  obj C
    n: Int

  fun pick(c: !C) -> !C
    c

  sub set_through(c: !C)
    r = pick(!c)
    r.n = 5

  c = C(n: 1)
  set_through(!c)
  print(c.n)

fail "shadow fixed is fixed", "6:1: cannot reassign fixed binding `x`"
  # `new x =! e` shadows the visible `x` with a fixed binding, which
  # cannot be reassigned.

  x = 1
  new x =! x + 1
  x = 3
  print(x)

fail "share named drop glue", "`o` owns an `Owner`, which can't be copied into a counted handle: write `<o` to move it or `+o` to clone it"
  # `*o` moves `o` into a new counted handle; with a bare name that would leave
  # `o` owning the same resources. Write `*<o`.

  obj Wrap
    payload: Int

  obj Owner
    b: *Wrap

  o = Owner(b: *Wrap(payload: 3))
  s = *o
  print(1)

fail "shared alias binding", "`rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it"
  # `rc2 = rc` on a shared handle is rejected: it would alias the handle
  # without a refcount bump. Use `<rc` or `+rc`.

  obj Wrap
    value: Int

  rc = *Wrap(value: 1)
  rc2 = rc
  <rc2
  <rc

fail "shared alias call arg", "`use_rc` takes ownership of a `*Wrap`, and `rc` can't be copied: write `<rc` to move it or `+rc` for another handle; if `use_rc` only reads it, make its parameter a `?*Wrap`"
  # Passing a bare shared handle as a call argument is rejected: caller
  # and callee would both own it. Use `<rc` or `+rc`.

  obj Wrap
    value: Int

  sub use_rc(rc: *Wrap)
    <rc

  rc = *Wrap(value: 1)
  use_rc(rc)
  <rc

