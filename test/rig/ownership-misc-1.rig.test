test "handle lend writable", '''
  9
  9
  9
  5
'''
  # `!c` lends the handle itself, which a callee may point elsewhere, only
  # where `c` may be written: an owned mutable local, a `!*T` parameter, a
  # handle field of a value reached through a write view. A fixed (`=!`) handle
  # or a read-only parameter lends what it holds.

  obj W
    h: *Cell[Int]

  sub repoint(x: !*Cell[Int])
    x = *Cell(9)

  sub again(x: !*Cell[Int])
    repoint(!x)

  sub set5(c: !Cell[Int])
    !c.set(5)

  sub through(w: !W)
    repoint(!w.h)

  a = *Cell(1)
  repoint(!a)
  print(a.get())
  b = *Cell(1)
  again(!b)
  print(b.get())
  w = W(h: *Cell(1))
  through(!w)
  print(w.h.get())
  k =! *Cell(1)
  set5(!k)
  print(k.get())

test "hoisted implicit lends", '''
  mk 2
  mk 1
  12
  drop 1
  drop 2
  mk 2
  mk 1
  12
  drop 1
  drop 2
  mk 1
  drop 2
  drop 1
  12
  mk 1
  drop 1
  -1
  mk 1
  drop 2
  drop 1
  12
  mk 1
  drop 2
  drop 1
  12
  mk 1
  drop 1
  -1
  mk 1
  drop 2
  drop 1
  drop 100
  103
  mk 1
  drop 1
  3
  mk 1
  drop 1
  -1
'''
  # A value made where a view argument goes is lent as a statement
  # temporary, also when the call's arguments are evaluated first into
  # names (keyword arguments out of order, a later `!` or `?`, a method's
  # receiver): it is kept once, and dropped once at the statement's end,
  # as `?mk(1)` is (the explicit forms are the controls).

  obj Bag
    n: Int

    drop(!@)
      print("drop", @n)

    fun plus2(?@, o: ?Bag, p: ?Bag) -> Int
      @n + o.n + p.n

  error Bad
    boom

  fun two(a: ?Bag, b: ?Bag) -> Int
    a.n * 10 + b.n

  fun mk(n: Int) -> Bag
    print("mk", n)
    Bag(n: n)

  fun mkf(n: Int) -> Bag!
    if n > 5
      return Bad.boom
    Bag(n: n)

  fun mko(n: Int) -> Bag?
    if n > 5
      return none
    Bag(n: n)

  fun val(n: Int) -> Int!
    if n > 5
      return Bad.boom
    n

  fun one(a: ?Bag, n: Int) -> Int
    a.n + n

  fun run_f(n: Int) -> Int!
    two(mk(1), mkf(n)!)

  fun run_f2(n: Int) -> Int!
    two(?mk(1), ?mkf(n)!)

  fun run_o(n: Int) -> Int?
    two(mk(1), mko(n)?)

  fun run_m(n: Int) -> Int!
    b = Bag(n: 100)
    b.plus2(mk(1), mkf(n)!)

  fun run_v(n: Int) -> Int!
    one(mk(1), val(n)!)

  print(two(b: mk(2), a: mk(1)))
  print(two(b: ?mk(2), a: ?mk(1)))
  print(run_f(2) catch -1)
  print(run_f(9) catch -1)
  print(run_f2(2) catch -1)
  print(run_o(2) ?? -1)
  print(run_o(9) ?? -1)
  print(run_m(2) catch -1)
  print(run_v(2) catch -1)
  print(run_v(9) catch -1)

fail "holder view locks owner", "14:1: cannot lend `a` to write while a read loan is live", "18:6: cannot move `c` while a read loan is live", "22:1: cannot lend `e` to write while a read loan is live", "27:2: cannot drop `f` while it is lent", errors: 4
  # A value that holds a read view keeps the viewed owner lent while the
  # value is used: a box, a generic function's result, an optional, and a
  # generic struct, each of a List. The owner can be neither written nor
  # moved nor dropped until the last use of the holder.

  obj Hold[T]
    v: T

  fun same[T](x: T) -> T
    x

  a: List[Int] = List()
  b = ^?a
  !a.push(1)
  print(b.len)
  c: List[Int] = List()
  r = same(?c)
  d = <c
  print(r.len, d.len)
  e: List[Int] = List()
  o: (?List[Int])? = ?e
  !e.push(1)
  if o as w
    print(w.len)
  f: List[Int] = List()
  h = Hold(v: ?f)
  <f
  print(h.v.len)

fail "holder view returned", "9:5: cannot return a view of `v`, which this function was not lent", "13:9: cannot return a view of `v`, which this function was not lent", "17:4: cannot return a view of `v`, which this function was not lent", errors: 3
  # A holder of a view of a local cannot leave the function that owns the
  # local, however the view was wrapped.

  fun same[T](x: T) -> T
    x

  fun boxed() -> ^?List[Int]
    v: List[Int] = List()
    ^?v

  fun through() -> ?List[Int]
    v: List[Int] = List()
    same(?v)

  fun optional() -> (?List[Int])?
    v: List[Int] = List()
    ?v

  print(boxed().len, through().len, optional() == none)

test "if as clone or move optional", '''
  clone 1
  moved 1
  end
  drop 1
'''
  # An optional handle held in a binding is bound with `as` by cloning it
  # (`if +m as h`) or moving it (`if <m as h`).

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  rc = *B(n: 1)
  w = ~rc
  m = *w
  if +m as h
    print("clone", h.n)
  if <m as h
    print("moved", h.n)
  print("end")

test "if as move binding", '''
  eat 1
  after eat
  end
  drop 1
'''
  # A resource bound by `as` may be moved out of the branch; then it is not
  # dropped there.

  obj Noisy
    id: Int

    drop(!@)
      print("drop", @id)

  sub eat(n: *Noisy)
    print("eat", n.id)

  rc = *Noisy(id: 1)
  w = ~rc
  if *w as n
    eat(<n)
    print("after eat")
  print("end")

fail "if header view escapes", "18:23: a view of the temporary `String(\"pre-fix\")` outlives its statement", "21:14: a view of the temporary `String(\"q,r\")` outlives its statement", "23:14: a view of the temporary `String(\"s,t\")` outlives its statement", "27:9: a view of the temporary `mk()` outlives its statement", "31:19: a view of the temporary `String(\"u,w\")` outlives its statement", errors: 5
  # The temporaries of an `if` header live through the `if`, and no
  # longer: a view of one the body leaves in a binding, a List, or through
  # a view outlives them.


  obj N
    v: List[Int]

  fun mk() -> N
    v: List[Int] = List()
    !v.push(1)
    N(v: <v)

  fun idp(n: ?N) -> (?List[Int])?
    ?n.v

  o: ?String = "init"
  if text.strip_prefix(?String("pre-fix"), "pre-") as rest
    o = rest
  v: List[?String] = List()
  if text.cut(?String("q,r"), ",") as kv
    !v.push(kv.before)
  if text.cut(?String("s,t"), ",") as kv and kv.before.len > 0
    o = kv.after
  keep: List[Int] = List()
  p = ?keep
  if idp(?mk()) as r
    p = r
  if false
    print("x")
  else if text.cut(?String("u,w"), ",") as kv
    o = kv.before
  print(o, v, p)

