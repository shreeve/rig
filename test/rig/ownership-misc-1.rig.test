fail "index of read place", "46:14: cannot lend `v` to write in an index of a place it is lending", "59:16: cannot lend `v` to write in an index of a place it is lending", "60:18: cannot lend `v` to write in an index of a place it is lending", "61:28: cannot lend `p` to write in an index of `p.qs`, a place being lent", "62:24: cannot lend `p` to write in an index of `p.bx.vals`, a place being lent", "63:15: cannot lend `v` to write in an index of a place it is lending", "65:18: cannot lend `v` to write in an index of a place it is lending", "68:19: cannot lend `w` to write in an index of a place it is lending", "69:30: cannot lend `h` to write in an index of a place it is lending", "71:14: cannot lend `l` to write in an index of a place it is lending", "72:17: cannot move `v` in an index of a place it is lending", errors: 11
  # A place that is read or taken is found up to each index before the
  # index runs. Where what the index is applied to lies past a List's
  # buffer, a box, or a handle, or is a handle itself, a write of the root
  # could move or free it, so the index cannot lend the root to write, or
  # move it. (Where it is an array or a List in the root's own storage, or
  # in an assignment's target, which is found after its indices run, the
  # index may: test/behavior/ownership/index_writes_place_root.rig.)

  obj Q
    vals: List[Int]

  obj P
    qs: List[Q]
    bx: ^Q

  fun grow(v: !List[List[Int]]) -> Int
    for _ in 0..100
      !v.push(List())
    0

  fun grow_q(p: !P) -> Int
    for _ in 0..100
      !p.qs.push(Q(vals: List()))
    0

  fun rebox(p: !P) -> Int
    p.bx = ^Q(vals: List())
    0

  fun grow_o(v: !List[List[Int?]]) -> Int
    !v.push(List())
    0

  fun reh(h: !*Q) -> Int
    h = *Q(vals: List())
    0

  fun rel(h: !*List[Int]) -> Int
    h = *List()
    0

  fun eat(v: List[List[Int]]) -> Int
    v.len

  fun at(v: !List[List[Int]]) -> Int
    v[0][grow(!v)]

