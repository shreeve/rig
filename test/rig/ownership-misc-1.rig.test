fail "shared field write view", "cannot lend to write through a shared handle", "cannot write-iterate through a shared handle"
  # A shared handle is read-only all the way down: a field reached through
  # it cannot be lent to write, lent to a `!T` parameter, given to a
  # `!@` method, or write-iterated.

  obj Counter
    n: Int

    sub bump(!@)
      @n += 1

  obj Holder
    v: List[Int]
    c: Counter

  sub inc(c: !Counter)
    c.n += 1

  h = *Holder(v: List(), c: Counter(n: 0))
  !h.v.push(1)
  !h.c.bump()
  inc(!h.c)
  for x in !h.v
    x += 1

fail "shared vec write method", "cannot call method `push`, which writes `self`, through a shared handle", "cannot call method `bump`, which writes `self`, through a shared handle"
  # A shared handle is read-only, the built-in List included: `!h.push`
  # through a `*List[T]` is rejected like any `!@` method, since other
  # handles may be reading it. Shared mutable state goes in a Cell.

  obj Counter
    n: Int

    sub bump(!@)
      @n += 1

  rv: *List[Int] = *List()
  !rv.push(100)
  c = *Counter(n: 0)
  !c.bump()

