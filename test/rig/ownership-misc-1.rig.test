  fun mk(c: Bool) -> List[Int]
    a: List[Int] = List()
    !a.push(1)
    if c
      defer
        for i in 0..100
          !a.push(i)
      a
    else
      List()

  x = mk(true)
  !x.push(3)
  print(x.len, x[0])

fail "tail returned name defer match", "7:14: use of `a` after move", errors: 1
  # A name a function returns through a `match` arm block leaves it before
  # the arm's defer runs.
  fun mk(k: Int) -> List[Int]
    a: List[Int] = List()
    match k
      0
        defer !a.push(9)
        a
      _ => List()

  x = mk(0)
  print(x.len)

test "take hint applied", '''
  false false
  false true
  true
'''
  # The forms the copy rejection offers for an optional field, applied.

  obj Bag
    items: List[Int]

  obj H
    o: Bag?

  sub viaread(p: ?H)
    x = +p.o
    y = ?p.o
    print(x == none, y == none)

  sub viawrite(p: !H)
    x = <p.o
    print(x == none, p.o == none)

  h = H(o: Bag(items: List()))
  viaread(?h)
  viawrite(!h)
  x = <h.o
  print(x == none)

fail "take hint where take allowed", "12:7: `p.o` owns a `Bag?`, which can't be copied by `=`: write `+p.o` to clone it or `?p.o` to view it", "16:7: `rc.o` owns a `Bag?`, which can't be copied by `=`: write `+rc.o` to clone it or `?rc.o` to view it", "20:7: `h.o` owns a `Bag?`, which can't be copied by `=`: write `<h.o` to move it out, `+h.o` to clone it, or `?h.o` to view it", "25:7: `h.o` owns a `Bag?`, which can't be copied by `=`: write `<h.o` to take it out (leaving `none`), `+h.o` to clone it, or `?h.o` to view it", "29:7: `p.o` owns a `Bag?`, which can't be copied by `=`: write `<p.o` to take it out (leaving `none`), `+p.o` to clone it, or `?p.o` to view it", errors: 5
  # The copy rejection offers `<p.o` to take an optional field out only
  # where the take is accepted: not through a read view or a shared handle;
  # out of a parameter, which is fixed, `<h.o` moves the field (Core §5).

  obj Bag
    items: List[Int]

  obj H
    o: Bag?

  sub viaread(p: ?H)
    x = p.o
    print(x == none)

  sub viashared(rc: *H)
    x = rc.o
    print(x == none)

  sub viaparam(h: H)
    x = h.o
    print(x == none)

  sub local()
    h = H(o: none)
    x = h.o
    print(x == none)

  sub viawrite(p: !H)
    x = p.o
    print(x == none)

  local()

fail "take needs owner", "10:5: cannot take out of a temporary", "13:8: cannot take `x`: it is a copy of the value inside `o`"
  # A take empties its place, so the place needs an owner that sees it:
  # not a temporary, and not a plain-data `as` binding, which is a copy.

  obj S
    a: Int?

  fun mk() -> S
    S(a: 1)

  t = <mk().a
  o: S? = S(a: 1)
  if o as x
    y = <x.a
    print(y, t)

test "take optional field", '''
  drop 1
  drop 2
  1 2
  end
  drop 3
'''
  # `<p.f` of an optional field takes the value out and leaves `none`
  # behind, so the place stays whole: a stack pushes, pops, and reverses
  # through `!@`, and a field of an `as` binding that owns its value is
  # taken and written.

  obj Node
    value: Int
    next: ^Node?

    drop(!@)
      print("drop", @value)

  obj Stack
    top: ^Node?

    sub push(!@, v: Int)
      @top = ^Node(value: v, next: <@top)

    fun pop(!@) -> Int?
      if <@top as n
        @top = <n.next
        return n.value
      none

    sub reverse(!@)
      cur = <@top
      prev: ^Node? = none
      while <cur as n
        cur = <n.next
        n.next = <prev
        prev = <n
      @top = <prev

  s = Stack(top: none)
  !s.push(1)
  !s.push(2)
  !s.push(3)
  !s.reverse()
  print((!s).pop(), (!s).pop())
  print("end")

fail "lend of a branch to a generic with its type inferred", "7:10: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?a if c else ?b`", errors: 1
  # Inference checks the argument quietly first; the check that reports
  # decides the lend again, so its error is not lost with the quiet one's.
  fun look[T](x: ?T) -> Int
    1

  fun pick[T](a: T, b: T, c: Bool) -> Int
    look(?(a if c else b))

  print(pick(String("a"), String("b"), true))

fail "lend of a branch to a generic with its type given", "cannot lend `a if c else b`: it may be `a`, a value a name holds", errors: 1
  fun look[T](x: ?T) -> Int
    1

  fun pick[T](a: T, b: T, c: Bool) -> Int
    look[T](?(a if c else b))

  print(pick(String("a"), String("b"), true))

fail "lend of a branch in a closure given to a generic", "cannot lend `s if x > 0 else t`: it may be `s`, a value a name holds, which lending the branching value would copy; lend each branch: `?s if x > 0 else ?t`", errors: 1
  fun look(x: ?String) -> Int
    x.len

  fun apply[T](f: ?fun(Int) -> T) -> T
    f(1)

  print(apply(|x|
    s = String("a")
    t = String("b")
    look(?(s if x > 0 else t)) + x
  ))

fail "kept view in a closure given to a generic", "`head(v)` keeps `v` lent while `r` lives; write `head(?v)`", errors: 1
  # Inference checks the closure quietly first; the check that keeps its
  # errors reports the kept view.
  fun head(xs: []Int) -> []Int
    xs[0..1]

  fun apply[T](f: ?fun(Int) -> T) -> T
    f(1)

  print(apply(|x|
    v: List[Int] = List()
    !v.push(1)
    r = head(v)
    r[0] + x
  ))
