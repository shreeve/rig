  r0 = R(n: 5)
  a = while true
    break r0
  x = for _ in 0..2
    r = R(n: 10)
    y = for _ in 0..2
      break r
    else
      R(n: 0)
    break y
  else
    R(n: 1)
  i = 0
  z = while i < 3
    q = R(n: i)
    defer print("defer", q.n)
    i += 1
    break q if i == 2
  else
    R(n: 99)
  print(a.n, x.n, z.n)

