  # A temporary receiver of a method that may keep a view of it, or a
  # Cell-holding part of one, is kept in its statement's slot, also when
  # the call's arguments run first: a view of it that the method returns,
  # or stores in what it was lent to write, may be used within the
  # statement (`test/behavior/ownership/cell_part_receiver_view_in_statement.rig`),
  # and nowhere after.

  obj S
    n: Int
    m: Int

    fun me(?@) -> ?S
      @

  obj Q
    c: Cell[Int]
    n: Int

    fun me(?@) -> ?Q
      @

    fun put(?@, h: !Holder) -> Int keeps @
      h.r = @
      @n

  obj Holder
    r: (?Q)?

  obj H
    q: Q

  fun mk() -> S
    S(n: 5, m: 6)

  fun mkh() -> *H
    *H(q: Q(c: Cell(1), n: 42))

  r = mk().me()
  print(r.n)
  h = Holder(r: none)
  print(mkh().q.put(!h))
  if h.r as q
    print(q.n)

test "labeled break after move", '''
  eat 1
  drop 1
  end
'''
  # `break $outer` leaves both loops, so a value moved just before it is
  # only unavailable after the outer loop, not after the inner one.

  obj Wrap
    payload: Int

    drop(!@)
      print("drop", @payload)

  sub eat(b: *Wrap)
    print("eat", b.payload)

  rc = *Wrap(payload: 1)
  i = 0
  $outer: while i < 3
    j = 0
    while j < 3
      if j == 1
        eat(<rc)
        break $outer
      j += 1
    print(rc.payload)
    i += 1
  print("end")

fail "labeled break carries move", "use of `rc` after move"
  # The state at `break $outer` flows to the end of the outer loop: a value
  # moved before it may be gone there.

  obj Wrap
    payload: Int

  sub eat(b: *Wrap)
    print(b.payload)

  rc = *Wrap(payload: 1)
  $outer: while true
    while true
      eat(<rc)
      break $outer
  print(rc.payload)

fail "lend branch of places", "31:9: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?a if c else ?b`", "35:9: cannot lend `a if c else b` to write: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `!a if c else !b`", "39:17: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?a if c else ?b`", "42:9: cannot lend `a if c else b` to write: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `!(!a if c else !b)[0].o`", "46:9: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?(?a if c else ?b)[0].v`", "50:11: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?a if c else ?b`", "55:11: cannot lend `a if c else b` to write: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `!a if c else !b`", "60:11: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?(?a if c else ?b).e`", "65:8: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?(?a if c else ?b).o`", "69:11: cannot lend `a if c else b` to write: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `!(!a if c else !b).o`", "74:15: cannot lend `a if c else b` to write: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `!a if c else !b`", "79:9: cannot lend `o ?? !d`: it may be `o`, a value a name holds, which lending the branching value would copy; lend each branch: `?o ?? !d`", "83:9: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend each branch: `?a if c else ?b`", errors: 13
  # A branch is a value, never a place: a lend (`?` or `!`) of a branch
  # (`a if c else b`, `a ?? b`, `e catch h`, `e?`, `e!`), or of a path of
  # fields, elements, and method calls from one, stands only where every
  # leaf is a value made there, a constant, or a lend itself
  # (`Checker.lendsBranch`).
  # One with a leaf a place holds would lend a copy of that leaf's value,
  # a write view included (Core §3: a lend of a branching value that may
  # be a name's is planned). Each branch is lent instead, in a statement,
  # an argument, a method's receiver, and every header.

  obj Res
    n: Int
    v: List[Int]

  enum E
    a(r: Res)
    b

  obj W
    e: E
    o: Res?
    v: List[Int]

    fun gvw(!@) -> ![]Int
      !@v[..]

  fun first(v: ?List[Int]) -> []Int
    ?v[..1]

  sub stmt_read(a: !List[Int], b: !List[Int], c: Bool)
    t = ?(a if c else b)
    print(t)

  sub stmt_write(a: !List[Int], b: !List[Int], c: Bool)
    t = !(a if c else b)
    print(t)

  sub argument(a: !List[Int], b: !List[Int], c: Bool)
    print(first(?(a if c else b)))

  sub path_write(a: !List[W], b: !List[W], c: Bool)
    w = !(a if c else b)[0].o
    print(w)

  sub path_read(a: !List[W], b: !List[W], c: Bool)
    r = ?(a if c else b)[0].v
    print(r)

  sub match_read(a: !E, b: !E, c: Bool)
    match ?(a if c else b)
      .a(r) => print(r.n)
      .b => pass

  sub match_write(a: !E, b: !E, c: Bool)
    match !(a if c else b)
      .a(r) => r.n = 1
      .b => pass

  sub match_part(a: !W, b: !W, c: Bool)
    match ?(a if c else b).e
      .a(r) => print(r.n)
      .b => pass

  sub as_part(a: !W, b: !W, c: Bool)
    if ?(a if c else b).o as x
      print(x.n)

  sub while_as_part(a: !W, b: !W, c: Bool)
    while !(a if c else b).o as x
      x.n = 1
      break

  sub receiver(a: !W, b: !W, c: Bool)
    for x in (!(a if c else b)).gvw()
      print(x)

  sub coalesce(v: !List[Int], d: !List[Int])
    o: (!List[Int])? = !v
    r = ?(o ?? !d)
    print(r)

  sub plain(a: Int, b: Int, c: Bool)
    r = ?(a if c else b)
    print(r)

  pass

