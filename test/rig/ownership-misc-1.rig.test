test "discard take plain optional", release: true, '''
  true true true
  true true true
  true false true
  true true
  in false
  after true
  true
'''
  # A discarded take of an optional field or element, a statement `<e` or
  # `_ = <e`, leaves `none` whatever the optional holds: plain data, a
  # plain struct, or a view, through the owner, a write view, a `!@`
  # receiver, or a `defer`, as a take whose value is bound does.

  obj P
    x: Int

  obj S
    n: Int?
    p: P?
    s: (?String)?

    sub clear(!@)
      <@n
      _ = <@p

  sub take_through(w: !S)
    <w.n
    <w.s

  t = "abc"
  a = S(n: 1, p: P(x: 2), s: ?t)
  <a.n
  <a.p
  <a.s
  print(a.n == none, a.p == none, a.s == none)
  b = S(n: 1, p: P(x: 2), s: ?t)
  _ = <b.n
  _ = <b.p
  _ = <b.s
  print(b.n == none, b.p == none, b.s == none)
  c = S(n: 1, p: P(x: 2), s: ?t)
  take_through(!c)
  print(c.n == none, c.p == none, c.s == none)
  d = S(n: 1, p: P(x: 2), s: none)
  !d.clear()
  print(d.n == none, d.p == none)
  e = S(n: 1, p: none, s: none)
  if true
    defer <e.n
    print("in", e.n == none)
  print("after", e.n == none)
  v: List[Int?] = List()
  !v.push(3)
  <v[0]
  print(v[0] == none)

fail "element place rules", "9:5: `v[0]` owns a `String`, which can't be copied by `=`: write `+v[0]` to clone it or `?v[0]` to view it", "10:6: `take` takes ownership of a `String`, and `v[0]` can't be copied: write `+v[0]` to pass a clone; if `take` only reads it, make its parameter a `?String`", "12:1: cannot lend `v` to write while a read loan is live", "14:6: cannot move out of `v[0]`: elements cannot be moved out of their container", "16:1: cannot assign to `v[0]` while `v` is lent"
  # An element that owns a resource is read where it is, and stays there:
  # it is not copied out, moved out, or changed while it is lent.

  sub take(t: String)
    print(t)

  v: List[String] = List()
  !v.push(String("a"))
  x = v[0]
  take(v[0])
  r = ?v[0]
  !v.push(String("b"))
  print(r)
  t = <v[0]
  s = ?v[0]
  v[0] = String("c")
  print(s)

