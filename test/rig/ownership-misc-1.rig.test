test "string copies free", '''
  lit other
  abcdefghijklmnop free abcdefghijklmnop abc
  Ann [1]
  x ["x", "y"]
  a a
'''
  # A String copied out of a view, a struct, or a List views what the
  # String views, not the place it was read from: the place is free again,
  # and a String a function copies out of its parameter can be returned.
  # A value views a Text only where it can reach one.

  obj Person
    name: ?String
    tags: List[Int]

    fun label(?@) -> ?String
      @name

  obj Reg
    names: List[?String]

    sub add(!@, n: ?String) keeps n
      !@names.push(n)

    fun first(?@) -> ?String
      @names[0]

  enum E
    a(c: ?String)
    b

  fun copy(s: ?String) -> ?String
    r = ?s
    x: ?String = r
    x

  fun pick(e: E) -> ?String
    match e
      .a(c)
        r = ?c
        x: ?String = r
        return x
      .b
        return "b"

  s = "lit"
  r = ?s
  o = r
  s = "other"
  print(o, s)
  t = String("abcdefghijklmnop")
  v = ?t[..]
  x: ?String = v
  v = "free"
  print(x, v, copy(?t), pick(E.a(?t[..3])))
  p = Person(name: "Ann", tags: List())
  l = ?p.label()
  !p.tags.push(1)
  print(l, p.tags)
  reg = Reg(names: List())
  !reg.add("x")
  f = ?reg.first()
  !reg.add("y")
  print(f, reg.names)
  lits: List[?String] = List()
  !lits.push("a")
  last: ?String = "z"
  for n in ?lits
    last = n
  c: *Cell[?String] = *Cell("b")
  for n in ?lits
    !c.set(n)
  <lits
  print(last, c.get())

