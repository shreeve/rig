# concurrency: tests whose names start `actor`.

test "actor ledger across tasks", seeds: 20, "805 805"
  # An actor holds state of any size, here a List, and runs its methods
  # one at a time: tasks call it through handles of their own (`+l`), and
  # no change is lost.
  obj Ledger
    entries: List[Int]
    total: Int

    sub post(!@, n: Int)
      !@entries.push(n)
      @total += n

    fun count(?@) -> Int
      @entries.len

    fun sum(?@) -> Int
      @total

  sub work(l: *Actor[Ledger])
    for 0..100
      !l.post(1)

  l = *Actor(Ledger(entries: List[Int](), total: 0))
  !l.post(5)
  ts = Tasks[Void]()
  for 0..8
    !ts.add(work(+l)&)
  >ts
  print(l.count() + 4, l.sum())

test "actor ledger across tasks released", seeds: 20, release: true, "8000"
  obj Counter
    hits: Int

    sub bump(!@)
      @hits += 1

    fun get(?@) -> Int
      @hits

  sub work(c: *Actor[Counter])
    for 0..1000
      !c.bump()

  c = *Actor(Counter(hits: 0))
  ts = Tasks[Void]()
  for 0..8
    !ts.add(work(+c)&)
  >ts
  print(c.get())

test "actor task calls", seeds: 20, '''
  5 true
  true
  6
'''
  # A call made with `&` is a task: the actor runs it in its turn, and
  # the task gives its answer. Its `!` marks the call, not a lend, so the
  # handle may be used again while it runs.
  obj Counter
    hits: Int

    fun add(!@, n: Int) -> Int
      @hits += n
      @hits

    fun get(?@) -> Int
      @hits

  c = *Actor(Counter(hits: 0))
  t = (!c).add(5)&
  u = c.get()&
  print(>t, >u >= 0)
  ts = Tasks[Int]()
  for 0..10
    !ts.add(c.get()&)
  print((>ts).len == 10)
  print((!c).add(1))

test "actor mailbox", seeds: 20, "20 20"
  # `mailbox: n` sets how many calls made with `&` the actor holds at
  # once; a caller waits for a slot when they are all taken.
  obj Counter
    hits: Int

    fun add(!@, n: Int) -> Int
      @hits += n
      @hits

    fun get(?@) -> Int
      @hits

  c = *Actor(Counter(hits: 0), mailbox: 2)
  ts = Tasks[Int]()
  for 0..20
    !ts.add((!c).add(1)&)
  xs = >ts
  print(xs.len, c.get())

test "actor handles", seeds: 20, '''
  2
  2
  2
  drop log 2
'''
  # Each holder has a handle of its own (`+a`); a read view `?a` calls the
  # methods that only read; a weak handle `~a` reaches the actor while a
  # handle lives. The value drops once, when the last handle goes.
  obj Log
    lines: List[String]

    sub add(!@, s: String)
      !@lines.push(<s)

    fun count(?@) -> Int
      @lines.len

    drop(!@)
      print("drop log", @lines.len)

  fun reader(h: ?*Actor[Log]) -> Int
    h.count()

  a = *Actor(Log(lines: List[String]()))
  b = +a
  !b.add(String("one"))
  (!a).add(String("two"))
  print(reader(?a))
  w = ~a
  if *w as s
    print(s.count())
  print(b.count())

test "actor arguments", seeds: 20, "3 4 [4]"
  # Arguments go to the actor: a value moves, and a read view lends what
  # it views for the call.
  obj Store
    n: Int
    items: List[Int]

    sub keep(!@, xs: List[Int])
      @items = <xs

    fun sum(?@, xs: ?List[Int]) -> Int
      t = 0
      for x in xs
        t += x
      t + @n

    fun size(?@, s: ?String) -> Int
      s.len + @n

    fun all(?@) -> List[Int]
      +@items

  c = *Actor(Store(n: 1, items: List[Int]()))
  xs = List[Int]()
  !xs.push(4)
  !c.keep(<xs)
  ys = List[Int]()
  !ys.push(2)
  print(c.sum(?ys), c.size("abc"), c.all())

test "actor call handle first", seeds: 20, '''
  pick 1
  consume 1
  a
  21
  pick 1
  b
  a
  42
  pick 1
  b
  a
  63
'''
  # The handle of an actor's method runs before the arguments, as
  # written, also when they are evaluated into temporaries first
  # (keyword arguments out of order): an argument that takes what the
  # handle's expression reads runs after it.
  obj Acc
    total: Int

    sub add(!@, a: Int, b: Int)
      @total += a * 10 + b

    fun get(?@) -> Int
      @total

  fun side(s: ?String, n: Int) -> Int
    print(s)
    n

  fun consume(hs: List[*Actor[Acc]]) -> Int
    print("consume", hs.len)
    hs.len

  fun pick(hs: ?List[*Actor[Acc]], i: Int) -> *Actor[Acc]
    print("pick", hs.len)
    +hs[i]

  hs = List[*Actor[Acc]]()
  !hs.push(*Actor(Acc(total: 0)))
  keep = +hs[0]
  !pick(?hs, 0).add(b: consume(<hs), a: side("a", 2))
  print(keep.get())
  gs = List[*Actor[Acc]]()
  !gs.push(+keep)
  !pick(?gs, 0).add(b: side("b", 1), a: side("a", 2))
  print(keep.get())
  t = (!pick(?gs, 0)).add(b: side("b", 1), a: side("a", 2))&
  >t
  print(keep.get())

test "actor made handle dropped", seeds: 20, '''
  3
  1
  5
  621
  8
  421
  -1
  1065
'''
  # A handle made by a call and used for a method that only reads the
  # actor is a temporary its statement drops, as a method's self is:
  # called, started as a task, through a branch, and evaluated before
  # arguments that run first.
  error Bad
    no

  obj Acc
    total: Int

    fun get(?@) -> Int
      @total

    fun mix(?@, a: Int, b: Int) -> Int
      @total * 100 + a * 10 + b

  fun mka(n: Int) -> *Actor[Acc]
    *Actor(Acc(total: n))

  fun fails(k: Int) -> Int!
    return Bad.no if k > 8
    k

  fun go(k: Int) -> Int!
    mka(4).mix(String("ab").len, fails(k)!)

  print(mka(3).get())
  print((*Actor(Acc(total: 1))).get())
  t = mka(5).get()&
  print(>t)
  print(mka(6).mix(b: 1, a: 2))
  c = true
  print((mka(8) if c else mka(9)).get())
  print(go(1) catch -1)
  print(go(9) catch -1)
  u = mka(10).mix(b: fails(5) catch 0, a: fails(6) catch 0)&
  print(>u)

test "actor deadline and cancel", seeds: 20, '''
  -1
  -2
  1
  1
'''
  # A call that can fail and has not started is withdrawn when its caller
  # is canceled or its deadline passes. A method that started runs to its
  # end, and its caller waits for it through a cancel.
  use std.time
  use std.task

  obj Slow
    n: Int

    fun nap(!@, started: *Cell[Bool]) -> Int!
      !started.set(true)
      time.sleep(ms: 20)!
      @n += 1
      @n

    fun later(!@) -> Int!
      task.check()!
      @n += 10
      @n

    fun get(?@) -> Int
      @n

  a = *Actor(Slow(n: 0))
  started = *Cell(false)
  t = (!a).nap(+started)&
  while not started.get()
    time.sleep(ms: 1) catch print("woke")
  n = time.within(ms: 5, |+a| (!a).later()!) catch -1
  print(n)
  u = (!a).later()&
  print(<u.cancel() catch -2)
  print(<t.cancel() catch -3)
  print(a.get())

test "actor idle call runs as the actor", seeds: 20, '''
  -2
  2
'''
  # A call that finds the actor idle runs inline, as the actor: the
  # caller's cancel and deadline do not stop it, and the caller meets its
  # cancel at its own next waiting point.
  use std.time
  use std.task

  obj Slow
    n: Int

    fun nap(!@) -> Int!
      time.sleep(ms: 20)!
      @n += 1
      @n

  fun work(a: *Actor[Slow]) -> Int!
    n = (!a).nap()!
    task.check()!
    n + 100

  a = *Actor(Slow(n: 0))
  t = work(+a)&
  time.sleep(ms: 5) catch print("woke")
  print(<t.cancel() catch -2)
  n = time.within(ms: 5, |+a| (!a).nap()!) catch -1
  print(n)

test "actor idle and busy", seeds: 20, "80 80"
  # Callers whose methods wait meet a busy actor, and send messages that
  # the caller running inline hands to the actor's own task when it is
  # done; none is lost, and each runs alone.
  use std.time

  obj Room
    inside: Int
    seen: Int
    most: Int

    sub visit(!@)!
      @inside += 1
      if @inside > @most
        @most = @inside
      time.sleep(us: 1)!
      @seen += 1
      @inside -= 1

    fun count(?@) -> Int
      @seen + @most - 1

  sub work(r: *Actor[Room])!
    for 0..10
      !r.visit()!

  r = *Actor(Room(inside: 0, seen: 0, most: 0))
  ts = Tasks[Void!]()
  for 0..8
    !ts.add(work(+r)&)
  >ts!
  print(r.count(), r.count())

