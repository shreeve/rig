fail "actor closure literal in a task call", "13:16: an actor runs its methods on a task of its own", errors: 1
  # A closure literal written in an actor call lends its captures to the
  # actor's task, as one in a task call does; they would end with the
  # statement while the actor runs.
  obj Counter
    hits: Int

    fun apply(!@, f: ?fun(Int) -> Int) -> Int
      @hits = f(@hits)
      @hits

  c = *Actor(Counter(hits: 1))
  total = 0
  t = (!c).apply(|!total, x|
    total += x
    total
  )&
  total += 100
  print(>t, total)

