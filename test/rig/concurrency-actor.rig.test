# concurrency: tests whose names start `actor`.

test "actor ledger across tasks", seeds: 20, "805 805"
  # An actor holds state of any size, here a List, and runs its methods
  # one at a time: tasks call it through handles of their own (`+l`), and
  # no change is lost.
  obj Ledger
    entries: List[Int]
    total: Int

    sub post(!@, n: Int)
      !@entries.push(n)
      @total += n

    fun count(?@) -> Int
      @entries.len

    fun sum(?@) -> Int
      @total

  sub work(l: *Actor[Ledger])
    for 0..100
      !l.post(1)

  l = *Actor(Ledger(entries: List[Int](), total: 0))
  !l.post(5)
  ts = Tasks[Void]()
  for 0..8
    !ts.add(work(+l)&)
  >ts
  print(l.count() + 4, l.sum())

test "actor ledger across tasks released", seeds: 20, release: true, "8000"
  obj Counter
    hits: Int

    sub bump(!@)
      @hits += 1

    fun get(?@) -> Int
      @hits

  sub work(c: *Actor[Counter])
    for 0..1000
      !c.bump()

  c = *Actor(Counter(hits: 0))
  ts = Tasks[Void]()
  for 0..8
    !ts.add(work(+c)&)
  >ts
  print(c.get())

test "actor task calls", seeds: 20, '''
  5 true
  true
  6
'''
  # A call made with `&` is a task: the actor runs it in its turn, and
  # the task gives its answer. Its `!` marks the call, not a lend, so the
  # handle may be used again while it runs.
  obj Counter
    hits: Int

    fun add(!@, n: Int) -> Int
      @hits += n
      @hits

    fun get(?@) -> Int
      @hits

  c = *Actor(Counter(hits: 0))
  t = (!c).add(5)&
  u = c.get()&
  print(>t, >u >= 0)
  ts = Tasks[Int]()
  for 0..10
    !ts.add(c.get()&)
  print((>ts).len == 10)
  print((!c).add(1))

test "actor mailbox", seeds: 20, "20 20"
  # `mailbox: n` sets how many calls made with `&` the actor holds at
  # once; a caller waits for a slot when they are all taken.
  obj Counter
    hits: Int

    fun add(!@, n: Int) -> Int
      @hits += n
      @hits

    fun get(?@) -> Int
      @hits

  c = *Actor(Counter(hits: 0), mailbox: 2)
  ts = Tasks[Int]()
  for 0..20
    !ts.add((!c).add(1)&)
  xs = >ts
  print(xs.len, c.get())

test "actor handles", seeds: 20, '''
  2
  2
  2
  drop log 2
'''
  # Each holder has a handle of its own (`+a`); a read view `?a` calls the
  # methods that only read; a weak handle `~a` reaches the actor while a
  # handle lives. The value drops once, when the last handle goes.
  obj Log
    lines: List[String]

    sub add(!@, s: String)
      !@lines.push(<s)

    fun count(?@) -> Int
      @lines.len

    drop(!@)
      print("drop log", @lines.len)

  fun reader(h: ?*Actor[Log]) -> Int
    h.count()

  a = *Actor(Log(lines: List[String]()))
  b = +a
  !b.add(String("one"))
  (!a).add(String("two"))
  print(reader(?a))
  w = ~a
  if *w as s
    print(s.count())
  print(b.count())

test "actor arguments", seeds: 20, "3 4 [4]"
  # Arguments go to the actor: a value moves, and a read view lends what
  # it views for the call.
  obj Store
    n: Int
    items: List[Int]

    sub keep(!@, xs: List[Int])
      @items = <xs

    fun sum(?@, xs: ?List[Int]) -> Int
      t = 0
      for x in xs
        t += x
      t + @n

    fun size(?@, s: ?String) -> Int
      s.len + @n

    fun all(?@) -> List[Int]
      +@items

  c = *Actor(Store(n: 1, items: List[Int]()))
  xs = List[Int]()
  !xs.push(4)
  !c.keep(<xs)
  ys = List[Int]()
  !ys.push(2)
  print(c.sum(?ys), c.size("abc"), c.all())

test "actor deadline and cancel", seeds: 20, '''
  -1
  -2
  1
  1
'''
  # A call that can fail and has not started is withdrawn when its caller
  # is canceled or its deadline passes. A method that started runs to its
  # end, and its caller waits for it through a cancel.
  use std.time
  use std.task

  obj Slow
    n: Int

    fun nap(!@, started: *Cell[Bool]) -> Int!
      !started.set(true)
      time.sleep(20 * time.MS)!
      @n += 1
      @n

    fun later(!@) -> Int!
      task.check()!
      @n += 10
      @n

    fun get(?@) -> Int
      @n

  a = *Actor(Slow(n: 0))
  started = *Cell(false)
  t = (!a).nap(+started)&
  while not started.get()
    time.sleep(time.MS) catch print("woke")
  n = time.within(5 * time.MS, |+a| (!a).later()!) catch -1
  print(n)
  u = (!a).later()&
  print(<u.cancel() catch -2)
  print(<t.cancel() catch -3)
  print(a.get())

test "actor idle call runs as the actor", seeds: 20, '''
  -2
  2
'''
  # A call that finds the actor idle runs inline, as the actor: the
  # caller's cancel and deadline do not stop it, and the caller meets its
  # cancel at its own next waiting point.
  use std.time
  use std.task

  obj Slow
    n: Int

    fun nap(!@) -> Int!
      time.sleep(20 * time.MS)!
      @n += 1
      @n

  fun work(a: *Actor[Slow]) -> Int!
    n = (!a).nap()!
    task.check()!
    n + 100

  a = *Actor(Slow(n: 0))
  t = work(+a)&
  time.sleep(5 * time.MS) catch print("woke")
  print(<t.cancel() catch -2)
  n = time.within(5 * time.MS, |+a| (!a).nap()!) catch -1
  print(n)

test "actor idle and busy", seeds: 20, "80 80"
  # Callers whose methods wait meet a busy actor, and send messages that
  # the caller running inline hands to the actor's own task when it is
  # done; none is lost, and each runs alone.
  use std.time

  obj Room
    inside: Int
    seen: Int
    most: Int

    sub visit(!@)!
      @inside += 1
      if @inside > @most
        @most = @inside
      time.sleep(time.US)!
      @seen += 1
      @inside -= 1

    fun count(?@) -> Int
      @seen + @most - 1

  sub work(r: *Actor[Room])!
    for 0..10
      !r.visit()!

  r = *Actor(Room(inside: 0, seen: 0, most: 0))
  ts = Tasks[Void!]()
  for 0..8
    !ts.add(work(+r)&)
  >ts!
  print(r.count(), r.count())

