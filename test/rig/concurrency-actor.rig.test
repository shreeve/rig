fail "actor call marks", "`get` only reads the actor: call it bare, `c.get(...)`", "`bump` changes the actor: mark the call, `!c.bump(...)`", "`take` takes its value, which the actor keeps: a handle calls a `?@` or `!@` method"
  obj C
    n: Int

    fun get(?@) -> Int
      @n

    sub bump(!@)
      @n += 1

    fun take(<@) -> Int
      @n

  c = *Actor(C(n: 0))
  print((!c).get())
  c.bump()
  print(c.take())

