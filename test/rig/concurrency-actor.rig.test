test "actor supervised restarts", seeds: 20, '''
  2
  -1 0
  1
  -2 7
'''
  # A supervised actor starts again from its function when a panic ends
  # it, up to `restarts:` times: the call that panicked panics in its
  # caller, and the next runs against a new value. Past the limit, the
  # actor dies for good.
  use std.task

  obj Rooms
    names: List[String]

    fun pick(?@, i: Int) -> Int
      @names[i].len

    sub add(!@, s: String)
      !@names.push(<s)

    fun count(?@) -> Int
      @names.len

  base = 7
  r = *Actor.supervised(*|+base| Rooms(names: List[String]()), restarts: 2)
  !r.add(String("hall"))
  !r.add(String("den"))
  print(r.count())
  n = task.isolate(|+r| r.pick(9)) catch -1
  print(n, r.count())
  !r.add(String("attic"))
  print(r.count())
  _ = task.isolate(|+r| r.pick(9)) catch -1
  _ = task.isolate(|+r| r.pick(9)) catch -1
  m = task.isolate(|+r| r.count()) catch -2
  print(m, base)

test "actor supervised restart panics", seeds: 20, '''
  8
  -2
'''
  # A panic in the function that makes the value ends the actor for good.
  use std.task

  obj Rooms
    n: Int

    fun pick(?@, i: Int) -> Int
      [1, 2][i] + @n

  fun make(made: *Cell[Int]) -> Rooms
    k = (!made).add(1)
    Rooms(n: [7][k - 1])

  made = *Cell(0)
  r = *Actor.supervised(*|+made| make(+made))
  print(r.pick(0))
  _ = task.isolate(|+r| r.pick(5)) catch -1
  _ = task.isolate(|+r| r.pick(0)) catch -1
  print(task.isolate(|+r| r.pick(0)) catch -2)

