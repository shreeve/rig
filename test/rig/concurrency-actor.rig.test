fail "actor write view argument", "a method an actor runs takes no write view: `!zs` lends `zs` to write"
  obj C
    n: Int

    sub fill(?@, xs: !List[Int])
      !xs.push(@n)

  c = *Actor(C(n: 0))
  zs = List[Int]()
  c.fill(!zs)

fail "actor task keeps argument loans", "cannot lend `ys` to write while a read loan is live"
  obj C
    n: Int

    fun sum(?@, xs: ?List[Int]) -> Int
      t = 0
      for x in xs
        t += x
      t + @n

  c = *Actor(C(n: 1))
  ys = List[Int]()
  t = c.sum(?ys)&
  !ys.push(1)
  print(>t)

test "actor dies in a method run inline", seeds: 20, '''
  1
  caught Stop.panicked
  -1
  caught again Stop.panicked
  -2
  caught a task Stop.panicked
'''
  # A panic in an actor's method ends the actor: a call run inline
  # panics in its caller, which an isolate stops, and every later call,
  # waiting or with `&`, panics too.
  use std.task

  obj Rooms
    names: List[String]

    fun pick(?@, i: Int) -> Int
      @names[i].len

    sub add(!@, s: String)
      !@names.push(<s)

    fun count(?@) -> Int
      @names.len

  fun later(r: *Actor[Rooms]) -> Int
    t = r.count()&
    >t

  r = *Actor(Rooms(names: List[String]()))
  !r.add(String("hall"))
  print(r.count())
  n = task.isolate(|+r| r.pick(5)) catch |e|
    print("caught", e)
    -1
  print(n)
  m = task.isolate(|+r| r.count()) catch |e|
    print("caught again", e)
    -2
  print(m)
  _ = task.isolate(|+r| later(+r)) catch |e|
    print("caught a task", e)
    -3

test "actor dies on its own task", seeds: 20, '''
  caught Stop.panicked
  -1 1
  -2
'''
  # A call queued behind another runs on the actor's own task: a panic
  # there stops at the actor, which dies, and passes to the caller; a
  # call queued behind it learns the actor died.
  use std.task
  use std.time

  obj Slow
    n: Int

    fun hold(!@) -> Int!
      time.sleep(20 * time.MS)!
      @n

    fun boom(?@, i: Int) -> Int
      [1, 2, 3][i]

    fun get(?@) -> Int
      @n

  fun holder(a: *Actor[Slow]) -> Int!
    (!a).hold()!

  fun behind(a: *Actor[Slow]) -> Int!
    time.sleep(2 * time.MS)!
    task.isolate(|+a| a.get()) catch -2

  a = *Actor(Slow(n: 1))
  t = holder(+a)&
  time.sleep(5 * time.MS)!
  u = behind(+a)&
  n = task.isolate(|+a| a.boom(9)) catch |e|
    print("caught", e)
    -1
  print(n, >t!)
  print(>u!)

bomb "actor dies and its caller panics", seeds: 20, "index out of bounds", prints: "before"
  # With no isolate, the caller's panic ends the program.
  obj Rooms
    n: Int

    fun pick(?@, i: Int) -> Int
      [1, 2, 3][i] + @n

  r = *Actor(Rooms(n: 0))
  print("before")
  print(r.pick(7))

test "actor supervised restarts", seeds: 20, '''
  2
  -1 0
  1
  -2 7
'''
  # A supervised actor starts again from its function when a panic ends
  # it, up to `restarts:` times: the call that panicked panics in its
  # caller, and the next runs against a new value. Past the limit, the
  # actor dies for good.
  use std.task

  obj Rooms
    names: List[String]

    fun pick(?@, i: Int) -> Int
      @names[i].len

    sub add(!@, s: String)
      !@names.push(<s)

    fun count(?@) -> Int
      @names.len

  base = 7
  r = *Actor.supervised(*|+base| Rooms(names: List[String]()), restarts: 2)
  !r.add(String("hall"))
  !r.add(String("den"))
  print(r.count())
  n = task.isolate(|+r| r.pick(9)) catch -1
  print(n, r.count())
  !r.add(String("attic"))
  print(r.count())
  _ = task.isolate(|+r| r.pick(9)) catch -1
  _ = task.isolate(|+r| r.pick(9)) catch -1
  m = task.isolate(|+r| r.count()) catch -2
  print(m, base)

test "actor supervised on its own task", seeds: 20, '''
  -1 105 200
  300 3
  -2
'''
  # A call queued while the actor dies waits for the new value. Restarts
  # count within `per:` nanoseconds: one after the window is allowed
  # again, a second within it is not.
  use std.task
  use std.time

  obj Slow
    n: Int

    fun hold(!@) -> Int!
      @n += 5
      time.sleep(20 * time.MS)!
      @n

    fun boom(?@, i: Int) -> Int
      [1, 2, 3][i]

    fun get(?@) -> Int
      @n

  fun holder(a: *Actor[Slow]) -> Int!
    (!a).hold()!

  fun behind(a: *Actor[Slow]) -> Int!
    time.sleep(2 * time.MS)!
    a.get()

  made = *Cell(0)
  a = *Actor.supervised(*|+made| Slow(n: 100 * (!made).add(1)), restarts: 1, per: 10 * time.MS)
  t = holder(+a)&
  time.sleep(5 * time.MS)!
  u = behind(+a)&
  n = task.isolate(|+a| a.boom(9)) catch -1
  print(n, >t!, >u!)
  time.sleep(20 * time.MS)!
  _ = task.isolate(|+a| a.boom(9)) catch -1
  print(a.get(), made.get())
  _ = task.isolate(|+a| a.boom(9)) catch -1
  print(task.isolate(|+a| a.get()) catch -2)

test "actor supervised restart panics", seeds: 20, '''
  8
  -2
'''
  # A panic in the function that makes the value ends the actor for good.
  use std.task

  obj Rooms
    n: Int

    fun pick(?@, i: Int) -> Int
      [1, 2][i] + @n

  fun make(made: *Cell[Int]) -> Rooms
    k = (!made).add(1)
    Rooms(n: [7][k - 1])

  made = *Cell(0)
  r = *Actor.supervised(*|+made| make(+made))
  print(r.pick(0))
  _ = task.isolate(|+r| r.pick(5)) catch -1
  _ = task.isolate(|+r| r.pick(0)) catch -1
  print(task.isolate(|+r| r.pick(0)) catch -2)

