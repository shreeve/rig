test "actor made where its type is expected", seeds: 20, "1 2 3 4"
  # `*Actor(x)` takes its type from `x`, wherever an `*Actor[T]` is
  # expected: a typed binding, an argument, a field, a variant payload.
  obj Counter
    n: Int

    fun get(?@) -> Int
      @n

  obj Box
    a: *Actor[Counter]

  enum Link
    act(a: *Actor[Counter])
    null

  fun take(a: *Actor[Counter]) -> Int
    a.get()

  x: *Actor[Counter] = *Actor(Counter(n: 1))
  b = Box(a: *Actor(Counter(n: 3)))
  l = Link.act(a: *Actor(Counter(n: 4)))
  m = match l
    .act(:a) => a.get()
    .null => 0
  print(x.get(), take(*Actor(Counter(n: 2))), b.a.get(), m)

test "actor dies holding a String it grew", seeds: 20, '''
  caught Stop.panicked
  -2
  after
'''
  # A panic in a function lent the actor's String to write, after the
  # String grew past several buffers, ends the actor: its state, the
  # String with it, is abandoned, never read or dropped again, and the
  # next call learns the actor died.
  use std.task

  sub fill(out: !String, xs: ?List[Int], n: Int)
    for i in 0..n
      !out.push[U64, .big](U64(xs[i % 3]))
    !out.push(U8(xs[n]))

  obj Log
    text: String
    xs: List[Int]

    sub add(!@, n: Int)
      fill(!@text, ?@xs, n)

    fun size(?@) -> Int
      @text.len

  xs: List[Int] = List()
  !xs.push(1)
  !xs.push(2)
  !xs.push(3)
  a = *Actor(Log(text: String(), xs: <xs))
  task.isolate(|+a| (!a).add(5000)) catch |e|
    print("caught", e)
  print(task.isolate(|+a| a.size()) catch -2)
  print("after")

test "actor supervised restarts after a String it grew", seeds: 20, '''
  -1
  10
'''
  # A supervised actor whose method panics in a function lent its String
  # to write starts again from a new value; the old one, String and all,
  # is abandoned, so nothing reads or frees its buffer again.
  use std.task

  sub fill(out: !String, n: Int)
    for i in 0..n
      !out.push[U64, .big](U64(i))
    !out.push(U8([1, 2, 3][n]))

  obj Log
    text: String

    sub add(!@, n: Int)
      fill(!@text, n)

    fun size(?@) -> Int
      @text.len

  a = *Actor.supervised(*|| Log(text: String()), restarts: 2)
  task.isolate(|+a| (!a).add(5000)) catch print(-1)
  !a.add(0)
  !a.add(1)
  print(a.size())

bomb "actor dies from a panic call in a method run inline", seeds: 20, timeout: 10, "Box.add: the actor died from a panic in Box.add", prints: "-9"
  # `panic(...)` ends an actor as a runtime panic does: the call run
  # inline panics in its caller, and a later call learns the actor died.
  use std.task

  obj Box
    hits: Int

    fun add(!@, n: Int) -> Int
      if n < 0
        panic("bad")
      @hits += n
      @hits

  c = *Actor(Box(hits: 0))
  print(task.isolate(|+c| (!c).add(-1)) catch -9)
  print((!c).add(1))

test "actor panics in a call made with & from a task under an isolate", seeds: 20, timeout: 10, "-9"
  # The task running the call inline panics: it ends, its isolate stops
  # it, and the isolate's own wait passes the panic on.
  use std.task

  obj Box
    hits: Int

    fun add(!@, n: Int) -> Int
      if n < 0
        panic("bad")
      @hits += n
      @hits

  fun bump(c: *Actor[Box], n: Int) -> Int
    t = (!c).add(n)&
    >t

  c = *Actor(Box(hits: 0))
  print(task.isolate(|+c| bump(+c, -1)) catch -9)

test "actor supervised gives back the mailbox slot of a call that panicked", seeds: 20, timeout: 10, '''
  -9 0
  -9 0
  -2
'''
  # A call made with `&` that panics on the actor's own task, by
  # `panic(...)` or the runtime's, gives back its slot of the mailbox, so
  # a supervised actor with one slot takes the next.
  use std.task
  use std.time

  obj Box
    hits: Int

    fun add(!@, n: Int) -> Int
      if n == -1
        panic("bad")
      xs = [1, 2]
      @hits += xs[n + 5]
      @hits += n
      @hits

    fun slow(!@) -> Int!
      time.sleep(ms: 50)!
      @hits

  fun hold(c: *Actor[Box]) -> Int!
    (!c).slow()!

  fun bump(c: *Actor[Box], n: Int) -> Int
    t = (!c).add(n)&
    >t

  c = *Actor.supervised(*|| Box(hits: 0), mailbox: 1)
  for n in [-1, -9]
    x = hold(+c)&
    time.sleep(ms: 10)!
    r = task.isolate(|+c, +n| bump(+c, n)) catch -9
    print(r, >x!)
  t = (!c).add(-4)&
  print(>t)

test "actor & calls wait for a mailbox slot asleep", seeds: 20, timeout: 10, "4"
  # A call made with `&` that finds every slot taken sleeps until one is
  # given back, so a deterministic run's clock reaches the timers that
  # end the calls holding them.
  use std.time

  obj Slow
    hits: Int

    fun add(!@, n: Int) -> Int!
      time.sleep(ms: 10)!
      @hits += n
      @hits

  c = *Actor(Slow(hits: 0), mailbox: 1)
  ts = Tasks[Int!]()
  for 0..4
    !ts.add((!c).add(1)&)
  xs = >ts!
  print(xs.len)

fail "actor mailbox given twice", "parameter `mailbox` of `Actor` is given twice", errors: 1
  obj Counter
    hits: Int

    fun get(?@) -> Int
      @hits

  c = *Actor(Counter(hits: 0), mailbox: 4, mailbox: 8)
  print(c.get())

fail "actor supervised option given twice", "parameter `restarts` of `Actor.supervised` is given twice", errors: 1
  obj Box
    hits: Int

    fun get(?@) -> Int
      @hits

  c = *Actor.supervised(*|| Box(hits: 0), restarts: 2, restarts: 3)
  print(c.get())

test "actor argument lent bare to a view parameter", seeds: 20, "5"
  # A bare place where a `?T` goes is lent, as `?p` would lend it (Core
  # sentence 1): the actor's method keeps nothing of it.
  obj Plain
    n: Int

  obj Counter
    hits: Int

    fun peek(?@, h: ?Plain) -> Int
      h.n + @hits

  d = *Actor(Counter(hits: 1))
  p = Plain(n: 4)
  print(d.peek(p))

fail "actor argument lent bare crosses as a view", "an actor runs its methods on a task of its own, and `Holder(j: ^Sum(xs: List([1, 2])))` is lent to it to read: `?Holder` holds `{Job + Sends}`"
  # A value lent bare where a `?T` goes is shared with the actor's task,
  # so `T` syncs (SPEC §18), as when `?` is written.
  api Job
    fun run(?@) -> Int

  obj Sum: Job
    xs: List[Int]

    fun run(?@) -> Int
      @xs.len

  obj Holder
    j: ^{Job + Sends}

  obj Counter
    hits: Int

    fun peek(?@, h: ?Holder) -> Int
      h.j.run() + @hits

  c = *Actor(Counter(hits: 0))
  print(c.peek(Holder(j: ^Sum(xs: List([1, 2])))))

fail "actor slice argument shares its elements", "an actor runs its methods on a task of its own, and `xs` is lent to it to read"
  # A slice lent to an actor, bare or with `?`, is read on its task, so
  # its elements sync (SPEC §18).
  api Job
    fun run(?@) -> Int

  obj Sum: Job
    xs: List[Int]

    fun run(?@) -> Int
      @xs.len

  obj Holder
    j: ^{Job + Sends}

  obj Counter
    hits: Int

    fun sl(?@, xs: []Holder) -> Int
      xs.len + @hits

  c = *Actor(Counter(hits: 0))
  xs = List[Holder]()
  !xs.push(Holder(j: ^Sum(xs: List([1]))))
  print(c.sl(xs))

test "a panic on an actor's task stops what its method started", seeds: 20, '''
  42 42
  caught Stop.panicked
  -1
'''
  # The method's stack goes when the panic ends the runner, so the task
  # lent a local on it must have ended first: it reads the local after
  # its sleep is canceled, and before the caller learns of the panic.
  use std.task
  use std.time

  sub nap(ms: Int)
    time.sleep(ms: ms) catch |_|
      return

  sub reader(s: ?[8]Int)
    nap(20)
    print(s[0], s[7])

  obj S
    n: Int

    sub slow(!@)
      nap(20)

    fun work(!@) -> Int
      local = [8 of @n + 41]
      t = reader(?local)&
      panic("mid") if @n > 0
      >t
      1

  sub first(a: *Actor[S])
    !a.slow()

  fun second(a: *Actor[S]) -> Int
    !a.work()

  a = *Actor(S(n: 1))
  t = first(+a)&
  time.sleep(ms: 5)!
  u = task.isolate(|+a| second(+a)) catch |e|
    print("caught", e)
    -1
  >t
  print(u)

test "a panic on an actor's task answers its caller after what it started", seeds: 20, '''
  7 7
  caught Stop.panicked
  -1
'''
  # A task the method started may view its caller's frames too, so the
  # caller goes on only once the task has ended.
  use std.task
  use std.time

  sub nap(ms: Int)
    time.sleep(ms: ms) catch |_|
      return

  sub reader(s: ?[8]Int)
    nap(20)
    print(s[0], s[7])

  obj S
    n: Int

    sub slow(!@)
      nap(20)

    fun work(?@, v: ?[8]Int) -> Int
      t = reader(v)&
      panic("mid") if @n > 0
      >t
      1

  sub first(a: *Actor[S])
    !a.slow()

  fun second(a: *Actor[S]) -> Int
    local = [8 of 7]
    a.work(?local)

  a = *Actor(S(n: 1))
  t = first(+a)&
  time.sleep(ms: 5)!
  u = task.isolate(|+a| second(+a)) catch |e|
    print("caught", e)
    -1
  >t
  print(u)

test "a panic in a task an actor's method started ends the actor", seeds: 20, '''
  caught Stop.panicked
  -1
  caught again Stop.panicked
  -2
'''
  # The task's panic passes to the method that waits for it, and the
  # actor's own task is the boundary it stops at.
  use std.task
  use std.time

  sub nap(ms: Int)
    time.sleep(ms: ms) catch |_|
      return

  sub boom()
    panic("in the task")

  obj S
    n: Int

    sub slow(!@)
      nap(20)

    fun work(?@) -> Int
      t = boom()&
      >t
      @n

    fun get(?@) -> Int
      @n

  sub first(a: *Actor[S])
    !a.slow()

  a = *Actor(S(n: 1))
  t = first(+a)&
  time.sleep(ms: 5)!
  u = task.isolate(|+a| a.work()) catch |e|
    print("caught", e)
    -1
  print(u)
  >t
  v = task.isolate(|+a| a.get()) catch |e|
    print("caught again", e)
    -2
  print(v)

test "an isolate inside a method on the actor's task keeps the actor", seeds: 20, '''
  -5
  1
'''
  # The panic stops at the nearer boundary, so the actor lives.
  use std.task
  use std.time

  sub nap(ms: Int)
    time.sleep(ms: ms) catch |_|
      return

  fun risky(x: Int) -> Int
    panic("no") if x > 0
    x

  obj S
    n: Int

    sub slow(!@)
      nap(20)

    fun safe(?@) -> Int
      task.isolate(|| risky(1)) catch -5

    fun get(?@) -> Int
      @n

  sub first(a: *Actor[S])
    !a.slow()

  a = *Actor(S(n: 1))
  t = first(+a)&
  time.sleep(ms: 5)!
  print(a.safe())
  >t
  print(a.get())

test "an isolate inside a method run inline keeps the actor", seeds: 20, '''
  -5
  1
'''
  use std.task

  fun risky(x: Int) -> Int
    panic("no") if x > 0
    x

  obj S
    n: Int

    fun safe(?@) -> Int
      task.isolate(|| risky(1)) catch -5

    fun get(?@) -> Int
      @n

  a = *Actor(S(n: 1))
  print(a.safe())
  print(a.get())
