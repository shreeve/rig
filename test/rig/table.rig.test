fail "span of another count is refused", "4:10: type mismatch: expected `Span[8]`, got `Span[16]`; a span is a run of slots of a table of its own `n`"
  t: Table[Int, 8] = Table()
  u: Table[Int, 16] = Table()
  sp = (!u).append([1])
