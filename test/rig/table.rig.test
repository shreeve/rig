fail "span a view is lent", "3:7: a span of a table views it; write `?t[sp]`"
  t: Table[Int, 8] = Table()
  sp = (!t).append([1, 2])
  print(t[sp][0])

fail "span append while a span is viewed", "cannot lend `t` to write while a read loan is live"
  t: Table[Int, 8] = Table()
  sp = (!t).append([1, 2])
  v = ?t[sp]
  _ = (!t).append([3])
  print(v)

fail "span a slot written while a span is viewed", "cannot assign to `t[s]` while `t` is lent"
  t: Table[Int, 8] = Table()
  sp = (!t).append([1, 2])
  s: Slot[8] = 0
  v = ?t[sp]
  t[s] = 4
  print(v)

fail "span not made from numbers", "a `Span[8]` is made by a table's `append`, by `sub`, or empty by `Span[8]()`, which takes no arguments"
  sp = Span[8](0, 3)
  print(sp)

fail "span its start is not a field", "a `Span[8]` has no field `start`"
  sp = Span[8]()
  print(sp.start)

fail "span append copies its elements", "`append` copies each element into a slot, and a `String` is not copied"
  t: Table[String, 8] = Table()
  xs = List([String("a")])
  _ = (!t).append(?xs)

fail "span has no order", "Span[8]"
  a = Span[8]()
  print(a < a)
