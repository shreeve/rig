  t: Table[Int, 2] = Table()
  _ = (!t).push(1)
  _ = (!t).push(2)
  _ = (!t).push(3)

bomb "table index by Int past n", "index out of bounds"
  t: Table[Int, 4] = Table()
  i = 4
  print(t[i])

