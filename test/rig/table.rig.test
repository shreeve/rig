fail "table every literal a slot takes is checked", "2:12: integer value `300` does not fit in `Slot[8]`", "3:16: `301`", "5:13: `302`", "14:16: `300`", "`303`", "`304`", "`305`", "`306`", errors: 8
  fun pick(c: Bool, o: Slot[8]?) -> Slot[8]
    x = o ?? 300
    y: Slot[8] = 301 if c else 1
    z: Slot[8] = match c
      true => 302
      false => 2
    x if y == z else y

  enum E
    a(v: Slot[8])
    b

  obj Q
    v: Slot[8] = 300

  e = E.a(v: 303)
  arr: [2]Slot[8] = [1, 304]
  fill: [3]Slot[8] = [3 of 305]
  l = List[Slot[8]]([1, 306])
  print(pick(true, none), arr, fill, l, Q().v, e)

test "table in a generic object holds its instance's element", '''
  0 7
  0 0
'''
  # Each instance's table is held as its element says: a table of `Int`
  # is reserved, one of `P` (whose default is 7) made.
  obj Store[T]
    items: Table[T, 1024]

  obj P
    x: Int = 7

  obj Wrap[T]
    n: Int = 0
    items: List[T] = List()

  a = Store[Int](items: Table())
  b = Store[P](items: Table())
  print(a.items[500], b.items[500].x)
  w: Table[Wrap[String], 4] = Table()
  print(w[3].n, w[3].items.len)

fail "table no slot of no slots through a generic element", "`z[0]` cannot use `n = 0`: the generic body names `Slot[n]`"
  # Every `Slot[n]` is below `n`: a count with no slots is rejected
  # wherever an instance names it, here in a table's element.
  fun z[n: Int]() -> Int
    t = Table[Slot[n], 4]()
    s: Slot[4] = 2
    Int(t[s])

  print(z[0]())

code "table a match subject is reached read-only", "w.constSlot(ws)", /^(?![\s\S]*w\.slot\()/
  # Only a slot a write reaches is reached to write (`slot`): a table
  # held as it is written never grows for a read.
  w: Table[String, 4] = Table()
  ws = (!w).push(String("ab"))
  c = match w[ws]
    "ab" => 1
    x => x.len
  print(c)

test "table an optional element read through a read view", "3"
  # Whether `<t[0]` could take the element is only asked, and the asking
  # reaches no slot to write: a read view of the table reads it in place.
  fun peek(t: ?Table[String?, 4]) -> Int
    if t[0] as s
      s.len
    else
      0

  t: Table[String?, 4] = Table()
  _ = (!t).push(String("abc"))
  print(peek(?t))

test "table of an object with an empty method", "true 0"
  # A method named like a runtime name is the object's own.
  obj Bag
    xs: List[Int] = List()

    fun empty(?@) -> Bool
      @xs.len == 0

  t: Table[Bag, 4] = Table()
  s: Slot[4] = 3
  print(t[s].empty(), t[s].xs.len)

test "table a slot's count is inferred from its argument", "11 8 4"
  # A generic call infers `n` from a `Slot[n]` argument, as from a
  # `Table[T, n]`, and through a view or an optional of one.
  fun id[n: Int](s: Slot[n]) -> Int
    Int(s) + n

  fun count[n: Int](s: ?Slot[n]?) -> Int
    n

  s: Slot[8] = 3
  o: Slot[4]? = 1
  p: Slot[8]? = s
  print(id(s), count(?p), count(?o))

test "table a slot and its table agree on the count", "5"
  fun get[n: Int](t: ?Table[Int, n], s: Slot[n]) -> Int
    t[s]

  t: Table[Int, 8] = Table()
  s = (!t).push(5)
  print(get(?t, s))

fail "table a slot of another count is refused", "6:7: conflicting values for `n` in the call to `get`: `8` (argument 1) and `4` (argument 2)"
  fun get[n: Int](t: ?Table[Int, n], s: Slot[n]) -> Int
    t[s]

  t: Table[Int, 8] = Table()
  s: Slot[4] = 1
  print(get(?t, s))

test "table a slot compares with a literal below its count", "true false true true true false true"
  # A literal below `n` is a `Slot[n]` where one is expected, beside a
  # slot in a comparison as at an assignment: `t == 0` tests for the
  # first slot, the zero a record's slot fields start at.
  t: Table[Int, 8] = Table()
  _ = (!t).push(1)
  s = (!t).push(2)
  z: Slot[8] = 0
  print(z == 0, s == 0, s != 3, 1 == s, s < 3, s >= 2 and s > 1 and s <= 1, 0 <= z)

fail "table a literal compared with a slot fits below its count", "3:12: integer value `8` does not fit in `Slot[8]`", errors: 1
  t: Table[Int, 8] = Table()
  s = (!t).push(1)
  print(s == 8)

fail "table no literal is a slot of no slots", "1:13: a `Slot` names one of `n` slots; `n` is at least 1", errors: 1
  fun zero(s: Slot[0]) -> Bool
    s == 0

  print(true)

# A reserved table reserves its range at its first write; until then its
# slots read `T()` from the zero range every unwritten table shares
# (src/table.zig). No view lives across that write: each form below that
# would keep one is rejected.

test "table an unwritten table reads its default", '''
  0 0 0 false
  []
  0
'''
  obj P
    x: Int = 0
    y: U32 = 0
    on: Bool = false

  N = 1 << 22

  sub main()
    t: Table[P, N] = Table()
    far: Slot[N] = 4194303
    a = ?t[0]
    print(a.x, t[far].y, t.len, t[far].on)
    print(t)
    for _ in ?t
      print("no slot")
    print(t[1000].x + Int(t[2000].y))

test "table a first write through push", '''
  0 7 1
  0 7
'''
  obj P
    x: Int = 0

  N = 1 << 22

  sub main()
    t: Table[P, N] = Table()
    before = t[0].x
    s = (!t).push(P(x: 7))
    print(before, t[s].x, t.len)
    print(t[1].x, t[0].x)

test "table a first write through a slot", '''
  9 0 0
  10 2 0
'''
  obj P
    x: Int = 0
    y: Int = 0

  N = 1 << 22

  sub main()
    t: Table[P, N] = Table()
    t[3].x = 9
    print(t[3].x, t[0].x, t.len)
    u: Table[P, N] = Table()
    u[5] = P(x: 10)
    v: Table[Int, N] = Table()
    v[1] += 2
    print(u[5].x, v[1], v[0])

test "table a first write through a write view", "4 0"
  sub set(x: !Int)
    x = 4

  t: Table[Int, 64] = Table()
  set(!t[2])
  print(t[2], t[3])

test "table a first write in a release build", release: true, '''
  0 7 9 1
'''
  N = 1 << 22

  sub main()
    t: Table[Int, N] = Table()
    a = t[5]
    s = (!t).push(7)
    u: Table[Int, N] = Table()
    u[N - 1] = 9
    print(a, t[s], u[N - 1], t.len)

test "table never written tables are dropped", '''
  0 1
'''
  obj P
    x: Int = 0
    y: Int = 0
    z: Int = 0

  N = 1 << 22

  obj Ast
    recs: Table[P, N]

  sub main()
    seen = 0
    asts: List[Ast] = List()
    for i in 0..2000
      t: Table[P, N] = Table()
      seen += t[i].x
      !asts.push(Ast(recs: Table()))
    !asts[7].recs.push(P(x: 1))
    print(seen, asts[7].recs.len)

test "table never written tables are dropped in a release build", release: true, '''
  0 1
'''
  N = 1 << 22

  obj Ast
    recs: Table[Int, N]

  sub main()
    seen = 0
    asts: List[Ast] = List()
    for i in 0..2000
      t: Table[Int, N] = Table()
      seen += t[i]
      !asts.push(Ast(recs: Table()))
    !asts[7].recs.push(1)
    print(seen, asts[7].recs.len)

