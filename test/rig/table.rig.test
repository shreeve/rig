fail "table no push while a field of an unwritten slot is viewed", "7:3: cannot lend `t` to write while a read loan is live"
  obj P
    x: Int = 0

  sub main()
    t: Table[P, 4] = Table()
    a = ?t[0].x
    !t.push(P(x: 3))
    print(a)

fail "table no slot written beside a view of another", "7:13: cannot lend `t` to write while a read loan is live"
  sub f(a: ?Int, b: !Int)
    b = 7
    print(a)

  sub main()
    t: Table[Int, 4] = Table()
    f(?t[0], !t[1])

fail "table no table written beside a view of its slot", "7:13: cannot lend `t` to write while a read loan is live"
  sub f(a: ?Int, t: !Table[Int, 4])
    t[1] = 7
    print(a)

  sub main()
    t: Table[Int, 4] = Table()
    f(?t[0], !t)

fail "table no push in a loop over an unwritten table", "3:3: cannot lend `t` to write while a read loan is live"
  t: Table[Int, 4] = Table()
  for _ in ?t
    !t.push(1)
  print(t.len)

fail "table no slot write while a view a function gave is live", "10:3: cannot assign to `t[2]` while `t` is lent"
  obj P
    x: Int = 0

  fun first(t: ?Table[P, 4]) -> ?P
    ?t[0]

  sub main()
    t: Table[P, 4] = Table()
    a = first(?t)
    t[2] = P(x: 9)
    print(a.x)

fail "table no slot write while an object holds a view of a slot", "7:3: cannot assign to `t[1]` while `t` is lent"
  obj V
    r: ?Int

  sub main()
    t: Table[Int, 4] = Table()
    v = V(r: ?t[0])
    t[1] = 4
    print(v.r)

fail "table no slot write while a closure views the table", "3:1: cannot assign to `t[0]` while `t` is lent"
  t: Table[Int, 4] = Table()
  g = |?t| t[0]
  t[0] = 4
  print(g())

fail "table no slot write while a slot of a table in an object is viewed", "7:3: cannot assign to `h.t[1]` while `h.t` is lent"
  obj H
    t: Table[Int, 4]

  sub main()
    h = H(t: Table())
    a = ?h.t[0]
    h.t[1] = 3
    print(a)

fail "table no two slots of one table lent to write", "cannot lend `t` to write while a write loan is live"
  t: Table[Int, 4] = Table()
  swap(!t[0], !t[1])
  print(t[0])
