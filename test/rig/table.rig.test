test "table a push in the value of a slot's assignment", '''
  0 0
  0 0
  2 1
'''
  obj R
    x: Int = 0
    y: Int = 0

  sub main()
    t: Table[R, 4] = Table()
    r = R(x: 2)
    t[0].x = Int((!t).push(r))
    print(t[0].x, t[1].x)
    u: Table[R, 4] = Table()
    u[0] = R(x: Int((!u).push(r)))
    print(u[0].x, u[1].x)
    v: Table[R, 4] = Table()
    v[(!v).push(r)].y = 1
    print(v[0].x, v[0].y)

test "table a write lent in the value of a slot's assignment", '''
  1 5
  1 5
  1 5
  1 5
'''
  obj R
    x: Int = 0
    y: Int = 0

  fun f(t: !Table[R, 4]) -> Int
    t[1].x = 5
    1

  sub main()
    a: Table[R, 4] = Table()
    a[0].x += f(!a)
    print(a[0].x, a[1].x)
    b: Table[R, 4] = Table()
    b[0].x = f(!b)
    print(b[0].x, b[1].x)
    c: Table[R, 4] = Table()
    c[1] = c[0]
    c[2] = R(x: c[3].x + f(!c))
    print(c[2].x, c[1].x)
    d: Table[R, 4] = Table()
    d[0] = R(x: f(!d), y: d[1].x)
    print(d[0].x, d[0].y)

