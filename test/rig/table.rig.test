  s = Slot[8](3)
  print(s)

fail "table a literal past n", "integer value `9` does not fit in `Slot[8]`"
  s: Slot[8] = 9
  print(s)

fail "table a large eager table", "a `Table[P, 67108864]` makes every slot up front"
  obj P
    x: Int = 1

  N = 1 << 26

  sub main()
    t: Table[P, N] = Table()
    print(t.len)

fail "table a view element", "a `Table` holds values; a view cannot be one"
  t: Table[?String, 4] = Table()
  print(t.len)

fail "table no slots", "a `Slot` names one of `n` slots; `n` is at least 1"
  s: Slot[0] = 0
  print(s)

fail "table no slots in a table", "a `Table` has `n` slots; `n` is at least 1"
  t: Table[Int, 0] = Table()
  print(t.len)

fail "table push while a slot is viewed", "cannot lend `t` to write while a read loan is live"
  t: Table[Int, 4] = Table()
  s = (!t).push(1)
  a = ?t[s]
  _ = (!t).push(2)
  print(a)

fail "table slot of another n", "expected `Slot[16]`, got `Slot[8]`"
  t: Table[Int, 16] = Table()
  if Slot[8].of(1) as s
    print(t[s])

fail "table no arithmetic on a slot", "Slot"
  t: Table[Int, 4] = Table()
  s = (!t).push(1)
  print(t[s + 1])

fail "table no element without a default", "a `Table[P, 4]` fills its slots with `P()`"
  obj P
    x: Int

  t: Table[P, 4] = Table()
  print(t.len)

fail "table no slicing", "cannot slice"
  t: Table[Int, 4] = Table()
  print(?t[0..2])

code "table a slot index has no test", "t.slot(s).*", "t.at(s)", /^(?![\s\S]*Int\()/
  t: Table[Int, 64] = Table()
  s = (!t).push(3)
  t[s] += 1
  print(t[s])

code "table an Int index has a test", "t.atInt(i)"
  t: Table[Int, 64] = Table()
  i = 2
  print(t[i])

test "table an element whose default is not zeros is made", '''
  none 2 7 true
'''
  # An optional's none, an enum whose default variant is not 0, and a
  # float, which may be `-0.0`, are not zero bytes: each slot is made.
  enum K
    a = 1
    b = 2

  obj P
    k: K = .b
    o: Int? = none
    f: Float = -0.0
    n: Int = 7

  t: Table[P, 1000] = Table()
  if Slot[1000].of(999) as s
    print(t[s].o, Int(t[s].k), t[s].n, t[s].f == 0.0)

test "table an optional table", '''
  true
  1
'''
  o: Table[Int, 4]? = none
  print(o == none)
  o = Table()
  if !o as t
    _ = (!t).push(5)
  if ?o as t
    print(t.len)

test "table a write view of a slot", '''
  [3]
'''
  sub bump(x: !Int)
    x += 2

  t: Table[Int, 8] = Table()
  s = (!t).push(1)
  bump(!t[s])
  print(t)

fail "table no table is a field's default", "a table is made as the program runs, so it is no field's default"
  obj S
    t: Table[Int, 8] = Table()

  s = S()
  print(s.t.len)

fail "table no table of no slots in a generic instance", "`Box[0]` instantiates `Table[Int, 0]`"
  obj Box[n: Int]
    t: Table[Int, n]

  b = Box[0](t: Table())
  print(b.t.len)

fail "table no slot literal where n is a parameter", "a literal is a `Slot[n]` only where `n` is known"
  fun mk[n: Int]() -> Slot[n]
    0

  print(mk[8]())

fail "table no slot from an alias call", "a `Slot[8]` is made by `push`, by `Slot[8].of(i)`, or by a literal below 8"
  type TypeId = Slot[8]

  s = TypeId(3)
  print(s)

fail "table no slot from an integer", "expected `Slot[8]`, got `Int`"
  i = 3
  s: Slot[8] = i
  print(s)

fail "table no wrapping count on a slot", "`+%=` requires an integer target"
  t: Table[Int, 8] = Table()
  s = (!t).push(1)
  s +%= 1
  print(s)

fail "table no slot read from bytes", "`read` reads an integer or float type"
  b = [U8(1), 0, 0, 0]
  x = b.read[Slot[8], .little](0)
  print(x)

fail "table no clone of a table", "`+x` cannot clone a `Table[String, 4]`: a table has no clone"
  t: Table[String, 4] = Table()
  u = +t
  print(u.len)

fail "table every literal a slot takes is checked", "2:12: integer value `300` does not fit in `Slot[8]`", "3:16: `301`", "5:13: `302`", "14:16: `300`", "`303`", "`304`", "`305`", "`306`", errors: 8
  fun pick(c: Bool, o: Slot[8]?) -> Slot[8]
    x = o ?? 300
    y: Slot[8] = 301 if c else 1
    z: Slot[8] = match c
      true => 302
      false => 2
    x if y == z else y

  enum E
    a(v: Slot[8])
    b

  obj Q
    v: Slot[8] = 300

  e = E.a(v: 303)
  arr: [2]Slot[8] = [1, 304]
  fill: [3]Slot[8] = [3 of 305]
  l = List[Slot[8]]([1, 306])
  print(pick(true, none), arr, fill, l, Q().v, e)

test "table in a generic object holds its instance's element", '''
  0 7
  0 0
'''
  # Each instance's table is held as its element says: a table of `Int`
  # is reserved, one of `P` (whose default is 7) made.
  obj Store[T]
    items: Table[T, 1024]

  obj P
    x: Int = 7

  obj Wrap[T]
    n: Int = 0
    items: List[T] = List()

  a = Store[Int](items: Table())
  b = Store[P](items: Table())
  print(a.items[500], b.items[500].x)
  w: Table[Wrap[String], 4] = Table()
  print(w[3].n, w[3].items.len)

fail "table no slot of no slots through a generic element", "`z[0]` cannot use `n = 0`: the generic body names `Slot[n]`"
  # Every `Slot[n]` is below `n`: a count with no slots is rejected
  # wherever an instance names it, here in a table's element.
  fun z[n: Int]() -> Int
    t = Table[Slot[n], 4]()
    s: Slot[4] = 2
    Int(t[s])

  print(z[0]())

code "table a match subject is reached read-only", "w.constSlot(ws)", /^(?![\s\S]*w\.slot\()/
  # Only a slot a write reaches is reached to write (`slot`): a table
  # held as it is written never grows for a read.
  w: Table[String, 4] = Table()
  ws = (!w).push(String("ab"))
  c = match w[ws]
    "ab" => 1
    x => x.len
  print(c)

test "table an optional element read through a read view", "3"
  # Whether `<t[0]` could take the element is only asked, and the asking
  # reaches no slot to write: a read view of the table reads it in place.
  fun peek(t: ?Table[String?, 4]) -> Int
    if t[0] as s
      s.len
    else
      0

  t: Table[String?, 4] = Table()
  _ = (!t).push(String("abc"))
  print(peek(?t))

test "table of an object with an empty method", "true 0"
  # A method named like a runtime name is the object's own.
  obj Bag
    xs: List[Int] = List()

    fun empty(?@) -> Bool
      @xs.len == 0

  t: Table[Bag, 4] = Table()
  s: Slot[4] = 3
  print(t[s].empty(), t[s].xs.len)

test "table a slot's count is inferred from its argument", "11 8 4"
  # A generic call infers `n` from a `Slot[n]` argument, as from a
  # `Table[T, n]`, and through a view or an optional of one.
  fun id[n: Int](s: Slot[n]) -> Int
    Int(s) + n

  fun count[n: Int](s: ?Slot[n]?) -> Int
    n

  s: Slot[8] = 3
  o: Slot[4]? = 1
  p: Slot[8]? = s
  print(id(s), count(?p), count(?o))

test "table a slot and its table agree on the count", "5"
  fun get[n: Int](t: ?Table[Int, n], s: Slot[n]) -> Int
    t[s]

  t: Table[Int, 8] = Table()
  s = (!t).push(5)
  print(get(?t, s))

fail "table a slot of another count is refused", "6:7: conflicting values for `n` in the call to `get`: `8` (argument 1) and `4` (argument 2)"
  fun get[n: Int](t: ?Table[Int, n], s: Slot[n]) -> Int
    t[s]

  t: Table[Int, 8] = Table()
  s: Slot[4] = 1
  print(get(?t, s))

test "table a slot compares with a literal below its count", "true false true true true false true"
  # A literal below `n` is a `Slot[n]` where one is expected, beside a
  # slot in a comparison as at an assignment: `t == 0` tests for the
  # first slot, the zero a record's slot fields start at.
  t: Table[Int, 8] = Table()
  _ = (!t).push(1)
  s = (!t).push(2)
  z: Slot[8] = 0
  print(z == 0, s == 0, s != 3, 1 == s, s < 3, s >= 2 and s > 1 and s <= 1, 0 <= z)

fail "table a literal compared with a slot fits below its count", "3:12: integer value `8` does not fit in `Slot[8]`", errors: 1
  t: Table[Int, 8] = Table()
  s = (!t).push(1)
  print(s == 8)

fail "table no literal is a slot of no slots", "1:13: a `Slot` names one of `n` slots; `n` is at least 1", errors: 1
  fun zero(s: Slot[0]) -> Bool
    s == 0

  print(true)

# Spans: `Span[n]`, a run of slots a table's `append` makes, viewed as a
# slice with no test (SPEC §10, "Table").

test "span append gives runs of slots", '''
  0..3 3..5 3
  [1, 2, 3] [4, 5]
  5
'''
  t: Table[Int, 16] = Table()
  xs = List([1, 2, 3])
  a = (!t).append(?xs)
  b = (!t).append([4, 5])
  print(a, b, a.len)
  print(?t[a], ?t[b])
  print(t.len)

test "span index and loop", '''
  20
  10 20 30
  60
'''
  t: Table[Int, 8] = Table()
  sp = (!t).append([10, 20, 30])
  print((?t[sp])[1])
  v = ?t[sp]
  print(v[0], v[1], v[2])
  n = 0
  for x in ?t[sp]
    n += x
  print(n)

test "span write through", '''
  [9, 4, 6]
  [9, 4, 6, 7]
'''
  t: Table[Int, 8] = Table()
  sp = (!t).append([1, 2, 3])
  _ = (!t).push(7)
  for x in !t[sp]
    x *= 2
  (!t[sp])[0] = 9
  print(?t[sp])
  print(t)

test "span sub", '''
  1..3 [2, 3] 2
  2..2 []
'''
  t: Table[Int, 8] = Table()
  sp = (!t).append([1, 2, 3, 4])
  mid = sp.sub(1, 3)
  print(mid, ?t[mid], mid.len)
  e = mid.sub(1, 1)
  print(e, ?t[e])

test "span empty and compared", '''
  0..0 0 true
  false true
'''
  t: Table[Int, 8] = Table()
  e: Span[8] = Span()
  nil = Span[8]()
  print(e, (?t[e]).len, e == nil)
  sp = (!t).append([1])
  print(sp == nil, sp != nil)

test "span of another table of the same n", '''
  [0, 0, 0]
  [5, 6, 7]
'''
  a: Table[Int, 64] = Table()
  b: Table[Int, 64] = Table()
  sp = (!a).append([5, 6, 7])
  print(?b[sp])
  print(?a[sp])

test "span records in a table of zeros", '''
  [2, 3] 1..3
  0..0
'''
  # A record whose spans default to `Span()` is all zeros, so a table of
  # it is reserved, and a slot never written holds the empty span.
  type Run = Span[1024]

  obj Sig
    params: Run = Run()
    flags: U32 = 0

  items: Table[Int, 1024] = Table()
  sigs: Table[Sig, 16777216] = Table()
  _ = (!items).push(1)
  s = (!sigs).push(Sig(params: (!items).append([2, 3])))
  print(?items[sigs[s].params], sigs[s].params)
  if Slot[16777216].of(99) as far
    print(sigs[far].params)

test "span keys a Map", "2 1"
  t: Table[Int, 32] = Table()
  a = (!t).append([1])
  b = (!t).append([2, 2])
  seen: Map[Span[32], Int] = Map()
  !seen.put(a, 1)
  !seen.put(b, 2)
  print(seen.get(b) ?? 0, seen.get(a) ?? 0)

test "span passes as a slice argument", "6 6"
  fun total(xs: []Int) -> Int
    n = 0
    for x in xs
      n += x
    n

  t: Table[Int, 8] = Table()
  sp = (!t).append([1, 2, 3])
  print(total(t[sp]), total(?t[sp]))

test "span a generic count is inferred", "5"
  fun sum[n: Int](t: ?Table[Int, n], sp: Span[n]) -> Int
    s = 0
    for x in ?t[sp]
      s += x
    s

  t: Table[Int, 8] = Table()
  sp = (!t).append([2, 3])
  print(sum(?t, sp))

test "span of a table made up front", "[1.5, 2.5] 0..2"
  # A Float may be `-0.0`, so a table of them makes every slot.
  t: Table[Float, 8] = Table()
  sp = (!t).append([1.5, 2.5])
  print(?t[sp], sp)

