test "review-box-p124", '''
  36 Node(v: 11, next: Node(v: 12, next: Node(v: 13, next: none)))
  40
  12
'''
  obj Node
    v: Int
    next: ^Node?

    fun sum(?@) -> Int
      if ?@next as n
        @v + n.sum()
      else
        @v

    sub add(!@, k: Int)
      @v += k
      if !@next as n
        !n.add(k)

    sub append(!@, v: Int)
      if !@next as n
        !n.append(v)
      else
        @next = ^Node(v: v, next: none)

    fun len(?@) -> Int
      if ?@next as n
        1 + n.len()
      else
        1

  n = Node(v: 1, next: none)
  !n.append(2)
  !n.append(3)
  !n.add(10)
  print(n.sum(), n)
  b = ^<n
  !b.append(4)
  print(b.sum())
  r = ?b
  if ?r.next as z
    print(z.v)

