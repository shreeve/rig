test "review-box-p107", '''
  drop 1
  eat 2
  drop 2
  eat 3
  drop 3
  drop 4
  end
  drop 30
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  sub eat(b: ^R)
    print("eat", b.n)

  b = ^R(n: 1)
  <b
  b = ^R(n: 2)
  flag = b.n > 1
  if flag
    eat(<b)
  c = ^R(n: 3)
  i = 0
  while i < 3
    if i == 1
      eat(<c)
      c = ^R(n: 30)
    i += 1
  o: ^R? = ^R(n: 4)
  if flag
    x = <o
  print("end")

test "review-box-p108", '''
  c 2
  s 3
  s 3
  2 6
  pc 2
'''
  enum Sh
    c(r: Int)
    s(k: Int)

  obj H
    b: ^Sh

  fun area(b: ?Sh) -> Int
    match b
      .c(r) => r * 3
      .s(k) => k * k

  h = H(b: ^Sh.c(r: 2))
  match ?h.b
    .c(r) => print("c", r)
    .s(k) => print("s", k)
  v: List[^Sh] = List()
  !v.push(^Sh.s(k: 3))
  for x in ?v
    match ?x
      .c(r) => print("c", r)
      .s(k) => print("s", k)
  for x in !v
    match x
      .c(r) => print("c", r)
      .s(k) => print("s", k)
  n = match ?h.b
    .c(r) => r
    .s(k) => k
  print(n, area(?h.b))
  p = ?h
  match ?p.b
    .c(r) => print("pc", r)
    .s(k) => print("ps", k)

