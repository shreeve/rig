  e2 = E.a(r: Res(n: 2, t: String("two")))
  p = ?e1
  k = Res(n: 0, t: String("k"))
  saved = ?k
  match p
    .a(r) => saved = ?r
    .b => pass
  p = ?e2
  e1 = E.b
  print(clobber(1))
  print(saved.t)

