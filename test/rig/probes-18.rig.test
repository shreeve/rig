    .a(r) if r.n > 7 => saved = ?r
    .a(r) => saved = ?r
    .b(r) => saved = ?r
  h2 = H(e: E.b(r: Res(n: 3, t: String("three"))))
  print(clobber(1))
  print(saved.t)

