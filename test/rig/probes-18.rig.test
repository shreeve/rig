test "review-box-p128", '''
  5
  5
  5
  1
  R(n: 1)
  R(n: 1)
  drop 1
  6 R(n: 2)
  drop 2
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  fun peek[T](b: ?T) -> ?T
    ?b

  sub show[T](x: ?T)
    print(x)

  sub showb[T](b: ?T)
    show(?b)
    show(b)

  sub wr[T](p: !T, v: T)
    p = <v

  sub setb[T](b: !^T, v: T)
    wr[T](!b, <v)

  i = ^5
  print(peek(?i))
  showb(?i)
  r = ^R(n: 1)
  print(peek(?r).n)
  showb(?r)
  setb(!i, 6)
  setb(!r, R(n: 2))
  print(i, r)

test "review-box-p129", '''
  5
  0
'''
  fun peek(b: ?Int) -> ?Int
    ?b

  fun peekv(b: ?List[Int]) -> ?List[Int]
    ?b

  i = ^5
  print(peek(?i))
  v = ^List[Int]()
  print(peekv(?v).len)

fail "review-box-p13", "cannot reassign `cur` while it is lent"
  obj Node
    v: Int
    next: ^Node?

  head: ^Node? = none
  for i in [1, 2, 3]
    head = ^Node(v: i, next: <head)
  cur = !head
  while !cur as n
    cur = !n.next
    n.next = none
  print(head)

test "review-box-p133", '''
  built
  dropped
  drop q 200000
  drop q 100000
  drop q 0
  done
'''
  obj T
    k: Int
    kids: List[^T]

  obj Q
    k: Int
    a: ^Q?
    s: *Q2?

    drop(!@)
      if @k % 100000 == 0
        print("drop q", @k)

  obj Q2
    q: ^Q?

  root = ^T(k: 0, kids: List())
  i = 1
  while i < 300000
    root = ^T(k: i, kids: List())
    i += 1
  deep: ^T? = none
  i = 0
  while i < 300000
    kids: List[^T] = List()
    if <deep as d
      !kids.push(<d)
    deep = ^T(k: i, kids: <kids)
    i += 1
  print("built")
  deep = none
  print("dropped")
  q: ^Q? = none
  i = 0
  while i < 300000
    if i % 2 == 0
      q = ^Q(k: i, a: <q, s: none)
    else
      q = ^Q(k: i, a: none, s: *Q2(q: <q))
    i += 1
  q = none
  print("done")
