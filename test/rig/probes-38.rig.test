fail "seam3-review1-e12 gen vec cell string base", "`keep[?String]` cannot use `T = ?String`: the generic body stores a `T` in a Cell, a Signal, or an owned closure, which carries no loan, and a `?String` may view a String (a `Static` carries no loan)"
  fun keep[T](x: T) -> *Cell[List[T]]
    xs: List[T] = List()
    !xs.push(x)
    *Cell(<xs)

  t = String("hello")
  !t.add(" world, a long text that lives on the heap")
  c = keep(?t[..])
  <t
  old = (!c).replace(List())
  print(old[0])

