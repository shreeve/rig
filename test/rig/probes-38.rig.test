fail "seam3-review1-e16 gen weak closure", "`mk[?^String]` cannot use `T = ?^String`: the generic body stores a `T` in a Cell, a Signal, or an owned closure, which carries no loan, and a view keeps what it views lent"
  obj Hold[T]
    v: T

  fun mk[T](x: T) -> *sub()
    h = *Hold(v: x)
    w = ~h
