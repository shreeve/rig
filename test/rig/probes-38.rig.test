  w: List[Int] = List()
  !v.push(1)
  b = ^?v if v.len > 0 else ^?w
  <v
  print(b.len)

fail "seam3-review1-i08 holder in tuple array", "cannot drop `v` while it is lent"
  v: List[Int] = List()
  !v.push(1)
  a = [^?v, ^?v]
  <v
  print(a[0].len)

fail "seam3-review1-j02 gen cell set vec", "`stash[?^String]` cannot use `T = ?^String`: the generic body stores a `T` in a Cell, a Signal, or an owned closure, which carries no loan, and a view keeps what it views lent"
  sub stash[T](c: *Cell[List[T]], x: T)
    xs: List[T] = List()
    !xs.push(x)
    _ = (!c).replace(<xs)

  c: *Cell[List[?^String]] = *Cell(List())
  b = ^String("hello")
  stash(+c, ?b)
  <b
  old = (!c).replace(List())
  print(old[0])

test "seams-mprobes-m01", "7 101"
  fun grow(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    0

  v: List[Int] = List()
  !v.push(7)
  v[0] += grow(!v)
  print(v[0], v.len)

test "seams-mprobes-m02", "0 101"
  fun grow(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    0

  v: List[Int] = List()
  !v.push(7)
  v[0] = grow(!v)
  print(v[0], v.len)

test "seams-mprobes-m04", "8 101"
  obj P
    a: List[Int]
    n: Int

  fun grow(p: !P) -> Int
    for i in 0..100
      !p.a.push(i)
    1

  p = P(a: List(), n: 0)
  !p.a.push(7)
  p.a[0] += grow(!p)
  print(p.a[0], p.a.len)

test "seams-mprobes-m05", "7"
  fun grow(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    0

  v: List[Int] = List()
  !v.push(7)
  x = v[0] + grow(!v)
  print(x)

test "seams-mprobes-m07", "1 0"
  obj Q
    v: List[Int]

  fun grow(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    0

  v: List[Int] = List()
  !v.push(7)
  q = Q(v: +v)
  n = grow(!v)
  print(q.v.len, n)

test "seams-mprobes-m08", '''
  v[0] is 5 expected 5
  w[0] is 6 expected 6
'''
  fun grow(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    5

  v: List[Int] = List()
  !v.push(7)
  v[0] = grow(!v)
  print("v[0] is", v[0], "expected 5")
  w: List[Int] = List()
  !w.push(1)
  w[0] += grow(!w)
  print("w[0] is", w[0], "expected 6")

test "seams-mprobes-m09", "v[0].total is 11 expected 11"
  obj Acc
    total: Int

  fun spill(v: !List[Acc]) -> Int
    for i in 0..100
      !v.push(Acc(total: i))
    1

  v: List[Acc] = List()
  !v.push(Acc(total: 10))
  v[0].total += spill(!v)
  print("v[0].total is", v[0].total, "expected 11")

test "seams-mprobes-m11", "1"
  obj H
    v: List[Int]

  fun f(h: !H) -> List[Int]
    !h.v.push(1)
    n: List[Int] = List()
    !n.push(h.v.len)
    n

  h = H(v: List())
  h.v = f(!h)
  print(h.v[0])

fail "seams-mprobes-m12", "cannot lend `v` to write while a write loan is live: to swap two elements of `v`, write `!v.swap(0, 1)`"
  fun grow(v: !List[Int]) -> Int
    for i in 0..100
      !v.push(i)
    2

  v: List[Int] = List()
  !v.push(7)
  !v.push(8)
  swap(!v[0], !v[1])
  print(v[0])
  a = [1, 2, 3]
  a[0] = a[1] + grow(!v)
  print(a[0])

