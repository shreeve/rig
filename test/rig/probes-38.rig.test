test "sc2-s", "0 3 0 1"
  fun first(xs: []Int?) -> Int
    xs[0] ?? 0

  fun maybe(xs: ([]Int)?) -> Int
    if xs as s
      return s.len
    0

  fun count(x: !Int?) -> Int
    1 if x != none else 0

  a: [2]Int? = [none, 3]
  b = [1, 2, 3]
  n: Int? = 4
  print(first(?a[0..2]), maybe(?b[0..3]), maybe(none), count(!n))

test "sc2v-s", "true [[7, 7, 7], [7, 7, 7]] [0, 0] true [9, 9, 9] 1"
  obj Node
    n: Int
    next: *Node?

    fun total(<@) -> Int
      @n

  enum Opt
    some(value: Int)
    nothing

  fun zeros[n: Int]() -> [n]Int
    [n of 0]

  tail = *Node(n: 2, next: none)
  head = Node(n: 1, next: +tail)
  grid: [2][3]Int = [2 of [3 of 7]]
  o: Opt = .some(5)
  of = 9
  xs = [3 of of]
  print(head.next != none, grid, zeros[2](), o == .some(5), xs, <head.total())

test "sc3-d", '''
  drop 1
  after -5
  drop 2
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  fun neg(x: Int) -> Int
    -x

  a = R(n: 1)
  b = R(n: 2)
  <a
  print("after", neg(5))

test "sc4-m", '''
  .circle(r: 12)
  big 5
  ate 7
  drop 7
  x 1
  9
'''
  obj R
    n: Int

    drop(!@)
      print("drop", @n)

  enum Shape
    circle(r: Int)
    sq(s: Int)
    held(res: R)

  sub eat(r: R)
    print("ate", r.n)

  e = Shape.circle(r: 2)
  match !e
    .circle(r) => r += 10
    _ => print("other")
  print(e)
  n = 5
  match n
    1, 2 => print("small")
    x if x > 3 => print("big", x)
    _ => print("mid")
  h = Shape.held(res: R(n: 7))
  match <h
    .held(res) => eat(<res)
    _ => print("none")
  v: List[Int] = List()
  !v.push(1)
  for x in ?v
    print("x", x)
  w = !n
  w = 9
  print(n)

