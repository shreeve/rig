# Probes from past reviews and audits, 38 of 41: sb-cl to seams-surface-d06_read_repoint.

use std.sort

test "sb-cl", "[1, 0, 0]"
  sub zap(w: ![]Int)
    v = <w
    f = |<v, i: Int|
      v[i] = 0
    f(1)
    f(2)

  a = [1, 2, 3]
  zap(!a[..])
  print(a)

test "sb-open", '''
  world hello hello, world 
  [2, 3, 4] [1, 2] [1, 2, 3, 4] []
  [20, 30] [10] [10, 20, 30]
  [3, 4] [2] [2, 3, 4]
  lo, world [3, 4] hell
'''
  s = "hello, world"
  print(s[7..], s[..5], s[..], s[s.len..])
  a = [1, 2, 3, 4]
  print(a[1..], a[..2], a[..], a[4..])
  v: List[Int] = List()
  !v.push(10)
  !v.push(20)
  !v.push(30)
  print(v[1..], v[..1], v[..])
  t = ?a[1..]
  print(t[1..], t[..1], t[..])
  k = 2
  print(s[k + 1..], a[k..], s[..k * 2])

