fail "seam3-holder-stack", "cannot lend `v` to write while a read loan is live"
  obj Stack[T]
    items: List[T]

    sub push(!@, x: T)
      !@items.push(x)

    fun top(?@) -> T?
      if @items.len == 0
        none
      else
        @items[@items.len - 1]

  v: List[Int] = List()
  !v.push(1)
  s: Stack[?List[Int]] = Stack(items: List())
  !s.push(?v)
  if s.top() as t
    print(t.len)
  !v.push(2)
  print(s.items.len)

