test "sb-rw", '''
  239 190 173 222 18 52
  3735928559 4660 13330
  3.5
  -2 4294967294
  .big .little
  16909060
  1
  [1, 0, 1, 2]
  0
'''
  page: [4096]U8 = [4096 of 0]
  !page.write[U32, .little](0, 0xdeadbeef)
  !page.write[U16, .big](4, 0x1234)
  print(page[0], page[1], page[2], page[3], page[4], page[5])
  print(page.read[U32, .little](0), page.read[U16, .big](4), page.read[U16, .little](4))
  x: F64 = 3.5
  !page.write[F64, .big](8, x)
  print(page.read[F64, .big](8))
  w = !page[100..]
  !w.write[I32, .little](0, -2)
  print(w.read[I32, .little](0), w.read[U32, .little](0))
  e: Endian = .big
  print(e, Endian.little)
  s = "\x01\x02\x03\x04"
  print(s.read[U32, .big](0))
  v: List[U8] = List()
  bs: [4]U8 = [1, 0, 0, 0]
  for b in bs
    !v.push(b)
  print(v.read[U32, .little](0))
  !v.write[U16, .big](2, 258)
  print(v)
  print(page.read[U8](4095))

test "sb-s1", '''
  [1, 2, 3, 4] 67305985
  [0, 16, 32, 48, 64, 80, 96, 112]
'''
  obj Frame
    buf: List[U8]

  sub put(f: !Frame, v: U32)
    !f.buf.write[U32, .big](0, v)

  f = Frame(buf: List())
  for i in 0..4
    !f.buf.push(U8(i))
  put(!f, 0x01020304)
  print(f.buf, f.buf.read[U32, .little](0))
  page: [8]U8 = [8 of 0]
  for i in 0..8
    !page.write[U8](i, U8(i * 16))
  print(page)

test "sbv-q", '''
  [1, 2, 3, 5, 7, 8, 9] true 4660 18 52
  world hello 7
  [9, 7, 7]
'''
  sub qsort(xs: ![]Int)
    return if xs.len < 2
    p = xs[xs.len - 1]
    i = 0
    j = 0
    while j < xs.len - 1
      if xs[j] < p
        !xs.swap(i, j)
        i += 1
      j += 1
    !xs.swap(i, xs.len - 1)
    qsort(!xs[..i])
    qsort(!xs[i + 1..])

  a = [5, 3, 9, 1, 7, 2, 8]
  qsort(!a[..])
  page: [64]U8 = [64 of 0]
  !page.write[U32, .little](0, 0xDEADBEEF)
  !page.write[U16, .big](4, 0x1234)
  print(a, page.read[U32, .little](0) == 0xDEADBEEF, page.read[U16, .big](4), page[4], page[5])
  s = "hello world"
  print(s[6..], s[..5], a.len)
  b = [0, 0, 0]
  !b[1..].fill(7)
  !b[..1].copy([9])
  print(b)

