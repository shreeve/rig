test "seams-probes-p17", '''
  1
  1
'''
  obj B
    v: List[Int]

  fun mk() -> B
    b = B(v: List())
    !b.v.push(5)
    <b

  a = mk()
  c = true
  print((a if c else mk()).v.len)
  print(a.v.len)

test "seams-strategy-probe3", '''
  a
  b
'''
  obj Job
    name: String
    priority: Int

  board: List[^Job] = List()
  !board.push(^Job(name: String("a"), priority: 2))
  !board.push(^Job(name: String("b"), priority: 1))
  sort.sort_by(!board[..], |a, b| a.priority < b.priority)
  !board.swap(0, 1)
  for t in ?board
    print(t.name)

test "seams-strategy-probe4", '''
  [Row(name: "a", n: 1)]
  x
'''
  obj Row
    name: ?String
    n: Int

  fun parse(t: ?String) -> List[Row]
    rows: List[Row] = List()
    !rows.push(Row(name: t[0..1], n: 1))
    rows

  t = String("abc")
  rows = parse(?t)
  print(rows)
  label = String("x")
  name: ?String = ?label
  print(name)

test "seams-strategy-tasks", '''
  tasks: 5
  [x] job-2 (p4)
  [ ] job-4 (p3)
  [ ] job-1 (p2)
  [ ] job-3 (p1)
  [ ] job-0 (p0)

'''
  # A tiny task board: tasks with owned names, sorted by priority,
  # with a text report.

  obj Job
    name: String
    priority: Int
    done: Bool = false

  fun make_task(prefix: ?String, n: Int, priority: Int) -> Job
    Job(name: String(prefix, "-", n), priority: priority)

  fun report(tasks: ?List[Job]) -> String
    out = String("tasks: ", tasks.len, "\n")
    for t in tasks
      mark = "x" if t.done else " "
      !out.add("[", mark, "] ", t.name, " (p", t.priority, ")\n")
    out

  board: List[Job] = List()
  i = 0
  while i < 5 : i += 1
    !board.push(make_task("job", i, (i * 7) % 5))
  board[2].done = true
  sort.sort_by(!board[..], |a, b| a.priority > b.priority)
  print(report(?board))

test "seams-strategy-tasks box", '''
  tasks: 5
  [ ] job-0 (p0)
  [ ] job-1 (p2)
  [x] job-2 (p4)
  [ ] job-3 (p1)
  [ ] job-4 (p3)

'''
  # The same board, with the workaround the compiler allows: boxed tasks.
  obj Job
    name: String
    priority: Int
    done: Bool = false

  fun make_task(prefix: ?String, n: Int, priority: Int) -> ^Job
    ^Job(name: String(prefix, "-", n), priority: priority)

  fun report(tasks: ?List[^Job]) -> String
    out = String("tasks: ", tasks.len, "\n")
    for t in ?tasks
      mark = "x" if t.done else " "
      !out.add("[", mark, "] ", t.name, " (p", t.priority, ")\n")
    out

  board: List[^Job] = List()
  i = 0
  while i < 5 : i += 1
    !board.push(make_task("job", i, (i * 7) % 5))
  for t, j in !board
    t.done = true if j == 2
  print(report(?board))

test "seams-surface-a01 bool short", "dup? true false"
  obj Set
    items: List[Int]

    fun insert(!@, k: Int) -> Bool
      for x in ?@items
        return false if x == k
      !@items.push(k)
      true

  s = Set(items: List())
  dup = (!s).insert(1)
  print("dup?", dup, (!s).insert(1))

test "seams-surface-a03 fail by binding", "1 -1"
  error E
    bad

  fun f(k: Int) -> Int!
    e = E.bad
    return 1 if k == 0
    return e

  print(f(0) catch -1, f(1) catch -1)

test "seams-surface-a06 tail moves", '''
  drop 2
  1
  drop 1
  drop 3
  4
  drop 4
'''
  obj R
    n: Int
    drop(!@)
      print("drop", @n)

  fun pick(a: R, b: R, c: Bool) -> R
    if c
      a
    else
      b

  fun tern(a: R, b: R, c: Bool) -> R
    a if c else b

  print(pick(R(n: 1), R(n: 2), true).n)
  x = tern(R(n: 3), R(n: 4), false)
  print(x.n)

test "seams-surface-b01 reads", '''
  P(v: []) 0 0
  b
  4
  0
'''
  obj P
    v: List[Int]

    fun n(?@) -> Int
      @v.len

  enum E
    a(v: List[Int])
    b

  fun size(p: ?P) -> Int
    p.v.len

  fun sizei(n: ?Int) -> Int
    n + 1

  p = P(v: List())
  e: E = .b
  print(p, p.n(), p.v.len)
  match e
    .a(v) => print(v.len)
    .b => print("b")
  k = 3
  print(sizei(?k))
  print(size(p))

test "seams-surface-b04 if as", "1"
  obj R
    n: Int
    drop(!@)
      pass

  o: R? = R(n: 1)
  if o as r
    print(r.n)

test "seams-surface-b07 array vec slice", '''
  6 [1, 2, 3]
  4
'''
  fun total(xs: []Int) -> Int
    n = 0
    for x in xs
      n += x
    n

  a = [3, 1, 2]
  v: List[Int] = List()
  !v.push(3)
  !v.push(1)
  sort.sort(!a)
  print(total(?a), a)
  print(total(?v))
  sort.sort(!v)

test "seams-surface-c02 text param", "he he hello 5"
  fun head(t: ?String) -> ?String
    t[0..2]

  fun head2(t: ?String) -> ?String
    ?t[0..2]

  fun whole(t: ?String) -> ?String
    t

  fun len_of(s: ?String) -> Int
    s.len

  t = String("hello")
  print(head(?t), head2(?t), whole(?t), len_of(?t))

test "seams-surface-c13 temp receiver", '''
  0 0
  0
'''
  obj Log
    lines: List[Int]

    fun count(?@) -> Int
      @lines.len

  fun make() -> Log
    Log(lines: List())

  fun count_of(l: ?Log) -> Int
    l.lines.len

  print(count_of(?make()), make().lines.len)
  print(?make().count())

test "seams-surface-c14 temp receiver2", '''
  0
  0
'''
  obj Log
    lines: List[Int]

    fun count(?@) -> Int
      @lines.len

  fun make() -> Log
    Log(lines: List())

  print(Log.count(?make()))
  print((?make()).count())

