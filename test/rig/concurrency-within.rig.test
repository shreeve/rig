# concurrency: tests whose names start `within`.

test "within value", seeds: 20, '''
  11
  Stop.timeout true
'''
  # `time.within` gives what its block gives; a waiting point after the
  # deadline fails with `task.Stop.timeout`, sleeping only until then.
  use std.time

  k = 10
  print(time.within(1, |+k| k + 1) catch 0)
  start = time.now()
  time.within(ms: 5, ||
    time.sleep(10)!
    print("slept")
  ) catch |e| print(e, start.elapsed() < 5 * time.SECOND)

test "within nested", seeds: 20, '''
  1 -1
  0
'''
  # Inside another deadline, the earlier one holds, and the outer one is
  # back once the inner block ends.
  use std.time

  fun slow(ms: Int) -> Int!
    time.sleep(ms: ms)!
    ms

  m = time.within(ms: 50, ||
    a = time.within(1, || slow(1)!)!
    b = time.within(10, || slow(10_000)!) catch -1
    print(a, b)
    a + b
  ) catch -2
  print(m)

test "within tasks", seeds: 20, release: true, '''
  inherited -1 true
  set -2
  check -3
  all -4
  par -5
  ok 1
'''
  # The tasks a block starts keep its deadline, and every fallible
  # waiting point fails after it: `task.check`, and a wait on a task, a
  # set, or `task.all`, whose tasks are canceled first.
  use std.par
  use std.task
  use std.time

  fun slow(ms: Int) -> Int!
    time.sleep(ms: ms)!
    ms

  fun spin() -> Int!
    loop
      task.check()!

  start = time.now()
  r = time.within(ms: 10, ||
    x = slow(10_000)&
    >x!
  ) catch -1
  print("inherited", r, start.elapsed() < 5 * time.SECOND)
  s = time.within(ms: 10, ||
    ts = Tasks[Int!]()
    !ts.add(slow(10_000)&)
    !ts.add(slow(1)&)
    (>ts!).len
  ) catch -2
  print("set", s)
  print("check", time.within(ms: 10, || spin()!) catch -3)
  b = time.within(ms: 10, ||
    p, q = task.all(slow(1)&, slow(10_000)&)!
    p + q
  ) catch -4
  print("all", b)
  xs = List([1, 2, 3, 4])
  print("par", time.within(ms: 10, |?xs| par.map(xs, |x| slow(x * 10_000)!)!.len) catch -5)
  print("ok", time.within(1, || slow(1)!) catch -6)

test "within one task", seeds: 20, '''
  -1 true
  3
'''
  # `time.within` calls its closure exactly once, so the closure may move
  # what it captures: a task made before the deadline is waited for
  # within it, and canceled when the deadline passes.
  use std.time

  fun slow(ms: Int) -> Int!
    time.sleep(ms: ms)!
    ms

  start = time.now()
  t = slow(60_000)&
  r = time.within(ms: 5, |<t| >t!) catch -1
  print(r, start.elapsed() < 5 * time.SECOND)
  u = slow(3)&
  print(time.within(1, |<u| >u!) catch -1)

test "within moves its captures", seeds: 20, '''
  drop 1
  a 2
  drop 2
  b 2
  drop 3
  c 0
  drop 4
  d -7
'''
  # The one call takes what the closure owns of its captures: it may
  # move them out, and drops the rest when it ends, failing or not.
  use std.time

  obj Res
    id: Int

    drop(!@)
      print("drop", @id)

  fun keep(r: Res) -> Int
    r.id

  error E
    bad

  sub boom(ok: Bool)!
    if not ok
      return E.bad

  r1 = Res(id: 1)
  print("a", time.within(1, |<r1| r1.id + 1) catch -1)
  r2 = Res(id: 2)
  print("b", time.within(1, |<r2| keep(<r2)) catch -1)
  r3 = Res(id: 3)
  flip = false
  print("c", time.within(1, |<r3, +flip|
    if flip
      keep(<r3)
    else
      0
  ) catch -1)
  r4 = Res(id: 4)
  print("d", time.within(1, |<r4, +flip|
    boom(flip)!
    keep(<r4)
  ) catch -7)

fail "within moves a capture once", "use of `r` after move", errors: 1
  # Called once, the closure may still move a capture only once.
  use std.time

  obj Res
    id: Int

  fun keep(r: Res) -> Int
    r.id

  r = Res(id: 1)
  n = time.within(1, |<r|
    s = 0
    for 0..2
      s += keep(<r)
    s
  ) catch -1
  print(n)

fail "within a closure called more than once", "cannot move captured `r`: the closure keeps what it captures for every call", errors: 1
  # Only a closure passed to a `once` parameter is called once: one
  # lent elsewhere keeps its captures for every call.
  obj Res
    id: Int

  fun keep(r: Res) -> Int
    r.id

  fun apply(f: ?fun() -> Int) -> Int
    f()

  r = Res(id: 1)
  print(apply(|<r| keep(<r)))

test "within inside the longest deadline", seeds: 20, timeout: 10, "5"
  # A deadline past the largest `Int` is no deadline: one inside it
  # holds, and the outer one is back after.
  use std.time

  print(time.within(ns: Int.max, || time.within(1, || 5)!) catch -1)
