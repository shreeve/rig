fail "apis object crossing lent without its bound", "`?b` is lent to a task to read, and `^{Shape}` hides its value's type without naming `Syncs`: write `^{Shape + Syncs}`", "`?s` is lent to a task to read, and `?{Shape}` hides its value's type without naming `Syncs`: write `?{Shape + Syncs}`", "`!w` is lent to a task to write, and `!{Shape}` hides its value's type without naming `Sends`: write `!{Shape + Sends}`", "`?c` is lent to a task to read, and `^{Shape + Sends}` hides its value's type without naming `Syncs`: write `^{Shape + Sends + Syncs}`", errors: 4
  # oracle: main reject T1
  # oracle: look reject T1
  # oracle: write reject T1
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape}) -> Float
    s.area()

  fun look(s: ?{Shape}) -> Float
    t = ?s.area()&
    >t

  sub touch(w: !{Shape})
    print(w.area())

  sub write(w: !{Shape})
    t = touch(!w)&
    >t

  fun total(c: ?^{Shape + Sends}) -> Float
    c.area()

  b: ^{Shape} = ^Square(side: 2.0)
  t = area_of(?b)&
  c: ^{Shape + Sends} = ^Square(side: 2.0)
  u = total(?c)&
  print(>t, >u, look(?b))

fail "apis object crossing a local task without its bound", "`?b` is lent to a task to read, and `^{Shape}` hides its value's type without naming `Syncs`: write `^{Shape + Syncs}` (a local task too: what it hides may go to no task)", errors: 1
  # oracle: main reject T1
  # Another part pins the task to this thread, which an object needs its
  # bound for too: what it hides may be an owned closure.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Node
    v: Int

  fun both(n: *Node, s: ?{Shape}) -> Float
    s.area() + Float(n.v)

  n = *Node(v: 1)
  b: ^{Shape} = ^Square(side: 2.0)
  t = both(+n, ?b)&
  print(>t)

