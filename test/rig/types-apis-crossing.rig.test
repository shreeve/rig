fail "apis object crossing a generic type that sends only where its argument does", "`Wrap[*Int]` is erased to `^{Job}`, which goes to other tasks, but `Wrap[*Int]` holds `*Int`", errors: 1
  # Stage 3 lets `Wrap[T]` provide `Job` where its instance does; the
  # erasure checks the API's `Sends` of the instance.
  api Job: Sends
    fun run(?@) -> Int

  obj Wrap[T]: Job
    x: T

    fun run(?@) -> Int
      2

  w: ^{Job} = ^Wrap[*Int](x: *Int(2))

fail "apis object crossing a generic type that clones only where its argument does", "`^Wrap[Tok](x: Tok(n: 1))` is erased to `^{Shape}`, whose API builds on `Clone`, and `Wrap[Tok]` is not `Clone`", errors: 1
  # The API's other built-in bounds are checked there too: `+w` would
  # clone a unique value through the table.
  api Shape: Clone
    fun area(?@) -> Float

  obj Tok unique
    n: Int

  obj Wrap[T]: Shape
    x: T

    fun area(?@) -> Float
      2.0

  w: ^{Shape} = ^Wrap[Tok](x: Tok(n: 1))
  v = +w
  print(v.area())

fail "apis object crossing a generic owned closure holds no task", "`mk[Task[Int]]` cannot use `T = Task[Int]`: the generic body captures a value that holds a `T` in an owned closure, which would hide a task from the rules that wait for one, and a `Task[Int]` holds one", errors: 1
  # An instance is checked where it is made, by the rule a capture of a
  # known type meets (`hidesNoTask`), not by the loan rule a task also
  # fails.
  fun sq(n: Int) -> Int
    n * n

  fun mk[T](x: T) -> *fun() -> Int
    *|<x| 7

  f = mk(3)
  g = mk(sq(2)&)
  print(f(), g())

fail "apis object crossing a generic owned closure over a value holding its parameter holds no task", "`mk[Task[Int]]` cannot use `T = Task[Int]`: the generic body captures a value that holds a `T` in an owned closure, which would hide a task from the rules that wait for one", errors: 1
  # The capture holds the `T` in a field; the instance is made through
  # another generic body.
  fun sq(n: Int) -> Int
    n * n

  obj Hold[T]
    t: T

  fun mk[T](x: Hold[T]) -> *fun() -> Int
    *|<x| 7

  fun outer[U](u: U) -> *fun() -> Int
    mk(Hold(t: <u))

  g = outer(sq(2)&)
  print(g())

fail "apis object crossing a generic body erases its parameter's instance without the bound", "`go[*Int]` cannot use `U = *Int`: a value that holds a `U` is erased to `^{Job + Sends}` in the generic body, and `*Int` is a `*` handle whose count is not atomic", "`sent[*Int]` cannot use `U = *Int`: a value that holds a `U` is erased to `^{Sent}` in the generic body", errors: 2
  # Review of phase 1: a `U` the body's bounds do not decide is decided
  # by each instance, as the erasure of a known type is; `Wrap[U]`
  # provides `Job` wherever its argument does.
  api Job
    fun run(?@) -> Int

  api Sent: Sends
    fun run(?@) -> Int

  obj Wrap[U]: Job + Sent
    u: U

    fun run(?@) -> Int
      1

  fun work(j: ^{Job + Sends}) -> Int
    j.run()

  fun go[U](u: U) -> Int
    j: ^{Job + Sends} = ^Wrap[U](u: <u)
    t = work(<j)&
    >t

  fun sent[U](u: U) -> ^{Sent}
    ^Wrap[U](u: <u)

  h = *Int(1)
  print(go(+h), sent(+h).run(), h)

fail "apis object crossing a generic body erases its parameter's instance without the other bounds", "`go[?List[Int]]` cannot use `U = ?List[Int]`: the generic body erases a value that holds a `U` to `^{Shape}`, whose braces or API name `Owned`, and `?List[Int]` is not `Owned`", "`dup[Tok]` cannot use `U = Tok`: the generic body erases a value that holds a `U` to `^{Copied}`, whose braces or API name `Clone`, and `Tok` is not `Clone`", "`show[^{Plain}]` cannot use `U = ^{Plain}`: the generic body erases a value that holds a `U` to `^{Plain + Print}`, whose braces or API name `Print`, and `^{Plain}` is not `Print`", errors: 3
  # The erased box of `go` outlived the List its field viewed (it printed
  # `Wrap(u: [])`), and `+b` would clone a unique `Tok` through the table.
  api Shape: Owned + Print
    fun area(?@) -> Float

  api Copied: Clone
    fun area(?@) -> Float

  api Plain
    fun area(?@) -> Float

  obj Tok unique
    n: Int

  obj Wrap[U]: Shape + Copied + Plain
    u: U

    fun area(?@) -> Float
      1.0

  fun go[U](u: U) -> ^{Shape}
    ^Wrap[U](u: <u)

  fun mk() -> ^{Shape}
    n = List([1, 2, 3])
    go(?n)

  fun dup[U](u: U) -> ^{Copied}
    b: ^{Copied} = ^Wrap[U](u: <u)
    +b

  fun show[U](u: U) -> ^{Plain + Print}
    ^Wrap[U](u: <u)

  p: ^{Plain} = ^Wrap[Int](u: 1)
  print(mk(), dup(Tok(n: 1)).area(), show(<p))

test "apis object crossing par over read views", seeds: 20, "[1.0, 4.0]"
  # Review of phase 1: a read view of an object is lent as it is, as
  # sema lends any read view (the runtime lent its address, which Zig
  # rejected).
  use std.par

  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  a = Square(side: 1.0)
  b = Square(side: 2.0)
  xs: List[?{Shape + Syncs}] = List()
  !xs.push(?a)
  !xs.push(?b)
  print(par.map(?xs, |s| s.area()))

fail "apis object crossing a generic body erases its parameter's instance without the API's Eq", "`go[*fun() -> Int]` cannot use `U = *fun() -> Int`: the generic body erases a value that holds a `U` to `^{Shape}`, whose braces or API name `Eq`", errors: 1
  # The table's `same` compares a `Wrap[U]`, which Zig rejected for an
  # owned closure.
  api Shape: Eq
    fun area(?@) -> Float

    fun same(?@) -> Bool
      @ == @

  obj Wrap[U]: Shape
    u: U

    fun area(?@) -> Float
      1.0

  fun go[U](u: U) -> ^{Shape}
    ^Wrap[U](u: <u)

  b = go(*|| 1)
  print(b.same())

fail "apis object crossing a held object names the bound it lacks", "`+h` is given to a task: `*H` holds `{Shape + Sends}`, an API object whose braces and API name no `Syncs`, so no two tasks may read what it hides", "`<p` is given to a task: `Pair` holds `{Shape + Syncs}`, an API object whose braces and API name no `Sends`, so what it hides may not go to another task", errors: 2
  # Review of phase 1: what a `*H` leads to is read by the tasks that
  # share it, so its object needs `Syncs`; a value given needs `Sends`.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj H
    s: ^{Shape + Sends}

  obj Pair
    s: ^{Shape + Syncs}

  fun f(h: *H) -> Float
    h.s.area()

  fun g(p: Pair) -> Float
    p.s.area()

  h = *H(s: ^Square(side: 1.0))
  p = Pair(s: ^Square(side: 2.0))
  t = f(+h)&
  u = g(<p)&
  print(>t, >u)

fail "apis object crossing a value erased at the task's call crosses by the parameter's braces", "`^Sum(n: 3)` is given to a task, and `^{Job}` hides its value's type without naming `Sends`: write `^{Job + Sends}`", "`<j` is given to a task, and `^{Job}` hides its value's type without naming `Sends`: write `^{Job + Sends}`", "`?s` is lent to a task to read, and `?{Job}` hides its value's type without naming `Syncs`: write `?{Job + Syncs}`", "an actor runs its methods on a task of its own, and `?s` is lent to it to read: `?{Job}` hides its value's type without naming `Syncs`: write `?{Job + Syncs}`", errors: 4
  # The designer's answer to the review of phase 1: an argument erased
  # into an object parameter crosses by the parameter's braces, as one
  # erased before the call does, whatever its known type.
  api Job
    fun run(?@) -> Int

  obj Sum: Job
    n: Int

    fun run(?@) -> Int
      @n

  obj Acc
    n: Int

    sub add(!@, j: ?{Job})
      @n += j.run()

  fun work(j: ^{Job}) -> Int
    j.run()

  fun look(j: ?{Job}) -> Int
    j.run()

  t = work(^Sum(n: 3))&
  j: ^{Job} = ^Sum(n: 4)
  u = work(<j)&
  s = Sum(n: 5)
  v = look(?s)&
  a = *Actor(Acc(n: 0))
  !a.add(?s)
  print(>t, >u, >v)

test "apis object crossing a value erased at the task's call with the bound", seeds: 20, "3 4 5 5"
  # The same calls with the bound in the parameters' braces.
  api Job
    fun run(?@) -> Int

  obj Sum: Job
    n: Int

    fun run(?@) -> Int
      @n

  obj Acc
    n: Int

    sub add(!@, j: ?{Job + Syncs})
      @n += j.run()

    fun get(?@) -> Int
      @n

  fun work(j: ^{Job + Sends}) -> Int
    j.run()

  fun look(j: ?{Job + Syncs}) -> Int
    j.run()

  t = work(^Sum(n: 3))&
  j: ^{Job + Sends} = ^Sum(n: 4)
  u = work(<j)&
  s = Sum(n: 5)
  v = look(?s)&
  a = *Actor(Acc(n: 0))
  !a.add(?s)
  print(>t, >u, >v, a.get())
