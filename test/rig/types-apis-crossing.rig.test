  g = *Grid(hits: Cell(0))
  print(area_of(?g))

fail "apis object crossing an owned closure hidden", "`Holder` is erased to `^{Shape + Sends}`, which goes to other tasks, but its field `f` is a `*fun() -> Float`, an owned closure, whose captures its type does not show", errors: 1
