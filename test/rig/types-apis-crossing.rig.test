test "apis object crossing a shared object", seeds: 20, "4.0 true"
  # A `*{Shape + Syncs}` goes to another task; a `~{Shape}` stays.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun f(s: *{Shape + Syncs}) -> Float
    s.area()

  fun alive(w: ?~{Shape}) -> Bool
    if *w as h
      return true
    false

  s: *{Shape + Syncs} = *Frozen(Square(side: 2.0))
  p: *{Shape} = *Square(side: 1.0)
  w = ~p
  t = f(+s)&
  print(>t, alive(?w))

fail "apis object crossing an owned closure holds no task", "an owned closure holds no task: `t` is a `Task[Int]`, which only the scope that waits for it may hold; wait for it first and capture its value", "an owned closure holds no task: `ts` is a `Tasks[Int]`", errors: 2
  # Reviewer's fix 1: a task hidden in an owned closure would leave
  # `task.isolate`, or hide in an API object, where no rule waits for it.
  use std.task

  fun sq(n: Int) -> Int
    n * n

  t = sq(2)&
  f: *fun() -> Int = *|<t| 7
  ts = Tasks[Int]()
  g: *fun() -> Int = *|<ts| 8
  print(f(), g())

