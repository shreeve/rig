# types: tests whose names start `apis object crossing`: an API object
# crosses tasks by a bound in its braces or its API (docs/design/apis.md,
# Stage 5).

test "apis object crossing a sending box given to a task", seeds: 20, "6"
  # Core §4's example: `Sends` in the braces is checked on `Sum` where
  # it is erased, and the box then goes to another task.
  api Job
    fun run(?@) -> Int

  obj Sum: Job
    xs: List[Int]

    fun run(?@) -> Int
      n = 0
      for x in @xs
        n += x
      n

  fun work(j: ^{Job + Sends}) -> Int
    j.run()

  j: ^{Job + Sends} = ^Sum(xs: List([1, 2, 3]))
  t = work(<j)&
  print(>t)

test "apis object crossing a syncing box lent to two tasks", seeds: 20, "8.0 8.0"
  # A box whose value syncs is read by several tasks at once, lent as the
  # box or as the read view it lends.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun total(b: ?^{Shape + Syncs}) -> Float
    b.area() * 2.0

  fun area_of(s: ?{Shape + Syncs}) -> Float
    s.area() * 2.0

  b: ^{Shape + Syncs} = ^Square(side: 2.0)
  t = total(?b)&
  u = area_of(?b)&
  print(>t, >u)

test "apis object crossing a syncing read view lent to a task", seeds: 20, "4.0 9.0"
  # A read view whose value syncs goes to another task, erased where it
  # is lent or lent on from a view of its own.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun area_of(s: ?{Shape + Syncs}) -> Float
    s.area()

  fun later(s: ?{Shape + Syncs}) -> Float
    t = area_of(?s)&
    >t

  sq = Square(side: 2.0)
  t = area_of(?sq)&
  print(>t, later(?Square(side: 3.0)))

test "apis object crossing a sending write view lent to a task", seeds: 20, "9.0"
  # A write view whose value sends goes to one task, to write.
  api Shape
    fun area(?@) -> Float
    sub grow(!@)

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

    sub grow(!@)
      @side += 1.0

  sub grow_it(s: !{Shape + Sends})
    !s.grow()

  b: ^{Shape + Sends} = ^Square(side: 2.0)
  t = grow_it(!b)&
  >t
  print(b.area())

test "apis object crossing by the API's bound", seeds: 20, "6 2"
  # `api Job: Sends` gives `Sends` to every object of it: Stage 3 checks
  # it of each type that provides `Job`, and the erasure checks it again.
  api Job: Sends
    fun run(?@) -> Int

  obj Sum: Job
    xs: List[Int]

    fun run(?@) -> Int
      n = 0
      for x in @xs
        n += x
      n

  fun work(j: ^{Job}) -> Int
    j.run()

  j: ^{Job} = ^Sum(xs: List([1, 2, 3]))
  k: ^{Job} = ^Sum(xs: List([2]))
  t = work(<j)&
  u = work(<k)&
  print(>t, >u)

test "apis object crossing a call through the object as a task", seeds: 20, "4.0 4.0 6"
  # A call through an object is a task when its self goes to one: lent
  # to read with `Syncs`, given with `Sends`.
  api Shape
    fun area(?@) -> Float

  api Job
    fun run(<@) -> Int

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Sum: Job
    xs: List[Int]

    fun run(<@) -> Int
      n = 0
      for x in @xs
        n += x
      n

  b: ^{Shape + Syncs} = ^Square(side: 2.0)
  t = ?b.area()&
  u = ?b.area()&
  j: ^{Job + Sends} = ^Sum(xs: List([1, 2, 3]))
  w = (<j).run()&
  print(>t, >u, >w)

test "apis object crossing a channel of boxes", seeds: 20, "60 3"
  # A channel's element sends and holds no loan: `api Job: Sends +
  # Owned` gives both to every `^{Job}`.
  use std.task

  api Job: Sends + Owned
    fun run(?@) -> Int

  obj Times: Job
    n: Int

    fun run(?@) -> Int
      @n * 10

  type J = ^{Job}

  sub produce(ch: *Chan[J])!
    for i in 1..4
      b: J = ^Times(n: i)
      !ch.send(<b)!
    !ch.close()

  fun consume(ch: *Chan[J]) -> Int!
    sum = 0
    while (!ch).recv()! as j
      sum += j.run()
    sum

  ch = *Chan[J](1)
  p = produce(+ch)&
  c = consume(+ch)&
  >p!
  print(>c!, 3)

test "apis object crossing an actor's state of boxes", seeds: 20, "3 60"
  # An actor's state holds boxes that send and hold no loan, and its
  # method takes one from other tasks.
  api Job
    fun run(?@) -> Int

  obj Times: Job
    n: Int

    fun run(?@) -> Int
      @n * 10

  obj Queue
    jobs: List[^{Job + Sends + Owned}]

    sub add(!@, j: ^{Job + Sends + Owned})
      !@jobs.push(<j)

    fun total(?@) -> Int
      n = 0
      for j in ?@jobs
        n += j.run()
      n

    fun count(?@) -> Int
      @jobs.len

  sub feed(q: *Actor[Queue], n: Int)
    b: ^{Job + Sends + Owned} = ^Times(n: n)
    !q.add(<b)

  q = *Actor(Queue(jobs: List()))
  ts = Tasks[Void]()
  for i in 1..4
    !ts.add(feed(+q, i)&)
  >ts
  print(q.count(), q.total())

test "apis object crossing par over boxes", seeds: 20, '''
  [1.0, 4.0, 9.0]
  3 [4.0, 9.0, 16.0]
'''
  # `par.map` reads each box from tasks on other cores, which its value
  # syncing allows; `par.each` lends each one to write, which its value
  # sending allows.
  use std.par

  api Shape
    fun area(?@) -> Float
    sub grow(!@)

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

    sub grow(!@)
      @side += 1.0

  xs: List[^{Shape + Syncs}] = List()
  ys: List[^{Shape + Sends}] = List()
  for i in 1..4
    !xs.push(^Square(side: Float(i)))
    !ys.push(^Square(side: Float(i)))
  print(par.map(?xs, |s| s.area()))
  par.each(!ys, |s| !s.grow())
  print(par.map(?xs, |s| s.area()).len, [ys[0].area(), ys[1].area(), ys[2].area()])

test "apis object crossing a generic erasure by its bound", seeds: 20, "6"
  # A `T` erases to `^{Job + Sends}` under `[T: Job + Sends]`; each
  # instance meets the bound.
  api Job
    fun run(?@) -> Int

  obj Sum: Job
    xs: List[Int]

    fun run(?@) -> Int
      n = 0
      for x in @xs
        n += x
      n

  fun boxed[T: Job + Sends](x: ^T) -> ^{Job + Sends}
    <x

  fun work(j: ^{Job + Sends}) -> Int
    j.run()

  j = boxed(^Sum(xs: List([1, 2, 3])))
  t = work(<j)&
  print(>t)

test "apis object crossing isolate gives a box", "4.0"
  # `task.isolate` gives its value back on the task that called it, so
  # a box needs no crossing bound to leave it. (`Owned`: the reference
  # checker reads a box an isolate gives as holding a loan of the
  # closure written in the call, which lives only for its statement.)
  use std.task

  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  fun mk() -> ^{Shape + Owned}
    ^Square(side: 2.0)

  b = task.isolate(|| mk()) catch return
  print(b.area())

test "apis object crossing a field and an optional", seeds: 20, "4.0 9.0"
  # An object a value holds crosses as the object does, at any depth.
  api Shape
    fun area(?@) -> Float

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

  obj Holder
    s: ^{Shape + Sends + Syncs}

  fun val(h: ?Holder) -> Float
    h.s.area()

  fun maybe(o: ^{Shape + Sends}?) -> Float
    if o as s
      return s.area()
    0.0

  h = Holder(s: ^Square(side: 2.0))
  t = val(?h)&
  o: ^{Shape + Sends}? = ^Square(side: 3.0)
  u = maybe(<o)&
  print(>t, >u)

test "apis object crossing the bounds in its name", "^{Shape + Sends + Syncs} ^{Shape + Owned + Sends} 1.0 1.0 2.0"
  # The braces are part of the type's name, in one order. A view names
  # only the bound its form uses, so a box of both lends `?{Shape +
  # Syncs}` and `!{Shape + Sends}`, and a write view lends `?{Shape}`.
  api Shape
    fun area(?@) -> Float
    sub grow(!@)

  obj Square: Shape
    side: Float

    fun area(?@) -> Float
      @side * @side

    sub grow(!@)
      @side += 1.0

  fun name_of[T](x: ?T) -> String
    String($name(T))

  fun read(s: ?{Shape + Syncs}) -> Float
    s.area()

  fun plain(s: ?{Shape}) -> Float
    s.area()

  fun write(s: !{Shape + Sends}) -> Float
    plain(?s)

  b: ^{Shape + Syncs + Sends} = ^Square(side: 1.0)
  c: ^{Shape + Sends + Owned} = ^Square(side: 1.0)
  x = read(?b)
  y = write(!b)
  !b.grow()
  print(name_of(?b), name_of(?c), x, y, read(?b) / 2.0)

