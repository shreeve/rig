# ownership: `+x` of a type declared in another module, and of the
# built-in Map and Set, which clone part by part (Core sentence 2).

test "another module's object clones part by part", "a ab 1"
  use lib

  sub main()
    a = lib.Box2(name: String("a"))
    !a.tags.push(String("t"))
    b = +a
    !b.name.push("b")
    print(a.name, b.name, b.tags.len)

  file "lib.rig"
    pub obj Box2
      pub name: String
      pub tags: List[String] = List()

test "another module's generic and recursive types clone", '''
  w
  1 2
'''
  use lib

  sub main()
    w = lib.Wrap[String](item: String("w"))
    w2 = +w
    print(w2.item)
    n = lib.Node(n: 1, next: ^lib.Node(n: 2, next: none))
    n2 = +n
    if n2.next as nx
      print(n2.n, nx.n)

  file "lib.rig"
    pub obj Wrap[T]
      pub item: T

    pub obj Node
      pub n: Int
      pub next: ^Node?

test "a Map and a Set clone, and the clones are their own", '''
  1 2
  1 2
  2
'''
  m: Map[String, Int] = Map()
  !m.put(String("x"), 1)
  m2 = +m
  !m2.put(String("y"), 2)
  print(m.len, m2.len)
  s: Set[String] = Set()
  !s.add(String("k"))
  s2 = +s
  !s2.add(String("j"))
  print(s.len, s2.len)
  mm: Map[Int, Map[String, Int]] = Map()
  !mm.put(1, +m)
  !mm.put(2, +m2)
  mm2 = +mm
  print(mm2.len)

test "a type parameter bounded by Clone clones", '''
  ab ab o 2 Wrap(v: "w", n: 1)
  ab abc 3 [5]
'''
  # `+x` of a `T`, a `?T`, and a `T?` in a generic body, and a `|+x|`
  # capture, clone as each instance clones: a new owner, which the
  # original outlives.
  obj Wrap[T]
    v: T
    n: Int

  fun dup[T: Clone](x: ?T) -> T
    +x

  fun opt[T: Clone](x: ?T?) -> T?
    +x

  fun own[T: Clone](x: T) -> T
    y = +x
    <x
    y

  fun cap[T: Clone](x: ?T) -> T
    f = |+x| +x
    f()

  fun loose[T](x: ?T) -> T
    +x

  s = String("ab")
  o: String? = String("o")
  w = Wrap(v: String("w"), n: 1)
  t = dup(?s)
  !t.add("c")
  xs = List[Int]()
  !xs.push(5)
  print(dup(?s), cap(?s), opt(?o), own(2), loose(?w))
  print(s, t, loose(?3), dup(?xs))

fail "a type parameter clones only where its instance clones", "`dup[Res]` cannot use `T = Res`: `Res` cannot be cloned", "`loose[Res]` cannot use `T = Res`: the generic body clones a value that holds a `T`, and `Res` is not `Clone`", "`capl[Once]` cannot use `T = Once`: the generic body clones into a closure a value that holds a `T`, and `Once` is not `Clone`", "`T` is bounded by `Ord`, which does not give a value that clones; add `Clone` to its bounds: `[T: Clone + Ord]`", errors: 4
  obj Res
    n: Int

    drop(!@)
      print("drop")

  obj Once unique
    n: Int

  fun dup[T: Clone](x: ?T) -> T
    +x

  fun loose[T](x: ?T) -> T
    +x

  fun capl[T](x: ?T) -> Int
    f = |+x| 1
    f()

  fun ord[T: Ord](x: ?T) -> T
    +x

  r = Res(n: 1)
  o = Once(n: 2)
  print(dup(?r).n, loose(?r).n, capl(?o))

fail "another module's type with a drop body has no clone", "`+x` cannot clone a `lib.Res`: a value with a `drop` body, or holding a Signal or a write view, has no clone; move it with `<x`, or lend it"
  use lib

  sub main()
    r = lib.Res(id: 1)
    r2 = +r
    print(r2.id)

  file "lib.rig"
    pub obj Res
      pub id: Int
      drop(!@)
        print("drop", @id)

fail "another module's unique type has no clone", "`+x` cannot clone a `lib.Once`: it is unique, and a copy would duplicate it; move it with `<x`"
  use lib

  sub main()
    o = lib.Once(n: 1)
    o2 = +o
    print(o2.n)

  file "lib.rig"
    pub obj Once unique
      pub n: Int

fail "a Map of values with no clone has no clone", "has no clone"
  use lib

  sub main()
    m: Map[Int, lib.Res] = Map()
    m2 = +m
    print(m2.len)

  file "lib.rig"
    pub obj Res
      pub id: Int
      drop(!@)
        print("drop", @id)

fail "a Map of Maps of values with no clone has no clone", "has no clone"
  # The inner Map is the same generic reached again: its arguments are
  # checked too.
  obj Res
    id: Int
    drop(!@)
      print("drop", @id)

  m: Map[Int, Map[Int, Res]] = Map()
  m2 = +m
  print(m2.len)

fail "a clone into a read view", "16:8: lend `v` instead: a clone into a read view is only read, then dropped", "21:6: lend `?w` instead: a clone into a read view is only read, then dropped", "22:7: lend `?s` instead: a clone into a read view is only read, then dropped", "24:8: call the method on `b` instead: a clone into a read self is only read, then dropped", "25:12: lend `?w` instead: a clone into a read view is only read, then dropped", errors: 5
  # A clone into a read view is made only to be read and dropped: the
  # call lends the original.
  obj B
    v: List[Int]

    fun total(?@) -> Int
      @v.len

  sub peek(v: ?List[Int])
    print(v.len)

  sub peekt(t: ?String)
    print(t.len)

  sub again(v: ?List[Int])
    peek(+v)

  w = List[Int]()
  s = String("hi")
  b = B(v: List[Int]())
  peek(+w)
  peekt(+s)
  again(?w)
  print((+b).total())
  defer peek(+w)

test "a clone into a read view kept apart", '''
  2 2
  [1, 1]
'''
  # Where the same call lends the original to write or moves it, the
  # clone keeps the two views apart.
  obj B
    v: List[Int]

    sub merge(!@, o: ?B)
      !@v.push(o.v.len)

  sub g(a: ?List[Int], b: !List[Int])
    !b.push(a.len)

  w = List[Int]()
  !w.push(1)
  g(+w, !w)
  b = B(v: List[Int]())
  !b.v.push(1)
  !b.merge(+b)
  print(b.v.len, w.len)
  print(w)

fail "a generic of itself over a value with no clone has no clone", "has no clone"
  obj Res
    id: Int
    drop(!@)
      print("drop", @id)

  obj Wrap[T]
    item: T

  w = Wrap[Wrap[Res]](item: Wrap[Res](item: Res(id: 1)))
  w2 = +w
  print(w2.item.item.id)

test "a recursive generic still clones", "1 2"
  obj Node[T]
    v: T
    next: ^Node[T]?

  n = Node[String](v: String("1"), next: ^Node[String](v: String("2"), next: none))
  n2 = +n
  if n2.next as nx
    print(n2.v, nx.v)

test "objects nested by value deeper than inlining compare, hash, and clone", "true true true 11", release: true
  # Past eight levels `==`, `.hash()`, and `+` reach a nested object
  # through a call of its own (`rig.outOfLine`), so a long chain builds in
  # time linear in its length; the values are the same either way.
  obj O0
    v: Int
    s: String

  obj O1
    inner: O0
    v: Int

  obj O2
    inner: O1
    v: Int

  obj O3
    inner: O2
    v: Int

  obj O4
    inner: O3
    v: Int

  obj O5
    inner: O4
    v: Int

  obj O6
    inner: O5
    v: Int

  obj O7
    inner: O6
    v: Int

  obj O8
    inner: O7
    v: Int

  obj O9
    inner: O8
    v: Int

  obj O10
    inner: O9
    v: Int

  obj O11
    inner: O10
    v: Int

  fun make0() -> O0
    O0(v: 0, s: String("x"))

  fun make1() -> O1
    O1(inner: make0(), v: 1)

  fun make2() -> O2
    O2(inner: make1(), v: 2)

  fun make3() -> O3
    O3(inner: make2(), v: 3)

  fun make4() -> O4
    O4(inner: make3(), v: 4)

  fun make5() -> O5
    O5(inner: make4(), v: 5)

  fun make6() -> O6
    O6(inner: make5(), v: 6)

  fun make7() -> O7
    O7(inner: make6(), v: 7)

  fun make8() -> O8
    O8(inner: make7(), v: 8)

  fun make9() -> O9
    O9(inner: make8(), v: 9)

  fun make10() -> O10
    O10(inner: make9(), v: 10)

  fun make11() -> O11
    O11(inner: make10(), v: 11)

  a = make11()
  b = +a
  c = make11()
  !c.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.s.push("y")
  print(a == b, a.hash() == b.hash(), a != c, b.v)
