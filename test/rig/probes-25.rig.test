  sub f(a: !E, b: !E, k: Int)
    x = match k
      0 => a
      _ => b
    match x
      .a(r0)
        s = ?r0.v[..]
        match !a
          .a(r)
            for i in 0..100
              !r.v.push(i)
          .b => pass
        print(s[0])
      .b => pass

  e = mk(1)
  d = mk(2)
  f(!e, !d, 0)

test "review-payload-loan-5-a11 propagate call ok", ".a(r: Res(n: 1, v: [1, 0, 1, 2]))"
  obj Res
    n: Int
    v: List[Int]

  enum E
    a(r: Res)
    b

  error Bad
    nope

  fun mk(n: Int) -> E
    v: List[Int] = List()
    !v.push(n)
    E.a(r: Res(n: n, v: <v))

  fun getw(e: !E) -> !E
    e

  fun tryw(e: !E, ok: Bool) -> (!E)!
    return Bad.nope if not ok
    e

  fun optw(e: !E, ok: Bool) -> (!E)?
    return none if not ok
    e

  fun id[T](x: T) -> T
    x

  fun f(x: !E) -> Int!
    match tryw(!x, true)!
      .a(r)
        for i in 0..3
          !r.v.push(i)
      .b => pass
    1

  e = mk(1)
  _ = f(!e) catch |_| 0
  print(e)

