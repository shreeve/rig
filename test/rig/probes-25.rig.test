fail "review-payload-loan-5-a06b closure returns capture bare", "`e` is a write view the closure captures, and a return value would hand it out of the closure at each call, though a write view has one holder; use it inside the closure instead"
  obj Res
    n: Int
    v: List[Int]

  enum E
    a(r: Res)
    b

  error Bad
    nope

  fun mk(n: Int) -> E
    v: List[Int] = List()
    !v.push(n)
    E.a(r: Res(n: n, v: <v))

  fun getw(e: !E) -> !E
    e

  fun tryw(e: !E, ok: Bool) -> (!E)!
    return Bad.nope if not ok
    e

  fun optw(e: !E, ok: Bool) -> (!E)?
    return none if not ok
    e

  fun id[T](x: T) -> T
    x

  e = mk(1)
  f = |!e| e
  match f()
    .a(r0)
      s = ?r0.v[..]
      match f()
        .a(r)
          for i in 0..100
            !r.v.push(i)
        .b => pass
      print(s[0])
    .b => pass

