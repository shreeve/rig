test "review-payload-loan-4-i08 generic read match capture", "1"
  enum G[T]
    a(x: T)
    b

  fun peek[T](g: ?G[T]) -> Int
    match g
      .a(x)
        f = |?x| 1
        f()
      .b => 0

  g2: G[Int] = G.a(4)
  print(peek(?g2))

test "review-payload-loan-4-i09 generic walk capture", "1"
  fun walk[T](v: ?List[T]) -> Int
    c = 0
    for x in v
      f = |?x| 1
      c += f()
    c

  w: List[Int] = List()
  !w.push(1)
  print(walk(?w))

