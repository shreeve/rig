test "review-payload-loan-4-g02 call int payload guard", ".a(n: 5) .a(n: 14)"
  enum F
    a(n: Int)
    b

  fun getf(f: !F) -> !F
    f

  f = F.a(5)
  d = F.a(7)
  c = false
  match (!f if c else !d)
    .a(n) if n > 6
      n = n * 2
    .a(n)
      n = 0
    .b => pass
  print(f, d)

