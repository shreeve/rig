fail "review-payload-loan-5-a08 loop value bare param", "bare use of write view `a` in `break` value would copy a write view, which is unique; use `<a` to move it"
  obj Res
    n: Int
    v: List[Int]

  enum E
    a(r: Res)
    b

  error Bad
    nope

  fun mk(n: Int) -> E
    v: List[Int] = List()
    !v.push(n)
    E.a(r: Res(n: n, v: <v))

  fun getw(e: !E) -> !E
    e

  fun tryw(e: !E, ok: Bool) -> (!E)!
    return Bad.nope if not ok
    e

  fun optw(e: !E, ok: Bool) -> (!E)?
    return none if not ok
    e

  fun id[T](x: T) -> T
    x

  sub f(a: !E)
    x = while true
      break a
    match x
      .a(r0)
        s = ?r0.v[..]
        match !a
          .a(r)
            for i in 0..100
              !r.v.push(i)
          .b => pass
        print(s[0])
      .b => pass

  e = mk(1)
  f(!e)

