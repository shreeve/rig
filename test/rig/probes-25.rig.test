fail "review-payload-loan-5-g03 while as writeview local lend", "bare use of write view `p` in binding would copy a write view, which is unique; use `<p` to move it"
  obj Res
    n: Int
    v: List[Int]

  enum E
    a(r: Res)
    b

  error Bad
    nope

  fun mk(n: Int) -> E
    v: List[Int] = List()
    !v.push(n)
    E.a(r: Res(n: n, v: <v))

  fun getw(e: !E) -> !E
    e

  fun tryw(e: !E, ok: Bool) -> (!E)!
    return Bad.nope if not ok
    e

  fun optw(e: !E, ok: Bool) -> (!E)?
    return none if not ok
    e

  fun id[T](x: T) -> T
    x

  fun f(e: !E) -> Int?
    o: (!E)? = !e
    p = !o
    while p as x
      match x
        .a(r0)
          s = ?r0.v[..]
          if !o as y
            match !y
              .a(r)
                for i in 0..100
                  !r.v.push(i)
              .b => pass
          print(s[0])
        .b => pass
      break
    1

  e = mk(1)
  _ = f(!e)

