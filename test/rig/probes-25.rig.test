test "review-payload-loan-4-e10 catch legit", '''
  .a(r: Res(n: 1, v: [1])) .a(r: Res(n: 2, v: [2, 42]))
  .a(r: Res(n: 1, v: [1, 43])) .a(r: Res(n: 2, v: [2, 42]))
'''
  obj Res
    n: Int
    v: List[Int]

  enum E
    a(r: Res)
    b

  error Bad
    nope

  fun mk(n: Int) -> E
    v: List[Int] = List()
    !v.push(n)
    E.a(r: Res(n: n, v: <v))

  fun getw(e: !E) -> !E
    e

  fun tryw(e: !E, ok: Bool) -> (!E)!
    return Bad.nope if not ok
    e

  fun optw(e: !E, ok: Bool) -> (!E)?
    return none if not ok
    e

  e = mk(1)
  d = mk(2)
  match tryw(!e, false) catch !d
    .a(r)
      !r.v.push(42)
    .b => pass
  print(e, d)
  match tryw(!e, true) catch !d
    .a(r)
      !r.v.push(43)
    .b => pass
  print(e, d)

