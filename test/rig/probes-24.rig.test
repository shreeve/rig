fail "review-never-data-1-h09 shared from branch", "`a.s` owns an `S`, which can't be copied into a counted handle, has no clone, and can't be moved out of its parent"
  obj S
    c: Cell[List[Int]]

  obj O
    s: S

  a = *O(s: S(c: Cell(List())))
  b = *O(s: S(c: Cell(List())))
  k = a.s.c.len == 0
  !a.s.c.push(1)
  n = *(a.s if k else b.s)
  !n.c.push(2)
  print(a.s.c.len, n.c.len)

