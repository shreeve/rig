  a: H? = H(v: List())
  b = H(v: List())
  !b.v.push(String("b"))
  r = (a ?? b).first()
  <b
  print(r)

test "review-never-data-1-k02 handle ptr siblings", '''
  5
  1 4
  5 8
  8 11
  7 3
'''
  obj Q
    n: Int

    fun get(?@, j: Int, k: Int) -> Int
      @n + j + k

  obj W
    h: *Q

  fun g(k: Int) -> Int
    k

  qs: List[*Q] = List()
  !qs.push(*Q(n: 1))
  !qs.push(*Q(n: 2))
  print(qs[g(1)].get(k: g(1), j: g(2)))
  print(?qs[g(0)].n, (?qs[0]).get(k: g(1), j: g(2)))
  w1 = W(h: *Q(n: 5))
  w2 = W(h: *Q(n: 6))
  c = g(1) == 1
  print((?w1 if c else ?w2).h.n, (?w1 if c else ?w2).h.get(k: g(1), j: g(2)))
  h1 = *Q(n: 8)
  h2 = *Q(n: 9)
  x = (?h1 if c else ?h2)
  print(x.n, x.get(k: g(1), j: g(2)))
  arr = [*Q(n: 3), *Q(n: 4)]
  print(arr[g(1)].get(k: g(1), j: g(2)), (?arr[0] if c else ?arr[1]).n)

test "review-never-data-1-k03 view loop siblings", '''
  3 pp
  4 qq
  3
  qq
  0 3
  1 4
  3 pp
  4
  pp
  qq
  1 5
'''
  obj P
    n: Int
    t: String

  enum E
    a(p: ?P)
    b

  p = P(n: 3, t: String("pp"))
  q = P(n: 4, t: String("qq"))
  rv: List[?P] = List()
  !rv.push(?p)
  !rv.push(?q)
  for x in ?rv
    print(x.n, x.t)
  for x in ?rv[0..1]
    print(x.n)
  for x in ?rv[1..2]
    print(x.t)
  for x, i in rv
    print(i, x.n)
  e = E.a(?p)
  match e
    .a(r) => print(r.n, r.t)
    .b => print(0)
  o: (?P)? = ?q
  if o as r
    print(r.n)
  arr = [?p, ?q]
  for x in arr
    print(x.t)
  vv: List[?List[Int]] = List()
  ints: List[Int] = List()
  !ints.push(5)
  !vv.push(?ints)
  for x in vv
    print(x.len, x[0])

test "review-never-data-1-k04 closure capture wv", '''
  3
  2
  2 ab
  2
'''
  obj P
    n: Int
    t: String

  sub viaw(w: !P)
    f = |?w| w.n + w.t.len
    print(f())
    g = |!w| w.n += 1
    g()

  sub gen[T](w: !T, f: sub(?T))
    h = |?w, ?f| f(w)
    h()

  sub show(p: ?P)
    print(p.n, p.t)

  p = P(n: 1, t: String("ab"))
  viaw(!p)
  w = !p
  k = |?w| w.n
  print(k())
  gen(!p, show)
  print(p.n)

fail "review-never-data-1-k07 generic capture wv local", "bare use of write view `v` in binding would copy a write view, which is unique; use `<v` to move it"
  obj P
    n: Int
    t: String

  sub gen[T](v: !T, f: sub(?T))
    w = v
    h = |?w, ?f| f(w)
    h()

  sub show(p: ?P)
    print(p.n, p.t)

  p = P(n: 1, t: String("ab"))
  gen(!p, show)

test "review-never-data-1-k08 nongeneric capture wv pass", "1 ab"
  obj P
    n: Int
    t: String

  sub show(p: ?P)
    print(p.n, p.t)

  sub viaw(w: !P)
    h = |?w| show(w)
    h()

  p = P(n: 1, t: String("ab"))
  viaw(!p)

test "review-never-data-1-l01 generic nested cell", "6"
  obj In[T]
    c: Cell[T]

    sub put(!@, x: T)
      !@c.set(x)

  obj W[T]
    i: In[T]
    n: Int

    sub put2(!@, x: T)
      !@i.put(x)

  sub bump[T](w: !W[T], x: T)
    !w.i.c.set(x)
    !w.i.put(x)
    !w.put2(x)
    r = !w.i
    !r.put(x)

  w = *W(i: In(c: Cell(1)), n: 0)
  bump(!w, 5)
  bump(!w, 6)
  print(w.i.c.get())

test "review-never-data-1-l02 generic enum cell", "8"
  enum E[T]
    a(c: Cell[T])
    b

  sub f[T](e: !E[T], x: T)
    match !e
      .a(c) => !c.set(x)
      .b => pass

  e = *E.a(c: Cell(1))
  f(!e, 7)
  f(!e, 8)
  match e
    .a(c) => print(c.get())
    .b => print(0)

test "review-never-data-1-l04 generic vec cellvec", "80"
  obj W[T]
    c: Cell[List[T]]

    sub add(!@, x: T)
      !@c.push(x)

  sub fill[T](w: !W[T], x: T, n: Int)
    for _ in 0..n
      !w.add(x)
      !w.c.push(x)

  v: List[Int] = List()
  w = *W(c: Cell(<v))
  fill(!w, 3, 40)
  print(w.c.len)

test "review-never-data-1-n03", "3 1 5"
  use lib

  sub bump(c: !lib.Counter)
    !c.hit()

  sub main()
    k = lib.mk()
    !k.hit()
    bump(!k)
    bump(!k)
    j = *lib.Counter()
    !j.hit()
    c = *lib.Counter(hits: Cell(4))
    !c.hit()
    print(k.hits.get(), j.hits.get(), c.hits.get())

  file "lib.rig"
    pub obj Counter
      pub hits: Cell[Int] = Cell(0)

      pub sub hit(!@)
        !@hits.set(@hits.get() + 1)

    pub type C = Cell[Int]

    pub obj Wrap[T]
      pub v: T

    pub fun mk() -> *Counter
      *Counter()

test "review-never-data-1-o02 result branch wv", "1 12 1 0"
  fun pick(a: !Int, b: !Int, c: Bool) -> !Int
    a if c else b

  fun pickv(a: !List[Int], b: !List[Int], c: Bool) -> !List[Int]
    return a if c else b

  x = 1
  y = 2
  w = pick(!x, !y, false)
  w += 10
  u: List[Int] = List()
  v: List[Int] = List()
  pickv(!u, !v, true).push(3)
  print(x, y, u.len, v.len)

fail "review-payload-loan-1-p03 generic payload", "cannot reassign `v` while it is lent"
  enum Opt[T]
    some(v: T)
    nothing

  sub f[T](o: !Opt[T], x: T)
    match !o
      .some(v)
        s = ?v
        v = <x
        print(s)
      .nothing => pass

  o = Opt.some(String("hello"))
  f(!o, String("other"))

fail "review-payload-loan-1-p05 nested in for", "cannot lend `t` to write while a read loan is live"
  enum E
    a(t: String)
    b

  v: List[E] = List()
  !v.push(E.a(String("hello")))
  for x in !v
    match !x
      .a(t)
        s = ?t[1..]
        for _ in 0..50
          !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
        print(s)
      .b => pass

fail "review-payload-loan-1-p06 in closure", "cannot lend `t` to write while a read loan is live"
  enum E
    a(t: String)
    b

  e = E.a(String("hello"))
  f = |!e|
    match !e
      .a(t)
        s = ?t[1..]
        for _ in 0..50
          !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
        print(s)
      .b => print("b")
  f()

