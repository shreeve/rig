test "review-never-data-1-i01 generic readT infer", '''
  1
  1
  0
'''
  obj Counter
    hits: Cell[Int] = Cell(0)

    sub hit(!@)
      !@hits.set(@hits.get() + 1)

  sub poke[T](x: ?T)
    print(1)

  k = *Counter()
  poke(?k)
  poke(k)
  print(k.hits.get())

fail "review-never-data-1-j01 branch receiver view result", "`i` is bound but never read; name it `_` to ignore the value"
  obj H
    v: List[String]

    fun first(?@) -> ?String
      ?@v[0]

  a = H(v: List())
  b = H(v: List())
  !a.v.push(String("a"))
  !b.v.push(String("b"))
  c = a.v.len > 0
  r = (a if c else b).first()
  for i in 0..100
    !a.v.push(String("z"))
  print(r)

fail "review-never-data-1-j02 branch receiver drop", "cannot drop `a` while it is lent"
