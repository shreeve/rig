    E.a(r: Res(n: n, v: <v))

  fun getw(e: !E) -> !E
    e

  fun tryw(e: !E, ok: Bool) -> (!E)!
    return Bad.nope if not ok
    e

  fun optw(e: !E, ok: Bool) -> (!E)?
    return none if not ok
    e

  e = mk(1)
  d = mk(2)
  c = true
  match (!e if c else !d)
    .a(r)
      match !e
        .a(r2) => r2.n = 3
        .b => pass
      r.n = 4
    .b => pass
