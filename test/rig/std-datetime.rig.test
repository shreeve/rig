# std.datetime: `Weekday` and `Date`: making one, its readers, the
# calendar sums and counts, the helpers, ISO weeks, the ends of the
# range, `==`, `<`, and hashing, and text. Cases marked with a Jiff file
# are ported from Jiff 1.0.0's tests (MIT); the rest are the design's
# (docs/design/datetime.md §12).

use std.datetime
use std.text

test "weekday names, numbers, and order", '''
  Monday 1 Sunday 7
  true true false
  7 2
'''
  # Ordered from Monday (§9 item 11), numbered as ISO 8601 numbers them.
  m = datetime.Weekday.monday
  s = datetime.Weekday.sunday
  print(m, m.iso_number(), s, s.iso_number())
  print(m < s, datetime.Weekday.friday > .thursday, m == s)
  w = Map[datetime.Weekday, Int]()
  for k in $variants(datetime.Weekday)
    !w.put(k, k.iso_number())
  print(w.len, w.get(.tuesday) ?? 0)

test "weekdays of a week", '''
  Saturday Sunday Monday Tuesday Wednesday Thursday Friday Saturday
  Thursday Monday Friday
'''
  # jiff-core civil/date.rs:1553 `unix_epoch_day_weekday`; 1970-01-01, and
  # the ends of the range.
  line = String()
  for day in 14..22
    !line.add(`{datetime.Date.new(2026, 2, day)!.weekday()} `)
  print(text.trim(line))
  print(datetime.Date.new(1970, 1, 1)!.weekday(), datetime.Date.new(-9999, 1, 1)!.weekday(), datetime.Date.new(9999, 12, 31)!.weekday())

test "date new and readers", '''
  2024-02-29 2024 2 29 60 29
  1900-02-28 28 59
  -000001-01-01 -1 1 1
  0000-12-31 366
'''
  d = datetime.Date.new(2024, 2, 29)!
  print(d, d.year(), d.month(), d.day(), d.day_of_year(), d.days_in_month())
  c = datetime.Date.new(1900, 2, 28)!
  print(c, c.days_in_month(), c.day_of_year())
  b = datetime.Date.new(-1, 1, 1)!
  print(b, b.year(), b.month(), b.day())
  print(datetime.Date.new(0, 12, 31)!, datetime.Date.new(0, 12, 31)!.day_of_year())

test "date new refuses what is not a date", '''
  range range range range range range range ok ok
'''
  # §7.1: -9999-01-01 to 9999-12-31; jiff-core civil/date.rs:1401, 1406.
  fun try_date(y: Int, m: Int, d: Int) -> ?String
    _ = datetime.Date.new(y, m, d) catch return "range"
    "ok"

  print(try_date(2023, 2, 29), try_date(2024, 2, 30), try_date(2024, 4, 31), try_date(2024, 13, 1), try_date(2024, 0, 1), try_date(10000, 1, 1), try_date(-10000, 12, 31), try_date(-9999, 1, 1), try_date(9999, 12, 31))

test "leap years and month lengths", '''
  29 29 29 29 29 29 29 29
  28 28 28 28 28 28 28 28
  31 28 31 30 31 30 31 31 30 31 30 31
'''
  # jiff-core civil/mod.rs:232 `year_leap`, 252 `month_days`.
  line = String()
  for y in [-400, -104, -4, 0, 1904, 2000, 2004, 2024]
    !line.add(`{datetime.Date.new(y, 2, 1)!.days_in_month()} `)
  print(text.trim(line))
  line = String()
  for y in [-401, -100, -1, 1900, 1999, 2001, 2002, 2003]
    !line.add(`{datetime.Date.new(y, 2, 1)!.days_in_month()} `)
  print(text.trim(line))
  line = String()
  for m in 1..13
    !line.add(`{datetime.Date.new(2001, m, 1)!.days_in_month()} `)
  print(text.trim(line))

test "add months clamps to the month's end", '''
  2027-02-28 2024-02-29 2024-04-30 2025-02-28
  2027-03-01 2024-03-01
  2024-02-29 2024-02-29
  2026-11-30 2027-02-28
'''
  # §6.2 and §12: Jan 31 + 1 month, Feb 29 + 1 year, Jan 31 + 1 month +
  # 1 day (clamp, then days); years and months cancel before the clamp;
  # from the 1st, a month less a day is the month's last day.
  print(datetime.Date.new(2027, 1, 31)!.add(months: 1), datetime.Date.new(2024, 1, 31)!.add(months: 1), datetime.Date.new(2024, 3, 31)!.add(months: 1), datetime.Date.new(2024, 2, 29)!.add(years: 1))
  print(datetime.Date.new(2027, 1, 31)!.add(months: 1, days: 1), datetime.Date.new(2024, 1, 31)!.add(months: 1, days: 1))
  leap = datetime.Date.new(2024, 2, 29)!
  print(leap.add(years: 1, months: -12), leap.add(years: -1, months: 12))
  print(datetime.Date.new(2026, 11, 1)!.add(months: 1, days: -1), datetime.Date.new(2027, 1, 1)!.add(months: 2, days: -1))

test "add basic", '''
  2019-11-18 1977-02-18 1976-12-08 2019-02-28
  1976-11-18 1976-11-18 1976-11-18 2019-01-28
  2020-02-29 2020-02-29
  2024-03-03 2024-03-31 2024-02-29 2025-02-28
'''
  # tests/tc39_262/civil/date/add.rs:58 `basic`, 88 `overflow_constrain`,
  # 94 `overflow_reject` (Rig, as Jiff, clamps); jiff civil/date.rs:3543
  # `add_constrained` and the doc examples of `checked_add`.
  d = datetime.Date.new(1976, 11, 18)!
  print(d.add(years: 43), d.add(months: 3), d.add(days: 20), datetime.Date.new(2019, 1, 31)!.add(months: 1))
  print(datetime.Date.new(2019, 11, 18)!.add(years: -43), datetime.Date.new(1977, 2, 18)!.add(months: -3), datetime.Date.new(1976, 12, 8)!.add(days: -20), datetime.Date.new(2019, 2, 28)!.add(months: -1))
  print(datetime.Date.new(2020, 1, 31)!.add(months: 1), datetime.Date.new(2020, 1, 31)!.add(months: 1))
  e = datetime.Date.new(2024, 2, 29)!
  print(e.add(days: 3), e.add(months: 1, days: 2), e.add(weeks: 0), e.add(years: 1))

test "add weeks, and amounts of mixed sign", '''
  2024-03-14 2024-02-15 2024-03-01
  2024-02-29 2024-03-28 2024-01-31
'''
  # §6.2: each group with its own sign, in order: months, then days.
  d = datetime.Date.new(2024, 2, 29)!
  print(d.add(weeks: 2), d.add(weeks: -2), d.add(weeks: 1, days: -6))
  print(d.add(weeks: 1, days: -7), d.add(months: 1, days: -1), d.add(months: -1, days: 2))

test "add at the ends of the range", '''
  9999-12-31 -009999-01-01 range range range range
  -009999-01-01 9999-12-31
'''
  # §7.2: `checked_add` fails beyond the range, also for amounts whose
  # months overflow an `Int`; jiff-core civil/date.rs:1926 `add`.
  fun step(d: datetime.Date, years: Int, days: Int) -> ?String
    _ = d.checked_add(years: years, days: days) catch return "range"
    "ok"

  top = datetime.Date.new(9999, 12, 30)!
  low = datetime.Date.new(-9999, 1, 2)!
  print(top.add(days: 1), low.add(days: -1), step(top, 0, 2), step(low, 0, -2), step(top, Int.max, 0), step(low, 0, Int.min))
  print(datetime.Date.new(9999, 12, 31)!.add(years: -19998, days: -364), datetime.Date.new(-9999, 1, 1)!.add(years: 19998, months: 11, days: 30))

bomb "add past the last date panics", "datetime.Date.add: 9999-12-31 plus years: 0, months: 0, weeks: 0, days: 1 is beyond the range of dates, -9999-01-01 to 9999-12-31"
  d = datetime.Date.new(9999, 12, 31)!
  print(d.add(days: 1))

bomb "add of more months than an Int holds panics", "datetime.Date.add: 2000-01-01 plus years: 9223372036854775807, months: 0, weeks: 0, days: 0 is beyond the range of dates"
  d = datetime.Date.new(2000, 1, 1)!
  print(d.add(years: Int.max))

test "counts in both directions", '''
  73 -73 10 -10 2 -2 0 0
  1 -1 0 0 0 0
  28 0 28 0
  1 0 1 0
'''
  # §6.4: `a.days_since(b)` is `-b.days_since(a)`; Jan 31 to Feb 28 is 0
  # months and 28 days; tests/tc39_262/civil/date/until.rs:9 `basic`.
  a = datetime.Date.new(1969, 7, 24)!
  b = datetime.Date.new(1969, 10, 5)!
  print(b.days_since(a), a.days_since(b), b.weeks_since(a), a.weeks_since(b), b.months_since(a), a.months_since(b), b.years_since(a), a.years_since(b))
  c = datetime.Date.new(2027, 1, 31)!
  e = datetime.Date.new(2027, 3, 1)!
  print(e.months_since(c), c.months_since(e), datetime.Date.new(2027, 2, 28)!.months_since(c), c.years_since(e), c.days_since(c), c.months_since(c))
  print(datetime.Date.new(2027, 2, 28)!.days_since(c), datetime.Date.new(2027, 2, 28)!.months_since(c), datetime.Date.new(2024, 2, 29)!.days_since(datetime.Date.new(2024, 2, 1)!), datetime.Date.new(2024, 2, 29)!.months_since(datetime.Date.new(2024, 2, 1)!))
  print(datetime.Date.new(2024, 2, 29)!.months_since(datetime.Date.new(2024, 1, 29)!), datetime.Date.new(2024, 2, 29)!.months_since(datetime.Date.new(2024, 1, 30)!), datetime.Date.new(2024, 3, 30)!.months_since(datetime.Date.new(2024, 2, 29)!), datetime.Date.new(2024, 3, 28)!.months_since(datetime.Date.new(2024, 2, 29)!))

test "counts of years, weeks, and days", '''
  50 1 12 52 1 12 52
  9719 18262 7304483 -7304483
'''
  # tests/tc39_262/civil/date/until.rs:24 `largestunit_higher_units`, and
  # jiff-core civil/date.rs `until`'s example: the whole range.
  print(datetime.Date.new(2019, 7, 24)!.years_since(datetime.Date.new(1969, 7, 24)!), datetime.Date.new(2021, 2, 1)!.years_since(datetime.Date.new(2020, 2, 1)!), datetime.Date.new(2021, 2, 1)!.months_since(datetime.Date.new(2020, 2, 1)!), datetime.Date.new(2021, 2, 1)!.weeks_since(datetime.Date.new(2020, 2, 1)!), datetime.Date.new(2022, 2, 28)!.years_since(datetime.Date.new(2021, 2, 28)!), datetime.Date.new(2022, 2, 28)!.months_since(datetime.Date.new(2021, 2, 28)!), datetime.Date.new(2022, 2, 28)!.weeks_since(datetime.Date.new(2021, 2, 28)!))
  a = datetime.Date.new(1969, 7, 24)!
  print(datetime.Date.new(1996, 3, 3)!.days_since(a), datetime.Date.new(2019, 7, 24)!.days_since(a), datetime.Date.new(9999, 12, 31)!.days_since(datetime.Date.new(-9999, 1, 1)!), datetime.Date.new(-9999, 1, 1)!.days_since(datetime.Date.new(9999, 12, 31)!))

test "years, months, and days between dates", '''
  0 1 1 0 2 0 -1 -30
  0 0 30 0 0 29 0 0 28
  0 1 0 0 0 30 0 0 29
  0 3 0 0 2 30 2 4 0 2 3 30
  0 1 28 1 3 30 0 1 11
'''
  # §6.4's recipe for years, months, and days from the earlier date;
  # tests/tc39_262/civil/date/until.rs:274 `wrapping_at_end_of_month`
  # and 263 `weeks_months`, and `rounding_relative`'s exact counts
  # (Rig does not round a count: the rounded spans are left out).
  fun ymd(a: datetime.Date, b: datetime.Date) -> String
    early = a if a < b else b
    late = b if a < b else a
    m = late.months_since(early)
    `{m / 12} {m % 12} {late.days_since(early.add(months: m))}`

  print(ymd(datetime.Date.new(2019, 1, 29)!, datetime.Date.new(2019, 3, 1)!), ymd(datetime.Date.new(2019, 1, 31)!, datetime.Date.new(2019, 3, 31)!), datetime.Date.new(2019, 1, 31)!.months_since(datetime.Date.new(2019, 3, 30)!), datetime.Date.new(2019, 1, 30)!.days_since(datetime.Date.new(2019, 3, 1)!))
  end = datetime.Date.new(1970, 2, 28)!
  print(ymd(datetime.Date.new(1970, 1, 29)!, end), ymd(datetime.Date.new(1970, 1, 30)!, end), ymd(datetime.Date.new(1970, 1, 31)!, end))
  leap_end = datetime.Date.new(1972, 2, 29)!
  print(ymd(datetime.Date.new(1972, 1, 29)!, leap_end), ymd(datetime.Date.new(1972, 1, 30)!, leap_end), ymd(datetime.Date.new(1972, 1, 31)!, leap_end))
  nov = datetime.Date.new(1970, 11, 30)!
  apr = datetime.Date.new(1973, 4, 30)!
  print(ymd(datetime.Date.new(1970, 8, 30)!, nov), ymd(datetime.Date.new(1970, 8, 31)!, nov), ymd(datetime.Date.new(1970, 12, 30)!, apr), ymd(datetime.Date.new(1970, 12, 31)!, apr))
  print(ymd(datetime.Date.new(1970, 1, 29)!, datetime.Date.new(1970, 3, 28)!), ymd(datetime.Date.new(1970, 1, 31)!, datetime.Date.new(1971, 5, 30)!), ymd(datetime.Date.new(1969, 7, 24)!, datetime.Date.new(1969, 9, 4)!))

test "years, months, and days from Feb 29", '''
  0 11 30 1 0 1 4 0 0 3 11 30
  0 0 29 0 1 0
'''
  # §6.4 and §12: counting from Feb 29 by the recipe, not years then
  # months then days.
  fun ymd(a: datetime.Date, b: datetime.Date) -> String
    early = a if a < b else b
    late = b if a < b else a
    m = late.months_since(early)
    `{m / 12} {m % 12} {late.days_since(early.add(months: m))}`

  leap = datetime.Date.new(2024, 2, 29)!
  print(ymd(leap, datetime.Date.new(2025, 2, 28)!), ymd(leap, datetime.Date.new(2025, 3, 1)!), ymd(leap, datetime.Date.new(2028, 2, 29)!), ymd(leap, datetime.Date.new(2028, 2, 28)!))
  print(ymd(datetime.Date.new(2024, 1, 31)!, leap), ymd(leap, datetime.Date.new(2024, 3, 29)!))

test "a Feb 29 birthday", '''
  0 1 1 4
  2025-02-28 2025-02-28 2028-02-29
'''
  # §6.4: someone born on Feb 29 turns a year older on Mar 1 in a common
  # year (`years_since` is 0 on Feb 28), while `add(years: 1)` clamps.
  born = datetime.Date.new(2024, 2, 29)!
  print(datetime.Date.new(2025, 2, 28)!.years_since(born), datetime.Date.new(2025, 3, 1)!.years_since(born), datetime.Date.new(2026, 2, 28)!.years_since(datetime.Date.new(2025, 2, 28)!), datetime.Date.new(2028, 2, 29)!.years_since(born))
  print(born.add(years: 1), datetime.Date.new(2025, 2, 28)!, born.add(years: 4))

test "the period of a recurrence", '''
  0 1 3 4
'''
  # §6.4 and §12: from 2027-01-31 the periods start at `add(months: k)`,
  # so on a clamped month end the count is one short and the index
  # steps up.
  start = datetime.Date.new(2027, 1, 31)!
  fun period(start: datetime.Date, today: datetime.Date) -> Int
    k = today.months_since(start)
    if start.add(months: k + 1) <= today
      k = k + 1
    k

  print(period(start, datetime.Date.new(2027, 2, 27)!), period(start, datetime.Date.new(2027, 2, 28)!), period(start, datetime.Date.new(2027, 4, 30)!), period(start, datetime.Date.new(2027, 5, 31)!))

test "first and last of the month", '''
  2024-02-01 2024-02-29 2023-02-28 2024-12-31 -009999-01-01 9999-12-31
'''
  # jiff-core civil/date.rs:1566 `first_of_last_of`.
  print(datetime.Date.new(2024, 2, 17)!.first_of_month(), datetime.Date.new(2024, 2, 17)!.last_of_month(), datetime.Date.new(2023, 2, 1)!.last_of_month(), datetime.Date.new(2024, 12, 1)!.last_of_month(), datetime.Date.new(-9999, 1, 31)!.first_of_month(), datetime.Date.new(9999, 12, 1)!.last_of_month())

test "nth weekday", '''
  2024-03-11 2024-03-17 2024-03-21 2024-03-04 2024-03-03 2024-02-29
  2026-11-23 2026-11-09
  9999-12-31 9999-12-31 9999-12-24 range
  -009999-01-01 -009999-01-01 -009999-01-08 range
  range 9999-12-27 range -009999-01-05 range
'''
  # jiff-core civil/date.rs:1755 `nth_weekday_various`, 1787
  # `nth_weekday_errors`, 1793 `nth_weekday_extreme`; and §12: the next
  # Monday from a Monday is a week on, never the day itself.
  fun nth(d: datetime.Date, n: Int, w: datetime.Weekday) -> String
    r = d.nth_weekday(n, w) catch return String("range")
    String(r)

  d = datetime.Date.new(2024, 3, 10)!
  print(nth(d, 1, .monday), nth(d, 1, .sunday), nth(d, 2, .thursday), nth(d, -1, .monday), nth(d, -1, .sunday), nth(d, -2, .thursday))
  monday = datetime.Date.new(2026, 11, 16)!
  print(nth(monday, 1, .monday), nth(monday, -1, .monday))
  print(nth(datetime.Date.new(9999, 12, 24)!, 1, .friday), nth(datetime.Date.new(9999, 12, 30)!, 1, .friday), nth(datetime.Date.new(9999, 12, 31)!, -1, .friday), nth(datetime.Date.new(9999, 12, 31)!, 1, .friday))
  print(nth(datetime.Date.new(-9999, 1, 8)!, -1, .monday), nth(datetime.Date.new(-9999, 1, 2)!, -1, .monday), nth(datetime.Date.new(-9999, 1, 1)!, 1, .monday), nth(datetime.Date.new(-9999, 1, 1)!, -1, .monday))
  low = datetime.Date.new(-9999, 1, 1)!
  top = datetime.Date.new(9999, 12, 31)!
  print(nth(d, 0, .monday), nth(low, 1_043_497, .monday), nth(low, 1_043_498, .monday), nth(top, -1_043_497, .friday), nth(low, Int.min, .monday))

test "nth weekday of the month", '''
  2017-03-10 2024-03-28 range range 1998-01-31
  range range range range range 2017-03-31 2017-03-03
  2026-11-26 2026-11-27
'''
  # jiff-core civil/date.rs:1600 `nth_weekday_of_month_various`, 1620
  # `nth_weekday_of_month_errors`; and §6.7: the fourth Thursday of
  # November 2026, and a fifth Friday that does not exist.
  fun nth(d: datetime.Date, n: Int, w: datetime.Weekday) -> String
    r = d.nth_weekday_of_month(n, w) catch return String("range")
    String(r)

  print(nth(datetime.Date.new(2017, 3, 1)!, 2, .friday), nth(datetime.Date.new(2024, 3, 1)!, -1, .thursday), nth(datetime.Date.new(2024, 3, 25)!, 5, .monday), nth(datetime.Date.new(2024, 3, 25)!, -5, .monday), nth(datetime.Date.new(1998, 1, 1)!, 5, .saturday))
  d = datetime.Date.new(2017, 3, 1)!
  print(nth(d, 0, .tuesday), nth(d, 5, .tuesday), nth(d, -5, .tuesday), nth(d, 6, .tuesday), nth(d, -6, .tuesday), nth(d, 5, .friday), nth(d, -5, .friday))
  nov = datetime.Date.new(2026, 11, 1)!
  print(nth(nov, 4, .thursday), nth(nov, -1, .friday))

test "nth weekday of every month near the ends", '''
  -009999-01-01 -009999-01-29 9999-12-31 9999-12-03 range
'''
  # jiff-core civil/date.rs:1643 and 1690, near the minimum and maximum
  # dates.
  fun nth(d: datetime.Date, n: Int, w: datetime.Weekday) -> String
    r = d.nth_weekday_of_month(n, w) catch return String("range")
    String(r)

  low = datetime.Date.new(-9999, 1, 1)!
  top = datetime.Date.new(9999, 12, 31)!
  print(nth(low, 1, .monday), nth(low, -1, .monday), nth(top, -1, .friday), nth(top, 1, .friday), nth(top, 5, .monday))

test "ISO weeks", '''
  1 2026 52 1994 1 1997 1 2020 1 2032 10 2024
  1 -9999 52 9999 53 2020 53 2026
'''
  # §8.5: 2025-12-29 is in week 1 of 2026; jiff-core civil/date.rs:2008
  # `to_iso_week_date_various`, with the ends of the range.
  fun week(y: Int, m: Int, d: Int) -> String
    x = datetime.Date.new(y, m, d) catch panic("no such date")
    `{x.iso_week()} {x.iso_week_year()}`

  print(week(2025, 12, 29), week(1995, 1, 1), week(1996, 12, 31), week(2019, 12, 30), week(2031, 12, 29), week(2024, 3, 9))
  print(week(-9999, 1, 1), week(9999, 12, 31), week(2020, 12, 31), week(2026, 12, 31))

test "with", '''
  2024-02-01 2025-02-28 range 2023-03-01 range range
'''
  # §6.7: `with` fails when the result is not a real date:
  # 2024-02-29 with the year 2023.
  fun change(d: datetime.Date, year: Int? = none, month: Int? = none, day: Int? = none) -> String
    r = d.with(year: year, month: month, day: day) catch return String("range")
    String(r)

  d = datetime.Date.new(2024, 2, 29)!
  print(change(d, day: 1), change(d, year: 2025, day: 28), change(d, year: 2023), change(d, year: 2023, month: 3, day: 1), change(d, month: 13), change(d, year: 10000))

test "dates compare, order, and hash", '''
  true false true true
  -000001-12-31 0000-01-01 2024-02-29
  3 2
'''
  a = datetime.Date.new(2024, 2, 29)!
  b = datetime.Date.new(2024, 3, 1)!
  print(a == datetime.Date.new(2024, 2, 29)!, a == b, a < b, datetime.Date.new(-1, 12, 31)! < datetime.Date.new(0, 1, 1)!)
  print(datetime.Date.new(-1, 12, 31)!, datetime.Date.new(0, 1, 1)!, a)
  seen = Map[datetime.Date, Int]()
  !seen.put(a, 1)
  !seen.put(b, 2)
  !seen.put(datetime.Date.new(2025, 1, 1)!, 3)
  !seen.put(datetime.Date.new(2024, 3, 1)!, 2)
  print(seen.len, seen.get(datetime.Date.new(2024, 3, 1)!) ?? 0)

test "date text", '''
  2026-11-17 2026-11-17 -000001-01-01 2024-03-10 0000-01-01 9999-12-31
  true -000001-01-01
'''
  # §8.1: ISO 8601, a year below 0 with its sign and six digits, and the
  # basic form; `String(d)` is the same text, which reads back.
  print(datetime.Date.parse("2026-11-17")!, datetime.Date.parse("20261117")!, datetime.Date.parse("-000001-01-01")!, datetime.Date.parse("+002024-03-10")!, datetime.Date.parse("0000-01-01")!, datetime.Date.parse("9999-12-31")!)
  d = datetime.Date.new(2026, 11, 17)!
  print(datetime.Date.parse(String(d))! == d, String(datetime.Date.new(-1, 1, 1)!))

test "date text refused", '''
  DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid
  DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid DateTimeError.invalid
'''
  # §8.1: a `Date` reads only its own form: no time, offset, zone, or
  # `Z`; and Jiff's grammar: four digits or a sign and six, one
  # separator throughout, a real date, no `-000000`.
  fun read(s: ?String) -> String
    d = datetime.Date.parse(s) catch |e| return String(e)
    String(d)

  print(read("2024-03-10T03:30"), read("2024-03-10 03:30"), read("2024-03-10-06:00"), read("2024-03-10[America/Denver]"), read("2024-03-10Z"), read("03:30"))
  print(read("2023-02-29"), read("2024-0310"), read("-0001-01-01"), read("-000000-01-01"), read("24-03-10"), read(""))

test "counts from Jiff's own tests", '''
  4 1 24 3 10 7 19998 11 30
  5 2 4 23 1 24 49 24 3 2 144 -144
  1 1 2 2 2 1
  10 30 0 30 10 29 10 29
'''
  # jiff civil/date.rs:3552 `since_years`, 3576 `since_months`, 3613
  # `since_weeks`, 3623 `since_days`, 3633 `until_month_lengths`, 3648
  # `since_until_not_commutative`, 3698 `until_months_no_balance`, 3709
  # `until_extremes`. Rig counts forward from the earlier date whichever
  # way it is asked (§9 item 3): where Jiff's `since` measures backward
  # from the later date (`4.years().months(1).days(21)`, `2.months()` from
  # 2020-04-30, `-10.months().days(30)`), Rig gives the count forward,
  # Jiff's `until` from the earlier (24 days, 2 months and 1 day, 10
  # months and 29 days).
  fun ymd(a: datetime.Date, b: datetime.Date) -> String
    early = a if a < b else b
    late = b if a < b else a
    m = late.months_since(early)
    `{m / 12} {m % 12} {late.days_since(early.add(months: m))}`

  fun md(a: datetime.Date, b: datetime.Date) -> String
    early = a if a < b else b
    late = b if a < b else a
    m = late.months_since(early)
    `{m} {late.days_since(early.add(months: m))}`

  print(ymd(datetime.Date.new(2023, 4, 15)!, datetime.Date.new(2019, 2, 22)!), ymd(datetime.Date.new(2023, 2, 22)!, datetime.Date.new(2019, 4, 15)!), ymd(datetime.Date.new(9999, 12, 31)!, datetime.Date.new(-9999, 1, 1)!))
  print(md(datetime.Date.new(2024, 7, 24)!, datetime.Date.new(2024, 2, 22)!), md(datetime.Date.new(2024, 7, 15)!, datetime.Date.new(2024, 2, 22)!), md(datetime.Date.new(2023, 4, 15)!, datetime.Date.new(2023, 2, 22)!), md(datetime.Date.new(2023, 4, 15)!, datetime.Date.new(2019, 2, 22)!), datetime.Date.new(2024, 7, 15)!.weeks_since(datetime.Date.new(2024, 6, 22)!), datetime.Date.new(2024, 7, 15)!.days_since(datetime.Date.new(2024, 6, 22)!) % 7, datetime.Date.new(2024, 7, 15)!.days_since(datetime.Date.new(2024, 2, 22)!), datetime.Date.new(2024, 2, 22)!.days_since(datetime.Date.new(2024, 7, 15)!))
  jan1 = datetime.Date.new(2020, 1, 1)!
  feb1 = datetime.Date.new(2020, 2, 1)!
  mar1 = datetime.Date.new(2020, 3, 1)!
  print(feb1.months_since(jan1), mar1.months_since(feb1), mar1.months_since(jan1), datetime.Date.new(2020, 4, 30)!.months_since(datetime.Date.new(2020, 2, 29)!), md(datetime.Date.new(2020, 4, 30)!, datetime.Date.new(2020, 2, 29)!))
  print(md(datetime.Date.new(2023, 5, 31)!, datetime.Date.new(2024, 4, 30)!), md(datetime.Date.new(2023, 5, 31)!, datetime.Date.new(2023, 6, 30)!), md(datetime.Date.new(-9999, 12, 1)!, datetime.Date.new(-9999, 1, 2)!), md(datetime.Date.new(9999, 1, 2)!, datetime.Date.new(9999, 12, 1)!))

test "invalid days", '''
  range range range ok range range
'''
  # jiff civil/date.rs:3874 `date_invalid_day`.
  fun try_date(y: Int, m: Int, d: Int) -> ?String
    _ = datetime.Date.new(y, m, d) catch return "range"
    "ok"

  print(try_date(1998, 1, 0), try_date(1998, 1, -1), try_date(1998, 2, 29), try_date(2004, 2, 29), try_date(2026, 3, 0), try_date(2026, 3, -1))

test "what a date, a time, and a datetime read", '''
  date only: 2024-03-10 invalid 2024-03-10T00:00:00
  date and time: invalid invalid 2024-03-10T03:30:00
  time only: invalid 03:30:00 invalid
  offset: invalid invalid invalid
  zone: invalid invalid invalid
  Z: invalid invalid invalid
'''
  # §8.1, the table of what `Date`, `Time`, and `DateTime` read: each
  # only its own form, where Jiff drops the rest without a word; a date
  # alone is a `DateTime` at midnight.
  fun show[T](r: T?) -> String
    if r as v
      return String(v)
    String("invalid")

  fun row(what: ?String, s: ?String) -> String
    d = show(datetime.Date.parse(s) catch none)
    t = show(datetime.Time.parse(s) catch none)
    dt = show(datetime.DateTime.parse(s) catch none)
    `{what}: {d} {t} {dt}`

  print(row("date only", "2024-03-10"))
  print(row("date and time", "2024-03-10T03:30"))
  print(row("time only", "03:30"))
  print(row("offset", "2024-03-10T03:30-06:00"))
  print(row("zone", "2024-03-10T03:30[America/Denver]"))
  print(row("Z", "2024-03-10T03:30Z"))
