# modules: the boundaries between the files of a directory module. Each
# file closes its own blocks and brackets, and its diagnostics name it.

fail "dir boundary unclosed bracket", "2:10: unexpected end of block; expected an expression", "2:9: the `(` opened here is not closed", errors: 1
  # An unclosed bracket is reported in its file, `m/a.rig`, and the next
  # file is not read as its continuation: nothing is reported in `m/b.rig`.
  use m

  print(m.b())

  file "m/a.rig"
    pub fun a() -> Int
      print((

  file "m/b.rig"
    pub fun b() -> Int
      2

test "dir boundary files close their blocks", "6"
  # A block left open at the end of one file ends there: the next file's
  # first declaration is a declaration of the module.
  use m

  print(m.b())

  file "m/a.rig"
    pub fun a() -> Int
      1

  file "m/b.rig"
    pub fun b() -> Int
      x = 2
      y = 3
      x + y + c()

  file "m/c.rig"
    fun c() -> Int
      a()

fail "dir boundary indented first line", "1:3: unexpected indentation", errors: 1
  # A file's first line may not be indented to continue the file before it.
  use m

  print(m.b())

  file "m/a.rig"
    pub fun a() -> Int
      1

  file "m/b.rig"
    pub fun b() -> Int
      x = 2
      x + c()

  file "m/c.rig"
    fun c() -> Int
      a()

  file "m/d.rig"
      fun d() -> Int
        1

fail "dir boundary error in a later file", "2:9: use of unbound name `nope`", errors: 1
  # An error is reported at its file's own line and column.
  use m

  print(m.b())

  file "m/a.rig"
    pub fun a() -> Int
      1

  file "m/b.rig"
    pub fun b() -> Int
      x = 2
      y = 3
      x + y + c()

  file "m/c.rig"
    fun c() -> Int
      a() + nope

test "dir boundary file with no tokens", "1"
  # A file with no tokens, a blank line or only comments, is part of the
  # module.
  use m

  print(m.a())

  file "m/0.rig"

  file "m/00.rig"
    # The module m.

  file "m/a.rig"
    pub fun a() -> Int
      1

test "dir boundary local named like a later use", "1"
  # A local may have the name another file's `use` binds.
  use m

  print(m.a())

  file "m/a.rig"
    pub fun a() -> Int
      math = 1
      math

  file "m/c.rig"
    use std.math

    fun c() -> Int
      math.abs(-1)

test "dir boundary use names per file", "33 2 41", release: true
  # A `use` binds its name in its own file only, in an optimized build
  # too: in another file of the module the name is free for a parameter
  # or a local.
  use m

  sub main()
    print(m.a(), m.b(1), m.c())

  file "ast.rig"
    pub fun size() -> Int
      3

  file "m/a.rig"
    use ast

    pub fun a() -> Int
      n = ast.size()
      new ast = n * 10
      ast + n

  file "m/b.rig"
    pub fun b(ast: Int) -> Int
      ast + 1

    pub fun c() -> Int
      ast = 40
      ast + d()

    fun d() -> Int
      f = |ast: Int| ast + 1
      f(0)

test "dir boundary file and directory of one name", "1 2"
  # `a/b.rig` is part of module `a`, and the directory `a/b/` is module
  # `a.b`: both may exist.
  use a
  use a.b

  print(a.one(), b.two())

  file "a/b.rig"
    pub fun one() -> Int
      1

  file "a/b/two.rig"
    pub fun two() -> Int
      2

test "dir boundary nested module", "1"
  # A directory module inside another directory is named by its path.
  use a.b

  print(b.one())

  file "a/b/one.rig"
    pub fun one() -> Int
      1
