# syntax: string literals where a `U8` or a `[N]U8` is expected are bytes.

test "byte values", "65 10 92 39 34 27 13 9 0 255 92"
  # Where a `U8` is expected, a string literal of one byte is that byte;
  # double quotes read escapes, single quotes do not.
  bytes: [11]U8 = ['A', "\n", "\\", "'", '"', "\x1b", "\r", "\t", "\x00", "\xFF", '\']
  print(bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7], bytes[8], bytes[9], bytes[10])

test "byte contexts", '''
  65 66 67 68 69
  true true false 2
  [70, 71]
'''
  # A binding's type, a field, an argument, a result, an element, and the
  # other side of an operator each expect a `U8`.
  obj Glyph
    ch: U8

  fun code(c: U8) -> Int
    Int(c)

  fun first() -> U8
    'D'

  a: U8 = 'A'
  cell = Glyph(ch: 'B')
  print(a, cell.ch, code('C'), first(), U8('E'))
  digit: U8 = '7'
  print(a == 'A', 'A' == a, a > 'Z', digit - '5')
  pair: [2]U8 = ['F', 'G']
  print(pair)

test "byte text without a type", "A AB 2"
  # With no type expected, a string literal is text, as `x = 3` is an
  # `Int`.
  x = 'A'
  y = "AB"
  print(x, y, y.len)

test "byte patterns", "cursor erase digit other control"
  # Against a `U8`, a string pattern is a byte, and a range's bound.
  fun act(c: U8) -> ?String
    match c
      'H', 'f' => "cursor"
      'J' => "erase"
      '0'..='9' => "digit"
      "\x00".."\x20" => "control"
      _ => "other"

  print(act('f'), act('J'), act('7'), act('x'), act("\n"))

fail "byte pattern overlaps", "4:5: this pattern overlaps an earlier arm"
  fun act(c: U8) -> Int
    match c
      'A' => 1
      65 => 2
      _ => 0

  print(act(1))

test "byte arrays", '''
  [104, 105, 10] 3
  [97, 98, 99]
  []
'''
  # Where a `[N]U8` is expected, a string literal is its bytes, with no
  # terminator.
  x: [3]U8 = "hi\n"
  y: [3]U8 = 'abc'
  e: [0]U8 = ""
  print(x, x.len)
  print(y)
  print(e)

test "byte module constants", '''
  [27, 91, 72] 91
  esc
'''
  # Bytes are constants, of their module too.
  ESC: U8 = "\x1b"
  HOME: [3]U8 = "\x1b[H"

  fun kind(c: U8) -> ?String
    match c
      ESC => "esc"
      _ => "other"

  sub main()
    print(HOME, HOME[1])
    print(kind(HOME[0]))

fail "byte array of the wrong length", "1:12: string literal `\"abc\"` is 3 bytes; `[2]U8` needs 2"
  y: [2]U8 = "abc"
  print(y)

fail "byte of no bytes", "1:9: `''` holds no bytes; a `U8` is one byte"
  c: U8 = ''
  print(c)

fail "byte of two bytes", "1:9: `'AB'` is 2 bytes; a `U8` is one byte"
  c: U8 = 'AB'
  print(c)

fail "byte of a raw escape", "1:9: `'\\n'` is raw, the two bytes `\\` and `n`; for a newline write `\"\\n\"`"
  c: U8 = '\n'
  print(c)

fail "byte of a raw hex escape", "1:9: `'\\x1b'` is raw, the 4 bytes `\\x1b`; for the byte 0x1b write `\"\\x1b\"`"
  c: U8 = '\x1b'
  print(c)

fail "byte of a raw escape and more", "1:9: `'a\\n'` is 3 bytes, and raw"
  c: U8 = 'a\n'
  print(c)

fail "byte of a non-ASCII character", "1:9: `'é'` is one character of 2 bytes; a `U8` is one byte"
  c: U8 = 'é'
  print(c)

fail "byte of a code point", "1:9: `\"\\u{e9}\"` is 2 bytes; a `U8` is one byte"
  c: U8 = "\u{e9}"
  print(c)

fail "byte beside a byte of two", "2:12: `'AB'` is 2 bytes; a `U8` is one byte"
  c: U8 = 'A'
  print(c == 'AB')

fail "byte pattern of two", "4:5: `'AB'` is 2 bytes; a `U8` is one byte", errors: 1
  fun act(c: U8) -> Int
    match c
      'A' => 1
      'AB' => 2
      _ => 0

  print(act(1))

fail "byte range bound of two", "4:5: `'AB'` is 2 bytes; a `U8` is one byte", errors: 1
  fun act(c: U8) -> Int
    match c
      'A' => 1
      'AB'..='Z' => 2
      _ => 0

  print(act(1))

fail "byte only for U8", "type mismatch: expected `Int`, got `Static`"
  # Only a `U8` takes a string literal as a byte.
  n: Int = 'A'
  print(n)

fail "byte prefix is a name", "3:8: unexpected `'A'`"
  # `b'A'` is the name `b` followed by a string.
  b = 1
  print(b'A')
