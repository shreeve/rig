test "new is contextual", '''
  3
  20
'''
  # `new` is a keyword only at the start of a statement (`new x = ...`
  # explicitly shadows); elsewhere it is an ordinary name, so a type can
  # have a `new` constructor.

  obj Point
    x: Int

    fun new(x: Int) -> Point
      Point(x: x)

  p = Point.new(3)
  print(p.x)
  x = 1
  new x = x * 20
  print(x)

test "new keyword argument", "1 O(new: 1, b: 2) 34 56"
  # `new` is a keyword only at the start of a statement, so it names a
  # field, and a keyword argument or a payload field in a call or a
  # pattern, as any member name does.

  obj O
    new: Int
    b: Int

  enum P
    pp(new: Int, b: Int)
    qq

  fun pv(p: P) -> Int
    match p
      .pp(new: x, b: y) => x * 10 + y
      .qq => 0

  o = O(new: 1, b: 2)
  print(o.new, o, pv(P.pp(new: 3, b: 4)), pv(.pp(b: 6, new: 5)))

fail "not comparison enum", "9:7: write `l <= .low`, or `not (l > .low)`: `not` applies to the whole comparison", "10:7: write `Level.high > l`, or `not (Level.high <= l)`", errors: 2
  # A plain enum is totally ordered, so an ordering of one directly under
  # `not` is flipped exactly, a `.variant` side included.

  enum Level
    low
    high

  l = Level.low
  print(not l > .low)
  print(not Level.high <= l)

fail "not comparison lines", "5:7: write `a <= 2`, or `not (a > 2)`: `not` applies to the whole comparison", "7:7: write `a > 2`, or `not (a <= 2)`: `not` applies to the whole comparison", errors: 2
  # A comparison under `not` that spans lines: the hint writes it on one
  # line, without the comments in it.

  a = 1
  print(not a # the count
    > 2)
  print(not a
    <= 2, 0)

fail "not comparison scope", "12:9: write `it.qty <= 3`, or `not (it.qty > 3)`: `not` applies to the whole comparison", "13:9: write `it.qty > 3`, or `not (it.qty <= 3)`", "16:9: write `a != 2`, or `not (a == 2)`", "17:9: write `b == 1.5`, or `not (b != 1.5)`", "20:9: write `not (it.price < 2.5)`: `not` applies to the whole comparison", "23:9: write `it.name < \"m\"`, or `not (it.name >= \"m\")`", "26:6: write `a <= 1`, or `not (a > 1)`", "28:14: write `a >= 0`, or `not (a < 0)`", "30:21: write `(a) <= (2)`, or `not ((a) > (2))`", "33:13: write `a != 1`, or `not (a == 1)`", errors: 10
  # `not` applies to the whole comparison after it, which reads as
  # `(not a) > b` too: a comparison directly under `not` is written in
  # parentheses, or flipped where the flip means the same (integers,
  # text, and any `==`), wherever `not` stands.

  obj Item
    qty: Int
    price: Float
    name: ?String

  sub ordered(it: ?Item)
    print(not it.qty > 3)
    print(not it.qty <= 3)

  sub equality(a: Int, b: Float)
    print(not a == 2)
    print(not b != 1.5)

  sub floats(it: ?Item)
    print(not it.price < 2.5)

  sub text(it: ?Item)
    print(not it.name >= "m")

  sub joined(a: Int, b: Bool)
    if not a > 1 and b
      print(1)
    while b or not a < 0
      break
    print(1) if b and not (a) > (2)

  sub nested(a: Int)
    print(not not a == 1)

  it = Item(qty: 4, price: 1.0, name: "x")
  ordered(?it)
  equality(1, 2.0)
  floats(?it)
  text(?it)
  joined(1, true)
  nested(1)

test "not scope", '''
  true true true true
  false true true
  ok
'''
  # `not` takes a Bool: a name, a call, a parenthesized comparison, or
  # another `not`. It binds tighter than `and` and `or`, so `not a and b`
  # is `(not a) and b`, and it needs no parentheses there.

  obj Bag
    items: List[Int]

    fun is_empty(?self) -> Bool
      self.items.len == 0

  done = false
  bag = Bag(items: List())
  a = 2
  b = 3
  while not done
    !bag.items.push(a)
    done = bag.items.len >= 2
  print(not bag.is_empty(), not (a > b), not (a == b), a <= b)
  print(not done and a < b, not not done, done or not (b < a))
  if not (a > b) and not bag.is_empty()
    print("ok")

