    r = %x

test "read receiver sigil", '''
  2
  13
  6
  p 1
  point 5
  7
  step 1
  step 1
'''
  # `?p.m()` spells out the read receiver a call takes anyway, on a place
  # and its fields and elements, and in a `while` step; `?(p.m())`
  # views the call's result.

  obj Point
    x: Int

    fun shifted(?self, d: Int) -> Point
      Point(x: self.x + d)

    sub show(?self, label: ?String)
      print(label, self.x)

  obj Line
    a: Point
    b: Point

  sub show_point(p: ?Point)
    print("point", p.x)

  p = Point(x: 1)
  print(?p.shifted(1).x)
  line = Line(a: Point(x: 2), b: Point(x: 3))
  q = ?line.b.shifted(10)
  print(q.x)
  pts = [Point(x: 5), Point(x: 6)]
  print(?pts[1].shifted(0).x)
  ?p.show("p")
  show_point(?(p.shifted(4)))
  v: List[Int] = List()
  !v.push(7)
  print(?v.get(0) ?? 0)
  i = 0
  while i < 2 : ?p.show("step")
    i += 1

fail "read receiver sigil on writer", "21:1: `bump` writes its receiver: write `!c.bump()`", "22:7: `done` consumes its receiver: write `<c.done()`; to lend the call's result, write `?(c.done())`", "23:6: `make` is called through its type or module and has no receiver; to lend the call's result, write `?(Counter.make())`"
  # `?p.m()` names a read receiver: a method that writes or consumes its
  # receiver is called with `!` or `<`, and a call's result is lent
  # with `?(p.m())`.

  obj Counter
    n: Int

    sub bump(!self)
      self.n += 1

    fun done(<self) -> Int
      self.n

    fun make() -> Counter
      Counter(n: 0)

  sub show(c: ?Counter)
    print(c.n)

  c = Counter(n: 0)
  ?c.bump()
  print(?c.done())
  show(?Counter.make())

test "receiver move sigil", '''
  2
  5
  7
  1
'''
  # `<self` is the short form of `self: Self`: the method consumes its
  # receiver, as `?self` reads it and `!self` writes it. The caller writes
  # the move (`<c.close()`), or calls it on a temporary.

  obj Conn
    name: ?String

    fun close(<self) -> Int
      self.name.len

    fun renamed(<self, name: ?String) -> Conn
      c = <self
      c.name = name
      <c

  obj Wrap[T]
    v: T

    fun unwrap(<self) -> T
      self.v

  enum Shape
    circle(r: Int)
    square

    fun area(<self) -> Int
      match self
        .circle(r) => 3 * r * r
        .square => 1

  c = Conn(name: "db")
  print(<c.close())
  print(Conn(name: "cache").renamed("store").close())
  w = Wrap[Int](v: 7)
  print(<w.unwrap())
  s: Shape = .square
  print(<s.area())

test "receiver sigils", '''
  4 4
  2
  6
  1
  50
  10
  -1
  3
  2
  1
  2
  sent 3
'''
  # `!` or `<` before a place followed by a method call is the receiver's
  # mode: `!v.push(x)` is `(!v).push(x)`, `<c.close()` is `(<c).close()`.
  # Postfixes after the call apply to its result.

  error Empty
    none_left

  obj Cell2
    n: Int
    sub bump(!self)
      self.n += 1

  obj Bag
    items: List[Int]
    sub add(!self, k: Int)
      !self.items.push(k)
    fun take(!self) -> Int!
      return Empty.none_left if self.items.len == 0
      (!self.items).pop() ?? 0
    fun with(!self, k: Int) -> !Bag
      !self.items.push(k)
      self

  obj Conn
    name: ?String
    fun close(<self) -> Int
      self.name.len

  obj Builder
    parts: List[Int]
    # `self: Self` is the long form of `<self`.
    fun with(self: Self, k: Int) -> Builder
      b = <self
      !b.parts.push(k)
      <b
    fun finish(<self) -> Int
      total = 0
      for p in ?self.parts
        total += p
      total

  obj Holder
    v: List[Int]

  obj Row
    cell: Cell2

  fun drain(b: !Bag) -> Int!
    (!b).take()! + (!b).take()!

  sub send(n: Int)
    print("sent", n)

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  (!v).push(3)
  !v.push(4) if v.len == 3
  !v.push(5) if false
  print(v.len, v[3])

  grid: List[Cell2] = List()
  !grid.push(Cell2(n: 0))
  !grid[0].bump()
  (!grid[0]).bump()
  print(grid[0].n)
  rows: List[Row] = List()
  !rows.push(Row(cell: Cell2(n: 5)))
  !rows[0].cell.bump()
  print(rows[0].cell.n)

  x = Holder(v: List())
  !x.v.push(7)
  print(x.v.len)

  bag = Bag(items: List())
  !bag.add(10)
  (!bag).with(20).with(30)
  print(drain(!bag) catch -1)
  print((!bag.items).pop() ?? 0)
  print(drain(!bag) catch -1)

  q: List[Int] = List()
  i = 0
  while i < 3 : !q.push(i)
    i += 1
  while (!q).pop() as j
    print(j)

  conn = Conn(name: "db")
  print(<conn.close())
  b = Builder(parts: List())
  send(<b.with(1).with(2).finish())

fail "reserved word as closure param", "3:6: unexpected keyword `when`"
  # A keyword cannot name a closure parameter; the error names it.

  f = |when: Int| when + 1
  print(f(1))

fail "reserved word as function", "3:5: unexpected keyword `yield`"
  # `yield` is reserved and cannot name a top-level function.

  fun yield() -> Int
    1

  print(1)

fail "reserved word as local", "3:1: unexpected keyword `when`"
  # `when` is reserved for a later form and cannot name a local.

  when = 3
  print(when)

fail "reserved word as param", "4:10: `const` is a keyword and cannot name a parameter"
  # `const` is reserved: inside ( ) `const:` reads as a name, but it
  # cannot name a parameter.

  sub show(const: Int)
    print(1)

  show(1)

fail "reserved word as variant", "4:3: unexpected keyword `async`"
  # `async` is reserved and cannot name an enum variant.

  enum Mode
    async
    sync

  print(1)

test "reserved words as member names", '''
  3 true here 6 true
  .at(when: 5, async: false)
'''
  # The words reserved for later forms (`trait`, `impl`, `where`,
  # `async`, `await`, `yield`, `when`, `const`) still name members: a
  # field, a method, or a payload field.

  obj Job
    when: Int
    const: Bool
    where: ?String

    fun yield(?self) -> Int
      self.when * 2

    fun await(?self) -> Bool
      self.const

  enum Ev
    at(when: Int, async: Bool)
    none_yet

  j = Job(when: 3, const: true, where: "here")
  print(j.when, j.const, j.where, j.yield(), j.await())
  e = Ev.at(when: 5, async: false)
  print(e)

test "results as", '''
  key value
  no =
  1 a
  2 b
  1
  2
'''
  # `if f() as a, b` and `while f() as a, b` bind the results inside an
  # optional, each name a new binding over the body.

  fun cut(s: ?String, sep: U8) -> (?String, ?String)? from s
    i = 0
    while i < s.len
      return s[..i], s[i + 1..] if s[i] == sep
      i += 1
    none

  obj Pairs
    ks: List[String]
    i: Int

    fun next(!self) -> (Int, String)?
      return none if self.i >= self.ks.len
      self.i += 1
      return self.i, +self.ks[self.i - 1]

  t = String("key=value")
  if cut(?t, 61) as key, value and key.len > 0
    print(key, value)
  if cut("abc", 61) as k, v
    print(k, v)
  else
    print("no =")
  p = Pairs(ks: List(), i: 0)
  !p.ks.push(String("a"))
  !p.ks.push(String("b"))
  while (!p).next() as n, s
    print(n, s)
  p.i = 0
  while (!p).next() as n, s
    print(n)
    <s

