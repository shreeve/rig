  # Comments start with `#`; there are no block comments.

  /* main */
  sub main()
    print(1)

fail "comment slashes", "3:7: comments start with `#`"
  # Comments start with `#`.

  x = 1 // one
  print(x)

fail "comparison chain", "5:21: unexpected `==`; comparisons do not chain, and `|`, `&`, and `^` bind tighter than a comparison: put each comparison in parentheses, `(a == b) | (c == d)`", errors: 1
  # Comparisons do not chain, and `|` binds tighter than `==`, so two
  # masks or Bools are combined with each comparison in parentheses.

  v = Simd[U8, 16].splat(0x22)
  print(v == 0x22 | v == 0x5C)

