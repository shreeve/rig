fail "loop else continue own label", "`continue @a` names no enclosing loop or block"
  # A loop's `else` runs after the loop, so a jump there cannot name it.
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  for _ in 0..2
    i = 0
    @a while mk(?v, i) as h and i >= 0: k += h.s[0]
      i += 1
    else
      n += 1
      continue @a
    k += 100
  print("end", k, n)

test "loop value", '''
  2 -1
  300
  4 -1
  26 -1
  8
  bb
  0
  1
  7
'''
  # A loop whose `break` carries a value is an expression: its value is
  # the value of the `break` that leaves it, or its `else` value when
  # none does. `while true` needs no `else`.

  obj Grid
    rows: [3]Int
    cols: [3]Int

  fun find(xs: ?[4]Int, t: Int) -> Int
    for x, i in xs
      break i if x == t
    else
      -1

  fun first_over(limit: Int) -> Int
    for i in 0..10
      break i if i * i > limit
    else
      -1

  fun pair(g: ?Grid, t: Int) -> Int
    @outer for r in g.rows
      for c in g.cols
        break @outer r * 10 + c if r + c == t
    else
      -1

  fun collatz(start: Int) -> Int
    n = start
    steps = 0
    while true
      break steps if n == 1
      n = n / 2 if n % 2 == 0 else 3 * n + 1
      steps += 1

  a = [5, 6, 7, 8]
  print(find(?a, 7), find(?a, 9))
  n = 0
  y = while n < 10
    n += 1
    break n * 100 if n == 3
  else
    0
  print(y)
  print(first_over(10), first_over(1000))
  g = Grid(rows: [1, 2, 3], cols: [4, 5, 6])
  print(pair(?g, 8), pair(?g, 20))
  print(collatz(6))
  word = if first_over(3) > 1
    for s in ["a", "bb", "ccc"]
      break s if s.len == 2
    else
      "none"
  else
    "small"
  print(word)
  x = for i in 0..3
    for j in 0..2
      print(j)
    else
      break 7 + i
  else
    0
  print(x)

test "loop value break in nested source", release: true, '''
  5
  2.5
  from the source
  2 9 10 1
  30
'''
  # A `for` source runs before its loop is entered, so a `break` there
  # leaves the loop around that `for`, with its value. It counts as that
  # loop's value even when it is the only `break` that gives one.
  #

  fun some(i: Int) -> Int?
    i if i != 1 else none

  fun mk(i: Int) -> List[Int]
    l: List[Int] = List()
    !l.push(i)
    !l.push(i + 1)
    l

  n = for i in 0..3
    for j in 0..(some(i) ?? break 5)
      print("n", i, j)
  else
    0
  print(n)

  f = for i in 0..3
    for j in 0..(some(i) ?? break 2.5)
      print("f", i, j)
    break 0.5 if i == 2
  else
    1.5
  print(f)

  s = for i in 0..3
    for j in 0..(some(i) ?? break String("from the source"))
      print("s", i, j)
    break String("from the body") if i == 2
  else
    String("from the else")
  print(s)

  a: List[Int] = List()
  !a.push(7)
  l = for i in 0..3
    for j in 0..(some(i) ?? break mk(9))
      print("l", i, j)
    break +a if i == 2
  else
    +a
  print(l.len, l[0], l[1], a.len)

  # Without the nested source's `break`, the body's leaves the loop.
  m = for i in 2..5
    for _ in 0..(some(i) ?? break 99)
      pass
    break i * 10 if i == 3
  else
    -1
  print(m)

fail "loop value break without value", "5:3: this `break` leaves a loop used as a value; give it the value (`break value`)"
  # Every `break` that leaves a loop used as a value gives it a value.

  x = for i in 0..3
    break i if i == 2
    break if i == 1
  else
    0
  print(x)

fail "loop value needs else", "4:5: a loop used as a value needs an `else` giving its value when no `break` does"
  # A loop used as a value has no value when its condition fails, so it
  # needs an `else`; only `while true` can do without one.

  x = for i in 0..3
    break i if i == 2
  print(x)

test "loop value positions", '''
  4 -1
  602
  zero small big
  4 0
  4 -1
  1
  200
'''
  # Loops used as values in every value position: a returned value, a
  # nested loop, a match arm, closure bodies, and with a type from context.

  obj P
    n: Int

  fun first_even(xs: ?[4]Int) -> Int
    return for x in xs
      break x if x % 2 == 0
    else
      return -1

  fun nested(limit: Int) -> Int
    x = for i in 1..10
      j = for k in 1..10
        break k if k * i > limit
      else
        0
      break i * 100 + j if j > 0 and j < 3
    else
      0
    x

  fun kind(n: Int) -> ?String
    match n
      0 => "zero"
      _
        i = 0
        while i < n : i += 1
          break "big" if i > 5
        else
          "small"

  print(first_even(?[1, 3, 4, 5]), first_even(?[1, 3, 5, 7]))
  print(nested(10))
  print(kind(0), kind(3), kind(9))
  f: fun(Int) -> Int = |n| for i in 0..n
    break i if i * 3 > n
  else
    n
  print(f(10), f(0))
  g = |n: Int| for i in 0..n
    break i * 2 if i == 2
  else
    -1
  print(g(5), g(1))
  a = P(n: 1)
  b = P(n: 2)
  r = for i in 0..2
    break ?a if i == 1
  else
    ?b
  print(r.n)
  u8v: U8 = for i in 0..3
    break 200 if i == 1
  else
    7
  print(u8v)

