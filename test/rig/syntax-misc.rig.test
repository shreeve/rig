test "bitwise or chain", "7"
  # `a | b | c` is bitwise or of three integers.

  a = 1
  b = 2
  c = 4
  x = a | b | c
  print(x)

fail "bom column", "1:5: use of unbound name `y`"
  ﻿x = y

  # The file starts with a UTF-8 byte order mark, which takes no column:
  # `y` is at column 5 of line 1.

  sub main()
    print(x)

test "boolean operators", '''
  true
  true
  false
  false
  true
  evaluated
  true
'''
  # `and`, `or`, and `not` are the boolean operators. `not` binds looser
  # than comparisons (`not a == b` is `not (a == b)`), `and` binds tighter
  # than `or`, and both short-circuit.

  fun loud(v: Bool) -> Bool
    print("evaluated")
    v

  a = 1
  b = 2
  print(not (a == b))
  print(true or false and false)
  print((true or false) and false)
  print(false and loud(true))
  print(true or loud(false))
  print(not false and loud(true))

fail "builtin detached", "3:7: `$` starts a builtin call: `$size(T)`, with the `$` touching the name and the name touching the `(`"
  # A builtin call's `$` touches its name, and the name its `(`.

  print($ size(Int))

test "byte order mark", "1"
  ﻿# A UTF-8 byte order mark at the start of a file is skipped.

  sub main()
    print(1)

test "call positions", '''
  3
  9
  3 7
  4
  1 -6 5 12 8
  big
  3
  2
  1
  2
  4
  two
  0
  10
  12
  11
'''
  # A call takes its parentheses wherever it stands: a statement, an
  # argument, a binding, `return`, a condition, a source, a subject, a
  # match arm, and a closure body.

  fun twice(n: Int) -> Int
    n * 2

  fun add(a: Int, b: Int) -> Int
    a + b

  sub each(n: Int, f: *sub(Int))
    for i in 0..n
      f(i)

  fun quad(n: Int) -> Int
    return twice(twice(n))

  # Statements and arguments.
  print(add(1, 2))
  print((1 + 2) * 3)
  print(add(1, 2), add(3, 4))
  print(twice(twice(1)))
  # Values: bindings, `return`, conditions, sources, and subjects.
  x = twice(5)
  x += twice(1)
  print(1, twice(-3), 5, x, quad(2))
  if twice(x) > 20
    print("big")
  n = 3
  while n > 0: n -= 1
    print(n)
  for i in [twice(1), twice(2)]
    print(i)
  match twice(1)
    2 => print("two")
    _ => print("other")
  # Closure bodies.
  each(2, *|i| print(i * 10))
  (|+x| print(x))()
  print(x - 1)

fail "call without parens", "7:11: unexpected `5`"
  # Every call has parentheses: `twice 5` is not a call, and does not
  # parse.

  fun twice(n: Int) -> Int
    n * 2

  x = twice 5
  print(x)

test "caret xor and box", '''
  6 3 6
  4
'''
  # `^` between two values is XOR; where an operand starts it boxes.

  a = 5
  b = 3
  x = a ^ b
  y = ^b
  z = [a ^ b, 1]
  print(x, y, z[0])
  a ^= 1
  print(a)

