    v: T

fail "guard inside expression", "a postfix `if` guard must end a statement"
  # A postfix `if` guards a whole statement; inside an expression a value
  # needs both branches: `a if c else b`.

  x = 1
  print(x if x > 0)

fail "habit ampersand view", "8:6: unexpected `&`; expected an expression, `)` or a keyword argument; Rig lends with `?x` (to read) or `!x` (to write)"
  # Rust and C take an address or a reference with `&`; Rig views with
  # `?x` to read and `!x` to write.

  sub show(n: ?Int)
    print(n)

  n = 1
  show(&n)

fail "habit braces", "3:12: unexpected `{`; Rig has no braces: a block is the lines indented under its header"
  # A block is the lines indented under its header; Rig has no braces.

  sub main() {
    print(1)
  }

fail "habit class", "3:1: Rig has no `class`; declare a type with `obj`", whole: true
  # A type is declared with `obj`.

  class Point
    x: Int

fail "habit const", "4:1: Rig has no `const`; write `x =! e` for a binding that never changes"
  # `const` is reserved; a binding that never changes is written `x =! e`,
  # and one that shadows `new x =! e`.

  const x = 5
  new const y = x
  print(x, y)

fail "habit def", "4:1: Rig has no `def`; declare a function with `fun`", whole: true
  # A function is declared with `fun` or `sub`; `def` is named where it
  # stands.

  def greet(name: ?String)
    print(name)

fail "habit do", "4:13: Rig has no `do`; a block is the indented lines below the line that opens it"
  # A block needs no `do` or `then`: it is the indented lines below.

  n = 0
  while n < 3 do
    n += 1

fail "habit elif", "6:1: Rig has no `elif`; write `else if`"
  # `elif` is written `else if`.

  n = 1
  if n > 1
    print(1)
  elif n > 0
    print(0)

fail "habit fn", "3:5: Rig has no `fn`; declare a function with `fun`", whole: true
  # Rust's `fn` is named at the word, even after `pub`.

  pub fn add(a: Int, b: Int) -> Int
    a + b

fail "habit import", "3:1: Rig has no `import`; use a module with `use name`", whole: true
  # A module is used with `use`.

  import math

fail "habit let", "3:1: Rig has no `let`; bind a name with `x = 5`, or `x =! 5` for one that never changes"
  # A binding needs no `let`, `var`, or `mut`.

  let mut x = 5
  print(x)

fail "habit loop", "4:1: Rig has no `loop`; write `while true`"
  # An endless loop is `while true`; `loop` is named at the word, not
  # at the block below it.

  loop
    print(1)

fail "habit new const", "5:5: Rig has no `const`; write `x =! e` for a binding that never changes"
  # `new const x = e` is no shadow: `const` is reserved, and a shadow
  # that never changes is written `new x =! e`.

  x = 1
  new const x = x + 1
  print(x)

fail "habit switch", "4:1: Rig has no `switch`; write `match`"
  # Rig's `switch` is `match`.

  n = 1
  switch n
    1 => print(1)

fail "header colon", "5:12: remove the `:`"
  # A block's header ends without a `:`, as a `while` step would begin
  # with one.

  n = 0
  while n < 3:
    n += 1

fail "increment operator", "4:2: Rig has no `++`; write `x += 1`"
  # Rig has no `++`.

  i = 0
  i++
  print(i)

