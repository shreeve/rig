test "results bind", '''
  3 2
  3 1
  1 0
  2 2
  4 1
'''
  # Several results, `-> (A, B)`, given by `return a, b` and bound by
  # name: each name declares or assigns as `x = e` does, `_` discards, and
  # `new` and `=!` work as for one name.

  fun divmod(a: Int, b: Int) -> (Int, Int)
    return a / b, a % b

  fun again(a: Int, b: Int) -> (Int, Int)
    return divmod(a, b)

  q, r = divmod(17, 5)
  print(q, r)
  _, r = divmod(9, 4)
  print(q, r)
  new q, r = divmod(1, 1)
  print(q, r)
  a, b =! again(8, 3)
  print(a, b)
  f = divmod
  x, y = f(9, 2)
  print(x, y)

test "results contexts", '''
  3 2
  4 1
  3 2
  3
'''
  # A destructure stands wherever a statement does: a branch, an arm, a
  # loop's body, a closure's last line, and `new` reads the names it
  # shadows, as `new x = e` does.

  fun divmod(a: Int, b: Int) -> (Int, Int)
    return a / b, a % b

  fun maybe(a: Int, b: Int) -> (Int, Int)?
    return none if b == 0
    return a / b, a % b

  n = 17
  new n, m = divmod(n, 5)
  print(n, m)
  q = 0
  r = 0
  match n
    3 => q, r = divmod(9, 2)
    _ => q, r = divmod(6, 4)
  print(q, r)
  f = |!q, !r|
    q, r = divmod(11, 3)
  f()
  print(q, r)
  if maybe(7, 2) as a, b
    _ = b
    print(a)

