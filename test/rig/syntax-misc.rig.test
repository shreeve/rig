# syntax: the rest of its tests.

fail "and operator spelling", "`&&` is not a Rig operator; use `and`"
  # The boolean operators are `and`, `or`, `not`; `&&` is rejected with a
  # pointer to the Rig spelling.

  a = true
  b = false
  print(a && b)

test "as chain", '''
  3 0 0
  big small small none
  both 1 2
  drop 1
  drop 3
  else 3 2
  else 0 2
  11
  2
  stopped
  22 2
  2 1
'''
  # Optional bindings join with `and`, with Bool conditions among them:
  # each binding is visible in the conditions after it and in the body,
  # and `else` runs when any of them is `none` or false.

  obj Noisy
    id: Int

    drop(!self)
      print("drop", self.id)

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun make(k: Int) -> Noisy?
    Noisy(id: k) if k > 0 else none

  fun sum(a: Int, b: Int) -> Int
    if get(a) as x and get(b) as y
      x + y
    else
      0

  fun pick(a: Int, flag: Bool) -> ?String
    if flag and get(a) as x and x > 3
      "big"
    else if get(a) as x and x > 0
      "small"
    else
      "none"

  sub owned(a: Int, b: Int)
    if make(a) as n and get(b) as y and y > n.id
      print("both", n.id, y)
    else
      print("else", a, b)

  sub bump(o: !(Int?), p: !(Int?))
    if ?o as x and !p as y
      y += x

  print(sum(1, 2), sum(0, 2), sum(1, 0))
  print(pick(5, true), pick(5, false), pick(2, true), pick(0, true))
  owned(1, 2)
  owned(3, 2)
  owned(0, 2)
  o: Int? = 10
  p: Int? = 1
  bump(!o, !p)
  print(p)
  v = if get(4) as x and x % 2 == 0
    x / 2
  else
    -1
  print(v)

  xs: List[Int] = List()
  for n in 1..8
    !xs.push(n)
  seen = 0
  while (!xs).pop() as x and x > 3
    seen += x
  else
    print("stopped")
  print(seen, xs.len)

  first = while (!xs).pop() as x and x > 0
    break x if x == 2
  else
    0
  print(first, xs.len)

fail "as chain scope", "17:4: use of unbound name `y`", "22:9: use of unbound name `x`", "24:40: the loop step cannot use `r`"
  # A binding of a joined condition is visible to the parts after it and
  # to the body, not to the parts before it or to `else`; a loop step
  # cannot use one that owns a resource, which the body drops first.

  obj Res
    id: Int

    drop(!self)
      print(self.id)

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun make(k: Int) -> Res?
    Res(id: k) if k > 0 else none

  if y > 0 and get(1) as y
    print(y)
  if get(1) as x and get(2) as y
    print(x, y)
  else
    print(x)
  i = 0
  while make(i) as r and r.id < 3: print(r.id)
    i += 1

fail "as in ternary or guard", "7:10: `as` binds only in the condition of an `if` or `while` block", "9:13: `as` binds only in the condition of an `if` or `while` block"
  # `as` binds in the condition of an `if` or `while` block, where the
  # block can see the name; a ternary or a postfix guard has no block.

  fun get(k: Int) -> Int?
    k if k > 0 else none

  v = 1 if get(1) as x else 2
  print(v)
  print(3) if get(4) as y and y > 3

fail "as outside condition", "7:5: `as` binds only in the condition of an `if` or `while` block, alone or joined to the rest by `and`", "8:4: `as` binds only in the condition of an `if` or `while` block", "10:8: `as` binds only in the condition of an `if` or `while` block", "12:7: `as` binds only in the condition of an `if` or `while` block"
  # `as` binds only in the condition of an `if` or `while` block, alone or joined to
  # the rest of it by `and`.

  fun get(k: Int) -> Int?
    k if k > 0 else none

  y = get(1) as x
  if get(1) as x or true
    print(1)
  if not get(2) as x
    print(2)
  print(get(3) as z)

