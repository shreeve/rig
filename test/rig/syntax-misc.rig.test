test "negation in loop value", "-3 0 -3 20 -5"
  # A loop's value is used, so `-y` as a `break` value, or as the last
  # line of a loop's `else` block, is negation.

  fun first(y: Int) -> Int
    x = while true
      break match y
        3 => -y
        _ => 0
    x

  fun found(xs: [3]Int, y: Int) -> Int
    x = for v in xs
      break v if v > 10
    else
      -y
    x

  fun counted(y: Int) -> Int
    n = 0
    x = while n < 2 : n += 1
      break -y if n > 5
    else
      -y
    x

  print(first(3), first(4), found([1, 2, 3], 3), found([1, 20, 3], 3), counted(5))

test "negation in value position", '''
  -4
  4
  -5
  5
  -2
'''
  # `-x` is negation wherever a line's value is used: the last line of a
  # `fun`, or of an `if` or `match` branch whose value is used.

  enum Sign
    plus
    minus

  fun pick(c: Bool, x: Int) -> Int
    y = if c
      -x
    else
      x
    y

  fun apply(s: Sign, n: Int) -> Int
    match s
      .plus
        n
      .minus
        -n

  fun tail(x: Int) -> Int
    -x + 1

  print(pick(true, 4))
  print(pick(false, 4))
  print(apply(.minus, 5))
  print(apply(.plus, 5))
  print(tail(3))

