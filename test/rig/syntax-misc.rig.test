  # `=!` is one token, so the source does not say which, and it is
  # rejected.

  y = 1
  x =!y
  print(x)

test "fixed binding forms", '''
  80 43
  9 true
'''
  # `x =! e` binds a fixed local, with or without a type, and `new x =! e`
  # shadows with one. `=!` lexes as one token only before a space, so
  # `x =! !y` is a fixed binding of the write lend `!y`, and `x != y`
  # compares.

  a =! 40
  b: Int =! a + 2
  new a =! a * 2
  new b: Int =! b + 1
  print(a, b)
  xs = [1, 2, 3]
  w =! !xs
  w[0] = 9
  print(xs[0], a != b)

test "float exponent literals", "10.0 2.0 150.0 300.0 225"
  # Float literals may carry a decimal exponent: `1.0e10`, `2e-3`, `1.5E+2`.
  # A hex literal's `e` is a digit, not an exponent.

  big = 1.0e10
  small = 2e-3
  mid = 1.5E+2
  typed: Float = 3e2
  hex = 0xE1
  print(big / 1e9, small * 1000.0, mid, typed, hex)

test "for bare", release: true, '''
  range 3
  list 4
  read 4
  made 5
  lent 8 3
  rest 10 -1
  name 10
  nested 12
  jumps 5
  label 9
  else 11
  12
  taken 3
  var 0
  var 1
  10 0
  20 1
  30 2
  40 3
'''
  # `for xs` with no variable is `for _ in xs`: it runs the body once per
  # item and binds nothing, over any source `for x in xs` takes. `it` is
  # an ordinary name. `break`, `continue`, labels, `else` and loop values
  # work as they do with a variable.

  obj Count
    lo: Int
    hi: Int

    fun next(!self) -> Int?
      return none if self.lo >= self.hi
      self.lo += 1
      self.lo - 1

  fun upto(n: Int) -> Count
    Count(lo: 0, hi: n)

  hits = 0
  for 0..3
    hits += 1
  print("range", hits)

  xs = [10, 20, 30, 40]
  hits = 0
  for xs
    hits += 1
  print("list", hits)

  hits = 0
  for ?xs
    hits += 1
  print("read", hits)

  hits = 0
  for upto(5)
    hits += 1
  print("made", hits)

  c = upto(6)
  for !c
    break if hits > 100
    hits += 1
    break if hits > 7
  print("lent", hits, (!c).next() ?? -1)
  for !c
    hits += 1
  print("rest", hits, (!c).next() ?? -1)

  it = 5
  for 0..it
    it += 1
  print("name", it)

  hits = 0
  for 0..3
    for 0..4
      hits += 1
  print("nested", hits)

  hits = 0
  for 0..10
    hits += 1
    continue if hits < 3
    break if hits == 5
  print("jumps", hits)

  @outer for 0..3
    for 0..3
      hits += 1
      continue @outer if hits > 6
  print("label", hits)

  for upto(2)
    hits += 1
  else
    print("else", hits)

  for 0..9
    break
  else
    print("never")

  r = for 0..4
    hits += 1
    break hits if hits > 10
  else
    -1
  print(r)

  e = upto(3)
  hits = 0
  for <e
    hits += 1
  print("taken", hits)

  for n in 0..2
    print("var", n)
  for x, i in xs
    print(x, i)

test "for iterator", release: true, '''
  resumed at 3
  rest 4
  rest 5
  ran out
  5 -1
  0 0
  1 0
  1 1
  2 0
  2 1
  2 2
  30
  10 -1
  took 0
  took 1
  took 2
  6
'''
  # `for x in it`, where `it` has `next(!self) -> T?`, is
  # `while (!it).next() as x`: the loop advances `it` where it stands, so
  # an iterator a `break` leaves is still there to resume. A source made
  # there (`upto(3)`), or a place the loop takes (`<it`), is held in a
  # hidden binding for the loop. `else`, `break` values, labels and loop
  # values work as they do for `while … as`.

  obj Count
    lo: Int
    hi: Int

    fun next(!self) -> Int?
      return none if self.lo >= self.hi
      self.lo += 1
      self.lo - 1

  fun upto(n: Int) -> Count
    Count(lo: 0, hi: n)

  fun first_over(k: Int) -> Int
    for n in upto(10)
      break n if n > k
    else
      -1

  fun drain(it: !Count) -> Int
    total = 0
    for n in !it
      total += n
    total

  c = upto(6)
  for n in !c
    break if n == 2
  print("resumed at", (!c).next() ?? -1)
  for n in !c
    print("rest", n)
  else
    print("ran out")
  print(first_over(4), first_over(20))

  @outer for a in upto(3)
    for b in upto(3)
      continue @outer if b > a
      print(a, b)

  r = for n in upto(5)
    break n * 10 if n == 3
  else
    -1
  print(r)
  d = upto(5)
  print(drain(!d), (!d).next() ?? -1)

  e = upto(3)
  for n in <e
    print("took", n)
  s = 0
  for n in upto(4)
    s += n
  print(s)

fail "for iterator signature", "31:10: cannot iterate over `Reads`: a `for` walks a type with `next(!self) -> T?`, but its `next` takes `?self`", "34:10: cannot iterate over `Wants`: a `for` walks a type with `next(!self) -> T?`, but its `next` takes more than `self`", "37:10: cannot iterate over `Plain`: a `for` walks a type with `next(!self) -> T?`, but its `next` does not give an optional", "40:10: cannot iterate over `Free`: a `for` walks a type with `next(!self) -> T?`, but its `next` takes no `self`", "42:10: cannot iterate over `Int`; a `for` source must be a range `a..b`, an array, a `?String`, a `List`, or an iterator (a type with `next(!self) -> T?`)", errors: 5
  # A `for` walks a type whose `next` is `next(!self) -> T?`: a `next`
  # that takes `?self`, takes more, or gives no optional is not one, and
  # a loop over such a type says why. Plain `List`, array and `?String`
  # sources keep their own meaning.

  obj Reads
    n: Int

    fun next(?self) -> Int?
      none

  obj Wants
    n: Int

    fun next(!self, step: Int) -> Int?
      none

  obj Plain
    n: Int

    fun next(!self) -> Int
      self.n

  obj Free
    n: Int

    fun next() -> Int?
      none

  a = Reads(n: 0)
  for x in a
    print(x)
  b = Wants(n: 0)
  for x in b
    print(x)
  c = Plain(n: 0)
  for x in c
    print(x)
  d = Free(n: 0)
  for x in d
    print(x)
  for x in 3
    print(x)

fail "for iterator source", "29:10: a `for` advances an iterator named by a name or a field path (`it`, `a.b`); bind `xs[0]` to a name first", "31:11: a `for` advances an iterator named by a name or a field path (`it`, `a.b`); bind `xs[1]` to a name first", "33:11: a `for` advances an iterator named by a name or a field path (`it`, `a.b`); bind `xs[0]` to a name first", "35:10: a `for` walks an iterator that is a place or a value made here; bind `mk().a` to a name first", "37:10: a `for` walks an iterator that is a place or a value made here; bind `p.a if c.lo > 0 else p.b` to a name first", "39:11: `for n in ?p.a` would only read an iterator, which `next` cannot advance; write `for n in !p.a` to advance it in place", "41:11: a `for` walks an iterator that is a place or a value made here; bind `mk().a` to a name first", "43:11: `!mk_count()` advances a place, and this is a value made here; write `for n in mk_count()`, which holds it for the loop", "45:8: an iterator has no index binding; keep a count in the loop: `for n in !c`", errors: 9
  # What a `for` over an iterator can walk: a name or a field path it
  # advances where it stands (written `!`), a value made there, or a place it takes with
  # `<`. An element, a read lend, a part of a made value, a branching
  # value, and `!` of a value made there cannot be advanced, and an
  # iterator has no index binding.

  obj Count
    lo: Int
    hi: Int

    fun next(!self) -> Int?
      return none if self.lo >= self.hi
      self.lo += 1
      self.lo - 1

  obj Pair
    a: Count
    b: Count

  fun mk() -> Pair
    Pair(a: Count(lo: 0, hi: 1), b: Count(lo: 0, hi: 1))

  fun mk_count() -> Count
    Count(lo: 0, hi: 1)

  p = Pair(a: Count(lo: 0, hi: 1), b: Count(lo: 0, hi: 1))
  xs = [Count(lo: 0, hi: 1), Count(lo: 0, hi: 1)]
  c = Count(lo: 0, hi: 2)
  for n in xs[0]
    print(n)
  for n in !xs[1]
    print(n)
  for n in <xs[0]
    print(n)
  for n in mk().a
    print(n)
  for n in p.a if c.lo > 0 else p.b
    print(n)
  for n in ?p.a
    print(n)
  for n in !mk().a
    print(n)
  for n in !mk_count()
    print(n)
  for n, i in c
    print(n, i)

test "for lent made iterator", '''
  4
  5
  40
  8
  9
  10
  9
  10
  11
  10
  11
  12
  4
  5
  6
  15
  [4, 5, 6, 1]
  drained 3
  drained 2
  drained 1
  drained 0
  0
'''
  # The `?` before a `for` loop's source that is a method call reaches the
  # call's receiver, as before any call (`?b.each()` is `(?b).each()`),
  # and the loop holds the iterator the call makes, which keeps `b` lent
  # to read for the loop. A method that writes its receiver is called
  # with the `!` in parentheses, `(!b).drain()`, as any write call whose
  # value is used is.

  obj Cur
    xs: ?List[Int]
    i: Int

    fun next(!self) -> Int?
      return none if self.i >= self.xs.len
      self.i += 1
      self.xs[self.i - 1]

  obj Count
    n: Int

    fun next(!self) -> Int?
      return none if self.n == 0
      self.n -= 1
      self.n

  obj Bag
    xs: List[Int]

    fun drain(!self) -> Count
      n = self.xs.len
      !self.xs.clear()
      Count(n: n)

    fun each(?self) -> Cur from self
      Cur(xs: ?self.xs, i: 0)

  obj Shelf
    bag: Bag

  b = Bag(xs: List())
  !b.xs.push(4)
  !b.xs.push(5)
  for x in ?b.each()
    print(x)
  for x in ?b.each()
    print(x * 10)
    break
  !b.xs.push(6)
  for x in ?b.each()
    for y in ?b.each()
      print(x + y)
  s = Shelf(bag: <b)
  for x in ?s.bag.each()
    print(x)
  total = 0
  for x in ?s.bag.each()
    total += x
  print(total)
  !s.bag.xs.push(1)
  print(s.bag.xs)
  for x in (!s.bag).drain()
    print("drained", x)
  print(s.bag.xs.len)

fail "for ptr binding reserved", "`for *x in` is reserved"
  # `for *x in v` (by-reference loop binding) is reserved and does not
  # parse; iterate with `for x in v`, `?v`, or `!v`.

  v: List[Int] = List()
  !v.push(1)
  for *x in v
    print(x)

test "fun ends with endless loop", "8"
  # A function may end with a `while true` loop that it leaves only by
  # `return`.

  fun first_over(limit: Int) -> Int
    x = 0
    while true : x += 1
      if x * x > limit
        return x

  print(first_over(50))

test "function markers", release: true, '''
  7 8 3
  count 3
  6 15 2
  note 1
  7 20 15 502 2
  0
  7 7 7
  9 b 12 20 5 6
'''
  # `inline`, `called`, and `rarely` mark a function before its `fun` or
  # `sub`: a module's function, a public one, a method in its type's body or
  # outside it, and a function with compile-time parameters. They ask for a
  # speed and change no meaning, and anywhere else each word is a name. A
  # `called` function, always a real call, may be passed as a value.

  inline fun add(a: Int, b: Int) -> Int
    a + b

  rarely sub report(what: ?String, n: Int)
    print(what, n)

  pub inline fun double(x: Int) -> Int
    x * 2

  pub rarely fun fallback(x: Int) -> Int
    x - 1

  called fun triple(x: Int) -> Int
    x * 3

  pub called sub note(n: Int)
    print("note", n)

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  obj Counter
    n: Int
    inline: Int

    inline fun get(?self) -> Int
      self.n + self.inline

    rarely sub reset(!self)
      self.n = 0

    called fun total(?self) -> Int
      self.n * 100 + self.inline

    fun rarely(?self) -> Int
      self.inline * 10

  inline fun Counter.bumped(?self, by: Int) -> Int
    self.n + by

  rarely sub Counter.clear(!self)
    self.inline = 0

  called fun Counter.half(?self) -> Int
    self.n / 2

  obj Wrap[T]
    value: T

    inline fun get(?self) -> T
      self.value

  rarely fun Wrap[T].peek(?self) -> T
    self.value

  called fun Wrap[T].same(?self) -> T
    self.value

  inline fun larger[T](a: T, b: T) -> T
    a if a > b else b

  rarely fun scaled[k: Int](x: Int) -> Int
    x * k

  called fun shifted[k: Int](x: Int) -> Int
    x + k

  fun rarely(inline: Int) -> Int
    called = inline + 1
    called

  sub main()
    inline = 3
    rare = rarely(inline)
    print(add(inline, rare), double(rare), fallback(rare))
    report("count", inline)
    print(triple(2), apply(triple, 5), apply(fallback, 3))
    note(1)
    c = Counter(n: 5, inline: 2)
    print(c.get(), c.rarely(), c.bumped(10), c.total(), c.half())
    !c.reset()
    !c.clear()
    print(c.get())
    w = Wrap[Int](value: 7)
    print(w.get(), w.peek(), w.same())
    print(larger(3, 9), larger("a", "b"), scaled[3](4), scaled[5](4), shifted[1](4), shifted[2](4))

fail "function type arg in expression", "4:11: a function type has no expression spelling"
  # A function type has no expression spelling, so it cannot be a type
  # argument in an expression.

  v = List[*fun(Int) -> Int]()

fail "function type suffix", "4:13: unexpected `?`; a function type takes no suffix; write `(*sub(Int))?`"
  # A function type takes no suffix: an optional one, or an optional owned
