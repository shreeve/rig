  # string, a negation, or a list, it is named with the fix.

  print -1

fail "print bare string", "3:7: unexpected `\"hi\"`; `print` is called with parentheses: `print(...)`"
  # `print "hi"` is not a call; the error names the fix.

  print "hi"

