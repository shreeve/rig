fail "definition without params", "4:5: write `sub main()`: a function's parameter list is always written, even when empty", errors: 1
  # A function writes its parameter list, even when empty, as its calls
  # (`main()`) and its type (`sub()`) do; the fix-it shows the header.

  sub main
    print(1)

fail "definition without params each", "4:5: write `fun answer() -> Int`: a function's parameter list is always written, even when empty", "10:7: write `fun get() -> Int`", "13:5: write `sub main()`", errors: 3
  # Every definition that leaves out its parameter list is reported, each
  # with its own header to write, so one run shows them all.

  fun answer -> Int
    42

  obj Box
    n: Int

    fun get -> Int
      1

  sub main
    print(answer())

fail "definition without params extern", "4:12: write `extern sub halt()`: a function's parameter list is always written, even when empty", errors: 1
  # A declared C function writes its parameter list too, and a failing
  # `sub` puts its `!` after it.

  extern sub halt

  print(1)

fail "definition without params fails", "7:5: write `sub save()!`: a function's parameter list is always written, even when empty", errors: 1
  # A failing `sub` without a parameter list: the `!` goes after the
  # `()`.

  error Oops
    bad

  sub save!
    raise()!

  sub raise()!
    return Oops.bad

  sub main()!
    save()!

fail "definition without params method", "7:11: write `fun get[T]() -> T?`: a function's parameter list is always written, even when empty", errors: 1
  # A method with compile-time parameters and no run-time ones still
  # writes `()`: after its brackets, as a call does (`w.get[Int]()`).

  obj Wrap
    n: Int

    pub fun get[T] -> T?
      none

  w = Wrap(n: 1)
  print(w.n)

fail "definition without params result", "4:5: write `fun answer() -> Int`: a function's parameter list is always written, even when empty", errors: 1
  # A `fun` without a parameter list: the fix-it puts `()` before the
  # result type.

  fun answer -> Int
    42

  print(answer())

fail "detached prefix arrow", "7:10: a prefix `-` touches its operand: write `-b`"
  # Rig has no `<-`: `a <- b` is `a <` and then a `-` that does not touch
  # its operand. `a < -b` compares with a negation.

  a = 1
  b = 2
  print(a < -b)
  print(a <- b)

fail "detached prefix box", "4:4: a prefix `^` touches its operand: write `^Int`"
  # A box sigil touches what it boxes, in a type: `^ Int` could be XOR,
  # so it is rejected rather than read.

  b: ^ Int = ^1
  print(b)

fail "detached prefix box value", "4:5: a prefix `^` touches its operand: write `^2`"
  # A box sigil touches what it boxes, in an expression: `^ 2` could be
  # XOR, so it is rejected rather than read.

  c = ^ 2
  print(c)

fail "detached prefix clone", "4:5: a prefix `+` touches its operand: write `+h`"
  # A clone is written against its operand: `+h`.

  h = *Cell(1)
  g = + h
  print(g.get(), h.get())

fail "detached prefix drop", "4:1: a prefix `<` touches its operand: write `<v`"
  # A drop statement is written against the dropped name: `<v`.

  v = List[Int]()
  < v
  print(1)

fail "detached prefix element type", "5:8: a prefix `?` touches its operand: write `?Int`"
  # After a type's `]`, a sigil starts the element type, and touches it as
  # any prefix sigil does.

  n = 1
  xs: [1]? Int = [?n]
  print(xs[0])

fail "detached prefix minus", "6:5: a prefix `-` touches its operand: write `-b`"
  # A prefix sigil touches its operand: `- b` is rejected, while an
  # infix `-` is written with any spacing.

  a = 1
  b = 2
  c = - b
  print(a -b, c)

fail "detached prefix move", "7:6: a prefix `<` touches its operand: write `<n`"
  # A move is written against the moved name: `<n`.

  sub take(n: Int)
    print(n)

  n = 1
  take(< n)

fail "detached prefix read", "7:6: a prefix `?` touches its operand: write `?n`"
  # A read view is written against its operand: `?n`.

  sub show(n: ?Int)
    print(n)

  n = 1
  show(? n)

fail "detached prefix type", "4:4: a prefix `*` touches its operand: write `*Cell`"
  # In a type as in an expression, a handle or lend sigil touches the
  # type it applies to.

  x: * Cell[Int] = *Cell(0)
  print(x.get())

fail "detached prefix weak", "4:5: a prefix `~` touches its operand: write `~h`"
  # A weak handle is written against its operand: `~h`.

  h = *Cell(1)
  w = ~ h
  print(*w != none)

fail "detached prefix write", "7:6: a prefix `!` touches its operand: write `!n`"
  # A write view is written against its operand: `!n`.

  sub bump(n: !Int)
    n += 1

  n = 1
  bump(! n)
  print(n)

test "digit separators", "1000000 65535 170 63 1000.5"
  # `_` may separate digits in any number; radix prefixes are lowercase.

  print(1_000_000, 0xff_ff, 0b1010_1010, 0o7_7, 1_000.5)

test "discard write call", "2"
  # `_ =` discards the value, so a write call there is a statement's and
  # keeps its short form `!v.pop()`; the parenthesized form still works.

  v: List[Int] = List()
  for i in 0..5
    !v.push(i)
  _ = !v.pop()
  _ = (!v).pop()
  _ = !v.remove(0)
  print(v.len)

fail "dot chain needs deeper line", "4:1: variant `.abs(...)` needs a known enum type; annotate the binding"
  # A leading `.` line at the statement's own indentation is a new statement.

  x = 5
  .abs()
  print(x)

fail "dot chain not after arm", "11:8: `.blue` is an enum variant, but the expected type `Int` is not an enum"
  # The body of a match arm written below its pattern is a block, so a
  # `.variant` line there is a statement of that block, not a chain.

  enum Color
    red
    blue

  fun f(c: Color) -> Int
    match c
      .red
        .blue
      .blue => 2

  print(f(.red))

fail "dot chain not after header", "5:4: `.abs` is an enum variant, but the expected type `Int` is not an enum"
  # A leading-dot line under a line that opens a block is the block's first
  # line, not a continuation: here a variant expression, which has no type.

  fun f() -> Int
    .abs()

  print(f())

fail "dot chain not in members", "5:5: unexpected indentation"
  # A member list holds fields and methods: a deeper `.` line is not a chain.

  obj P
    x: Int
      .abs()

  pass

test "drop decl body", '''
  0
  7
'''
  # A struct's `drop(!self)` body runs at scope exit and can read
  # `self`'s fields.

  obj File
    fd: Int

    drop(!self)
      print(self.fd)

  f: File = File(fd: 7)
  print(0)
  # scope exit runs the drop body, which prints the fd

test "drop decl long receiver", '''
  3
  b 2
  a 1
'''
  # A `drop` receiver may be spelled as a method's is: `drop(!self)` or
  # `drop(self: !Self)`, which may name the struct.

  obj A
    n: Int

    drop(self: !Self)
      print("a", self.n)

  obj B
    n: Int

    drop(self: !B)
      print("b", self.n)

  a = A(n: 1)
  b = B(n: 2)
  print(a.n + b.n)

fail "drop receiver without parens", "6:8: a drop body takes its receiver in parentheses: `drop(!self)`"
  # A `drop` body takes its receiver in parentheses, like a method.

  obj File
    fd: Int

    drop self: !Self
      print(self.fd)

fail "drop statement lend", "11:1: this expression does nothing as a statement: `<?a` moves a view nowhere, and a view owns nothing to drop", "12:1: this expression does nothing as a statement: `<!a` moves a view nowhere, and a view owns nothing to drop", errors: 2
  # A statement `<?a` or `<!a` moves a view nowhere. A view owns nothing,
  # so the statement does nothing, and is rejected; `<a` drops `a`.

  obj F
    n: Int

    drop(!self)
      print("drop", self.n)

  a = F(n: 1)
  <?a
  <!a
  print("end")

fail "drop statement plain data", "18:1: `<n` drops nothing: `n` is plain data", "19:1: `<x` drops nothing: `x` is plain data", "20:1: `<p` drops nothing: `p` is plain data", "21:1: `<o` drops nothing: `o` is plain data", "22:1: `<k` drops nothing: `k` is plain data", errors: 5
  # A statement `<x` releases what `x` owns or ends the loans it holds;
  # plain data that holds no view owns nothing and carries no loan, so
  # dropping it does nothing. (A String may view a Text: dropping one is
  # accepted, in behavior/ownership/drop_ends_string_view.rig.)

  obj P
    x: Int

  enum Color
    red
    green

  n = 1
  x = 2.5
  p = P(x: 1)
  o: Int? = 1
  k = Color.red
  <n
  <x
  <p
  <o
  <k if true
  print("end")

test "else after block", '''
  one, flagged
  one
  not one
  else if
'''
  # A line starting with `else` continues the `if` (or `while` / `for`)
  # whose block just closed, even inside a match arm; the arm after it
  # starts with its own pattern.

  enum Kind
    one
    two
    three

  sub show(k: Kind, flag: Bool)
    match k
      .one
        if flag
          print("one, flagged")
        else
          print("one")
      _
        print("not one")

  show(.one, true)
  show(.one, false)
  show(.three, true)
  if false
    print("no")
  else if true
    print("else if")
  else
    print("else")

fail "empty type args", "3:10: empty brackets: give the compile-time arguments, as in `List[Int]()`"
  # Brackets of compile-time arguments are never empty.

  v = List[]()

test "enum literal after return", '''
  1
  2
'''
  # `return .red` returns the enum literal `.red` of the declared return
  # type, and a match covering every variant needs no default arm.

  enum Color
    red
    green

  fun pick(b: Bool) -> Color
    if b
      return .red
    return .green

  match pick(true)
    .red => print(1)
    .green => print(2)
  match pick(false)
    .red => print(1)
    .green => print(2)

test "explicit shadow", "2"
  # `new x = ...` explicitly shadows an existing binding.

  x = 1
  new x = x + 1
  print(x)

