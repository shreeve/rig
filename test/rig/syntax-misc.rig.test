test "unique is a name", "3 6 true true true 3 8"
  # `unique` is a keyword only after a struct header's name or type
  # parameters, where it declares the struct unique (`obj Random unique`).
  # Everywhere else it is an ordinary name.

  obj Seed unique
    value: Int

  pub obj Ring[T] unique
    item: T

  obj Flags
    unique: Bool

    fun only(?self, unique: Bool) -> Bool
      self.unique and unique

  enum Mode
    unique
    shared

  fun twice(unique: Int) -> Int
    unique * 2

  unique = 3
  f = Flags(unique: true)
  m = Mode.unique
  s = Seed(value: unique)
  r = Ring(item: twice(unique: 4))
  print(unique, twice(unique), f.unique, f.only(unique: true), m == .unique, s.value, r.item)

fail "unreachable after jump", "unreachable code: this statement follows a `return`", "unreachable code: this statement follows a `break`", "unreachable code: this statement follows a `continue`"
  # A statement right after `return`, `break`, or `continue` never runs.

  fun f() -> Int
    return 1
    2

  for i in 0..3
    break
    print(i)
  while true
    continue
    print("x")
  print(f())

fail "unterminated string", "4:5: unterminated string", errors: 1
  # A string literal with no closing quote is reported as unterminated at
  # its line and column.

  x = "abc
  print(x)

fail "untyped closure last line", "17:5: so `<q` here is no drop, and this closure gives no value; to drop `q` here, write `_ = <q`"
  # An untyped closure (`go = || ...`) takes its last line as its value,
  # and so does the last line of a branch that ends it, so `<q` there is
  # no drop: the closure gives no value, and the line says what to write.
  # (A closure whose type returns nothing treats its last line as a
  # statement: test/behavior/syntax/closure_no_value_tail.rig.)

  obj F
    n: Int

    drop(!self)
      print("drop", self.n)

  go = ||
    q = F(n: 1)
    if q.n > 0
      print(q.n)
      <q
  go()

test "utf8 bom", "bom skipped"
  ﻿# A byte order mark at the start of the file is skipped: this file
  # begins with the bytes EF BB BF.
  sub main()
    print("bom skipped")

fail "warn bare name", "4:6: `warn` is called with parentheses: `warn(-1)`"
  # `warn` is only a call: written without its parentheses, before a
  # string, a negation, or a list, it is named with the fix.

  warn -1

fail "warn bare string", "3:6: unexpected `\"hi\"`; `warn` is called with parentheses: `warn(...)`"
  # `warn "hi"` is not a call; the error names the fix.

  warn "hi"

test "while header jump label", '''
  0
  12
  3 4
  11
'''
  # A jump in a `while` header may name a label: `@outer` is a label after
  # `break` or `continue`, and the header's `:` still starts the step.

  fun more(n: Int) -> Bool?
    n > 0 if n < 9 else none

  n = 3
  @outer while true
    while more(n) ?? break @outer
      n -= 1
    print(n)
    n = 12
    while more(n) ?? continue @outer
      n -= 1
  print(n)
  i = 0
  k = 0
  @rows while i < 4 : i += 1
    j = 0
    while (more(i * 4 - j) ?? break @rows) and j < 2 : j += 1
      k += 1
  print(i, k)
  m = 0
  @a while m < 5 : m += 1
    while more(m) ?? break @a : m += 10
      pass
  print(m)

fail "while step declares", "5:15: a `while` step runs after the body, so it cannot declare `x`; declare it before the loop"
  # A `while` step runs after the body, so a name it declared would be
  # seen by the body before it has a value.

  i = 0
  while i < 3 : x = i
    print(x)
    i += 1

fail "while step not a call", "4:15: a `while` step is an assignment or a call"
  # A `while` step is an assignment or a call.

  j = 0
  while j < 2 : j
    j += 1

fail "while step not assignment", "5:15: unexpected keyword `break`; expected an assignment or a call"
  # A `while` step is an assignment or a call, run after each iteration;
  # any other statement there is an error.

  x = 0
  while x < 3 : break
    x += 1

test "whitespace insensitive", '''
  6 6 8 -21
  21 21 10 10 false false false
  10 10 10
  20 20 1
  3 3
  .green true -7 -7
  [0, 0, 0] 3
  1 1 [20, 30] [20, 30]
  4 4 none
  7 7 3
'''
  # A character that several forms share is read by position, not by
  # spacing. After a value it continues the value (an infix operator, a
  # call, an index, a member, a suffix); anywhere else it starts an operand
  # (a prefix sigil, grouping, an array literal, an enum literal, a
  # closure's bar list). An infix operator may be spaced on both sides or
  # neither, and a space before a call's or an index's bracket changes
  # nothing; the spacing that would read two ways is rejected, in
  # reject/syntax/unbalanced_spacing.rig.

  N = 4

  enum Color
    red
    green

  obj Wrap[T]
    v: T

    fun get(?self) -> T
      self.v

  fun twice(n: Int) -> Int
    n * 2

  fun maybe(n: Int) -> Int?
    n if n > 0 else none

  fun half(n: Int) -> Int?
    m = maybe(n)?
    m / 2

  sub main()
    a = 7
    b = 3
    print(a - 1, a-1, a - -1, a*-b)
    print(a * b, a*b, a + b, a+b, a < b, a<b, a<-b)
    print(twice(5), twice(5), (twice)(5))
    xs = [10, 20, 30]
    print(xs[1], xs[1], [1, 2][0])
    w = Wrap[Int](v: 3)
    print(w.get(), w.get())
    c: Color = .green
    print(c, c == .green, -a, 0 - a)
    s: [N - 1]Int = [N-1 of 0]
    print(s, s.len)
    v = List[Int]()
    !v.push(1)
    print(v.len, v[0], xs[1 .. 3], xs[1..])
    f = | +b , x : Int | x + b
    print(f(1), half(8), half(-1))
    print(a | b, a|b, a & b)

fail "zig block reserved", "unexpected keyword `zig`", "inline Zig is reserved"
  # Inline `zig "..."` source splicing is reserved and does not parse;
  # `raw` blocks and `extern` declarations are the escape hatches.

  zig "const x = 42; std.debug.print(\"{any}\\n\", .{x});"
