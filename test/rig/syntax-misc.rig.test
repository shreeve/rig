test "sigil after bracket", '''
  6 6 1
  3 none
  7 1 1
'''
  # A sigil after a `]` is read by what the parser expects there, never by
  # spacing: in an expression it continues the value (`[3][0]*a` is
  # `[3][0] * a`, `[a, b][1]?` a suffix), and in a type it starts the
  # element type (`[2][3]?Int`, `[2](Int?)`, `[]?(Int?)`).

  fun second(a: Int?, b: Int?) -> Int?
    x = [a, b][1]?
    x + 1

  fun count(xs: []?(Int?)) -> Int
    n = 0
    for x in xs
      n += 1 if x != none
    n

  a = 2
  print([3][0]*a, [3][0] * a, [3][0]-a)
  print(second(1, 2), second(1, none))
  n = 7
  d: [2][3]?Int = [[?n, ?n, ?n], [?n, ?n, ?n]]
  e: [2](Int?) = [1, none]
  f: Int? = 4
  g: [2]?(Int?) = [?f, ?e[1]]
  print(d[1][2], e[0], count(?g[..]))

test "sigil spacing", '''
  false
  14
  9
  1
  5
  -3
  8
  10
  10
  1
'''
  # The same character is an infix operator when spaced (`a < x`, `a * b`,
  # `a + b`, `a % b`, `a - b`) and an ownership sigil when tight against its
  # operand at expression start (`<s`, `*Wrap`, `+s`, `?box`). `-x` is
  # negation, and `<x` alone on a line drops `x`; `$name(...)` is a
  # builtin call.

  obj Wrap
    v: Int

  fun show(b: ?Wrap) -> Int
    b.v

  a = 7
  b = 2
  x = 3
  print(a < x)
  print(a * b)
  print(a + b)
  print(a % b)
  print(a - b)
  y = -x              # negation
  print(y)
  print($size(Wrap)) # builtin call
  s = *Wrap(v: 10)     # share
  t = +s              # clone
  u = <s              # move
  print(u.v)
  <u                  # drop statement
  print(t.v)
  box = Wrap(v: 1)
  print(show(?box))   # read view

test "sigils before calls", '''
  0
  3 true
  -4 -5
  6
  1
  pair
  1 4
'''
  # Only `?`, `!`, and `<` reach a method's receiver. The other prefix
  # sigils, and `?` / `!` / `<` before a place with no method call after
  # it, apply to the whole expression; `?(p.m())` views a call's result.

  obj Point
    x: Int
    fun origin() -> Point
      Point(x: 0)
    fun shifted(?self, d: Int) -> Point
      Point(x: self.x + d)

  obj Leaf
    n: Int

  obj Tree
    leaf: *Leaf
    fun first(?self) -> ?*Leaf
      ?self.leaf

  obj Pair
    v: List[Int]
    name: (?String)?

  sub fill(v: !List[Int])
    !v.push(1)

  sub show(p: ?Point)
    print(p.x)

  shared = *Point.origin()
  print(shared.x)
  tree = Tree(leaf: *Leaf(n: 3))
  copy = +tree.first()
  weak = ~copy
  print(copy.n, *weak != none)
  p = Point(x: 4)
  print(-p.x, -p.shifted(1).x)
  show(?(p.shifted(2)))
  pair = Pair(v: List(), name: "pair")
  fill(!pair.v)
  print(pair.v.len)
  name = <pair.name
  print(name)
  xs = [1, 2, 3]
  first = ?xs[0]
  q = <p
  print(first, q.x)

