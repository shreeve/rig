fail "pass as value", "6:10: `pass` does nothing and has no value", "10:3: this `pass` produces none", "14:3: `pass` does nothing and has no value", "19:8: `pass` does nothing and has no value", errors: 4
  # `pass` does nothing and has no value: a match arm, an `if` branch, or
  # a block whose value is used cannot end with it.

  fun sign(n: Int) -> Int
    match n
      0 => pass
      _ => 1

  fun twice(n: Int) -> Int
    pass

  a = 1 if true else 2
  x = if a > 0
    pass
  else
    2
  y = match a
    1 => 10
    _ => pass
  print(sign(0), twice(1), x, y)

test "pass statement", '''
  red
  0
  3
  small
  three
  before
  after
'''
  # `pass` is a statement that does nothing: a match arm, a loop body, an
  # `if` branch, or a `sub` body with no work to do. Like any simple
  # statement it takes a postfix guard.

  enum Color
    red
    green
    blue

  obj Countdown
    n: Int

    fun next(!self) -> Int?
      return none if self.n == 0
      self.n -= 1
      self.n

  sub nothing()
    pass

  sub name(c: Color)
    match c
      .red => print("red")
      _ => pass

  nothing()
  name(.red)
  name(.blue)
  c = Countdown(n: 3)
  while (!c).next() as _
    pass
  print(c.n)
  i = 0
  while i < 3 : i += 1
    pass
  print(i)
  for _ in 0..2
    pass
  if i > 5
    pass
  else
    print("small")
  match i
    3
      pass
      print("three")
    _ => pass
  if i == 3
    print("before")
    pass
    print("after")
  pass if i > 1
  defer pass

fail "pin sigil reserved", "the pin sigil `@x` is reserved"
  # The `@x` pin sigil is reserved: pinning has no semantics yet, so a
  # tight `@` before a name (not a label) is a lexical error.

  x = 42
  p = @x
  print(p)

test "postfix guard", '''
  5
  4
'''
  # `stmt if cond` runs the statement only when `cond` holds. Any simple
  # statement takes a guard: a call, `return`, `break`.

  fun first_big(limit: Int) -> Int
    i = 0
    while i < 100
      i += 1
      break if i > limit
    return i

  x = 5
  print(x) if x > 3
  print(99) if x > 9
  print(first_big(3))

