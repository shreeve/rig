fail "minus statement drop hint", "13:3: this expression does nothing as a statement: `-x` negates a value and discards it; a view parameter is not dropped, since the caller owns what it views", "19:1: this expression does nothing as a statement; to drop `v` now, write `<v`", "20:1: this expression does nothing as a statement; to drop `s.o` now, write `<s.o`", "21:1: this expression does nothing as a statement; `s.r` is dropped with what holds it, or replaced by assigning to it", "22:1: this expression does nothing as a statement: `-a[0]` negates a value and discards it", "23:1: this expression does nothing as a statement: `-s.n` negates a value and discards it", errors: 6
  # A statement `-x` negates `x` and throws the result away, so it does
  # nothing. Where `x` owns or views something, the diagnostic says how to
  # drop it: `<x` for a binding or an optional field or element, which `<`
  # takes; any other field or element is dropped with what holds it. A
  # view parameter is not dropped: the caller owns what it views.

  obj S
    r: List[Int]
    o: List[Int]?
    n: Int

  sub look(x: ?List[Int])
    -x

  look(List[Int]())
  s = S(r: List(), o: none, n: 1)
  v: List[Int] = List()
  a = [1, 2]
  -v
  -s.o
  -s.r
  -a[0]
  -s.n
  print(s.n, a, v.len)

fail "minus statement negates", "14:3: this expression does nothing as a statement: `-f()` negates a value and discards it", "20:1: this expression does nothing as a statement: `-f()` negates a value and discards it", "21:1: this expression does nothing as a statement: `-(a + b)` negates a value and discards it", "22:1: this expression does nothing as a statement: `-p.get()` negates a value and discards it", "23:2: this expression does nothing as a statement: `-f()` negates a value and discards it", "24:1: `-f()` negates a value and discards it", "25:7: this expression does nothing as a statement: `-f()` negates", "27:8: this expression does nothing as a statement: `-f()` negates", "30:3: this expression does nothing as a statement: `-f()` negates", errors: 9
  # A statement `-e` negates a value and throws it away, in every place a
  # statement stands; a drop is written `<x`.

  fun f() -> Int
    3

  obj P
    n: Int

    fun get(?self) -> Int
      self.n

  sub tail()
    -f()

  a = 1
  b = 2
  c = a > 0
  p = P(n: 1)
  -f()
  -(a + b)
  -p.get()
  (-f())
  -f() if c
  defer -f()
  match a
    1 => -f()
    _ => pass
  if c
    -f()
  tail()
  print(a, b, p.n)

fail "minus statement view hint", "10:3: this expression does nothing as a statement: `-o` negates a value and discards it; a view parameter is not dropped, since the caller owns what it views", "15:1: this expression does nothing as a statement; to drop `r` now, write `<r`", "17:3: this expression does nothing as a statement: `-v` negates a value and discards it; a closure keeps what it captures for every call, so `v` is not dropped here", "21:3: this expression does nothing as a statement: `-v` negates a value and discards it; a closure keeps what it captures for every call, so `v` is not dropped here", "25:3: this expression does nothing as a statement: `-x` negates a value and discards it; `x` views an element the loop walks, which is dropped with what holds it", "27:3: this expression does nothing as a statement: `-x` negates a value and discards it; `x` views an element the loop walks, which is dropped with what holds it", "29:3: this expression does nothing as a statement; to drop `y` now, write `<y`", errors: 7
  # A statement `-x` negates `x` and discards it. Where `x` owns or views
  # something, the hint offers `<x` only where `<x` drops it: not for a
