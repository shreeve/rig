    c: Color = . green
    s: [N -1]Int = [N - 1 of 0]
    xs = [1, 2, 3]
    print(?xs[.. 2], ?xs[a ..], 0 ..a)
    n = a?? 0
    n =1
    print(n
      -1)
    print(c, s, n, half(4))

