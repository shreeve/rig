test "obj is a name", release: true, '''
  5
  10
  6
  7 8
  6
'''
  # `obj` is a keyword only where a declaration starts (before a name, at
  # the start of a statement). Anywhere else it is an ordinary name, and
  # so is the old `struct`.

  obj Bag
    obj: Int
    struct: Int

  fun twice(obj: Int) -> Int
    obj * 2

  obj = 5
  print(obj)
  print(twice(obj))
  new struct = obj + 1
  print(struct)
  b = Bag(obj: 7, struct: 8)
  print(b.obj, b.struct)
  obj = obj + 1
  print(obj)

test "of is a name", '''
  1 20 [1] [1, 1] 2 2 6
  [1, 1] [2, 2, 2] [20, 20]
  [[0, 0, 0], [0, 0, 0]] 8
'''
  # `of` is a keyword only after a value directly inside [ ], where it
  # separates a fill literal's count from its element (`[n of x]`).
  # Everywhere else it is an ordinary name.

  obj Pair
    of: Int

  fun twice(of: Int) -> Int
    of * 2

  of = 1
  xs = [10, 20, 30]
  p = Pair(of: 2)
  print(of, xs[of], [of], [of, of], twice(of), p.of, twice(of: 3))
  print([2 of of], [3 of p.of], [2 of xs[of]])
  grid: [2][3]Int = [2 of [3 of 0]]
  page: [8]U8 = [8 of 0]
  print(grid, page.len)

