test "match arms stay arms", release: true, '''
  1 12 23
  10 20 30
  1 2 3
'''
  # A `.variant` line under a line that opens a block is not a chain: the
  # arms of a `match` are arms, an arm may be a pattern with a body below
  # it, and a line deeper than a one-line arm's own is not allowed.

  enum Color
    red
    green
    blue

  fun name(c: Color) -> Int
    match c
      .red => 10
      .green
        20
      .blue => 30

  fun code(c: Color) -> Int
    match c
      .red => 1
      .green => 2
      .blue
        new k = 3
        k

  fun value(c: Color) -> Int
    k = match c
      .red => 1
      .green => 2
      .blue
        3
    return match c
      .red => k
      .green => k + 10
      .blue => k + 20

  print(value(.red), value(.green), value(.blue))
  print(name(.red), name(.green), name(.blue))
  print(code(.red), code(.green), code(.blue))

fail "match else arm", "7:3: unexpected keyword `else`; expected a match arm, the end of the line or the end of the block; the catch-all arm is `_`, or a name that binds the value"
  # A match's catch-all arm is `_` (or a name, which binds the value);
  # `else` is not a pattern.

  x = 3
  match x
    1 => print("one")
    else => print("other")

fail "match else block arm", "7:3: the catch-all arm is `_`, or a name that binds the value"
  # `else` does not start a block arm either; the catch-all is `_`.

  x = 3
  match x
    1
      print("one")
    else
      print("other")

fail "match float pattern", "unexpected `1.5`", "a pattern is a name, an integer, `true`, `false`, or an enum variant"
  # A match pattern is a name, an integer, a Bool, or an enum variant;
  # a float literal is not a pattern.

  x = 1.5
  match x
    1.5 => print(1)
    _ => print(2)

test "match guards and alternatives", '''
  big circle
  round or square
  round or square
  square rect
  rect
  point
  0 tiny
  1 tiny
  4 small even
  5 small odd
  -3 negative
  12 large
  any bool
  next
  over two: 3
  .circle(r: 400)
  small 1
  drop 1
  not big
  drop 2
  end
'''
  # An arm may list alternatives (`1, 2 =>`) and take a guard (`p if c`),
  # which sees the pattern's bindings; an arm whose guard fails falls
  # through to the later arms. It works in value and statement position,
  # on enums, integers, ranges, and Bool, and for `match !e` and `match <e`.

  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Shape
    circle(r: Int)
    square(s: Int)
    rect(w: Int, h: Int)
    point

  enum Slot
    full(b: *B)
    empty

  fun describe(s: ?Shape) -> ?String
    match s
      .circle(r) if r > 10 => "big circle"
      .circle(_), .square(_) => "round or square"
      .rect(w, h) if w == h => "square rect"
      .rect(_, _) => "rect"
      .point => "point"

  fun bucket(n: Int) -> ?String
    match n
      0, 1 => "tiny"
      2..10 if n % 2 == 0 => "small even"
      2..10 => "small odd"
      k if k < 0 => "negative"
      _ => "large"

  fun next() -> Int
    print("next")
    3

  shapes: [6]Shape = [.circle(r: 20), .circle(r: 1), .square(s: 2), .rect(w: 2, h: 2), .rect(w: 1, h: 3), .point]
  for s in shapes
    print(describe(?s))
  for n in [0, 1, 4, 5, -3, 12]
    print(n, bucket(n))
  match true
    b if not b => print("false")
    true, false => print("any bool")
  match next()
    n if n > 2 => print("over two:", n)
    _ => print("other")
  c = Shape.circle(r: 4)
  match !c
    .circle(r) if r < 5
      r *= 100
    .circle(r) => r = 0
    _ => print("no")
  print(c)
  s: Slot = .full(b: *B(n: 1))
  match <s
    .full(b) if b.n > 5 => print("big", b.n)
    .full(b) => print("small", b.n)
    .empty => print("empty")
  t: Slot = .full(b: *B(n: 2))
  match <t
    .full(b) if b.n > 5 => print("big", b.n)
    _ => print("not big")
  print("end")

