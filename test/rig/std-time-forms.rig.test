fail "duration round's increment is an Int", "4:41: an increment of `round` is an `Int`, and `none` is no number: name one unit and a number, `round(seconds: 1)`", "5:34: an increment of `floor` is an `Int`, and `pick()` is an `Int?`: name one unit and a number, `floor(seconds: 1)`", "6:22: method `round` must be called; wrap it in a closure to pass it as a value", errors: 3
  fun pick() -> Int?
    1

  print(time.duration(1.5).round(seconds: none))
  print(time.duration(1).floor(ms: pick()))
  g = time.duration(1).round

test "duration round through a closure", "2s"
  # A checked method is called; a closure passes it as a value.
  use std.time

  f = |d: time.Duration, k: Int| d.round(seconds: k)
  print(f(time.duration(1.5), 1))

fail "time's removed names", "1:12: no member `now` in module `time`; for timing, `time.monotonic()` reads the monotonic clock, and `start.elapsed()` gives a `time.Duration`; for the date and time, `datetime.now()` reads the wall clock", "2:12: no member `MS` in module `time`; a length of time is a `time.Duration`: `time.duration(ms: 1)`, or `ms: 1` where a duration is taken", "3:12: no member `SECOND` in module `time`; a length of time is a `time.Duration`: `time.duration(1)`, or a bare number of seconds where a duration is taken", "4:12: no member `NS` in module `time`; a length of time is a `time.Duration`: `time.duration(ns: 1)`, or `ns: 1` where a duration is taken", "5:12: no member `US` in module `time`; a length of time is a `time.Duration`: `time.duration(us: 1)`, or `us: 1` where a duration is taken", "6:12: no member `MINUTE` in module `time`; a length of time is a `time.Duration`: `time.duration(minutes: 1)`, or `minutes: 1` where a duration is taken", "7:9: no type `Instant` in module `time`; a reading of the monotonic clock is a `time.Monotonic`, from `time.monotonic()` or `time.Monotonic.at(d)`", "8:12: no member `unix_ns` in module `time`; the wall clock is std.datetime's: `datetime.now()` reads it, and `datetime.now().unix().ns()` gives its nanoseconds since 1970", errors: 8
  print(time.now())
  print(time.MS)
  print(time.SECOND)
  print(time.NS)
  print(time.US)
  print(time.MINUTE)
  x: time.Instant = time.Monotonic.at(0)
  print(time.unix_ns())

fail "a reading is not a number", "6:36: operator `-` requires numeric operands", "7:13: only the standard library's module `std.time` can construct `std.time.Monotonic`: its field `n` is private; make one with its `pub` functions", errors: 2
  # A reading of the monotonic clock is a `Monotonic`, not a number: it
  # cannot be mixed with the wall clock, nor made from its field; only
  # `Monotonic.at` says a duration is one.
  use std.datetime
  start = time.monotonic()
  print(datetime.now().unix().ns() - start)
  fake = time.Monotonic(n: 5)
  print(fake.elapsed())

fail "a duration is not a number", "1:7: operator `+` requires numeric operands", "2:12: only the standard library's module `std.time` can construct `std.time.Duration`: its field `n` is private; make one with its `pub` functions", errors: 2
  print(time.duration(1) + 1)
  print(time.Duration(n: 5))

test "several units add up", '''
  1h 30m 30m 1s 500ms 1m 1s -1m 30s
  2ns -2ns 1s 500ms 250us 1h 1s
'''
  # Units' keywords add up, each unit at most once, in any order and of
  # any sign; each `Float` part is rounded to the nanosecond, a half away
  # from zero, before the parts are added (0.5 ns twice is 2 ns, not 1).
  z = time.Monotonic.at(0)
  print(time.duration(hours: 1, minutes: 30), time.duration(hours: 1, minutes: -30), z.add(seconds: 1, ms: 500).since(z), time.Monotonic.at(minutes: 1, seconds: 1).since(z), time.duration(seconds: 30, minutes: -2))
  print(time.duration(us: 0.0005, ns: 0.5), time.duration(us: -0.0005, ns: -0.5), time.duration(seconds: 1.5, ms: 0.25), time.duration(hours: 1, minutes: 0, seconds: 1.0, ms: 0, us: 0, ns: 0))

test "several units at each kind of callee", '''
  3m 2s 1ms 1ms 1us 1m 2s
  2ms 2us 2h 1m 2s 10ms 1m
  63 4 1
'''
  # A function, a generic function, a type's function, a method of
  # std.time's type and of another, an API's method under a bound and
  # through an API object, and an optional `Duration?` each take several
  # units, beside the call's other arguments by position or name.
  fun twice(d: time.Duration) -> time.Duration
    d.times(2)

  fun first[T](d: time.Duration, x: T) -> time.Duration
    d

  fun maybe(x: Int, d: time.Duration? = none) -> Int
    x + (d ?? time.duration(0)).seconds()

  api Waits
    fun wait(?@, d: time.Duration) -> time.Duration

  obj Clock: Waits
    k: Int

    fun wait(?@, d: time.Duration) -> time.Duration
      d.times(@k)

    fun make(d: time.Duration) -> time.Duration
      d

  fun through[W: Waits](w: ?W) -> time.Duration
    w.wait(seconds: 1, ms: 5)

  fun dyn(w: ?{Waits}) -> time.Duration
    w.wait(minutes: 1, seconds: -30)

  print(twice(minutes: 1, seconds: 30), first(seconds: 2, ms: 1, x: "x"), first(x: 1, ms: 1, us: 1), time.Duration.add(time.duration(1), minutes: 1, seconds: 1))
  c = Clock(k: 2)
  print(c.wait(ms: 1, us: 1), Clock.make(hours: 2, minutes: 1), through(?c), dyn(?c))
  print(maybe(1, minutes: 1, seconds: 2), maybe(1, d: 3), maybe(1))

test "several units of another module", "1m 30s 7 61"
  # Another module's function and optional parameter, from a module that
  # does not name std.time.
  use lib

  sub main()
    print(lib.twice(seconds: 30, ms: 15000), lib.maybe(1, seconds: 6, ms: 500), lib.maybe(1, minutes: 1, ns: 1))

  file "lib.rig"
    use std.time

    pub fun twice(d: time.Duration) -> time.Duration
      d.times(2)

    pub fun maybe(x: Int, d: time.Duration? = none) -> Int
      x + (d ?? time.duration(0)).seconds()

test "several units in their order", '''
  1
  2
  3
  1m 2s 3ms
  0
  1
  2
  1h 2m 0
  5
  6
  7
  5m 7s 6
  1m 2s 3
'''
  # The parts are evaluated in the order written, among the call's other
  # arguments, as any arguments are; a part that can fail fails in its
  # place.
  error Bad
    neg

  fun note(n: Int) -> Int
    print(n)
    n

  fun pick(n: Int) -> Int!Bad
    return Bad.neg if n < 0
    n

  fun later(d: time.Duration, x: Int) -> String
    `{d} {x}`

  sub main()
    print(time.duration(minutes: note(1), seconds: note(2), ms: note(3)))
    print(later(x: note(0), hours: note(1), minutes: note(2)))
    print(later(minutes: note(5), x: note(6), seconds: note(7)))
    print(later(minutes: pick(1)!, seconds: pick(2)!, x: 3))

test "several units at the ends of the range", '''
  2562047h 47m 16s 854ms 775us 807ns
  -9223372036854775808
  9223372036854775807
'''
  # The sum may reach either end of a `Duration`'s range.
  fun big(n: Int) -> Int
    n

  print(time.duration(hours: 2562047, minutes: 47, seconds: 16, ms: 854, us: 775, ns: 807))
  print(time.duration(hours: -2562047, minutes: -47, seconds: -16, ms: -854, us: -775, ns: -808).ns())
  print(time.duration(hours: big(2562047), minutes: big(47), seconds: 16, ms: 854, us: 775, ns: 807).ns())

bomb "several units past the range", "a duration is more nanoseconds than a Duration holds"
  fun big(n: Int) -> Int
    n

  print(time.duration(hours: big(2562047), minutes: big(48)))

bomb "several units past the range below", "a duration is more nanoseconds than a Duration holds"
  fun big(n: Int) -> Int
    n

  print(time.duration(hours: big(-2562047), minutes: -47, seconds: -16, ms: -854, us: -775, ns: big(-809)))

bomb "a part of several units past an Int", "a duration is more nanoseconds than a Duration holds"
  # Each part is a number a `Duration` holds before the parts add up.
  fun big(n: Int) -> Int
    n

  print(time.duration(hours: big(3_000_000), minutes: big(-60_000_000)))

bomb "a part of several units not finite", "a duration is not a finite number of nanoseconds a Duration holds"
  fun nan() -> Float
    Float.nan()

  print(time.duration(seconds: 1, ms: nan()))

fail "several units written outside their forms", "5:24: `time.duration` takes one duration: `2` or `minutes: 1, seconds: 3`, not both", "6:27: `time.duration` takes one duration: `d: 2` or `minutes: 1, seconds: 3`, not both", "7:37: a unit's keyword takes a number, and `d` is a `time.Duration` already: write it with no keyword, not `ms: d`", "8:44: the unit `hours:` is given twice: a duration's units add up, each given at most once", "9:28: `3_000_000` hours is more nanoseconds than a `Duration` holds", "10:21: `hours: 2562047, minutes: 48` is more nanoseconds than a `Duration` holds", "11:21: `hours: -2562047, minutes: -48` is more nanoseconds than a `Duration` holds", "12:35: a duration is a finite number, and `Float.nan()` is not", "13:33: `time.duration` has no parameter `secs`; did you mean `seconds: 2`?", errors: 9
  # A bare number or a name beside units, a `Duration` among them, a unit
  # given twice, a part or a constant sum past the range, a part not
  # finite, and a misspelled unit among them are each refused.
  d = time.duration(1)
  print(time.duration(2, minutes: 1, seconds: 3))
  print(time.duration(d: 2, minutes: 1, seconds: 3))
  print(time.duration(minutes: 1, ms: d))
  print(time.duration(hours: 1, minutes: 30, hours: 2))
  print(time.duration(hours: 3_000_000, minutes: -60_000_000))
  print(time.duration(hours: 2562047, minutes: 48))
  print(time.duration(hours: -2562047, minutes: -48))
  print(time.duration(hours: 1, ns: Float.nan()))
  print(time.duration(minutes: 1, secs: 2))

fail "several units take no days or weeks", "3:21: a duration takes no `days:`, since a day is not always 24 hours: write `hours: 26, minutes: 30`, exactly 24 hours a day", "4:34: a duration takes no `weeks:`, since a day is not always 24 hours: write `minutes: 30, hours: 168 + 24 * n()`, exactly 168 hours a week", "5:32: a duration takes no `days:`, since a day is not always 24 hours: write `hours: 36`, exactly 24 hours a day", errors: 3
