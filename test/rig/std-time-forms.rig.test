  print(time.duration(0.0 / 0.0))
  x = 1e300
  print(time.duration(ms: 2 * x))
  print(time.duration(ns: Float.inf() * 0.5))

fail "duration round and floor take one unit by name", "1:30: `ns` has a default, so it is an option, given by name: `ns: 5`", "2:24: `round` takes a unit and its increment: `round(seconds: 1)`", "3:37: `floor` takes one unit and its increment, not 2: write the increment in one unit, `floor(us: 1002)`", "4:34: an increment of `round` is from 1 to 1,000,000,000, and `0` is not", "5:30: `round` takes a unit from `ns:` to `hours:` and its increment, and `days:` is none of them", "6:34: an increment of `floor` is from 1 to 1,000,000,000, and `1_000_000_001` is not", "7:45: `ns` has a default, so it is an option, given by name: `ns: 5`", "8:19: `std.time.Duration.round` has options, given by name, so it is not a value: write a closure that calls it", errors: 8
