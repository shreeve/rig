# std.time: the duration forms, at each place a call gives one: a
# function, a method, a type's function, an API's method, a generic
# function, another module's, an optional parameter, two parameters, a
# function value; and the forms rejected, each with its fix.

use std.time

test "duration forms by unit", '''
  2s 500ms 2s 1h 1m 1s 1ms 1us 1ns
  1h 30m 1m 30s 1s 500ms 1ms 500us 1us 500ns 3ns -3ns 0s
'''
  # A bare number is seconds, an `Int` or a `Float`; each unit's keyword
  # counts its unit, a `Float` rounded to the nearest whole nanosecond, a
  # half away from zero.
  print(time.duration(2.5), time.duration(2), time.duration(hours: 1), time.duration(minutes: 1), time.duration(seconds: 1), time.duration(ms: 1), time.duration(us: 1), time.duration(ns: 1))
  print(time.duration(hours: 1.5), time.duration(minutes: 1.5), time.duration(seconds: 1.5), time.duration(ms: 1.5), time.duration(us: 1.5), time.duration(ns: 2.5), time.duration(ns: -2.5), time.duration(1e-10))

test "duration forms at each kind of callee", '''
  2s 40ms 1s
  1s 1s 3ms 2s
  2s 3s 20ms
  4s 6ms 5s 1ms
  1ms 3s 10s 1h
'''
  # A function, a method of std.time's own type and of another type, a
  # type's function, an API's method, and a generic function each take
  # the same forms; a `Duration` passes as it is, positionally or by its
  # parameter's name.
  fun twice(d: time.Duration) -> time.Duration
    d.times(2)

  fun first[T](d: time.Duration, x: T) -> time.Duration
    d

  api Waits
    fun wait(?@, d: time.Duration) -> time.Duration

  obj Clock: Waits
    k: Int

    fun wait(?@, d: time.Duration) -> time.Duration
      d.times(@k)

    fun make(d: time.Duration) -> time.Duration
      d

  fun through[W: Waits](w: ?W) -> time.Duration
    w.wait(ms: 10)

  z = time.Monotonic.at(0)
  print(z.add(2).since(z), z.add(ms: 40).since(z), time.Monotonic.at(1).since(z))
  d = time.duration(1)
  print(time.duration(d), time.duration(d: d), twice(ms: 1.5), twice(d: 1))
  c = Clock(k: 2)
  print(c.wait(1), c.wait(1.5), through(?c))
  print(twice(c.wait(1)), Clock.make(ms: 6), first(5, "x"), first(us: 1000, x: 1))
  print(first(d: time.duration(ms: 1), x: 0), time.duration(2).add(d), time.duration(10).add(d: 0), time.Duration.add(time.duration(minutes: 30), minutes: 30))

test "duration forms of another module", '''
  3s 6ms 4us
  1 6 8 10 12
  2 2
'''
  # A module's own function or method that takes a `Duration`, called
  # from a module that does not name std.time; an optional `Duration?`
  # takes `none`, an optional, a `Duration`, or any form.
  use lib

  sub main()
    print(lib.twice(1.5), lib.twice(ms: 3), lib.twice(us: 2))
    print(lib.maybe(1), lib.maybe(1, 5), lib.maybe(1, d: 7), lib.maybe(1, seconds: 9), lib.maybe(1, minutes: 0.1833333333333))
    w = lib.W(k: 1)
    print(w.wait(ms: 1000), lib.maybe(2, lib.none_yet()))

  file "lib.rig"
    use std.time

    pub fun twice(d: time.Duration) -> time.Duration
      d.times(2)

    pub fun maybe(x: Int, d: time.Duration? = none) -> Int
      x + (d ?? time.duration(0)).seconds()

    pub fun none_yet() -> time.Duration?
      none

    pub obj W
      pub k: Int

      pub fun wait(?@, d: time.Duration) -> Int
        d.seconds() + @k

test "duration forms through an API object", "30ms 3s 2us"
  # A method called through an API object takes the forms its API's
  # method declares.
  api Waits
    fun wait(?@, d: time.Duration) -> time.Duration

  obj Clock: Waits
    k: Int

    fun wait(?@, d: time.Duration) -> time.Duration
      d.times(@k)

  fun dyn(w: ?{Waits}) -> time.Duration
    w.wait(ms: 10)

  c = Clock(k: 3)
  b: ^{Waits} = ^Clock(k: 2)
  print(dyn(?c), b.wait(1.5), b.wait(us: 1))

test "duration forms of two parameters", "1s 1s 2s 500ms 3s"
  # With two `Duration` parameters, each is given by its own name, with a
  # bare number of seconds or a `Duration`.
  fun span(a: time.Duration, b: time.Duration) -> time.Duration
    b.sub(a)

  print(span(1, 2), span(a: 1, b: 2), span(b: 2.5, a: time.duration(0)), span(time.duration(0), 3))

fail "a number through a function value", "2:3: type mismatch: expected `time.Duration`, got `Int`; a number is a duration only as an argument of a call that names its function: write `time.duration(1)`", "3:20: type mismatch: expected `time.Duration`, got `Float`; a number is a duration only as an argument of a call that names its function: write `time.duration(0.5)`", errors: 2
  s = time.sleep
  s(1)!
  d: time.Duration = 0.5
  print(d)

test "duration through a function value", "2s 4s"
  # A function value has no parameter names: its caller passes a
  # `Duration`.
  fun twice(d: time.Duration) -> time.Duration
    d.times(2)

  f = twice
  g: fun(time.Duration) -> time.Duration = time.duration
  print(f(time.duration(1)), f(g(time.duration(2))))

bomb "duration of a NaN", "a duration is not a finite number of nanoseconds a Duration holds"
  fun nan() -> Float
    Float.nan()

  print(time.duration(ms: nan()))

bomb "duration past an Int", "a duration is more nanoseconds than a Duration holds"
  fun big() -> Int
    10_000_000_000

  print(time.duration(big()))

bomb "duration of a Float past an Int", "a duration is not a finite number of nanoseconds a Duration holds"
  fun big() -> Float
    1e19

  print(time.duration(ns: big()))

fail "durations written outside their forms", "7:19: `time.sleep` takes one duration, in one unit: `ms: 1` or `ns: 2`, not both", "8:15: `time.sleep` takes one duration, in one unit: `2` or `ms: 3`, not both", "9:12: `time.sleep` has no parameter `secs`; did you mean `seconds: 2`?", "10:12: a duration is a number of seconds, a unit's keyword and a number, `ms: 40`, or a `time.Duration`, and `\"x\"` is a `Static`", "11:12: a duration is a number of seconds, a unit's keyword and a number, `ms: 40`, or a `time.Duration`, and `U8(3)` is a `U8`: write `Int(U8(3))`", "12:16: a duration is a finite number, and `Float.inf()` is not", "13:12: `10_000_000_000` seconds is more nanoseconds than a `Duration` holds", "14:16: `1e13` ms is more nanoseconds than a `Duration` holds", "15:12: `time.sleep` has no parameter `timeout`; a duration is written bare in seconds, `time.sleep(2)`, or with one unit, `ms: 40`, from `ns:` to `hours:`", "16:16: a unit's keyword takes a number, and `d` is a `time.Duration` already: write it with no keyword, not `ms: d`", "17:61: `time.after` takes one duration, in one unit: `ms: 1` or `us: 2`, not both", "18:28: `3e6` hours is more nanoseconds than a `Duration` holds", errors: 12
  # Each form outside a bare number of seconds, one unit's keyword and a
  # number, or a `Duration` is rejected with its fix.
  use std.task

  ch = *Chan[Int](1)
  d = time.duration(1)
  time.sleep(ms: 1, ns: 2)!
  time.sleep(2, ms: 3)!
  time.sleep(secs: 2)!
  time.sleep("x")!
  time.sleep(U8(3))!
  time.sleep(ns: Float.inf())!
  time.sleep(10_000_000_000)!
  time.sleep(ms: 1e13)!
  time.sleep(timeout: 3)!
  time.sleep(ms: d)!
  _ = task.select(got: !ch.on_recv(), late: time.after(ms: 1, us: 2))!
  print(time.duration(hours: 3e6))

fail "durations take no days or weeks", "1:21: a duration takes no `days:`, since a day is not always 24 hours: write `hours: 24` for exactly 24 hours", "2:21: a duration takes no `weeks:`, since a day is not always 24 hours: write `hours: 336` for exactly 336 hours", "3:26: a duration takes no `days:`, since a day is not always 24 hours: write `hours: 24` for exactly 24 hours", errors: 3
  print(time.duration(days: 1))
  print(time.duration(weeks: 2))
  _ = time.monotonic().add(days: n())

  fun n() -> Int
    1

test "a function's own days parameter", "1d 2s"
  # A function with a parameter named `days` takes it by its name.
  fun later(d: time.Duration, days: Int) -> String
    `{days}d {d}`

  print(later(2, days: 1))

fail "duration parameters named for units", "1:27: a function that takes a `Duration` names no parameter `ms`: a call writes a duration with a unit's keyword, `ms: 40`, so rename it", "4:37: a function that takes a `Duration` names no parameter `seconds`: a call writes a duration with a unit's keyword, `ms: 40`, so rename it", errors: 2
  fun bad(d: time.Duration, ms: Int) -> Int
    ms

  fun worse(d: time.Duration? = none, seconds: Int = 0) -> Int
    seconds

  print(bad(1, 2), worse())

fail "two durations take no unit", "4:12: `span` takes 2 durations, so each is given by its own name, `a: 1`, not by a unit's keyword", errors: 1
  fun span(a: time.Duration, b: time.Duration) -> time.Duration
    b.sub(a)

  print(span(ms: 1, b: 2))

fail "duration round and floor take one unit by name", "1:30: `round` takes a unit and its increment by name, `round(minutes: 15)`, and no positional argument", "2:24: `round` takes a unit and its increment: `round(seconds: 1)`", "3:37: `floor` takes one unit and its increment, not two: `ms: 1` or `us: 2`", "4:34: an increment of `round` is from 1 to 1,000,000,000, and `0` is not", "5:30: `round` takes a unit from `ns:` to `hours:` and its increment, and `days:` is none of them", "6:34: an increment of `floor` is from 1 to 1,000,000,000, and `1_000_000_001` is not", "7:45: `round` takes a unit and its increment by name, `round(minutes: 15)`, and no positional argument", "8:19: `std.time.Duration.round` checks its arguments where it is called, so it must be called; wrap it in a closure to pass it as a value", errors: 8
  print(time.duration(1).round(5))
  print(time.duration(1).round())
  print(time.duration(1).floor(ms: 1, us: 2))
  print(time.duration(1).round(ms: 0))
  print(time.duration(1).round(days: 1))
  print(time.duration(1).floor(ns: 1_000_000_001))
  print(time.Duration.round(time.duration(1), 5))
  f = time.Duration.round

test "duration round through a closure", "2s"
  # A checked method is called; a closure passes it as a value.
  use std.time

  f = |d: time.Duration, k: Int| d.round(seconds: k)
  print(f(time.duration(1.5), 1))

fail "time's removed names", "1:12: no member `now` in module `time`; for timing, `time.monotonic()` reads the monotonic clock, and `start.elapsed()` gives a `time.Duration`; for the date and time, `time.unix_ns()` reads the wall clock", "2:12: no member `MS` in module `time`; a length of time is a `time.Duration`: `time.duration(ms: 1)`, or `ms: 1` where a duration is taken", "3:12: no member `SECOND` in module `time`; a length of time is a `time.Duration`: `time.duration(1)`, or a bare number of seconds where a duration is taken", "4:12: no member `NS` in module `time`; a length of time is a `time.Duration`: `time.duration(ns: 1)`, or `ns: 1` where a duration is taken", "5:12: no member `US` in module `time`; a length of time is a `time.Duration`: `time.duration(us: 1)`, or `us: 1` where a duration is taken", "6:12: no member `MINUTE` in module `time`; a length of time is a `time.Duration`: `time.duration(minutes: 1)`, or `minutes: 1` where a duration is taken", "7:9: no type `Instant` in module `time`; a reading of the monotonic clock is a `time.Monotonic`, from `time.monotonic()` or `time.Monotonic.at(d)`", errors: 7
  print(time.now())
  print(time.MS)
  print(time.SECOND)
  print(time.NS)
  print(time.US)
  print(time.MINUTE)
  x: time.Instant = time.Monotonic.at(0)

fail "a reading is not a number", "5:24: operator `-` requires numeric operands", "6:13: only the standard library's module `std.time` can construct `std.time.Monotonic`: its field `n` is private; make one with its `pub` functions", errors: 2
  # A reading of the monotonic clock is a `Monotonic`, not a number: it
  # cannot be mixed with the wall clock, nor made from its field; only
  # `Monotonic.at` says a duration is one.
  start = time.monotonic()
  print(time.unix_ns() - start)
  fake = time.Monotonic(n: 5)
  print(fake.elapsed())

fail "a duration is not a number", "1:7: operator `+` requires numeric operands", "2:12: only the standard library's module `std.time` can construct `std.time.Duration`: its field `n` is private; make one with its `pub` functions", errors: 2
  print(time.duration(1) + 1)
  print(time.Duration(n: 5))
