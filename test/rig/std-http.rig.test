# std.http: tests whose names start `http`.
use std.http
use std.net

test "http serve", seeds: 20, '''
  200 Hello from Rig!
  200 {"hits":2}
  200 hi rig
  404 not found
  500 internal server error
  200 {"hits":6}
  -1
'''
  # A handler routes on the path with string arms, reads a query
  # argument, counts in a shared Cell, and panics on one route, which
  # answers 500 while the server goes on. Canceling the server ends it.
  use std.text

  fun route(req: ?http.Request, hits: *Cell[Int]) -> http.Response
    !hits.add(1)
    match req.path
      "/" => http.text("Hello from Rig!")
      "/hits" => http.json(String("{\"hits\":", hits.get(), "}"))
      "/hi" => http.text(String("hi ", req.arg("name") ?? String("you")))
      "/boom" => http.text(String([1, 2][hits.get()]))
      _ => http.not_found()

  fun run(l: net.Listener, hits: *Cell[Int]) -> Int!
    http.serve(<l, |+hits, req| route(req, +hits))!
    0

  # The status and the body of a request for `path`.
  fun get(port: Int, path: ?String) -> String!
    c = net.connect(String("127.0.0.1:", port))!
    (!c).write(String("GET ", path, " HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))!
    got = String()
    while true
      n = (!c).read(!got, 4096)!
      if n == 0
        break
    status = ?got[9..12]
    at = text.find(?got, "\r\n\r\n") ?? 0
    String(status, " ", text.trim(?got[at..]))

  hits = *Cell(0)
  l = net.listen("127.0.0.1:0")!
  port = l.port()
  t = run(<l, +hits)&
  for p in ["/", "/hits", "/hi?name=rig", "/nope", "/boom", "/hits"]
    print(get(port, p)!)
  print(<t.cancel() catch -1)

test "http keep alive", seeds: 20, "500 500"
  # Many clients, each sending its requests on one connection.
  use std.text

  fun run(l: net.Listener, hits: *Cell[Int]) -> Int!
    http.serve(<l, |+hits, req|
      !hits.add(1)
      http.text(req.path)
    )!
    0

  fun client(port: Int, n: Int) -> Int!
    c = net.connect(String("127.0.0.1:", port))!
    ok = 0
    for i in 0..n
      (!c).write(String("GET /p", i, " HTTP/1.1\r\nHost: x\r\n\r\n"))!
      got = String()
      want = String("/p", i)
      while text.find(?got, ?want) == none
        _ = (!c).read(!got, 4096)!
      ok += 1
    ok

  hits = *Cell(0)
  l = net.listen("127.0.0.1:0")!
  port = l.port()
  t = run(<l, +hits)&
  cs = Tasks[Int!]()
  for 0..10
    !cs.add(client(port, 50)&)
  xs = >cs!
  sum = 0
  for x in xs
    sum += x
  print(sum, hits.get())
  _ = <t.cancel() catch -1

test "http pipelined", seeds: 20, "/a: /b:hello /c:"
  # Requests sent together on one connection, one with a body, are each
  # answered in turn: what is read past one request stays for the next.
  use std.text

  fun run(l: net.Listener) -> Int!
    http.serve(<l, |req| http.text(String(req.path, ":", req.body)))!
    0

  l = net.listen("127.0.0.1:0")!
  port = l.port()
  t = run(<l)&
  c = net.connect(String("127.0.0.1:", port))!
  (!c).write(String("GET /a HTTP/1.1\r\nHost: x\r\n\r\nPOST /b HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhelloGET /c HTTP/1.1\r\nHost: x\r\n\r\n"))!
  got = String()
  while text.find(?got, "/c:") == none
    _ = (!c).read(!got, 4096)!
  a = text.find(?got, "/a:") ?? -1
  b = text.find(?got, "/b:hello") ?? -1
  d = text.find(?got, "/c:") ?? -1
  print("/a:" if a >= 0 else "?", "/b:hello" if b > a else "?", "/c:" if d > b else "?")
  _ = <t.cancel() catch -1

test "http expect continue", seeds: 20, '''
  100 then /e:hello
  417
  /f:
'''
  # A client that sends `Expect: 100-continue` waits for `100 Continue`
  # before it sends the body; the server asks for it, in any case, and
  # answers 417 to an expectation it does not know.
  use std.text

  fun run(l: net.Listener) -> Int!
    http.serve(<l, |req| http.text(String(req.path, ":", req.body)))!
    0

  # Read from `c` onto `got` until it holds `want`, or the other end
  # closes.
  sub until(c: !net.Stream, got: !String, want: ?String)!
    while text.find(?got, want) == none
      if (!c).read(!got, 4096)! == 0
        return

  l = net.listen("127.0.0.1:0")!
  port = l.port()
  t = run(<l)&
  c = net.connect(String("127.0.0.1:", port))!
  (!c).write("POST /e HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-Continue\r\n\r\n")!
  got = String()
  until(!c, !got, "\r\n\r\n")!
  first = String(?got[9..12])
  (!c).write("hello")!
  until(!c, !got, "/e:hello")!
  print(first, "then", ?got[(text.find(?got, "/e:") ?? 0)..])
  d = net.connect(String("127.0.0.1:", port))!
  (!d).write("POST /x HTTP/1.1\r\nHost: x\r\nContent-Length: 1\r\nExpect: later\r\n\r\nx")!
  got = String()
  until(!d, !got, "\r\n\r\n")!
  print(?got[9..12])
  # With no body to ask for, the answer comes at once.
  (!c).write("GET /f HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n")!
  got = String()
  until(!c, !got, "/f:")!
  print(?got[(text.find(?got, "/f:") ?? 0)..])
  _ = <t.cancel() catch -1

test "http body limit", seeds: 20, '''
  413 0
  413 0
  200 /ok
'''
  # A body over 16 MiB is answered 413 before any of it is read, and
  # the connection closes once the client has seen the answer; one that
  # waits for `100 Continue` is never asked for. The server goes on.
  use std.text

  fun run(l: net.Listener) -> Int!
    http.serve(<l, |req| http.text(req.path))!
    0

  # The status of the answer to `head`, and how many bytes follow the
  # end of the answer's body before the server closes.
  fun send(port: Int, head: ?String) -> String!
    c = net.connect(String("127.0.0.1:", port))!
    (!c).write(head)!
    got = String()
    while (!c).read(!got, 4096)! > 0
      pass
    at = (text.find(?got, "\r\n\r\n") ?? 0) + 4
    body = ?got[at..]
    if text.starts_with(?got, "HTTP/1.1 200")
      return String(?got[9..12], " ", body)
    String(?got[9..12], " ", body.len - "content too large\n".len)

  l = net.listen("127.0.0.1:0")!
  port = l.port()
  t = run(<l)&
  print(send(port, "POST /big HTTP/1.1\r\nHost: x\r\nContent-Length: 16777217\r\n\r\nabc")!)
  print(send(port, "PUT /big HTTP/1.1\r\nHost: x\r\nContent-Length: 99999999\r\nExpect: 100-continue\r\n\r\n")!)
  print(send(port, "GET /ok HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")!)
  _ = <t.cancel() catch -1

fail "http serve captures share", "`http.serve` calls the closure on several tasks at once, and `|!count|` lends `count` to write"
  fun run(l: net.Listener) -> Int!
    count = 0
    http.serve(<l, |!count, req| http.text(req.path))!
    count

  l = net.listen("127.0.0.1:0")!
  _ = run(<l)

fail "http serve takes a listener", "`http.serve` takes connections on a `net.Listener`, which it takes"
  fun run() -> Int!
    http.serve(":8080", |req| http.text(req.path))!
    0

  _ = run()
