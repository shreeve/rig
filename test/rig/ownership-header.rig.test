fail "header temporary rejected", "36:5: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `opt(?String(\"abc\"))` to a name first", "38:8: bind `opt(?String(\"\"))` to a name first", "40:7: bind `mkh(4)` to a name first", "43:32: bind the index to a name first", errors: 4
  # A `match`, `if … as`, `while … as`, or `for` header that makes a
  # statement temporary and has no place outside it to reach (a value made
  # in the header, or a part of one) is emitted over a copy of that value,
  # in the block that drops the temporary, so what it binds would be in
  # that copy: a write, a Cell change, or a view through a binding would
  # reach the copy. Such a header is rejected, whatever it binds, unless it
  # takes a value made there (`match mke(?String("a"))`, `if opt(3) as p`),
  # and the hint says what to bind to a name first. A header that reaches a
  # place binds the place's own (`header_temporary_points.rig`).

  enum E
    a(xs: [4]Int)
    b

  obj P
    x: Int

  obj H
    e: E
    t: String

  fun idx(s: ?String) -> Int
    s.len - 1

  fun opt(n: ?String) -> P?
    if n.len > 0
      return P(x: n.len)
    none

  fun mkh(n: Int) -> H
    H(e: E.a(xs: [n, n, n, n]), t: String("h"))

  fun mke(s: ?String) -> E
    .a(xs: [s.len, 0, 0, 0])

  if ?opt(?String("abc")) as p
    print(p.x)
  while ?opt(?String("")) as q
    print(q.x)
  match mkh(4).e
    .a(xs) => print(xs[0])
    .b => pass
  for x in [[1, 2], [3, 4]][idx(?String("ab"))]
    print(x)
  match mke(?String("a"))
    .a(xs) => print(xs[0])
    .b => pass
  if opt(?String("abc")) as p
    print(p.x)

fail "header temporary view bound", "20:5: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `mk()` to a name first", "22:8: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `mk()` to a name first", "25:8: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `mke()` to a name first", errors: 3
  # What `if … as`, `while … as`, or `match` binds lives through the
  # body, past its header, so it may not lend a temporary the header
  # made.
  #
  # oracle: main reject C5

  obj B
    o: String?

  enum E
    a(t: String)
    z

  fun mk() -> B
    B(o: String("o"))

  fun mke() -> E
    E.a(t: String("e"))

  if ?mk().o as t
    print(t)
  while ?mk().o as u
    print(u)
    break
  match ?mke()
    .a(t) => print(t)
    .z => pass

fail "header view loans", "22:5: cannot lend `v` to write while a read loan is live", "27:5: cannot reassign `o` while it is lent", "34:8: cannot drop `b` while it is lent", "42:8: a view of the temporary `mkh()` outlives its statement", errors: 4
  # A header that reads a bare place keeps it lent while what it binds is
  # used, as `?p` does; a value it holds ends with the construct.

  obj Res
    n: Int
    t: String

  enum E
    a(r: Res)
    b

  obj H
    e: E

  fun mkh() -> H
    H(e: E.a(r: Res(n: 1, t: String("a"))))

  sub loops()
    v: List[Int] = List()
    !v.push(1)
    for x in v
      !v.push(x)

  sub ifs()
    o: List[Int]? = List()
    if o as x
      o = none
      print(x.len)

  sub boxes()
    b = ^E.a(r: Res(n: 2, t: String("b")))
    match b
      .a(r)
        <b
        print(r.n)
      .b => pass

  sub held()
    keep = Res(n: 0, t: String("c"))
    saved = ?keep
    match mkh().e
      .a(r) => saved = ?r
      .b => pass
    print(saved.n)

  loops()
