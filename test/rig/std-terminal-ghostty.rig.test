  |  X
  |
  |
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3;3H\x1b[5AX")
  print(t.dump())

test "CUD stops at the bottom", '''
  |
  |
  |
  |X
  cursor 3 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[9BX")
  print(t.dump())

test "CUF stops at the right edge", '''
  |         X
  |
  |
  |
  cursor 0 9 wrap
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[20CX")
  print(t.dump())

test "CUB stops at the left edge", '''
  |Xbc
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x1b[9DX")
  print(t.dump())

test "a count of zero moves one", '''
  |
  | X
  |
  |
  cursor 1 2
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3;3H\x1b[0A\x1b[0DX")
