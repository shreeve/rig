# std: std.terminal against Ghostty (libghostty-vt at 31bdcd5a7963), which
# defines what it shows. Written by tools/terminal_ghostty.py from
# Ghostty's answers: run it to write this file again after a change to
# its cases.

use std.terminal

test "print fills the first row", '''
  |hello
  |
  |
  |
  cursor 0 5
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("hello")
  print(t.dump())

test "print wraps at the right margin", '''
  |abcdefghij
  |k
  |
  |
  cursor 1 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abcdefghijk")
  print(t.dump())

test "a full row leaves a wrap pending", '''
  |abcdefghij
  |
  |
  |
  cursor 0 9 wrap
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abcdefghij")
  print(t.dump())

test "carriage return clears a pending wrap", '''
  |Xbcdefghij
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abcdefghij\x0dX")
  print(t.dump())

test "line feed keeps the column", '''
  |abc
  |   def
  |
  |
  cursor 1 6
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x0adef")
  print(t.dump())

test "carriage return and line feed", '''
  |one
  |two
  |three
  |
  cursor 2 5
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("one\x0d\x0atwo\x0d\x0athree")
  print(t.dump())

test "vertical tab and form feed are line feeds", '''
  |a
  | b
  |  c
  |
  cursor 2 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("a\x0bb\x0cc")
  print(t.dump())

test "line feed at the bottom scrolls", '''
  |3
  |4
  |5
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x0d\x0a5")
  print(t.dump())

test "wrapping at the bottom scrolls", '''
  |efgh
  |ijkl
  cursor 1 3 wrap
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("abcdefghijkl")
  print(t.dump())

test "backspace moves left", '''
  |abX
  |
  |
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x08X")
  print(t.dump())

test "backspace stops at the left margin", '''
  |a
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x08\x08a")
  print(t.dump())

test "backspace with a wrap pending", '''
  |abXd
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("abcd\x08X")
  print(t.dump())

test "line feed with a wrap pending", '''
  |abcd
  |   X
  |
  cursor 1 3 wrap
'''
  t = terminal.Terminal.new(4, 3)
  !t.feed("abcd\x0aX")
  print(t.dump())

test "printable ASCII", '''
  | !"#$%&'()*+,-./
  |0123456789:;<=>?
  |@ABCDEFGHIJKLMNO
  |PQRSTUVWXYZ[\]^_
  |`abcdefghijklmno
  |pqrstuvwxyz{|}~
  cursor 5 15
'''
  t = terminal.Terminal.new(16, 6)
  !t.feed(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~")
  print(t.dump())

test "a one-column terminal", '''
  |a
  |b
  |c
  cursor 2 0 wrap
'''
  t = terminal.Terminal.new(1, 3)
  !t.feed("abc")
  print(t.dump())

test "REP repeats the last rune", '''
  |abbbb
  |
  cursor 0 5
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("ab\x1b[3b")
  print(t.dump())

test "REP with no count repeats once", '''
  |abb
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("ab\x1b[b")
  print(t.dump())

test "REP of zero repeats once", '''
  |abb
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("ab\x1b[0b")
  print(t.dump())

test "REP before any rune does nothing", '''
  |X
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("\x1b[3bX")
  print(t.dump())

test "REP wraps", '''
  |abbb
  |bbb
  cursor 1 3
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("ab\x1b[5b")
  print(t.dump())

test "REP after a control repeats the rune", '''
  |aa
  |
  cursor 0 2
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("a\x0d\x1b[2b")
  print(t.dump())

test "tab moves to the next stop", '''
  |a       b       c
  |
  cursor 0 17
'''
  t = terminal.Terminal.new(20, 2)
  !t.feed("a\x09b\x09c")
  print(t.dump())

test "tab stops at the last column", '''
  |                   X
  |
  cursor 0 19 wrap
'''
  t = terminal.Terminal.new(20, 2)
  !t.feed("\x09\x09\x09\x09X")
  print(t.dump())

test "tab with a wrap pending", '''
  |abcdefgh
  |X
  cursor 1 1
'''
  t = terminal.Terminal.new(8, 2)
  !t.feed("abcdefgh\x09X")
  print(t.dump())

test "bell and other controls print nothing", '''
  |ab
  |
  cursor 0 2
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("a\x07\x00\x01\x05\x0e\x0f\x1fb")
  print(t.dump())

test "DEL is printed as a character", '''
  |ab
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("a\x7fb")
  print(t.dump())

test "CUP moves to a row and column", '''
  |
  |    X
  |
  |
  cursor 1 5
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[2;5HX")
  print(t.dump())

test "CUP with no parameters goes home", '''
  |Xbc
  |de
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x0d\x0ade\x1b[HX")
  print(t.dump())

test "CUP clamps to the screen", '''
  |
  |
  |
  |         X
  cursor 3 9 wrap
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[99;99HX")
  print(t.dump())

test "CUP with zeros is one", '''
  |X
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3;3H\x1b[0;0HX")
  print(t.dump())

test "CUP with only a row", '''
  |
  |
  |X
  |
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3HX")
  print(t.dump())

test "CUP with only a column", '''
  |   X
  |
  |
  |
  cursor 0 4
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[;4HX")
  print(t.dump())

test "HVP is CUP", '''
  |
  |  X
  |
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[2;3fX")
  print(t.dump())

test "CUU stops at the top", '''
  |  X
  |
  |
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3;3H\x1b[5AX")
  print(t.dump())

test "CUD stops at the bottom", '''
