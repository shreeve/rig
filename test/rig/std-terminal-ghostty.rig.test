test "EL clears a pending wrap", '''
  |abcX
  |
  cursor 0 3 wrap
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("abcd\x1b[KX")
  print(t.dump())

test "selective EL erases", '''
  |abc
  |
  cursor 0 3
'''
