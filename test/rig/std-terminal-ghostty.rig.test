test "ED 0 erases to the end of the screen", '''
  |abcdefghij
  |abc
  |
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abcdefghijabcdefghijabcdefghijabcdefghij\x1b[2;4H\x1b[J")
  print(t.dump())

test "ED 1 erases to the cursor", '''
  |
  |    efghij
  |abcdefghij
  |abcdefghij
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 4)
