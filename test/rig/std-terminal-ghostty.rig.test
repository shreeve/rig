  ~0 0-3 fg=3
  ~1 0-3 fg=3
  cursor 0 0
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("\x1b[33m\x1b#8")
  print(t.dump())

test "DECALN keeps only the pen's colors", '''
  |EEEE
  |EEEE
  ~0 0-3 fg=2 bg=4
  ~1 0-3 fg=2 bg=4
  cursor 0 0
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("\x1b[1;5;32;44m\x1b#8")
  print(t.dump())

test "after DECALN the flags stay off", '''
  |EEEE
  |XEEE
  ~0 0-3 fg=2
  ~1 0-3 fg=2
  cursor 1 1
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("\x1b[1;32m\x1b#8\x1b[2;1HX")
  print(t.dump())

test "DECAWM off overwrites the last column", '''
  |abcf
  |
  cursor 0 3 wrap
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("\x1b[?7labcdef")
  print(t.dump())

test "DECAWM back on", '''
  |abcf
  |gh
  cursor 1 2
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("\x1b[?7labcdef\x1b[?7hgh")
  print(t.dump())

test "IRM inserts", '''
  |abXYcdef
  |
  cursor 0 4
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("abcdef\x1b[1;3H\x1b[4hXY")
  print(t.dump())

test "IRM off replaces", '''
  |abXYef
  |
  cursor 0 4
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("abcdef\x1b[4h\x1b[4l\x1b[1;3HXY")
  print(t.dump())

test "IRM pushes off the end", '''
  |XYabcd
  |
  cursor 0 2
'''
  t = terminal.Terminal.new(6, 2)
  !t.feed("abcdef\x1b[1;1H\x1b[4hXY")
  print(t.dump())

test "LNM makes LF return", '''
  |abc
  |def
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[20habc\x0adef")
  print(t.dump())

test "LNM off", '''
  |abc
  |   def
  |
  cursor 1 6
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[20h\x1b[20labc\x0adef")
  print(t.dump())

test "DECOM homes to the top margin", '''
  |
  |X
  |
  |
  |
  cursor 1 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6hX")
  print(t.dump())

test "DECOM makes CUP relative", '''
  |
  |
  |  X
  |
  |
  cursor 2 3
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6h\x1b[2;3HX")
  print(t.dump())

test "DECOM keeps CUP in the region", '''
  |
  |
  |
  |  X
  |
  cursor 3 3
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6h\x1b[9;3HX")
  print(t.dump())

test "DECOM off homes to the corner", '''
  |X
  |
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6h\x1b[?6lX")
  print(t.dump())

test "DECSTBM in origin mode homes to the margin", '''
  |
  |
  |X
  |
  |
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[?6h\x1b[3;5rX")
  print(t.dump())

test "DECOM and VPA", '''
  |
  |
  |X
  |
  |
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6h\x1b[2dX")
  print(t.dump())

test "DECOM and CHA", '''
  |
  |
  |
  |    X
  |
  cursor 3 5
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6h\x1b[2;2H\x1b[5GX")
  print(t.dump())

test "DECSC saves origin mode", '''
  |
  |X
  |
  |
  |
  cursor 1 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6h\x1b7\x1b[?6l\x1b8\x1b[1;1HX")
  print(t.dump())

test "several modes at once", '''
  |abcdeh
  |
  cursor 0 5 wrap
'''
  t = terminal.Terminal.new(6, 2)
  !t.feed("\x1b[?7;6labcdefgh")
  print(t.dump())

test "an unknown mode is ignored", '''
  |ab
  |
  cursor 0 2
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("\x1b[?999h\x1b[999hab")
  print(t.dump())

test "DECTCEM changes nothing on screen", '''
  |abc
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("\x1b[?25lab\x1b[?25hc")
  print(t.dump())

test "XTRESTORE with nothing saved restores the default", '''
  |abcd
  |ef
  cursor 1 2
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("\x1b[?7l\x1b[?7rabcdef")
  print(t.dump())

test "XTSAVE and XTRESTORE", '''
  |abcf
  |
  cursor 0 3 wrap
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("\x1b[?7l\x1b[?7s\x1b[?7h\x1b[?7rabcdef")
  print(t.dump())

test "XTRESTORE of origin mode homes the cursor", '''
  |X
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[2;2H\x1b[?6rX")
  print(t.dump())
