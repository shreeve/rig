test "CNL and CPL go to the first column", '''
  |abc
  |Y
  |X
  |
  cursor 1 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x1b[2EX\x1b[1FY")
  print(t.dump())

test "CHA sets the column", '''
  |abc   X
  |
  |
  |
  cursor 0 7
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x1b[7GX")
  print(t.dump())

test "HPA sets the column", '''
  |abc X
  |
  |
  |
  cursor 0 5
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x1b[5`X")
  print(t.dump())

test "VPA sets the row", '''
  |abc
  |
  |   X
  |
  cursor 2 4
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x1b[3dX")
  print(t.dump())

test "HPR and VPR move right and down", '''
  |a   X
  |
  |     Y
  |
  cursor 2 6
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("a\x1b[3aX\x1b[2eY")
  print(t.dump())

test "movement clears a pending wrap", '''
  |abXd
  |
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(4, 3)
  !t.feed("abcd\x1b[DX")
  print(t.dump())

test "CUF from a pending wrap", '''
  |abcX
  |
  |
  cursor 0 3 wrap
'''
  t = terminal.Terminal.new(4, 3)
  !t.feed("abcd\x1b[CX")
  print(t.dump())

test "CUP clears a pending wrap", '''
  |Xbcd
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(4, 3)
  !t.feed("abcd\x1b[1;1HX")
  print(t.dump())

test "CHT and CBT move by tab stops", '''
  |                Y
  |
  cursor 0 17
'''
  t = terminal.Terminal.new(30, 2)
  !t.feed("\x1b[2IX\x1b[ZY")
  print(t.dump())

test "CBT stops at the first column", '''
  |Xbc
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(30, 2)
  !t.feed("abc\x1b[5ZX")
  print(t.dump())

test "two parameters to CUU do nothing", '''
  |
  |
  |  X
  |
  cursor 2 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3;3H\x1b[1;1AX")
  print(t.dump())

test "CHT of zero does nothing", '''
  |X
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(20, 2)
  !t.feed("\x1b[0IX")
  print(t.dump())

test "CBT keeps a pending wrap", '''
  |abcdefghijklm
  |X
  cursor 1 1
'''
  t = terminal.Terminal.new(13, 2)
  !t.feed("abcdefghijklm\x1b[ZX")
  print(t.dump())

test "HPR of zero stays and ends a pending wrap", '''
  |abcX
  |
  cursor 0 3 wrap
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("abcd\x1b[0aX")
  print(t.dump())

test "VPR of zero stays and ends a pending wrap", '''
  |abcX
  |
  |
  cursor 0 3 wrap
'''
  t = terminal.Terminal.new(4, 3)
  !t.feed("abcd\x1b[0eX")
  print(t.dump())

test "VPR in origin mode counts from the margin", '''
  |
  |
  |
  |X
  |
  cursor 3 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;4r\x1b[?6h\x1b[1eX")
  print(t.dump())

test "IND moves down", '''
  |ab
  |  X
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("ab\x1bDX")
  print(t.dump())

test "IND at the bottom scrolls", '''
  ^1
  |2
  | X
  cursor 1 2
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("1\x0d\x0a2\x1bDX")
  print(t.dump())

test "NEL moves to the next line", '''
  |ab
  |X
  |
  cursor 1 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("ab\x1bEX")
  print(t.dump())

test "RI moves up", '''
  |
  |  X
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[3;3H\x1bMX")
  print(t.dump())

test "RI at the top scrolls down", '''
  |X
  |1
  |2
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x1b[H\x1bMX")
  print(t.dump())

test "HTS sets a tab stop", '''
  |   X
  |
  cursor 0 4
'''
  t = terminal.Terminal.new(20, 2)
  !t.feed("\x1b[4G\x1bH\x0d\x09X")
  print(t.dump())

test "TBC 0 clears the stop at the cursor", '''
  |                X
  |
  cursor 0 17
'''
  t = terminal.Terminal.new(20, 2)
  !t.feed("\x1b[9G\x1b[0g\x0d\x09X")
  print(t.dump())

test "TBC with no parameter does nothing", '''
  |        X
  |
  cursor 0 9
'''
  t = terminal.Terminal.new(20, 2)
  !t.feed("\x1b[9G\x1b[g\x0d\x09X")
  print(t.dump())

test "TBC 3 clears every stop", '''
  |                   X
  |
  cursor 0 19 wrap
'''
  t = terminal.Terminal.new(20, 2)
  !t.feed("\x1b[3g\x09X")
  print(t.dump())

test "DECSC and DECRC save the position", '''
  |abY
  |
  |    X
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("ab\x1b7\x1b[3;5HX\x1b8Y")
  print(t.dump())

test "DECRC with nothing saved goes home", '''
  |X
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[2;2H\x1b8X")
  print(t.dump())

test "DECRC restores a pending wrap", '''
  |abcd
  |X
  |
  cursor 1 1
'''
  t = terminal.Terminal.new(4, 3)
  !t.feed("abcd\x1b7\x1b[2;1H\x1b8X")
  print(t.dump())

test "an unknown escape is ignored", '''
  |abc
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("a\x1bQb\x1b(Bc")
  print(t.dump())

test "CSI s and CSI u save and restore the cursor", '''
  |abY
  |
  |    X
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("ab\x1b[s\x1b[3;5HX\x1b[uY")
  print(t.dump())

test "CSI s with parameters does nothing", '''
  |Yb
  |
  |    X
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("ab\x1b[2s\x1b[3;5HX\x1b[uY")
  print(t.dump())

test "RIS resets everything", '''
  |X
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[2;3r\x1b[1;31m\x1b[?7lab\x1bcX")
  print(t.dump())

test "CAN cancels a sequence", '''
  |a;3HX
  |
  cursor 0 5
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("a\x1b[2\x18;3HX")
  print(t.dump())

test "SUB cancels a sequence", '''
  |aHX
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("a\x1b[\x1aHX")
  print(t.dump())

test "ESC restarts a sequence", '''
  |
  | X
  |
  |
  cursor 1 2
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3\x1b[2;2HX")
  print(t.dump())

test "a control inside CSI runs", '''
  |abX
  |
  |
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x1b[2\x0dCX")
  print(t.dump())

test "a late control inside CSI is dropped", '''
  |abc  X
  |
  |
  |
  cursor 0 6
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abc\x1b[2\x11CX")
  print(t.dump())

test "a private CSI is not a movement", '''
  |X
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[?5CX")
  print(t.dump())

test "an intermediate makes CSI unknown", '''
  |X
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[3 CX")
  print(t.dump())

test "a colon makes CSI unknown", '''
  |X
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[1:2HX")
  print(t.dump())

test "a leading colon is ignored", '''
  |X
  |
  |
  |
  cursor 0 1
'''
