  !t.feed("abcdefghij\x1b[1;4H\x1b[1K")
  print(t.dump())

test "EL 2 erases the row", '''
  |
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("abcdefghij\x1b[1;4H\x1b[2K")
  print(t.dump())

test "EL with an unknown parameter", '''
  |abcdefghij
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("abcdefghij\x1b[1;4H\x1b[5K")
  print(t.dump())

test "EL clears a pending wrap", '''
  |abcX
  |
  cursor 0 3 wrap
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("abcd\x1b[KX")
  print(t.dump())

test "selective EL erases", '''
  |abc
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("abcdefghij\x1b[1;4H\x1b[?K")
  print(t.dump())

test "ED 0 erases to the end of the screen", '''
  |abcdefghij
  |abc
  |
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("abcdefghijabcdefghijabcdefghijabcdefghij\x1b[2;4H\x1b[J")
  print(t.dump())

test "ED 1 erases to the cursor", '''
  |
  |    efghij
  |abcdefghij
  |abcdefghij
  cursor 1 3
'''
