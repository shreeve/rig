test "a huge parameter is clamped", '''
  |         X
  |
  |
  |
  cursor 0 9 wrap
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("\x1b[99999999999CX")
  print(t.dump())

test "OSC is ignored to BEL", '''
  |ab
  |
  cursor 0 2
'''
