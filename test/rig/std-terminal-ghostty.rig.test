test "EL 2 erases the row", '''
  |
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("abcdefghij\x1b[1;4H\x1b[2K")
  print(t.dump())

test "EL with an unknown parameter", '''
  |abcdefghij
  |
  cursor 0 3
'''
  t = terminal.Terminal.new(10, 2)
  !t.feed("abcdefghij\x1b[1;4H\x1b[5K")
