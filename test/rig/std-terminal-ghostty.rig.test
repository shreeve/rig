test "wide runes go with their rows", '''
  ^一一
  ^一x
  |2
  |3
  cursor 1 1
'''
  t = terminal.Terminal.new(5, 2)
  !t.feed("\xe4\xb8\x80\xe4\xb8\x80\xe4\xb8\x80x\x0d\x0a2\x0d\x0a3")
  print(t.dump())

test "a wide rune wrapped leaves its spacer in the history", '''
  ^ab
  ^一
  |3
  |4
  cursor 1 1
'''
  t = terminal.Terminal.new(3, 2)
  !t.feed("ab\xe4\xb8\x80\x0d\x0a3\x0d\x0a4")
  print(t.dump())

test "joined runes go with their cells", '''
  ^éx
  |2
  |3
  cursor 1 1
'''
  t = terminal.Terminal.new(6, 2)
  !t.feed("e\xcc\x81x\x0d\x0a2\x0d\x0a3")
  print(t.dump())

test "chars of mode 2027 go with their cells", '''
  ^👨‍👩x
  |2
  |3
  cursor 1 1
'''
  t = terminal.Terminal.new(6, 2)
  !t.feed("\x1b[?2027h\xf0\x9f\x91\xa8\xe2\x80\x8d\xf0\x9f\x91\xa9x\x0d\x0a2\x0d\x0a3")
  print(t.dump())

test "protected cells go with their rows", '''
  ^ab
  |2
  |3
  cursor 1 1
'''
  t = terminal.Terminal.new(6, 2)
  !t.feed("\x1b[1\"qab\x1b[0\"q\x0d\x0a2\x0d\x0a3\x1b[?1049h\x1b[?1049l")
  print(t.dump())

test "the alternate screen keeps nothing", '''
  |2
  |3
  |4
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[?1049h1\x0d\x0a2\x0d\x0a3\x0d\x0a4")
  print(t.dump())

test "the primary screen's history shows on the alternate", '''
  ^1
  |
  |
  | X
  cursor 2 2
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x1b[?1049hX")
  print(t.dump())

test "the history outlasts the alternate screen", '''
  ^1
  |2
  |3
  |49
  cursor 2 2
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x1b[?1049h5\x0d\x0a6\x0d\x0a7\x0d\x0a8\x1b[?1049l9")
  print(t.dump())

test "ED 3 erases the history", '''
  |3
  |4
  |5
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x0d\x0a5\x1b[3J")
  print(t.dump())

test "ED 3 keeps the screen and cursor", '''
  |3
  |4X
  |5
  cursor 1 2
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x0d\x0a5\x1b[2;2H\x1b[3JX")
  print(t.dump())

test "rows after ED 3 fill the history again", '''
  ^3
  ^4
  ^5
  ^6
  |7
  |8
  |9
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x0d\x0a5\x1b[3J\x0d\x0a6\x0d\x0a7\x0d\x0a8\x0d\x0a9")
  print(t.dump())

test "rows erased by ED 3 come back blank", '''
  ^3
  ^4
  ^5
  ^6
  |
  |
  |
  cursor 2 0
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[44m1\x1b[K\x0d\x0a\x1b[m\xe4\xb8\x80e\xcc\x81\x0d\x0a3\x0d\x0a4\x0d\x0a5\x1b[3J\x0d\x0a6\x0d\x0a\x0d\x0a\x0d\x0a")
  print(t.dump())

test "ED 3 on the alternate screen keeps the primary's history", '''
  ^1
  |2
  |3
  |4
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x1b[?1049h\x1b[3J\x1b[?1049l")
  print(t.dump())

test "DECALN fills the screen, not the history", '''
  ^1
  |EEEE
  |EEEE
  cursor 0 0
'''
  t = terminal.Terminal.new(4, 2)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x1b#8")
  print(t.dump())

test "ED 2 keeps the history", '''
  ^1
  |
  |
  |
  cursor 2 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x1b[2J")
  print(t.dump())

test "RIS erases the history", '''
  |X
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x1bcX")
  print(t.dump())

test "ED 22 moves the screen into the history", '''
  ^1
  ^2
  ^3
  |
  |
  |
  cursor 0 0
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x1b[22J")
  print(t.dump())

test "ED 22 moves rows down to the last with text", '''
  ^1
  ^2
  ^3
  |X
  |
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x1b[1;5H\x1b[22JX")
  print(t.dump())

test "ED 22 keeps the cursor below the rows it moves", '''
  ^1
  ^2
  |
  |  X
  |
  |
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("1\x0d\x0a2\x1b[4;3H\x1b[22JX")
  print(t.dump())

test "ED 22 keeps the empty rows above the cursor", '''
  ^
  ^1
  |
  |
  |  X
  |
  |
  cursor 2 3
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("\x1b[2;1H1\x1b[5;3H\x1b[22JX")
  print(t.dump())

test "ED 22 of an empty screen", '''
  |
  |  X
  |
  cursor 1 3
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("\x1b[2;3H\x1b[22JX")
  print(t.dump())

test "ED 22 counts a row with a background", '''
  ^1
  ^
  ^
  | X
  |
  |
  |
  ~-1 0-9 bg=4
  cursor 0 2
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("1\x1b[3;1H\x1b[44m\x1b[K\x1b[m\x1b[4;2H\x1b[22JX")
  print(t.dump())

test "ED 22 counts a row with a spacer", '''
  ^ab
  ^一
  |X
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(3, 4)
  !t.feed("ab\xe4\xb8\x80\x1b[3;1H\x1b[22JX")
  print(t.dump())

test "ED 22 counts a wide rune on one column as empty", '''
  |
  |
  ~0 0-0 bg=2
  cursor 0 0
'''
  t = terminal.Terminal.new(1, 2)
  !t.feed("\x1b[42m\xea\xb0\x9f\x1b[22J")
  print(t.dump())

test "ED 22 brings in rows without the pen's background", '''
  ^1
  ^2
  |
  |
  |
  cursor 0 0
'''
  t = terminal.Terminal.new(10, 3)
  !t.feed("1\x0d\x0a2\x1b[44m\x1b[22J\x1b[m")
  print(t.dump())

test "ED 22 clears a pending wrap", '''
  ^
  ^
  ^abcd
  |X
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(4, 3)
  !t.feed("\x1b[3;1Habcd\x1b[22JX")
  print(t.dump())

test "ED 22 ignores the margins", '''
  ^1
  ^2
  ^3
  |
  |X
  |
  |
  |
  cursor 1 1
'''
  t = terminal.Terminal.new(10, 5)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x1b[2;4r\x1b[5;1H\x1b[22JX")
  print(t.dump())

test "ED 22 on the alternate screen keeps nothing", '''
  ^1
  |X
  |
  |
  |
  cursor 0 1
'''
  t = terminal.Terminal.new(10, 4)
  !t.feed("1\x0d\x0a2\x0d\x0a3\x0d\x0a4\x0d\x0a5\x1b[?1049ha\x0d\x0ab\x1b[4;1H\x1b[22JX")
  print(t.dump())

