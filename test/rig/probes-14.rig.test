fail "r3-s36-reads-k03 take push bare", "`b` owns a `Bag`, which can't be copied into a box: write `<b` to move it or `+b` to clone it"
  obj Bag
    n: Int
    v: List[Int]

    fun total(?self) -> Int
      self.n + self.v.len

  fun mk(n: Int) -> Bag
    v: List[Int] = List()
    !v.push(n)
    Bag(n: n, v: <v)

  fun size(b: ?Bag) -> Int
    b.n + b.v.len

  sub eat(b: Bag)
    print(b.n)

