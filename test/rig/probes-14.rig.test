fail "r3-s36-reads-q08 ifas header view", "a view of the temporary `mk(3)` outlives its statement, which drops it; bind the value to a name first"
  obj B
    n: Int

    fun get(?self) -> Int
      self.n

    drop(!self)
      print("drop", self.n)

  fun mk(n: Int) -> B
    B(n: n)

  fun mko(n: Int) -> B?
    B(n: n)

  fun idp(b: ?B) -> (?B)?
    b

  if idp(?mk(3)) as r
    print("body", r.n)
  print("after")

test "r3-s36-reads-q09 match temp move", '''
  kept 1
  drop 1
  after
'''
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum E
    one(b: B)
    zero

  fun mk() -> E
    E.one(b: B(n: 1))

  sub keep(b: B)
    print("kept", b.n)

  match mk()
    .one(b) => keep(<b)
    .zero => pass
  print("after")

