fail "r3-s36-reads-q15 while as header view", "a view of the temporary `B(n: i)` outlives its statement, which drops it; bind the value to a name first"
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  fun idp(b: ?B) -> (?B)?
    b if b.n < 3 else none

  i = 0
  while idp(?B(n: i)) as r
    print("body", r.n)
    i += 1
  print("after")

