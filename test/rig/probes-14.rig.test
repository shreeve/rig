# Probes from past reviews and audits, 14 of 41: r3-s36-loans-text_st02_loop_view_into_vec to r3-s36-reads-x04_text_for_q.

use std.text

fail "r3-s36-loans-text st02 loop view into vec", "`t` does not live long enough"
  names: List[?String] = List()
  for i in 0..3
    t = String("n", i)
    !names.push(?t[..])
  print(names)

fail "r3-s36-loans-text st03 payload copy keeps loan", "cannot lend `t` to write while a read loan is live"
  enum H
    has(s: ?String)
    no

  t = String("abc")
  h: H = .has(s: ?t[..])
  match h
    .has(s)
      w = s
      <h
      !t.add("d")
      print(w)
    .no => print("no")

fail "r3-s36-loans-text st04 closure view then mutate", "cannot lend `t` to write while a read loan is live"
  t = String("abc")
  s: ?String = ?t[..]
  f = |?s| print(s)
  !t.add("d")
  f()

fail "r3-s36-loans-text st05 over lend key", "cannot lend `k` to write while a read loan is live"
  # Over-lending with Strings: the result can only view `hay`, but it
  # views the key's Text too.
  fun after(hay: ?String, key: ?String) -> ?String
    hay[key.len..]

  doc = String("key=value")
  k = String("key=")
  v = after(?doc, ?k)
  !k.add("x")
  print(v)

fail "r3-s36-loans-text st07 defer view at propagate", "cannot drop `x` while it is lent"
  error E
    bad

  fun maybe(ok: Bool) -> Int!
    return E.bad if not ok
    1

  fun f(ok: Bool) -> Int!
    keep = String("keep")
    x = String("x")
    r: ?String = ?x[..]
    defer r = ?keep[..]
    k = maybe(ok)!
    <x
    print(r, k)
    k

  print(f(true) catch 0)

fail "r3-s36-loans-text st08 for view elems push", "cannot lend `t` to write while a read loan is live"
  t = String("a b")
  names: List[?String] = List()
  !names.push(?t[0..1])
  for s in ?names
    !t.add("!")
    print(s)

fail "r3-s36-loans-text st09 optional view coalesce", "cannot lend `t` to write while a read loan is live"
  fun find(hay: ?String, b: U8) -> (?String)?
    for c, i in hay
      return hay[i..] if c == b
    none

  t = String("a=b")
  rest = find(?t, 61) ?? ""
  !t.add("c")
  print(rest)

fail "r3-s36-loans-text st10 match temp view", "a view of the temporary `mk()` outlives its statement, which drops it; bind the value to a name first"
  fun mk() -> String
    String("temp")

  s: ?String = "x"
  s = ?mk()[..]
  print(s)

test "r3-s36-n03 tail match drops", '''
  drop 2
  1
  drop 1
'''
  obj R
    n: Int

    drop(!self)
      print("drop", self.n)

  fun pick(k: Int) -> R
    a = R(n: 1)
    b = R(n: 2)
    match k
      0 => a
      _ => b

  x = pick(0)
  print(x.n)

fail "r3-s36-n06 box lend then reassign", "cannot reassign `b` while it is lent"
