test "r3-s36-reads-q01 print ternary names", '''
  1
  1 2
  drop 2
  drop 1
'''
  obj B
    n: Int

    fun get(?self) -> Int
      self.n

    drop(!self)
      print("drop", self.n)

  fun mk(n: Int) -> B
    B(n: n)

  fun mko(n: Int) -> B?
    B(n: n)

  a = mk(1)
  b = mk(2)
  c = true
  print((a if c else b).n)
  print(a.n, b.n)

