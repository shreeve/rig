    s

  b = ^S(n: 1)
  r = get(?b)
  b = ^S(n: 2)
  print(r.n)

fail "r3-s36-n07 match box payload reassign", "cannot reassign `b` while it is lent"
  enum Sh
    circle(r: List[Int])
    dot

  v: List[Int] = List()
  !v.push(1)
  b = ^Sh.circle(<v)
  match ?b
    .circle(r)
      b = ^Sh.dot
      print(r.len)
    .dot => print("dot")

