    v: List[Int] = List()
    !v.push(n)
    Bag(n: n, v: <v)

  fun size(b: ?Bag) -> Int
    b.n + b.v.len

  b = mk(3)
  print(b.v)
  print(b.v.len, b.total())
  print(b.n)

