test "r3-s36-reads-t01 return bare", "0 0 0 0"
  obj Bag
    v: List[Int]

  fun mk() -> Bag
    b = Bag(v: List())
    return b

  fun mk2() -> Bag
    b = Bag(v: List())
    b

  fun mk4(c: Bool) -> Bag
    b = Bag(v: List())
    d = Bag(v: List())
    b if c else d

  fun mk5(c: Bool) -> Bag
    b = Bag(v: List())
    d = Bag(v: List())
    if c
      b
    else
      d

  a = mk()
  b = mk2()
  c = mk4(false)
  d = mk5(true)
  print(a.v.len, b.v.len, c.v.len, d.v.len)

