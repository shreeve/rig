test "r3-s36-reads-l08 callable", "3 12 20"
  fun twice(f: ?fun(Int) -> Int, x: Int) -> Int
    f(f(x))

  fun inc(x: Int) -> Int
    x + 1

  k = 10
  add = |?k, x: Int| x + k
  print(twice(inc, 1), twice(|x: Int| x * 2, 3), twice(?add, 0))

test "r3-s36-reads-l11 box array slice", "6"
  fun sum(xs: []Int) -> Int
    s = 0
    for x in xs
      s += x
    s

  b = ^[1, 2, 3]
  print(sum(?b))

