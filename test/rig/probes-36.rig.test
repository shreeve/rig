fail "review-while-step-gen-catchbreak-match-grow", "cannot lend `v` to write while a read loan is live"
  # oracle: mk accept
  # oracle: mkf accept
  # oracle: grow accept
  # oracle: main reject C4

  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int], n: Int) -> S?
    if n < 4
      return S(s: ?v[..])
    none

  fun mkf(v: ?List[Int], n: Int) -> S?!
    return E.bad if n == 70
    mk(v, n)

  sub grow(v: !List[Int])
    for i in 0..50
      !v.push(i)

  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  @outer while (mkf(?v, n) catch break) as h: k += h.s[0]
    n += 1
    match n
      1
        j = 0
        while j < 2: j += 1
          grow(!v)
          continue @outer
      _
        grow(!v)
  print(k, n)

test "review-while-step-gen-catchbreak-match-read", "4004 4"
  # oracle: mk accept
  # oracle: mkf accept
  # oracle: grow accept
  # oracle: main accept

  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int], n: Int) -> S?
    if n < 4
      return S(s: ?v[..])
    none

  fun mkf(v: ?List[Int], n: Int) -> S?!
    return E.bad if n == 70
    mk(v, n)

  sub grow(v: !List[Int])
    for i in 0..50
      !v.push(i)

  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  @outer while (mkf(?v, n) catch break) as h: k += h.s[0]
    n += 1
    match n
      1
        j = 0
        while j < 2: j += 1
          k += 1000
          continue @outer
      _
        k += 1000
  print(k, n)

test "review-while-step-gen-catchbreak-whileas-read", "4004 4"
  # oracle: mk accept
  # oracle: mkf accept
  # oracle: grow accept
  # oracle: main accept

  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int], n: Int) -> S?
    if n < 4
      return S(s: ?v[..])
    none

  fun mkf(v: ?List[Int], n: Int) -> S?!
    return E.bad if n == 70
    mk(v, n)

  sub grow(v: !List[Int])
    for i in 0..50
      !v.push(i)

  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  @outer while (mkf(?v, n) catch break) as h: k += h.s[0]
    n += 1
    while mk(?v, 0) as g
      k += g.s[0] - 1
      k += 1000
      continue @outer
  print(k, n)

fail "review-while-step-gen-catchnone-whilefor-grow", "cannot lend `v` to write while a read loan is live"
  # oracle: mk accept
  # oracle: mkf accept
  # oracle: grow accept
  # oracle: main reject C4

  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int], n: Int) -> S?
    if n < 4
      return S(s: ?v[..])
    none

  fun mkf(v: ?List[Int], n: Int) -> S?!
    return E.bad if n == 70
    mk(v, n)

  sub grow(v: !List[Int])
    for i in 0..50
      !v.push(i)

  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  @outer while (mkf(?v, n) catch none) as h: k += h.s[0]
    n += 1
    j = 0
    while j < 2: j += 1
      for _ in 0..1
        grow(!v)
        continue @outer
  print(k, n)

test "review-while-step-gen-plain-whilecond-read", "4004 4"
  # oracle: mk accept
  # oracle: mkf accept
  # oracle: grow accept
  # oracle: main accept

  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int], n: Int) -> S?
    if n < 4
      return S(s: ?v[..])
    none

  fun mkf(v: ?List[Int], n: Int) -> S?!
    return E.bad if n == 70
    mk(v, n)

  sub grow(v: !List[Int])
    for i in 0..50
      !v.push(i)

  v: List[Int] = List()
  !v.push(1)
  k = 0
  n = 0
  @outer while mk(?v, n) as h: k += h.s[0]
    n += 1
    j = 0
    while j < 2
      j += 1
      k += 1000
      continue @outer if j > 0
  print(k, n)

test "review-while-step-w04-labeled-continue-inner-while", "25 5"
  # `continue @outer` from an inner `while` must run the outer step,
  # which reads the outer condition's binding.
  #
  # oracle: mk accept
  # oracle: main accept
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(5)
  k = 0
  i = 0
  @outer while mk(?v, i) as h: k += h.s[0]
    i += 1
    j = 0
    while j < 3: j += 1
      continue @outer if j == 2
    k += 100
  print(k, i)

  # expect: 25 5

fail "review-while-step-w06-body-local-repoint", "`local` does not live long enough"
  # The body re-points an outer view at a body-local List, which drops
  # at the body's end; the step then reads the view.
  #
  # oracle: main reject C5
  w: List[Int] = List()
  !w.push(7)
  s = ?w[..]
  k = 0
  i = 0
  while i < 3: k += s[0]
    local: List[Int] = List()
    !local.push(i)
    s = ?local[..]
    i += 1
  print(k)

fail "review-while-step-w07-body-defer-reads-h", "cannot lend `v` to write while a read loan is live"
  # oracle: mk accept
  # oracle: main reject C4

  obj S
    s: []Int

  fun mk(v: ?List[Int]) -> S?
    if v.len < 40
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  while mk(?v) as h: k += 1
    defer k += h.s[0]
    !v.push(2)
  print(k)

fail "review-while-step-w08-step-grows-outer-view-live", "cannot lend `v` to write while a read loan is live"
