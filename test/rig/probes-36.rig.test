test "review-text3-b11", '''
  took 1
  drop 1
  end
'''
  obj N
    id: Int
    t: String

    drop(!self)
      print("drop", self.id)

  enum M
    a(n: N, s: ?String, r: ?String)
    c

  fun mk(s: ?String, r: ?String) -> M
    M.a(n: N(id: 1, t: String("owned")), s: s, r: r)

  sub take(n: N)
    print("took", n.id)

  t = String("hello")
  u = String("world")
  match mk(?t[..], ?u[..])
    .a(n, _, _) => take(<n)
    .c => print("c")
  print("end")

test "review-text3-b3", '''
  took
  drop 1
  end
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  enum Inner
    x(n: N)
    y

  enum M
    a(i: Inner)
    c

  fun mk() -> M
    M.a(i: Inner.x(n: N(id: 1)))

  sub take(i: Inner)
    print("took")

  match mk()
    .a(i) => take(<i)
    .c => print("c")
  print("end")

test "review-text3-b4", '''
  took 1
  drop 1
  end
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  fun mk() -> N?
    N(id: 1)

  sub take(n: N)
    print("took", n.id)

  if mk() as n
    take(<n)
  print("end")

test "review-text3-b5", '''
  took 1
  drop 1
  end
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  enum M
    a(n: N)
    c

  fun mk() -> M
    M.a(n: N(id: 1))

  sub take(n: N)
    print("took", n.id)

  f = ||
    match mk()
      .a(n) => take(<n)
      .c => print("c")
  f()
  print("end")

test "review-text3-d11", '''
  hello world
  11
  1
  end
'''
  fun f(o: String?) -> Int?
    print(o?)
    print(o?.len)
    1

  x: String? = String("hello world")
  print(f(<x) ?? 0)
  print("end")

fail "review-text3-d14", "`o` owns a `String?`, which can't be copied by `=`: write `<o` to move it, `+o` to clone it, or `?o` to view it"
  sub take(t: String)
    print(t)

  fun f(o: String?) -> Int?
    _ = o?
    take(o?)
    1

  x: String? = String("hello")
  print(f(<x) ?? 0)

test "review-text3-d8", '''
  N(id: 1)
  N(id: 1)
  end
  drop 1
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  fun mk() -> N
    N(id: 9)

  o: N? = N(id: 1)
  c = false
  print(mk() if c else (o ?? mk()))
  print(o)
  print("end")

fail "review-text3-e7", "a view of the temporary `maybe(1) ?? N(id: 4, t: String(\"dd\"))` outlives its statement, which drops it; bind the value to a name first"
  obj N
    id: Int
    t: String

    drop(!self)
      print("drop", self.id)

  fun maybe(k: Int) -> N?
    N(id: k, t: String("aaaa")) if k > 0 else none

  print(text.trim(?(maybe(1) ?? N(id: 2, t: String("bb"))).t))
  print((maybe(0) ?? N(id: 3, t: String("cc"))).t)
  s = text.trim(?(maybe(1) ?? N(id: 4, t: String("dd"))).t)
  print(s)

fail "review-text3-f1", "cannot move `b` while a read loan is live"
  b = ^String("boxed")
  s = ?b[1..]
  t = <b.unbox()
  print(s, t)

fail "review-text3-f2", "cannot move `b` while a read loan is live"
  b = ^String("boxed")
  s = ?b[1..]
  c = <b
  print(s, c)

fail "review-text3-f3", "cannot lend `b` to write while a read loan is live"
  b = ^String("boxed")
  s = ?b[1..]
  !b.add(" more text that forces a realloc of the buffer")
  print(s)

fail "review-text4-a3", "`n` owns an `N`, which can't be copied into a counted handle: write `<n` to move it"
  obj N
    id: Int
    drop(!self)
      print("drop", self.id)

  n = N(id: 1)
  print(*n)
  print(n.id)

fail "review-text4-e6", "`h` is a `*N` handle, which can't be copied into an argument: write `<h` to move it or `+h` for another handle"
  obj N
    id: Int
    drop(!self)
      print("drop", self.id)

  obj P
    a: *N
    b: *N

  h = *N(id: 1)
  print(P(a: h, b: h).a.id)
  print(h.id)

test "review-text4-q1", '''
  N(id: 1)
  drop 1
  mid
  N(id: 3)
  drop 3
  end run
  --
  N(id: 2)
  drop 2
  mid
  N(id: 3)
  drop 3
  end run
  drop 1
'''
  obj N
    id: Int
    drop(!self)
      print("drop", self.id)

  fun mo(k: Int) -> N?
    N(id: k) if k > 0 else none

  sub run(c: Bool)
    a = N(id: 1)
    print(<a if c else N(id: 2))
    print("mid")
    o = N(id: 3)
    print(mo(0) ?? <o)
    print("end run")

  run(true)
  print("--")
  run(false)

test "review-text4-q2", '''
  N(id: 5)
  drop 5
  N(id: 6)
  drop 6
  8
  end
  drop 8
  drop 7
  drop 4
  drop 3
'''
  obj N
    id: Int
    drop(!self)
      print("drop", self.id)

  fun mo(k: Int) -> N?
    N(id: k) if k > 0 else none

  fun mf(k: Int) -> N!
    N(id: k)

  o = N(id: 3)
  print(mo(5) ?? <o)
  p = N(id: 4)
  print(mf(6) catch <p)
  q = N(id: 7)
  x = mo(8) ?? <q
  print(x.id)
  print("end")

test "review-while-step-2-gen2-matchvalue-catchbreak-catchbreak", '''
  step 0 0
  step 9 0
  drop 101
  mdefer 1 1
  step 2 6
  drop 102
  mdefer 1 2
  step 2 7
  drop 103
  mdefer 1 3
  step 2 8
  drop 104
  mdefer 1 4
  step 2 9
  after mid 1 4
  drop 1
  odefer 1
  step 1 6
  step 9 0
  drop 101
  mdefer 2 1
  step 2 6
  drop 102
  mdefer 2 2
  drop 2
  odefer 2
  step 1 7
  step 9 0
  drop 101
  mdefer 3 1
  step 2 6
  drop 102
  mdefer 3 2
  step 2 7
  drop 103
  mdefer 3 3
  step 2 8
  drop 104
  mdefer 3 4
  step 2 9
  after mid 3 4
  drop 3
  odefer 3
  step 1 8
  step 9 0
  drop 101
  mdefer 4 1
  step 2 6
  drop 102
  mdefer 4 2
  drop 4
  odefer 4
  step 1 9
  end 275 4
'''
  # review-while-step-2 gen2 cell matchvalue.catchbreak.catchbreak: steps, defers and drops must
  # print what the plain.plain cell prints.
  #
  # oracle: D.drop accept
  # oracle: mk accept
  # oracle: mkf accept
  # oracle: fresh accept
  # oracle: take accept
  # oracle: odd accept
  # oracle: main accept
  error E
    bad

  obj S
    s: []Int

  obj D
    n: Int
    drop(!self)
      print("drop", self.n)

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 4
      return S(s: ?v[..])
    none

  fun mkf(v: ?List[Int], i: Int, bad: Int) -> S?!
    return E.bad if i == bad
    mk(v, i)

  fun fresh(t: Int, n: Int) -> List[Int]
    print("step", t, n)
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  fun odd(j: Int) -> Int?
    j if j % 2 == 1 else none

  v: List[Int] = List()
  !v.push(5)
  a = fresh(0, 0)
  k = 0
  i = 0
  @outer while (mkf(?v, i, 99) catch break) as h: a = fresh(1, h.s[0] + i)
    i += 1
    defer print("odefer", i)
    x = D(n: i)
    k += take(<a)
    m = 0
    b = fresh(9, 0)
    @mid while (mkf(?v, m, 99) catch break) as g: b = fresh(2, g.s[0] + m)
      m += 1
      defer print("mdefer", i, m)
      y = D(n: 100 + m)
      k += take(<b)
      w = match m
        1 => 10
        2
          continue @outer if i % 2 == 0
          20
        _ => 30
      k += w
    print("after mid", i, m)
  print("end", k, i)

