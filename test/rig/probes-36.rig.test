  !v.push(1)
  s = ?v[..]
  k = 0
  i = 0
  while i < 40: !v.push(i)
    k += s[0]
    i += 1
  print(k)

fail "review-while-step-w09-cond-grows-outer-view-step", "cannot lend `w` to write while a read loan is live"
  # oracle: grow accept
  # oracle: main reject C4

  fun grow(v: !List[Int]) -> Bool
    !v.push(1)
    v.len < 40

  w: List[Int] = List()
  !w.push(1)
  s = ?w[..]
  k = 0
  while grow(!w): k += s[0]
    k += 1
  print(k)

fail "review-while-step-w10-closure-step", "cannot lend `v` to write while a read loan is live"
