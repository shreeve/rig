    drop(!self)
      print("drop", self.id)

  enum M
    a(n: N, s: ?String)
    b

  fun mk(s: ?String) -> M
    M.a(n: N(id: 1), s: s)

  sub take(n: N)
    print("took", n.id)

  t = String("hello")
  match mk(?t[..])
    .a(n, s) => take(<n)
    .b => print("b")
  print("end")

