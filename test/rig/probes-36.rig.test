fail "review-while-step-w26-shared-reassign", "cannot reassign `x` while it is lent"
  # A slice of a shared List; the body replaces the handle (the last one),
  # freeing the List the step's slice views.
  #
  # oracle: all accept
  # oracle: main reject C4
  fun all(v: ?List[Int]) -> []Int
    ?v[..]

  x = *List[Int]()
  s = all(?x)
  k = 0
  i = 0
  while i < 3: k += s.len
    x = *List[Int]()
    i += 1
  print(k)

fail "review-while-step-w27-shared-view-binding", "cannot reassign `r` while it is lent"
  # oracle: all accept
  # oracle: mkn accept
  # oracle: main reject C4

  obj Node
    vals: List[Int]

  fun all(n: ?Node, i: Int) -> ([]Int)?
    if i < 4
      return ?n.vals[..]
    none

  fun mkn(x: Int) -> *Node
    v: List[Int] = List()
    !v.push(x)
    *Node(vals: <v)

  r = mkn(1)
  k = 0
  i = 0
  while all(?r, i) as s: k += s[0]
    r = mkn(i)
    i += 1
  print(k)

test "review-while-step-w29-weak-step", "0 1"
  # The step upgrades a weak handle whose strong handle the body
  # replaces: the upgrade fails safely.
  #
  # oracle: count accept
  # oracle: main accept
  obj Node
    val: Int

  fun count(w: ?~Node) -> Int
    if *w as n
      return n.val
    0

  s = *Node(val: 5)
  w = ~s
  k = 0
  i = 0
  while i < 3: k += count(?w)
    s = *Node(val: 1)
    i += 1
  print(k, s.val)

  # expect: 0 1

fail "review-while-step-w30-enclosing-defer", "cannot lend `v` to write while a read loan is live"
  # A defer of the enclosing scope reads an outer view; the step grows
  # the List it views.
  #
  # oracle: main reject C4
  v: List[Int] = List()
  !v.push(1)
  s = ?v[..]
  defer print(s[0])
  i = 0
  while i < 40: !v.push(i)
    i += 1
  print(v.len)

fail "review-while-step-w31-repoint-write-view-local", "`y` does not live long enough"
  # The body re-points an outer write view at a body-local value; the
  # step writes through it after the local's scope ended.
  #
  # oracle: main reject C5
  x = 1
  p = !x
  i = 0
  while i < 3: p += 1
    y = 5
    p = !y
    i += 1
  print(x)

fail "review-while-step-w32-outer-repoint-after-grow-ok", "cannot lend `v` to write while a read loan is live"
  # Valid: the body grows the List, then re-points the outer slice at it
  # before the step reads it. (Textual liveness may over-reject.)
  #
  # oracle: main accept
  v: List[Int] = List()
  !v.push(1)
  s = ?v[..]
  k = 0
  i = 0
  while i < 5: k += s[0]
    !v.push(2)
    s = ?v[..]
    i += 1
  print(k)

  # expect: 5

test "review-while-step-w33-shared-view-binding-clone-ok", "12"
  # Valid: the body clones the handle and drops the clone; the step reads
  # the slice the condition bound.
  #
  # oracle: all accept
  # oracle: main accept
  obj Node
    vals: List[Int]

  fun all(n: ?Node, i: Int) -> ([]Int)?
    if i < 4
      return ?n.vals[..]
    none

  v: List[Int] = List()
  !v.push(3)
  r = *Node(vals: <v)
  k = 0
  i = 0
  while all(?r, i) as s: k += s[0]
    c = +r
    <c
    i += 1
  print(k)

  # expect: 12

fail "review-while-step-w34-cond-temp-view", "a view of the temporary `mkv(i)` outlives its statement, which drops it; bind the value to a name first"
  # The condition binds a view of a temporary List made in the condition;
  # the step reads it.
  #
  # oracle: mkv accept
  # oracle: first accept
  # oracle: main reject C5
  fun mkv(i: Int) -> List[Int]
    v: List[Int] = List()
    !v.push(i)
    v

  fun first(v: ?List[Int], i: Int) -> ([]Int)?
    if i < 3
      return ?v[..]
    none

  k = 0
  i = 0
  while first(?mkv(i), i) as h: k += h[0]
    i += 1
  print(k)

fail "review-while-step-w35-step-reassigns-view-body-stale", "cannot lend `v` to write while a read loan is live"
  # The step re-points an outer slice; the body grows the List and then
  # reads the slice the step made before the growth.
  #
  # oracle: all accept
  # oracle: main reject C4
  fun all(v: ?List[Int]) -> []Int
    ?v[..]

  v: List[Int] = List()
  !v.push(1)
  e = [0]
  s: []Int = ?e[..]
  k = 0
  i = 0
  while i < 40: s = all(?v)
    !v.push(2)
    k += s[0]
    i += 1
  print(k)

test "review-while-step-w36-cond-writes-step-reads", "510 6"
  # The condition writes `v` and binds a view of it; the step reads the
  # view; the body only reads `v` through `h`.
  #
  # oracle: nx accept
  # oracle: main accept
  obj S
    s: []Int

  fun nx(v: !List[Int]) -> S?
    !v.push(v.len)
    if v.len < 6
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  k = 0
  while nx(!v) as h: k += h.s[h.s.len - 1]
    k += 100
  print(k, v.len)

  # expect: 510 6

fail "review-while-step-w37-fallible-cond", "cannot lend `v` to write while a read loan is live"
  # oracle: mk accept
  # oracle: run reject C4
  # oracle: main accept

  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int]) -> S?!
    return E.bad if v.len > 100
    if v.len < 40
      return S(s: ?v[..])
    none

  fun run() -> Int!
    v: List[Int] = List()
    !v.push(1)
    k = 0
    while mk(?v)! as h: k += h.s[0]
      !v.push(2)
    k

  print(run() catch 0)
