test "review-take-p60", '''
  user replace
  5 0
  closure swap 1 2
'''
  fun replace(a: !Int, b: Int) -> Int
    print("user replace")
    a = b
    0

  x = 1
  y = replace(!x, 5)
  print(x, y)
  swap = |a: Int, b: Int| print("closure swap", a, b)
  swap(1, 2)

test "review-take-p61", "P(a: 2, b: 1) 3"
  obj P
    a: Int
    b: Int

    sub swap(!self)
      t = self.a
      self.a = self.b
      self.b = t

    fun replace(?self, v: Int) -> Int
      v

  p = P(a: 1, b: 2)
  !p.swap()
  print(p, p.replace(3))

test "review-take-p71", '''
  Tree(key: 1, left: none, right: none)
  Tree(key: 2, left: Tree(key: 3, left: none, right: none), right: none)
  none Tree(key: 2, left: Tree(key: 3, left: none, right: none), right: none)
  drop 2
  drop 3
  drop 1
'''
  obj Tree
    key: Int
    left: ^Tree?
    right: ^Tree?

    drop(!self)
      print("drop", self.key)

  fun leaf(k: Int) -> ^Tree?
    ^Tree(key: k, left: none, right: none)

  fun cut(b: !^Tree) -> ^Tree?
    <b.left

  fun cut2(slot: !^Tree?) -> ^Tree?
    if !slot as t
      return <t.right
    none

  b = ^Tree(key: 2, left: leaf(1), right: leaf(3))
  l = cut(!b)
  print(l)
  swap(!b.left, !b.right)
  print(b)
  o: ^Tree? = <b
  r = cut2(!o)
  print(r, o)

