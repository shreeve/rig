  drop 2
  drop 3
'''
  obj R
    n: Int
    drop(!self)
      print("drop", self.n)

  obj S
    a: R?
    b: R?

  s = S(a: R(n: 1), b: R(n: 2))
  c = true
  y = <s.b if c else <s.a
  print(y, s)
  s.b = R(n: 3)
  z = <s.b if not c else none
  print(z, s)
  q = (c and <s.a == none)
  print(q, s)

