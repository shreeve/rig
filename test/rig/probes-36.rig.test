fail "review-while-step-w11-body-stores-h-step-grows", "cannot lend `v` to write while a read loan is live"
  # oracle: mk accept
  # oracle: main reject C4

  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 40
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(1)
  e: List[Int] = List()
  !e.push(0)
  last = S(s: ?e[..])
  k = 0
  i = 0
  while mk(?v, i) as h: !v.push(2)
    last = h
    i += 1
    k += last.s[0]
  print(k, last.s[0])

test "review-while-step-w13-labeled-continue-skips-step-plain", "21 5"
  # The same with a plain (not joined) condition, which emits Zig's own
  # continue expression.
  #
  # oracle: mk accept
  # oracle: fresh accept
  # oracle: take accept
  # oracle: main accept
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 5
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  @outer while mk(?v, i) as h: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    j = 0
    while j < 3: j += 1
      break @outer if i > 100
      continue @outer if j == 2
  print(k, i)

  # expect: 21 5

test "review-while-step-w15-catchbreak-continue-skips-step-uaf", "21 5"
  # The same as w14 through a single (not joined) condition with a jump
  # in it, `catch break`, which also takes the joined lowering.
  #
  # oracle: mk accept
  # oracle: fresh accept
  # oracle: take accept
  # oracle: main accept
  error E
    bad

  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?!
    return E.bad if i > 70
    if i < 5
      return S(s: ?v[..])
    none

  fun fresh(n: Int) -> List[Int]
    a: List[Int] = List()
    !a.push(n)
    a

  fun take(a: List[Int]) -> Int
    a[0]

  v: List[Int] = List()
  !v.push(5)
  a = fresh(1)
  k = 0
  i = 0
  @outer while (mk(?v, i) catch break) as h: a = fresh(h.s[0])
    i += 1
    k += take(<a)
    continue if i > 200
    j = 0
    while j < 3: j += 1
      break @outer if i > 100
      continue @outer if j == 2
  print(k, i)

  # expect: 21 5

