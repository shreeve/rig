test "review-take-p55", '''
  0 1
  1002
'''
  obj Node
    value: Int
    next: ^Node?

  obj Stack
    top: ^Node?

    sub push(!self, v: Int)
      self.top = ^Node(value: v, next: <self.top)

    fun pop(!self) -> Int?
      if <self.top as n
        self.top = <n.next
        return n.value
      none

    sub reverse(!self)
      cur = <self.top
      prev: ^Node? = none
      while <cur as n
        cur = <n.next
        n.next = <prev
        prev = <n
      self.top = <prev

  s = Stack(top: none)
  i = 0
  while i < 300000 : i += 1
    !s.push(i)
  !s.reverse()
  print((!s).pop(), (!s).pop())
  j = 0
  while j < 1000 : j += 1
    _ = !s.pop()
  print((!s).pop())

