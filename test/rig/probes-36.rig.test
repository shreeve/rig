test "review-text2-a1", '''
  drop 0
  drop 1
  drop 2
  i 3
  drop 10
  drop 10
  end
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  fun mk(i: Int) -> N
    N(id: i)

  fun get(n: ?N) -> Int
    n.id

  i = 0
  while get(?mk(i)) < 5
    i += 1
    if i == 2
      continue
    if i == 3
      break
  print("i", i)
  @outer for k in 0..2
    j = 0
    while get(?mk(10 + j)) < 12
      j += 1
      if k == 1
        break @outer
      if j == 1
        continue @outer
  print("end")

test "review-text2-a2", '''
  drop 0
  -1
  drop 0
  drop 1
  drop 2
  2
  drop 0
  drop 1
  drop 2
  -5
  101
  drop 51
  drop 50
  drop 61
  drop 60
  false
  drop 71
  drop 70
  true
  drop 80
  drop 81
  81
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  error Bad
    no

  fun mk(i: Int) -> N
    N(id: i)

  fun get(n: ?N) -> Int
    n.id

  fun f(x: Int) -> Int!
    if x > 1
      return Bad.no
    x

  fun g(o: Int?) -> Int
    i = 0
    while get(?mk(i)) < (o ?? return -1)
      i += 1
    i

  fun h(n: Int) -> Int!
    i = 0
    while get(?mk(i)) + f(i)! < n
      i += 1
    i

  print(g(none))
  print(g(2))
  print(h(10) catch -5)
  print(get(?mk(50)) + (f(5) catch get(?mk(51))))
  x = get(?mk(60)) > 0 and get(?mk(61)) > 100 and get(?mk(62)) > 0
  print(x)
  y = get(?mk(70)) < 0 or get(?mk(71)) > 0
  print(y)
  z = get(?mk(81)) if get(?mk(80)) > 0 else get(?mk(82))
  print(z)

test "review-text2-a3", '''
  drop 3
  4
  drop 20
  20
  drop 5
  9
  drop 7
  drop 8
  seven 9
  drop 9
  done
  deferred 99
  drop 99
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  fun mk(i: Int) -> N
    N(id: i)

  fun get(n: ?N) -> Int
    n.id

  fun twice[T](x: T, f: ?fun(T) -> Int) -> Int
    f(x) + get(?mk(5))

  fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  c = |x: Int|
    get(?mk(x)) + 1
  print(c(3))
  print(apply(|x| get(?mk(x * 10)), 2))
  print(twice(4, |x| x))
  defer print("deferred", get(?mk(99)))
  match get(?mk(7))
    7 if get(?mk(8)) == 8 => print("seven", get(?mk(9)))
    _ => print("other")
  print("done")

test "review-text2-a5", '''
  drop 1
  1
  1
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  fun mk[T](x: T) -> T
    x

  fun show[T](x: ?T) -> Int
    1

  fun gen[T](x: T) -> Int
    a = show(?mk(<x))
    a

  print(gen(N(id: 1)))
  print(gen(String("t")))

test "review-text2-d1", '''
  consume 1
  drop 1
  a
  2
  drop 2
  b
  consume 3
  drop 3
  consume 2
  drop 2
  consume 1
  drop 1
  c
  5
  drop 5
  4
  drop 4
  d
  e
  drop 7
'''
  obj N
    id: Int

    drop(!self)
      print("drop", self.id)

  fun maybe(i: Int) -> N?
    if i > 0
      return N(id: i)
    none

  sub consume(n: N)
    print("consume", n.id)

  if maybe(1) as n
    consume(<n)
  print("a")
  if maybe(2) as n
    print(n.id)
  print("b")
  i = 3
  while maybe(i) as n
    consume(<n)
    i -= 1
  print("c")
  j = 5
  while maybe(j) as n
    print(n.id)
    j -= 1
    if j == 3
      break
  print("d")
  v: List[^N] = List()
  if maybe(7) as n
    !v.push(^<n)
  print("e")

