    f(k)

  x = Item(n: 1)
  y = Item(n: 2)
  f = |?x, k: ?Item| x
  r = call(?f, ?y)
  y.n = 3
  print(r.n, y.n)

test "r3-or-formal-cursor", "1 2"
  obj Item
    n: Int

  obj Cursor
    items: ?List[Item]
    i: Int

    fun next(!@) -> ?Item
      k = @i
      @i += 1
      ?@items[k]

  v: List[Item] = List()
  !v.push(Item(n: 1))
  !v.push(Item(n: 2))
  c = Cursor(items: ?v, i: 0)
  a = (!c).next()
  b = (!c).next()
  print(a.n, b.n)

