fail "r3-or-formal-hr store", "cannot store a view of `x` through captured `h`: `h` outlives every call of the closure, and the closure's parameters and own values last one call at most"
  obj Item
    n: Int

  obj Holder
    r: ?Item

  sub each(v: ?[2]Item, f: ?sub(?Item))
    f(?v[0])

  g = Item(n: 1)
  h = Holder(r: ?g)
  f = |!h, x: ?Item| h.r = x
  if true
    arr = [2 of Item(n: 5)]
    each(?arr, ?f)
  print(h.r.n)

