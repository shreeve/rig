fail "r3-or-red-f2 fun lent var", "cannot assign to `y.n` while `y` is lent"
  # Must stay rejected once `left` says `from a` and `right` says `from b`:
  # a `?fun` local re-pointed in a branch holds the join of both.
  obj Item
    n: Int

  fun left(a: ?Item, b: ?Item) -> ?Item
    a

  fun right(a: ?Item, b: ?Item) -> ?Item
    b

  x = Item(n: 1)
  y = Item(n: 2)
  h = ?left
  if y.n > 1
    h = ?right
  r = h(?x, ?y)
  y.n = 5
  print(r.n)

fail "r3-or-red-f4 fun result", "cannot assign to `y.n` while `y` is lent"
  # Must stay rejected once `left` says `from a` and `right` says `from b`:
  # `choose`'s result type must not take `left`'s narrower origins.
  obj Item
    n: Int

  fun left(a: ?Item, b: ?Item) -> ?Item
    a

  fun right(a: ?Item, b: ?Item) -> ?Item
    b

  fun choose(c: Bool) -> ?fun(?Item, ?Item) -> ?Item
    if c
      return ?left
    ?right

  x = Item(n: 1)
  y = Item(n: 2)
  h = choose(y.n > 1)
  r = h(?x, ?y)
  y.n = 5
  print(r.n)

