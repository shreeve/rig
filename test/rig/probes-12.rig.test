# Probes from past reviews and audits, 12 of 41: r3-or-fit-f7b_parser_text to r3-s36-containers-b16_read_slice_repoint.

use std.os
use std.sort
use std.text

test "r3-or-fit-f7b parser text", "x 9"
  obj Tok
    kind: Int
    start: Int
    len: Int

  obj Parser
    src: ?String
    toks: []Tok
    pos: Int

    fun text(?@, t: ?Tok) -> ?String
      @src[t.start..t.start + t.len]

  src = String("let x")
  toks = [Tok(kind: 1, start: 0, len: 3), Tok(kind: 2, start: 4, len: 1)]
  p = Parser(src: ?src, toks: ?toks, pos: 0)
  name = ?p.text(?toks[1])
  p.pos = 1
  toks[0].kind = 9
  print(name, toks[0].kind)

test "r3-or-fit-f7c parser text only", "x 9"
  obj Tok
    kind: Int
    start: Int
    len: Int

  fun text(src: ?String, t: ?Tok) -> ?String
    src[t.start..t.start + t.len]

  src = String("let x")
  toks = [Tok(kind: 1, start: 0, len: 3), Tok(kind: 2, start: 4, len: 1)]
  name = text(?src, ?toks[1])
  toks[0].kind = 9
  print(name, toks[0].kind)

