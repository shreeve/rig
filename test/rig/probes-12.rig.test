fail "r3-or-generic-loopcopy", "`x` does not live long enough"
  # A generic loop over a `?List[T]` binds a copy of each element, which
  # the iteration holds (SPEC "Generic bodies"): `?x` lends that copy, so
  # a view of it may not outlive the iteration (Core s6); one used within
  # the iteration is fine.

  fun lastref[T](v: ?List[T]) -> ?T
    r = ?v[0]
    for x in v
      r = ?x
    r

  sub look[T](r: ?T)
    pass

  fun count[T](v: ?List[T]) -> Int
    n = 0
    for x in v
      r = ?x
      look(r)
      n += 1
    n

  v: List[String] = List()
  !v.push(String("a"))
  print(count(?v))

  # oracle: lastref reject C5
  # oracle: look accept
  # oracle: count accept
  # oracle: main accept

test "r3-or-generic-sound", "3 2 1"
  # A generic body is checked once, a type parameter owning and holding no
  # view (SPEC "Generic bodies"); a copy of a `T` is each instance's
  # question. A call of a generic function at plain data is checked by
  # its signature.
  #
  # oracle: first accept
  # oracle: Pair.left accept
  # oracle: Pair.put accept
  # oracle: take_both accept
  # oracle: main accept

  obj Pair[T]
    a: T
    b: T

    fun left(?@) -> T
      @a

    sub put(!@, x: T)
      @a = <x

  fun first[T](v: ?List[T]) -> T
    v[0]

  fun take_both[T](x: T, y: T) -> List[T]
    out: List[T] = List()
    !out.push(<x)
    !out.push(<y)
    out

  v: List[Int] = List()
  !v.push(3)
  p = Pair[Int](a: 1, b: 2)
  !p.put(first(?v))
  w = take_both(4, 5)
  print(p.left(), w.len, v.len)

fail "r3-or-generic-unsound", "cannot return a view of `w`, which this function was not lent"
  # The unsound neighbours of r3-or-generic-sound: a generic body's views
  # and moves follow the Core as any other body's do.
  #
  # oracle: local_view reject C5
  # oracle: used_after_move reject C1
  # oracle: grows_while_viewed reject C4

  fun local_view[T](x: T) -> ?T
    w: List[T] = List()
    !w.push(<x)
    ?w[0]

  fun used_after_move[T](x: T) -> List[T]
    out: List[T] = List()
    !out.push(<x)
    !out.push(<x)
    out

  fun look[T](r: ?T) -> Int
    1

  sub grows_while_viewed[T](v: !List[T], x: T)
    r = ?v[0]
    !v.push(<x)
    print(look(r))

  print(used_after_move(1).len)

test "r3-or-handle-sound", '''
  ada
  ada
  bob
  cy
  cy
  1 1
  2
  gone
  new
'''
  # Handles (Core s8, s9): `*<x` moves `x` into a counted box, `*S(...)`
  # boxes a new value, `+h` adds a count, `~h` holds the box weakly, and
  # `*h` is the way back. What a handle holds is read through it
  # while the handle lives, and every handle carries its contents' loans.
  #
  # oracle: boxes accept
  # oracle: view_of_contents accept
  # oracle: clone_outlives accept
  # oracle: carries_then_done accept
  # oracle: weak_after_drop accept
  # oracle: lends_the_handle accept

  obj User
    name: ?String

  obj Holder
    r: ?List[Int]

  sub show(u: ?User)
    print(u.name)

  sub reset(h: !*User)
    h = *User(name: "new")

  sub boxes()
    u = User(name: "ada")
    a = *<u
    b = +a
    show(?a)
    <a
    print(b.name)

  sub view_of_contents()
    a = *User(name: "bob")
    r = ?a.name
    b = +a
    <b
    print(r)

  sub clone_outlives()
    a = *User(name: "cy")
    b = +a
    w = ~a
    <a
    if *w as h
      print(h.name)
    print(b.name)

  sub carries_then_done()
    v: List[Int] = List()
    !v.push(1)
    h = *Holder(r: ?v)
    g = +h
    print(g.r.len, h.r.len)
    <h
    <g
    !v.push(2)
    print(v.len)

  sub weak_after_drop()
    a = *User(name: "dee")
    w = ~a
    <a
    if *w as h
      print("still", h.name)
    else
      print("gone")

  sub lends_the_handle()
    a = *User(name: "old")
    reset(!a)
    print(a.name)

  boxes()
  view_of_contents()
  clone_outlives()
  carries_then_done()
  weak_after_drop()
  lends_the_handle()

fail "r3-or-handle-unsound", "cannot drop `a` while it is lent"
  # The unsound neighbours of r3-or-handle-sound: a view of a box's
  # contents outliving the handle it was reached through, and a loan the
  # contents carry outliving a change to what they view, on a clone or a
  # weak handle (Core s8, s9).
  #
  # oracle: drop_while_viewed reject C4
  # oracle: lend_then_drop reject C4
  # oracle: clone_carries reject C4
  # oracle: weak_carries reject C4
  # oracle: moved_handle reject C1

  obj User
    name: String

  obj Holder
    r: ?List[Int]

  sub drop_while_viewed()
    a = *User(name: String("bob"))
    r = ?a.name
    <a
    print(r)

  sub lend_then_drop()
    a = *User(name: String("eve"))
    u = ?a
    <a
    print(u.name)

  sub clone_carries()
    v: List[Int] = List()
    !v.push(1)
    h = *Holder(r: ?v)
    g = +h
    <h
    !v.push(2)
    print(g.r.len)

  sub weak_carries()
    v: List[Int] = List()
    !v.push(1)
    h = *Holder(r: ?v)
    g = +h
    w = ~h
    <h
    !v.push(2)
    if *w as k
      print(k.r.len)

  sub moved_handle()
    a = *User(name: String("fay"))
    b = <a
    print(a.name, b.name)

  drop_while_viewed()

fail "r3-or-held-unsound", "a view of the temporary `mkh()` outlives its statement, which drops it; bind the value to a name first"
  # The unsound neighbours of r3-or-held-sound: a view of a held part's
  # payload kept past its arm, and a view of a held optional's value kept
  # past the `if`, whose held value it views.
  #
  # oracle: payload_kept reject C5
  # oracle: value_kept reject C5

  obj Res
    n: Int
    t: String

  enum E
    a(r: Res)
    b

  obj H
    e: E
    o: Res?

  fun mkh() -> H
    H(e: E.a(r: Res(n: 1, t: String("a"))), o: Res(n: 2, t: String("b")))

  sub payload_kept()
    keep = Res(n: 0, t: String("k"))
    saved = ?keep
    match mkh().e
      .a(r) => saved = ?r
      .b => pass
    print(saved.n)

  sub value_kept()
    keep = Res(n: 0, t: String("k"))
    saved = ?keep
    if mkh().o as r
      saved = ?r
    print(saved.n)

  payload_kept()

