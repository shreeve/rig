test "r3-or-planned-as sound", '''
  1
  drop 1
  true
  2
  2
  drop 2
  5
  3
  drop 3
  4 true
  drop 5
'''
  # Core s1: a bare owning place an `if … as` or `while … as` binds is
  # read where it stands, as `?p`, and the binding is a view: the place
  # may change once the view is done. A `match` on a place reads it in
  # place, and an optional of plain data copies.
  #
  # oracle: if_as accept
  # oracle: while_as accept
  # oracle: field_as accept
  # oracle: match_place accept
  # oracle: plain_copies accept

  obj N
    v: Int

    drop(!@)
      print("drop", @v)

  enum E
    one(b: ^N)
    nothing

  sub if_as()
    o: ^N? = ^N(v: 1)
    if o as x
      print(x.v)
    o = none
    print(o == none)

  sub while_as()
    o: ^N? = ^N(v: 2)
    k = 0
    while o as x
      print(x.v)
      k += 1
      break if k > 1

  sub field_as(h: ?Holder)
    if h.o as x
      print(x.v)

  obj Holder
    o: ^N?

  sub match_place()
    e = E.one(b: ^N(v: 3))
    match e
      .one(n) => print(n.v)
      .nothing => pass
    e = E.nothing

  sub plain_copies()
    n: Int? = 4
    if n as x
      n = none
      print(x, n == none)

  if_as()
  while_as()
  h = Holder(o: ^N(v: 5))
  field_as(?h)
  match_place()
  plain_copies()

test "r3-or-power-logger", '''
  app step 0
  app step 1
  app step 2
  3
'''
  # The store channel: a logger whose context holds a String field.
  # Today `m` stays lent because `log` is assumed to keep `msg` in `ctx`.
  # Fixed only by `into` (stores default to nothing) or inference.
  obj Ctx
    name: ?String
    count: Int

  sub log(ctx: !Ctx, msg: ?String)
    ctx.count += 1
    print(ctx.name, msg)

  ctx = Ctx(name: "app", count: 0)
  for i in 0..3
    m = String("step ", i)
    log(!ctx, ?m)
  print(ctx.count)

fail "r3-or-power-parser scratch", "cannot lend `p` to write while a read loan is live"
  # Parser that views a token slice and also owns a scratch List[Tok].
  # L0 alone keeps `p` lent after `next` (Parser can own a Tok itself,
  # in `scratch`); `from @toks` frees it. Rust: `-> &'a Tok` in
  # `impl<'a> Parser<'a>` accepts the twin.
  obj Tok
    kind: Int
    start: Int

  obj Parser
    toks: []Tok
    scratch: List[Tok]
    pos: Int

    fun next(!@) -> ?Tok
      t = ?@toks[@pos]
      @pos += 1
      t

  ts = [Tok(kind: 1, start: 0), Tok(kind: 2, start: 3)]
  p = Parser(toks: ?ts[..], scratch: List(), pos: 0)
  a = (!p).next()
  b = (!p).next()
  print(a.kind, b.kind)

fail "r3-or-power-table get free", "cannot lend `q` to write while a read loan is live"
  # Same as table_get, as a free function: isolates the read-receiver bug.
  obj Env
    keys: []?String
    vals: []?String

  fun get(e: ?Env, name: ?String) -> (?String)?
    for i in 0..e.keys.len
      if e.keys[i] == name
        return e.vals[i]
    none

  ks = ["HOME", "PATH"]
  vs = ["/h", "/bin"]
  env = Env(keys: ?ks[..], vals: ?vs[..])
  q = String("HO", "ME")
  v = get(?env, ?q) ?? "?"
  !q.add("X")
  print(v, q)

