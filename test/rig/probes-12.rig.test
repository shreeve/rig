'''
  obj Point
    x: Int
    y: Int

  sub bump(v: !List[Int])
    !v.push(1)

  sub twice(v: !List[Int])
    bump(!v)
    bump(!v)

  fun fx(p: !Point) -> !Int
    !p.x

  v: List[Int] = List()
  twice(!v)
  p = Point(x: 1, y: 2)
  r: !Int = fx(!p)
  r += 6
  print(r)
  print(v.len, p.x)

