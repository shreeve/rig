test "r3-s36-containers-b10 new shadow pattern", "1"
  x = 1
  new x = ?x
  print(x)

test "r3-s36-containers-b15 slice local repoint", "[9, 2] [8, 4]"
  a = [1, 2]
  b = [3, 4]
  s = !a
  s[0] = 9
  s = !b
  s[0] = 8
  print(a, b)

test "r3-s36-containers-b16 read slice repoint", '''
  [1, 2]
  [3, 4]
'''
  a = [1, 2]
  b = [3, 4]
  s: []Int = ?a
  print(s)
  s = ?b
  print(s)
