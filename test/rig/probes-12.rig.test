test "r3-or-repoint-sound", '''
  2
  7
  1 5
  2 2
'''
  # Assigning a new write view to a `!T` local re-points it: the local
  # then holds the new loan only, so the old place is free again (Core §6
  # "View places"). A bare write view on the right is read as its value.

  sub old_place_free()
    m = 1
    n = 2
    w = !m
    w += 1
    w = !n
    print(m)
    w = 7
    print(n)

  sub moved_in()
    m = 1
    n = 2
    w = !m
    w2 = !n
    w = <w2
    w = 5
    print(m, n)

  sub bare_value()
    m = 1
    n = 2
    w = !m
    w3 = !n
    w = w3
    print(m, n)

  old_place_free()
  moved_in()
  bare_value()


  # oracle: old_place_free accept
  # oracle: moved_in accept
  # oracle: bare_value accept

fail "r3-or-repoint-unsound", "use of `n` while a write loan is live"
  # Re-pointing a `!T` local hands it the new place's loan (Core §6), and
  # a view taken of it before keeps the old place's.

  sub new_place_held()
    m = 1
    n = 2
    w = !m
    w = !n
    print(n)
    w = 3

  sub old_view_kept()
    m = String("m")
    n = String("n")
    w = !m
    r = ?w
    w = !n
    !m.add("!")
    print(r)

  new_place_held()
  old_view_kept()

  # oracle: new_place_held reject C4
  # oracle: old_view_kept reject C4

