test "review-std-al", "true true"
  use std.random
  use dice

  sub main()
    r = random.Random.seeded(1)
    x = dice.roll(!r)
    dice.wait()
    f: random.Random = dice.fresh()
    s = random.Random.seeded(1)
    print(x >= 1 and x <= 6, (!f).next() == (!s).next())

  file "dice.rig"
    use std.random as rnd
    use std.time as t

    pub fun roll(r: !rnd.Random, n: Int = 6) -> Int
      (!r).int(1, n + 1)

    pub sub wait(ns: Int = t.MS)
      t.sleep(ns)

    pub fun fresh() -> rnd.Random
      rnd.Random.seeded(1)

