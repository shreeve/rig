fail "review-seam2-r2-z08 view local assign", "a view of the temporary `mkh()` outlives its statement, which drops it; bind the value to a name first"
  # Review probe r2/z08_view_local_assign.rig (seam 2 rounds 1 and 2): rejected, or runs sanitizer-clean.
  # oracle: S.drop accept
  # oracle: H.me accept
  # oracle: H.drop accept
  # oracle: mk accept
  # oracle: mkh accept
  # oracle: wrap accept
  # oracle: main reject C5
  obj S
    n: Int
    t: String

    drop(!self)
      print("dropS", self.n)

  obj H
    r: ?String
    rs: List[?String]

    fun me(!self) -> !H
      self

    drop(!self)
      print("dropH sees", self.r, self.rs)

  fun mk(n: Int) -> S
    S(n: n, t: String("hello world, long enough to be on the heap ", n))

  fun mkh() -> H
    H(r: "init", rs: List())

  fun wrap(h: !H) -> !H
    h

  w = wrap(!mkh())
  print(w.r)

