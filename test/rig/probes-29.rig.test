  obj S
    n: Int
    t: String

    drop(!self)
      print("dropS", self.n)

  obj H
    r: ?String
    rs: List[?String]

    fun me(!self) -> !H
      self

    drop(!self)
      print("dropH sees", self.r, self.rs)

  fun mk(n: Int) -> S
    S(n: n, t: String("hello world, long enough to be on the heap ", n))

