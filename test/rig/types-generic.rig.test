fail "generic payload copy any subject", "`place[String]` cannot use `T = String`: the generic body copies a `T`", "`lend[String]` cannot use `T = String`: the generic body copies a `T`", "`call[String]` cannot use `T = String`: the generic body copies a `T`", "`lend_call[String]` cannot use `T = String`: the generic body copies a `T`", "`branch[String]` cannot use `T = String`: the generic body copies a `T`", "`branch_call[String]` cannot use `T = String`: the generic body copies a `T`", "`field[String]` cannot use `T = String`: the generic body copies a `T`", "`field_of_call[String]` cannot use `T = String`: the generic body copies a `T`", "`field_of_branch[String]` cannot use `T = String`: the generic body copies a `T`", "`elem[String]` cannot use `T = String`: the generic body copies a `T`", "`elem_of_call[String]` cannot use `T = String`: the generic body copies a `T`", "`guarded[String]` cannot use `T = String`: the generic body copies a `T`", "`branch_value[String]` cannot use `T = String`: the generic body copies a `T`", "`holder[String]` cannot use `T = String`: the generic body copies a `T`", "`nested[String]` cannot use `T = String`: the generic body copies a `T`", "`catch_all[String]` cannot use `T = String`: the generic body copies a `T`", "`as_field_of_call[String]` cannot use `T = String`: the generic body copies a `T`", "`while_field_of_branch[String]` cannot use `T = String`: the generic body copies a `T`", "`for_call[String]` cannot use `T = String`: the generic body copies a `T`", errors: 19
  # A generic body that copies a `T` out of what a `match`, an `if … as`,
  # or a `for` reads, and gives the copy away, needs every instance's `T`
  # to own nothing, whatever the subject: a place, a lend, a view a call
  # returns, a branching value, a field or element of any of these, and a
  # guarded match. Each instance below would free its Text twice.

  enum Opt[T]
    some(v: T)
    nothing

  obj P[T]
    x: T

  enum E[T]
    has(p: P[T])
    empty

  obj W[T]
    o: Opt[T]
    p: T?

  fun get[T](o: ?Opt[T]) -> ?Opt[T] from o
    o

  fun getw[T](w: ?W[T]) -> ?W[T] from w
    w

  fun geta[T](a: ?List[Opt[T]]) -> ?List[Opt[T]] from a
    a

  fun gete[T](e: ?E[T]) -> ?E[T] from e
    e

  fun getxs[T](xs: ?List[T]) -> ?List[T] from xs
    xs

  fun place[T](o: ?Opt[T], d: T) -> T
    match o
      .some(v) => v
      .nothing => <d

  fun lend[T](o: ?Opt[T], d: T) -> T
    match ?o
      .some(v) => v
      .nothing => <d

  fun call[T](o: ?Opt[T], d: T) -> T
    match get(o)
      .some(v) => v
      .nothing => <d

  fun lend_call[T](o: ?Opt[T], d: T) -> T
    match ?get(o)
      .some(v) => v
      .nothing => <d

  fun branch[T](o: ?Opt[T], o2: ?Opt[T], c: Bool, d: T) -> T
    match (o if c else o2)
      .some(v) => v
      .nothing => <d

  fun branch_call[T](o: ?Opt[T], o2: ?Opt[T], c: Bool, d: T) -> T
    match (get(o) if c else get(o2))
      .some(v) => v
      .nothing => <d

  fun field[T](w: ?W[T], d: T) -> T
    match w.o
      .some(v) => v
      .nothing => <d

  fun field_of_call[T](w: ?W[T], d: T) -> T
    match getw(w).o
      .some(v) => v
      .nothing => <d

  fun field_of_branch[T](w: ?W[T], w2: ?W[T], c: Bool, d: T) -> T
    match (w if c else w2).o
      .some(v) => v
      .nothing => <d

  fun elem[T](a: ?List[Opt[T]], d: T) -> T
    match a[0]
      .some(v) => v
      .nothing => <d

  fun elem_of_call[T](a: ?List[Opt[T]], d: T) -> T
    match geta(a)[0]
      .some(v) => v
      .nothing => <d

  fun guarded[T](o: ?Opt[T], c: Bool, d: T) -> T
    match get(o)
      .some(v) if c => v
      _ => <d

  fun branch_value[T](o: ?Opt[T], c: Bool, d: T) -> T
    match get(o)
      .some(v) => v if c else <d
      .nothing => <d

  fun holder[T](e: ?E[T], d: T) -> P[T]
    match gete(e)
      .has(p) => p
      _ => P(x: <d)

  fun nested[T](o: ?Opt[Opt[T]], d: T) -> T
    match get(o)
      .some(inner)
        match inner
          .some(v) => v
          .nothing => <d
      .nothing => <d

  fun catch_all[T](w: ?W[T]) -> Opt[T]
    match getw(w).o
      x => x

  fun as_field_of_call[T](w: ?W[T], d: T) -> T
    if getw(w).p as v
      return v
    <d

  fun while_field_of_branch[T](w: ?W[T], w2: ?W[T], c: Bool, d: T) -> T
    while (w if c else w2).p as v
      return v
    <d

  fun for_call[T](xs: ?List[T], d: T) -> T
    for x in getxs(xs)
      return x
    <d

  o: Opt[String] = .some(v: String("o"))
  w: W[String] = W(o: .some(v: String("w")), p: String("p"))
  a: List[Opt[String]] = List()
  !a.push(.some(v: String("a")))
  e2: E[String] = .has(p: P(x: String("p")))
  xs: List[String] = List()
  !xs.push(String("x"))
  print(place(?o, String("d")))
  print(lend(?o, String("d")))
  print(call(?o, String("d")))
  print(lend_call(?o, String("d")))
  print(branch(?o, ?o, true, String("d")))
  print(branch_call(?o, ?o, true, String("d")))
  print(field(?w, String("d")))
  print(field_of_call(?w, String("d")))
  print(field_of_branch(?w, ?w, true, String("d")))
  print(elem(?a, String("d")))
  print(elem_of_call(?a, String("d")))
  print(guarded(?o, true, String("d")))
  print(branch_value(?o, true, String("d")))
  print(holder(?e2, String("d")).x)
  n: Opt[Opt[String]] = .some(v: .some(v: String("n")))
  print(nested(?n, String("d")))
  match catch_all(?w)
    .some(v) => print(v)
    .nothing => pass
  print(as_field_of_call(?w, String("d")))
  print(while_field_of_branch(?w, ?w, true, String("d")))
  print(for_call(?xs, String("d")))

test "generic payload copy plain", '''
  1
  1
  1
  1
  1
  1
  2
  2
  2
  4
  4
  1
  0
  0
  6
  5
  2
  3
  3
  7
'''
  # The generic bodies of reject/types/generic_payload_copy_any_subject.rig
  # copy a `T` out of what a `match`, an `if … as`, or a `for` reads,
  # whatever the subject. An instance of plain data copies it, and runs.

  enum Opt[T]
    some(v: T)
    nothing

  obj P[T]
    x: T

  enum E[T]
    has(p: P[T])
    empty

  obj W[T]
    o: Opt[T]
    p: T?

  fun get[T](o: ?Opt[T]) -> ?Opt[T] from o
    o

  fun getw[T](w: ?W[T]) -> ?W[T] from w
    w

  fun geta[T](a: ?List[Opt[T]]) -> ?List[Opt[T]] from a
    a

  fun gete[T](e: ?E[T]) -> ?E[T] from e
    e

  fun getxs[T](xs: ?List[T]) -> ?List[T] from xs
    xs

  fun place[T](o: ?Opt[T], d: T) -> T
    match o
      .some(v) => v
      .nothing => <d

  fun lend[T](o: ?Opt[T], d: T) -> T
    match ?o
      .some(v) => v
      .nothing => <d

  fun call[T](o: ?Opt[T], d: T) -> T
    match get(o)
      .some(v) => v
      .nothing => <d

  fun lend_call[T](o: ?Opt[T], d: T) -> T
    match ?get(o)
      .some(v) => v
      .nothing => <d

  fun branch[T](o: ?Opt[T], o2: ?Opt[T], c: Bool, d: T) -> T
    match (o if c else o2)
      .some(v) => v
      .nothing => <d

  fun branch_call[T](o: ?Opt[T], o2: ?Opt[T], c: Bool, d: T) -> T
    match (get(o) if c else get(o2))
      .some(v) => v
      .nothing => <d

  fun field[T](w: ?W[T], d: T) -> T
    match w.o
      .some(v) => v
      .nothing => <d

  fun field_of_call[T](w: ?W[T], d: T) -> T
    match getw(w).o
      .some(v) => v
      .nothing => <d

  fun field_of_branch[T](w: ?W[T], w2: ?W[T], c: Bool, d: T) -> T
    match (w if c else w2).o
      .some(v) => v
      .nothing => <d

  fun elem[T](a: ?List[Opt[T]], d: T) -> T
    match a[0]
      .some(v) => v
      .nothing => <d

  fun elem_of_call[T](a: ?List[Opt[T]], d: T) -> T
    match geta(a)[0]
      .some(v) => v
      .nothing => <d

  fun guarded[T](o: ?Opt[T], c: Bool, d: T) -> T
    match get(o)
      .some(v) if c => v
      _ => <d

  fun branch_value[T](o: ?Opt[T], c: Bool, d: T) -> T
    match get(o)
      .some(v) => v if c else <d
      .nothing => <d

  fun holder[T](e: ?E[T], d: T) -> P[T]
    match gete(e)
      .has(p) => p
      _ => P(x: <d)

  fun nested[T](o: ?Opt[Opt[T]], d: T) -> T
    match get(o)
      .some(inner)
        match inner
          .some(v) => v
          .nothing => <d
      .nothing => <d

  fun catch_all[T](w: ?W[T]) -> Opt[T]
    match getw(w).o
      x => x

  fun as_field_of_call[T](w: ?W[T], d: T) -> T
    if getw(w).p as v
      return v
    <d

  fun while_field_of_branch[T](w: ?W[T], w2: ?W[T], c: Bool, d: T) -> T
    while (w if c else w2).p as v
      return v
    <d

  fun for_call[T](xs: ?List[T], d: T) -> T
    for x in getxs(xs)
      return x
    <d

  o: Opt[Int] = .some(v: 1)
  w: W[Int] = W(o: .some(v: 2), p: 3)
  a: List[Opt[Int]] = List()
  !a.push(.some(v: 4))
  e2: E[Int] = .has(p: P(x: 6))
  xs: List[Int] = List()
  !xs.push(7)
  print(place(?o, 0))
  print(lend(?o, 0))
  print(call(?o, 0))
  print(lend_call(?o, 0))
  print(branch(?o, ?o, false, 0))
  print(branch_call(?o, ?o, true, 0))
  print(field(?w, 0))
  print(field_of_call(?w, 0))
  print(field_of_branch(?w, ?w, false, 0))
  print(elem(?a, 0))
  print(elem_of_call(?a, 0))
  print(guarded(?o, true, 0))
  print(guarded(?o, false, 0))
  print(branch_value(?o, false, 0))
  print(holder(?e2, 0).x)
  n: Opt[Opt[Int]] = .some(v: .some(v: 5))
  print(nested(?n, 0))
  match catch_all(?w)
    .some(v) => print(v)
    .nothing => pass
  print(as_field_of_call(?w, 0))
  print(while_field_of_branch(?w, ?w, true, 0))
  print(for_call(?xs, 0))

fail "generic polymorphic recursion", "`Wrap[*B]` leads to ever deeper instances of generic types (through `Wrap[Wrap[T]]`)"
  # A generic body that uses a deeper instance of its own type (`Wrap[T]`
  # using `Wrap[Wrap[T]]`) would need ever deeper instances; it is rejected
  # rather than expanded forever.

  obj B
    n: Int

  obj Wrap[T]
    v: T

    fun wrap(<@) -> Wrap[Wrap[T]]
      Wrap(v: <@)

  b: Wrap[*B] = Wrap(v: *B(n: 1))

fail "generic share of weak", "15:5: `share[~Node]` cannot use `T = ~Node`: the generic body copies a `T`, which would duplicate the resource `~Node` owns", errors: 1
  # The meaning of `*x` is decided once, by the type the body sees: on a
  # type parameter `T` it copies `x` into a new counted handle, which needs
  # a `T` that copies, in every instance. An instance with `T = ~U` is
  # rejected; `*x` never upgrades there, though `*` of a `~U` outside a
  # generic body would.

  obj Node
    id: Int

  fun share[T](x: T) -> T
    h = *x
    x

  rc = *Node(id: 1)
  w = share(~rc)
  <w

test "generic struct field", "6"
  # A generic struct instantiated as `Wrap[Int]`; the constructor's field is
  # checked against the substituted type and `b.value` types as Int.

  obj Wrap[T]
    value: T

  b: Wrap[Int] = Wrap(value: 5)
  print(b.value + 1)

test "generic struct holds read view", '''
  2 2
  2 hey
  hey
'''
  # A generic struct, with methods, holds a read view of an owner: the
  # value built from it keeps the owner lent while it, or a view it gave
  # out, is used.

  obj Hold[T]
    v: T

    fun get(?@) -> T
      @v

  obj Pair[A, B]
    a: A
    b: B

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  t = String("hey")
  h = Hold(v: ?v)
  r = ?h.get()
  print(r.len, h.v.len)
  p = Pair(a: ?v, b: ?t)
  print(p.a.len, p.b)
  nested = Hold(v: Hold(v: ?t))
  print(nested.v.v)

test "generic struct method", "42"
  # A method on a generic struct: `get` returns `T`, which is Int for a
  # `Wrap[Int]` receiver.

  obj Wrap[T]
    value: T

    fun get(?@) -> T
      @value

  b: Wrap[Int] = Wrap(value: 42)
  print(b.get())

test "generic struct string field", "hi"
  # A `Wrap[?String]` field types as String, so print formats it as text.

  obj Wrap[T]
    value: T

  b: Wrap[?String] = Wrap(value: "hi")
  print(b.value)

test "generic struct two params", '''
  42
  answer
'''
  # A generic struct with two type parameters; each field gets its own
  # substituted type.

  obj Pair[T, U]
    first: T
    second: U

  p: Pair[Int, ?String] = Pair(first: 42, second: "answer")
  print(p.first)
  print(p.second)

fail "generic symbolic body type", "type mismatch: expected `T`, got `Static`"
  # Inside a generic body, constructor fields are checked symbolically:
  # a String is not a `T`.

  obj Wrap[T]
    value: T

    fun bad(?@) -> Self
      b: Self = Wrap(value: "hello")
      b

  b: Wrap[Int] = Wrap(value: 5)
  print(b.value)

fail "generic type method polymorphic recursion", "13:6: `Wrap[Int]` leads to ever deeper instances of generic functions (through `keep[Wrap[Wrap[T]]]`); a generic type's body cannot nest itself in its own type arguments"
  # A generic type whose method uses its own instance nested deeper, here
  # through a generic function, would need ever deeper instances.

  fun keep[T](x: T) -> T
    x

  obj Wrap[T]
    v: T

    fun rewrap(<@) -> Wrap[Wrap[T]]
      keep(Wrap(v: <@))

  d = <Wrap(v: 1).rewrap()
  print(d.v.v)

fail "generic type param called", "5:3: `T` is a type parameter; it cannot be called or constructed", "8:7: `T` is a type parameter; it cannot be called or constructed", "12:3: `print` is a type parameter; it cannot be called or constructed", "19:9: `T` is a type, not a value"
  # A type parameter names a type, not a function: it cannot be called or
  # constructed, in a generic function or in a generic type's method.

  fun f[T](x: T) -> T
    T(x)

  fun g[T](x: Int) -> Int
    y = T(n: x)
    2

  fun h[print](x: print) -> Int
    print(1)
    2

  obj Wrap[T]
    v: T

    fun make(?@, x: Int) -> Int
      y = T(x)
      2

  print(f(3), g[Int](1), h(3), Wrap(v: 1).make(3))

fail "generic type value param", "7:14: a compile-time value parameter of a type is an integer; `m` has the type `Mode`"
  # A generic type's compile-time value parameter is an integer.

  enum Mode
    fast
    slow

  obj Tuned[m: Mode]
    first: Int

  print(1)

test "generic unused type param", '''
  1
  .two
'''
  # A type parameter the body never uses is still a valid parameter.

  obj Tag[T]
    n: Int

  enum Marker[T]
    one
    two

  t: Tag[?String] = Tag(n: 1)
  print(t.n)
  m: Marker[Int] = .two
  print(m)

test "generic value param", '''
  [5, 6, 0, 0] 4 2 40
  [1, 1, 1, 1] 4
  3 [true, false, true]
  [1, 1, 1] [2, 2, 2]
  Pair(items: [1, 2]) .full(items: [3, 4]) .empty
'''
  # A generic type takes compile-time integer parameters beside its type
  # parameters. Its fields and methods use them; its instances are named
  # (`Ring[Int, 4]`), or inferred from the fields. The same value, however
  # it is written, names the same type.

  LIMIT = 2

  obj Ring[T, n: Int]
    items: [n]T
    head: Int = 0
    log: List[Int]

    fun new(x: T) -> Ring[T, n]
      Ring[T, n](items: [n of x], log: List[Int]())

    sub put(!@, x: T)
      @items[@head % n] = x
      @head += 1
      !@log.push(@head)

    fun cap(?@) -> Int
      n

  obj Pool[T, m: Int]
    ring: Ring[T, m]
    spare: [m]T

  obj Pair[n: Int]
    items: [n]Int

  enum Slot[n: Int]
    full(items: [n]Int)
    empty

  fun capacity[T, n: Int](r: ?Ring[T, n]) -> Int
    n * 10

  sub main()
    r = Ring[Int, 2 + 2].new(0)
    s: Ring[Int, 4] = <r
    !s.put(5)
    !s.put(6)
    print(s.items, s.cap(), s.log.len, capacity(?s))
    q = Ring[Int, LIMIT * 2](items: [4 of 1], log: List[Int]())
    print(q.items, q.cap())
    u = Ring(items: [true, false, true], log: List[Int]())
    print(u.cap(), u.items)
    p = Pool[Int, 3](ring: Ring[Int, 3].new(1), spare: [3 of 2])
    print(p.ring.items, p.spare)
    pr = Pair(items: [1, 2])
    x: Slot[2] = .full(items: [3, 4])
    print(pr, x, Slot[2].empty)

fail "generic value param args", "13:6: `n` is a compile-time value, not a type", "15:5: `Ring[Int, -4]` cannot use `n = -4`: the generic body uses `n` as an array length", "16:14: compile-time argument 2 of `Ring` is a value of type `Int`, not a type", "17:9: `4` is a value; `T` takes a type", "18:4: generic type `Ring` expects 2 compile-time arguments, got 1", "19:10: compile-time argument 1 of `Small` is `256`, which `n`, a `U8`, cannot hold", "20:23: `[n of x]` copies its element into every slot, and a `List[Int]` owns a resource"
  # A generic type's compile-time arguments fill its parameters in order:
  # a type where it takes a type, and an integer where it takes a value,
  # which its parameter's type holds and, used as an array length, is in
  # range. Its value parameters are values, not types.

  obj Ring[T, n: Int]
    items: [n]T

  obj Small[n: U8]
    items: [n]Int

  obj Bad[n: Int]
    x: n

  a = Ring[Int, -4](items: [0 of 0])
  b: Ring[Int, Int] = Ring(items: [1])
  c: Ring[4, Int] = Ring(items: [1])
  d: Ring[Int] = Ring(items: [1])
  e: Small[256] = Small(items: [1])
  f = Ring(items: [2 of List[Int]()])
  print(a, b, c, d, e, f)

fail "generic value param names", "8:10: generic parameter `Int` has the name of a built-in type", "11:10: generic parameter `LIMIT` has the same name as the module-level declaration `LIMIT`", "14:18: duplicate generic parameter `n` on `C`", "17:10: generic parameter `n` has the same name as a method of the type", "26:11: parameter `n` has the name of the generic parameter `n`", "30:5: local `n` has the name of the generic parameter `n`"
  # A generic type's value parameter needs a name of its own, as a type
  # parameter does: not a built-in type, a module-level declaration,
  # another parameter, or a method of the type, and no local or parameter
  # inside the type may reuse it.

  LIMIT = 4

  obj A[T, Int: Int]
    items: [2]T

  obj B[T, LIMIT: Int]
    items: [2]T

  obj C[T, n: Int, n: Int]
    items: [n]T

  obj D[T, n: Int]
    items: [n]T

    fun n() -> Int
      1

  obj E[T, n: Int]
    items: [n]T

    fun get(n: Int) -> Int
      n

    fun twice() -> Int
      n = 2
      n

  sub main()
    print(LIMIT)

fail "generic variant arity", "11:9: variant `some` has one field: write `.some(value)` or `.some(v: value)`", "12:9: variant `some` is missing field `v`", "13:9: a variant with more than one field sets them by name: `.pair(a: ...)`"
  # A generic variant given arguments that fill no field reports what the
  # variant takes, not a failure to infer its type.

  enum Opt[T]
    some(v: T)
    no

  enum Two[T]
    pair(a: T, b: T)

  x = Opt.some(1, 2)
  y = Opt.some()
  z = Two.pair(1, 2)
  print(x, y, z)

fail "generic variant payload literal", "15:7: `holds[fun(Int) -> Int]` cannot use `T = fun(Int) -> Int`: the generic body applies `==` to `T`, which `fun(Int) -> Int` does not support: `fun(Int) -> Int` is a function value", "9:3: `==` used on `T` here"
  # A payload variant literal in a generic body compares a `T`, so each
  # instance needs `==` on its `T`.

  enum Opt[T]
    some(value: T)
    nothing

  fun holds[T](o: ?Opt[T], x: T) -> Bool
    o == .some(value: x)

  fun inc(x: Int) -> Int
    x + 1

  o: Opt[fun(Int) -> Int] = .nothing
  print(holds(?o, inc))

test "generic vec field", "2 1"
  # A generic type can hold a `List[T]`: the element rules are checked for
  # each instance, here `Int` and the shared handle `*Int`.

  obj Stack[T]
    items: List[T]

    sub push(!@, x: T)
      !@items.push(<x)

    fun size(?@) -> Int
      @items.len

  s: Stack[Int] = Stack(items: List())
  !s.push(3)
  !s.push(4)
  t: Stack[*Int] = Stack(items: List())
  !t.push(*9)
  print(s.size(), t.size())

fail "generic vec loop copies per instance", "8:5: a value of `C` holds a Cell, so it lives only behind a shared handle: write `*C`", errors: 1
  # A generic loop over a `?List[T]` binds a copy of each element, which
  # never holds a Cell: a value that holds one is never a type argument
  # (`List[C]`), since it lives only behind a shared handle.

  obj C
    c: Cell[Int]

  v: *List[C] = *List[C]()
  print(v.len)

test "generic vec owning instances", "0 1"
  # `List[T]` in a generic type holds whatever each instance gives it.

  obj Stack[T]
    items: List[T]

  obj Owner
    h: *Int

  s: Stack[List[Int]] = Stack(items: List())
  o: Stack[Owner] = Stack(items: List())
  !o.items.push(Owner(h: *3))
  print(s.items.len, o.items.len)

fail "generic whole division", "11:7: `Wrap[Float]` cannot use `T = Float`: the generic body gives a `T` the division of whole numbers `1 / 2`, which divides integers, not a `Float`"
  # A division of whole-number literals divides integers, so an instance
  # whose type parameter is a float is rejected where the body gives a `T`
  # one.

  obj Wrap[T]
    v: T

    fun half(?@) -> T
      @v + 1 / 2

  print(Wrap(v: 3.0).half(), Wrap(v: 3).half())
