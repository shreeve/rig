test "generic literal division", '''
  3 7 -1
  4.5 4
'''
  # Integer literals in arithmetic over a type parameter take its type in
  # each instance; a division of whole-number literals divides integers,
  # so `1 / 2` is `0` (see reject/types/generic_whole_division for a
  # float instance).

  obj Wrap[T]
    v: T

    fun half(?@) -> T
      @v + 1 / 2

    fun mix(?@) -> T
      @v + 7 % 4 * 3 / 2

    fun more(?@) -> T
      y = @v - 7 / 2
      y * (1 + 1) / 4 + -(3 / 2) % 2

  obj Scale[T]
    v: T

    fun scale(?@) -> T
      @v * 3 / 2

  print(Wrap(v: 3).half(), Wrap(v: 3).mix(), Wrap(v: 3).more())
  print(Scale(v: 3.0).scale(), Scale(v: U8(3)).scale())

fail "generic literal must fit", "`Half[Int]` cannot use `T = Int`: the generic body applies `*` to a `T` and a float literal, which `Int` cannot hold", "the generic body applies `+` to a `T` and the literal `300`, which `U8` cannot hold", "`Neg[U8]` cannot use `T = U8`: the generic body applies `-` to `T`", "`Wide[U8]` cannot use `T = U8`: the generic body shifts a `T` by 9 bits, which `U8` is too narrow for"
  # A literal in a generic body becomes a `T`, so every instance must hold
  # it; negation needs a signed `T`, and a constant shift a wide enough one.

  obj Half[T]
    v: T
    fun get(?@) -> T
      @v * 1.5

  obj Big[T]
    v: T
    fun get(?@) -> T
      @v + 300

  obj Neg[T]
    v: T
    fun get(?@) -> T
      -@v

  obj Wide[T]
    v: T
    fun get(?@) -> T
      @v << 9

  a: Half[Int] = Half(v: 1)
  b: Big[U8] = Big(v: 1)
  c: Neg[U8] = Neg(v: 1)
  d: Wide[U8] = Wide(v: 1)
  print(a.get(), b.get(), c.get(), d.get())

test "generic literal operands", '''
  8 -7 7
  3.5 -2.5
  14
'''
  # Literals combined with a generic `T` take the instance's type: the
  # instances here hold every literal the body uses.

  obj Acc[T]
    total: T

    fun bumped(?@) -> T
      @total + 1

    fun negated(?@) -> T
      -@total

    sub add(!@, x: T)
      @total += x
      @total -= 1

  obj Bits[T]
    v: T

    fun doubled(?@) -> T
      @v << 1

  a: Acc[Int] = Acc(total: 5)
  f: Acc[Float] = Acc(total: 2.5)
  u: Bits[U8] = Bits(v: 7)
  !a.add(3)
  print(a.bumped(), a.negated(), a.total)
  print(f.bumped(), f.negated())
  print(u.doubled())

test "generic literal order", '''
  3.0 3.0 2
  3.0 2.5 2.5 3.0
'''
  # When only literals give a type parameter its type, a float literal
  # makes it `Float`, in any argument order, for generic functions and
  # generic types alike.

  fun max[T](a: T, b: T) -> T
    a if a > b else b

  obj P[T]
    a: T
    b: T

  print(max(3, 2.5), max(2.5, 3), max(1, 2))
  p = P(a: 3, b: 2.5)
  q = P(a: 2.5, b: 3)
  print(p.a, p.b, q.a, q.b)

test "generic methods over resources", '''
  drop 1
  put
  ignored
  drop 3
  drop 2
  drop 4
  kept 5
  drop 7
  replaced
  drop 8
  dropped
  drop 6
  drop 10
  got 9
  8
  drop 9
  drop 5
'''
  # A generic type's methods work for an argument that owns a resource as
  # long as they move `T` values (`<x`) rather than copy them: values of
  # `T` are dropped when they go out of scope, a replaced field drops its
  # old value, and a consumed enum yields its payload.

  obj B
    n: Int

    drop(!@)
      print("drop", @n)

  obj Wrap[T]
    v: T

    sub put(!@, x: T)
      @v = <x

    sub ignore(<@, extra: T)
      print("ignored")

    fun keep(<@, x: T) -> T
      y = <x
      if true
        z = <y
        return <z
      <y

    sub juggle(<@, x: T, y: T)
      a = <x
      a = <y
      print("replaced")
      <a
      print("dropped")

  enum Opt[T]
    some(v: T)
    nothing

    fun or_else(<@, d: T) -> T
      match <@
        .some(v) => v
        .nothing => <d

  b: Wrap[*B] = Wrap(v: *B(n: 1))
  !b.put(*B(n: 2))
  print("put")
  <b.ignore(*B(n: 3))
  c: Wrap[*B] = Wrap(v: *B(n: 4))
  k = <c.keep(*B(n: 5))
  print("kept", k.n)
  d: Wrap[*B] = Wrap(v: *B(n: 6))
  <d.juggle(*B(n: 7), *B(n: 8))
  o: Opt[*B] = .some(v: *B(n: 9))
  x = <o.or_else(*B(n: 10))
  print("got", x.n)
  i: Wrap[Int] = Wrap(v: 7)
  !i.put(8)
  print(i.v)

