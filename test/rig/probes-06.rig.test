test "audit-ownership-v04 wb view store ok", '''
  2
  drop 2
  drop 1
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  obj View
    b: ?Tok

  x = Tok(n: 1)
  y = Tok(n: 2)
  vw = View(b: ?x)
  w = !vw
  w = View(b: ?y)
  print(vw.b.n)

fail "audit-ownership-v05 wb to param store", "cannot store a view of `y` through `w`: `vw` outlives it"
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  obj View
    b: ?Tok

  sub f(vw: !View)
    y = Tok(n: 2)
    w = !vw
    w = View(b: ?y)

  x = Tok(n: 1)
  vw = View(b: ?x)
  f(!vw)
  print(vw.b.n)

