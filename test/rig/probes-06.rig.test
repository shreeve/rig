# Probes from past reviews and audits, 6 of 41: audit-ownership-j06_generic_swap to audit-sema-up1.

test "audit-ownership-j06 generic swap", '''
  2 1
  drop 1
  drop 2
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  sub sw[T](a: !T, b: !T) keeps a, b
    swap(!a, !b)

  a = *Tok(n: 1)
  b = *Tok(n: 2)
  sw(!a, !b)
  print(a.n, b.n)

test "audit-ownership-j07 generic replace", '''
  1 2
  drop 1
  drop 2
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  fun put[T](a: !T, x: T) -> T
    replace(!a, <x)

  a = *Tok(n: 1)
  old = put(!a, *Tok(n: 2))
  print(old.n, a.n)

test "audit-ownership-j08 generic struct owning", '''
  pop 2
  drop 2
  end
  drop 1
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  obj Stack[T]
    items: List[T]

    sub push(!self, x: T)
      !self.items.push(<x)

    fun pop(!self) -> T?
      (!self.items).pop()

  s = Stack[*Tok](items: List())
  !s.push(*Tok(n: 1))
  !s.push(*Tok(n: 2))
  if (!s).pop() as t
    print("pop", t.n)
  print("end")

fail "audit-ownership-j10 generic box list", "cannot move out of `n.v`: `n` would still drop it (partial moves are not supported); move `n` whole, or exchange the field: `replace(!n.v, v)`"
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  obj Node[T]
    v: T
    next: ^Node[T]?

  obj Chain[T]
    head: ^Node[T]?

    sub push(!self, v: T)
      self.head = ^Node[T](v: <v, next: <self.head)

    fun pop(!self) -> T?
      if <self.head as n
        self.head = <n.next
        return <n.v
      none

  l = Chain[*Tok](head: none)
  !l.push(*Tok(n: 1))
  !l.push(*Tok(n: 2))
  if (!l).pop() as t
    print("pop", t.n)
  print("end")

test "audit-ownership-j11 generic for move", '''
  drop 1
  drop 2
  3
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  fun total[T](v: List[T], f: ?fun(?T) -> Int) -> Int
    s = 0
    for x in <v
      s += f(?x)
    s

  fun score(t: ?*Tok) -> Int
    t.n

  v: List[*Tok] = List()
  !v.push(*Tok(n: 1))
  !v.push(*Tok(n: 2))
  print(total(<v, score))

