fail "audit-ownership-q02", "`lib.Holder[*Tok]` cannot use `T = *Tok`: the generic body copies a `T`, which would duplicate the resource `*Tok` owns"
  use lib

  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  sub main()
    h = lib.Holder[*Tok](x: *Tok(n: 1))
    t = h.peek()
    print(t.n)

  file "lib.rig"
    pub fun get[T](v: ?List[T], i: Int) -> T
      v[i]

    pub obj Holder[T]
      pub x: T

      pub fun peek(?self) -> T
        self.x

    pub fun pick[T](a: ?T, b: ?T) -> ?T
      a

    pub fun each_first[T](v: ?List[T]) -> T?
      for x in v
        return x
      none

test "audit-ownership-s02 opt propagate after move", '''
  drop 1
  none
  two 1 1
  drop 1
  0
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun get(k: Int) -> Int?
    k if k > 0 else none

  sub two(t: *Tok, n: Int)
    print("two", t.n, n)

  fun run(k: Int) -> Int?
    a = *Tok(n: 1)
    two(<a, get(k)?)
    0

  print(run(0))
  print(run(1))

test "audit-ownership-s03 ctor propagate", '''
  drop 1
  none
  drop 1
  2
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  obj P
    a: *Tok
    n: Int

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun run(k: Int) -> Int?
    p = P(a: *Tok(n: 1), n: get(k)?)
    p.n

  print(run(0))
  print(run(2))

test "audit-ownership-s05 push fallible arg", '''
  -1
  drop 0
  1
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun run(k: Int) -> Int!
    v: List[*Tok] = List()
    !v.push(*Tok(n: fail(k)!))
    v.len

  print(run(1) catch -1)
  print(run(0) catch -1)

test "audit-ownership-s06 consume recv fallible arg", '''
  drop 1
  -1
  done 1 0
  drop 1
  0
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  obj R
    t: *Tok

    sub done(<self, n: Int)
      print("done", self.t.n, n)

  fun run(k: Int) -> Int!
    r = R(t: *Tok(n: 1))
    <r.done(fail(k)!)
    0

  print(run(1) catch -1)
  print(run(0) catch -1)

test "audit-ownership-s07 box ctor propagate", '''
  drop 5
  none
  drop 5
  drop 3
  3
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  obj Node
    a: *Tok
    next: ^Node?

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun run(k: Int) -> Int?
    x: ^Node? = ^Node(a: *Tok(n: 5), next: none)
    b = ^Node(a: *Tok(n: get(k)?), next: <x)
    b.a.n

  print(run(0))
  print(run(3))

test "audit-ownership-s08 take coalesce loop", '''
  eat 1
  drop 1
  eat 3
  drop 3
  end
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  obj H
    o: *Tok?

  hs: List[^H] = List()
  !hs.push(^H(o: *Tok(n: 1)))
  !hs.push(^H(o: none))
  !hs.push(^H(o: *Tok(n: 3)))
  for h in !hs
    t = <h.o ?? continue
    eat(<t)
  print("end")

