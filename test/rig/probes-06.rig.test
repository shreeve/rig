test "audit-sema-eq2", "true"
  fun f[T](a: T, p: ?lib.P, q: ?lib.P) -> Bool
    p == q

  use lib

  sub main()
    x = lib.P.make()
    y = lib.P.make()
    print(f(*1, ?x, ?y))

  file "lib.rig"
    obj Wrap[T]
      v: T

    pub obj P
      w: Wrap[Int]

      pub fun make() -> P
        P(w: Wrap[Int](v: 1))

test "audit-sema-ff1", '''
  6
  8 10
'''
  use lib

  obj Q
    f: fun(?Int) -> Int

  fun twice(n: ?Int) -> Int
    n * 2

  sub main()
    q = Q(f: twice)
    n = 3
    print(q.f(?n))
    p = lib.P.make()
    m = 4
    r = p.f(?m)
    m = 5
    print(r, p.f(?m))

  file "lib.rig"
    fun twice(n: ?Int) -> Int
      n * 2

    pub obj P
      pub f: fun(?Int) -> Int

      pub fun make() -> P
        P(f: twice)

