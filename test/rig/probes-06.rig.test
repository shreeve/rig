test "audit-ownership-k06 vec of boxes pop", '''
  see 1
  see 2
  pop 2
  drop 2
  pop 1
  drop 1
  end
'''
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

    drop(!self)
      print("drop", self.key)

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      if key < n.key
        insert(!n.left, key)
      else
        insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  sub walk(slot: ?^Node?)
    if slot as n
      walk(?n.left)
      print(n.key)
      walk(?n.right)

  v: List[^Node] = List()
  !v.push(^Node(key: 1, left: none, right: none))
  !v.push(^Node(key: 2, left: none, right: none))
  for b in ?v
    print("see", b.key)
  while (!v).pop() as b
    print("pop", b.key)
  print("end")

test "audit-ownership-k07 vec of boxes write elem", '''
  drop 1
  drop 10
  see 7 true
  drop 7
'''
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

    drop(!self)
      print("drop", self.key)

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      if key < n.key
        insert(!n.left, key)
      else
        insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  sub walk(slot: ?^Node?)
    if slot as n
      walk(?n.left)
      print(n.key)
      walk(?n.right)

  v: List[^Node] = List()
  !v.push(^Node(key: 1, left: none, right: none))
  for b in !v
    b.left = ^Node(key: 10, left: none, right: none)
    b = ^Node(key: 7, left: none, right: none)
  for b in ?v
    print("see", b.key, b.left == none)

test "audit-ownership-k08 vec boxes for move", '''
  drop 2
  kept true
  drop 1
'''
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

    drop(!self)
      print("drop", self.key)

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      if key < n.key
        insert(!n.left, key)
      else
        insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  sub walk(slot: ?^Node?)
    if slot as n
      walk(?n.left)
      print(n.key)
      walk(?n.right)

  v: List[^Node] = List()
  !v.push(^Node(key: 1, left: none, right: none))
  !v.push(^Node(key: 2, left: none, right: none))
  keep: ^Node? = none
  for b in <v
    if b.key == 1
      keep = <b
  print("kept", keep != none)

test "audit-ownership-k11 box in loop reassign", '''
  at 1
  drop 1
  at 0
  drop 0
  end
'''
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

    drop(!self)
      print("drop", self.key)

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      if key < n.key
        insert(!n.left, key)
      else
        insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  sub walk(slot: ?^Node?)
    if slot as n
      walk(?n.left)
      print(n.key)
      walk(?n.right)

  cur: ^Node? = ^Node(key: 1, left: ^Node(key: 0, left: none, right: none), right: none)
  while <cur as n
    print("at", n.key)
    cur = <n.left
  print("end")

test "audit-ownership-k12 box match write", "9"
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

    drop(!self)
      print("drop", self.key)

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      if key < n.key
        insert(!n.left, key)
      else
        insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  sub walk(slot: ?^Node?)
    if slot as n
      walk(?n.left)
      print(n.key)
      walk(?n.right)

  enum Tree
    leaf(v: Int)
    node(l: ^Tree, r: ^Tree)

  fun sum(t: ?Tree) -> Int
    match t
      .leaf(v) => v
      .node(l, r) => sum(?l) + sum(?r)

  sub bump(t: !Tree)
    match !t
      .leaf(v) => v += 1
      .node(l, r)
        bump(!l)
        bump(!r)

  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.node(l: ^Tree.leaf(v: 2), r: ^Tree.leaf(v: 3)))
  bump(!t)
  print(sum(?t))

test "audit-ownership-k13 box match write replace subtree", "5"
  obj Node
    key: Int
    left: ^Node?
    right: ^Node?

    drop(!self)
      print("drop", self.key)

  sub insert(slot: !^Node?, key: Int)
    if !slot as n
      if key < n.key
        insert(!n.left, key)
      else
        insert(!n.right, key)
    else
      slot = ^Node(key: key, left: none, right: none)

  sub walk(slot: ?^Node?)
    if slot as n
      walk(?n.left)
      print(n.key)
      walk(?n.right)

  enum Tree
    leaf(v: Int)
    node(l: ^Tree, r: ^Tree)

  fun sum(t: ?Tree) -> Int
    match t
      .leaf(v) => v
      .node(l, r) => sum(?l) + sum(?r)

  sub prune(t: !Tree)
    match !t
      .node(l, _)
        l = ^Tree.leaf(v: 100)
        t = .leaf(v: 5)
      .leaf(v) => v += 1

  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.leaf(v: 3))
  prune(!t)
  print(sum(?t))

fail "audit-ownership-k15 match write payload assign root after", "`l` is bound but never read; name it `_` to ignore the value"
  enum Tree
    leaf(v: Int)
    node(l: ^Tree, r: ^Tree)

  sub prune(t: !Tree)
    match !t
      .node(l, _)
        print("x")
        t = .leaf(v: 5)
      .leaf(v) => v += 1

  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.leaf(v: 3))
  prune(!t)
  match t
    .leaf(v) => print(v)
    _ => print("node")

test "audit-ownership-k16 match write local assign root after", "5"
  enum Tree
    leaf(v: Int)
    node(l: ^Tree, r: ^Tree)

  t: Tree = .node(l: ^Tree.leaf(v: 1), r: ^Tree.leaf(v: 3))
  match !t
    .node(l, _)
      l = ^Tree.leaf(v: 7)
      t = .leaf(v: 5)
    .leaf(v) => v += 1
  match t
    .leaf(v) => print(v)
    _ => print("node")

test "audit-ownership-l02 errdefer reads moved", '''
  errdefer 1
  drop 1
  -1
  eat 1
  drop 1
  0
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun run(k: Int) -> Int!
    t = *Tok(n: 1)
    errdefer print("errdefer", t.n)
    n = fail(k)!
    eat(<t)
    n

  print(run(1) catch -1)
  print(run(0) catch -1)

fail "audit-ownership-l04 defer view later var", "deferred code reads `y` through `vw`, but `y` is declared after the `defer` and dropped before it runs"
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  obj View
    b: ?Tok

  x = Tok(n: 1)
  vw = View(b: ?x)
  defer print(vw.b.n)
  y = Tok(n: 2)
  vw.b = ?y

test "audit-ownership-l05 defer in loop break", '''
  iter end 0
  eat 1
  drop 1
  iter end 1
  end
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  t = *Tok(n: 1)
  for i in 0..3
    defer print("iter end", i)
    if i == 1
      eat(<t)
      break
  print("end")

fail "audit-ownership-l07 defer nested scope return", "cannot move out of `b.n`: it copies, so `<` would leave it as it was; remove the `<` to copy it"
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun run(k: Int) -> Int
    a = *Tok(n: 1)
    defer print("outer", a.n)
    if k > 0
      b = *Tok(n: 2)
      defer print("inner", b.n)
      return <b.n
    0

  print(run(1))

  # oracle: run reject C3

test "audit-ownership-l08 propagate in loop with move", '''
  eat 1
  drop 1
  drop 5
  -1
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun run() -> Int!
    t = *Tok(n: 1)
    for i in 0..3
      fail(i - 1)!
      if i == 0
        eat(<t)
        t = *Tok(n: 5)
    0

  print(run() catch -1)

