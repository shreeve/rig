test "audit-ownership-n07 if as then return store"
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  obj Big
    v: List[Int]

  obj View
    b: ?Big

  fun put(v: !View, t: ?Big) -> Bool keeps t
    v.b = t
    false

  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: Big? = Big(v: List())
  if <o as x
    put(!vw, ?x)
    return
  print("after", vw.b.v.len)

fail "audit-ownership-o07 closure lent with write", "cannot lend `v` to read while a write loan is live"
  sub run(v: !List[Int], f: ?fun() -> Int)
    !v.push(f())

  v: List[Int] = List()
  !v.push(1)
  run(!v, |?v| v.len)
  print(v)

fail "audit-ownership-o09 two returned wb", "cannot lend `v` to write while a write loan is live"
  fun slot(a: !List[Int]) -> !List[Int]
    a

  v: List[Int] = List()
  a = slot(!v)
  b = slot(!v)
  !a.push(1)
  !b.push(2)

test "audit-ownership-o12 lend on local wb then use", "[3, 4]"
  sub add(v: !List[Int])
    !v.push(3)

  v: List[Int] = List()
  w = !v
  add(!w)
  !w.push(4)
  print(v)

fail "audit-ownership-o13 array of handles copy", "`a` owns a `[2]*Tok`, which can't be copied by `=`: write `<a` to move it, `+a` to clone it, or `?a` to view it"
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  a = [*Tok(n: 1), *Tok(n: 2)]
  b = a
  print(b[0].n)

fail "audit-ownership-o13b array of handles index move", "cannot move out of `a[0]`: elements cannot be moved out of their container"
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  a = [*Tok(n: 1), *Tok(n: 2)]
  t = <a[0]
  print(t.n)

test "audit-ownership-o14 array of vecs", "1 5"
  a = [List[Int](), List[Int]()]
  !a[0].push(1)
  a[1] = List()
  !a[1].push(5)
  print(a[0].len, a[1][0])

fail "audit-ownership-o15 array slice then write", "cannot assign to `a[0]` while `a` is lent"
  a = [1, 2, 3]
  s = ?a[0..2]
  a[0] = 9
  print(s[0])

test "audit-ownership-o18 slice param returned", "[1, 2]"
  fun head(a: ?[3]Int) -> []Int
    ?a[0..2]

  print(head(?[1, 2, 3]))

test "audit-ownership-p01 cell set reentrant", '''
  drop 1
  drop 2
  after set true
  end
'''
  obj Obj
    n: Int
    home: ~Cell[*Obj?]

    drop(!self)
      print("drop", self.n)
      if *self.home as h
        !h.set(none)

  c: *Cell[*Obj?] = *Cell(none)
  !c.set(*Obj(n: 1, home: ~c))
  !c.set(*Obj(n: 2, home: ~c))
  print("after set", (!c).replace(none) == none)
  print("end")

test "audit-ownership-p02 cell replace reentrant vec", '''
  drop 2
  len in drop 1
  drop 1
  len in drop 2
  after clear 2
  popped true
  drop 101
  len in drop 2
  end 2
  drop 201
  drop 102
'''
  obj Obj
    n: Int
    home: ~Cell[List[*Obj]]

    drop(!self)
      print("drop", self.n)
      if *self.home as h
        !h.push(*Obj(n: self.n + 100, home: ~h))
        print("len in drop", h.len)

  c: *Cell[List[*Obj]] = *Cell(List())
  !c.push(*Obj(n: 1, home: ~c))
  !c.push(*Obj(n: 2, home: ~c))
  !c.clear()
  print("after clear", c.len)
  x = (!c).pop()
  print("popped", x != none)
  <x
  print("end", c.len)

test "audit-ownership-p03 cell pop drop reenter", '''
  drop 3
  drop 2
  drop 1
  drop 0
  end 0
'''
  obj Obj
    n: Int
    home: ~Cell[List[*Obj]]

    drop(!self)
      print("drop", self.n)
      if *self.home as h
        if h.len > 0
          _ = !h.pop()

  c: *Cell[List[*Obj]] = *Cell(List())
  for i in 0..4
    !c.push(*Obj(n: i, home: ~c))
  _ = !c.pop()
  print("end", c.len)

test "audit-ownership-p04 signal set in sub drop", "3 3"
  sig: *Signal[Int] = *Signal(0)
  count: *Cell[Int] = *Cell(0)
  !sig.subscribe(*|~sig, +count|
    !count.set(count.get() + 1)
    if *sig as s
      if s.get() < 3
        !s.set(s.get() + 1)
  )
  !sig.set(1)
  print(sig.get(), count.get())

test "audit-ownership-p05 rc drop reenters parent", "drop child 1"
  obj Child
    n: Int
    parent: ~Cell[*Child?]

    drop(!self)
      print("drop child", self.n)
      if *self.parent as p
        old = (!p).replace(none)
        print("old none", old == none)

  c: *Cell[*Child?] = *Cell(none)
  !c.set(*Child(n: 1, parent: ~c))

