test "audit-sema-up1", '''
  2
  2
'''
  use lib

  obj Q
    n: Int

    fun upgrade(?self) -> Int
      self.n + 1

  sub main()
    q = *Q(n: 1)
    print(q.upgrade())
    p = *lib.P(n: 1)
    print(p.upgrade())

  file "lib.rig"
    pub obj P
      pub n: Int

      pub fun upgrade(?self) -> Int
        self.n + 1
