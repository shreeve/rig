test "audit-ownership-s15 for move propagate", '''
  ok 0
  drop 0
  ok 1
  drop 1
  drop 2
  drop 3
  -1
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun run() -> Int!
    v: List[*Tok] = List()
    for i in 0..4
      !v.push(*Tok(n: i))
    for t in <v
      fail(t.n - 1)!
      print("ok", t.n)
    0

  print(run() catch -1)

test "audit-ownership-s16 for move continue outer", '''
  drop 0
  drop 1
  drop 2
  j 0
  drop 10
  drop 12
  drop 11
  j 1
  end
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  for j in 0..2
    v: List[*Tok] = List()
    for i in 0..3
      !v.push(*Tok(n: i + j * 10))
    @inner for t in <v
      continue if t.n == 0
      break
    print("j", j)
  print("end")

test "audit-ownership-s17 while as temp break", '''
  drop 0
  drop 1
  end 2
'''
  obj Tok
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(t: *Tok)
    pair(a: *Tok, b: *Tok)
    empty

  sub eat(t: *Tok)
    print("eat", t.n)

  fun cond(t: *Tok) -> Bool
    print("cond", t.n)
    false

  error E
    bad

  fun fail(k: Int) -> Int!
    return E.bad if k > 0
    k

  fun mk(k: Int) -> *Tok?
    *Tok(n: k) if k < 3 else none

  k = 0
  while mk(k) as t
    k += 1
    break if t.n == 1
  print("end", k)

fail "audit-ownership-t01 vec of holders order", "`x` is dropped before `v`, whose `drop` body could still read it through this view"
  obj Big
    v: List[Int]

  fun mk(k: Int) -> Big
    b = Big(v: List())
    !b.v.push(k)
    <b

  obj Holder
    b: ?Big

    drop(!self)
      print("holder reads", self.b.v[0])

  v: List[*Holder] = List()
  x = mk(1)
  h = *Holder(b: ?x)
  !v.push(<h)
  print("end")

fail "audit-ownership-t03 holder via wb param", "`x` is dropped before `h`, whose `drop` body could still read it through this view"
  obj Big
    v: List[Int]

  fun mk(k: Int) -> Big
    b = Big(v: List())
    !b.v.push(k)
    <b

  obj Holder
    b: ?Big

    drop(!self)
      print("holder reads", self.b.v[0])

  sub set(h: !Holder, b: ?Big) keeps b
    h.b = b

  x0 = mk(0)
  h = Holder(b: ?x0)
  x = mk(1)
  set(!h, ?x)
  print("end")

fail "audit-ownership-t05 holder shared clone outer", "`x` is dropped before `keep`, whose `drop` body could still read it through this view"
  obj Big
    v: List[Int]

  fun mk(k: Int) -> Big
    b = Big(v: List())
    !b.v.push(k)
    <b

  obj Holder
    b: ?Big

    drop(!self)
      print("holder reads", self.b.v[0])

  keep: *Holder? = none
  x = mk(1)
  h = *Holder(b: ?x)
  keep = +h
  print("end")

fail "audit-ownership-t06 holder optional outer assign", "`x` is dropped before `keep`, whose `drop` body could still read it through this view"
  obj Big
    v: List[Int]

  fun mk(k: Int) -> Big
    b = Big(v: List())
    !b.v.push(k)
    <b

  obj Holder
    b: ?Big

    drop(!self)
      print("holder reads", self.b.v[0])

  keep: Holder? = none
  x = mk(1)
  keep = Holder(b: ?x)
  print("end")

fail "audit-ownership-t08 holder box", "`x` is dropped before `e`, whose `drop` body could still read it through this view"
  obj Big
    v: List[Int]

  fun mk(k: Int) -> Big
    b = Big(v: List())
    !b.v.push(k)
    <b

  obj Holder
    b: ?Big

    drop(!self)
      print("holder reads", self.b.v[0])

  e: ^Holder? = none
  x = mk(1)
  e = ^Holder(b: ?x)
  print("end")

