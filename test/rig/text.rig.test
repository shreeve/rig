  # std.text's byte functions take a `U8`.

  print(text.is_digit(300))

fail "text iterators", "5:10: field `rest` of `std.text.Split` is private to the standard library's module `std.text`", "6:10: only the standard library's module `std.text` can construct `std.text.Split`: its fields `rest`, `sep`, `done` are private", "7:10: method `next` needs its receiver lent to write; write `(!it).next()`", errors: 3
  # std.text's iterators are made by `split`, `lines`, and `words`, which
  # check their arguments, and advanced through a write view.

  it = text.split("a b", " ")
  print(it.rest)
  s = text.Split(rest: "a", sep: "", done: false)
  print(it.next(), (!s).next())

fail "text parse fails", "5:5: fallible call to `text.parse_int` must be wrapped with `!` (propagate) or `catch` (handle)", "6:6: `!` needs a fallible operand; this expression has type `Int?` and cannot fail", "7:60: no member `empty` on type `std.text.ParseError`", errors: 3
  # std.text's parsers can fail, and say so: a call handles the failure or
  # propagates it, a search that cannot fail takes neither, and the
  # errors are `ParseError`'s.

  n = text.parse_int("1")
  at = text.find("abc", "b")!
  ok = text.parse_bool("yes") catch |e| e == text.ParseError.empty
  print(n, at, ok)

# Written by hand, in the shortest forms.

test "building a string from parts", "ab"
  String("a", "b")

test "a parse of empty text fails, and the caller handles it", true
  text.parse_bool("") catch |e| e == text.ParseError.invalid

test "splitting on a space", '''
  a
  b
  c
'''
  for w in text.split("a b c", " ")
    print(w)

bomb "a char boundary past the end", "the index is out of bounds"
  text.char_boundary("ab", 9)

fail "a byte function takes a U8", "does not fit in `U8`"
  text.is_digit(300)

code "a call into std.text calls the module's function", /__rig_m\d+_std_text\.is_digit\(55\)/
