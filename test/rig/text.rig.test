test "text chars table", "4221213868"
  # GENERATED by tools/gen-unicode.py; do not edit.
  # Every code point but the surrogates is put in short texts whose char
  # counts tell its grapheme class of Unicode 15.1.0 apart, and a hash of
  # all the counts equals that of the Character Database.

  # Appends `c` to `t` in UTF-8.
  sub push_rune(t: !String, c: Int)
    if c < 0x80
      !t.push(U8(c))
    else if c < 0x800
      !t.push(U8(0xC0 + c / 64))
      !t.push(U8(0x80 + c % 64))
    else if c < 0x10000
      !t.push(U8(0xE0 + c / 4096))
      !t.push(U8(0x80 + c / 64 % 64))
      !t.push(U8(0x80 + c % 64))
    else
      !t.push(U8(0xF0 + c / 262144))
      !t.push(U8(0x80 + c / 4096 % 64))
      !t.push(U8(0x80 + c / 64 % 64))
      !t.push(U8(0x80 + c % 64))

  # The chars of `before`, `c`, and `after`, written in `t`.
  fun count(t: !String, before: ?String, c: Int, after: ?String) -> Int
    !t.clear()
    !t.add(before)
    push_rune(!t, c)
    !t.add(after)
    text.char_count(?t[..])

  t = String()
  h = 0
  for c in 0..0x110000
    continue if c >= 0xD800 and c < 0xE000
    sig = 0
    sig += (count(!t, "\u{61}", c, "") - 1) << 0
    sig += (count(!t, "", c, "\u{61}") - 1) << 2
    sig += (count(!t, "", c, "\u{301}") - 1) << 4
    sig += (count(!t, "\u{d}", c, "") - 1) << 6
    sig += (count(!t, "", c, "\u{a}") - 1) << 8
    sig += (count(!t, "", c, "\u{1161}") - 1) << 10
    sig += (count(!t, "", c, "\u{11a8}") - 1) << 12
    sig += (count(!t, "", c, "\u{1100}") - 1) << 14
    sig += (count(!t, "", c, "\u{1f1e6}") - 1) << 16
    sig += (count(!t, "\u{1f600}\u{200d}", c, "") - 1) << 18
    sig += (count(!t, "\u{915}\u{94d}", c, "") - 1) << 20
    sig += (count(!t, "\u{915}", c, "\u{915}") - 1) << 22
    sig += (count(!t, "\u{915}\u{94d}", c, "\u{915}") - 1) << 24
    sig += (count(!t, "\u{1f600}", c, "\u{200d}\u{1f600}") - 1) << 26
    sig += (count(!t, "\u{ac00}", c, "") - 1) << 28
    h = (h * 31 + sig) % 4294967296
  print(h)

test "text class end", release: true, '''
  3 7 7
  2 2 0
  0 differ
'''
  # std.text's `class_end` against a plain loop: each of the 8 mask bits
  # alone, a mask of several and of all; runs of 0 to 40 bytes in a class
  # before a byte outside it, from every `i`; a text of one class to its
  # end; and a byte whose table entry is 0xFF, in every class. Each case
  # that differs prints itself; the last line counts them.

  fun plain(s: ?String, i: Int, table: ?[256]U8, mask: U8) -> Int
    j = i
    while j < s.len and table[s[j]] & mask != 0
      j += 1
    j

  # Byte `b` is in the classes of the bits of `b % 8` and `b % 8 + 1`;
  # 0xFF is in every class, and 0x00 in none.
  fun classes() -> [256]U8
    t: [256]U8 = [256 of 0]
    for b in 1..255
      t[b] = U8(1) <<% (b % 8) | U8(1) <<% ((b + 1) % 8)
    t[255] = 0xFF
    t

  fun differs(s: ?String, i: Int, table: ?[256]U8, mask: U8) -> Int
    got = text.class_end(s, i, table, mask)
    want = plain(s, i, table, mask)
    return 0 if got == want
    print("mask", mask, "len", s.len, "at", i, "got", got, "want", want)
    1

  t = classes()
  bad = 0
  masks: [11]U8 = [1, 2, 4, 8, 16, 32, 64, 128, 0x81, 0x5A, 0xFF]
  for mask in masks
    # The last byte below 0xFF in `mask`'s class, and the last outside it.
    inside: U8 = 0xFF
    outside: U8 = 0
    for b in 1..255
      if t[b] & mask != 0
        inside = U8(b)
      else
        outside = U8(b)
    for run in 0..41
      for tail in 0..3
        s = String()
        for j in 0..run
          !s.push(0xFF if j % 3 == 0 else inside)
        !s.push(outside)
        for _ in 0..tail
          !s.push(inside)
        for i in 0..s.len + 1
          bad += differs(s, i, t, mask)
    for b in 0..256
      if t[b] & mask != 0
        s = String()
        for _ in 0..37
          !s.push(U8(b))
        bad += differs(s, 0, t, mask) + differs(s, 18, t, mask) + differs(s, s.len, t, mask)
  s = "abc\x00def"
  print(text.class_end(s, 0, t, 0xFF), text.class_end(s, 4, t, 0xFF), text.class_end(s, s.len, t, 0xFF))
  print(text.class_end("\xff\xff\x00", 0, t, 0x80), text.class_end("\xff\xff", 1, t, 0x01), text.class_end("", 0, t, 1))
  print(bad, "differ")

bomb "text class end outside", "index out of bounds", prints: "2 2", release: true
  # std.text's `class_end` panics at an `i` outside 0 to `s.len`, as
  # indexing does.

  t: [256]U8 = [256 of 1]
  s = "ab"
  print(text.class_end(s, 0, t, 1), text.class_end(s, s.len, t, 1))
  print(text.class_end(s, -1, t, 1))

test "text edit distance", '''
  3 3
  1 3
  0 3 0
  1 1
  2 2
  1 0
  2 1
  3
  0 true
'''
  # `edit_distance` is Levenshtein distance over runes, with a scratch row
  # the caller owns and an early exit when the distance passes `max`.

  row: List[Int] = List()
  print(text.edit_distance("kitten", "sitting", !row), text.edit_distance("", "abc", !row))
  print(text.edit_distance("\u{e9}a", "ea", !row), text.edit_distance("kitten", "sitting", !row, max: 2))
  print(text.edit_distance("", "", !row), text.edit_distance("abc", "", !row), text.edit_distance("abc", "abc", !row))
  print(text.edit_distance("\xff", "a", !row), text.edit_distance("\u{20ac}\u{20ac}", "\u{20ac}", !row))
  print(text.edit_distance("flaw", "lawn", !row), text.edit_distance("lawn", "flaw", !row))
  print(text.edit_distance("\xff", "\xfe", !row), text.edit_distance("\xff", "\xff", !row))
  print(text.edit_distance("\xc0\x80", "\xc1\x81", !row), text.edit_distance("\xe2\x82", "\xe2\x83", !row))
  print(text.edit_distance("\xed\xa0\x80", "x", !row))
  words = ["", "a", "ab", "ba", "abc", "kitten", "sitting", "saturday", "sunday", "\u{e9}t\u{e9}", "ete"]
  bad = 0
  for a in words
    for b in words
      full = text.edit_distance(a, b, !row)
      for max in 0..9
        got = text.edit_distance(a, b, !row, max: max)
        want = full if full <= max else max + 1
        bad += 1 if got != want else 0
      bad += 1 if full != text.edit_distance(b, a, !row) else 0
  print(bad, row.len > 0)

test "text find any", release: true, '''
  4 7 9 -1
  -1 -1 -1
  0 differ
'''
  # std.text's `find_any` against a plain loop over the set, with `none`
  # read as -1: sets of 0 to 8 bytes and a long one, with 0x00, 0xFF and
  # duplicates; a match at every offset from `i`, and none; every `i`
  # from 0 to `s.len`; texts of every length 0 to 80, so the 16-byte
  # steps, the tail that reads the last 16 bytes again, and the U64 test
  # of a short text each meet every case; and random texts. The filler
  # beside a match is a set byte plus 1, which a word test can wrongly
  # mark when the subtraction at a match takes 1 from it. Each case that
  # differs prints itself; the last line counts them.

  obj Rand
    x: Int

    fun next(!self) -> Int
      self.x = self.x *% 6364136223846793005 +% 1442695040888963407
      (self.x >> 33) & 0x7FFFFFFF

  # The first index from `i` whose byte is in `set`, or -1.
  fun plain(s: ?String, set: ?String, i: Int) -> Int
    for j in i..s.len
      for b in set
        return j if s[j] == b
    -1

  fun in_set(set: ?String, c: U8) -> Bool
    for b in set
      return true if b == c
    false

  # The bytes that fill a text around its matches: each set byte plus 1
  # that is not in the set, or `a`.
  fun fillers(set: ?String) -> String
    out = String()
    for b in set
      c = U8((Int(b) + 1) & 0xFF)
      !out.push(c) if not in_set(set, c)
    !out.push(0x61) if out.len == 0
    out

  fun differs[set: ?String](s: ?String, i: Int) -> Int
    got = text.find_any[set](s, i) ?? -1
    want = plain(s, set, i)
    return 0 if got == want
    print("set", set.len, "len", s.len, "at", i, "got", got, "want", want)
    1

  # Every length 0 to 80, every place for one match (and none), and every
  # `i`; a second match follows the first, so a test that reads past the
  # first is caught.
  fun sweep[set: ?String]() -> Int
    bad = 0
    owned = fillers(set)
    fill = ?owned[..]
    for n in 0..81
      for p in -1..n
        s = String()
        for j in 0..n
          if set.len > 0 and (j == p or j == p + 3)
            !s.push(set[j % set.len])
          else
            !s.push(fill[j % fill.len])
        for i in 0..n + 1
          bad += differs[set](s, i)
    bad

  # Random texts of 0 to 100 bytes, each byte a set byte one time in 16,
  # and every `i`.
  fun random[set: ?String](rnd: !Rand) -> Int
    bad = 0
    owned = fillers(set)
    fill = ?owned[..]
    for _ in 0..300
      n = (!rnd).next() % 101
      s = String()
      for _ in 0..n
        v = (!rnd).next()
        if set.len > 0 and v % 16 == 0
          !s.push(set[(v >> 4) % set.len])
        else if v % 16 == 1
          !s.push(U8((v >> 4) & 0xFF))
        else
          !s.push(fill[(v >> 4) % fill.len])
      for i in 0..n + 1
        bad += differs[set](s, i)
    bad

  fun all[set: ?String](rnd: !Rand) -> Int
    sweep[set]() + random[set](!rnd)

  rnd = Rand(x: 7)
  bad = 0
  bad += all[""](!rnd)
  bad += all["\""](!rnd)
  bad += all["\"\\"](!rnd)
  bad += all["\n\r\xe2"](!rnd)
  bad += all["\"\\\n\r"](!rnd)
  bad += all["<>&\"'"](!rnd)
  bad += all["<>&\"'\n"](!rnd)
  bad += all["<>&\"'\n\r"](!rnd)
  bad += all["<>&\"'\n\r\t"](!rnd)
  bad += all["<>&\"'\n\r\x00{}[]\xff~"](!rnd)
  bad += all["\x00"](!rnd)
  bad += all["\xff"](!rnd)
  bad += all["\x00\xff"](!rnd)
  bad += all["\x01\x00"](!rnd)
  bad += all["aa"](!rnd)
  bad += all["xyxyx"](!rnd)
  s = "say \"hi\" \\ then"
  print(text.find_any["\"\\"](s, 0) ?? -1, text.find_any["\"\\"](s, 5) ?? -1, text.find_any["\"\\"](s, 8) ?? -1, text.find_any["\"\\"](s, s.len) ?? -1)
  print(text.find_any[""](s, 3) ?? -1, text.find_any["z"](s, 0) ?? -1, text.find_any["\x00"]("", 0) ?? -1)
  print(bad, "differ")

bomb "text find any negative", "index out of bounds", prints: "0", release: true
  # std.text's `find_any` panics at a negative `i`, as indexing does.

  print(text.find_any["a"]("ab", 0) ?? -1)
  print(text.find_any["a"]("ab", -1) ?? -1)

bomb "text find any outside", "index out of bounds", prints: "-1 -1", release: true
