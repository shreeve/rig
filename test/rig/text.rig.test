# std.text, std.utf8, std.utf16, and std.unicode: text as bytes, runes, units, and chars.

use std.os
use std.sort
use std.text
use std.unicode
use std.utf16
use std.utf8

test "text bytes", '''
  48 true false false 48 48
  57 true false false 57 57
  47 false false false 47 47
  58 false false false 58 58
  97 false true false 65 97
  122 false true false 90 122
  65 false true false 65 97
  90 false true false 90 122
  64 false false false 64 64
  91 false false false 91 91
  96 false false false 96 96
  123 false false false 123 123
  32 false false true 32 32
  9 false false true 9 9
  10 false false true 10 10
  11 false false true 11 11
  12 false false true 12 12
  13 false false true 13 13
  8 false false false 8 8
  14 false false false 14 14
  31 false false false 31 31
  33 false false false 33 33
  195 false false false 195 195
  169 false false false 169 169
  255 false false false 255 255
  6 81 255
  true false true false true
  true false
  false
  -1 1 0 0
  -1 1 -1 -1 1
  true
  true
  true
  ["", "Fig", "apple", "fig", "pear"]
'''
  # std.text's byte functions: ASCII classes and case, UTF-8 validity
  # (`utf8.is_valid`), and `compare`, which orders Strings as `<` does.

  sub classes(s: ?String)
    for b in s
      print(b, text.is_digit(b), text.is_alpha(b), text.is_space(b), text.to_upper(b), text.to_lower(b))

  fun digits(s: ?String) -> Int
    n = 0
    for b in s
      if text.is_digit(b)
        n += 1
    n

  # "0", "9", "/", ":", "a", "z", "A", "Z", "@", "[", "`", "{"
  classes("09/:azAZ@[`{")
  # space, tab, line feed, vertical tab, form feed, carriage return, and
  # the bytes either side of them
  classes(" \t\n\x0b\x0c\r\x08\x0e\x1f!")
  # the two bytes of "é", and 0xff
  classes("é\xff")
  print(digits("a1b22c333"), text.to_upper(text.to_lower(81)), text.to_lower(U8.max))

  ok = "h\xc3\xa9!"
  print(utf8.is_valid(ok), utf8.is_valid("h\xc3("), utf8.is_valid(""), utf8.is_valid("\xe2\x82"), utf8.is_valid("\xe2\x82\xac"))
  print(utf8.is_valid(ok[1..3]), utf8.is_valid(ok[2..]))
  print(utf8.is_valid("\xff"))

  print(text.compare("a", "b"), text.compare("b", "a"), text.compare("ab", "ab"), text.compare("", ""))
  print(text.compare("ab", "abc"), text.compare("abc", "ab"), text.compare("", "a"), text.compare("Z", "a"), text.compare("é", "z"))
  for pair in [["pear", "fig"], ["fig", "fig"], ["a", "ab"]]
    print((text.compare(pair[0], pair[1]) < 0) == (pair[0] < pair[1]))

  names = ["pear", "Fig", "apple", "fig", ""]
  sort.sort_by(!names, |a, b| text.compare(a, b) < 0)
  print(names)

bomb "text char boundary negative panics", "text.char_boundary: the index is out of bounds"
  # A negative byte index is outside the text.

  print(text.char_boundary("ab", -1))

bomb "text char boundary panics", "text.char_boundary: the index is out of bounds"
  # `char_boundary` takes a byte index from 0 to the text's length.

  print(text.char_boundary("ab", 3))

test "text chars", release: true, '''
  a 1 1 [ 1 ]
  e-acute 2 1 [ 2 ]
  e+combining 3 1 [ 3 ]
  wave+tone 8 1 [ 8 ]
  family 18 1 [ 18 ]
  crlf 2 1 [ 2 ]
  lfcr 2 2 [ 1 1 ]
  cr cr lf 3 2 [ 1 2 ]
  flags 20 3 [ 8 8 4 ]
  hangul 15 2 [ 9 6 ]
  devanagari 12 1 [ 12 ]
  empty 0 0 [  ]
  bad 4 4 [ 1 1 1 1 ]
  bad+mark 4 2 [ 3 1 ]
  cut 3 2 [ 2 1 ]
  mixed 26 8 [ 1 2 3 2 8 1 8 1 ]
  0 1 1 3 3 3 6 6 8 8 8 8 8 8 8 8 16 17 17 17 17 17 17 17 17 25 26
  0/0 1/1 3/9 6/10 8/18 16/20 17/23 25/25 26/26 26/26
  0/0 0/0
  0/0 1/1 2/2 3/3 3/3
  [  ] héllo [  ] héllo
  1 1 3
  0 👨‍👩‍👧 a
  48 64 64 47
  true 3
'''
  # std.text's chars: Unicode's extended grapheme clusters. Each text in
  # the first table is one char, however many bytes and runes it takes;
  # CR LF is one char, regional indicators pair up into flags, and Hangul
  # jamo join into syllables. Bytes that are not UTF-8 are one char each
  # (each is one rune, U+FFFD), so the chars always tile the text.

  # The byte size of each char of `s`.
  fun sizes(s: ?String) -> String
    out = String()
    for c in text.chars(s)
      !out.add(" ") if out.len > 0
      !out.add(c.len)
    out

  # `piece`, `n` times.
  fun repeat(piece: ?String, n: Int) -> String
    out = String()
    for _ in 0..n
      !out.add(piece)
    out

  sub show(name: ?String, s: ?String)
    print(name, s.len, text.char_count(s), "[", sizes(s), "]")

  # Where `char_boundary` puts each byte of `s`, and `s.len`.
  sub boundaries(s: ?String)
    out = String()
    for i in 0..s.len + 1
      !out.add(" ") if out.len > 0
      !out.add(text.char_boundary(s, i))
    print(out)

  sub ends(s: ?String)
    out = String()
    for n in 0..text.char_count(s) + 2
      !out.add(" ") if out.len > 0
      !out.add(text.first_chars(s, n).len, "/", text.last_chars(s, n).len)
    print(out)

  show("a", "a")
  show("e-acute", "\u{e9}")
  show("e+combining", "e\u{301}")
  show("wave+tone", "\u{1f44b}\u{1f3fd}")
  show("family", "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}")

  show("crlf", "\r\n")
  show("lfcr", "\n\r")
  show("cr cr lf", "\r\r\n")
  show("flags", "\u{1f1fa}\u{1f1f8}\u{1f1eb}\u{1f1f7}\u{1f1ef}")
  show("hangul", "\u{1100}\u{1161}\u{11a8}\u{ac00}\u{11a8}")
  show("devanagari", "\u{915}\u{94d}\u{937}\u{93f}")
  show("empty", "")

  # Each byte that is not UTF-8 is one char, and a combining mark joins
  # it as it would any other rune.
  show("bad", "\xff\xc3\xe2\x82")
  show("bad+mark", "\xff\u{301}a")
  show("cut", "\u{e9}\xa9")

  mixed = "a\u{e9}e\u{301}\r\n\u{1f44b}\u{1f3fd}\xff\u{1f1fa}\u{1f1f8}z"
  show("mixed", mixed)
  boundaries(mixed)
  ends(mixed)
  ends("")
  ends("\xe2\x82\xff")
  print("[", text.first_chars("h\u{e9}llo", 0), "]", text.first_chars("h\u{e9}llo", 9), "[", text.last_chars("h\u{e9}llo", 0), "]", text.last_chars("h\u{e9}llo", 9))
  print(text.first_chars("\xff\xfe", 1).len, text.last_chars("\xff\xfe", 1).len, text.first_chars("e\u{301}\xff", 1).len)

  # Cutting at a byte limit without breaking a char.
  s = "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467} and more"
  print(s[..text.char_boundary(s, 12)].len, s[..text.char_boundary(s, 20)])

  # ASCII that ends the text where a block of 32 bytes ends.
  a64 = repeat("ab\r\n", 16)
  print(text.char_count(a64), text.first_chars(a64, 48).len, text.first_chars(a64, 99).len, text.char_count(a64[1..]))

  # A char is a part of the String it came from.
  owned = String("ab\u{e9}")
  n = 0
  it = text.chars(?owned)
  for c in !it
    n += c.len
  print(n == owned.len, text.char_count(owned))

test "text chars conformance", "1187 tests, 0 failed", release: true
  # GENERATED by tools/gen-unicode.py from GraphemeBreakTest.txt of Unicode
  # 15.1.0; do not edit.
  # Every test of Unicode's grapheme break test: `text.chars` splits the
  # text into chars of the byte sizes the test gives, and `char_count`,
  # `first_chars`, `last_chars`, and `char_boundary` agree with them at
  # every char and every byte.

  # 0 when `s` splits into chars of the byte sizes `want` (separated by
  # spaces) and the other char tools agree; else 1, after printing why.
  fun check(line: Int, s: ?String, want: ?String) -> Int
    got = String()
    starts = List[Int]()
    at = 0
    for c in text.chars(s)
      !got.add(" ") if got.len > 0
      !got.add(c.len)
      !starts.push(at)
      at += c.len
    if got != want
      print("line", line, "sizes", got, "want", want)
      return 1
    n = starts.len
    if text.char_count(s) != n
      print("line", line, "char_count", text.char_count(s))
      return 1
    for k in 0..n
      end = starts[k + 1] if k + 1 < n else s.len
      for i in starts[k]..end
        if text.char_boundary(s, i) != starts[k]
          print("line", line, "char_boundary", i, text.char_boundary(s, i))
          return 1
      if text.first_chars(s, k).len != starts[k]
        print("line", line, "first_chars", k)
        return 1
      if text.last_chars(s, n - k).len != s.len - starts[k]
        print("line", line, "last_chars", n - k)
        return 1
    if text.char_boundary(s, s.len) != s.len or text.first_chars(s, n).len != s.len or text.last_chars(s, 0).len != 0
      print("line", line, "at the end")
      return 1
    0

  bad = 0
  bad += check(25, "\u{20}\u{20}", "1 1")
  bad += check(26, "\u{20}\u{308}\u{20}", "3 1")
  bad += check(27, "\u{20}\u{d}", "1 1")
