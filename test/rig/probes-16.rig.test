      g(i + 70) + g(i + 71) + g(i + 72) + g(i + 73) + g(i + 74) + g(i + 75) + g(i + 76) + g(i + 77) + g(i + 78) + g(i + 79) + \
      g(i + 80) + g(i + 81) + g(i + 82) + g(i + 83) + g(i + 84) + g(i + 85) + g(i + 86) + g(i + 87) + g(i + 88) + g(i + 89) + \
