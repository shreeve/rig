test "rev255-zd01 nonkept copies", "hellohello 5 2 static hello zzzzzzzz"
  obj P
    owned: String
    n: Int
    pos: Int
    src: ?String
    names: List[String]

    sub note(!@, s: ?String)
      @owned = String(s)
      @n += s.len
      !@owned.add(s)
      @pos = text.find(s, "l") ?? -1
      @src = "static"
      !@names.push(String(s))

  p = P(owned: String(""), n: 0, pos: 0, src: "", names: List())
  t = String("hello")
  !p.note(?t)
  <t
  u = String("zzzzzzzz")
  print(p.owned, p.n, p.pos, p.src, p.names[0], u)

