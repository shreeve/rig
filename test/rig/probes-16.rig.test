test "rev229-closure-self", "3"
  # Review of #229: an `inline` function's closure calling it is a call of
  # its own, no cycle.

  inline fun go(n: Int) -> Int
    return 0 if n <= 0
    f = |+n| go(n - 1)
    f() + 1

  print(go(3))

fail "rev229-cycle-objects", "`A.go` is `inline` and calls itself through `B.go`, also `inline`, so no call of it can be inlined; drop `inline` from one of them"
  # Review of #229: a cycle of `inline` methods of two object types names
  # each by its type.

  obj A[T]
    v: T

    inline fun go(?@, n: Int) -> Int
      return 0 if n <= 0
      b = B[T](v: 1)
      b.go(n - 1) + 1

  obj B[T]
    v: Int

    inline fun go(?@, n: Int) -> Int
      a = A[Int](v: 2)
      a.go(n - 1) + 1

  a = A[Bool](v: true)
  print(a.go(3))

test "rev229-generic-member-module", "1688700"
  # The residual of #229's first review after #237, across modules: the
  # only instance of `lib.Box.w`, a generic type's member with 56 KB of
  # values, is made here, where `main` calls it 1,300 times (73 MB, more
  # than the program's stack). The instance's frame, counted here, is the
  # member's, so the rule leaves it a call.

  use lib

  sub main()
    b = lib.Box[Int](v: 1)
    i = 0
    s = 0
    s += b.w(i + 0) + b.w(i + 1) + b.w(i + 2) + b.w(i + 3) + b.w(i + 4) + b.w(i + 5) + b.w(i + 6) + b.w(i + 7) + b.w(i + 8) + b.w(i + 9)
