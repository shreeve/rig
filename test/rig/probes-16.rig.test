  file "lib.rig"
    pub obj Box[T]
      pub v: T

      pub fun w(?@, i: Int) -> Int
        t = [7000 of 0]
        for k in 0..7000
          t[k] = k + i
        t[i % 7000]

test "rev229-generic-member-nested", "1688700"
  # The residual of #229's first review after #237: a member of a generic
  # type is inlined by the rule per instance, under the largest frame of
  # its instances. `Box.w` keeps 56 KB of values, and its only instance is
  # made inside another generic function's body, which calls it 1,300
  # times (73 MB, more than the program's stack): its frame is counted at
  # that instance, so the rule leaves it a call there.

  obj Box[T]
    v: T

    fun w(?@, i: Int) -> Int
      t = [7000 of 0]
      for k in 0..7000
        t[k] = k + i
      t[i % 7000]

  fun outer[T](x: T, i: Int) -> Int
