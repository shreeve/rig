  s = *S(n: 1)
  f = *|~s|
    if *<s as p
      print(p.n)
  f()
  f()

test "rev228-temp-parts", '''
  1
  2
  true
  true
'''
  obj S
    n: Int

  obj H
    w: ~S
    ws: List[~S]

  fun mk(s: *S) -> H
    ws: List[~S] = List()
    !ws.push(~s)
    H(w: ~s, ws: <ws)

  s = *S(n: 1)
  if *mk(+s).w as p
    print(p.n)
  if *mk(+s).ws[0] as p
    print(p.n + 1)
  print(*mk(+s).w != none)
  <s
  print(*mk(*S(n: 2)).w == none)

test "rev229-chain-pile", "91200"
  # Step 3 of the frame owners round: `a`, which the rule inlines, calls
  # `g`, marked `inline`, which calls `w`, which the rule inlines, 56 KB of
  # values; `near` calls `a` 300 times. Each call of `a` lands `g` and `w`
  # in `near`'s frame, so `w`'s frame counts in `near`'s account through
  # both, and the rule stops before the frame passes 64 KiB.

  fun w(i: Int) -> Int
    t = [7000 of 0]
    for k in 0..7000
      t[k] = k + i
    t[i % 7000]

  inline fun g(i: Int) -> Int
    w(i) + 1

  fun a(i: Int) -> Int
    g(i)

  fun near(i: Int) -> Int
    a(i + 0) + a(i + 1) + a(i + 2) + a(i + 3) + a(i + 4) + a(i + 5) + a(i + 6) + a(i + 7) + a(i + 8) + a(i + 9) + \
    a(i + 10) + a(i + 11) + a(i + 12) + a(i + 13) + a(i + 14) + a(i + 15) + a(i + 16) + a(i + 17) + a(i + 18) + a(i + 19) + \
    a(i + 20) + a(i + 21) + a(i + 22) + a(i + 23) + a(i + 24) + a(i + 25) + a(i + 26) + a(i + 27) + a(i + 28) + a(i + 29) + \
    a(i + 30) + a(i + 31) + a(i + 32) + a(i + 33) + a(i + 34) + a(i + 35) + a(i + 36) + a(i + 37) + a(i + 38) + a(i + 39) + \
    a(i + 40) + a(i + 41) + a(i + 42) + a(i + 43) + a(i + 44) + a(i + 45) + a(i + 46) + a(i + 47) + a(i + 48) + a(i + 49) + \
    a(i + 50) + a(i + 51) + a(i + 52) + a(i + 53) + a(i + 54) + a(i + 55) + a(i + 56) + a(i + 57) + a(i + 58) + a(i + 59) + \
    a(i + 60) + a(i + 61) + a(i + 62) + a(i + 63) + a(i + 64) + a(i + 65) + a(i + 66) + a(i + 67) + a(i + 68) + a(i + 69) + \
    a(i + 70) + a(i + 71) + a(i + 72) + a(i + 73) + a(i + 74) + a(i + 75) + a(i + 76) + a(i + 77) + a(i + 78) + a(i + 79) + \
    a(i + 80) + a(i + 81) + a(i + 82) + a(i + 83) + a(i + 84) + a(i + 85) + a(i + 86) + a(i + 87) + a(i + 88) + a(i + 89) + \
    a(i + 90) + a(i + 91) + a(i + 92) + a(i + 93) + a(i + 94) + a(i + 95) + a(i + 96) + a(i + 97) + a(i + 98) + a(i + 99) + \
    a(i + 100) + a(i + 101) + a(i + 102) + a(i + 103) + a(i + 104) + a(i + 105) + a(i + 106) + a(i + 107) + a(i + 108) + a(i + 109) + \
    a(i + 110) + a(i + 111) + a(i + 112) + a(i + 113) + a(i + 114) + a(i + 115) + a(i + 116) + a(i + 117) + a(i + 118) + a(i + 119) + \
    a(i + 120) + a(i + 121) + a(i + 122) + a(i + 123) + a(i + 124) + a(i + 125) + a(i + 126) + a(i + 127) + a(i + 128) + a(i + 129) + \
    a(i + 130) + a(i + 131) + a(i + 132) + a(i + 133) + a(i + 134) + a(i + 135) + a(i + 136) + a(i + 137) + a(i + 138) + a(i + 139) + \
