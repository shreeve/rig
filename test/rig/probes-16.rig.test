    xs[bump(!xs)]

  v: List[Int] = List()
  !v.push(7)
  !v.push(8)
  print(at(!v[..]))

test "rev224-called-rarely", '''
  5 8 3.0 6 8
  2 9 6
  safe 2
  safe 500
  7 5 -1 100
  ok 1
  checked 1
  checked -1
  failed -1
  caught
  0
  1 8 4.0
'''
  # Review of #224's split: `called` and `rarely` on functions, methods,
  # generic and compile-time-parameter functions, fallible ones with
  # `defer` and `errdefer`, function values, and across modules.

  use lib
  use std.math

  error E
    bad

  called fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
    f(x)

  fun safe(n: Int) -> Int!
    rarely
    return E.bad if n == 0
    defer print("safe", n)
    if n > 100
      return 100
    10 / n

  sub check(n: Int)!
    rarely
    errdefer print("failed", n)
    defer print("checked", n)
    return E.bad if n < 0
    print("ok", n)

  obj Acc
    items: List[Int]

    called sub add(!@, x: Int)
      !@items.push(x)

    fun first(?@) -> Int?
      rarely
      return none if @items.len == 0
      @items[0]

  called fun Acc.count(?@) -> Int
    @items.len

  called fun tiny(x: Int) -> Int
    x

  fun sq(x: Float) -> Float
    rarely
    math.sqrt(x)

  sub main()
    b = lib.Box[Int](v: 3)
    !b.set(5)
    print(b.get(), lib.twice(4), lib.twice(1.5), lib.scaled[3](2), lib.scaled[4](2))
    print(apply(lib.inc, 1), apply(tiny, 9), apply(|x: Int| x * 2, 3))
    g = tiny
    print(g(7), safe(2) catch -1, safe(0) catch -1, safe(500) catch -1)
    check(1) catch print("x")
    check(-1) catch print("caught")
    a = Acc(items: List[Int]())
    print(a.first() ?? 0)
    !a.add(8)
    print(a.count(), a.first() ?? 0, sq(16.0))

  file "lib.rig"
    pub obj Box[T: Copy]
      pub v: T

      pub called fun get(?@) -> T
        @v

      pub sub set(!@, v: T)
        rarely
        @v = v

    pub called fun twice[T: Num](x: T) -> T
      x + x

    pub fun scaled[k: Int](x: Int) -> Int
      rarely
      x * k

    pub called fun inc(x: Int) -> Int
      x + 1

fail "rev224-generic-cycle", "`G.a` is `inline` and calls itself through `G.b`, also `inline`, so no call of it can be inlined; drop `inline` from one of them"
  # Review of #224: a cycle of `inline` methods of a generic object type,
  # and one through an `inline` generic function, are rejected.

  obj G[T]
    v: T

    inline fun a(?@, n: Int) -> Int
      0 if n == 0 else @b(n - 1)

    inline fun b(?@, n: Int) -> Int
      0 if n == 0 else @a(n - 1)

  obj H
    n: Int

    inline fun step(?@, k: Int) -> Int
      0 if k == 0 else via[Int](@, k - 1)

  inline fun via[T](x: ?H, k: Int) -> Int
    x.step(k)

  g = G[Int](v: 1)
  h = H(n: 1)
  print(g.a(3), h.step(2))

test "rev224-inline-views", '''
  a
  az
  0 3
  bag
'''
  # Review of #224: `inline` functions and methods that move, lend, and hand
  # back views run as they do when called.

  obj Bag
    items: List[String]
    name: String

    inline fun into_name(<@) -> String
      new b = <@
      swap(!b.name, String("x"))

    inline fun first(?@) -> ?String
      ?@items[0]

    inline fun slot(!@) -> !String
      !@items[0]

  inline fun head(xs: ?List[Int]) -> ?Int
    ?xs[0]

  inline fun make(n: Int) -> List[Int]
    out = List[Int]()
    for i in 0..n
      !out.push(i)
    out

  b = Bag(items: List[String](), name: String("bag"))
  !b.items.push(String("a"))
  print(b.first())
  s = (!b).slot()
  !s.add("z")
  print(b.first())
  xs = make(3)
  h = head(?xs)
  print(h, xs.len)
  n = <b.into_name()
  print(n)

test "rev224-std-wrapper", "1 7"
  # Review of #224: an `inline` function that calls a method of a built-in
  # type, or one through a handle, of its own name, calls no Rig function of
  # that name, so it is no cycle.

  inline sub push(xs: !List[Int], x: Int)
    !xs.push(x)

  obj Holder
    c: *Cell[Int]

    inline fun get(?@) -> Int
      @c.get()

  xs = List[Int]()
  push(!xs, 1)
  h = Holder(c: *Cell[Int](7))
  print(xs.len, h.get())

test "rev227-empty-defaults", '''
  42
  1 0 0
  Zero()
  drop 7 0
  drop 7 0
  drop 7 0
'''
  # `T()` from another module, as a local and as field defaults, of
  # objects with private defaulted fields, a resource with a `drop`, a
  # `unique` object, a generic one, nested defaults, and an object with no
  # fields.

  use lib

  obj Holder
    a: lib.Res = lib.Res()
    n: lib.Nest = lib.Nest()
    b: lib.Box[List[Int]] = lib.Box[List[Int]]()
    z: lib.Zero = lib.Zero()
    l: lib.Lim = lib.Lim()

  sub main()
    r = lib.Res()
    s = lib.Seed()
    print(s.get())
    h1 = Holder()
    h2 = Holder()
    l = List[Int]()
    !l.push(1)
    !h1.b.put(<l)
    print(h1.b.count, h2.b.count, h1.l.s.len)
    z = lib.Zero()
    print(z)

  file "lib.rig"
    pub obj Res
      id: Int = 7
      log: List[String] = List()

      drop(!@)
        print("drop", @id, @log.len)

    pub obj Seed unique
      s: Int = 42

      pub fun get(?@) -> Int
        @s

    pub obj Half
      n: Int

    pub obj Box[T]
      items: List[T] = List()
      pub ?count: Int = 0
      pub sub put(!@, x: T)
        !@items.push(<x)
        @count += 1

    pub obj Nest
      inner: Box[String] = Box[String]()
      more: List[Box[Int]] = List()

    pub obj Zero
      pub fun one(?@) -> Int
        1

    pub obj Lim
      n: Int = Int.max
      pub ?s: String = String()

test "rev227-empty-generic-field", "1 0 1 0"
  # `T[A]()` of another module's generic object as a field default inside
  # a generic object.

  use lib

  obj Outer[T]
    inner: lib.Box[T] = lib.Box[T]()
    more: List[T] = List()

  sub main()
    o = Outer[String]()
    !o.more.push(String("x"))
    !o.inner.put(String("y"))
    p = Outer[String]()
    print(o.inner.count, p.inner.count, o.more.len, p.more.len)

  file "lib.rig"
    pub obj Res
