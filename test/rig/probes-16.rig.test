fail "rev220-handle-root", "cannot lend `h` to write in an index of a place it is lending"
  obj P
    hl: *List[Int]

  fun reh(h: !*List[Int]) -> Int
    n: List[Int] = List()
    !n.push(50)
    h = *<n
    0

  fun rep(p: !P) -> Int
    n: List[Int] = List()
    !n.push(50)
    p.hl = *<n
    0

  fun rea(h: !*[3]Int) -> Int
    h = *[4, 5, 6]
    0

  fun rec(c: !*Cell[List[Int]]) -> Int
    c = *Cell(List())
    !c.push(9)
    0

  v: List[Int] = List()
  !v.push(7)
  h = *<v
  print(h[reh(!h)])
  w: List[Int] = List()
  !w.push(7)
  p = P(hl: *<w)
  print(p.hl[rep(!p)])
  a: *[3]Int = *[1, 2, 3]
  print(a[rea(!a)])
  c: *Cell[List[Int]] = *Cell(List())
  !c.push(7)
  print(c[rec(!c)])

test "rev220-in-root", '''
  40 101 77
  218
'''
  obj G[T]
    items: List[T]
    pair: [2]List[T]

  obj P
    arr: [2][2]Int
    g: G[Int]

  fun bump(p: !P) -> Int
    p.arr[0][1] = 40
    n: List[Int] = List()
    for i in 0..50
      !n.push(i + 100)
    p.g.items = <n
    m: List[Int] = List()
    !m.push(77)
    p.g.pair[1] = <m
    1

  fun inner(p: !P) -> Int
    p.arr[0][bump(!p)] + p.g.items[bump(!p)] + p.g.pair[1][bump(!p) - 1]

  l: List[Int] = List()
  !l.push(1)
  !l.push(2)
  q: List[Int] = List()
  !q.push(3)
  p = P(arr: [[1, 2], [3, 4]], g: G(items: <l, pair: [List(), <q]))
  print(p.arr[0][bump(!p)], p.g.items[bump(!p)], p.g.pair[1][bump(!p) - 1])
  print(inner(!p))

test "rev220-slice-root", "1"
