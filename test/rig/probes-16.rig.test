fail "rev255-a05 nested generic keeps", "cannot drop `n` while it is lent"
  obj Inner[W]
    w: (?W)?

  obj Outer[V]
    i: Inner[V]

  sub put(o: !Outer[String], x: ?String) keeps x
    o.i.w = x

