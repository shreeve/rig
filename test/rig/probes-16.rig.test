  fun keep(k: ?Int, r: !Res) -> Bool
    print("f", k)
    k % 2 == 0

  m = Map[Int, Res].new()
  for i in 0..4
    !m.put(i, Res(n: i))
  !m.retain(|k, r| keep(k, !r))
  print("after", m.len)

