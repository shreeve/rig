        1

    pub obj Lim
      n: Int = Int.max
      pub ?s: String = String()

fail "rev227-ro-while", "cannot lend `t.last` to write: field `last` of `lib.Tally` is read-only outside module `lib`, which declares it `pub ?last`"
  # A while header that lends a read-only field to write is rejected.

  use lib

  sub main()
    t = lib.Tally()
    !t.bump(3)
    while !t.last as l
      l = 2
      break
    print(t.tags, t.inner.n, t.shape, t.last)

  file "lib.rig"
    pub obj Inner
      pub n: Int = 0
      pub sub inc(!@)
        @n += 1

    pub enum Shape
      dot
      rect(w: Int, h: Int)

    pub obj Tally
      pub ?tags: List[Int] = List()
      pub ?inner: Inner = Inner()
      pub ?shape: Shape = .dot
      pub ?last: Int? = none

      pub sub bump(!@, tag: Int)
        !@tags.push(tag)
        @shape = Shape.rect(w: tag, h: tag)
        @last = tag

    pub obj Pile[T]
      pub ?n: Int = 0

fail "rev228-taken-capture", "cannot move captured `s`: the closure keeps what it captures for every call; write `+s` for another weak handle"
  obj S
