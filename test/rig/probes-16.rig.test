fail "rev255-m01", "cannot drop `n` while it is lent"
  # oracle: main reject C4
  use b

  sub main()
    n = String("4")
    bag = b.Bag[String](last: none)
    !bag.put(?n)
    <n
    print(bag.last)

  file "b.rig"
    pub obj Bag[T: Print]
      pub last: (?T)?

      pub sub put(!@, x: ?T) keeps x
        @last = x

      pub sub peek(!@, x: ?T)
        print(x)

    pub sub push_into[T](out: !List[?T], x: ?T) keeps x
      !out.push(x)

    pub sub look[T](out: !List[?T], x: ?T)
      print(out.len)

    pub obj W
      pub src: ?String

      pub sub watch(!@, a: ?String, s: ?String) keeps s
        @src = s

fail "rev255-m03", "cannot drop `n` while it is lent"
  use b

  sub main()
    n = String("4")
    out: List[?String] = List()
    b.push_into(!out, ?n)
    <n
    print(out[0])

  file "b.rig"
    pub sub push_into[T](out: !List[?T], x: ?T) keeps x
      !out.push(x)

