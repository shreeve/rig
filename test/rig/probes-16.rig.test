test "rev240-m01 drop counting", "true true true 0"
  # Every value made is dropped exactly once through put_new, ensure,
  # ensure_with, retain, take, put, and clear, on small and large Maps.

  obj Res
    n: Int
    live: *Cell[Int]

    drop(!@)
      !@live.set(@live.get() - 1)

  fun mk(n: Int, live: ?*Cell[Int]) -> Res
    c = +live
    !c.set(c.get() + 1)
    Res(n: n, live: <c)

  obj Rand
    s: U64

    fun next(!@, n: Int) -> Int
      @s = @s *% 6364136223846793005 +% 1442695040888963407
      Int((@s >> 33) % U64(n))

  fun run(seed: U64, span: Int, steps: Int, live: ?*Cell[Int]) -> Int
    r = Rand(s: seed)
    m = Map[String, Res].new()
    for step in 0..steps
      op = (!r).next(12)
      k = String("k", (!r).next(span))
      if op < 3
        _ = (!m).put_new(<k, mk(step, live))
      else if op < 5
        c = (!m).ensure(<k, mk(step, live))
        c.n += 1
      else if op < 7
        c = (!m).ensure_with(<k, |?live, kk| mk(kk.len, live))
        c.n += 1
      else if op < 9
        t = (!m).take(k)
        <t
      else if op < 10
        !m.put(<k, mk(step, live))
      else if op < 11
        !m.retain(|kk, v| bumpkeep(kk, !v))
      else if (!r).next(20) == 0
        !m.clear()
    n = 0
    for e in ?m.items()
      n += e.value.n
    n

  fun bumpkeep(k: ?String, v: !Res) -> Bool
    v.n += 1
    (v.n + k.len) % 3 != 0

  live = *Cell(0)
  a = run(1, 5, 500, ?live)
  b = run(2, 40, 3000, ?live)
  c = run(3, 300, 6000, ?live)
  print(a > 0, b > 0, c > 0, live.get())

test "rev240-m02 string model", '''
  -1 -1 -1 -1 -1
  -1 -1 -1
'''
  # Map[String, List[Int]] and Set[String] against a List-of-pairs model,
  # through put_new, ensure, ensure_with, retain (writing values), take,
  # put, reserve, and clear; checks len, get, has, and walk order each step.

  obj Pair
    key: String
    value: List[Int]
    live: Bool

  obj Model
    pairs: List[Pair] = List()
    len: Int = 0

    fun find(?@, k: ?String) -> Int?
      for p, i in ?@pairs
        return i if p.live and p.key == k
      none

    sub add(!@, k: ?String, v: Int)
      !@pairs.push(Pair(key: String(k), value: one(v), live: true))
      @len += 1

  fun one(n: Int) -> List[Int]
    l = List[Int]()
    !l.push(n)
    l

  obj Rand
    s: U64

    fun next(!@, n: Int) -> Int
      @s = @s *% 6364136223846793005 +% 1442695040888963407
      Int((@s >> 33) % U64(n))

  fun keep(k: ?String, v: !List[Int]) -> Bool
    !v.push(k.len)
    (v[0] + v.len) % 3 != 0

  fun same(a: ?List[Int], b: ?List[Int]) -> Bool
    return false if a.len != b.len
    for x, i in a
      return false if x != b[i]
    true

  fun agree(m: ?Map[String, List[Int]], ref: ?Model, span: Int) -> Bool
    return false if m.len != ref.len
    for x in 0..span
      k = String("key", x)
      got = m.get(k)
      if ref.find(k) as i
        if got as g
          return false if not same(g, ref.pairs[i].value)
        else
          return false
      else
        return false if got != none or m.has(k)
    i = 0
    for e in ?m.items()
      while i < ref.pairs.len and not ref.pairs[i].live
        i += 1
      return false if i >= ref.pairs.len or ref.pairs[i].key != e.key
      i += 1
    while i < ref.pairs.len and not ref.pairs[i].live
      i += 1
    i == ref.pairs.len

  fun run(seed: U64, span: Int, steps: Int, reserve: Int) -> Int
    r = Rand(s: seed)
    m = Map[String, List[Int]].new(capacity: reserve)
    ref = Model()
    for step in 0..steps
      op = (!r).next(20)
      k = String("key", (!r).next(span))
      if op < 4
        isnew = ref.find(k) == none
        !ref.add(k, step) if isnew
        return step if (!m).put_new(<k, one(step)) != isnew
      else if op < 7
        !ref.add(k, step) if ref.find(k) == none
        i = ref.find(k) ?? 0
        !ref.pairs[i].value.push(-1)
        c = (!m).ensure(<k, one(step))
        !c.push(-1)
      else if op < 10
        !ref.add(k, k.len) if ref.find(k) == none
        i = ref.find(k) ?? 0
        !ref.pairs[i].value.push(-2)
        c = (!m).ensure_with(<k, |kk| one(kk.len))
        !c.push(-2)
      else if op < 14
        got = (!m).take(k)
        if ref.find(k) as i
          ref.pairs[i].live = false
          ref.len -= 1
          return step if got == none
        else
          return step if got != none
      else if op < 16
        if ref.find(k) as i
          ref.pairs[i].value = one(step)
        else
          !ref.add(k, step)
        !m.put(<k, one(step))
      else if op < 18
        kept: List[Pair] = List()
        while (!ref.pairs).pop() as p
          !kept.push(<p)
        ref.len = 0
        while (!kept).pop() as p
          new q = <p
          if q.live
            if keep(q.key, !q.value)
              !ref.pairs.push(<q)
              ref.len += 1
        !m.retain(|kk, v| keep(kk, !v))
      else if op < 19
        !m.reserve((!r).next(40))
      else if (!r).next(10) == 0
        !m.clear()
        !ref.pairs.clear()
        ref.len = 0
      return step if not agree(?m, ?ref, span)
    -1

  fun run_set(seed: U64, span: Int, steps: Int) -> Int
    r = Rand(s: seed)
    s = Set[String]()
    ref = Model()
    for step in 0..steps
      op = (!r).next(10)
      k = String("key", (!r).next(span))
      if op < 5
        isnew = ref.find(k) == none
        !ref.add(k, 0) if isnew
        return step if (!s).add(<k) != isnew
      else if op < 7
        got = (!s).take(k)
        if ref.find(k) as i
          ref.pairs[i].live = false
          ref.len -= 1
          return step if got == none
        else
          return step if got != none
      else if op < 8
        !s.retain(|kk| kk.len % 2 == 0)
        for p in !ref.pairs
          if p.live and p.key.len % 2 != 0
            p.live = false
            ref.len -= 1
      else if op < 9
        !s.reserve((!r).next(30))
      return step if s.len != ref.len
      for x in 0..span
        kk = String("key", x)
        return step if s.has(kk) != (ref.find(kk) != none)
      i = 0
      for kk in ?s.items()
        while i < ref.pairs.len and not ref.pairs[i].live
          i += 1
        return step if i >= ref.pairs.len or ref.pairs[i].key != kk
        i += 1
    -1

  print(run(1, 5, 300, 0), run(2, 12, 400, 0), run(3, 60, 400, 0), run(4, 200, 300, 0), run(5, 30, 300, 50))
  print(run_set(6, 5, 300), run_set(7, 14, 400), run_set(8, 200, 300))

test "rev240-m03 value kinds", '''
  6 48 false
  10
  1
  10 62
  beta
  gamma
  alpha gamma
  gamma alpha
  6 ["a", "al", "alph", "alpha", "beta", "alp"]
'''
  # ensure, ensure_with, put_new, and retain with boxed, shared, enum, and
  # view values and keys, crossing the small-map limit.

  obj Node
    name: String
    n: Int

  enum Shape
    dot
    line(len: Int)
    label(text: String)

  fun shape_of(k: ?Int) -> Shape
    if k % 3 == 0
      return Shape.dot
    if k % 3 == 1
      return Shape.line(len: k)
    Shape.label(text: String("L", k))

  fun box_of(k: ?Int) -> ^Node
    ^Node(name: String("n", k), n: k)

  fun weight(s: ?Shape) -> Int
    match s
      .dot => return 1
      .line(len) => return len
      .label(text) => return text.len

  boxes = Map[Int, ^Node].new()
  for i in 0..30
    b = (!boxes).ensure_with(i % 13, box_of)
    b.n += 1
  _ = (!boxes).put_new(1, ^Node(name: String("dup"), n: 0))
  !boxes.retain(|k, b| b.n % 2 == 1)
  t = 0
  for e in ?boxes.items()
    t += e.value.n
  print(boxes.len, t, boxes.get(1) != none)

  shared = Map[String, *Node].new()
  one = *Node(name: String("one"), n: 1)
  for i in 0..20
    _ = (!shared).ensure(String("s", i % 11), +one)
  !shared.retain(|k, s| k.len == 2)
  print(shared.len)
  <shared
  print(one.n)

  shapes = Map[Int, Shape].new()
  for i in 0..25
    _ = (!shapes).ensure_with(i % 17, shape_of)
  !shapes.retain(|k, s| weight(s) > 1)
  w = 0
  for e in ?shapes.items()
    w += weight(e.value)
  print(shapes.len, w)

  a = String("alpha")
  b = String("beta")
  c = String("gamma")
  views = Map[?String, ?String].new()
  x = (!views).ensure(?a, ?b)
  print(x)
  x = ?c
  y = (!views).ensure(?a, ?c)
  print(y)
  _ = (!views).put_new(?c, ?a)
  !views.retain(|k| k.len == 5)
  for e in ?views.items()
    print(e.key, e.value)

  vs = Set[?String]()
  for i in 0..20
    _ = (!vs).add(?a[0..(i % 5) + 1])
  !vs.retain(|k| k.len != 3)
  !vs.reserve(100)
  _ = (!vs).add(?b)
  _ = (!vs).add(?a[0..3])
  out = List[?String]()
  for k in ?vs.items()
    !out.push(k)
  print(vs.len, out)

test "rev240-m05 retain drop interleaving", '''
  f 0
  f 1
  drop 1
  f 2
  f 3
  drop 3
  after 2
  drop 2
  drop 0
'''
  # retain drops each entry f rejects as it goes, before f sees the next.

  obj Res
    n: Int

    drop(!@)
