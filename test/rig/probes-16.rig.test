# Probes from past reviews and audits, 16 of 41: rev210-j02_repoint_field_then_write to review-arm-temps-2-m03_name_target_dropped_in_arm.

use std.text

test "rev210-j02 repoint field then write", '''
  a
  a z
'''
  # Reviewer probe for #210 (field loans): A write view re-pointed after a
  # view of its field ended.

  obj S
    s: String
    k: Int

  obj Node
    name: String
    next: ^Node?

  a = S(s: String("a"), k: 0)
  b = S(s: String("b"), k: 0)
  w = !a
  r = ?w.s
  w.k = 2
  print(r)
  w = !b
  w.s = String("z")
  print(a.s, b.s)

fail "rev210-k03 generic box inst", "cannot assign to `p.a` while `p.a.name` is lent"
  # Reviewer probe for #210 (field loans): Fields through a box in a
  # generic struct instance.

  obj Node
    name: String
    n: Int

  obj Pair[T]
    a: T
    b: T

  p = Pair[^Node](a: ^Node(name: String("a"), n: 0), b: ^Node(name: String("b"), n: 0))
  r = ?p.a.name
  p.a.n = 3
  p.b = ^Node(name: String("c"), n: 0)
  p.a = ^Node(name: String("d"), n: 0)
  print(r)

fail "rev215-a01 ret object view and t", "`mk` returns a view of `x`, but its signature says it views only `c`"
  # A generic result type holding both a view and a T: the T part carries
  # what reached it, but the result type may hold a view, so the generic
  # taint is never counted.
  obj P[T]
    s: ?String
    v: T

  fun mk[T](x: T, c: ?String) -> P[T] from c
    P(s: c, v: x)

  t = String("abc")
  u = String("u")
  p = mk(?t, ?u)
  <t
  print(p.v)

fail "rev215-a04 closure local", "`pick` returns a view of `f`, but its signature says it views only `b`"
  # Review probe (#215): a loan reaching a generic body's T; rejected, or runs sanitizer-clean.
  obj K
    s: ?String

  fun pick[T](f: ?fun(?String) -> T, a: ?String, b: ?String) -> T from b
    g = |?f, ?a| f(a)
    g()

  t = String("abc")
  u = String("u")
  k = pick(|s: ?String| K(s: s), ?t, ?u)
  <t
  print(k.s)

fail "rev215-a12 recursion swap", "`g` returns a view of `xs`, but its signature says it views only `ys`"
  # Review probe (#215): a loan reaching a generic body's T; rejected, or runs sanitizer-clean.
  fun g[T](xs: []T, ys: []T, n: Int) -> T from ys
    if n == 0
      return ys[0]
    g(ys, xs, n - 1)

  t = String("abc")
  u = String("u")
  a = [?t]
  b = [?u]
  r = g(?a[..], ?b[..], 1)
  <t
  print(r)

fail "rev215-a13 method box", "`pick` returns a view of `@`, but its signature says it views only `other`"
  # Review probe (#215): a loan reaching a generic body's T; rejected, or runs sanitizer-clean.
  obj Box[T]
    v: T

    fun pick(?@, other: ?Box[T]) -> T from other
      @v

  t = String("abc")
  u = String("u")
  b1 = Box(v: ?t)
  b2 = Box(v: ?u)
  r = b1.pick(?b2)
  <b1
  <t
  print(r)

fail "rev215-a14 match", "`g` returns a view of `o`, but its signature says it views only `d`"
  # Review probe (#215): a loan reaching a generic body's T; rejected, or runs sanitizer-clean.
  enum Opt[T]
    some(value: T)
    nothing

  fun g[T](o: ?Opt[T], d: T) -> T from d
    match o
      .some(v) => v
      .nothing => d

  t = String("abc")
  u = String("u")
  o = Opt[?String].some(?t)
  r = g(?o, ?u)
  <o
  <t
  print(r)

fail "rev215-a19 match object payload", "`g` returns a view of `o`, but its signature says it views only `d`"
  # The payload binding of a match on a read view, in a body returning T.
  obj K
    s: ?String

  enum Opt[T]
    some(value: T)
    nothing

  fun g[T](o: ?Opt[T], d: T) -> T from d
    match o
      .some(v)
        w = v
        w
      .nothing => d

  t = String("abc")
  u = String("u")
  o = Opt[K].some(K(s: ?t))
  r = g(?o, K(s: ?u))
  <o
  <t
  print(r.s)

fail "rev215-a23 ret object K", "`mk` returns a view of `x`, but its signature says it views only `c`"
  # a01 with T an object holding a view.
  obj K
    s: ?String

  obj P[T]
    s: ?String
    v: T

  fun mk[T](x: T, c: ?String) -> P[T] from c
    P(s: c, v: x)

  t = String("abc")
  u = String("u")
  p = mk(K(s: ?t), ?u)
  <t
  print(p.v.s)

fail "rev220-cell-set", "cannot lend `@` to write in an index of `@c`, a place being lent"
  obj K
    c: Cell[List[Int]]

    fun get(!@) -> Int
      @c[reset(!@)]

  fun reset(k: !K) -> Int
    n: List[Int] = List()
    for i in 0..100
      !n.push(i + 50)
    !k.c.set(<n)
    0

  k = *K(c: Cell(List()))
  !k.c.push(7)
  print((!k).get())
  cc: *Cell[List[Int]] = *Cell(List())
  !cc.push(1)
  print(cc[reset2(!cc)])

  fun reset2(c: !Cell[List[Int]]) -> Int
    n: List[Int] = List()
    !n.push(42)
    !c.set(<n)
    0

