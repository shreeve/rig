test "review-arm-temps-2-m01 name target moved in arm", '''
  sink 0
  drop 0
  s 10
  drop 10
  drop 1
  s 5
  drop 5
'''
  # `s = match k` whose arm moves `s`: the store must not drop the moved value.
  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  fun sink(d: D) -> D
    print("sink", d.n)
    D(n: d.n + 10)

  sub run(k: Int)
    s = D(n: k)
    s = match k
      0 => sink(<s)
      _ => D(n: 5)
    print("s", s.n)

  run(0)
  run(1)

test "review-arm-temps-2-m02 field target moved in arm", '''
  sink 0
  drop 0
  o 10
  drop 10
  drop 1
  o 5
  drop 5
'''
  # `o.d = match k` whose arm moves `o.d` out: a conditional partial move,
  # then the store reinitializes it, dropping the old value only where it
  # is still held.
  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  obj O
    d: D

  fun sink(d: D) -> D
    print("sink", d.n)
    D(n: d.n + 10)

  sub run(k: Int)
    o = O(d: D(n: k))
    o.d = match k
      0 => sink(<o.d)
      _ => D(n: 5)
    print("o", o.d.n)

  run(0)
  run(1)

test "review-arm-temps-2-m03 name target dropped in arm", '''
  drop 0
  s 20
  drop 20
  drop 1
  s 5
  drop 5
'''
  # `s = match k` whose block arm drops `s` now: the store must not drop it again.
  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  sub run(k: Int)
    s = D(n: k)
    s = match k
      0
        <s
        D(n: 20)
      _ => D(n: 5)
    print("s", s.n)

  run(0)
  run(1)
