test "rev236-fuzz", "true true"
  obj Pair
    key: String
    value: String
    live: Bool

  obj Model
    pairs: List[Pair] = List()
    len: Int = 0

    fun find(?@, k: ?String) -> Int?
      for p, i in ?@pairs
        return i if p.live and p.key == k
      none

  obj Rand
    s: U64

    fun next(!@, n: Int) -> Int
      @s = @s *% 6364136223846793005 +% 1442695040888963407
      Int((@s >> 33) % U64(n))

  fun mk(k: Int) -> String
    String("k", k, "-long-enough-to-allocate-on-heap")

  sub addone(k: ?String, v: !String)
    !v.add("+")

  fun agree(m: ?Map[String, String], ref: ?Model, span: Int) -> Bool
    return false if m.len != ref.len
    for x in 0..span
      k = mk(x)
      if ref.find(?k) as i
        if m.get(?k) as v
          return false if v != ref.pairs[i].value
        else
          return false
      else
        return false if m.has(?k)
    i = 0
    for e in ?m.items()
      while i < ref.pairs.len and not ref.pairs[i].live
        i += 1
      return false if i >= ref.pairs.len
      return false if ref.pairs[i].key != e.key or ref.pairs[i].value != e.value
      i += 1
    while i < ref.pairs.len and not ref.pairs[i].live
      i += 1
    i == ref.pairs.len

  fun run(seed: U64, span: Int, steps: Int) -> Bool
    r = Rand(s: seed)
    m = Map[String, String].new(capacity: (!r).next(20))
    ref = Model()
    for step in 0..steps
      op = (!r).next(20)
      x = (!r).next(span)
      if op < 8
        v = String("v", step)
        found = ref.find(?mk(x))
        old = (!m).replace(mk(x), +v)
        if found as i
          if old as o
            return false if o != ref.pairs[i].value
          else
            return false
          ref.pairs[i].value = <v
        else
          return false if old != none
          !ref.pairs.push(Pair(key: mk(x), value: <v, live: true))
          ref.len += 1
      else if op < 15
        got = (!m).take(?mk(x))
        if ref.find(?mk(x)) as i
          if got as g
            return false if g != ref.pairs[i].value
          else
            return false
          ref.pairs[i].live = false
          ref.len -= 1
        else
          return false if got != none
      else if op < 16
        !m.reserve((!r).next(30))
      else if op < 17
        !m.update(addone)
        for p in !ref.pairs
          !p.value.add("+") if p.live
      else if op < 18
        if (!m).edit(?mk(x)) as v
          !v.add("e")
          if ref.find(?mk(x)) as i
            !ref.pairs[i].value.add("e")
          else
            return false
      else if (!r).next(30) == 0
        !m.clear()
        !ref.pairs.clear()
        ref.len = 0
      if not agree(?m, ?ref, span)
        print("disagree at", step)
        return false
    true

  ok = true
  for seed in 1..9
    span = 3 + Int(seed % 25)
    if not run(U64(seed), span, 300)
      print("fail", seed)
      ok = false
  print(run(99, 200, 800), ok)

test "rev236-sfuzz", "true true"
  obj Rand
    s: U64

    fun next(!@, n: Int) -> Int
      @s = @s *% 6364136223846793005 +% 1442695040888963407
      Int((@s >> 33) % U64(n))

  fun mk(k: Int) -> String
    String("k", k, "-long-enough-to-allocate-on-heap")

  fun run(seed: U64, span: Int, steps: Int) -> Bool
    r = Rand(s: seed)
    s = Set[String].new(capacity: (!r).next(20))
    ref: List[String] = List()
    for _ in 0..steps
      op = (!r).next(20)
      x = (!r).next(span)
      k = mk(x)
      at: Int? = none
      for e, i in ?ref
        at = i if e == k
      if op < 9
        added = (!s).add(+k)
        return false if added != (at == none)
        !ref.push(<k) if at == none
      else if op < 17
        got = (!s).take(?k)
        if at as i
          if got as g
            return false if g != k
          else
            return false
          _ = (!ref).remove(i)
        else
          return false if got != none
      else if op < 18
        !s.reserve((!r).next(30))
      else if (!r).next(20) == 0
        !s.clear()
        !ref.clear()
      return false if s.len != ref.len
      i = 0
      for e in ?s.items()
        return false if i >= ref.len or ref[i] != e
        i += 1
      return false if i != ref.len
      for y in 0..span
        kk = mk(y)
        inref = false
        for e in ?ref
          inref = true if e == kk
        return false if s.has(?kk) != inref
    true

  ok = true
  for seed in 1..9
    if not run(U64(seed), 3 + Int(seed % 25), 300)
      print("fail", seed)
      ok = false
  print(run(77, 200, 800), ok)

test "rev236-sym", '''
  0 1 2
  503 0
  9 8 0 q8
'''
  n = text.Interner()
  print((!n).intern("a"), (!n).intern("b"), (!n).intern("c"))
  !n.reserve(100, bytes: 400)
  bad = 0
  for i in 0..500
    t = String("s", i)
    id = (!n).intern(?t)
    bad += 1 if id != U32(i + 3)
  for i in 0..500
    t = String("s", i)
    bad += 1 if n.id(?t) != U32(i + 3)
    bad += 1 if n.text(U32(i + 3)) != t
  bad += 1 if n.id("a") != U32(0) or n.id("c") != U32(2) or n.id("zz") != none
  !n.reserve(5000)
  for i in 0..500
    t = String("s", i)
    bad += 1 if (!n).intern(?t) != U32(i + 3)
  print(n.len, bad)
  e = text.Interner()
  for i in 0..9
    _ = (!e).intern(String("q", i))
  print(e.len, e.id("q8"), e.id("q0"), e.text(8))

