fail "partial closures and defers", "18:15: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "22:24: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 2
  # 10. Deferred code reads a field still held; a closure called once moves
  # a field of what it moved in.
  # oracle: deferred_other accept
  # oracle: once_closure accept
  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  fun run(f: once ?fun() -> Int) -> Int
    f()

  sub deferred_other()
    p = P(a: String("a"), b: String("b"))
    defer print("deferred", p.b)
    print(keep(<p.a))

  sub once_closure()
    p = P(a: String("aa"), b: String("b"))
    print(run(|<p| keep(<p.a) + p.b.len))

  sub main()
    deferred_other()
    once_closure()

fail "partial closures and defers reject", "16:18: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "21:21: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "27:15: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 3
  # 10. A closure that may run again moves no field of what it captured,
  # deferred code moves none, and deferred code reads no field moved out
  # before it runs.
  # oracle: stack_closure reject B3
  # oracle: defer_moves reject B2
  # oracle: defer_reads reject C1
  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  sub stack_closure()
    p = P(a: String("a"), b: String("b"))
    f = |<p| keep(<p.a)
    print(f())

  sub defer_moves()
    p = P(a: String("a"), b: String("b"))
    defer print(keep(<p.a))
    print(p.b)

  sub defer_reads()
    p = P(a: String("a"), b: String("b"))
    defer print(p.a)
    print(keep(<p.a))

  sub main()
    stack_closure()

test "partial optional field takes", '''
  o R(o: none, s: "s")
  gone
'''
  # 11. An optional field keeps today's take, which leaves `none`: the
  # object stays whole.
  # oracle: taken accept
  obj R
    o: String?
    s: String

  sub taken()
    p = R(o: String("o"), s: String("s"))
    x = <p.o
    print(x, p)
    if p.o as y
      print(y)
    else
      print("gone")

  sub main()
    taken()

fail "partial generic and task", "17:4: cannot move out of `p.x`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.x, v)`", "25:13: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 2
  # 12. A generic `T` field moves; a field moves into a task as into any
  # call.
  # oracle: first accept
  # oracle: generic accept
  obj Two[T]
    x: T
    y: T

  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  fun first[T](p: Two[T]) -> T
    <p.x

  sub generic()
    print(first(Two(x: String("a"), y: String("b"))))
    print(first(Two(x: 1, y: 2)))

  sub task()
    p = P(a: String("aa"), b: String("b"))
    t = keep(<p.a)&
    print(>t, p.b)

  sub main()
    generic()
    task()

fail "partial per path flow", "15:4: cannot move out of `p.b`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.b, v)`", "21:17: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "27:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 3
  # 13. Moves are tracked per path to a fixpoint: a loop that moves a field
  # and assigns it again, and a parameter's other fields, used and
  # returned.
  # oracle: value_of accept
  # oracle: loop_refill accept
  # oracle: param_rest accept
  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  fun value_of(p: P) -> String
    <p.b

  sub loop_refill(n: Int)
    p = P(a: String("a"), b: String("b"))
    i = 0
    while i < n
      print(keep(<p.a))
      p.a = String("again")
      i += 1
    print(p)

  sub param_rest(p: P)
    x = <p.a
    print(x, p.b)

  sub main()
    loop_refill(3)
    param_rest(P(a: String("a"), b: String("b")))
    print(value_of(P(a: String("a"), b: String("b"))))

