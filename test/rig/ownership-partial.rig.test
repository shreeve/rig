  # 6. A field whose own type has a `drop` body moves whole.
  # oracle: File.drop accept
  # oracle: whole_field accept
  obj File
    name: String

    drop(!@)
      print("close", @name)

  obj Holder
    f: File
    t: String

  sub whole_field()
    h = Holder(f: File(name: String("f")), t: String("t"))
    f = <h.f
    print(f.name, h.t)

  sub main()
    whole_field()

