  # 2. Assigned again on one path only, the field is still moved out on the
  # other, so a use of all of `p` is rejected.
  # oracle: refill_one reject C1
  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  sub refill_one(c: Bool)
    p = P(a: String("aa"), b: String("bbb"))
    print(keep(<p.a))
    if c
      p.a = String("new")
    print(p)

  sub main()
    refill_one(true)

fail "partial whole assignment", "14:13: cannot move out of `p.b`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.b, v)`", "14:22: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "20:17: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 3
  # 3. `p = x` drops the old value field by field, only what it still holds;
  # its value may take `p`'s own fields.
  # oracle: swapped accept
  # oracle: replaced accept
  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  sub swapped()
    p = P(a: String("a"), b: String("b"))
    p = P(a: <p.b, b: <p.a)
    print(p.a, p.b)

  sub replaced(c: Bool)
    p = P(a: String("aa"), b: String("bbb"))
    if c
      print(keep(<p.a))
    p = P(a: String("x"), b: String("y"))
    print(p)

  sub main()
    swapped()
    replaced(true)
    replaced(false)

fail "partial whole uses reject", "39:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "44:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "49:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "55:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "60:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "65:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "71:15: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "76:15: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "81:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "87:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "94:15: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "98:15: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 12
  # 4. No use touches all of a partly moved name but `p = x`: printing,
  # lending, a method, moving, cloning, returning, a last value, `swap` of
  # the hole, a capture, deferred code, and a drop.
  # oracle: P.size accept
  # oracle: P.touch accept
  # oracle: printed reject C1
  # oracle: lent_read reject C1
  # oracle: lent_write reject C1
  # oracle: read_method reject C1
  # oracle: moved_whole reject C1
  # oracle: cloned reject C1
  # oracle: returned reject C1
  # oracle: last_value reject C1
  # oracle: swapped_hole reject C1
  # oracle: captured reject C1
  # oracle: deferred reject C1
  # oracle: dropped reject C1
  obj P
    a: String
    b: String

    fun size(?@) -> Int
      @a.len + @b.len

    sub touch(!@)
      @b = String("t")

  fun keep(s: String) -> Int
    s.len

  fun look(p: ?P) -> Int
    p.a.len

  fun own(p: P) -> Int
    p.b.len

  sub printed()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    print(p, x)

  sub lent_read()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    print(look(?p), x)

  sub lent_write()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    !p.touch()
    print(x)

  sub read_method()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    print(p.size(), x)

  sub moved_whole()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    print(own(<p), x)

  sub cloned()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    q = +p
    print(q, x)

  fun returned() -> P
    p = P(a: String("a"), b: String("b"))
    print(keep(<p.a))
    return p

  fun last_value() -> P
    p = P(a: String("a"), b: String("b"))
    print(keep(<p.a))
    p

  sub swapped_hole()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    y = swap(!p.a, String("c"))
    print(x, y)

  sub captured()
    p = P(a: String("a"), b: String("b"))
    x = <p.a
    f = |?p| p.b.len
    print(f(), x)

  sub deferred()
    p = P(a: String("a"), b: String("b"))
    defer print(p)
    print(keep(<p.a))

  sub dropped()
    p = P(a: String("a"), b: String("b"))
    print(keep(<p.a))
    <p

  sub main()
    printed()

fail "partial nested paths", "16:8: cannot move out of `p.a.b`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a.b, v)`", "23:8: cannot move out of `p.a.b`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a.b, v)`", "29:8: cannot move out of `p.a.b`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a.b, v)`", "30:8: cannot move out of `p.d`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.d, v)`", errors: 4
  # 5. `<p.a.b` leaves `p.a` and `p` partly moved; `p.a.c` and `p.d` stay
  # usable, and `p.a = x` drops only what `p.a` still holds.
  # oracle: nested accept
  # oracle: nested_refill accept
  # oracle: nested_left accept
  obj In
    b: String
    c: String

  obj Out
    a: In
    d: String

  sub nested()
    p = Out(a: In(b: String("b"), c: String("c")), d: String("d"))
    x = <p.a.b
    print(x, p.a.c, p.d)
    p.a = In(b: String("B"), c: String("C"))
    print(p)

  sub nested_refill()
    p = Out(a: In(b: String("b"), c: String("c")), d: String("d"))
    x = <p.a.b
    p.a.b = String("bb")
    print(x, p)

  sub nested_left()
    p = Out(a: In(b: String("b"), c: String("c")), d: String("d"))
    x = <p.a.b
    y = <p.d
    print(x, y, p.a.c)

  sub main()
    nested()
    nested_refill()
    nested_left()

fail "partial nested paths reject", "15:8: cannot move out of `p.a.b`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a.b, v)`", "20:8: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 2
  # 5. `p.a` is not used while `p.a.b` is moved out, and nothing is written
  # below a hole.
  # oracle: parent_read reject C1
  # oracle: below_hole reject C1
  obj In
    b: String
    c: String

  obj Out
    a: In
    d: String

  sub parent_read()
    p = Out(a: In(b: String("b"), c: String("c")), d: String("d"))
    x = <p.a.b
    print(p.a, x)

  sub below_hole()
    p = Out(a: In(b: String("b"), c: String("c")), d: String("d"))
    x = <p.a
    p.a.b = String("x")
    print(x)

  sub main()
    parent_read()

