# ownership: tests whose names start `partial`: a field of an owned
# object moves like a name (Core §5). One case for each hole the
# adversarial review found (docs/history/records/2026-10/partial-moves/),
# with the reference checker's verdicts.

fail "partial branches and exits", "29:17: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "34:13: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "40:13: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "47:19: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 4
  # 1. A field moved on one branch, before a `!`, inside a value a `!` leaves
  # unfinished, or before a `break`: each moved path has its own drop flag,
  # so every exit drops only what the local still holds.
  # oracle: branch accept
  # oracle: exits accept
  # oracle: made accept
  # oracle: breaks accept
  obj P
    a: String
    b: String

  obj Q
    a: String
    n: Int

  error E
    bad

  fun f(n: Int) -> Int!E
    return E.bad if n < 0
    n

  fun keep(s: String) -> Int
    s.len

  sub branch(c: Bool)
    p = P(a: String("aa"), b: String("bbb"))
    if c
      print(keep(<p.a))
    print(p.b)

  fun exits(n: Int) -> Int!E
    p = P(a: String("aa"), b: String("bbb"))
    x = keep(<p.a)
    y = f(n)!
    x + y + p.b.len

  fun made(n: Int) -> Int!E
    p = P(a: String("aa"), b: String("b"))
    q = Q(a: <p.a, n: f(n)!)
    q.a.len + q.n + p.b.len

  sub breaks()
    for i in 0..3
      p = P(a: String("aa"), b: String("bbb"))
      if i == 1
        print(keep(<p.a))
        break
      print(p.a, i)

  sub main()
    branch(true)
    branch(false)
    print(exits(1) catch -1)
    print(exits(-1) catch -1)
    print(made(1) catch -1, made(-1) catch -1)
    breaks()

fail "partial branches and exits reject", "15:17: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "21:17: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 2
  # 1. A field moved on some path is used only once assigned again: after a
  # branch that may move it, and in a loop's next turn.
  # oracle: branch_use reject C1
  # oracle: loop_twice reject C1
  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  sub branch_use(c: Bool)
    p = P(a: String("aa"), b: String("bbb"))
    if c
      print(keep(<p.a))
    print(p.a)

  sub loop_twice()
    p = P(a: String("aa"), b: String("bbb"))
    for _ in 0..2
      print(keep(<p.a))

  sub main()
    branch_use(true)
    loop_twice()

fail "partial assigned again", "15:17: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", "22:17: cannot move out of `p.a`: `p` would still drop it (partial moves are not supported); move `p` whole, or exchange the field: `old = swap(!p.a, v)`", errors: 2
  # 2. `p.a = x` after a move that may have run drops the old value only if
  # it is still held, then holds the new one.
  # oracle: refill accept
  # oracle: refill_each accept
  obj P
    a: String
    b: String

  fun keep(s: String) -> Int
    s.len

  sub refill(c: Bool)
    p = P(a: String("aa"), b: String("bbb"))
    if c
      print(keep(<p.a))
    p.a = String("new")
    print(p.a, p.b)

  sub refill_each()
    p = P(a: String("aa"), b: String("bbb"))
    for i in 0..3
      print(keep(<p.a), i)
      p.a = String("again")
    print(p)

  sub main()
    refill(true)
    refill(false)
    refill_each()

