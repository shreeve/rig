# types: tests whose names start `optional`.

test "optional compared with value", "true true true false true true"
  # `T?` compares with a `T`: equal when it holds that value.

  enum E
    a
    b

  a: Int? = 5
  u: U8? = none
  k = 5
  e: E? = E.b
  print(a == 5, a != 6, 5 == a, u == 3, a == k, e == E.b)

test "optional equality", '''
  true true true false
  true false false false true
  true true false true true
'''
  # `==` and `!=` compare optionals of equatable types: two present values
  # compare as the values do (Strings by contents), and `none` equals only
  # `none`.

  enum Color
    red
    green

  fun find(key: Int) -> (?String)?
    if key == 1
      return "one"
    none

  fun pick(n: Int) -> Color?
    if n == 1
      return .green
    none

  fun num(n: Int) -> Int?
    if n == 1
      return 5
    none

  a = find(1)
  b = find(2)
  s = "one"
  print(a == "one", a == s, a != "two", a == none)
  print(b == none, b != none, b == "one", a == b, b == find(3))
  print(pick(1) == .green, pick(2) == none, pick(1) == pick(2), num(1) == 5, num(2) == num(3))

test "optional error compare", '''
  true
  false
  true
  true
  false
  true
'''
  # An optional error compares with an error, a contextual `.name`,
  # `none`, and another optional error.

  error E
    bad
    worse

  e: E? = E.bad
  n: E? = none
  print(e == E.bad)
  print(e == .worse)
  print(e != none)
  print(n == none)
  print(e == n)
  print(n != E.bad)

test "optional fallback from context", "0 3 4 7"
  # Where an optional is expected, the fallback of `??` or `catch` may be
  # `none` or another optional.

  error Bad
    nope

  fun g(ok: Bool) -> Int!
    if ok
      3
    else
      return Bad.nope

  fun pick(a: Int?, b: Int?) -> Int?
    a ?? b

  x: Int? = g(false) catch none
  y: Int? = g(true) catch none
  a: Int? = none
  b: Int? = 4
  c: Int? = a ?? b
  print(x ?? 0, y ?? 0, c ?? 1, pick(none, 7) ?? 0)

test "optional from value", "3"
  # A plain value is lifted where an optional is expected: `y: Int? = 3`.
  # `??` yields the value inside, or the fallback when it is `none`.

  y: Int? = 3
  print(y ?? 7)

fail "optional function field call", "8:9: field `f` holds an optional function, `(fun(Int) -> Int)?`: take the function out first, `if h.f as g`, then call `g(...)`"
  # A field holding an optional function is not called directly: the
  # function is taken out of the optional first.

  obj Hooks
    f: (fun(Int) -> Int)? = none

  h = Hooks()
  print(h.f(1))

test "optional handle binding", '''
  false true true
  -1 1 1
  3 3 0 none
  true true
  true true true
'''
  # `*` and `~` bind to the type they touch, tighter than a suffix: `*Node?`
  # is an optional handle. A view covers the whole type after it:
  # `?*Node?` views an optional handle, `!Int?` an optional Int. A slice's
  # element takes the suffix (`[]Int?`); an optional slice is `([]Int)?`.
  # A type argument in an expression reads the same way: `Cell[*Node?]` and
  # `Cell[*(Node)?]` hold optional handles. A handle to an optional,
  # `*(Node?)`, is named there with a `type` alias.

  obj Node
    value: Int

  type Held = *(Node?)

  fun present(h: ?*Node?) -> Bool
    h != none

  fun take(h: *Node?) -> Int
    if <h as n
      return n.value
    -1

  fun first(xs: []Int?) -> Int
    xs[1] ?? 0

  fun size(xs: ([]Int)?) -> Int
    if xs as s
      return s.len
    0

  sub clear(x: !Int?)
    x = none

  a: *Node? = none
  b: *Node? = *Node(value: 1)
  w: ~Node? = none
  cell = *Cell[*Node?](none)
  !cell.set(+b)
  print(present(?a), present(?b), w == none)
  print(take(<a), take(<b), take((!cell).swap(none)))
  xs: [2]Int? = [none, 3]
  ys = [1, 2, 3]
  n: Int? = 4
  clear(!n)
  print(first(?xs[0..2]), size(?ys[0..3]), size(none), n)
  p = *Cell[*(Node)?](none)
  q = *Cell[~Node?](none)
  m: Node? = Node(value: 2)
  held = *Cell[Held](*m)
  old = (!held).swap(*none)
  <old
  print((!p).swap(none) == none, (!q).swap(none) == none)
  nd = *Node(value: 3)
  sw: *Cell[~Node?] = *Cell[~Node?](~nd)
  ws: *Cell[~*Node?] = *Cell[~*Node?](none)
  sp: *Cell[(~Node)?] = *Cell[(~Node)?](none)
  print((!sw).swap(none) != none, (!ws).swap(none) == none, (!sp).swap(none) == none)

test "optional handle none", '''
  true
  true
  true
  2 true
  true
  true
'''
  # An optional handle with no value is `none`, in every position where
  # a `(*T)?` is expected, and a box of an optional holds `none` as any
  # other value. (`*none` is rejected: test/reject/types/share_of_none.rig.)

  obj S
    h: (*Int)?

  sub f(h: (*Int)?)
    print(h == none)

  fun g() -> (*Int)?
    none

  fun empty(o: ?(Int?)) -> Bool
    o == none

  b: (*Int)? = none
  print(b == none)
  f(none)
  s = S(h: none)
  print(s.h == none)
  w: List[(*Int)?] = List()
  !w.push(none)
  !w.push(*5)
  print(w.len, w[0] == none)
  print(g() == none)
  x: ^(Int?) = ^none
  print(empty(?x))

test "optional holds read view", '''
  1 7
  true
  2 2
  true
'''
  # An optional holds a read view of an owner, and keeps the owner lent
  # while it is used.

  fun find(v: ?List[List[Int]], want: Int) -> (?List[Int])?
    for i in 0..v.len
      if v[i].len == want
        return ?v[i]
    none

  v: List[Int] = List()
  !v.push(7)
  o: (?List[Int])? = ?v
  if o as w
    print(w.len, w[0])
  n: (?List[Int])? = none
  print(n == none)
  rows: List[List[Int]] = List()
  !rows.push(List())
  inner: List[Int] = List()
  !inner.push(1)
  !inner.push(2)
  !rows.push(<inner)
  if find(?rows, 2) as hit
    print(hit.len, hit[1])
  none_hit = find(?rows, 9)
  print(none_hit == none)

fail "optional member without unwrap", "8:5: cannot access `name` on optional `User?`; take the value out first with `x ?? fallback`"
  # Field access on an optional (`u.name` with `u: User?`) requires
  # unwrapping it first.

  obj User
    name: ?String

  fun name_of(u: User?) -> ?String
    u.name

  print("unused")

fail "optional method without unwrap", "cannot call `get` on optional `U?`"
  # Methods are not reachable through an optional.

  obj U
    n: Int

    fun get(?@) -> Int
      @n

  fun f(u: U?) -> Int
    u.get()

  print(1)

test "optional none literal", "7"
  # `none` is the absent optional.

  x: Int? = none
  print(x ?? 7)

test "optional return", '''
  3
  0
  true
  false
'''
  # A `-> T?` function returns either a `T` (lifted) or `none`; `??`
  # supplies a fallback and `== none` tests for absence.

  fun positive(n: Int) -> Int?
    if n > 0
      n
    else
      none

  print(positive(3) ?? 0)
  print(positive(-1) ?? 0)
  m: Int? = none
  print(m == none)
  print(positive(5) == none)

fail "optional slice size", "4:14: `[600000](?String)?` takes 9600000 bytes", "5:14: `[600000]([]Int)?` takes 9600000 bytes"
  # An optional String or slice takes no more room than the String or
  # slice: its absence is a null address.

  type Names = [600000](?String)?
  type Views = [600000]([]Int)?

  print(1)

test "optional text eq", '''
  true false false true
  true false false true
  true false
  true false true
  true false
'''
  # An optional of text compares with text of any type by its bytes, as
  # two texts do: a `String?` beside a `?String`, a `Static`, or a String,
  # and a `?String?` beside a String, or a boxed String beside a
  # `String?`. `none` equals no text.

  o: String? = String("a")
  n: String? = none
  t = String("a")
  u = String("b")
  print(o == ?t, o == ?u, n == ?t, o != ?u)
  print(o == "a", o == "b", n == "a", "a" == o)
  print(o == t, ?u == o)
  v: (?String)? = ?t
  print(v == t, v == u, v == "a")
  bx = ^String("a")
  print(o == bx, n == bx)

code "optional niche layout", "a: rig.Opt(rig.Opt(Flagged)) =", "rig.List(rig.Opt(Cheese))", "f: rig.Opt(Flagged),", "[3]rig.Opt(Flagged)"
  # An object's optional, an optional of one, and one in a List, an
  # array, or a field are written `rig.Opt`, which holds `none` in the
  # object's niche where it has one.
  obj Cheese
    name: String
    age: Int

  obj Flagged
    n: Int
    on: Bool

  obj Outer
    f: Flagged?
    n: Int

  a: (Flagged?)? = none
  xs: List[Cheese?] = List()
  !xs.push(none)
  arr: [3]Flagged? = [none, none, none]
  o = Outer(f: none, n: 1)
  print(a == none, xs.len, arr[0] == none, o.f == none)

test "optional niche", '''
  true true true
  true
  3 true
  true none
  true true 2
  none
  brie 3
  true true Flagged(n: 3, on: true)
  true false Outer(f: Flagged(n: 1, on: false), n: 2)
  none Flagged(n: 2, on: true) none
'''
  # An optional held in its object's niche means what any optional does:
  # `none`, `if x as v`, `==`, an optional of it holding `none` or a
  # value, a List and an array of them, and a field that is one.
  obj Cheese
    name: String
    age: Int

  obj Flagged
    n: Int
    on: Bool

  obj Outer
    f: Flagged?
    n: Int

  a: (Flagged?)? = none
  b: Flagged? = none
  c: (Flagged?)? = b
  d: (Flagged?)? = Flagged(n: 3, on: true)
  print(a == none, c != none, d != none)
  if c as inner
    print(inner == none)
  if d as inner
    if inner as f
      print(f.n, f.on)
  e: ((Flagged?)?)? = c
  print(e != none, e)
  xs: List[Cheese?] = List()
  !xs.push(none)
  !xs.push(Cheese(name: String("brie"), age: 3))
  print(xs[0] == none, xs[1] != none, xs.len)
  for i in 0..xs.len
    if xs[i] as ch
      print(ch.name, ch.age)
    else
      print("none")
  ys: List[(Flagged?)?] = List()
  !ys.push(none)
  !ys.push(b)
  !ys.push(d)
  print(ys[0] == none, ys[1] != none, ys[2])
  o: Outer? = Outer(f: none, n: 2)
  if !o as v
    v.f = Flagged(n: 1, on: false)
  print(o != none, o == none, o)
  arr: [3]Flagged? = [none, Flagged(n: 2, on: true), none]
  print(arr[0], arr[1], arr[2])

code "optional named none layout", "pub const __rig_none_field = \"id\";", "pub const __rig_none: u32 = 0;", "if (@sizeOf(rig.Opt(@This())) != @sizeOf(@This())) @compileError(", "rig.Opt(Node)", "rig.notNone(Node, "
  # An object that names its none (`none id == 0`) holds that value for
  # `none`: its optional is `rig.Opt(Node)`, the size of a `Node`, which
  # the emitted object checks as Zig compiles it, and its constructor
  # checks the value it is given.
  obj Node
    id: U32
    none id == 0

  fun find(i: U32) -> Node?
    return none if i > 5
    Node(id: i + 1)

  if find(3) as n
    print(n.id)

test "optional named none", '''
  4 true
  true true true true true
  true
  true true
  true true
  2 none
'''
  # An optional held in a named none means what any optional does:
  # `none`, `if n as x`, `==`, an optional of it, a List of them, and a
  # plain enum field whose variant is the none.
  enum Kind
    empty
    leaf
    inner

  obj Tagged
    kind: Kind
    none kind == .empty

  obj Node
    id: U32
    none id == 0

  fun find(i: U32) -> Node?
    return none if i > 5
    Node(id: i + 1)

  if find(3) as n
    print(n.id, find(9) == none)
  a: Node? = Node(id: 3)
  b: Node? = none
  c: (Node?)? = a
  d: (Node?)? = none
  e: (Node?)? = b
  print(a != none, b == none, c != none, d == none, e != none)
  if c as inner
    print(inner != none)
  t: Tagged? = Tagged(kind: .leaf)
  u: Tagged? = none
  print(t != none, u == none)
  ns: List[Node?] = List()
  !ns.push(none)
  !ns.push(Node(id: 9))
  print(ns[0] == none, ns[1] != none)
  m = ns[1] ?? Node(id: 1)
  print(m.id - 7, ns[0])

bomb "optional named none made with its none", "a `Node` never holds `id` 0, which is what a `Node?` holds for `none`"
  # A value known only when the program runs is checked as the object is
  # made.
  use std.os

  obj Node
    id: U32
    none id == 0

  n = Node(id: U32(os.args().len - 1))
  print(n.id)

fail "optional named none misuse", "7:5: cannot assign to `n.id`: `id` names the none of `Node` (`none id == ...`), so only its constructor sets it; make a new `Node`", "8:16: a `Node` never holds `id` 0, which is what a `Node?` holds for `none`; write `none` where no `Node` is meant", "9:20: a `Tagged` never holds `kind` .empty", errors: 3
  obj Node
    id: U32
    none id == 0

  sub main()
    n = Node(id: 2)
    n.id = 3
    z = Node(id: 0)
    t = Tagged(kind: .empty)
    print(n.id, z.id, t.kind)

  enum Kind
    empty
    full

  obj Tagged
    kind: Kind
    none kind == .empty

fail "optional named none declarations", "4:3: an object names its none by its one field, and `Two` has 2", "8:8: an object names its none by a field that is an integer or a plain enum; `s` is a `String`", "12:3: a member line `name field == value` is the none of an object, written `none v == ...`", "16:8: `Big` has no field `w`", "20:13: `v` is a `U8`, which cannot hold 300", "23:12: `v`'s default is its none, which no `Def` holds", "29:3: only an object names its none; `Pick` is an enum", errors: 7
  obj Two
    a: Int
    b: Int
    none a == 0

  obj Text
    s: String
    none s == 0

  obj Odd
    v: Int
    nope v == 0

  obj Big
    v: Int
    none w == 0

  obj Small
    v: U8
    none v == 300

  obj Def
    v: Int = 0
    none v == 0

  enum Pick
    one
    two
    none one == 0

  sub main()
    print(1)
