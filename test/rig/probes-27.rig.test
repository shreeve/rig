test "review-sc3-ed", '''
  defer 2
  3
  defer 1
  100
  defer 0
  errdefer 0
  -1
'''
  error E
    missing

  fun get(k: Int) -> Int?
    k if k > 0 else none

  fun f(k: Int) -> Int!
    errdefer print("errdefer", k)
    defer print("defer", k)
    x = get(k) ?? return E.missing
    y = get(k - 1) ?? return 100
    x + y

  print(f(2) catch -1)
  print(f(1) catch -1)
  print(f(0) catch -1)

test "review-sc3-ei", '''
  drop 2
  drop 1
  drop 3
  drop 1
  drop 1
  2 30 0
  drop 2
  drop 1
  3
  drop 4
  4
  -1
'''
  obj Res
    id: Int

    drop(!self)
      print("drop", self.id)

  obj Node
    next: Res?
    alt: Res?

    fun take2(!self) -> Int
      if <self.next as a and <self.alt as b
        a.id + b.id
      else if <self.alt as c and c.id > 0
        c.id
      else
        -1

  fun make(k: Int) -> Res?
    Res(id: k) if k > 0 else none

  fun pick(i: Int, j: Int) -> Int
    v = if make(i) as a and a.id > 1
      a.id
    else if make(j) as b and b.id > 1
      b.id * 10
    else
      0
    v

  print(pick(2, 3), pick(1, 3), pick(1, 1))
  n = Node(next: Res(id: 1), alt: Res(id: 2))
  print((!n).take2())
  m = Node(next: none, alt: Res(id: 4))
  print((!m).take2())
  print((!m).take2())

test "review-sc3-fb", '''
  n 1
  drop 1
  drop 2
  drop 4
  drop 3
  out 99
  drop 99
'''
  obj Res
    id: Int

    drop(!self)
      print("drop", self.id)

  fun get(k: Int) -> Int?
    k if k != 2 else none

  xs: List[^Res] = List()
  for i in 1..5
    !xs.push(^Res(id: i))
  keep = Res(id: 99)
  out = for b in <xs
    n = get(b.id) ?? break <keep
    print("n", n)
  else
    Res(id: -1)
