test "review-rule2-cell-handle-alias", '''
  2 0
  q
'''
  sub alias(a: *Cell[List[String]], b: *Cell[List[String]])
    swap(!a, !b)
    (!b).push(String("y"))
    old = (!a).replace(List())
    print(old.len, b.len)

  sub alias2(a: *Cell[String], b: *Cell[String])
    swap(!a, !b)
    (!a).set(String("q"))

  c: *Cell[List[String]] = *Cell(List())
  !c.push(String("a"))
  alias(+c, +c)
  s: *Cell[String] = *Cell(String("a"))
  alias2(+s, +s)
  print((!s).replace(String("")))

test "review-rule2-cell-handle-forms", '''
  20 2
  2
  30 3
  2 7
  1102 1107
  2 1 1
  9 1 1
  6 5
'''
  obj H
    h: *Cell[List[Int]]

  sub viaOwned(o: H)
    h = +o.h
    (!h)[0] = 20
    (!h).push(21)

  sub viaOpt(h: (*Cell[List[Int]])?)
    if h as x
      print(x.len)
    y = <h ?? return
    (!y)[0] = 30
    (!y).push(31)

  sub generic[T](c: *Cell[T], d: *Cell[T], v: T)
    (!c).set(v)
    swap(!c, !d)

  sub viaLoop(cs: List[*Cell[Int]])
    for c in <cs
      (!c).set(c.get() + 100)

  sub viaLoopView(cs: ?List[*Cell[Int]])
    for c in cs
      d = +c
      (!d).set(d.get() + 1000)

  sub swapLocals()
    a: *Cell[Int] = *Cell(1)
    b: *Cell[Int] = *Cell(2)
    a2 = +a
    swap(!a, !b)
    print(a.get(), b.get(), a2.get())
    !a.set(9)
    print(a.get(), b.get(), a2.get())

  sub fixed()
    a =! *Cell(5)
    b =! *Cell(6)
    swap(!a, !b)
    print(a.get(), b.get())

  c: *Cell[List[Int]] = *Cell(List())
  !c.push(1)
  viaOwned(H(h: +c))
  print(c[0], c.len)
  viaOpt(+c)
  print(c[0], c.len)
  viaOpt(none)
  x: *Cell[Int] = *Cell(1)
  y: *Cell[Int] = *Cell(2)
  generic(+x, +y, 7)
  print(x.get(), y.get())
  cs: List[*Cell[Int]] = List()
  !cs.push(+x)
  !cs.push(+y)
  viaLoopView(?cs)
  viaLoop(<cs)
  print(x.get(), y.get())
  swapLocals()
  fixed()

test "review-rule2-cell-handle-lend-binding", '''
  2
  6 2
  6 2 8 2
  77
  3 2 77
  2 3
'''
  sub viaBinding(c: *Cell[List[Int]])
    w = !c
    !w.push(5)
    w[0] = 6
    print(w.len)

  sub viaTernary(c: *Cell[List[Int]], d: *Cell[List[Int]], k: Bool)
    (!c if k else !d).push(7)
    (!c if k else !d)[0] = 8

  sub viaCapture(c: *Cell[Int])
    f = |+c| (!c).set(77)
    f()

  sub swapTernary(a: *Cell[Int], b: *Cell[Int], c: *Cell[Int], k: Bool)
    swap(!a if k else !b, !c)

  sub cellSwapMember(a: *Cell[Int], b: *Cell[Int])
    x = (!a).replace(b.get())
    (!b).set(x)

  c: *Cell[List[Int]] = *Cell(List())
  !c.push(1)
  viaBinding(+c)
  print(c[0], c.len)
  d: *Cell[List[Int]] = *Cell(List())
  !d.push(1)
  viaTernary(+c, +d, false)
  print(c[0], c.len, d[0], d.len)
  i: *Cell[Int] = *Cell(1)
  viaCapture(+i)
  print(i.get())
  j: *Cell[Int] = *Cell(2)
  k: *Cell[Int] = *Cell(3)
  swapTernary(+i, +j, +k, true)
  print(i.get(), j.get(), k.get())
  cellSwapMember(+i, +j)
  print(i.get(), j.get())

test "review-rule2-cell-handle-module", '''
  4 2
  b a
  1 0
  8
'''
  use lib

  sub local(c: *Cell[List[Int]])
    lib.trade(+c, +c)

  sub main()
    c: *Cell[List[Int]] = *Cell(List())
    !c.push(1)
    lib.put(+c, 4)
    print(c[0], c.len)
    a: *Cell[String] = *Cell(String("a"))
    b: *Cell[String] = *Cell(String("b"))
    lib.trade(+a, +b)
    print((!a).replace(String("")), (!b).replace(String("")))
    local(+c)
    s: *Cell[List[String]] = *Cell(List())
    lib.through(+s)
    bx = lib.Box[Int](c: *Cell(1))
    bx.put(8)
    print(bx.c.get())

  file "lib.rig"
    pub obj Box[T]
      pub c: *Cell[T]

      pub sub put(?self, v: T)
        h = +self.c
        (!h).set(v)

    pub sub put(c: *Cell[List[Int]], v: Int)
      (!c)[0] = v
      (!c).push(v)

    pub sub trade[T](a: *Cell[T], b: *Cell[T])
      swap(!a, !b)

    pub sub touch[T](x: !T)
      print($name(T))

    pub sub through(c: *Cell[List[String]])
      (!c).push(String("n"))
      old = (!c).replace(List())
      print(old.len, c.len)

test "review-rule2-cell-handle-param-ops", '''
  1
  11
  10
  3 3
  2
  0
  0
  5
  5 6
  hi
  6
  2 6
  b
  2 6
  z yo
'''
  sub fill(xs: !Cell[List[Int]])
    !xs.push(7)
    xs[0] = 3

  sub ops(c: *Cell[List[Int]])
    (!c)[0] = 10
    print(c.len)
    (!c).push(11)
    print((!c).pop() ?? -1)
    (!c).push(12)
    print(c.get(0) ?? -1)
    fill(!c)
    print(c.len, c[0])
    (!c).keep(2)
    print(c.len)
    (!c).clear()
    print(c.len)

  sub cellops(c: *Cell[Int], s: *Cell[String])
    (!c).set(5)
    print(c.get())
    old = (!c).replace(6)
    print(old, c.get())
    (!s).set(String("hi"))
    t = (!s).replace(String("yo"))
    print(t)

  sub builtins(c: *Cell[Int], d: *Cell[Int], s: *Cell[String], t: *Cell[String])
    swap(!c, !d)
    print(c.get(), d.get())
    swap(!s, !t)
    u = (!s).replace(String("z"))
    print(u)

  c: *Cell[List[Int]] = *Cell(List())
  !c.push(1)
  ops(+c)
  print(c.len)
  i: *Cell[Int] = *Cell(1)
  s: *Cell[String] = *Cell(String("a"))
  cellops(+i, +s)
  print(i.get())
  j: *Cell[Int] = *Cell(2)
  t: *Cell[String] = *Cell(String("b"))
  builtins(+i, +j, +s, +t)
  print(i.get(), j.get())
  print((!s).replace(String("")), (!t).replace(String("")))

test "review-rule2-name-module", '''
  (Node?)? (Node?)?
  *(Node?) *(Node?)
  (P?)? (lib.P?)?
  *(P?) *(lib.P?)
  ((Node?)?)?
  Box[(Int?)?]? lib.Box[(Int?)?]?
  lib (P?)? Box[P?]?
'''
  use lib

  obj Node
    v: Int

  type NN = (Node?)?

  type HN = *(Node?)

  type LPP = (lib.P?)?

  type HP = *(lib.P?)

  type BX = lib.Box[(Int?)?]?

  sub main()
    n: Node? = none
    print(lib.nm(n), $name(NN))
    print(lib.hnm(n), $name(HN))
    p: lib.P? = none
    print(lib.nm(p), $name(LPP))
    print(lib.hnm(p), $name(HP))
    print(lib.deeper(n))
    i: (Int?)? = none
    b = lib.Box(v: i)
    print(b.self_name(), $name(BX))
    lib.local_names()

  file "lib.rig"
    pub obj P
      pub v: Int

    pub obj Box[T]
      pub v: T

      pub fun self_name(?self) -> ?String
        $name(Self?)

    pub fun nm[T](x: T) -> ?String
      $name(T?)

    pub fun hnm[T](x: T) -> ?String
      $name(*T)

    pub fun deeper[T](x: T) -> ?String
      y: T? = none
      nm(y)

    pub type LP = (P?)?

    pub sub local_names()
      print("lib", $name(LP), $name(Box[P?]?))

fail "review-rule2-name-view-deep-import", "`lib.f9[(?Node)?]` cannot use `T = (?Node)?`: the generic body names a type that holds a `T` with `$name`, which spells no view or slice in a type parameter's instance but a `?String`, and `(?Node)?` holds `?Node`"
  use lib

  obj Node
    v: Int

  sub main()
    n = Node(v: 1)
    r: (?Node)? = ?n
    print(lib.f0(?r))

  file "lib.rig"
    pub fun f0[T](x: ?T) -> Int
      f1(x) + 1

    pub fun f1[T](x: ?T) -> Int
      f2(x) + 1

    pub fun f2[T](x: ?T) -> Int
      f3(x) + 1

    pub fun f3[T](x: ?T) -> Int
      f4(x) + 1

    pub fun f4[T](x: ?T) -> Int
      f5(x) + 1

    pub fun f5[T](x: ?T) -> Int
      f6(x) + 1

    pub fun f6[T](x: ?T) -> Int
      f7(x) + 1

    pub fun f7[T](x: ?T) -> Int
      f8(x) + 1

    pub fun f8[T](x: ?T) -> Int
      f9(x) + 1

    pub fun f9[T](x: ?T) -> Int
      print($name(T))
      0

test "review-rule2-proof-addend-cycle", '''
  3 2
  4 3
  5 4
'''
  fun k() -> Int
    2

  fun j() -> Int
    if false
      return 3
    k()

  fun c1() -> Int
    if false
      return c2()
    1

  fun c2() -> Int
    if false
      return c1()
    9

  sub walk(s: []Int)
    i = 0
    while i + 4 <= s.len
      print(s[i + j()], s[i + c1()])
      i += 1

  xs = [1, 2, 3, 4, 5, 6]
  walk(xs[..])

bomb "review-rule2-proof-call-cycles", "index out of bounds", prints: "2"
  obj P
    k: Int

  fun f(n: Int) -> Int
    if n > 0
      return g(n - 1)
    2

  fun g(n: Int) -> Int
    if n == 0
      return 10
    f(n)

  fun h(n: Int) -> Int
    if n > 0
      return h(n - 1)
    1

  fun a(n: Int) -> P
    if n > 0
      return b(n - 1)
    P(k: 1)

  fun b(n: Int) -> P
    if n == 0
      return P(k: 9)
    a(n)

  fun c() -> Int
    d()

  fun d() -> Int
    if true
      return c()
    0

  xs = [1, 2, 3]
  print(xs[h(4)])
  print(xs[a(5).k])
  print(xs[f(1)])

test "review-rule2-swap-writable-handles", '''
  3 2 1 1
  2 1 1 2
  2 40
  1
'''
  obj H
    h: *Cell[Int]

  a: *Cell[Int] = *Cell(1)
  b: *Cell[Int] = *Cell(2)
  c: *Cell[Int] = *Cell(3)
  a2 = +a
  k = a.get() == 1
  swap(!a if k else !b, !c)
  print(a.get(), b.get(), c.get(), a2.get())
  o = H(h: +a2)
  q = H(h: +b)
  swap(!o.h, !q.h)
  print(o.h.get(), q.h.get(), a2.get(), b.get())
  r = replace(!o.h, *Cell(40))
  print(r.get(), o.h.get())
  print(c.get())

