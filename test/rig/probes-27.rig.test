test "review-sc5-c2", '''
  drop R 1
  drop R 105
  105
  drop R 2
  -1
  -9
  102
  98
'''
  obj R
    n: Int
    drop(!self)
      print("drop R", self.n)

  fun first(s: ?String) -> U8?
    s.get(0)

  fun lead(s: ?String, f: ?fun(?String) -> R?) -> Int
    if f(s) as r
      return r.n
    -1

  fun nested(s: ?String, f: ?fun(?String) -> Int!) -> Int
    f(s) catch -9

  error E
    bad

  fun fail(n: Int) -> Int!
    if n == 0
      return E.bad
    n

  print(lead("hi", |s|
    a = R(n: 1)
    R(n: Int(first(s)?) + a.n)
  ))
  print(lead("", |s|
    a = R(n: 2)
    R(n: Int(first(s)?) + a.n)
  ))
  print(nested("x", |s|
    g: *fun(Int) -> Int! = *|k| fail(k)! + 1
    g(s.len - 1)! + 100
  ))
  print(nested("xy", |s|
    g: *fun(Int) -> Int! = *|k| fail(k)! + 1
    g(s.len - 1)! + 100
  ))
  k: *fun(Int) -> U8? = *|n| first("abc"[n..])?
  print(k(1) ?? 0)

test "review-sc5-c5", '''
  g 3
  8 -2
  true
'''
  error E
    bad

  fun fail(n: Int) -> Int!
    if n == 0
      return E.bad
    n

  obj S
    f: *fun(Int) -> Int!
    g: *sub(Int)!

  fun run(s: ?S, n: Int) -> Int!
    s.g(n)!
    s.f(n)! * 2

  s = S(f: *|n| fail(n)! + 1, g: *|n| print("g", fail(n)!))
  print(run(?s, 3) catch -1, run(?s, 0) catch -2)
  o: (*fun(Int) -> Int!)? = none
  print(o == none)
