test "review-sc3-c1", '''
  drop 2
  drop 0
  4 -9
  1 none
  2 -1 3
  s 1 51
  drop 51
  drop 50
  caught E.worse
'''
  error E
    bad
    worse

  obj Res
    id: Int

    drop(!self)
      print("drop", self.id)

  fun p(k: Int) -> Int!
    return E.bad if k == 0
    return E.worse if k < 0
    k

  fun q(k: Int) -> Int!
    r = Res(id: k)
    n = p(k) catch |e| return e
    n + r.id

  fun opt(k: Int) -> Int?
    n = p(k) catch return none
    n

  fun chain(a: Int?, b: Int?) -> Int
    a ?? (b ?? return -1)

  sub s(k: Int)!
    r = Res(id: 50 + k)
    n = p(k) catch |e| return E.worse if e == E.bad else e
    print("s", n, r.id)

  print(q(2) catch -9, q(0) catch -9)
  print(opt(1), opt(0))
  print(chain(none, 2), chain(none, none), chain(3, none))
  s(1)!
  s(0) catch |e| print("caught", e)

test "review-sc3-c2", '''
  eat 1
  drop 1
  else
  eat 2
  drop 2
  body 3
  drop 3
  eat 2
  drop 2
  else
  drop 1
  u else
  u body 5
  drop 5
  u else
'''
  obj Res
    id: Int

    drop(!self)
      print("drop", self.id)

  fun make(k: Int) -> Res?
    Res(id: k) if k > 0 else none

  fun eat(r: Res) -> Bool
    print("eat", r.id)
    r.id > 1

  sub t(k: Int, j: Int)
    if make(k) as a and eat(<a) and make(j) as b
      print("body", b.id)
    else
      print("else")

  sub u(k: Int)
    p: Res? = make(k)
    if <p as a and a.id > 2
      print("u body", a.id)
    else
      print("u else")

  t(1, 3)
  t(2, 3)
  t(2, 0)
  u(1)
  u(5)
  u(0)

test "review-sc3-cs", '''
