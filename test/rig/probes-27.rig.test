test "review-sc4-bx", '''
  three 1
  drop 2
  20
  opt 7
  end
  drop 7
  drop 20
  drop 1
'''
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(b: *B, k: Int)
    empty

  obj H
    s: ^Slot

  sub edit(h: !H)
    match !h.s
      .full(b, k) if k > 0 => b = *B(n: 20)
      .full(_, k) => k = 5
      _ => print("e")

  fun peek(h: ?H) -> Int
    match ?h.s
      .full(b, k) if k > 0 => b.n
      _ => 0

  bx = ^Slot.full(b: *B(n: 1), k: 0)
  match !bx
    .full(b, k) if b.n > 0 => k = 3
    _ => print("e")
  match ?bx
    .full(b, k) if k == 3 => print("three", b.n)
    _ => print("e")
  h = H(s: ^Slot.full(b: *B(n: 2), k: 0))
  edit(!h)
  edit(!h)
  print(peek(?h))
  o: Slot? = .full(b: *B(n: 7), k: 1)
  if ?o as s
    match s
      .full(b, k) if k > 0 => print("opt", b.n)
      _ => print("e")
  print("end")

test "review-sc4-c1", '''
  kept 10
  drop 10
  drop 0
  kept 1
  drop 1
  drop 11
  kept 12
  drop 12
  drop 2
  drop 51
  drop 60
  50 61
  drop 70
  71
  end
  drop 71
  drop 61
  drop 50
'''
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Pair
    two(a: *B, b: *B)
    nothing

  sub keep(b: *B)
    print("kept", b.n)

  fun pick(p: Pair, first: Bool) -> *B
    match <p
      .two(a, b)
        if first
          return <a
        <b
      .nothing => *B(n: 0)

  i = 0
  while i < 3
    p: Pair = .two(a: *B(n: i), b: *B(n: i + 10))
    match <p
      .two(a, b)
        if i == 1
          keep(<a)
        else
          keep(<b)
      .nothing => print("none")
    i += 1
  x = pick(.two(a: *B(n: 50), b: *B(n: 51)), true)
  y = pick(.two(a: *B(n: 60), b: *B(n: 61)), false)
  print(x.n, y.n)
  q: Pair = .two(a: *B(n: 70), b: *B(n: 71))
  q2 = match <q
    .two(a, b) if a.n > 100 => <a
    .two(a, b) => <b
    .nothing => *B(n: 0)
  print(q2.n)
  print("end")

