  sub s(k: Int)!
    return E.bad if k == 1
    print("s", k)

  fun t(k: Int) -> Int
    s(k) catch return -1
    k

  for i in 0..3
    s(i) catch continue
    print("after", i)
  for i in 0..3
    s(i) catch break
  print(t(0), t(1))

