test "review-sc4-sf", '''
  drop 1
  11
  drop 99
  11
  end
  drop 11
'''
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(b: *B)
    empty

    fun take(<self, d: *B) -> *B
      match <self
        .full(b) if b.n > 0 => b
        _ => <d

    sub bump(!self)
      match !self
        .full(b) if b.n < 10 => b = *B(n: b.n + 10)
        _ => print("big")

    fun peek(?self) -> Int
      match self
        .full(b) if b.n > 0 => b.n
        _ => 0

  s: Slot = .full(b: *B(n: 1))
  !s.bump()
  print(s.peek())
  x = <s.take(*B(n: 99))
  print(x.n)
  print("end")

test "review-sc4-t1", '''
  consume 1
  consume 1
  d 1
  drop 1
  end
'''
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(b: *B)
    empty

  fun consume(b: *B) -> Bool
    print("consume", b.n)
    false

  fun fresh(n: Int) -> B
    B(n: n)

  s: Slot = .full(b: *B(n: 1))
  match <s
    .full(b) if consume(+b) => print("a")
    .full(b) if consume(+b) => print("c")
    .full(b) => print("d", b.n)
    .empty => print("e")
  print("end")

test "review-sc4-t2", '''
  drop 1
  -1
  drop 2
  -2
  end
'''
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Slot
    full(b: *B)
    empty

  error Bad
    nope

  fun check(n: Int) -> Bool!
    return Bad.nope if n > 0
    true

  fun go(s: Slot) -> Int!
    match <s
      .full(b) if check(b.n)! => b.n
      .full(b) => 0 - b.n
      .empty => 0

  fun lookup(n: Int) -> Int?
    return none if n > 0
    n

  fun go2(s: Slot) -> Int?
    match <s
      .full(b) if lookup(b.n)? > 100 => b.n
      _ => 0

  r = go(.full(b: *B(n: 1))) catch -1
  print(r)
  r2 = go2(.full(b: *B(n: 2))) ?? -2
  print(r2)
  print("end")

fail "review-sc4-tr", "`r` is bound but never read; name it `_` to ignore the value"
  obj B
    n: Int

    drop(!self)
      print("drop", self.n)

  enum Tree
    leaf(b: *B)
    node(l: ^Tree, r: ^Tree)

  fun count(t: ?Tree) -> Int
    match t
      .leaf(b) if b.n > 100 => 100
      .leaf(b) => b.n
      .node(l, r) if count(?l) > 5 => 99
      .node(l, r) => count(?l) + count(?r)

  fun sum(t: Tree) -> Int
    match <t
      .leaf(b) if b.n > 3 => b.n * 10
      .node(l, r) if count(?l) > 2
        a = <l.unbox()
        sum(<a)
      .node(l, r)
        a = <l.unbox()
        c = <r.unbox()
        sum(<a) + sum(<c)
      _ => 0

  sub edit(t: !Tree)
    match !t
      .leaf(b) if b.n == 3 => b = *B(n: 30)
      .node(l, r) if count(?l) > 0
        edit(!l)
        edit(!r)
      _ => print("x")

  t: Tree = .node(l: ^Tree.leaf(b: *B(n: 3)), r: ^Tree.leaf(b: *B(n: 4)))
  print(count(?t))
  edit(!t)
  print(count(?t))
  print(sum(<t))
  print("end")

