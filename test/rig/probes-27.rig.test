test "review-sc3-j6", '''
  drop 1
  drop 2
  drop 3
  drop 4
  total 8
  r 1
  drop 1
  drop 100
  r 2
  drop 2
  drop 100
  drop 100
  got 100
  v 1
  drop 14
  drop 13
  drop 12
  drop 11
'''
  error E
    bad

  obj Res
    id: Int

    drop(!self)
      print("drop", self.id)

  fun parse(r: ?Res) -> Int!
    return E.bad if r.id == 2
    r.id

  fun mk(i: Int) -> Res!
    return E.bad if i == 3
    Res(id: i)

  xs: List[^Res] = List()
  for i in 1..5
    !xs.push(^Res(id: i))
  total = 0
  for b in <xs
    n = parse(?b) catch continue
    total += n
  print("total", total)
  ys: List[*Res] = List()
  for i in 1..5
    !ys.push(*Res(id: 10 + i))
  got = for y in ?ys
    tmp = Res(id: 100)
    r = mk(y.id - 10) catch break tmp.id
    print("r", r.id)
  else
    0
  print("got", got)
  v = while true
    q = mk(3) catch |e| break (1 if e == E.bad else 2)
    print(q.id)
  print("v", v)

