test "review-revamp-rest-p8-c1", "42"
  obj P
    n: Int
    fun plus(?self, k: Int) -> Int
      self.n + k

  fun grow(c: !*Cell[List[P]]) -> Int
    for i in 0..1000
      !c.push(P(n: i))
    1

  c = *Cell[List[P]](value: List())
  !c.push(P(n: 41))
  d = +c
  print(c[0].plus(grow(!d)))

test "review-revamp-rest-p8-c3", "42"
  error E
    bad

  obj P
    n: Int
    fun plus(?self, k: Int) -> Int
      self.n + k

  fun grow(c: !*Cell[List[P]]) -> Int!
    for i in 0..10000
      !c.push(P(n: i))
    1

  fun run(c: ?*Cell[List[P]], d: !*Cell[List[P]]) -> Int!
    c[0].plus(grow(!d)!)

  c = *Cell[List[P]](value: List())
  !c.push(P(n: 41))
  d = +c
  print(run(c, !d) catch 0)

fail "review-revamp-rest-p8-c4", "cannot lend `v` to write while a read loan is live"
  obj P
    n: Int
    fun plus(?self, k: Int) -> Int
      self.n + k

  fun grow(v: !List[P]) -> Int?
    for i in 0..10000
      !v.push(P(n: i))
    1

  fun run(v: !List[P]) -> Int?
    v[0].plus(grow(!v)?)

  v = List[P]()
  !v.push(P(n: 41))
  print(run(!v) ?? 0)

test "review-revamp-rest-p8-c5", "43"
  error E
    bad

  obj P
    n: Int
    fun use(?self, a: List[Int], b: List[Int]) -> Int
      self.n + a.len + b.len

  fun mk(c: !*Cell[List[P]]) -> List[Int]!
    for i in 0..10000
      !c.push(P(n: i))
    v = List[Int]()
    !v.push(1)
    v

  fun run(c: ?*Cell[List[P]], d: !*Cell[List[P]]) -> Int!
    c[0].use(mk(!d)!, mk(!d)!)

  c = *Cell[List[P]](value: List())
  !c.push(P(n: 41))
  d = +c
  print(run(c, !d) catch 0)

test "review-revamp-rest-p8-c7", "4 2 2"
  error E
    bad

  obj P
    n: Int
    fun use(!self, a: List[Int], b: List[Int]) -> Int
      self.n += 1
      self.n + a.len + b.len

  fun mk(n: Int) -> List[Int]!
    return E.bad if n < 0
    v = List[Int]()
    !v.push(n)
    v

  fun run(ps: ![2]P, i: !Int) -> Int!
    (!ps[i]).use(mk(1)!, mk(2)!)

  ps = [P(n: 1), P(n: 2)]
  i = 0
  print(run(!ps, !i) catch 0, ps[0].n, ps[1].n)

