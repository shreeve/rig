fail "review-syntax-b-2-o06 closure read of writeview", "cannot lend `w` to write while a read loan is live"
  sub f(w: !String)
    g = |?w| w[1..]
    s = g()
    for _ in 0..50
      !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    print(s)

  t = String("hello")
