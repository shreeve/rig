    b

  e = E.a(String("hello"))
  match !e
    .a(t)
      r = ?t
      !t.add("x")
      print(r)
    .b => print("b")

fail "review-syntax-b-2-m04 match bang vec payload", "cannot lend `xs` to write while a read loan is live"
  fun keepv(s: []Int) -> []Int
    s

