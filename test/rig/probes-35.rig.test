  print(keep((!h).get()[1..]))
  s = keep(?(!h).get()[1..])
  print(s)

test "review-syntax-b-2-v08 branch read ok", "ello"
  fun keep(s: ?String) -> ?String
    s

  sub f(a: ?String, b: ?String, c: Bool)
    s = keep((a if c else b)[1..])
    print(s)

  x = String("hello")
  y = String("world")
  f(?x, ?y, true)

fail "review-syntax-b-2-v09 match bang escape ok", "`t` does not live long enough"
  fun keep(s: ?String) -> ?String
    s

  enum E
    a(t: String)
    b

  e = E.a(String("hello"))
  s: ?String = ""
  match !e
    .a(t) => s = keep(?t[1..])
    .b => pass
  print(s)

fail "review-syntax-b-2-v11 if bang as owned escape", "`r` does not live long enough"
