# Probes from past reviews and audits, 35 of 41: review-syntax-b-2-b26_array_text_elem_writeview to review-take-p52.

use std.text

fail "review-syntax-b-2-b26 array text elem writeview", "cannot assign to `a[0]` while `a` is lent"
  fun keep(s: ?String) -> ?String
    s

  sub f(a: ![2]String)
    s = keep(?a[0][1..])
    a[0] = String("x")
    print(s)

  a = [String("hello"), String("world")]
  f(!a)

fail "review-syntax-b-2-c03 call ret write arg", "a view reached through `get(!h)` outlives its statement, which holds `get(!h)`, itself a view, only while it runs; bind `get(!h)` to a name first"
  fun keep(s: ?String) -> ?String
    s

  obj H
    t: String

  fun get(h: !H) -> !String
    !h.t

  h = H(t: String("hello"))
  s = keep(?get(!h)[1..])
  for _ in 0..50
    !h.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(s)

fail "review-syntax-b-2-c05 call ret write ok", "a view reached through `get(!h)` outlives its statement, which holds `get(!h)`, itself a view, only while it runs; bind `get(!h)` to a name first"
  fun keep(s: ?String) -> ?String
    s

  obj H
    t: String

  fun get(h: !H) -> !String
    !h.t

  h = H(t: String("hello"))
  s = keep(?get(!h)[1..])
  print(s)
  !h.t.add("x")
  print(h.t)

fail "review-syntax-b-2-c07 branch lends write", "a view reached through `!x if c else !y` outlives its statement, which holds `!x if c else !y`, itself a view, only while it runs; bind `!x if c else !y` to a name first"
  fun keep(s: ?String) -> ?String
    s

  x = String("hello")
  y = String("world")
  c = true
  s = keep(?(!x if c else !y)[1..])
  for _ in 0..50
    !x.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(s)

fail "review-syntax-b-2-c08 method ret write view", "a view reached through `(!h).get()` outlives its statement, which holds `(!h).get()`, itself a view, only while it runs; bind `(!h).get()` to a name first"
  fun keep(s: ?String) -> ?String
    s

  obj H
    t: String

    fun get(!@) -> !String
      !@t

  h = H(t: String("hello"))
  s = keep(?(!h).get()[1..])
  for _ in 0..50
    !h.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(s)

fail "review-syntax-b-2-c12 writeview moved slice", "cannot move `w` while a read loan is live"
  fun keep(s: ?String) -> ?String
    s

  sub g(w: !String)
    !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")

  sub f(w: !String)
    s = keep(?w[1..])
    g(<w)
    print(s)

  t = String("hello")
  f(!t)

fail "review-syntax-b-2-c13 writeview relend slice", "cannot lend `w` to write while a read loan is live"
  fun keep(s: ?String) -> ?String
    s

  sub g(w: !String)
    for _ in 0..50
      !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")

  sub f(w: !String)
    s = keep(?w[1..])
    g(!w)
    print(s)

  t = String("hello")
  f(!t)

fail "review-syntax-b-2-c19 closure ret write slice", "cannot return a view of `t`, which this function was not lent"
  fun keep(s: ?String) -> ?String
    s

  t = String("hello")
  f = |!t| keep(?t[1..])
  s = f()
  for _ in 0..50
    !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  print(s)

fail "review-syntax-b-2-d05 writeslice slice of slice", "cannot assign to `w[0]` while `w` is lent"
  sub f(w: ![]String)
    s = ?w[0..1]
    t = s[0..1]
    u = ?t[0][1..]
    w[0] = String("other")
    print(u)

  v: List[String] = List()
  !v.push(String("hello"))
  f(!v[..])

fail "review-syntax-b-2-e01 readview of temp bind", "a view of the temporary `mk()` outlives its statement, which drops it; bind the value to a name first"
  fun keep(s: ?String) -> ?String
    s

  fun mk() -> String
    String("hello")

  fun id(r: ?String) -> ?String
    r

  s = id(?mk())[1..]
  print(s)

fail "review-syntax-b-2-e03 readview of temp implicit", "a view of the temporary `mk()` outlives its statement, which drops it; bind the value to a name first"
  fun keep(s: ?String) -> ?String
    s

  fun mk() -> String
    String("hello")

  fun id(r: ?String) -> ?String
    r

  s = keep(id(mk())[1..])
  print(s)

test "review-syntax-b-2-e04 readview of temp stmt ok", "ello"
  fun keep(s: ?String) -> ?String
    s

  fun mk() -> String
    String("hello")

  fun id(r: ?String) -> ?String
    r

  print(keep(id(?mk())[1..]))

fail "review-syntax-b-2-e06 box temp readview", "a view of the temporary `^String(\"hello\")` outlives its statement, which drops it; bind the value to a name first"
  fun keep(s: ?String) -> ?String
    s

  fun id(r: ?^String) -> ?^String
    r

  s = keep(id(?^String("hello"))[1..])
  print(s)

fail "review-syntax-b-2-e07 struct temp field", "a view of the temporary `H(t: String(\"hello\"))` outlives its statement, which drops it; bind the value to a name first"
  fun keep(s: ?String) -> ?String
    s

  fun mk() -> String
    String("hello")

  fun id(r: ?String) -> ?String
    r

  obj H
    t: String

  fun name(h: ?H) -> ?String
    ?h.t

  s = keep(name(?H(t: String("hello")))[1..])
  print(s)

fail "review-syntax-b-2-e08 writeview of temp", "a view reached through `wid(!mk())` outlives its statement, which holds `wid(!mk())`, itself a view, only while it runs; bind `wid(!mk())` to a name first"
  fun keep(s: ?String) -> ?String
    s

  fun mk() -> String
    String("hello")

  fun wid(w: !String) -> !String
    w

  s = keep(?wid(!mk())[1..])
  print(s)

fail "review-syntax-b-2-f02 trim writeview slice", "cannot lend `w` to write while a read loan is live"
  sub f(w: !String)
    s = text.trim(?w[1..])
    for _ in 0..50
      !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    print(s)

  t = String(" hello ")
  f(!t)

fail "review-syntax-b-2-f03 split writeview", "cannot lend `w` to write while a read loan is live"
  sub f(w: !String)
    it = text.split(?w[0..], " ")
    for _ in 0..50
      !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    while (!it).next() as p
      print(p)

  t = String("a b c")
  f(!t)

test "review-syntax-b-2-f05 writeview print ok", '''
  hello
   hello !
'''
  sub f(w: !String)
    print(text.trim(w[1..]))
    !w.add("!")
    print(w)

  t = String(" hello ")
  f(!t)

fail "review-syntax-b-2-g01 for bytes writeview add", "cannot lend `w` to write while a read loan is live"
  sub f(w: !String)
    for b in w
      if b == 104
        for _ in 0..50
          !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(b)

  t = String("hello")
  f(!t)

fail "review-syntax-b-2-g02 for vec writeview push", "cannot lend `w` to write while a read loan is live"
  sub f(w: !List[Int])
    for x in w
      if x == 1
        for i in 0..100
          !w.push(i)
      print(x)

  v: List[Int] = List()
  !v.push(1)
  !v.push(2)
  f(!v)

fail "review-syntax-b-2-g03 for bytes box writeview", "cannot reassign `w` while it is lent"
  sub f(w: !^String)
    for b in w
      if b == 104
        w = ^String("x")
      print(b)

  t = ^String("hello")
  f(!t)

fail "review-syntax-b-2-m02 match bang bound written", "cannot lend `t` to write while a read loan is live"
  fun keep(s: ?String) -> ?String
    s

  fun keepv(s: []Int) -> []Int
    s

  enum E
    a(t: String)
    b

  e = E.a(String("hello"))
  match !e
    .a(t)
      s = ?t[1..]
      for _ in 0..50
        !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => print("b")

