test "review-take-p46", '''
  R(n: 1) 1
  drop 1
  S(a: none)
  R(n: 2) 0
  drop 2
  R(n: 3) 0
  drop 3
  S(a: none)
'''
  obj R
    n: Int
    drop(!@)
      print("drop", @n)

  obj S
    a: R?

  fun peek(s: ?S) -> Int
    if ?s.a as r
      return r.n
    0

  sub f(x: R?, y: Int)
    print(x, y)

  s = S(a: R(n: 1))
  f(y: peek(?s), x: <s.a)
  print(s)
  s.a = R(n: 2)
  f(y: 0, x: <s.a)
  s.a = R(n: 3)
  f(x: <s.a, y: peek(?s))
  print(s)

