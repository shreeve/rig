test "review-take-p24", '''
  R(n: 1) S(a: none)
  drop 1
  R(n: 1) S(a: R(n: 7))
  drop 1
  drop 7
  R(n: 1) S(a: R(n: 7))
  drop 1
  drop 7
'''
  obj R
    n: Int
    drop(!@)
      print("drop", @n)

  obj S
    a: R?

  fun make() -> S?
    S(a: R(n: 1))

  if make() as x
    y = <x.a
    print(y, x)
  i = 0
  while make() as z
    w = <z.a
    z.a = R(n: 7)
    print(w, z)
    i += 1
    break if i > 1

