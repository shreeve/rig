  o: String? = String("hello")
  s: ?String = ""
  if !o as r
    !r.add("!")
    s = keep(?r[1..])
  print(s)

fail "review-syntax-b-2-v12 match bang param escape", "`t` does not live long enough"
  fun keep(s: ?String) -> ?String
    s

  enum E
    a(t: String)
    b

  sub f(e: !E)
    s: ?String = ""
    match !e
      .a(t) => s = keep(?t[1..])
      .b => pass
    print(s)

  x = E.a(String("hello"))
  f(!x)

test "review-take-h1", "1 S(a: none)"
  obj S
    a: Int?

  fun mk() -> S
    S(a: 1)

  s = mk()
  t = <s.a
  print(t, s)

test "review-take-h4", '''
  R(n: 1) S(t: T(a: none), z: 0)
  drop 1
'''
  obj R
    n: Int
    drop(!@)
      print("drop", @n)

  obj T
    a: R?

  obj S
    t: T
    z: Int

  fun mk() -> S
    S(t: T(a: R(n: 1)), z: 0)

  s = mk()
  t = <s.t.a
  print(t, s)

