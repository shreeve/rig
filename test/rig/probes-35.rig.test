      print(r.len)
      s = ?xs[..]
      for i in 0..100
        !xs.push(i)
      print(s)
    .b => print("b")

fail "review-syntax-b-2-m15 match bang named payload", "cannot lend `x` to write while a read loan is live"
  enum E
    a(t: String, n: Int)
    b

  e = E.a(t: String("hello"), n: 1)
  match !e
    .a(t: x)
      s = ?x[1..]
      for _ in 0..50
        !x.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    _ => pass

fail "review-syntax-b-2-m17 match bang arrow call", "cannot lend `t` to read while a write loan is live"
  fun grow(t: !String, s: ?String) -> ?String
    for _ in 0..50
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
    s

  enum E
    a(t: String)
    b

  e = E.a(String("hello"))
  match !e
    .a(t) => print(grow(!t, ?t[1..]))
    .b => pass

test "review-syntax-b-2-o02 write holder slice field reassign", '''
  [2, 3]
  [4, 5, 6]
'''
  obj R
    xs: []Int

  sub g(w: !R, u: []Int) keeps u
    s = w.xs[1..]
    w.xs = u
    print(s)

  a = [1, 2, 3]
  b = [4, 5, 6]
  r = R(xs: ?a[..])
  g(!r, ?b[..])
  print(r.xs)

test "review-syntax-b-2-o03 write vec of slices", '''
  [2, 3]
  [[4, 5, 6]]
'''
  sub g(w: !List[[]Int], u: []Int) keeps u
    s = w[0][1..]
    w[0] = u
    print(s)

  a = [1, 2, 3]
  b = [4, 5, 6]
  v: List[[]Int] = List()
  !v.push(?a[..])
  g(!v, ?b[..])
  print(v)

test "review-syntax-b-2-o04 write holder string field reassign", '''
  ello
  other
'''
  obj R
    f: ?String

  sub g(w: !R)
    s = w.f[1..]
    w.f = "other"
    print(s)

  t = String("hello")
  r = R(f: ?t[..])
  g(!r)
  print(r.f)

