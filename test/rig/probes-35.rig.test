test "review-take-p117", '''
  drop 4
  drop 3
  drop 2
  none
  Stack(top: Node(value: 1, next: none))
  drop 1
  1
  Stack(top: none)
'''
  obj Node
    value: Int
    next: ^Node?

    drop(!@)
      print("drop", @value)

  obj Stack
    top: ^Node?

    fun find(!@, k: Int) -> Int?
      while <@top as n
        if n.value == k
          return n.value
        @top = <n.next
        continue if n.value == 99
        break if n.value == 2
      none

  s = Stack(top: none)
  for v in [1, 2, 3, 4]
    s.top = ^Node(value: v, next: <s.top)
  print((!s).find(9))
  print(s)
  print((!s).find(1))
  print(s)

