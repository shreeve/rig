fail "review-take-p52", "use of `s` after move"
  obj R
    n: Int
    drop(!@)
      print("drop", @n)

  obj S
    a: R?

  sub eat(s: S)
    print("eat", s)

  s = S(a: R(n: 1))
  defer
    x = <s.a
    print("deferred", x)
  eat(<s)
  print("end")
