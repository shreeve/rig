fail "review-syntax-b-2-o08 read of write then move", "cannot move `w` while a read loan is live"
  sub g(w: !String)
    for _ in 0..50
      !w.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")

  t = String("hello")
  w = !t
  r = ?w
  s = r[1..]
  g(<w)
  print(s)

fail "review-syntax-b-2-o13 callable view write capture", "cannot lend `t` to read while a write loan is live"
  sub f(r: ?String, g: ?sub())
    s = r[1..]
    g()
    print(s)

  t = String("hello")
  g = |!t|
    for _ in 0..50
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
  f(?t, g)

