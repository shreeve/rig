fail "review-copies-p44-n-of-text-view-drop", "cannot return a view of `t`, which this function was not lent"
  fun mk() -> [3]?String
    t = String("a long heap allocated text here")
    [3 of ?t]

  print(mk()[0])

fail "review-copies-p45-boundary-pols", "cannot assign to `a.x` while `a` is lent"
  # The kept boundary: how a read view of a plain struct reads in each
  # form, beside a write view of one and a read view of an Int.
  obj P
    x: Int

  fun id[T](v: T) -> T
    v

  a = P(x: 1)
  r = ?a
  b = r
  a.x = 2
  print(b.x)

test "review-copies-p45b-boundary-branch", "1"
  obj P
    x: Int

  a = P(x: 1)
  p = P(x: 9)
  r = ?a
  b = r if a.x > 0 else p
  a.x = 2
