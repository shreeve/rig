  sub main()
    x = b.h(0) catch |e|
      match e
        b.Mid.timeout => 1
        _ => 2
    print(x)
    y = b.h(0) catch |e| 1 if e == .timeout else 2

  file "a.rig"
    error Hidden
      timeout

    pub fun f(n: Int) -> Int!
      return Hidden.timeout if n == 0
      n

  file "b.rig"
    use a

    pub error Mid
      timeout

    pub fun h(n: Int) -> Int!
      return Mid.timeout if n == 1
      a.f(n)!

