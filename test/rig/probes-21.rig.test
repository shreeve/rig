fail "review-copies-p22-result-copy-out-then-holder-changes", "cannot lend `xs` to write while a read loan is live"
  # The copy out of a view keeps the loans of the views S holds, not the
  # loan on s: s may change, xs may not.
  obj S
    v: ?List[Int]

  fun keep(r: ?S) -> S
    r

  xs: List[Int] = List()
  !xs.push(1)
  ys: List[Int] = List()
  s = S(v: ?xs)
  t = keep(?s)
  s = S(v: ?ys)
  print(t.v.len, s.v.len)
  !ys.push(3)
  !xs.push(2)
  print(t.v.len)

