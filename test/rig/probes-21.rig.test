test "review-errors-m10", '''
  Bx(v: 1, e: Disk.full)
  .bad(e: Disk.full) .bad(e: Disk.empty)
  true true
'''
  use lib

  sub main()
    b = lib.Bx[Int](v: 1)
    print(b)
    r: lib.R = .bad(.full)
    print(r, lib.mk(0))
    match lib.mk(0)
      .bad(e) => print(e == .empty, e == lib.Disk.empty)
      .ok(v) => print(v)

  file "lib.rig"
    pub error Disk
      full
      empty

    pub obj Bx[T]
      pub v: T
      pub e: Disk = .full

    pub enum R
      ok(v: Int)
      bad(e: Disk)

    pub fun mk(n: Int) -> R
      return .bad(.empty) if n == 0
      .ok(n)

test "review-errors-m2", '''
  Rec(e: Disk.full, g: Disk.timeout) Disk.timeout Disk.full Disk.full
  Disk.timeout true true
  1
  Disk.full true true false
  7
  f
'''
  use lib

  sub main()
    r = lib.Rec()
    print(r, lib.dflt(), lib.dflt(.full), lib.dflt(lib.Disk.full))
    print(lib.opt(0), r.e == .full, r.e == lib.Disk.full)
    x = lib.fail(1) catch 5
    print(x)
    y = lib.fail(0) catch |e|
      print(e, e == .full, e == lib.Disk.full, e == .timeout)
      7
    print(y)
    match r.e
      .timeout => print("t")
      lib.Disk.full => print("f")

  file "lib.rig"
    pub error Disk
      timeout
      full

    pub obj Rec
      pub e: Disk = .full
      pub g: Disk? = .timeout

    pub fun dflt(e: Disk = .timeout) -> Disk
      e

    pub fun opt(n: Int) -> Disk?
      return .timeout if n == 0
      none

    pub fun fail(n: Int) -> Int!
      return Disk.full if n == 0
      1

fail "review-errors-m3-main5", "`y` is assigned but never read; use it, or discard the value with `_ = ...`"
