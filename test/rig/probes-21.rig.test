test "review-copies-2-q09c-coalesce-copyout-optional-sites", '''
  1
  1 1
'''
  # The same copy-out into `P?` at an argument, a return, a field.
  obj P
    x: Int

  obj S
    o: P?

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  fun pick(i: (?P)?, r: ?P) -> P?
    i ?? r

  a = P(x: 1)
  b = P(x: 2)
  i: (?P)? = ?a
  print(px(i ?? ?b))
  s = S(o: i ?? ?b)
  print(px(pick(i, ?b)), px(s.o))

test "review-copies-2-q09d-branch-copyout-into-optional", "1 1"
  # Siblings: a branch and a bare view into `P?`.
  obj P
    x: Int

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  a = P(x: 1)
  b = P(x: 2)
  c = true
  r = ?a
  f: P? = r
  g: P? = ?a if c else ?b
  print(px(f), px(g))

test "review-copies-2-q09e-coalesce-none-into-optional", "1 -1"
  # `?? none` and `catch none` where an optional of the viewed value is expected.
  error Bad
    oops

  obj P
    x: Int

  fun get(r: ?P, ok: Bool) -> (?P)!
    return Bad.oops if not ok
    r

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  a = P(x: 1)
  i: (?P)? = ?a
  f: P? = i ?? none
  g: P? = get(?a, false) catch none
  print(px(f), px(g))

test "review-copies-2-q09g-coalesce-read-view-int-into-optional", "1 1"
  # A read view of an Int is held by value, so this one compiles.
  fun ix(o: Int?) -> Int
    if o as p
      return p
    -1

  n = 1
  m = 2
  i: (?Int)? = ?n
  f: Int? = i ?? none
  g: Int? = i ?? ?m
  print(ix(f), ix(g))

test "review-copies-2-q09h-coalesce-moved-write-view-into-optional", "1 1"
  # A moved optional write view, coalesced where an optional Int is expected.
  fun ix(o: Int?) -> Int
    if o as p
      return p
    -1

  n = 1
  i: (!Int)? = !n
  f: Int? = <i ?? none
  print(ix(f), n)

test "review-copies-2-q11b-clone-write-view-int", "1 2 2 5"
  # `+w` of a write view of an Int reads the Int (Core sentence 1).
  obj P
    x: Int

  n = 1
  w = !n
  c = +w
  a = P(x: 2)
  v = !a
  d = +v
  w += 1
  v.x = 5
  print(c, d.x, n, a.x)

test "review-copies-2-q11d-clone-read-view-holder", "1 s 1"
  # A value holding only read views copies, so it clones.
  obj R
    r: ?Int
    s: ?String

  n = 1
  h = R(r: ?n, s: "s")
  c = +h
  f = |+h| h.r
  print(c.r, c.s, f())

test "review-copies-2-q13a-ret-write-as-read-fallible", '''
  3 1
  7
'''
  error Bad
    oops

  obj P
    x: Int

  fun ri(w: !Int, ok: Bool) -> (?Int)!
    return Bad.oops if not ok
    w

  fun rp(w: !P, ok: Bool) -> (?P)!
    return Bad.oops if not ok
    w

  fun ro(w: !P, k: Int) -> (?P)?!
    return Bad.oops if k == 0
    return none if k == 1
    w

  n = 3
  m = 4
  a = P(x: 1)
  b = P(x: 2)
  x = ri(!n, true) catch ?m
  y = rp(!a, true) catch ?b
  print(x, y.x)
  c = P(x: 7)
  z = ro(!c, 2) catch none
  if z as zz
    print(zz.x)

