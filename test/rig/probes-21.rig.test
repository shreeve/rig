fail "review-copies-p37-owned-closure-struct-param-stored", "cannot store a view of `p` in a `Cell`: every handle to it could reach the view; a value stored in a Cell or Signal may not hold one; if it is only passed literal text, declare the parameter `Static`, which carries no loan"
  # An owned closure stores a String-holding struct param into a captured
  # Cell it shares; the Text dies before the Cell is read.
  obj P
    s: ?String

  c = *Cell(P(s: "init"))
  d = +c
  f = *|<c, p: P| !c.set(P(s: p.s))
  if true
    t = String("a long heap allocated text here")
    f(P(s: ?t))
  print(d.get().s)

test "review-copies-p38-owned-closure-big-values", '''
  z 9 P(s: "y", n: 2, a: [4, 5, 6])
  x
'''
  obj P
    s: ?String
    n: Int
    a: [3]Int

  obj Q
    ps: [4]P
    o: P?

  f = *|q: Q, k: Int| Q(ps: [q.ps[3], q.ps[2], q.ps[1], q.ps[0]], o: q.ps[k])
  p = P(s: "x", n: 1, a: [1, 2, 3])
  q = Q(ps: [p, P(s: "y", n: 2, a: [4, 5, 6]), p, P(s: "z", n: 4, a: [7, 8, 9])], o: none)
  r = f(q, 1)
  print(r.ps[0].s, r.ps[0].a[2], r.o)
  g = +f
  print(g(r, 0).ps[0].s)

fail "review-copies-p39-fill-through-slice-param-scope", "`n` does not live long enough"
  # A callee fills a caller's array of views through a write slice with a
  # view of a local that dies before the array is read.
  sub fillit(s: ![]?Int, x: ?Int) keeps x
    !s.fill(x)

  m = 1
  a = [?m, ?m, ?m]
  if true
    n = 5
    fillit(!a[..], ?n)
  print(a[0])

