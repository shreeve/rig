  y = rp(!a, true) catch ?b
  print(a.x)
  print(y.x)

test "review-copies-2-q14a-closure-inside-fallible-view-fn", "1 2"
  # A closure inside a function that returns a fallible view returns its
  # own type; the closure's `return` is not the function's.
  error Bad
    oops

  obj P
    x: Int

  fun get(r: ?P, k: Int) -> (?P)!
    f: fun(Int) -> Int = |n|
      return n + 1 if n > 0
      0
    g: fun(Int) -> Int! = |n|
      return Bad.oops if n < 0
      n
    return Bad.oops if f(k) == 0
    _ = g(k)!
    r

  a = P(x: 1)
  b = P(x: 2)
  v = get(?a, 1) catch ?b
  u = get(?a, 0) catch ?b
  print(v.x, u.x)

test "review-copies-2-q14b-fallible-view-fn-inside-closure", "1 2"
  # A closure returning a fallible view, inside a function returning an Int.
  error Bad
    oops

  obj P
    x: Int

  fun outer(a: ?P, b: ?P, k: Int) -> Int
    f: fun(?P, Int) -> (?P)! = |r, n|
      return Bad.oops if n == 0
      r
    v = f(a, k) catch b
    v.x

  a = P(x: 1)
  b = P(x: 2)
  print(outer(?a, ?b, 1), outer(?a, ?b, 0))

