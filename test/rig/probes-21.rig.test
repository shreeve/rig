# Probes from past reviews and audits, 21 of 41: review-copies-2-q08c-opt-into-optional-copy to review-errors-m7.

use std.text

test "review-copies-2-q08c-opt-into-optional-copy", "1"
  error Bad
    oops

  obj P
    x: Int

  fun get(r: ?P, ok: Bool) -> (?P)!
    return Bad.oops if not ok
    r

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  fun vx(o: (?P)?) -> Int
    if o as p
      return p.x
    -1

  a = P(x: 1)
  b = P(x: 2)
  o: P? = get(?a, true) catch ?b
  a.x = 9
  b.x = 9
  print(px(o))

test "review-copies-2-q08d-fallible-return-optional-arg", "1 1 -1"
  error Bad
    oops

  obj P
    x: Int

  fun get(o: (?P)?, ok: Bool) -> (?P)?!
    return Bad.oops if not ok
    o

  fun get2(o: (?P)?, ok: Bool) -> (?P)?!
    return Bad.oops if not ok
    r = o?
    r

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  fun vx(o: (?P)?) -> Int
    if o as p
      return p.x
    -1

  a = P(x: 1)
  o: (?P)? = ?a
  x = get(o, true) catch none
  y = get2(o, true) catch none
  z = get2(none, true) catch none
  print(vx(x), vx(y), vx(z))

test "review-copies-2-q08e-error-value-of-other-errset", '''
  2
  1
  1
'''
  error Bad
    oops

  obj P
    x: Int

  error Other
    nope

  fun get(r: ?P, k: Int) -> (?P)!
    return Bad.oops if k == 0
    return Other.nope if k == 1
    r

  a = P(x: 1)
  b = P(x: 2)
  for k in 0..3
    v = get(?a, k) catch |e| (?b if e == Bad.oops else ?a)
    print(v.x)

test "review-copies-2-q09a-coalesce-copyout-into-optional", "1"
  # `??` whose value is a view, where an optional of its value is expected.
  obj P
    x: Int

  fun px(o: P?) -> Int
    if o as p
      return p.x
    -1

  a = P(x: 1)
  b = P(x: 2)
  i: (?P)? = ?a
  f: P? = i ?? ?b
  a.x = 9
  print(px(f))

