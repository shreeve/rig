fail "review-copies-p04-clone-capture-view-string-text-dropped", "cannot drop `t` while it is lent"
  obj S
    s: ?String

  fun mk() -> Int
    t = String("a heap string of some length")
    s = S(s: ?t)
    r = ?s
    f = |+r| r.s.len
    <t
    f()

  print(mk())

test "review-copies-p05-clone-capture-vec-paths", '''
  5 5
  5
  unused 1
  7 7 7
  drop 7
'''
  obj N
    v: Int
    drop(!self)
      print("drop", self.v)

  fun build() -> *fun() -> Int
    v: List[String] = List()
    !v.push(String("aa"))
    !v.push(String("bbb"))
    f = *|+v| v.len + v[1].len
    !v.push(String("c"))
    f

  sub unused()
    v: List[String] = List()
    !v.push(String("zz"))
    f = |+v| v.len
    if v.len > 5
      print(f())
    print("unused", v.len)

  sub many()
    hs: List[*N] = List()
    !hs.push(*N(v: 7))
    f = |+hs| hs[0].v
    <hs
    print(f(), f(), f())

  g = build()
  print(g(), g())
  h = +g
  <g
  print(h())
  unused()
  many()

