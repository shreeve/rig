    full

  fun f() -> Int!
    return Disk.full

  obj Holder
    e: Disk
    n: Int

  x = f() catch |e|
    print([e, e], e)
    0
  h = Holder(e: .full, n: 1)
  v: List[Disk?] = List()
  !v.push(.full)
  !v.push(none)
  print(h, v, [Disk.full])
  <v
  print(x)

