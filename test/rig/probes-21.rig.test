test "review-copies-p34-clone-capture-escape-and-fail", '''
  6
  12
  drop 1
  2
  drop 5
  -1
'''
  # Deep-cloned closure environments on every exit path: returned from a
  # function that was only lent the source, stored in a List, cloned,
  # captured into another closure, and dropped on a failing path.
  error Bad
    oops

  obj N
    v: Int

    drop(!self)
      print("drop", self.v)

  fun mk(v: ?List[String]) -> *fun() -> Int
    *|+v| v.len + v[0].len

  fun risky(n: Int) -> Int!
    if n > 1
      return Bad.oops
    n

  fun run(n: Int) -> Int!
    hs: List[*N] = List()
    !hs.push(*N(v: n))
    f = |+hs| hs[0].v
    k = risky(n)!
    f() + k

  ts: List[String] = List()
  !ts.push(String("hello"))
  g = mk(?ts)
  <ts
  print(g())
  fs: List[*fun() -> Int] = List()
  !fs.push(+g)
  !fs.push(<g)
  print(fs[0]() + fs[1]())
  print(run(1) catch -1)
  print(run(5) catch -1)

