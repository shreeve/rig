test "review-copies-p46-generic-copies-instances", '''
  a 2 [1, 2] 7
  d
  7 [5, 5, 5]
'''
  # Generic bodies that copy a T (Requirement.copies), instantiated with
  # plain structs, arrays, optionals, and String holders.
  obj P
    s: ?String
    n: Int

  fun first[T](xs: ?[2]T) -> T
    xs[0]

  fun three[T](x: T) -> [3]T
    [3 of x]

  fun dup[T](x: T) -> [2]T
    a = [x, x]
    !a.fill(x)
    a

  fun cap[T](x: T) -> Int
    f = |+x| 7
    f()

  fun pick[T](o: ?T?, d: T) -> T
    o ?? d

  ps = [P(s: "a", n: 1), P(s: "b", n: 2)]
  print(first(?ps).s, three(ps[1])[2].n, dup([1, 2])[1], cap(P(s: "c", n: 3)))
  o: P? = P(s: "d", n: 4)
  print(pick(?o, ps[0]).s)
  oo: (Int?)? = 5
  print(cap(oo), three(oo))

fail "review-copies-p49b-while-step-uses-slice-after-push", "cannot lend `v` to write while a read loan is live"
  # The step reads a slice the condition binds... rejected: a view
  # binding may not be used by the step.
  #
  # oracle: mk accept
  # oracle: main reject C4
  fun mk(v: ?List[Int]) -> ([]Int)?
    if v.len < 40
      return ?v[..]
    none

  v: List[Int] = List()
  !v.push(1)
  k = 0
  while mk(?v) as h: k += h[0]
    !v.push(2)
  print(k, v.len)

fail "review-copies-p49c-while-step-outer-slice", "cannot lend `v` to write while a read loan is live"
  # A plain `while c: step` whose step reads a slice declared before the
  # loop, after the body grew the List.
  #
  # oracle: main reject C4
  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  s = ?v[..]
  while i < 40: k += s[0]
    i += 1
    !v.push(2)
  print(k, v.len)

fail "review-copies-p49d-while-step-text-holder", "cannot lend `t` to write while a read loan is live"
  # oracle: mk accept
  # oracle: main reject C4


  # The step reads a String the condition's binding holds, after the
  # body grew the Text it views.
  obj S
    s: ?String

  fun mk(t: ?String) -> S?
    if t.len < 200
      return S(s: ?t)
    none

  t = String("abc")
  k = 0
  while mk(?t) as h: k += (1 if text.ends_with(h.s, "9") else 0)
    !t.add("0123456789")
  print(k, t.len)

test "review-copies-p49e-while-step-struct-reads-only", "12"
  # Same shape, but the body does not write `v`: accepted, runs clean.
  #
  # oracle: mk accept
  # oracle: main accept
  obj S
    s: []Int

  fun mk(v: ?List[Int], i: Int) -> S?
    if i < 3
      return S(s: ?v[..])
    none

  v: List[Int] = List()
  !v.push(4)
  k = 0
  i = 0
  while mk(?v, i) as h: k += h.s[0]
    i += 1
  print(k)

fail "review-copies-p49f-while-step-outer-repointed", "cannot lend `v` to write while a read loan is live"
  # The step reads an outer slice the body re-points at a List, after the
  # body grew that List.
  #
  # oracle: main reject C4
  w = [7, 7]
  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  s = ?w[..]
  while i < 40: k += s[0]
    s = ?v[..]
    !v.push(2)
    i += 1
  print(k, v.len)

fail "review-copies-p50-defer-reads-slice-after-push", "cannot lend `v` to write while a read loan is live"
  # A defer reads a slice at scope end, after the List it views grew.
  #
  # oracle: main reject C4
  v: List[Int] = List()
  !v.push(1)
  s = ?v[..]
  defer print(s[0])
  !v.push(2)
  !v.push(3)
  print(v.len)

fail "review-copies-p50b-defer-reads-struct-slice-after-push", "cannot lend `v` to write while a read loan is live"
  # oracle: main reject C4

  obj S
    s: []Int

  v: List[Int] = List()
  !v.push(1)
  h = S(s: ?v[..])
  defer print(h.s[0])
  !v.push(2)
  !v.push(3)
  print(v.len)

test "review-copies-p50c-while-step-copy-out", "465"
  # The step reads, through a copy out of a view, a struct whose slice
  # views a List the body grows.
  #
  # oracle: main accept
  obj S
    s: []Int

  v: List[Int] = List()
  !v.push(1)
  k = 0
  i = 0
  while i < 30: k += i
    h = S(s: ?v[..])
    i += h.s[0]
    !v.push(2)
  print(k)

test "review-copies-p51-coalesce-view-result-copy-out", "1 2 3"
  # `o ?? r` gives a `?P`, copied out where a `P` is expected.
  obj P
    x: Int
    y: Int

  fun pick(o: (?P)?, r: ?P) -> P
    o ?? r

  a = P(x: 1, y: 2)
  b = P(x: 3, y: 4)
  o: (?P)? = ?a
  c: P = o ?? ?b
  d = pick(o, ?b)
  e = pick(none, ?b)
  print(c.x, d.y, e.x)

test "review-copies-p51b-coalesce-view-int-copy-out", "1 1 3"
  # The same shape with an Int: `o ?? ?m` gives a `?Int`, read where an
  # Int is expected.
  fun pick(o: (?Int)?, r: ?Int) -> Int
    o ?? r

  n = 1
  m = 3
  o: (?Int)? = ?n
  c: Int = o ?? ?m
  print(c, pick(o, ?m), pick(none, ?m))

test "review-copies-p52b-return-view-into-fallible", "1"
  # A function returning a `(?P)!` whose last value is its `?P` parameter.
  error Bad
    oops

  obj P
    x: Int

  fun get(r: ?P, ok: Bool) -> (?P)!
    if not ok
      return Bad.oops
    r

  a = P(x: 1)
  v = get(?a, true) catch ?a
  print(v.x)

test "review-copies-p53-branch-match-views-copy-out", "1 2 2 1"
  # Branching values whose every arm is a `?P`, where a `P` is expected:
  # a branch, a match, a block, and a `??` whose fallback is a view too.
  obj P
    x: Int

  fun two(a: ?P, b: ?P, f: Bool) -> P
    a if f else b

  fun arm(a: ?P, b: ?P, k: Int) -> P
    match k
      0 => a
      _ => b

  a = P(x: 1)
  b = P(x: 2)
  f = a.x > 0
  c: P = ?a if f else ?b
  d: P = match a.x
    1 => ?b
    _ => ?a
  print(c.x, d.x, two(?a, ?b, false).x, arm(?a, ?b, 0).x)

