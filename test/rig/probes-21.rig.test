fail "review-copies-p32-clone-capture-through-view-vec-of-slices", "cannot assign to `a[1]` while `a` is lent"
  # `|+r|` deep-clones a List of slices through a view: the clone keeps
  # the slices' loan on `a`, not the view's loan on `x`.
  a = [1, 2, 3]
  x: List[[]Int] = List()
  !x.push(?a[..2])
  r = ?x
  f = |+r| r[0][1]
  <x
  a[1] = 9
  print(f())

