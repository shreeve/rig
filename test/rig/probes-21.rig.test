  # `fill` stores a view of a temporary Text that ends with the statement.
  a: [2]?String = ["x", "y"]
  !a.fill(?String("hello", " world, long enough to allocate"))
  print(a[0])

fail "review-copies-p56-n-of-temp-view", "a view of the temporary `String(\"hello world, long enough to allocate\")` outlives its statement, which drops it; bind the value to a name first"
  a = [3 of ?String("hello world, long enough to allocate")]
  print(a[0])

test "review-copies-p57-clone-capture-copy-through-views", '''
  1 5 2 7
  2 7 9
'''
  # `|+x|` copies a value that copies through a read or write view: the
  # closure keeps the value it saw, and the owner may then change.
  obj P
    x: Int

  fun ox(o: P?) -> Int
    if o as p
      return p.x
    0

  a = P(x: 1)
  w = !a
  f = |+w| w.x
  w.x = 5
  arr = [1, 2]
  ra = ?arr
  g = |+ra| ra[1]
  o: P? = P(x: 7)
  ro = ?o
  h = |+ro| ox(ro)
  print(f(), a.x, g(), h())
  arr[1] = 9
  o = none
  print(g(), h(), arr[1])

test "review-copies-p58-clone-capture-through-write-view-keeps-loan", "2 1"
  # `|+w|` deep-clones the List a write view sees; the closure owns its
  # clone, so the List may be used while the closure lives (Core §7: the
  # capture carries what the copied value holds, not the view's loan).
  xs: List[Int] = List()
  !xs.push(1)
  w = !xs
  f = |+w| w.len
  !xs.push(2)
  print(xs.len, f())

test "review-copies-p58b-clone-capture-through-read-view-plain", "2 1"
  obj P
    x: Int

  a = P(x: 1)
  r = ?a
  f = |+r| r.x
  a.x = 2
  print(a.x, f())

test "review-copies-p59-branch-view-and-optional", "1 1 3"
  # A branch of a `?P` and a `P?`: the view is copied out into the
  # optional.
  obj P
    x: Int

  fun ox(o: P?) -> Int
    if o as p
      return p.x
    0

  a = P(x: 1)
  o: P? = none
  r = ?a
  c = r if a.x > 0 else o
  d = o if a.x > 5 else r
  a.x = 3
  print(ox(c), ox(d), a.x)

test "review-enumtext-args-hidden", '''
  .red .blue
  .red .blue
  .red
  .blue
  .red none
  .blue
  true
'''
  # `from_text` of temporaries lent with `?`, List elements, loop views, a nested `from_text`, and chained `??`.
  enum Color
    red
    blue

  fun mk(n: Int) -> String
    String("bl", "ue") if n > 0 else String("x")

  fun nested(w: ?String) -> Color?
    Color.from_text(Color.from_text(w)?.text)

  print(Color.from_text(?String("re", "d")), Color.from_text(?mk(1)))
  xs = List[String]()
  !xs.push(String("red"))
  !xs.push(mk(1))
  print(Color.from_text(?xs[0]), Color.from_text(xs[1]))
  for s in ?xs
    print(Color.from_text(s))
  print(nested("red"), nested("zzz"))
  print(Color.from_text(mk(0)) ?? Color.from_text(mk(1)) ?? .red)
  ok = Color.from_text(mk(1)) == .blue and Color.from_text(mk(0)) == none
  print(ok)

test "review-enumtext-closure-views", '''
  dark_red
  dark_red
  dark_red
  dark_red
  dark_red
  red 0
  dark_red
  red
  red
  dark_red
  red
  dark_red
  dark_red
'''
  # `e.text` of a view captured by a closure, a write view passed on, and loop and `as` bindings that are views.
  enum Color
    red
    dark_red

  sub f(c: !Color)
    g = |!c| c.text
    print(g())
    h = |?c| c.text
    print(h())
    k = |+c| c.text
    print(k())

  fun r(c: ?Color) -> Static
    g = |?c| c.text
    g()

  sub w(c: !Color)
    inner(!c)
    for i in 0..1
      print(c.text, i)

  sub inner(c: !Color)
    print(c.text)
    c = .red

  c: Color = .dark_red
  !f(!c)
  print(r(?c))
  !w(!c)
  o: Color? = .dark_red
  if !o as v
    print(v.text)
    v = .red
  if ?o as v
    print(v.text)
  xs = [Color.red, Color.dark_red]
  for x in ?xs
    print(x.text)
  for x in !xs
    print(x.text)
  ys: []Color = ?xs
  print(ys[1].text)

test "review-enumtext-comptime", '''
  strict loose .loose none
  strict strict
'''
  # `.text` of a compile-time enum parameter and `from_text` of a compile-time `?String` parameter.
  enum Mode
    strict
    loose

  fun name[mode: Mode]() -> Static
    mode.text

  fun parse[w: ?String]() -> Mode?
    Mode.from_text(w)

  print(name[.strict](), name[Mode.loose](), parse["loose"](), parse["x"]())
  m =! Mode.strict
  print(m.text, name[m]())

test "review-enumtext-deep-receivers", '''
  blue
  blue
  red
  red
  red blue red blue
  blue
  blue
  blue
  red red
  red
  blue
'''
  # `e.text` through boxes and shared handles behind read and write views, fields of objects reached through views, and closures lending them.
  enum Color
    red
    blue

  obj Pen
    color: Color
    boxed: ^Color
    shared: *Color
    opt: Color?
    list: List[Color]

  sub wbox(b: !^Color)
    print(b.text)

  fun rbox(b: ?^Color) -> Static
    b.text

  sub wsh(h: !*Color)
    print(h.text)

  fun rsh(h: ?*Color) -> Static
    h.text

  sub wpen(p: !Pen)
    print(p.color.text, p.boxed.text, p.shared.text, p.list[0].text)
    if p.opt as o
      print(o.text)
    for x in !p.list
      print(x.text)

  fun rpen(p: ?Pen) -> Static
    p.boxed.text

  b = ^Color.blue
  !wbox(!b)
  print(rbox(?b))
  h = *Color.red
  !wsh(!h)
  print(rsh(?h))
  l = List[Color]()
  !l.push(.blue)
  p = Pen(color: .red, boxed: ^Color.blue, shared: *Color.red, opt: .blue, list: <l)
  !wpen(!p)
  print(rpen(?p))
  r = ?p
  print(r.color.text, r.shared.text)
  f = |!p| p.color.text
  print(f())
  g = |?b| b.text
  print(g())

test "review-enumtext-dirmodule", '''
  .blue none .big .little
  1 two .dark_red .big
  little red
'''
  # A directory module: a plain enum declared in one file and looked up
  # by `from_text` in another, a private enum's table, and `Endian`'s
  # module-level table needed by two files of the module and the root.
  use shapes

  sub main()
    print(shapes.parse("blue"), shapes.parse("x"), shapes.order("big"), shapes.order2("little"))
    print(shapes.from_b("two"), shapes.hid(1), shapes.Color.from_text("dark_red"), Endian.from_text("big"))
    e: Endian = .little
    print(e.text, shapes.Color.red.text)

  file "shapes/a.rig"
    pub enum Color
      red
      dark_red
      blue

    enum Hidden
      one
      two

    pub fun from_b(w: ?String) -> Int
      Int(Hidden.from_text(w) ?? .one)

  file "shapes/b.rig"
    pub fun parse(w: ?String) -> Color?
      Color.from_text(w)

    pub fun order(w: ?String) -> Endian?
      Endian.from_text(w)

    pub fun hid(h: Int) -> Static
      (Hidden.from_int(h) ?? .one).text

  file "shapes/c.rig"
    pub fun order2(w: ?String) -> Endian?
      Endian.from_text(w)

test "review-enumtext-match-payload", '''
  red
  red
  blue blue
  blue .blue
'''
  # `c.text` of a plain enum bound by a match on a payload enum, through read and write views.
  enum Color
    red
    blue

  enum Shape
    dot
    circle(c: Color)
    pair(a: Color, b: Color)

  fun name(s: ?Shape) -> Static
    match s
      .dot => "dot"
      .circle(c) => c.text
      .pair(_, b) => b.text

  sub recolor(s: !Shape)
    match !s
      .circle(c)
        print(c.text)
        c = .blue
      _ => pass

  s: Shape = .circle(c: .red)
  print(name(?s))
  !recolor(!s)
  print(name(?s), name(Shape.pair(a: .red, b: .blue)))
  match ?s
    .circle(c) => print(c.text, Color.from_text(c.text))
    _ => pass

test "review-enumtext-module-const", '''
  blue blue red
  red .red
  blue .blue
  red
'''
  # `.text` of module constants (an element of `@variants`, a variant, an array element) and of a Signal's value.
  enum Color
    red
    blue

  all = @variants(Color)
  fav = Color.blue
  pair = [Color.blue, Color.red]

  sub main()
    print(all[1].text, fav.text, pair[1].text)
    for c in all
      print(c.text, Color.from_text(c.text))
    s = *Signal(Color.red)
    print(s.get().text)

test "review-enumtext-positions", '''
  .blue none
  red
  b
  .red
  .red
  .dark_red
  .red
  .blue
  .blue
  .dark_red
  .red none
'''
  # `from_text` in `if as`, a match subject with `??`, `?? return`, `catch`, a closure, an owned closure, a write view lent on as `?s`, and a test block.
  enum Color
    red
    dark_red
    blue

  fun mk(n: Int) -> String
    String("bl", "ue") if n > 0 else String("x")

  fun opt(n: Int) -> String?
    return none if n == 0
    String("red")

  fun fail(n: Int) -> String!
    return E.bad if n == 0
    String("dark_red")

  error E
    bad

  fun parse(w: ?String) -> Color!
    Color.from_text(w) ?? return E.bad

  sub take(s: !String)
    print(Color.from_text(?s))

  sub main()
    print(Color.from_text(mk(1)), Color.from_text(mk(0)))
    if Color.from_text(String("re", "d")) as c
      print(c.text)
    match Color.from_text("blue") ?? .red
      .red => print("r")
      .blue => print("b")
      _ => print("other")
    s = opt(1) ?? String("none")
    print(Color.from_text(s))
    if opt(1) as o
      print(Color.from_text(o))
    t = fail(1) catch String("q")
    print(Color.from_text(t))
    print(parse("red") catch Color.blue)
    print(parse("nope") catch Color.blue)
    ws = String("blue")
    !take(!ws)
    f = |w: ?String| Color.from_text(w)
    print(f("dark_red"))
    h: *fun(?String) -> Color? = *|w| Color.from_text(w)
    print(h("red"), h("x"))

  test "from_text in a test"
    print(Color.from_text("red") == Color.red, Color.blue.text == "blue")
    print(Color.from_text(Color.dark_red.text))

test "review-enumtext-self", '''
  dark_red .dark_red .red dark_red dark_red
  dark_red
  red
  red
'''
  # `self.text` in `?self`, `!self`, and `<self` methods, and `from_text` in associated functions and a method declared outside the body.
  enum Color
    red
    dark_red

    fun name(?self) -> Static
      self.text

    sub flip(!self)
      print(self.text)
      self = Color.from_text("red") ?? .dark_red
      print(self.text)

    fun parse(w: ?String) -> Self?
      Color.from_text(w)

    fun parse2(w: ?String) -> Color?
      Color.from_text(w)

    fun owned(<self) -> Static
      self.text

  fun Color.outside(?self) -> Static
    self.text

  c: Color = .dark_red
  print(c.name(), Color.parse("dark_red"), Color.parse2("red"), c.outside(), c.owned())
  !c.flip()
  print(c.text)

test "review-enumtext-temp-owner", '''
  dark_red
  drop pen0
  dark_red
  drop pen2
  drop pen1
  dark_red
  drop pen3
  dark_red
  drop pen4
  drop pen5
  dark_red
  .dark_red
  drop pen6
  none
  drop pen7
  none
  drop pen8
'''
  # `.text` of a field of a temporary that owns a resource (an object, a List element, a box, a shared handle): each is dropped once; `from_text` of a temporary String.
  enum Color
    red
    dark_red

  obj Pen
    color: Color
    label: String

    drop(!self)
      print("drop", self.label)

  fun make(n: Int) -> Pen
    Pen(color: .dark_red, label: String("pen", n))

  fun pens() -> List[Pen]
    xs = List[Pen]()
    !xs.push(make(1))
    !xs.push(make(2))
    xs

  fun boxed() -> ^Pen
    ^make(3)

  fun shared() -> *Pen
    *make(4)

  print(make(0).color.text)
  print(pens()[1].color.text)
  print(boxed().color.text)
  print(shared().color.text)
  t = make(5).color.text
  print(t)
  print(Color.from_text(make(6).color.text))
  print(Color.from_text(make(7).label))
  print(Color.from_text(?make(8).label))

test "review-enumtext-values", '''
  blue none red none 8
  other ["dark_red", "red"] true true false
  dark_red dark true
  dark_red-red 12
  ["dark_red"]
  ["dark_red", "red", "blue"] 3
  100
  dark_red
  .dark_red .dark_red
'''
  # `.text` as a value: `?.` on an optional, a ternary, List[Static] and List[?String], comparisons, slices, hash, String building, iteration, and `from_text` of it.
  enum Color
    red
    dark_red
    blue

  fun name_of(c: Color?) -> Static?
    c?.text

  fun parse_name(w: ?String) -> Static?
    Color.from_text(w)?.text

  fun len_of(w: ?String) -> Int?
    Color.from_text(w)?.text.len

  fun echo(s: ?String) -> ?String
    s

  print(name_of(.blue), name_of(none), parse_name("red"), parse_name("x"), len_of("dark_red"))
  c: Color = .dark_red
  d: Color = .red
  k = false
  x = c.text if k else "other"
  names: List[Static] = List()
  !names.push(c.text)
  !names.push(d.text)
  print(x, names, names[0] == "dark_red", c.text < d.text, c.text == d.text)
  print(echo(c.text), c.text[0..4], c.text.hash() == "dark_red".hash())
  s = String(c.text, "-", d.text)
  print(s, s.len)
  views: List[?String] = List()
  !views.push(c.text)
  print(views)
  arr = [c.text, d.text, Color.blue.text]
  print(arr, arr.len)
  for ch in c.text
    print(ch)
    break
  m = match c
    .dark_red => c.text
    _ => "?"
  print(m)
  y = Color.from_text(c.text) ?? .blue
  z = Color.from_text(?s[0..8])
  print(y, z)

test "review-errors-a1", '''
  Rec(e: Disk.full, f: none)
  Disk.timeout Disk.timeout none
  [Disk.full, Disk.timeout] Disk.timeout Disk.full
  true true
'''
  error Disk
    timeout
    full

  error Net
    timeout

  obj Rec
    e: Disk = .full
    f: Disk? = none

  fun opt(n: Int) -> Disk?
    return .timeout if n == 0
    none

  fun dflt(e: Disk = .timeout) -> Disk
    e

  r = Rec()
  print(r)
  o: Disk? = .timeout
  print(o, opt(0), opt(1))
  v = List[Disk]()
  !v.push(.full)
  !v.push(Disk.timeout)
  print(v, dflt(), dflt(.full))
  print(r.e == .full, r.e != Disk.timeout)
  <v

test "review-errors-a2", '''
  f t
  nt-flag net disk net ok
'''
  error Disk
    timeout
    full

  error Net
    timeout
    refused

  fun name(d: Disk) -> ?String
    match d
      Disk.timeout => "t"
      .full => "f"

  fun fetch(n: Int) -> Int!
    return Net.timeout if n == 1
    return Disk.timeout if n == 2
    return Net.refused if n == 3
    n

  fun cls(n: Int, flag: Bool) -> ?String
    _ = fetch(n) catch |e|
      s = match e
        Net.timeout if flag => "nt-flag"
        Net.timeout, Net.refused => "net"
        Disk.timeout, Disk.full => "disk"
        _ => "?"
      return s
    "ok"

  print(name(.full), name(Disk.timeout))
  print(cls(1, true), cls(1, false), cls(2, true), cls(3, false), cls(4, false))

test "review-errors-a4", '''
  true false true false
  0
'''
  error Disk
    timeout

  error Net
    timeout

  fun fetch(n: Int) -> Int!
    return Net.timeout if n == 1
    return Disk.timeout if n == 2
    n

  d: Disk = .timeout
  n: Net = .timeout
  x = fetch(2) catch |e|
    print(e == d, e == n, d == e, e != d)
    0
  print(x)

test "review-errors-a6", '''
  3 0
  .missing .red
  rethrowing Bad.bad
  errdefer ran
  -1 1
'''
  error Bad
    bad
    missing

  enum Color
    red
    missing

  fun parse[T](ok: Bool, x: T) -> T!
    return Bad.bad if not ok
    x

  fun cb(f: ?fun(Int) -> Color!) -> Color
    f(1) catch .red

  fun rethrow(n: Int) -> Int!
    x = parse(n > 0, n) catch |e|
      print("rethrowing", e)
      return e
    x

  fun withdefer(n: Int) -> Int!
    errdefer print("errdefer ran")
    r = rethrow(n)!
    r

  print(parse(true, 3) catch 0, parse(false, 3) catch 0)
  print(cb(|x| .missing), cb(|x|
    return Bad.bad if x == 1
    .missing
  ))
  print(withdefer(0) catch -1, withdefer(1) catch -1)

fail "review-errors-b3", "`e` owns an `error`, which can't be copied into an array: write `<e` to move it or `+e` to clone it"
