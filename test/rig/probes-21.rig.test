fail "review-copies-p18-branch-copy-out-view-holder", "cannot lend `xs` to write while a read loan is live"
  # A branch whose arms are a read view of S and an S: the view is copied
  # out; the copy carries the loan of the view S holds.
  obj S
    v: ?List[Int]

  xs: List[Int] = List()
  !xs.push(1)
  ys: List[Int] = List()
  s = S(v: ?xs)
  r = ?s
  flag = xs.len > 0
  c = r if flag else S(v: ?ys)
  s = S(v: ?ys)
  !xs.push(2)
  print(c.v.len)

