    i = at
    if i + 7 <= s.len
      !s.write[Simd[U8, 8]](i, Simd[U8, 8].splat(9)) # keeps: write upper

  fun at16(s: ?String, at: Int) -> Int
    i = at
    if i + 15 <= s.len
      return Int(s.read[Simd[U8, 16]](i)[0]) # keeps: read upper
    0

  sub put16(s: ![]U8, at: Int)
    i = at
    if i + 15 <= s.len
      !s.write[Simd[U8, 16]](i, Simd[U8, 16].splat(9)) # keeps: write upper

  fun at32(s: ?String, at: Int) -> Int
    i = at
    if i + 31 <= s.len
      return Int(s.read[Simd[U8, 32]](i)[0]) # keeps: read upper
    0

  sub put32(s: ![]U8, at: Int)
    i = at
    if i + 31 <= s.len
      !s.write[Simd[U8, 32]](i, Simd[U8, 32].splat(9)) # keeps: write upper

  fun at64(s: ?String, at: Int) -> Int
    i = at
    if i + 63 <= s.len
      return Int(s.read[Simd[U8, 64]](i)[0]) # keeps: read upper
    0

  sub put64(s: ![]U8, at: Int)
    i = at
    if i + 63 <= s.len
      !s.write[Simd[U8, 64]](i, Simd[U8, 64].splat(9)) # keeps: write upper

  s = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkl"
  a: [64]U8 = [64 of 1]
  put2(!a[..], 62)
  print(at2(s, 62), a[62])
  put4(!a[..], 60)
  print(at4(s, 60), a[60])
  put8(!a[..], 56)
  print(at8(s, 56), a[56])
  put16(!a[..], 48)
  print(at16(s, 48), a[48])
  put32(!a[..], 32)
  print(at32(s, 32), a[32])
  put64(!a[..], 0)
  print(at64(s, 0), a[0])
  print(at2(s, 63))

bomb "simd mid unit mut", "byte read out of range", prints: "98", release: true
  # A write of the offset inside the read's own statement ends the guard's
  # facts for it, whichever part runs first: the read keeps both tests.

  fun bump(n: !Int) -> Int
    n += 1
    0

  fun peek(s: ?String, at: Int) -> Int
    i = at
    if i + 16 <= s.len
      return bump(!i) + Int(s.read[Simd[U8, 16]](i)[0]) # keeps: read lower upper
    0

  s = "abcdefghijklmnopqrstuvwxyz"
  print(peek(s, 0))
  print(peek(s, s.len - 16))

bomb "simd negative mut", "byte read out of range", prints: "[1, 1, 1, 1, 1, 1, 1, 1]\n97", release: true
  # Nothing shows `0 <= i` when `i` starts below 0: a vector's read keeps
  # its sign test, and its write too.

  fun scan(s: ?String, at: Int) -> Int
    i = at
    n = 0
    while i + 16 <= s.len : i += 16
      v = s.read[Simd[U8, 16]](i) # keeps: read lower
      n += Int(v[0])
    n

  sub fill(t: ![]U8, at: Int)
    i = at
    while i + 4 <= t.len : i += 4
      !t.write[Simd[U8, 4]](i, Simd[U8, 4].splat(1)) # keeps: write lower

  a: [8]U8 = [8 of 0]
  fill(!a[..], 0)
  print(a)
  print(scan("abcdefghijklmnopqrstuvwxyz", 0))
  print(scan("abcdefghijklmnopqrstuvwxyz", -5))

