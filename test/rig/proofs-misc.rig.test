    i = at
    if i < s.len and flag
      return s[i] # proves: index upper
    0

  print(pick("abc", 2, true))

bomb "or guard mut", "index out of bounds", release: true
  # `or` makes no fact: either side may be the one that held.

  fun pick(s: ?String, at: Int, flag: Bool) -> U8
    i = at
    if i < s.len or flag
      return s[i] # keeps: index upper
    0

  print(pick("abc", 5, true))

test "other len", "98", release: true
  # A guard on the view that is indexed.

  fun pick(t: ?String, s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      return s[i] # proves: index upper
    t[0]

  print(pick("abcd", "ab", 1))

bomb "other len mut", "index out of bounds", release: true
  # A guard on one view's length proves nothing about another's.

  fun pick(t: ?String, s: ?String, at: Int) -> U8
    i = at
    if i < t.len
      return s[i] # keeps: index upper
    0

  print(pick("abcd", "ab", 3))

test "raw", "97", release: true
  # Without the `raw` block the guard stands.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      return s[i] # proves: index upper
    0

  print(pick("abc", 0))

bomb "raw mut", "index out of bounds", release: true
  # Nothing proven before a `raw` block outlives it.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      raw
        i += 1
      return s[i] # keeps: index upper
    0

  print(pick("abc", 2))

test "repoint", "197", release: true
  # A guard on the view `s` holds while `s` is not assigned.

  fun pick(t: ?String, at: Int) -> U8
    s = t
    i = at
    if i < s.len
      u = t[..1]
      return s[i] + u[0] # proves: index upper
    0

  print(pick("abcd", 3))

bomb "repoint mut", "index out of bounds", release: true
  # Assigning the view `s` points it at shorter text: the guard on its old
  # length proves nothing.

  fun pick(t: ?String, at: Int) -> U8
    s = t
    i = at
    if i < s.len
      s = t[..1]
      return s[i] # keeps: index upper
    0

  print(pick("abcd", 3))

test "result bound", "9093 8 3 8"
  # A loop that steps by the size a decoder returns. Every size the decoder
  # can return is a literal from 0 to 4, so under `i < s.len`, which leaves
  # `i` below `s.len <= 2^62 - 1`, `i + d.size` cannot overflow.

  obj Decoded
    rune: Int
    size: Int

  fun bad() -> Decoded
    Decoded(rune: 0xFFFD, size: 1)

  fun multi(s: ?String, i: Int) -> Decoded
    n = 2 if s[i] < 0xE0 else 3
    return bad() if i + n > s.len
    r = Int(s[i] & 0x0F) << 6 | Int(s[i + 1] & 0x3F)
    return Decoded(rune: Int(s[i] & 0x1F) << 6 | Int(s[i + 1] & 0x3F), size: 2) if n < 3
    Decoded(rune: r << 6 | Int(s[i + 2] & 0x3F), size: 3)

  fun rune_after(s: ?String, i: Int) -> Decoded
    if i >= 0 and i < s.len
      b = s[i]
      return Decoded(rune: Int(b), size: 1) if b < 0x80
      return multi(s, i)
    Decoded(rune: 0xFFFD, size: 0)

  fun total(s: ?String) -> Int
    sum = 0
    i = 0
    while i < s.len
      d = rune_after(s, i)
      sum += d.rune
      i += d.size # proves: += no_overflow
    sum

  fun count(s: ?String) -> Int
    n = 0
    i = 0
    while i < s.len
      i += rune_after(s, i).size # proves: += no_overflow
      n += 1
    n

  fun after(s: ?String, i: Int) -> Int
    if i < s.len
      d = rune_after(s, i)
      return i + d.size # proves: + no_overflow
    i

  fun width(b: U8) -> Int
    return 1 if b < 0x80
    return 2 if b < 0xE0
    3

  fun skip(s: ?String) -> Int
    n = 0
    i = 0
    while i < s.len
      i += width(s[i]) # proves: += no_overflow
      n += 1
    n

  s = "h\u{e9}llo \u{20ac}!"
  print(total(s), count(s), after(s, 1), skip(s))

bomb "result bound huge mut", "integer overflow", prints: "3", release: true
  # A literal size past 2^62 is no bound, and a function on a cycle of
  # calls bounds nothing: both adds keep their tests.

  obj Decoded
    rune: Int
    size: Int

  fun huge(s: ?String, i: Int) -> Decoded
    return Decoded(rune: Int(s[i]), size: 1) if s[i] < 0x80
    Decoded(rune: 0xFFFD, size: 0x7FFFFFFFFFFFFFFF)

  fun spin(s: ?String, i: Int, k: Int) -> Decoded
    return spin(s, i, k - 1) if k > 0
    huge(s, i)

  fun total(s: ?String) -> Int
    sum = 0
    i = 0
    while i < s.len
      d = huge(s, i)
      sum += d.rune
      i += d.size # keeps: += no_overflow
    sum

  fun spun(s: ?String) -> Int
    i = 0
    while i < s.len
      i += spin(s, i, 2).size # keeps: += no_overflow
    i

  print(spun("abc"))
  print(total("a\u{e9}"))

test "result bound module", "664"
  # What a function of another module bounds of its result proves the add
  # of its caller: `decode.rune_after` returns a size from 0 to 2.

  use decode

  fun total(s: ?String) -> Int
    sum = 0
    i = 0
    while i < s.len
      d = decode.rune_after(s, i)
      sum += d.rune
      i += d.size # proves: += no_overflow
    sum

  sub main()
    print(total("h\u{e9}llo"))

  file "decode.rig"
    # A decoder in another module, which bounds the size it returns.

    pub obj Decoded
      pub rune: Int
      pub size: Int

    pub fun rune_after(s: ?String, i: Int) -> Decoded
      if i >= 0 and i < s.len
        b = s[i]
        return Decoded(rune: Int(b), size: 1) if b < 0x80
        return multi(s, i)
      Decoded(rune: 0xFFFD, size: 0)

    fun multi(s: ?String, i: Int) -> Decoded
      return bad() if i + 2 > s.len
      Decoded(rune: Int(s[i] & 0x1F) << 6 | Int(s[i + 1] & 0x3F), size: 2)

    fun bad() -> Decoded
      Decoded(rune: 0xFFFD, size: 1)

bomb "result bound mut", "integer overflow", release: true
  # A size the decoder takes from its caller is not bounded, so `i +=
  # d.size` keeps its test: from `i = 1` a size of `Int.max` overflows.

  obj Decoded
    rune: Int
    size: Int

  fun rune_after(s: ?String, i: Int, big: Int) -> Decoded
    return Decoded(rune: Int(s[i]), size: 1) if s[i] < 0x80
    Decoded(rune: 0xFFFD, size: big)

  fun total(s: ?String, big: Int) -> Int
    sum = 0
    i = 0
    while i < s.len
      d = rune_after(s, i, big)
      sum += d.rune
      i += d.size # keeps: += no_overflow
    sum

  print(total("a\u{e9}", Int.max))

bomb "result bound write mut", "integer overflow", release: true
  # A store into the decoded value ends what the decoder bounds: `i +=
  # d.size` keeps its test.

  obj Decoded
    rune: Int
    size: Int

  fun rune_after(s: ?String, i: Int) -> Decoded
    return Decoded(rune: Int(s[i]), size: 1) if s[i] < 0x80
    Decoded(rune: 0xFFFD, size: 2)

  fun total(s: ?String, big: Int) -> Int
    sum = 0
    i = 0
    while i < s.len
      d = rune_after(s, i)
      d.size = big if d.rune == 0xFFFD
      sum += d.rune
      i += d.size # keeps: += no_overflow
    sum

  print(total("a\u{e9}", Int.max))

