test "step", "5", release: true
  # A body that does not write `i` leaves the guard standing for the step.

  fun run(at: Int, n: Int) -> Int
    i = at
    t = 0
    while i < n : i += 1 # proves: += no_overflow
      t += 1
      continue
    t

  print(run(Int.max - 5, Int.max))

bomb "step mut", "integer overflow", release: true
  # A `continue` goes to the step after the body wrote `i`: the step's
  # `i += 1` keeps its test.

  fun run(at: Int, n: Int) -> Int
    i = at
    t = 0
    while i < n : i += 1 # keeps: += no_overflow
      t += 1
      i += 5
      continue
    t

  print(run(Int.max - 5, Int.max))

test "swap half", "[5, 4, 3, 2, 1] [\"d\", \"c\", \"b\", \"a\"]", release: true
  # `!xs.swap(i, j)` is proven when both indexes are: here the first half
  # and its mirror, at any element type.

  sub flip[T](xs: ![]T)
    n = xs.len
    for i in 0..n / 2
      !xs.swap(i, n - 1 - i) # proves: swap lower upper

  a = [1, 2, 3, 4, 5]
  flip(!a[..])
  b = [String("a"), String("b"), String("c"), String("d")]
  flip(!b[..])
  print(a, b)

bomb "swap half mut", "index out of bounds", release: true
  # One index the facts do not prove keeps the tests of both: `n - i` is
  # `n` at `i = 0`.

  sub flip(xs: ![]Int)
    n = xs.len
    for i in 0..n / 2
      !xs.swap(i, n - i) # keeps: swap lower upper

  a = [1, 2, 3, 4, 5]
  flip(!a[..])
  print(a)

test "swar", release: true, '''
  13
  13
  16
  1
'''
  # The loops of a JSON scanner, eight bytes at a time. `rig check
  # --facts=proofs` on this file is compared line by line in
  # test/cli/facts_proofs.sh.

  fun is_digit(c: U8) -> Bool
    c >= 48 and c <= 57

  fun skip_space(s: ?String, at: Int) -> Int
    i = at
    while i < s.len
      c = s[i]
      if c == 32 and i + 8 <= s.len and s.read[U64, .little](i) == 0x2020202020202020
        i += 8
      else if c == 32 or c == 10 or c == 13 or c == 9
        i += 1
      else
        break
    i

  fun take_digits(s: ?String, at: Int) -> Int
    i = at
    while i + 8 <= s.len
      d = s.read[U64, .little](i)
      if d & 0xf0f0f0f0f0f0f0f0 != 0x3030303030303030 or (d +% 0x0606060606060606) & 0xf0f0f0f0f0f0f0f0 != 0x3030303030303030
        break
      i += 8
    while i < s.len and is_digit(s[i])
      i += 1
    i

  fun skip_plain_ascii(s: ?String, at: Int) -> Int
    i = at
    while i + 8 <= s.len
      w = s.read[U64, .little](i)
      if w & 0x8080808080808080 != 0
        break
      i += 8
    for c, k in s[i..]
      return i + k if c >= 128 or c == 34
    s.len

  fun count_high(s: ?String) -> Int
    n = 0
    i = 0
    while i + 8 <= s.len
      w = s.read[U64, .little](i)
      if w & 0x8080808080808080 != 0
        n += 1
      i += 8
    n

  print(skip_space("             x", 0))
  print(take_digits("1234567890123x", 0))
  print(skip_plain_ascii("abcdefghijklmnop\"", 0))
  print(count_high("abcdefgh\u{e9}bcdefgh"))

test "value block", release: true, '''
  1
  99
'''
  # The control for `value_block_mut.rig`: arms that write nothing see what
  # the guard before the statement showed.

  fun pick(s: ?String, at: Int, k: Int) -> U8
    i = at
    if i < s.len
      x = match k
        1
          print(k)
          s[i] # proves: index upper
        _ => s[i] # proves: index upper
      return x
    0

  print(pick("abc", 2, 1))

bomb "value block mut", "index out of bounds", release: true
  # A value that holds statements: an arm of the `match` writes `i`, so
  # no `s[i]` in the statement is proven by the guard before it.

  fun pick(s: ?String, at: Int, k: Int) -> U8
    i = at
    if i < s.len
      x = match k
        1
          i += 1
          s[i] # keeps: index upper
        _ => s[i] # keeps: index upper
      return x
    0

  print(pick("abc", 2, 1))

test "wide read", "7812454979559974501", release: true
  # Room for 8 bytes proves an 8-byte read.

  fun peek(s: ?String, at: Int) -> U64
    i = at
    if i + 8 <= s.len
      return s.read[U64, .little](i) # proves: read upper
    0

  print(peek("abcdefghijkl", 4))

bomb "wide read mut", "byte read out of range", release: true
  # Room for 8 bytes proves nothing about a 16-byte read.

  fun peek(s: ?String, at: Int) -> U128
    i = at
    if i + 8 <= s.len
      return s.read[U128, .little](i) # keeps: read upper
    0

  print(peek("abcdefghijkl", 4))

test "wrapping guard", release: true, '''
  7523094288207667809
  1
'''
  # The checked `i + 8 <= s.len`, from `i = 0`, proves the read.

  fun count(s: ?String) -> Int
    i = 0
    n = 0
    while i + 8 <= s.len
      x = s.read[U64, .little](i) # proves: read lower upper
      n += 1
      print(x)
      i += 8
    n

  print(count("abcdefghij"))

bomb "wrapping guard mut", "byte read out of range", release: true
  # `i +% 8 <= s.len` says nothing about `i + 8`: the sum wraps, the guard
  # passes, and the read keeps both its tests.

  fun count(s: ?String, at: Int) -> Int
    i = at
    n = 0
    while i +% 8 <= s.len
      x = s.read[U64, .little](i) # keeps: read lower upper
      n += 1
      print(x)
      i += 8
    n

  print(count("abcdefghij", Int.max - 3))
