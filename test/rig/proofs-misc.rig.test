# proofs: the rest of its tests.

test "assign order", "[0, 0, 99, 0]", release: true
  # A check in a statement before the assignment proves its target.

  sub put(t: ![]U8, src: ?String, at: Int)
    i = at
    c = t[i]
    t[i] = src[i] + c # proves: index lower upper

  a: [4]U8 = [0, 0, 0, 0]
  put(!a[..], "abcd", 2)
  print(a)

bomb "assign order mut", "index out of bounds", release: true
  # The place of `t[i] = src[i]` may be found before its value runs: the
  # value's check proves nothing about the target.

  sub put(t: ![]U8, src: ?String, at: Int)
    i = at
    t[i] = src[i] # keeps: index lower upper

  a: [4]U8 = [0, 0, 0, 0]
  put(!a[..], "abcd", -1)
  print(a)

test "assign value", "[1, 2, 7]", release: true
  # The value writes another binding: the target's `a[i]` is proven.

  fun next(n: !Int) -> Int
    n += 1
    7

  sub put(a: ![]Int, at: Int)
    i = at
    j = 0
    if i < a.len
      a[i] = next(!j) # proves: index upper

  a = [1, 2, 3]
  put(!a[..], 2)
  print(a)

bomb "assign value mut", "index out of bounds", release: true
  # An assignment's value runs before its target's index: `next(!i)`
  # moves `i` past the guard before `a[i]` is reached.

  fun next(n: !Int) -> Int
    n += 1
    7

  sub put(a: ![]Int, at: Int)
    i = at
    if i < a.len
      a[i] = next(!i) # keeps: index upper

  a = [1, 2, 3]
  put(!a[..], 2)
  print(a)

test "call target compound mut", release: true, '''
  4
  [101, 0, 0, 0]
'''
  # `call_target_mut.rig` with a compound store: the call that writes `i`
  # is a step of the statement, so `s[i]` keeps its test.

  fun pick(t: ![]U8, n: !Int) -> ![]U8 from t
    n += 1
    t

  sub put(t: ![]U8, s: ?String, at: Int)
    i = at
    if i < s.len
      pick(!t, !i)[0] += s[i] # keeps: index upper
    print(i)

  a: [4]U8 = [1, 0, 0, 0]
  put(!a[..], "abcd", 3)
  print(a)

test "call target mut", release: true, '''
  4
  [100, 0, 0, 0]
'''
  # The target's root is a call that writes `i`: whichever of the call and
  # the value runs first, nothing the guard showed of `i` is known while
  # the statement runs, so `s[i]` keeps its test.

  fun pick(t: ![]U8, n: !Int) -> ![]U8 from t
    n += 1
    t

  sub put(t: ![]U8, s: ?String, at: Int)
    i = at
    if i < s.len
      pick(!t, !i)[0] = s[i] # keeps: index upper
    print(i)

  a: [4]U8 = [0, 0, 0, 0]
  put(!a[..], "abcd", 3)
  print(a)

test "check then sub", "194", release: true
  # `c = s[i]` shows `0 <= i` and `i < s.len` for what follows.

  fun peek(s: ?String, at: Int) -> U8
    i = at
    c = s[i]
    return c + s.read[U8](i) # proves: read lower upper

  print(peek("abc", 0))

bomb "check then sub mut", "byte read out of range", release: true
  # `c = s[i]` showed `0 <= i`; `i -= 1` ends it.

  fun peek(s: ?String, at: Int) -> U8
    i = at
    c = s[i]
    i -= 1
    return c + s.read[U8](i) # keeps: read lower

  print(peek("abc", 0))

test "closure", "99", release: true
  # A closure that writes another binding leaves `i`'s guard standing.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    j = 0
    if i < s.len
      f = |!j| j += 1
      f()
      return s[i] # proves: index upper
    0

  print(pick("abc", 2))

bomb "closure mut", "index out of bounds", release: true
  # A closure made after the guard, lent `i` to write, changes it when
  # called.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      f = |!i| i += 1
      f()
      return s[i] # keeps: index upper
    0

  print(pick("abc", 2))

test "cond continue", "5", release: true
  # Without a `continue` in the condition, every path to the step passed the
  # guard.

  fun pick(i: Int) -> Int?
    if i % 2 == 0
      return i
    none

  fun run(at: Int, n: Int) -> Int
    i = at
    t = 0
    while i < n and (pick(i) ?? 0) >= 0 : i += 1 # proves: += no_overflow
      t += 1
    t

  print(run(Int.max - 5, Int.max))

bomb "cond continue mut", "integer overflow", release: true
  # A `continue` in the condition reaches the step before the guard after it
  # ran: the step's `i += 1` keeps its test.

  fun pick(i: Int) -> Int?
    none

  fun run(at: Int, n: Int) -> Int
    i = at
    t = 0
    while (pick(i) ?? continue) > 0 and i < n : i += 1 # keeps: += no_overflow
      t += 1
    t

  print(run(Int.max, Int.max))

test "defer", release: true, '''
  2
  done
  99
'''
  # A `defer` that writes nothing the guard named.

  fun pick(s: ?String, at: Int, flag: Bool) -> U8
    i = at
    if i < s.len
      if flag
        defer print("done")
        print(i)
      return s[i] # proves: index upper
    0

  print(pick("abc", 2, true))

bomb "defer mut", "index out of bounds", prints: "2", release: true
  # A `defer` in an inner block runs where that block ends, before the use.

  fun pick(s: ?String, at: Int, flag: Bool) -> U8
    i = at
    if i < s.len
      if flag
        defer i += 1
        print(i)
      return s[i] # keeps: index upper
    0

  print(pick("abc", 2, true))

test "else branch", "99", release: true
  # The true edge proves the use.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      return s[i] # proves: index upper
    else
      print("out of range")
    0

  print(pick("abc", 2))

bomb "else branch mut", "index out of bounds", release: true
  # A guard's false edge proves nothing.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      print("in range")
    else
      return s[i] # keeps: index upper
    0

  print(pick("abc", 5))

test "field", "99", release: true
  # A local copy of the field is a subject.

  obj Cursor
    i: Int

  fun pick(s: ?String, c: ?Cursor) -> U8
    i = c.i
    if i < s.len
      return s[i] # proves: index upper
    0

  c = Cursor(i: 2)
  print(pick("abc", ?c))

bomb "field mut", "index out of bounds", release: true
  # A field is never a fact's subject: `(!@).bump()` writes it.

  obj Cursor
    i: Int

    sub bump(!@)
      @i += 1

  fun pick(s: ?String, c: !Cursor) -> U8
    if c.i < s.len
      (!c).bump()
      return s[c.i] # keeps: index upper
    0

  c = Cursor(i: 2)
  print(pick("abc", !c))

test "generic width", "1717920867", release: true
  # A concrete width in a generic body.

  fun peek[T](s: ?String, at: Int, d: T) -> U32
    i = at
    if i + 4 <= s.len
      return s.read[U32, .little](i) # proves: read upper
    0

  print(peek[U64]("abcdef", 2, 0))

bomb "generic width mut", "byte read out of range", release: true
  # In a generic body the width of `read[T]` is not known: a guard for 4
  # bytes proves nothing about a `U64` read.

  fun peek[T](s: ?String, at: Int, d: T) -> T
    i = at
    if i + 4 <= s.len
      return s.read[T, .little](i) # keeps: read upper
    d

  print(peek[U64]("abcdef", 2, 0))

test "guard add", "99", release: true
  # A guard proves `s[i]` when nothing writes `i` between them.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      return s[i] # proves: index upper
    0

  print(pick("abc", 2))

bomb "guard add mut", "index out of bounds", release: true
  # A guard proves `s[i]`, but `i += 1` between them ends the proof.

  fun pick(s: ?String, at: Int) -> U8
    i = at
    if i < s.len
      i += 1
      return s[i] # keeps: index upper
    0

  print(pick("abc", 2))

test "guard overflow", "2", release: true
  # The same loop from 0 runs.

  fun count(s: ?String, at: Int) -> Int
    i = at
    n = 0
    while i + 8 <= s.len
      n += 1
      i += 8 # proves: += no_overflow
    n

  print(count("abcdefghijklmnopq", 0))

bomb "guard overflow mut", "integer overflow", release: true
  # The loop's own `i + 8` is not proven at its entry: from `Int.max - 3` it
  # overflows.

  fun count(s: ?String, at: Int) -> Int
    i = at
    n = 0
    while i + 8 <= s.len # keeps: + no_overflow
      n += 1
      i += 8
    n

  print(count("abcdefghij", Int.max - 3))

test "half range", "[5, 4, 3, 2, 1]", release: true
  # `for i in 0..n / 2`, with `n = xs.len`, has `i + 1 <= n`, since
  # `n / 2 <= n`: `xs[i]` is in range, and so is `xs[n - 1 - i]`, the
  # index counted down from the end, as `0 <= i`.

  sub flip(xs: ![]Int)
    n = xs.len
    for i in 0..n / 2
      t = xs[i] # proves: index lower upper
      xs[i] = xs[n - 1 - i] # proves: index lower upper
      xs[n - 1 - i] = t # proves: index lower upper

  a = [1, 2, 3, 4, 5]
  flip(!a[..])
  print(a)

bomb "half range inclusive mut", "index out of bounds", release: true
  # `0..=n / 2` reaches `n / 2`, which is `n` itself when `n` is 0: `xs[i]`
  # keeps its upper test.

  fun total(xs: []Int) -> Int
    n = xs.len
    t = 0
    for i in 0..=n / 2
      t += xs[i] # keeps: index upper
    t

  a = [1, 2, 3]
  print(total(a[..0]))

test "held as", release: true, '''
  drop 99
  198
'''
  # An `if ... as` over a part of a value the header makes holds that
  # value before the test (`Header.held`): the held value is the `as`
  # part's code, so a guard before the `if` proves `s[i]` in it and in the
  # body.

  obj Res
    n: Int

    drop(!@)
      print("drop", @n)

  obj Bag
    o: Res?

  fun mk(c: U8) -> Bag
    Bag(o: Res(n: Int(c)))

  fun pick(s: ?String, at: Int) -> Int
    i = at
    if i < s.len
      if mk(s[i]).o as r # proves: index upper
        return r.n + Int(s[i]) # proves: index upper
    0

  print(pick("abc", 2))

test "index writes mut", release: true, '''
  4
  [100, 0, 0, 0]
'''
  # The target's index writes `i`: the value's `s[i]` keeps its test, and
  # the guard proves nothing in the statement.

  fun next(n: !Int) -> Int
    n += 1
    n

  sub put(t: ![]U8, s: ?String, at: Int)
    i = at
    if i < s.len
      t[next(!i) - 4] = s[i] # keeps: index upper
    print(i)

  a: [4]U8 = [0, 0, 0, 0]
  put(!a[..], "abcd", 3)
  print(a)

test "int bound", "9223372036854775807", release: true
  # `i < n` leaves room for one: `i += 1` fits.

  fun step(at: Int, n: Int) -> Int
    i = at
    if i < n
      i += 1 # proves: += no_overflow
    i

  print(step(Int.max - 1, Int.max))

bomb "int bound mut", "integer overflow", release: true
  # `i <= n` leaves no room above `i`: `i += 1` keeps its test.

  fun step(at: Int, n: Int) -> Int
    i = at
    if i <= n
      i += 1 # keeps: += no_overflow
    i

  print(step(Int.max, Int.max))

test "int bound write", "4", release: true
  # Nothing writes `n`: `i + 1` fits.

  fun step(s: ?String, at: Int) -> Int
    n = s.len
    i = at
    if i < n
      return i + 1 # proves: + no_overflow
    0

  print(step("abcd", 3))

test "int bound write mut", "6", release: true
  # Writing the bound `n` ends the guard `i < n`: the add keeps its test.
  # (`n` is no length here, so nothing the guard showed outlives the write;
  # its twin `len_equal_write.rig` keeps what `n = s.len` lets the guard
  # show of `s`.)

  fun step(m: Int, at: Int) -> Int
    n = m
    i = at
    if i < n
      n -= 2
      return i + 1 + n # keeps: + no_overflow
    0

  print(step(4, 3))

test "len equal", "3", release: true
  # `n = s.len` makes `n` stand for the length while neither changes: a
  # guard on `n` proves an index into `s`.

  fun count(src: ?String) -> Int
    n = src.len
    i = 0
    while i < n and src[i] != 0 # proves: index lower upper
      i += 1 # proves: += no_overflow
    i

  print(count("abc"))

test "len equal add", "6", release: true
  # After `n = s.len`, the guard `i < n` shows `i + 1 <= s.len`, which
  # stays true when `n` changes, since `i` and `s` do not: `i + 1` fits.

  fun step(s: ?String, at: Int) -> Int
    n = s.len
    i = at
    if i < n
      n -= 2
      return i + 1 + n # proves: + no_overflow
    0

  print(step("abcd", 3))

bomb "len equal mut", "index out of bounds", release: true
  # Re-pointing `s` after `n = s.len` ends what `n` said of its length: a
  # guard on `n` proves nothing about the shorter `s`.

  fun get(t: ?String, at: Int) -> U8
    s = t
    n = s.len
    s = t[..1]
    i = at
    if i < n
      return s[i] # keeps: index upper
    0

  print(get("abc", 2))

test "len equal write", "99", release: true
  # A guard on `n` once `n = s.len` proves `i < s.len`, which stays true
  # when `n` changes later, since `i` and `s` do not.

  fun get(s: ?String, at: Int) -> U8
    n = s.len
    i = at
    if i < n
      n -= 2
      return s[i] # proves: index upper
    0

  print(get("abc", 2))

test "lend arg", "4", release: true
  # `bump(!j)` writes another binding: `a[i]` is proven.

  sub bump(n: !Int)
    n += 1

  fun pick(a: []Int, at: Int) -> Int
    i = at
    j = 0
    if i < a.len
      bump(!j)
      return a[i] + j # proves: index upper
    0

  a = [1, 2, 3]
  print(pick(a[..], 2))

bomb "lend arg mut", "index out of bounds", release: true
  # `bump(!i)` writes `i` after the guard: `a[i]` keeps its test.

  sub bump(n: !Int)
    n += 1

  fun pick(a: []Int, at: Int) -> Int
    i = at
    if i < a.len
      bump(!i)
      return a[i] # keeps: index upper
    0

  a = [1, 2, 3]
  print(pick(a[..], 2))

test "loop", "6", release: true
  # A guard before a loop holds in it when the loop does not write what it
  # named.

  fun total(a: []Int, at: Int) -> Int
    i = at
    t = 0
    if i < a.len
      k = 0
      while k < 2
        t += a[i] # proves: index upper
        k += 1
    t

  a = [1, 2, 3]
  print(total(a[..], 2))

test "loop else", "99", release: true
  # The loop's body sees its guard.

  fun last(s: ?String) -> U8
    i = 0
    c: U8 = 0
    while i < s.len
      c = s[i] # proves: index lower upper
      i += 1
    else
      return c
    0

  print(last("abc"))

bomb "loop else mut", "index out of bounds", release: true
  # A loop's `else` runs when its condition fails: it sees no guard.

  fun last(s: ?String) -> U8
    i = 0
    while i < s.len
      i += 1
    else
      return s[i] # keeps: index upper
    0

  print(last("abc"))

bomb "loop mut", "index out of bounds", release: true
  # A guard before a loop proves nothing in it about a binding the loop
  # writes: the second iteration reads past the end.

  fun total(a: []Int, at: Int) -> Int
    i = at
    t = 0
    if i < a.len
      k = 0
      while k < 2
        t += a[i] # keeps: index upper
        i += 1
        k += 1
    t

  a = [1, 2, 3]
  print(total(a[..], 2))

test "match arm", release: true, '''
  1
  99
'''
  # An arm that writes another binding.

  fun pick(s: ?String, at: Int, k: Int) -> U8
    i = at
    j = 0
    if i < s.len
      match k
        1 => j += 1
        _ => pass
      print(j)
      return s[i] # proves: index upper
    0

  print(pick("abc", 2, 1))

bomb "match arm mut", "index out of bounds", release: true
  # A `match` arm that writes `i` ends the guard after the `match`.

  fun pick(s: ?String, at: Int, k: Int) -> U8
    i = at
    if i < s.len
      match k
        1 => i += 1
        _ => pass
      return s[i] # keeps: index upper
    0

  print(pick("abc", 2, 1))

test "match guard", "99", release: true
  # A guard that writes another binding.

  fun bump(n: !Int) -> Bool
    n += 1
    false

  fun pick(s: ?String, at: Int, k: Int) -> U8
    i = at
    j = 0
    if i < s.len
      match k
        1 if bump(!j) => print(1)
        _ => return s[i] # proves: index upper
    0

  print(pick("abc", 2, 1))

bomb "match guard mut", "index out of bounds", release: true
  # An arm runs after the guards before it failed: a guard that writes `i`
  # ends the facts every later arm would use.

  fun bump(n: !Int) -> Bool
    n += 1
    false

  fun pick(s: ?String, at: Int, k: Int) -> U8
    i = at
    if i < s.len
      match k
        1 if bump(!i) => print(1)
        _ => return s[i] # keeps: index upper
    0

  print(pick("abc", 2, 1))

bomb "mirror bound mut", "index out of bounds", release: true
  # `n - 1 - i` is below the length only when `n` is the length: here it
  # is one more, so the index keeps its upper test, though `i < n / 2`
  # still proves its lower one.

  fun total(xs: []Int) -> Int
    n = xs.len + 1
    t = 0
    for i in 0..n / 2
      t += xs[n - 1 - i] # proves: index lower
    t

  a = [1, 2, 3]
  print(total(a[..]))

bomb "mirror room mut", "index out of bounds", release: true
  # `n - 2 - i` needs `i + 2 <= n`, which `0..n` does not give: the index
  # keeps its lower test.

  fun total(xs: []Int) -> Int
    n = xs.len
    t = 0
    for i in 0..n
      t += xs[n - 2 - i] # keeps: index lower
    t

  a = [1, 2, 3]
  print(total(a[..]))

test "negative start", release: true, '''
  7523094288207667809
  1
'''
  # From `i = 0`, `0 <= i` holds through `i += 8`.

  fun count(s: ?String) -> Int
    i = 0
    n = 0
    while i + 8 <= s.len
      x = s.read[U64, .little](i) # proves: read lower upper
      print(x)
      n += 1
      i += 8
    n

  print(count("abcdefghij"))

bomb "negative start mut", "byte read out of range", release: true
  # Nothing shows `0 <= i` when `i` starts below 0: the read keeps its
  # sign test.

  fun count(s: ?String, at: Int) -> Int
    i = at
    n = 0
    while i + 8 <= s.len
      x = s.read[U64, .little](i) # keeps: read lower
      print(x)
      n += 1
      i += 8
    n

  print(count("abcdefghij", -5))

test "or guard", "99", release: true
  # `and` makes a fact from each side.

