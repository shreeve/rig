  # Room for 15 bytes proves nothing about a 16-byte vector's read: at
  # `s.len - 15` it runs one byte past the end.

  fun scan(s: ?String, at: Int) -> Int
    i = at
    n = 0
    while i + 15 <= s.len
      v = s.read[Simd[U8, 16]](i) # keeps: read upper
      n += Int(v[0])
      i += 16
    n

  s = "abcdefghijklmnopqrstuvwxyz"
  print(scan(s, 0))
  print(scan(s, s.len - 15))

test "simd read", release: true, '''
  11
  25443
  [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 0, 0, 0, 0, 0, 0, 0, 0]
'''
  # Room for a vector's bytes proves its read and its write, as it proves a
  # `read` of an integer of as many bytes: a `Simd[T, n]` is `n` times the
  # size of `T`.

  fun count_a(s: ?String) -> Int
    n = 0
    i = 0
    while i + 16 <= s.len : i += 16
      v = s.read[Simd[U8, 16]](i) # proves: read lower upper
      n += Int((v == 0x61).bits().count_ones())
    n

  fun wide_lanes(s: ?String, at: Int) -> Int
    i = at
    if i + 16 <= s.len
      w = s.read[Simd[U16, 8], .little](i) # proves: read upper
      f = s.read[Simd[F32, 4], .little](i) # proves: read upper
      return Int(w[0]) + (1 if f[3] != 0.0 else 0)
    0

  sub fill(t: ![]U8, b: U8)
    i = 0
    while i + 16 <= t.len : i += 16
      !t.write[Simd[U8, 16]](i, Simd[U8, 16].splat(b)) # proves: write lower upper

  print(count_a("abcabcabcabcabcabcabcabcabcabcabcabc"))
  print(wide_lanes("abcdefghijklmnopq", 1))
  a: [40]U8 = [40 of 0]
  fill(!a[..], 7)
  print(a)

