test "a spread shares a handle field by `..+` and moves it by `..<`", "1 2\n1 2"
  obj Box
    n: Int

  obj Hold
    b: *Box
    k: Int = 1

  sub show(..h: Hold)
    print(h.k, h.b.n)

  a = Hold(b: *Box(n: 2))
  show(..+a)
  show(..<a)

