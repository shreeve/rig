    n: Int = 1
    name: String = String()

  s = Seed()
  t = Seed(n: 2, ..<s)
  u = Seed(n: 3, ..+s)
  print(t.n, u.n)

test "a field with a drop body or a unique type moves in a group and an update", "a 1\nclose a\nb 2\nclose b\n5"
  obj File
    name: String

    drop(!@)
      print("close", @name)

  obj Seed unique
    n: Int = 5

  obj Job
    f: File
    tries: Int = 1

  obj Gen
    s: Seed

  sub run(..j: Job)
    print(j.f.name, j.tries)

  sub gen(..g: Gen)
    print(g.s.n)

  run(f: File(name: String("a")))
  j = Job(f: File(name: String("b")))
  k = Job(tries: 2, ..<j)
  print(k.f.name, k.tries)
  <k
  gen(s: Seed())
