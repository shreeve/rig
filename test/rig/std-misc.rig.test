'''
  # BigInt's add, sub, mul, compare, and equals against Python's int:
  # Go's sumZZ and prodZZ vectors, the values at limb boundaries paired
  # every way, and random numbers of 1 to 9 limbs. Each line is a and b,
  # then a + b, a - b, a * b, compare, and equals.

  sub show(x: ?String, y: ?String)!
    a = bigint.parse(x)!
    b = bigint.parse(y)!
    print(a.text(), b.text(), a.add(b).text(), a.sub(b).text(), a.mul(b).text(), a.compare(b), a.equals(b))

  sub main()!
    # Go's sumZZ and prodZZ.
    show("0", "0")!
    show("1", "0")!
    show("123456789", "987654321")!
    show("-1", "0")!
    show("-123456789", "987654321")!
    show("-123456789", "-987654321")!
    show("991", "-991")!
    show("1234567890123456789", "-987654321")!
    for x in ["0", "1", "-1", "9223372036854775807", "9223372036854775808", "18446744073709551615", "-18446744073709551615", "18446744073709551616", "18446744073709551617", "-340282366920938463463374607431768211456", "340282366920938463463374607431768211455", "10000000000000000000000000000000000000000", "-10000000000000000000000000000000000000007", "515377520732011331036461129765621272702107522001"]
      for y in ["0", "1", "-1", "9223372036854775807", "9223372036854775808", "18446744073709551615", "-18446744073709551615", "18446744073709551616", "18446744073709551617", "-340282366920938463463374607431768211456", "340282366920938463463374607431768211455", "10000000000000000000000000000000000000000", "-10000000000000000000000000000000000000007", "515377520732011331036461129765621272702107522001"]
        show(x, y)!
    for p in [["-1860903800198095183808957185706010987375043379335640245723", "184177705870766014192110985461552122655927477824957144547112234609521675477490313137631602203763683078400590950101758729247705112762187061605831803354446799516197249168687013"], ["-10392716316822846872", "8097541682777998953965251151911813564513896878094419333133209227495582455154014273156703514062519804858339972024408353599944467698837143157568984522625145"], ["-10255833792965483033", "-10198135509002029339018488254494601072868041202287045124154643247867651043572594911287900500061659231161383147499989181774180248728699504352251836859794687"], ["8015881082569549484869420076489091707968486823763079548404379444292730821244636466252675942732910391071267957823039411443872114068380035899549815987528144", "870769847675744914084423184858137461959401043235176770121057087698818023340017324949412593534631863403918898605058496819446705184512289204820322580474918"], ["-598440965181049341760924119208561601982694597034123489944872905269876534389923444841138990392470096021346208514417513956522935693947855", "-169882716520915340791389123130726086598495266216361456585796699090353068956622570371755148025739917418342996224070577025529577327085329360034339392363434705861102463886831100"], ["142434485153189063323760375601089024320312968549756494186934309503943964584599267649759301935658914845470997321373231169480518256241687", "-125700091766927384532222149244199049237"], ["1143589156606615661", "12713738046129548594"], ["-3395159516580109576", "75352512277158495737205349755204108323042879681203011753126092784501939109231"], ["-62422505862043915152087367508053840205", "1216904289071276656"], ["3419880252196476063384730293923172513411506203200349719176", "6402664592405953213455702667236811726739758170676215305245068538522164034116280538973299277194735615613382999261294"], ["14713197994114646228", "-3512911754107777729894964066708403135357336135639799419973"], ["10026570987937526214163529421320155839827037430890426343220329152785933195572611913676271258611341768860861447437230652513783801105202747851465823554691825", "18113716367507085297927984348124191495897038911481586153563560249582958804809960189906904108407096912555739498679107"], ["1463906939266343357443733878118190403262553456087316375708929162258189007316503389269683550438809127669049560165789", "-88440197567206989386075271882817641960217355237606874039175317083749885363677409745947459058454557903369691192507450611028246467300291708844448409255366177753591647515077646"], ["-139640893998368791588288570491701362408", "46201747052369592920355997733408056713841650209551859653664423208108606658348"], ["842046371258989822130605594596350398429741731396407672309678561993703375262457466480642507661944", "-16964007324025152734576869014252323198656021899232552676604330841256715718206546012208273050656550681521156236698793"], ["340116358917560661097811654551682002435", "-517314091847862731783335559871590416035021117145565118099403320085411198927898357007868470822317386426667108547912174103443049362180905"], ["435129666533925269048450189833613619869899651667280111828162943627460180928537239736217739046759304030396813274623055088908762599870653", "-1331174768235624680615109567738778334755870927780480131609314341702063464448024166656021300688117"], ["-2198370736617773064523815900239802020063475822363559705798", "-163360631166670173508365637506578596696549956984901743962536041588185355384373318205606605297673009717185318518213500190121533471519317924471118700238933865825810086059271800"], ["5511527101799694597920032658305547301772205277579931121222", "2495683795383128599"], ["194519489653491523852241858569396006199325506958552604773048148939000470211869786919161527968967791832182589272493290513493003120961580", "5596724826089896519277849728045245584455313319045666444539054557717725209056664912184588665386865083963552164925640136612162347220523267529164295352195192"], ["51118781577076927791012062191306414040171328227229471529613523222183985244880034015057859809123407064687417905367102569290887966289796271228154444850817334360794550367019936", "-61051968925196675473805248449179788826053486698767847633046293166192719184942951110920576176106863906948781333663649580767497182627129476073948072664870849184232312229494169"], ["-5044343007134110102", "729514730531077799"], ["-412200808168708935390539316241062589348492187709721565687315080858472406005188525651902034286134269748694903896941448413570209035835379", "1497996150880676035597784525086541443192592515398616404828868707007106450616182678540771002465113859463783669568693947921553480661676303240024570131814552"], ["10630413082652111515984317386581786200110004768899438426187261509948294483223733236440243778989212194076834610781125984768409478445907761745169833018775397", "-208682933523894380788813429589889800159695043367952469986513038078293815984983553151512390380915982538445665444855767299148010515527023528355945356057824165462245386376334843"]]
      show(p[0], p[1])!

bomb "bigint bad base panics", "bigint.parse: the base is not 0 or between 2 and 36"
  # A base is 0, for one the text names, or from 2 to 36.

  print((bigint.parse("1", 37) catch bigint.from_int(0)).text())

bomb "bigint base one panics", "bigint.parse: the base is not 0 or between 2 and 36"
  # A base of 1 reads nothing, so it is a misuse too.

  print((bigint.parse("0", 1) catch bigint.from_int(0)).text())

fail "bigint misuse", "6:7: `==` is not defined for `bigint.BigInt`: field `limbs` is a `List[U64]`, which has no `==`", "7:7: operator `<` orders numbers, plain enums, Strings, and `[]U8` slices; got `bigint.BigInt`", "8:12: only the standard library's module `std.bigint` can construct `std.bigint.BigInt`: its fields `neg`, `limbs` are private; make one with its `pub` functions", "9:9: field `neg` of `std.bigint.BigInt` is private to the standard library's module `std.bigint`", errors: 4
  # A BigInt is compared by its methods and made by `parse` and
  # `from_int`: it has no `==` or `<`, and no fields to read or set.

  a = bigint.from_int(1)
  b = bigint.from_int(2)
  print(a == b)
  print(a < b)
  c = bigint.BigInt(neg: false, limbs: List())
  print(a.neg, c.text())

test "bigint parse", '''
  "" 0 ParseError.invalid
  "a" 0 ParseError.invalid
  "z" 0 ParseError.invalid
