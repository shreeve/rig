  # copy it out of its cell.

  r = random.Random.seeded(1)
  s = random.Random.seeded(1)
  print(r == s)
  c = *Cell(random.Random.seeded(4))
  t = c.get()

test "random wide ranges", '''
  0
  true
'''
  # `int(lo, hi)` takes any range with `lo < hi`, up to the whole of
  # `Int` but its maximum, and stays inside it.

  r = random.Random.seeded(9)
  bad = 0
  n = 0
  while n < 2000 : n += 1
    a = (!r).int(-1, Int.max)
    b = (!r).int(Int.min, 1)
    c = (!r).int(Int.min, Int.max)
    d = (!r).int(Int.max - 1, Int.max)
    e = (!r).int(Int.min, Int.min + 1)
    if a < -1 or b > 0 or c == Int.max or d != Int.max - 1 or e != Int.min
      bad += 1
  print(bad)
  lows = 0
  n = 0
  while n < 1000 : n += 1
    if (!r).int(Int.min, Int.max) < 0
      lows += 1
  print(lows > 400 and lows < 600)

test "slices", '''
  [4, 3, 2, 1] true false 3 none
  [3, 2, 1] false none
  ["a", "b", "a"] 0 false
'''
  # std.slices: `reverse` in place, and the linear `contains` and
  # `index_of`, on arrays and on Vecs through a slice.

  a = [1, 2, 3, 4]
  slices.reverse(!a)
  print(a, slices.contains(?a, 3), slices.contains(?a, 5), slices.index_of(?a, 1), slices.index_of(?a, 9))
  odd = [1, 2, 3]
  slices.reverse(!odd)
  empty: [0]Int = []
  slices.reverse(!empty)
  print(odd, slices.contains(?empty, 1), slices.index_of(?empty, 1))
  v: List[?String] = List()
  !v.push("a")
  !v.push("b")
  !v.push("a")
  slices.reverse(!v[..])
  print(v, slices.index_of(?v[..], "a"), slices.contains(?v[..], "c"))

test "sort", '''
  [1, 3, 3, 5, 7, 9]
  [9, 7, 5, 3, 3, 1]
  1 5 none none
  1 3 0 6
  ["apple", "fig", "fig", "pear"] 1 none 3
  none 0
  true
'''
  # std.sort: `sort` and `sort_by` sort in place and keep equal elements in
  # their order, at every size (runs of 20 merged in place), on arrays and
  # on Vecs through a slice; `lower_bound` and `search` find by binary
  # search.

  obj P
    key: Int
    id: Int

  fun sorted(xs: []Int) -> Bool
    for x, i in xs
      if i > 0 and xs[i - 1] > x
        return false
    true

  fun stable(ps: []P) -> Bool
    for p, i in ps
      if i > 0
        q = ps[i - 1]
        if q.key > p.key or (q.key == p.key and q.id > p.id)
          return false
    true

  a = [5, 3, 9, 1, 7, 3]
  sort.sort(!a)
  print(a)
  sort.sort_by(!a, |x, y| x > y)
  print(a)
  sort.sort(!a)
  print(sort.search(?a, 3), sort.search(?a, 9), sort.search(?a, 4), sort.search(?a, 0))
  print(sort.lower_bound(?a, 3), sort.lower_bound(?a, 4), sort.lower_bound(?a, 0), sort.lower_bound(?a, 10))
  words = ["pear", "fig", "apple", "fig"]
  sort.sort(!words)
  print(words, sort.search(?words, "fig"), sort.search(?words, "kiwi"), sort.lower_bound(?words, "kiwi"))
  empty: [0]Int = []
  sort.sort(!empty)
  print(sort.search(?empty, 1), sort.lower_bound(?empty, 1))

  r = random.Random.seeded(3)
  ok = true
  for n in [0, 1, 2, 19, 20, 21, 39, 40, 41, 100, 257, 1000]
    v: List[Int] = List()
    ps: List[P] = List()
    for i in 0..n
      !v.push((!r).int(-50, 50))
      !ps.push(P(key: (!r).int(0, 8), id: i))
    sort.sort(!v[..])
    sort.sort_by(!ps[..], |x, y| x.key < y.key)
    ok = ok and sorted(?v[..]) and stable(?ps[..]) and v.len == n
    slices.reverse(!v[..])
    slices.reverse(!v[..])
    ok = ok and sorted(?v[..])
    if n > 0
      k = v[n / 2]
      i = sort.lower_bound(?v[..], k)
      ok = ok and v[i] == k and (i == 0 or v[i - 1] < k) and sort.search(?v[..], k) == i
  print(ok)

fail "sort needs order", "8:6: `sort.sort[P]` cannot use `T = P`: the generic body applies `<` to `T`", "`<` used on `T` here"
  # `sort` orders with `<`, which a struct does not have: sort it with
  # `sort_by` and a comparator instead.

  obj P
    x: Int

  ps = [P(x: 2), P(x: 1)]
  sort.sort(!ps)

test "target arch", '''
  true true
  true true
  true
  true
  true true .riscv64
  513
  25
'''
  # `target.arch` is a compile-time value of the built-in enum `Arch`,
  # which Zig sets for the target: Rig checks both branches of a choice
  # on it, and Zig keeps one. The output holds on x86_64 and aarch64.

  TIER = 0 if target.arch == .x86_64 else 16
  KNOWN = target.arch == .x86_64 or target.arch == .aarch64
  ORDER: Endian = .big if target.arch == .s390x else .little
  HERE: Arch = target.arch

  fun family(a: Arch) -> Static
    match a
      .x86_64, .x86 => "x86"
      .aarch64, .arm => "arm"
      _ => "other"

  fun lanes[a: Arch]() -> Int
    if a == .x86_64
      return 32
    16

  fun scan_from(tier: Int) -> Int
    # A per-target constant in run-time arithmetic is checked when it runs.
    tier * 2 + 1

  sub main()
    print(KNOWN, family(target.arch) != "other")
    print(TIER == 0 or TIER == 16, (TIER == 0) == (target.arch == .x86_64))
    print(lanes[target.arch]() == (32 if HERE == .x86_64 else 16))
    print(scan_from(TIER) == 2 * TIER + 1)
    local =! target.arch
    print(local == HERE, target.arch != .wasm32, Arch.riscv64)
    b: [2]U8 = [1, 2]
    print(b.read[U16, ORDER](0))
    x: U8 = 200
    x >>= 3 if target.arch == .x86_64 else 3
    print(x)

fail "target arch const arithmetic", "8:15: the operands of a module constant's arithmetic must be known when Rig checks the program; the value of `TIER`", "9:10: the operands of a module constant's arithmetic must be known", "10:8: the operands of a module constant's arithmetic must be known", "11:10: the operands of a module constant's arithmetic must be known", "12:9: the operands of a module constant's arithmetic must be known", errors: 5
  # A module constant's arithmetic is computed when Rig checks the
  # program, and Zig computes it again when it compiles: on an operand the
  # target sets, Rig could not see the overflow or division by zero Zig
  # stops at (100 / TIER divides by zero on x86_64 only). So it is
  # rejected on every machine; write each branch's value instead.

  TIER = 0 if target.arch == .x86_64 else 16
  RATIO = 100 / TIER
  DOUBLE = TIER * 2
  NEG = -TIER
  TABLE = [TIER << 2, 1]
  WIDE = (TIER + 1) * 2
  OK = 0 if target.arch == .x86_64 else 32
  SAME = TIER == 0 and OK > 1

  sub main()
    print(RATIO, DOUBLE, NEG, TABLE, WIDE, SAME)

bomb "target arch shift panics", "integer does not fit"
  # A shift by a per-target constant is checked when the program runs, as
  # a shift by any value Rig does not know is: Zig does not reject it
  # when it compiles.

  BIG = 16 if target.arch == .x86_64 else 16

  sub main()
    x: U8 = 2
    x >>= BIG
    print(x)

fail "target arch values", "8:8: an enum value must be known when Rig checks the program; the value of `LANES` is chosen for each target", "14:7: an array length must be known when Rig checks the program; the value of `TIER` is chosen for each target", "15:16: compile-time argument 2 of `Simd` must be known when Rig checks the program; the value of `LANES`", "16:15: compile-time argument 1 of `twice` must be known when Rig checks the program; the value of `TIER`", "18:15: the number of lanes `lag` takes must be known when Rig checks the program; the value of `LANES`", "20:5: the bounds of a range pattern must be known when Rig checks the program; the value of `LANES`", "23:7: an array length must be known when Rig checks the program; the value of `k` is chosen for each target"
  # Rig never assumes the value of `target.arch`, or of a constant that
  # names it: a place that needs the value is rejected on every machine.

  TIER = 0 if target.arch == .x86_64 else 16
  LANES = 16 if target.arch == .x86_64 else 16

  enum Code
    ok = LANES

  fun twice[n: Int]() -> Int
    n * 2

  sub main()
    a: [TIER]U8 = [4 of 0]
    v = Simd[U8, LANES].splat(1)
    print(twice[TIER]())
    w = Simd[U8, 16].splat(1)
    print(w.lag[LANES](w))
    match 5
      0..LANES => print("low")
      _ => print("high")
    k =! TIER
    c: [k]U8 = [4 of 0]
    print(a, v, c, Code.ok)

test "target markers", "true false", release: true
  # The markers are checked over every `extern zig` block, std.target's
  # Zig-backed constant `arch` among them, and mark functions that read it.

  inline fun lanes() -> Int
    32 if target.arch == .x86_64 else 16

  called fun bytes[a: Arch]() -> Int
    64 if a == .x86_64 else 32

  rarely fun unknown(a: Arch) -> Bool
    a != .x86_64 and a != .aarch64

  sub main()
    print(lanes() * 2 == bytes[target.arch](), unknown(target.arch))

test "time", '''
  true true true
  true true
  true
  1 1000 1000000 1000000000 60000000000
'''
  # std.time: `now()` is an Instant of the monotonic clock, which never
  # goes back; `sleep` waits at least as long as asked; the wall clock is
  # past 2023. Durations are `Int` nanoseconds.

  fun waited(start: time.Instant) -> Int
    start.elapsed()

  start = time.now()
  time.sleep(3 * time.MS)
  later = time.now()
  took = later.since(start)
  print(took >= 3 * time.MS, took < 10 * time.SECOND, start.since(later) == -took)
  time.sleep(0)
  time.sleep(-1)
  print(waited(start) >= took, start.elapsed() >= took)
  print(time.unix_ns() > 1_700_000_000 * time.SECOND)
  print(time.NS, time.US, time.MS, time.SECOND, time.MINUTE)

test "unicode ids", '''
  true false true
  true false true
  false true true
  15.1.0
  0
  false false true
  true false false
'''
  # The identifier classes of UAX #31 for Unicode 15.1: ID_Start and
  # ID_Continue, with Other_ID_Start and Other_ID_Continue included. Every
  # ASCII value is checked against its definition.

  print(unicode.is_id_start(0x61), unicode.is_id_start(0x30), unicode.is_id_continue(0x30))
  print(unicode.is_id_start(0x2118), unicode.is_id_start(0xB7), unicode.is_id_continue(0xB7))
  print(unicode.is_id_start(0x2E2F), unicode.is_id_continue(0x200C), unicode.is_id_start(0x4E00))
  print(unicode.VERSION)
  bad = 0
  for c in 0..128
    letter = (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
    digit = c >= 48 and c <= 57
    bad += 1 if unicode.is_id_start(c) != letter else 0
    bad += 1 if unicode.is_id_continue(c) != (letter or digit or c == 95) else 0
  print(bad)
  print(unicode.is_id_start(-1), unicode.is_id_continue(0x110000), unicode.is_id_continue(0xE0100))
  print(unicode.is_id_start(0x323AF), unicode.is_id_start(0x323B0), unicode.is_id_start(0x1F600))

test "unicode space", release: true, '''
  25
  ,9,a,b,c,d,20,85,a0,1680,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,200a,2028,2029,202f,205f,3000
  false false false false
'''
  # std.unicode's `is_space`: every value from -1 to 0x110000 is
  # looked up, and the white space found is exactly the 25 runes of the
  # White_Space property of Unicode 15.1 (PropList.txt), which Go's
  # `unicode.IsSpace` reports. U+FEFF and U+180E, white space in some
  # other definitions, are not.

  found = String()
  n = 0
  r = -1
  while r <= 0x110000 : r += 1
    if unicode.is_space(r)
      !found.add(",", text.format_int(r, 16))
      n += 1
  print(n)
  print(found)
  print(unicode.is_space(0xFEFF), unicode.is_space(0x180E), unicode.is_space(0x200B), unicode.is_space(Int.min))

test "utf16 go", "0 0 0 0 0", release: true
  # std.utf16 on Go's unicode/utf16 tests (src/unicode/utf16/utf16_test.go),
  # ported by hand: `size` is `RuneLen`, `pair_from_rune` is `EncodeRune`,
  # `rune_from_pair` is `DecodeRune`, and `is_surrogate` is `IsSurrogate`.
  # Go's `Encode` is written here with `size` and `pair_from_rune`.
  # Each check that fails prints itself; the last line counts them.

  # TestRuneLen: each value and its units, or -1 for `none`.
  LENS = [[0, 1], [0xD7FF, 1], [0xE000, 1], [0xFFFF, 1], [0x10000, 2], [0x10FFFF, 2], [0x110000, -1], [-1, -1]]

  # encodeTests: runes, and the units Go's `Encode` writes for them.
  RUNES1 = [1, 2, 3, 4]
  UNITS1 = [1, 2, 3, 4]
  RUNES2 = [0xffff, 0x10000, 0x10001, 0x12345, 0x10ffff]
  UNITS2 = [0xffff, 0xd800, 0xdc00, 0xd800, 0xdc01, 0xd808, 0xdf45, 0xdbff, 0xdfff]
  RUNES3 = [0x61, 0x62, 0xd7ff, 0xd800, 0xdfff, 0xe000, 0x110000, -1]
  UNITS3 = [0x61, 0x62, 0xd7ff, 0xfffd, 0xfffd, 0xe000, 0xfffd, 0xfffd]

  # decodeRuneTests: a pair and the rune it decodes to.
  PAIRS = [[0xd800, 0xdc00, 0x10000], [0xd800, 0xdc01, 0x10001], [0xd808, 0xdf45, 0x12345], [0xdbff, 0xdfff, 0x10ffff], [0xd800, 0x61, 0xfffd]]

  # surrogateTests: a value and whether it is a surrogate.
  SURROGATES = [[0x7A, 0], [0x6C34, 0], [0xFEFF, 0], [0x10000, 0], [0x1D11E, 0], [0x10FFFD, 0], [0xd7ff, 0], [0xd800, 1], [0xdc00, 1], [0xe000, 0], [0xdfff, 1]]

  # TestRuneLen.
  fun lens() -> Int
    failed = 0
    for t in LENS
      n = utf16.size(t[0]) ?? -1
      if n != t[1]
        print("size", t[0], "gave", n, "want", t[1])
        failed += 1
    failed

  # TestEncode and TestEncodeRune: the units of each rune, from `size` and
  # `pair_from_rune`; a rune of size 2 decodes back from its pair, and
  # every other value's pair is `REPLACEMENT` twice.
  fun encode() -> Int
    encode_case(?RUNES1, ?UNITS1) + encode_case(?RUNES2, ?UNITS2) + encode_case(?RUNES3, ?UNITS3)

  # One case of `encode`: the runes `rs` and the units `want`.
  fun encode_case(rs: []Int, want: []Int) -> Int
    failed = 0
    out = List[Int]()
    for r in rs
      p = utf16.pair_from_rune(r)
      size = utf16.size(r) ?? 0
      if size == 2
        !out.push(p.hi)
        !out.push(p.lo)
        if utf16.rune_from_pair(p.hi, p.lo) != r
          print("decode", r)
          failed += 1
      else
        !out.push(r if size == 1 else utf8.REPLACEMENT)
        if p.hi != utf8.REPLACEMENT or p.lo != utf8.REPLACEMENT
          print("pair", r, p.hi, p.lo)
          failed += 1
    same = out.len == want.len
    for u, k in want
      same = same and k < out.len and out[k] == u
    if not same
      print("encode", rs.len)
      failed += 1
    failed

  # TestDecodeRune.
  fun decode() -> Int
    failed = 0
    for t in PAIRS
      r = utf16.rune_from_pair(t[0], t[1])
      if r != t[2]
        print("rune_from_pair", t[0], t[1], "gave", r, "want", t[2])
        failed += 1
    failed

  # TestIsSurrogate.
  fun surrogates() -> Int
    failed = 0
    for t in SURROGATES
      if utf16.is_surrogate(t[0]) != (t[1] == 1)
        print("is_surrogate", t[0])
        failed += 1
    failed

  # Every value from -2 to 0x110001: `pair_from_rune` and `rune_from_pair`
  # undo each other on the runes from U+10000, `size` is 2 exactly there,
  # and `rune_from_pair` gives `REPLACEMENT` for every pair whose high or
  # low unit is just outside its range.
  fun exhaustive() -> Int
    failed = 0
    r = -2
    while r <= 0x110001 : r += 1
      p = utf16.pair_from_rune(r)
      size = utf16.size(r) ?? 0
      if r >= 0x10000 and r <= 0x10FFFF
        ok = size == 2 and p.hi >= 0xD800 and p.hi < 0xDC00 and p.lo >= 0xDC00 and p.lo < 0xE000 and utf16.rune_from_pair(p.hi, p.lo) == r
        failed += 1 if not ok else 0
      else
        ok = p.hi == 0xFFFD and p.lo == 0xFFFD and size == (0 if r < 0 or r > 0x10FFFF or utf16.is_surrogate(r) else 1)
        failed += 1 if not ok else 0
    for hi in [0xD7FF, 0xDC00, 0xDFFF, -1]
      failed += 1 if utf16.rune_from_pair(hi, 0xDC00) != 0xFFFD else 0
    for lo in [0xDBFF, 0xE000, 0x10000, -1]
      failed += 1 if utf16.rune_from_pair(0xD800, lo) != 0xFFFD else 0
    failed

  sub main()
    print(lens(), encode(), decode(), surrogates(), exhaustive())

test "utf16 halves", '''
  -9223372036854775808 false false false
  -55296 false false false
  -1 false false false
  0 false false false
  55295 false false false
  55296 true false true
  56319 true false true
  56320 false true true
  57343 false true true
  57344 false false false
  65535 false false false
  120832 false false false
  121856 false false false
  4295022592 false false false
  -9223372036854720512 false false false
  9223372036854775807 false false false
  0 1024 1024
'''
  # `utf16.is_high_surrogate` and `utf16.is_low_surrogate` at every
  # boundary and at the ends of Int, and against their definitions on
  # every value from -1 to 0x110000.

  for u in [Int.min, -0xD800, -1, 0, 0xD7FF, 0xD800, 0xDBFF, 0xDC00, 0xDFFF, 0xE000, 0xFFFF, 0x1D800, 0x1DC00, 0x100000000 + 0xD800, Int.min + 0xD800, Int.max]
    print(u, utf16.is_high_surrogate(u), utf16.is_low_surrogate(u), utf16.is_surrogate(u))
  wrong = 0
  highs = 0
  lows = 0
  u = -1
  while u <= 0x110000 : u += 1
    high = u >= 0xD800 and u <= 0xDBFF
    low = u >= 0xDC00 and u <= 0xDFFF
    wrong += 1 if utf16.is_high_surrogate(u) != high or utf16.is_low_surrogate(u) != low
    wrong += 1 if utf16.is_surrogate(u) != (utf16.is_high_surrogate(u) or utf16.is_low_surrogate(u))
    highs += 1 if high
    lows += 1 if low
  print(wrong, highs, lows)

test "utf16 units", release: true, '''
  0 3 1 2 1
  2 4 8 18
  3 2 3 3 9
  22 4
  -3 0
  0 0
  1 1
  2 5
  3 5
  4 6
  5 6
  100 6
  4 4 7 18
  0 0 11 1
  6561 0
'''
  # std.utf16's `unit_count` and `byte_index` on emoji, CJK, ASCII runs
  # longer than a word, and bytes that are not UTF-8, each of which is one
  # unit; past either end `byte_index` stops at 0 or `s.len`; and on every
  # string of up to four pieces both agree with a count of `utf8.runes`
  # and undo each other at every rune boundary.

  PIECES = ["a", "abcdefghi", "\u{e9}", "\u{4e2d}", "\u{1f600}", "\xff", "\xe2\x82", "\xf0\x9f\x98", "\xed\xa0\x80"]

  # The units of `s` counted rune by rune, each bad byte one `REPLACEMENT`.
  fun naive(s: ?String) -> Int
    n = 0
    for r in utf8.runes(s)
      n += utf16.size(r) ?? 99
    n

  # How `unit_count` and `byte_index` differ on `s` from `naive` and from
  # each other: at each rune boundary `i`, `byte_index` of the units before
  # `i` is `i`, and every unit count lands on the boundary at or after it.
  fun check(s: ?String) -> Int
    bad = 0
    total = utf16.unit_count(s)
    bad += 1 if total != naive(s) else 0
    bad += 1 if utf16.byte_index(s, total) != s.len or utf16.byte_index(s, total + 1) != s.len else 0
    bad += 1 if utf16.byte_index(s, 0) != 0 or utf16.byte_index(s, -1) != 0 else 0
    i = 0
    units = 0
    while i < s.len
      bad += 1 if utf16.byte_index(s, units) != i or utf16.unit_count(s[..i]) != units else 0
      d = utf8.rune_after(s, i)
      w = utf16.size(d.rune) ?? 99
      if w == 2
        bad += 1 if utf16.byte_index(s, units + 1) != i + d.size else 0
      i += d.size
      units += w
    bad += 1 if units != total else 0
    bad

  sub main()
    family = "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}"
    wave = "\u{1f44b}\u{1f3fd}"
    print(utf16.unit_count(""), utf16.unit_count("abc"), utf16.unit_count("\u{e9}"), utf16.unit_count("e\u{301}"), utf16.unit_count("\u{20ac}"))
    print(utf16.unit_count("\u{1f600}"), utf16.unit_count(wave), utf16.unit_count(family), family.len)
    print(utf16.unit_count("a\xffb"), utf16.unit_count("\xe2\x82"), utf16.unit_count("\xed\xa0\x80"), utf16.unit_count("\xf0\x9f\x98"), utf16.unit_count("\x80\x80\x80\x80\x80\x80\x80\x80\x80"))
    print(utf16.unit_count("abcdefghij\u{1f600}klmnopqrst"), utf16.unit_count("\u{4e2d}\u{6587}\u{4e2d}\u{6587}"))
    s = "a\u{1f600}b"
    for u in [-3, 0, 1, 2, 3, 4, 5, 100]
      print(u, utf16.byte_index(s, u))
    print(utf16.byte_index(family, 1), utf16.byte_index(family, 2), utf16.byte_index(family, 3), utf16.byte_index(family, 8))
    print(utf16.byte_index("", 0), utf16.byte_index("", 3), utf16.byte_index("abcdefghijklmnop", 11), utf16.byte_index("\xff\xfe", 1))
    bad = 0
    strings = 0
    for a in PIECES
      for b in PIECES
        for c in PIECES
          for d in PIECES
            bad += check(?String(a, b, c, d))
            strings += 1
    print(strings, bad)

test "utf8 ascii end", release: true, '''
  2183112 0
  0 3 2 6
'''
  # std.utf8's `ascii_end` against a byte-by-byte scan: in a run of each
  # length 0 to 80 with a byte of 0x80 or more at each position (or none),
  # from every cursor; every cursor 0 to 64 of strings that end in a run;
  # and views that start at each offset 0 to 15 of their String, so the
  # U128, vector, and overlapped tail reads each meet the end of `s`.

  fun scan(s: ?String, i: Int) -> Int
    k = i
    while k < s.len and s[k] < 0x80
      k += 1
    k

  checked = 0
  wrong = 0
  t = String()
  for len in 0..81
    for high in -1..len
      for b in [0x80, 0xC3, 0xFF]
        for off in [0, 1, 7, 15]
          !t.clear()
          for _ in 0..off
            !t.push(U8(0xFF))
          for j in 0..len
            !t.push(U8(b) if j == high else U8(0x20 + j % 95))
          s = ?t[off..]
          for i in 0..len + 1
            checked += 1
            wrong += 1 if utf8.ascii_end(s, i) != scan(s, i)
  # A second byte of 0x80 or more after the first, and runs ending at s.len.
  for len in 0..140
    !t.clear()
    for j in 0..len
      !t.push(U8(0x61 + j % 26))
    for i in 0..(len + 1 if len < 65 else 65)
      checked += 1
      wrong += 1 if utf8.ascii_end(t, i) != len
    if len > 4
      !t.add("\u{e9}abc\u{e9}")
      for i in 0..t.len + 1
        checked += 1
        wrong += 1 if utf8.ascii_end(t, i) != scan(t, i)
  print(checked, wrong)
  print(utf8.ascii_end("", 0), utf8.ascii_end("abc", 3), utf8.ascii_end("ab\u{e9}cd", 1), utf8.ascii_end("ab\u{e9}cd", 4))

bomb "utf8 ascii end negative", "index out of bounds", prints: "2", release: true
  # std.utf8's `ascii_end` panics at a negative cursor, as indexing does.

  s = "ab"
  print(utf8.ascii_end(s, 0))
  print(utf8.ascii_end(s, -1))

bomb "utf8 ascii end outside", "index out of bounds", prints: "2", release: true
  # std.utf8's `ascii_end` panics at a cursor outside 0 to `s.len`, as
  # indexing does.

  s = "ab"
  print(utf8.ascii_end(s, s.len))
  print(utf8.ascii_end(s, s.len + 1))

test "utf8 counts", release: true, '''
  18100 0
  5 6 0 0
'''
  # std.utf8's `rune_count` and std.utf16's `unit_count` against a count
  # rune by rune with `rune_after`, which reads every bad
  # byte as one rune of one unit, as Go does. Whole blocks of 64 and 16
  # bytes are counted by their bytes and checked valid as they are: each
  # piece, valid or not, is put at every byte from 0 to 150 of ASCII and
  # of three-byte runes, so it falls in each lane of a block and across
  # each block's end, and random mixes of the pieces follow.

  PIECES = ["\xc3\xa9", "\xe4\xb8\xad", "\xf0\x9f\x98\x80", "\xed\x9f\xbf", "\xee\x80\x80", "\xf4\x8f\xbf\xbf", "\x80", "\xbf", "\xc0", "\xc1", "\xc2", "\xe0", "\xe0\x80", "\xe0\xa0", "\xed\xa0", "\xed\xa0\x80", "\xf0", "\xf0\x8f", "\xf0\x9f\x98", "\xf4\x90", "\xf5", "\xf8", "\xff", "\xc3\xa9\x80", "\xf0\x90\x80\x80\x80"]

  obj Gen
    x: Int

  # The next number of `g`, 0 to 32767.
  fun next(g: !Gen) -> Int
    g.x = (g.x * 1103515245 + 12345) % 2147483648
    g.x / 65536

  # Runes, or units when `wide`, rune by rune.
  fun reference(s: ?String, wide: Bool) -> Int
    n = 0
    i = 0
    while i < s.len
      d = utf8.rune_after(s, i)
      n += 2 if wide and d.size == 4 else 1
      i += d.size
    n

  # Whether every count of `s` is the reference's.
  fun agrees(s: ?String) -> Bool
    runes = reference(s, false)
    units = reference(s, true)
    utf8.rune_count(s) == runes and utf16.unit_count(s) == units

  sub main()
    checked = 0
    wrong = 0
    t = String()
    for fill in ["a", "\u{4e2d}"]
      for p in PIECES
        for at in 0..151
          !t.clear()
          while t.len < at
            !t.add(fill)
          !t.add(p)
          while t.len < at + 70
            !t.add(fill)
          checked += 1
          wrong += 0 if agrees(t) else 1
          checked += 1
          wrong += 0 if agrees(t[at..]) else 1
    g = Gen(x: 2026)
    for round in 0..3000
      !t.clear()
      for _ in 0..next(!g) % 160
        k = next(!g) % (PIECES.len + 2)
        if k >= PIECES.len
          !t.add("abcdefghijklmnopq" if k == PIECES.len else "\u{4e2d}\u{6587}")
        else if round % 2 == 0 and k > 5
          !t.add("\u{e9}")
        else
          !t.add(PIECES[k])
      checked += 1
      wrong += 0 if agrees(t) else 1
    print(checked, wrong)
    s = "a\u{e9}\u{4e2d}\u{1f600}\xff"
    print(utf8.rune_count(s), utf16.unit_count(s), utf8.rune_count(""), utf16.unit_count(""))

test "utf8 edges", release: true, '''
  empty :  | back ok | size  | last 65533 0 65533 0
  ascii :  97/1 127/1 | back ok | size  1 1 | last 65533 0 65533 0
  two :  128/2 2047/2 | back ok | size  2 0 2 0 | last 65533 0 65533 0
  three :  2048/3 55295/3 57344/3 65533/3 65535/3 | back ok | size  3 0 0 3 0 0 3 0 0 3 0 0 3 0 0 | last 65533 0 65533 0
  four :  65536/4 1114111/4 | back ok | size  4 0 0 0 4 0 0 0 | last 65533 0 65533 0
  cjk :  20013/3 25991/3 120/1 | back ok | size  3 0 0 3 0 0 1 | last 65533 0 65533 0
  overlong2 :  65533/1 65533/1 65533/1 65533/1 | back ok | size  0 0 0 0 | last 65533 0 65533 0
  overlong3 :  65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 | back ok | size  0 0 0 0 0 0 | last 65533 0 65533 0
  overlong4 :  65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 | back ok | size  0 0 0 0 0 0 0 0 | last 65533 0 65533 0
  surrogate :  65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 | back ok | size  0 0 0 0 0 0 | last 65533 0 65533 0
  past :  65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 65533/1 | back ok | size  0 0 0 0 0 0 0 0 | last 65533 0 65533 0
  leads :  65533/1 65533/1 65533/1 65533/1 | back ok | size  0 0 0 0 | last 65533 0 65533 0
  lone :  65533/1 97/1 65533/1 | back ok | size  0 1 0 | last 65533 0 65533 0
  cut2 :  97/1 65533/1 | back ok | size  1 0 | last 65533 0 65533 0
  cut3 :  97/1 65533/1 65533/1 | back ok | size  1 0 0 | last 65533 0 65533 0
  cut4 :  97/1 65533/1 65533/1 65533/1 | back ok | size  1 0 0 0 | last 65533 0 65533 0
  cutmid :  65533/1 65533/1 97/1 65533/1 65533/1 98/1 | back ok | size  0 0 1 0 0 1 | last 65533 0 65533 0
  extra :  233/2 65533/1 128512/4 65533/1 65533/1 | back ok | size  2 0 0 4 0 0 0 0 0 | last 65533 0 65533 0
  leadlead :  65533/1 128/2 | back ok | size  0 2 0 | last 65533 0 65533 0
  badsecond :  65533/1 4096/3 | back ok | size  0 3 0 0 | last 65533 0 65533 0
  fivecont :  65533/1 65533/1 65533/1 65533/1 65533/1 | back ok | size  0 0 0 0 0 | last 65533 0 65533 0
'''
  # std.utf8 at every edge: each case prints the runes `rune_after` reads
  # from the start (rune/size), whether `rune_before` reads the same runes
  # walking back from the end, and `rune_size` at each byte (0 for `none`).

  sub show(name: ?String, s: ?String)
    found = List[Int]()
    sizes = List[Int]()
    line = String()
    i = 0
    while i < s.len
      r = utf8.rune_after(s, i)
      !found.push(r.rune)
      !sizes.push(r.size)
      !line.add(" ", r.rune, "/", r.size)
      i += r.size
    at_end = utf8.rune_after(s, s.len)
    at_start = utf8.rune_before(s, 0)
    same = true
    j = s.len
    k = found.len
    while j > 0 and k > 0
      r = utf8.rune_before(s, j)
      k -= 1
      if r.rune != found[k] or r.size != sizes[k]
        same = false
      j -= r.size
    back = "ok" if same and j == 0 and k == 0 else "differs"
    ends = String()
    for n in 0..s.len
      !ends.add(" ", utf8.rune_size(s, n) ?? 0)
    print(name, ":", line, "| back", back, "| size", ends, "| last", at_end.rune, at_end.size, at_start.rune, at_start.size)

  show("empty", "")
  show("ascii", "a\x7f")
  show("two", "\u{80}\u{7ff}")
  show("three", "\u{800}\u{d7ff}\u{e000}\u{fffd}\u{ffff}")
  show("four", "\u{10000}\u{10ffff}")
  show("cjk", "\u{4e2d}\u{6587}x")
  show("overlong2", "\xc0\x80\xc1\xbf")
  show("overlong3", "\xe0\x80\x80\xe0\x9f\xbf")
  show("overlong4", "\xf0\x80\x80\x80\xf0\x8f\xbf\xbf")
  show("surrogate", "\xed\xa0\x80\xed\xbf\xbf")
  show("past", "\xf4\x90\x80\x80\xf5\x80\x80\x80")
  show("leads", "\xf8\xfc\xfe\xff")
  show("lone", "\x80a\xbf")
  show("cut2", "a\xc3")
  show("cut3", "a\xe2\x82")
  show("cut4", "a\xf0\x9f\x98")
  show("cutmid", "\xe2\x82a\xf0\x9fb")
  show("extra", "\u{e9}\x80\u{1f600}\x80\x80")
  show("leadlead", "\xc2\xc2\x80")
  show("badsecond", "\xf0\xe1\x80\x80")
  show("fivecont", "\x80\x80\x80\x80\x80")

test "utf8 go", release: true, '''
  65533 0 65533 0 65533 128
  0 0 0 0 0
  0 0 0 0
'''
  # std.utf8 on Go's unicode/utf8 tests (src/unicode/utf8/utf8_test.go),
  # ported by hand: `rune_after` is `DecodeRuneInString`, `rune_before` is
  # `DecodeLastRuneInString`, `runes` is `for range`, `size` is `RuneLen`
  # (and `ValidRune` where it is not `none`), `push_rune` is `AppendRune`,
  # `rune_count` is `RuneCountInString`, and `is_valid` is `ValidString`.
  # Each check that fails prints itself; the last line counts them.

  # utf8map: each code point and its encoding.
  CODES = [0x0000, 0x0001, 0x007e, 0x007f, 0x0080, 0x0081, 0x00bf, 0x00c0, 0x00c1, 0x00c8, 0x00d0, 0x00e0, 0x00f0, 0x00f8, 0x00ff, 0x0100, 0x07ff, 0x0400, 0x0800, 0x0801, 0x1000, 0xd000, 0xd7ff, 0xe000, 0xfffe, 0xffff, 0x10000, 0x10001, 0x40000, 0x10fffe, 0x10ffff, 0xFFFD]
  SEQS = ["\x00", "\x01", "\x7e", "\x7f", "\xc2\x80", "\xc2\x81", "\xc2\xbf", "\xc3\x80", "\xc3\x81", "\xc3\x88", "\xc3\x90", "\xc3\xa0", "\xc3\xb0", "\xc3\xb8", "\xc3\xbf", "\xc4\x80", "\xdf\xbf", "\xd0\x80", "\xe0\xa0\x80", "\xe0\xa0\x81", "\xe1\x80\x80", "\xed\x80\x80", "\xed\x9f\xbf", "\xee\x80\x80", "\xef\xbf\xbe", "\xef\xbf\xbf", "\xf0\x90\x80\x80", "\xf0\x90\x80\x81", "\xf1\x80\x80\x80", "\xf4\x8f\xbf\xbe", "\xf4\x8f\xbf\xbf", "\xef\xbf\xbd"]

  # surrogateMap: U+D800 and U+DFFF, each encoded as if it were a code point.
  SURROGATES = ["\xed\xa0\x80", "\xed\xbf\xbf"]

  # testStrings.
  STRINGS = ["", "abcd", "\u{263a}\u{263b}\u{2639}", "\u{65e5}a\u{672c}b\u{8a9e}\u{e7}\u{65e5}\u{f0}\u{672c}\u{ca}\u{8a9e}\u{fe}\u{65e5}\u{a5}\u{672c}\u{bc}\u{8a9e}i\u{65e5}\u{a9}", "\u{65e5}a\u{672c}b\u{8a9e}\u{e7}\u{65e5}\u{f0}\u{672c}\u{ca}\u{8a9e}\u{fe}\u{65e5}\u{a5}\u{672c}\u{bc}\u{8a9e}i\u{65e5}\u{a9}\u{65e5}a\u{672c}b\u{8a9e}\u{e7}\u{65e5}\u{f0}\u{672c}\u{ca}\u{8a9e}\u{fe}\u{65e5}\u{a5}\u{672c}\u{bc}\u{8a9e}i\u{65e5}\u{a9}\u{65e5}a\u{672c}b\u{8a9e}\u{e7}\u{65e5}\u{f0}\u{672c}\u{ca}\u{8a9e}\u{fe}\u{65e5}\u{a5}\u{672c}\u{bc}\u{8a9e}i\u{65e5}\u{a9}", "\x80\x80\x80\x80"]

  # invalidSequenceTests: each starts with no valid rune.
  INVALID = ["\xed\xa0\x80\x80", "\xed\xbf\xbf\x80", "\x91\x80\x80\x80", "\xC2\x7F\x80\x80", "\xC2\xC0\x80\x80", "\xDF\x7F\x80\x80", "\xDF\xC0\x80\x80", "\xE0\x9F\xBF\x80", "\xE0\xA0\x7F\x80", "\xE0\xBF\xC0\x80", "\xE0\xC0\x80\x80", "\xE1\x7F\xBF\x80", "\xE1\x80\x7F\x80", "\xE1\xBF\xC0\x80", "\xE1\xC0\x80\x80", "\xED\x7F\xBF\x80", "\xED\x80\x7F\x80", "\xED\x9F\xC0\x80", "\xED\xA0\x80\x80", "\xF0\x8F\xBF\xBF", "\xF0\x90\x7F\xBF", "\xF0\x90\x80\x7F", "\xF0\xBF\xBF\xC0", "\xF0\xBF\xC0\x80", "\xF0\xC0\x80\x80", "\xF1\x7F\xBF\xBF", "\xF1\x80\x7F\xBF", "\xF1\x80\x80\x7F", "\xF1\xBF\xBF\xC0", "\xF1\xBF\xC0\x80", "\xF1\xC0\x80\x80", "\xF4\x7F\xBF\xBF", "\xF4\x80\x7F\xBF", "\xF4\x80\x80\x7F", "\xF4\x8F\xBF\xC0", "\xF4\x8F\xC0\x80", "\xF4\x90\x80\x80"]

  # runelentests: each value and the bytes it encodes to, or -1 for `none`.
  LENS = [[0, 1], [0x65, 1], [0xe9, 2], [0x263a, 3], [0xFFFD, 3], [0x10FFFF, 4], [0xD800, -1], [0xDFFF, -1], [0x110000, -1], [-1, -1]]

  # runecounttests: each string and its runes.
  COUNTED = ["abcd", "\u{263a}\u{263b}\u{2639}", "1,2,3,4", "\xe2\x00", "\xe2\x80", "a\xe2\x80"]
  COUNTS = [4, 3, 7, 2, 2, 3]

  # validTests, before the generated ones `valid` adds.
  VALID = ["", "a", "abc", "\u{416}", "\u{416}\u{416}", "\u{431}\u{440}\u{44d}\u{434}-\u{41b}\u{413}\u{422}\u{41c}", "\u{263a}\u{263b}\u{2639}", "a\u{fffd}b", "\xF4\x8F\xBF\xBF"]
  INVALID_TEXT = ["aa\xe2", "B\xfa", "B\xfaC", "\xF4\x90\x80\x80", "\xF7\xBF\xBF\xBF", "\xFB\xBF\xBF\xBF\xBF", "\xc0\x80", "\xed\xa0\x80", "\xed\xbf\xbf"]

  # validrunetests: each value, and whether it is a rune.
  VALID_RUNES = [0, 0x65, 0xe9, 0x263a, 0xFFFD, 0x10FFFF, 0xD7FF, 0xE000]
  NOT_RUNES = [0xD800, 0xDFFF, 0x110000, -1]

  ERROR = 0xFFFD

  # Whether `d` is `r` of `size`; prints the case when it is not.
  fun want(what: ?String, n: Int, d: utf8.Decoded, r: Int, size: Int) -> Bool
    return true if d.rune == r and d.size == size
    print(what, n, "gave", d.rune, d.size, "want", r, size)
    false

  # TestDecodeRune: each encoding decodes, alone and before a NUL, and so
  # does `rune_before` at its end; without its last byte it is
  # `ERROR` of size 1 (0 when nothing is left); with its last byte made
  # bad it is `ERROR` of size 1.
  fun decode() -> Int
    failed = 0
    for m, n in SEQS
      c = CODES[n]
      failed += 1 if not want("decode", n, utf8.rune_after(m, 0), c, m.len) else 0
      nul = String(m, "\x00")
      failed += 1 if not want("decode NUL", n, utf8.rune_after(?nul, 0), c, m.len) else 0
      failed += 1 if not want("decode last", n, utf8.rune_before(m, m.len), c, m.len) else 0
      short = m[..m.len - 1]
      wantsize = 1 if m.len > 1 else 0
      failed += 1 if not want("decode short", n, utf8.rune_after(short, 0), ERROR, wantsize) else 0
      failed += 1 if not want("decode last short", n, utf8.rune_before(short, short.len), ERROR, wantsize) else 0
      bad = String(short)
      !bad.push(U8(0x80 if m.len == 1 else 0x7F))
      failed += 1 if not want("decode bad", n, utf8.rune_after(?bad, 0), ERROR, 1) else 0
    failed

  # TestDecodeSurrogateRune: a surrogate is `ERROR` of size 1, from
  # either side.
  fun surrogates() -> Int
    failed = 0
    for m, n in SURROGATES
      failed += 1 if not want("surrogate", n, utf8.rune_after(m, 0), ERROR, 1) else 0
      failed += 1 if not want("surrogate last", n, utf8.rune_before(m, m.len), ERROR, 1) else 0
    failed

  # TestDecodeInvalidSequence: each is `ERROR`, of size 1.
  fun invalid() -> Int
    failed = 0
    for m, n in INVALID
      failed += 1 if not want("invalid", n, utf8.rune_after(m, 0), ERROR, 1) else 0
    failed

  # testSequence: `rune_before`, walking back from the end, gives the
  # runes and the indexes `rune_after` gives walking forward.
  fun sequence(s: ?String) -> Int
    at = List[Int]()
    found = List[Int]()
    i = 0
    while i < s.len
      r = utf8.rune_after(s, i)
      !at.push(i)
      !found.push(r.rune)
      i += r.size
    j = at.len
    i = s.len
    while i > 0
      j -= 1
      r = utf8.rune_before(s, i)
      i -= r.size
      if j < 0 or r.rune != found[j] or i != at[j]
        print("sequence", s.len, i, j)
        return 1
    1 if j != 0 else 0

  # TestSequencing: every test string around every encoding.
  fun sequencing() -> Int
    failed = 0
    for ts in STRINGS
      for m in SEQS
        failed += sequence(?String(ts, m))
        failed += sequence(?String(m, ts))
        failed += sequence(?String(ts, m, ts))
    failed

  # TestRuneLen: `size` of each; and TestValidRune: whether `size` is
  # `none`.
  fun sizes() -> Int
    failed = 0
    for t in LENS
      n = utf8.size(t[0]) ?? -1
      if n != t[1]
        print("size", t[0], "gave", n, "want", t[1])
        failed += 1
    for r in VALID_RUNES
      failed += 1 if utf8.size(r) == none else 0
    for r in NOT_RUNES
      failed += 1 if utf8.size(r) != none else 0
    failed

  # TestEncodeRune and TestAppendRune: each code point is written as its
  # encoding, alone and after "init"; and TestNegativeRune: -1 is written
  # as `REPLACEMENT` is.
  fun encode() -> Int
    failed = 0
    for m, n in SEQS
      out = String()
      utf8.push_rune(!out, CODES[n])
      init = String("init")
      utf8.push_rune(!init, CODES[n])
      if ?out != m or ?init != ?String("init", m)
        print("encode", n)
        failed += 1
    a = String()
    utf8.push_rune(!a, ERROR)
    b = String()
    utf8.push_rune(!b, -1)
    failed += 1 if ?a != ?b else 0
    failed

  # TestRuntimeConversion: `runes` gives what `rune_after` reads walking
  # forward, and `rune_count` counts them.
  fun conversion() -> Int
    failed = 0
    for ts in STRINGS
      i = 0
      n = 0
      for r in utf8.runes(ts)
        d = utf8.rune_after(ts, i)
        failed += 1 if r != d.rune else 0
        i += d.size
        n += 1
      failed += 1 if i != ts.len or n != utf8.rune_count(ts) else 0
    failed

  # TestRuneCount: `rune_count` of each.
  fun rune_counts() -> Int
    failed = 0
    for s, n in COUNTED
      if utf8.rune_count(s) != COUNTS[n]
        print("rune_count", n, "gave", utf8.rune_count(s), "want", COUNTS[n])
        failed += 1
    failed

  # 1 when `is_valid(s)` is not `ok`, after printing the case; else 0.
  fun check_valid(s: ?String, ok: Bool) -> Int
    return 0 if utf8.is_valid(s) == ok
    print("is_valid", s.len, "want", ok)
    1

  # TestValid: each of `VALID` and `INVALID_TEXT`, then for `i` below 100,
  # "a" repeated `i` times, alone, before a valid rune, before a cut one,
  # and each of those two before "b" repeated `i` times.
  fun valid() -> Int
    failed = 0
    for s in VALID
      failed += check_valid(s, true)
    for s in INVALID_TEXT
      failed += check_valid(s, false)
    for i in 0..100
      a = String()
      b = String()
      for _ in 0..i
        !a.push(0x61)
        !b.push(0x62)
      failed += check_valid(?a, true)
      failed += check_valid(?String(a, "\u{416}"), true)
      failed += check_valid(?String(a, "\xe2"), false)
      failed += check_valid(?String(a, "\u{416}", b), true)
      failed += check_valid(?String(a, "\xe2", b), false)
    failed

  sub main()
    e = utf8.rune_after("", 0)
    l = utf8.rune_before("", 0)
    print(e.rune, e.size, l.rune, l.size, utf8.REPLACEMENT, utf8.RUNE_SELF)
    print(decode(), surrogates(), invalid(), sequencing(), sizes())
    print(encode(), conversion(), rune_counts(), valid())

test "utf8 push", release: true, '''
  0 1 true true true true
  127 1 true true true true
  128 2 true true true true
  2047 2 true true true true
  2048 3 true true true true
  55295 3 true true true true
  57344 3 true true true true
  65533 3 true true true true
  65535 3 true true true true
  65536 4 true true true true
  1114111 4 true true true true
  true
  11
  -1 true -1
  -128 true -1
  -9223372036854775808 true -1
  55296 true -1
  56319 true -1
  56320 true -1
  57343 true -1
  1114112 true -1
  2147483647 true -1
  9223372036854775807 true -1
  30 true 10
'''
  # std.utf8's `push_rune` at every boundary of the encoding's lengths, read
  # back by `rune_after`, `rune_size`, and `runes`; and every value that is
  # not a rune written as U+FFFD, as Go's `AppendRune` writes it.

  points = [0, 0x7F, 0x80, 0x7FF, 0x800, 0xD7FF, 0xE000, 0xFFFD, 0xFFFF, 0x10000, 0x10FFFF]
  out = String()
  for r in points
    at = out.len
    utf8.push_rune(!out, r)
    d = utf8.rune_after(?out, at)
    print(r, out.len - at, d.rune == r, d.size == out.len - at, (utf8.rune_size(?out, at) ?? 0) == out.len - at, (utf8.size(r) ?? 0) == out.len - at)
  print(?out == "\x00\u{7f}\u{80}\u{7ff}\u{800}\u{d7ff}\u{e000}\u{fffd}\u{ffff}\u{10000}\u{10ffff}")
  n = 0
  for r in utf8.runes(?out)
    n += 1 if r == points[n] else 100
  print(n)
  bad = String()
  for r in [-1, -0x80, Int.min, 0xD800, 0xDBFF, 0xDC00, 0xDFFF, 0x110000, 0x7FFFFFFF, Int.max]
    at = bad.len
    utf8.push_rune(!bad, r)
    print(r, ?bad[at..] == "\u{fffd}", utf8.size(r) ?? -1)
  print(bad.len, utf8.is_valid(?bad), utf8.rune_count(?bad))

bomb "utf8 rune after outside", "index out of bounds", prints: "65533", release: true
  # std.utf8's `rune_after` panics at an index outside 0 to `s.len`, as indexing does.

  s = "ab"
  print(utf8.rune_after(s, s.len).rune)
  print(utf8.rune_after(s, s.len + 1).rune)

bomb "utf8 rune before outside", "index out of bounds", prints: "65533", release: true
  # std.utf8's `rune_before` panics at an index outside 0 to `s.len`, as indexing does.

  s = "ab"
  print(utf8.rune_before(s, 0).rune)
  print(utf8.rune_before(s, -1).rune)

bomb "utf8 rune size outside", "index out of bounds", prints: "0", release: true
  # std.utf8's `rune_size` panics at an index outside 0 to `s.len`, as indexing does.

  s = "ab"
  print(utf8.rune_size(s, s.len) ?? 0)
  print(utf8.rune_size(s, s.len + 1) ?? 0)
