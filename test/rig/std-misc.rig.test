  sub main()
    doc = json.new_doc()
    bad = 0
    for k in 0..CASES.len
      (!doc).parse(?CASES[k])
      bad += 1 if json.error_name(doc.error) != KINDS[k] or doc.error_pos != POS[k]
    print("checked", CASES.len, "mismatches", bad)

bomb "math clamp bounds", "math.clamp: the low bound is above the high bound"
  # `clamp(x, lo, hi)` needs `lo <= hi`: no value lies between bounds the
  # wrong way round.

  print(math.clamp(5, 10, 1))

test "math float", '''
  4.0 true
  -2.0 2.0 2.0 -1.0
  1.0 0.0 2.0
  0.0 1.0 1.0
  1024.0 2.0
  true
'''
  # std.math's Float functions, from its Zig file.

  print(math.sqrt(16.0), math.sqrt(2.0) * math.sqrt(2.0) > 1.999)
  print(math.floor(-1.5), math.floor(2.0), math.ceil(1.2), math.ceil(-1.2))
  print(math.exp(0.0), math.ln(1.0), math.ln(math.exp(2.0)))
  print(math.sin(0.0), math.cos(0.0), math.sin(math.PI / 2.0))
  print(math.powf(2.0, 10.0), math.powf(4.0, 0.5))
  print(math.sqrt(-1.0) != math.sqrt(-1.0))

test "math float more", '''
  0.0 0.0 2.5 7 true
  2.0 -2.0 -0.0 0.0
  -3.0 3.0 -3.0 -0.0
  3.0 0.0 -1.0 true true
'''
  # std.math: abs of a zero is +0.0 and of a NaN a NaN, and trunc,
  # copysign, and log2 follow IEEE 754.

  nan = math.sqrt(-1.0)
  print(math.abs(-0.0), math.abs(0.0), math.abs(-2.5), math.abs(-7), math.abs(nan) != math.abs(nan))
  print(math.trunc(2.7), math.trunc(-2.7), math.trunc(-0.5), math.trunc(0.5))
  print(math.copysign(3.0, -1.0), math.copysign(-3.0, 1.0), math.copysign(3.0, -0.0), math.copysign(0.0, -1.0))
  print(math.log2(8.0), math.log2(1.0), math.log2(0.5), math.log2(0.0) < 0.0, math.log2(-1.0) != math.log2(-1.0))

bomb "math gcd min", "integer overflow"
  # `gcd` takes magnitudes, and `Int.min` has none an `Int` holds.

  print(math.gcd(Int.min, 0))

test "math int", '''
  7 7 0 2.5 3
  3 9 -1.5 b
  10 0 4 0.25 5
  6 6 7 0
  81 -8 1 4611686018427387904 -9223372036854775808
  0 1 -1 1
  1 1 -1 0
  2 -2 -1 0
  3.141592653589793 2.718281828459045
'''
  # std.math's integer helpers, written in Rig: `abs`, `min`, `max`, and
  # `clamp` are generic over number types; `gcd`, `pow`, and `mod` take
  # `Int`s.

  print(math.abs(-7), math.abs(7), math.abs(0), math.abs(-2.5), math.abs(I8(-3)))
  print(math.min(3, 9), math.max(3, 9), math.min(-1.5, 2.0), math.max("a", "b"))
  print(math.clamp(15, 0, 10), math.clamp(-3, 0, 10), math.clamp(4, 0, 10), math.clamp(0.5, 0.0, 0.25), math.clamp(5, 5, 5))
  print(math.gcd(12, 18), math.gcd(-12, 18), math.gcd(7, 0), math.gcd(0, 0))
  print(math.pow(3, 4), math.pow(-2, 3), math.pow(5, 0), math.pow(2, 62), math.pow(-2, 63))
  print(math.pow(2, -1), math.pow(1, -5), math.pow(-1, -3), math.pow(-1, -4))
  print(math.pow(1, Int.min), math.pow(-1, Int.min), math.pow(-1, Int.min + 1), math.pow(7, Int.min))
  print(math.mod(-7, 3), math.mod(7, -3), math.mod(-7, -3), math.mod(6, 3))
  print(math.PI, math.E)

bomb "math pow overflow", "integer overflow"
  # std.math.pow is checked like `*`: it panics on overflow.

  print(math.pow(2, 63))

bomb "math pow zero", "division by zero"
  # 0 to a negative power is 1 divided by 0.

  print(math.pow(0, -1))

test "math shortest", '''
  false 5 -324
  true 1 -1
  false 1 21
  false 12345 -2
  false 0 0
  none
'''
  fun zero() -> Float
    0.0

  sub show(f: Float)
    if math.shortest(f) as d
      print(d.neg, d.digits, d.exp)
    else
      print("none")

  show(5e-324)
  show(-0.1)
  show(1e21)
  show(123.45)
  show(0.0)
  show(1.0 / zero())

bomb "no crash report set", "index out of bounds", prints: "1", release: true
  # The harness runs a program that panics on purpose with
  # RIG_NO_CRASH_REPORT=1, so macOS files no crash report for its abort;
  # the panic is the same (test/cli/no_crash_report.sh).

  fun rt(n: Int) -> Int
    n

  print(os.env("RIG_NO_CRASH_REPORT") ?? "unset")
  a = [1, 2, 3]
  print(a[rt(3)])

test "no crash report unset", "unset", release: true
  # A program not marked to panic runs without RIG_NO_CRASH_REPORT: should
  # it crash, macOS still files its crash report.

  print(os.env("RIG_NO_CRASH_REPORT") ?? "unset")

test "os", '''
  1 true true
  true
  no names with =
'''
  # std.os: the arguments start with the program's name, and they and the
  # environment's values are Strings that live as long as the program.

  fun first_arg() -> ?String
    os.args()[0]

  args = os.args()
  print(args.len, first_arg().len > 0, args[0] == first_arg())
  print(os.env("RIG_STD_SURELY_UNSET_VARIABLE") == none)
  print(os.env("A=B") ?? "no names with =")

fail "private members", "5:9: field `state` of `std.random.Random` is private to the standard library's module `std.random`", "5:23: `random.entropy` is private to the standard library's module `std.random`", "6:12: only the standard library's module `std.random` can construct `std.random.Random`: its field `state` is private; make one with its `pub` functions", errors: 3
  # The standard library's private declarations are named by their module,
  # `std.random`, with no hint to change the library.

  r = random.Random.seeded(1)
  print(r.state, random.entropy())
  s = random.Random(state: 1)
  print((!s).next())

test "random", '''
  16294208416658607535
  true true
  0 true true
  5 -9223372036854775808
  0
  36 true
  [9]
  true
'''
  # std.random: a seeded Random gives the same sequence everywhere (splitmix64:
  # seed 0 starts with 16294208416658607535); `int` stays in its range and
  # reaches every value; `float` is in [0, 1); `shuffle` permutes; and
  # `Random.new` is seeded from the operating system.

  r = random.Random.seeded(0)
  print((!r).next())
  a = random.Random.seeded(7)
  b = random.Random.seeded(7)
  print((!a).next() == (!b).next(), (!a).int(0, 1000) == (!b).int(0, 1000))

  seen = [6 of 0]
  bad = 0
  n = 0
  while n < 6000 : n += 1
    k = (!r).int(-3, 3)
    if k < -3 or k >= 3
      bad += 1
    else
      seen[k + 3] += 1
  print(bad, seen[0] > 800, seen[5] > 800)
  print((!r).int(5, 6), (!r).int(Int.min, Int.min + 1))

  f_bad = 0
  n = 0
  while n < 1000 : n += 1
    f = (!r).float()
    if f < 0.0 or f >= 1.0
      f_bad += 1
  print(f_bad)

  xs = [1, 2, 3, 4, 5, 6, 7, 8]
  !r.shuffle(!xs)
  total = 0
  for x in xs
    total += x
  print(total, xs != [1, 2, 3, 4, 5, 6, 7, 8])
  none_left: [0]Int = []
  !r.shuffle(!none_left)
  v: List[Int] = List()
  !v.push(9)
  !r.shuffle(!v[..])
  print(v)

  o = random.Random.new()
  d = (!o).int(1, 7)
  print(d >= 1 and d <= 6)

test "random array", '''
  true
  true
  view
  true
  true true
  true
  true
'''
  # An array holds `Random`s, which are unique: a loop writes each in
  # place, an element is lent or written where it is, and a discarded
  # `Random` is simply dropped.

  fun step(r: !random.Random) -> U64
    (!r).next()

  sub show(r: ?random.Random)
    print("view")

  a: [2]random.Random = [random.Random.seeded(1), random.Random.seeded(2)]
  for r in !a
    print((!r).next() != 0)
  show(?a[0])
  print(step(!a[1]) != 0)
  random.Random.seeded(3)
  _ = random.Random.seeded(4)
  x = random.Random.seeded(5)
  print(step(!x) != 0, step(!x) != 0)
  y = random.Random.seeded(6)
  f = (!y).fork()
  print((!f).int(1, 7) >= 1)
  b = <a
  print((!b[1]).next() != 0)

bomb "random empty range", "random: empty range 4..4"
  # `int(lo, hi)` needs `lo < hi`: an empty range has no value to give.

  r = random.Random.seeded(1)
  print((!r).int(4, 4))

fail "random holder moves", "9:5: `g` is a unique `Game`, which can't be copied by `=`: write `<g` to move it or `?g` to view it", errors: 1
  # A struct that holds a `Random` is unique too: binding it to another
  # name without `<` would copy the generator.

  obj Game
    rng: random.Random
    score: Int

  g = Game(rng: random.Random.seeded(7), score: 0)
  h = g
  print(h.score)

test "random in cell", '''
  10451216379200822465
  3 true
'''
  # A Cell holds a `Random`: `replace` hands back the old one, which moves.

  obj Game
    rng: random.Random
    score: Int

  c = *Cell(random.Random.seeded(1))
  r = (!c).replace(random.Random.seeded(2))
  print((!r).next())
  g = Game(rng: random.Random.seeded(7), score: 3)
  h = <g
  print(h.score, (!h.rng).next() != 0)

test "random moves", '''
  true true
  true
'''
  # A `Random` moves, so no two owners draw the same stream by accident;
  # `fork` makes a second generator, seeded from the first, on purpose.

  fun roll(r: random.Random) -> Int
    g = <r
    (!g).int(1, 7)

  r = random.Random.seeded(5)
  a = <r
  first = (!a).next()
  child = (!a).fork()
  print((!child).next() != (!a).next(), first != 0)
  n = roll(<a)
  print(n >= 1 and n <= 6)

fail "random moves is rejected", "6:22: use of `r` after move"
  # A `Random` is not Copy: binding it to another name moves it, so the old
  # name cannot draw the same numbers again.

  r = random.Random.seeded(1)
  a = <r
  print((!a).next(), (!r).next())

fail "random no clone", "5:6: `+x` cannot clone a `random.Random`", errors: 1
  # A `Random` has no clone, which would repeat its stream: `fork` makes a
  # second generator on purpose.

  r = random.Random.seeded(1)
  s = +r
  print(!s.next())

fail "random not copy", "4:5: `r` is a unique `random.Random`, which can't be copied by `=`: write `<r` to move it or `?r` to view it", errors: 1
  # Binding a `Random` to another name without `<` would copy its stream.

  r = random.Random.seeded(1)
  a = r
  print((!a).next())

fail "random old name", "4:20: no type `Rng` in module `random`; its generator is `Random`", "7:12: no member `Rng` in module `random`; its generator is `Random`"
  # `std.random` has no `Rng`: its generator is `Random`, and the old name
  # resolves to nothing, as a type or as a value.

  fun roll(r: random.Rng) -> Int
    1

  r = random.Rng.seeded(1)
  print(roll(r))

test "random owned bindings", '''
  true 4
  true
  true
  true
  true
'''
  # A binding a `Random` moves into owns it and may write it: an `as`
  # binding, a `match <e` payload, a binding of a moved parameter, and
  # the value `Cell.replace` hands back.

  obj G
    r: random.Random
    n: Int

  enum Pick
    a(r: random.Random)
    b

  fun roll(r: random.Random) -> U64
    g = <r
    (!g).next()

  o: G? = G(r: random.Random.seeded(1), n: 0)
  if <o as g
    g.n = 4
    print((!g.r).next() != 0, g.n)
  p: random.Random? = random.Random.seeded(1)
  if <p as r
    print((!r).next() != 0)
  print(roll(random.Random.seeded(1)) != 0)
  e = Pick.a(r: random.Random.seeded(2))
  match <e
    .a(r) => print((!r).next() != 0)
    .b => pass
  w = *Cell(random.Random.seeded(5))
  old = (!w).replace(random.Random.seeded(6))
  print((!old).next() != 0)

fail "random read loop", "24:11: cannot lend `a if f else b`: it may be `a`, a value a name holds", "29:7: `count[random.Random]` cannot use `T = random.Random`: the generic body copies into a loop binding a value that holds a `T`, and `random.Random` is unique"
  # A `Random` is unique, so nothing copies one: a loop over a place reads
  # each element where it is (`?Random`), and one over an array made here
  # takes it, but a branching source, which may be a name's, is bound to a
  # name first, and a generic body whose loop copies a `T` cannot take
  # `T = Random`.

  fun count[T](xs: ?[2]T) -> Int
    new n = 0
    for x in xs
      n += 1
    n

  sub look(s: []random.Random)
    for r in s
      print(r)

  a = [random.Random.seeded(1), random.Random.seeded(2)]
  b = [random.Random.seeded(3), random.Random.seeded(4)]
  f = true
  for r in a
    print(r)
  for r in ?a
    print(r)
  for r in (a if f else b)
    print(r)
  for r in [random.Random.seeded(5), random.Random.seeded(6)]
    print(r)
  look(?a[..])
  print(count(?a))

