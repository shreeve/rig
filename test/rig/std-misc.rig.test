'''
  # BigInt's to_f64, the nearest F64 with ties to even, against Python's
  # float(int): exact values, ties at 2^53 and 2^54 and far above them,
  # where only a bit below the top 64 breaks the tie, and the largest F64,
  # past which every number is infinite. Each line is the number's bits as
  # an F64, from `to_bits`.

  sub main()!
    for x in ["0", "1", "-1", "2", "3", "4503599627370496", "9007199254740991", "9007199254740992", "9007199254740993", "9007199254740994", "9007199254740995", "9007199254740996", "9007199254740997", "-9007199254740993", "-9007199254740995", "18014398509481986", "18014398509481990", "18014398509481985", "9223372036854775808", "18446744073709551615", "18446744073709551616", "18446744073709553664", "18446744073709553665", "1267650600228229542234191560704", "1267650600228229542234191560705", "1267650600228229823709168271360", "1267650600228229823709168271359", "1606938044258990453947923680586147734807949174969684883144705", "-1606938044258990453947923680586147734807949174969684883144704", "10000000000000000000000", "100000000000000000000000", "515377520732011331036461129765621272702107522001", "-33838570200749104093688312191360663049723538032163586311882583029937928817155484694868047033872426464394494995988271332913954603498574472214519578172866008667274238025742281231442261927858597726462360331182430633401319955052400299452568317841001584180001", "", "", "", "-", "", "", "-", "", ""]
      print(bigint.parse(x)!.to_f64().to_bits())
    print(bigint.from_int(1).to_f64(), bigint.from_int(-7).to_f64(), (bigint.parse("1e3") catch bigint.from_int(0)).text())

fail "bigint use after move", "7:7: use of `a` after move", errors: 1
  # A BigInt owns its limbs, so `<x` moves it, and a BigInt moved away
  # cannot be read; `clone` makes a second one.

  a = bigint.from_int(1)
  b = a.clone()
  c = <a
  print(a.text(), b.text(), c.text())

test "enum order generic", '''
  .small .medium
  .medium .medium
  .small
  [.small, .small, .medium, .large]
  2 3 none
'''
  # A plain enum meets a generic body's ordering: std.math's min, max, and
  # clamp, std.sort's sort, lower_bound, and search, and a user's generic
  # `<` each order its values by the variants' values.

  enum Size
    large = 30
    small = 10
    medium = 20

  fun least[T](xs: []T) -> T
    best = xs[0]
    for x in xs
      if x < best
        best = x
    best

  print(math.min(Size.large, Size.small), math.max(Size.small, Size.medium))
  print(math.clamp(Size.large, Size.small, Size.medium), math.clamp(Size.small, Size.medium, Size.large))
  xs = [Size.large, Size.small, Size.medium, Size.small]
  print(least(?xs))
  sort.sort(!xs)
  print(xs)
  print(sort.lower_bound(?xs, Size.medium), sort.search(?xs, Size.large), sort.search(?xs[0..2], Size.large))

test "for over iterators", release: true, '''
  [ ann ]
  [  ]
  [ bob ]
  x
  1
  y
  2
  first a
  b
  c
  three
'''
  # `split`, `lines` and `words` give iterators, which a `for` walks: a
  # source made there is held for the loop, a name is advanced in place.

  for part in text.split("ann,,bob", ",")
    print("[", part, "]")
  rows = text.lines("x 1\r\ny  2\n")
  for row in !rows
    for w in text.words(row)
      print(w)
  more = text.split("a-b-c", "-")
  for p in !more
    print("first", p)
    break
  for p in !more
    print(p)
  n = for w in text.words("one two three")
    break w if w.len == 5
  else
    "none"
  print(n)

fail "instant is not int", "5:24: operator `-` requires numeric operands", "6:13: only the standard library's module `std.time` can construct `std.time.Instant`", errors: 2
  # A monotonic reading is an `Instant`, not a number: it cannot be mixed
  # with the wall clock, nor made from one.

  start = time.now()
  print(time.unix_ns() - start)
  fake = time.Instant(ns: 5)
  print(fake.elapsed())

test "json partial tape", '''
  false eof 3 0
  true ok 11
  false eof 20 0
'''
  # std.json: a failed parse leaves no partial tape, and a Doc parses
  # again after one.

  doc = json.new_doc()
  bad = "[[1"
  print((!doc).parse(?bad), json.error_name(doc.error), doc.error_pos, doc.size())
  good = "[[1], {\"a\": \"b\\n\"}, 2.5, 99999999999999999999]"
  print((!doc).parse(?good), json.error_name(doc.error), doc.size())
  again = "{\"x\": [\"\\u00e9\", 1.5"
  print((!doc).parse(?again), json.error_name(doc.error), doc.error_pos, doc.size())

test "json scan edges", "checked 358940 mismatches 0", release: true
  # Every place a string scan can stop, from every start: the scan starts
  # at `at` (1 to 18, after spaces and `\"` escapes, so special bytes lie
  # before it inside the overlapping tail read; or after a UTF-8 run; or
  # after raw control whitespace), runs over `a` plain bytes (0 to 130),
  # and stops at a control byte, a 0xFF, a backslash, a quote, or the end
  # of the input, with `b` (0 to 33) more bytes after the stop.

  FILL = "plain !#[]~\x7f {}:,09AZaz/"

  sub add_fill(s: !String, k: Int)
    for j in 0..k
      !s.push(FILL[j % FILL.len])

  # 0 when `src` parses as expected, else 1, after printing why.
  fun check(src: ?String, ok: Bool, kind: Static, pos: Int, n: Int) -> Int
    doc = json.new_doc()
    got = (!doc).parse(?src)
    if ok
      return 0 if got and doc.size() == 1 and doc.get_str(0).len == n
    else if not got and json.error_name(doc.error) == kind and doc.error_pos == pos
      return 0
    print("MISMATCH len", src.len, "want", ok, kind, pos, n, "got", got, json.error_name(doc.error), doc.error_pos)
    1

  sub main()
    bad = 0
    total = 0
    for c in 0..20
      for a in 0..131
        for b in 0..34
          for stop in 0..5
            continue if stop == 4 and b > 0
            s = String()
            decoded = 0
            in_array = false
            if c < 18
              for _ in 0..c / 9
                !s.push(0x20)
              !s.push(0x22)
              for _ in 0..c % 9
                !s.add("\\\"")
              decoded = c % 9
            else if c == 18
              !s.add("\"\xc3\xa9")
              decoded = 2
            else
              !s.add("[1,\n\t\r\"")
              in_array = true
            add_fill(!s, a)
            pos = s.len
            ok = false
            kind = "eof"
            want = pos
            if stop == 0
              !s.push(0x01)
              kind = "control"
            else if stop == 1
              !s.push(0xFF)
              kind = "utf8"
            else if stop == 2
              !s.push(0x5C)
              want = pos + 1
              kind = "escape" if b > 0 else "eof"
            else if stop == 3
              !s.push(0x22)
              want = pos + 1
              if in_array
                kind = "unexpected" if b > 0 else "eof"
              else if b > 0
                kind = "trailing"
              else
                ok = true
            if stop < 4
              add_fill(!s, b)
            total += 1
            bad += check(?s, ok, kind, want, decoded + a)
    print("checked", total, "mismatches", bad)

test "json space blocks", "cases 31488 ok 1722 checksum 2873757600852398656"
  # std.json's whitespace skip: every byte after every run of mixed
  # whitespace from 0 to 40 bytes long, then more whitespace or none, so
  # the run ends at every offset within a 16-byte block, across block
  # edges, and in the input's last 15 bytes. The checksum of every case's
  # error and offset is the one std.json gave when this test was written,
  # so a faster skip must give exactly the same results.

  WS = " \t\n\r"

  sub main()
    cases = 0
    ok = 0
    sum: U64 = 0
    for p in 0..41
      for b in 0..256
        for q in [0, 3, 17]
          s = String()
          !s.push(0x5B)
          for k in 0..p
            !s.push(WS[k % 4])
          !s.push(U8(b))
          for k in 0..q
            !s.push(WS[(k + 1) % 4])
          !s.push(0x5D)
          doc = json.new_doc()
          good = (!doc).parse(?s)
          ok += 1 if good
          name = json.error_name(doc.error)
          sum = sum *% 1000003 +% U64(doc.error_pos) *% 31 +% U64(name.len) *% 7 +% U64(name[0])
          cases += 1
    print("cases", cases, "ok", ok, "checksum", sum)

test "json utf8 blocks", "checked 864 mismatches 0"
  # std.json checks a string's non-ASCII text 16 bytes at a time: each
  # UTF-8 sequence, valid and not, at every offset around a block's edges,
  # with the text ended by a quote, an escape, or a control byte, in every
  # lane of a block and in the input's last 15 bytes, which are checked a
  # sequence at a time. The errors and their offsets are Python's.

