test "for over temporary vec", '''
  0
  10
  0 0
  1 10
  2 20
  b 0
  b 10
  20
'''
  # A loop over a List that its source expression creates drops the List
  # when the loop ends, however it ends.

  fun mk(n: Int) -> List[Int]
    v: List[Int] = List()
    for i in 0..n
      !v.push(i * 10)
    v

  fun first_big(n: Int) -> Int
    for x in mk(n)
      return x if x > 10
    -1

  for x in mk(2)
    print(x)
  for x, i in mk(3)
    print(i, x)
  for x in mk(5)
    break if x > 10
    print("b", x)
  print(first_big(4))

fail "for over vec expression", "8:13: cannot lend `o?`: it may be `o`, a value a name holds", "17:12: cannot lend `a if c else b`: it may be `a`, a value a name holds", "19:11: cannot lend `a if c else b`: it may be `a`, a value a name holds", errors: 3
  # A `for` over a List walks a named List in place, or consumes the List a
  # call makes. Any other expression (`o?`, a ternary, a `match`) could
  # name a place on one path and make a List on another, so it is bound
  # to a name first.

  fun total(o: List[Int]?) -> Int?
    t = 0
    for e in ?o?
      t += e
    t

  a: List[Int] = List()
  !a.push(1)
  b: List[Int] = List()
  !b.push(2)
  c = a.len > 0
  for e in ?(a if c else b)
    print(e)
  for e in (a if c else b)
    print(e)
  print(total(<b) ?? 0, a.len)

test "for takes array of owners", '''
  got 1
  drop 1
  drop 3
  drop 2
  ["a", "b", "c", "d"]
'''
  # `for x in <a` over an array whose elements own hands each one over
  # in turn; the loop drops the ones a `break` leaves, and the array is
  # not dropped again. An array made in the header is taken the same way.

  obj D
    n: Int

    drop(!@)
      print("drop", @n)

  fun mk() -> [2]String
    [String("a"), String("b")]

  a = [D(n: 1), D(n: 2), D(n: 3)]
  for d in <a
    print("got", d.n)
    break if d.n == 1
  keep: List[String] = List()
  for t in mk()
    !keep.push(<t)
  ts = [String("c"), String("d")]
  for t in <ts
    !keep.push(<t)
  print(keep)

fail "for temporary source loans", "26:2: cannot drop `t` while it is lent", "34:2: cannot drop `v` while it is lent", errors: 2
  # The elements of a `for` over a value no binding holds (an array
  # literal, or a call's result) carry what that value views, so one
  # stored outside the loop keeps it viewed.

  obj C
    s: ?String

  fun halves(s: ?String) -> [2]?String
    [s[..s.len / 2], s[s.len / 2..]]

  fun firsts(s: ?String) -> List[?String]
    v: List[?String] = List()
    !v.push(s[..1])
    v

  t = String("abcdefghijklmnop")
  o: ?String = "x"
  for x in [?t[..1], ?t[1..2]]
    o = x
  for c in [C(s: ?t[..3])]
    o = c.s
  for x in halves(?t)
    o = x
  for x in firsts(?t)
    o = x
  <t
  print(o)
  v: List[Int] = List()
  !v.push(1)
  e: List[Int] = List()
  sl = ?e[..]
  for x in [?v[..], ?v[..1]]
    sl = x
  <v
  print(sl)

fail "for write iteration conflicts", "cannot write-iterate parameter `xs`", "cannot write-iterate a `Static`", "`xs` must be a binding, or a field or element of one"
  # `for x in !xs` needs a place it may write.

  fun make() -> List[Int]
    List()

  sub read_only(xs: ?List[Int])
    for x in !xs
      x += 1

  for c in !"abc"
    print(c)
  for y in !make()
    y = 1

fail "for write iteration conflicts ownership", "6:11: cannot lend `v` to write while a read loan is live"
  # `for x in !xs` lends `xs` to write for the whole loop.

  v: List[Int] = List()
  !v.push(1)
  r = ?v
  for x in !v
    x = 2
  print(r.len)

fail "for write view elements", "10:6: a write view is never stored inside a value, and `!Int` cannot stand here", "12:6: a write view is never stored inside a value, and `!H` cannot stand here", errors: 2
  # An array cannot hold write views (`[2]!Int`, `[1]!H`): a write view is
  # never stored inside a value, so no loop walks elements that are write
  # views.

  obj H
    n: Int

  n = 1
  m = 2
  xs = [!n, !m]
  a = H(n: 1)
  hs = [!a]
  print(xs.len, hs.len)
