test "imported variant positional", '''
  4 5 .some(value: "x") .some(value: 6)
'''
  # A variant of another module's enum takes its one field by position too.

  use geo

  fun radius(s: geo.Shape) -> Int
    match s
      .circle(r) => r
      .rect(w, h) => w + h

  sub main()
    a: geo.Shape = .circle(4)
    b = geo.Shape.circle(5)
    m = geo.Maybe.some("x")
    n: geo.Maybe[Int] = .some(6)
    print(radius(a), radius(b), m, n)

  file "geo.rig"
    pub enum Shape
      circle(radius: Int)
      rect(w: Int, h: Int)

    pub enum Maybe[T]
      some(value: T)
      nothing

fail "imported view stored through write view", "`x` does not live long enough"
  # An imported function's write view parameter carries the loans stored
  # through it, as a local one does: `put` stores `?x` into `holder`,
  # which outlives `x`.

  use a

  sub main()
    y = a.Wrap(v: List())
    !y.v.push(1)
    holder = a.Holder(b: ?y)
    if true
      x = a.Wrap(v: List())
      !x.v.push(42)
      a.put(!holder, ?x)
    print(holder.b.v[0])

  file "a.rig"
    pub obj Wrap
      pub v: List[Int]

    pub obj Holder
      pub b: ?Wrap

    pub sub put(t: !Holder, x: ?Wrap) keeps x
      t.b = x

fail "imported write view holder copy", "5:10: a write view is never stored inside a value, and `!Wrap` cannot stand here", errors: 1
  # An imported struct cannot hold a write view (a write view is never
  # stored inside a value), so no copy of one can be a second writer.

  use wv

  sub main()
    x: wv.Wrap = wv.Wrap(v: List())
    !x.v.push(1)
    a = wv.WV(b: !x)
    b = a
    b.b.v = List()
    print(a.b.v.len)

  file "wv.rig"
    pub obj Wrap
      pub v: List[Int]

    pub obj WV
      pub b: !Wrap

fail "imported blocker names its own type", "8:15: `x` is lent to a task to read: `?lib.FS` holds `*fun(?String) -> String?`, an owned closure, whose captures its type does not show", "12:17: `y` is lent to a task to read: `?lib.Pool` holds `Task[lib.Res]`, a task, which only the one that holds it may wait for", errors: 2
  # What keeps a value of another module's object from a task is named
  # as that module declares it: the type of the field that blocks, read
  # in its own module's table, never this module's.

  use lib

  sub probe_fs(x: ?lib.FS)
    t = read_fs(x)&
    print(>t)

  sub probe_pool(y: ?lib.Pool)
    t = read_pool(y)&
    print(>t)

  fun read_fs(x: ?lib.FS) -> Int
    1

  fun read_pool(y: ?lib.Pool) -> Int
    2

  sub main()
    print(0)

  file "lib.rig"
    pub obj FS
      pub read: *fun(?String) -> String?

    pub obj Res
      pub n: Int

    pub obj Pool
      pub t: Task[Res]?

test "imported plain narrows another module's generic", "3 1 1 3 1 2 1"
  # A generic that tests `$plain` in another module takes each instance's
  # answer, and a generic here that builds it from its own parameters
  # passes its own on (SPEC "Generic bodies").
  use slots

  obj W[V]
    m: slots.Slots[V]

  fun fresh[V]() -> W[V]
    m: slots.Slots[V] = slots.Slots()
    W(m: <m)

  fun twice[T](x: T) -> Int
    slots.spread(<x, 2).len

  sub main()
    a = slots.Slots[Int]()
    !a.es.push(1)
    !a.fill(3)
    b = slots.Slots[String]()
    !b.es.push(String("s"))
    !b.fill(3)
    n = 4
    w = fresh[?Int]()
    !w.m.es.push(?n)
    !w.m.fill(3)
    print(a.es.len, b.es.len, w.m.es.len, slots.spread(5, 3).len, slots.spread(String("x"), 3).len, twice(1), twice(String("y")))

  file "slots.rig"
    pub obj Slots[K]
      pub es: List[K] = List()

      pub sub fill(!@, n: Int)
        if $plain(K) and @es.len > 0
          k = @es[0]
          while @es.len < n
            !@es.push(k)

    pub fun spread[T](x: T, n: Int) -> List[T]
      out: List[T] = List()
      if $plain(T)
        while out.len < n - 1
          !out.push(x)
      !out.push(<x)
      out
