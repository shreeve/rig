fail "par named function takes the element", "`par.map` calls `name_len` with each element as `?Int`, and `name_len` takes `?String`", errors: 1
  # A function's name is called with what the runtime passes: each
  # element's view, or the value of a scalar's.
  use std.par

  fun name_len(s: ?String) -> Int
    s.len

  xs = List([1, 2])
  print(par.map(?xs, name_len))

