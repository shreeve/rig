test "par limit before closure", seeds: 20, '''
  [10, 20, 30]
  [11, 21, 31]
  [22, 42, 62]
'''
  # `limit:` comes before a closure written last.
  use std.par

  xs = List([1, 2, 3])
  par.each(!xs, limit: 3, |x| x *= 10)
  print(xs)
  par.each(!xs, limit: 3, |x|
    x += 1
  )
  print(xs)
  print(par.map(?xs, limit: 2, |x| x * 2))

test "par path capture", seeds: 20, '''
  [3, 6, 9]
  [4, 8, 12]
'''
  # Every task reads the field a closure captures, `|?cfg.k|` or `|+cfg.k|`,
  # while `cfg`'s other field stays the method's to write.
  use std.par

  obj Cfg
    k: Int
    log: List[Int]

  cfg = Cfg(k: 3, log: List[Int]())
  print(par.map(?[1, 2, 3], |?cfg.k, x| x * cfg.k))
  !cfg.log.push(1)
  cfg.k = 4
  print(par.map(?[1, 2, 3], |+cfg.k, x| x * cfg.k))

fail "par generic instance owned closure", "`go[*fun() -> Int]` cannot use `T = *fun() -> Int`: a value that holds a `T` is lent to tasks to read in the generic body, and `*fun() -> Int` is an owned closure", errors: 1
  use std.par

  fun go[T](xs: ?List[T]) -> List[Int]
    par.map(xs, |x| 1)

  xs: List[*fun() -> Int] = List()
  !xs.push(*|| 4)
  print(go(?xs))

fail "par generic capture owned closure", "`go[*fun() -> Int]` cannot use `T = *fun() -> Int`: a value that holds a `T` is lent to tasks to read in the generic body", errors: 1
  use std.par

  fun go[T](v: ?T) -> List[Int]
    xs = List([1, 2])
    par.map(?xs, |?v, x| x)

  cb: *fun() -> Int = *|| 4
  print(go(?cb))

test "par generic instances", seeds: 20, "[1, 1] [2, 3]"
  use std.par

  fun go[T](xs: ?List[T]) -> List[Int]
    par.map(xs, |x| 1)

  fun inc[T](v: ?T) -> List[Int]
    xs = List([1, 2])
    par.map(?xs, |?v, x| x + 1)

  print(go(?List(["a", "b"])), inc(?3))

fail "par generic instance stays on one thread", "`go[*Node]` cannot use `T = *Node`: a value that holds a `T` is lent to tasks to read in the generic body, and `*Node` is a `*` handle whose count is not atomic", errors: 1
  use std.par

  obj Node
    v: Int

  fun go[T](xs: ?List[T]) -> List[Int]
    par.map(xs, |x| 1)

  xs: List[*Node] = List()
  !xs.push(*Node(v: 1))
  print(go(?xs))

test "par workers", seeds: 20, '''
  100 0 198 9900
  100 4950 3
  [1, 4, 9]
'''
  # `par.workers` runs one task for each state, each calling the closure
  # with its own state on the next item it takes, until none is left.
  # The values come back in the order of the items, whichever task made
  # each, and the states stay with the caller.
  use std.par

  obj Acc
    n: Int = 0
    sum: Int = 0

  fun square(acc: !Acc, x: ?Int) -> Int
    acc.n += 1
    x * x

  states = List([Acc(), Acc(), Acc()])
  xs: List[Int] = List()
  for i in 0..100
    !xs.push(i)
  ys = par.workers(!states, ?xs, |s, x|
    s.n += 1
    s.sum += x
    x * 2
  )
  print(ys.len, ys[0], ys[99], ys.sum())
  n = 0
  sum = 0
  for s in states
    n += s.n
    sum += s.sum
  print(n, sum, states.len)
  one = [Acc()]
  print(par.workers(!one, ?[1, 2, 3], square))

test "par workers gives nothing", seeds: 20, "4950 true"
  # A closure that gives nothing makes a call that gives nothing: what
  # each task does stays in its state.
  use std.par

  obj Sum
    total: Int = 0
    seen: List[Int]

  states: List[Sum] = List()
  for _ in 0..4
    !states.push(Sum(seen: List[Int]()))
  xs: List[Int] = List()
  for i in 0..100
    !xs.push(i)
  par.workers(!states, ?xs, |s, x|
    s.total += x
    !s.seen.push(x)
  )
  total = 0
  seen = 0
  for s in states
    total += s.total
    seen += s.seen.len
  print(total, seen == 100)

test "par workers few items", seeds: 20, '''
  [10, 20] 2
  [] 0
  []
'''
  # With more states than items, the tasks that find none left end at
  # once; with no items, none is called.
  use std.par

  obj Count
    n: Int = 0

  states = List([Count(), Count(), Count(), Count(), Count()])
  ys = par.workers(!states, ?[1, 2], |s, x|
    s.n += 1
    x * 10
  )
  n = 0
  for s in states
    n += s.n
  print(ys, n)
  no_items: List[Int] = List()
  before = states[0].n + states[1].n
  zs = par.workers(!states[..2], ?no_items, |s, x|
    s.n += 100
    x
  )
  print(zs, states[0].n + states[1].n - before)
  empty: List[Count] = List()
  print(par.workers(!empty, ?no_items, |s, x| x))

test "par workers heavy first", seeds: 20, '''
  60 36 true
  1 2 3
'''
  # Items taken in the caller's order, heaviest first, balance an uneven
  # load: each task takes the next item as it is free, so the busiest
  # state does less than the one a fixed split of the same items gives
  # every heavy item. A unit of work is a millisecond's sleep, while the
  # other tasks run; the work each state did is counted, not timed.
  use std.par
  use std.time

  obj Load
    work: Int = 0

  # Weights, heaviest first: four heavy items of 8, then light ones.
  weights: List[Int] = List()
  for _ in 0..4
    !weights.push(8)
  for _ in 0..28
    !weights.push(1)
  states = List([Load(), Load(), Load(), Load()])
  got = par.workers(!states, ?weights, |s, w|
    for _ in 0..w
      time.sleep(time.MS)!
    s.work += w
    w
  ) catch List[Int]()
  most = 0
  total = 0
  for s in states
    most = s.work if s.work > most
    total += s.work
  # A fixed split of 4 consecutive runs: the first takes all four heavy items.
  fixed = 0
  for k in 0..4
    part = 0
    for i in k * 8..(k + 1) * 8
      part += weights[i]
    fixed = part if part > fixed
  print(total, fixed, most < fixed)
  print(got[0] / 8, got[4] + 1, got[31] + 2)

test "par workers fails", seeds: 20, '''
  Bad.odd
  0
  ["n1", "n2", "n3"]
'''
  # A closure that can fail makes the call fail: the first failure stops
  # the tasks taking more items, and cancels them; the values made are
  # dropped, and the states stay with the caller.
  use std.par
  use std.task

  error Bad
    odd

  obj Log
    names: List[String]

  fun name(log: !Log, n: Int) -> String!
    return Bad.odd if n == 37
    task.check()!
    !log.names.push(String("n", n))
    String("n", n)

  states: List[Log] = List()
  for _ in 0..3
    !states.push(Log(names: List[String]()))
  xs: List[Int] = List()
  for i in 0..100
    !xs.push(i)
  r = par.workers(!states, ?xs, |s, x| name(!s, x)!) catch |e|
    print(e)
    List[String]()
  print(r.len)
  print(par.workers(!states, ?xs[1..4], |s, x| name(!s, x)!) catch List[String]())

