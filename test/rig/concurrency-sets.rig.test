fail "sets wait first args", "`wait_first` takes nothing; to give it a deadline, call it in `time.within`: `time.within(2, |<ts| <ts.wait_first()!)`", errors: 1
  fun sq(x: Int) -> Int!
    x * x

  ts = Tasks[Int!]()
