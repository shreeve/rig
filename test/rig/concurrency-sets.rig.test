test "sets wait first within", seeds: 20, '''
  slow stops
  7
'''
  # `time.within` gives `wait_first` a deadline, as it does `>ts`.
  use std.time

  fun slow() -> Int!
    defer print("slow stops")
    time.sleep(10)!
    1

  fun quick() -> Int!
    7

  ts = Tasks[Int!]()
  !ts.add(slow()&)
  !ts.add(quick()&)
  print(time.within(1, |<ts| <ts.wait_first()!) catch -1)

fail "sets keep views", "cannot change `xs` while a read view of it is still in use", errors: 1
  # A set keeps the loans of its tasks.
  # oracle: main reject C4
  fun total(xs: ?List[Int]) -> Int
    xs.len

  xs: List[Int] = List()
  ts = Tasks[Int]()
  !ts.add(total(?xs)&)
  !xs.push(1)
  print(>ts)

test "sets waited end their views", seeds: 20, "[0] 1"
  # `>ts` takes the set, and what it gives views nothing.
  # oracle: main accept
  fun total(xs: ?List[Int]) -> Int
    xs.len

  xs: List[Int] = List()
  ts = Tasks[Int]()
  !ts.add(total(?xs)&)
  r = >ts
  !xs.push(1)
  print(r, xs.len)

fail "sets waited give what their tasks view", "cannot change `xs` while a read view of it is still in use", errors: 1
  # What a set's tasks give may view what they were given.
  # oracle: main reject C4
  fun first(v: ?List[String]) -> ?String
    ?v[0]

  xs: List[String] = List()
  !xs.push(String("a"))
  ts = Tasks[?String]()
  !ts.add(first(?xs)&)
  r = >ts
  !xs.push(String("b"))
  print(r)

fail "sets in a closure keep their views", "cannot change `xs` while a read view of it is still in use", errors: 1
  # A closure that holds a set drops it where the closure's binding
  # ends, which waits for its tasks.
  # oracle: main reject C4
  fun total(v: ?List[Int]) -> Int
    v.len

  xs: List[Int] = List()
  ts = Tasks[Int]()
  !ts.add(total(?xs)&)
  f = |<ts| ts.len
  print(f())
  !xs.push(1)
  print(xs.len)

fail "sets through a generic keep their views", "cannot change `xs` while a read view of it is still in use", errors: 1
  # oracle: main reject C4
  fun total(v: ?List[Int]) -> Int
    v.len

  fun hand[T](x: T) -> T
    x

  xs: List[Int] = List()
  ts = Tasks[Int]()
  !ts.add(total(?xs)&)
  us = hand(<ts)
  !xs.push(1)
  print(>us)

fail "sets stored by a generic keep their views", "cannot change `xs` while a read view of it is still in use", errors: 1
  # oracle: main reject C4
  fun total(v: ?List[Int]) -> Int
    v.len

  sub put[T](l: !Tasks[T], x: Task[T])
    !l.add(<x)

  xs: List[Int] = List()
  ts = Tasks[Int]()
  put(!ts, total(?xs)&)
  !xs.push(1)
  print(>ts)

