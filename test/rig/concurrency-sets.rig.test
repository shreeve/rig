# concurrency: tests whose names start `sets`.

test "sets wait all", seeds: 20, '''
  4
  [0, 1, 4, 9]
'''
  # `Tasks[T]` holds tasks of one type; `>ts` waits for them all and gives
  # their results in the order added.
  fun sq(x: Int) -> Int
    x * x

  ts = Tasks[Int]()
  for i in 0..4
    !ts.add(sq(i)&)
  print(ts.len)
  print(>ts)

test "sets order added", seeds: 20, "[10, 20]"
  # The second task ends first; the results keep the order added.
  use std.time

  fun fetch(n: Int, ms: Int) -> Int!
    time.sleep(ms: ms)!
    n * 10

  ts = Tasks[Int!]()
  !ts.add(fetch(1, 20)&)
  !ts.add(fetch(2, 1)&)
  >ts!

test "sets first error", seeds: 20, release: true, '''
  slow 1 stops
  Fetch.missing
  true
'''
  # The first task to fail cancels the rest, and the wait fails with its
  # error.
  use std.time

  error Fetch
    missing

  fun fail_soon() -> Int!
    time.sleep(ms: 5)!
    return Fetch.missing

  fun slow(n: Int) -> Int!
    defer print("slow", n, "stops")
    time.sleep(10)!
    n

  fun run() -> Int!
    ts = Tasks[Int!]()
    !ts.add(slow(1)&)
    !ts.add(fail_soon()&)
    xs = >ts!
    xs.len

  start = time.monotonic()
  run() catch |e| print(e)
  print(start.elapsed() < time.duration(5))

test "sets deadline", seeds: 20, '''
  slow stops
  Stop.timeout true
'''
  # A wait for a set made before a deadline, given the set in
  # `time.within`, cancels what is still running when the deadline
  # passes.
  use std.task
  use std.time

  fun slow() -> Int!
    defer print("slow stops")
    time.sleep(10)!
    1

  fun run() -> Int!
    ts = Tasks[Int!]()
    !ts.add(slow()&)
    xs = time.within(ms: 20, |<ts| >ts!)!
    xs.len

  run() catch |e| print(e, e == task.Stop.timeout)

test "sets wait first", seeds: 20, '''
  slow stops
  50
'''
  # The first task to succeed; a failure before it is passed over.
  use std.time

  error Fetch
    missing

  fun fetch(n: Int, ms: Int) -> Int!
    time.sleep(ms: ms)!
    return Fetch.missing if n == 3
    n * 10

  fun slow() -> Int!
    defer print("slow stops")
    time.sleep(10)!
    1

  ts = Tasks[Int!]()
  !ts.add(slow()&)
  !ts.add(fetch(3, 1)&)
  !ts.add(fetch(5, 5)&)
  print(<ts.wait_first()!)

test "sets wait first all fail", seeds: 20, "Fetch.late"
  # When every task fails, `wait_first` fails with the last error.
  use std.time

  error Fetch
    early
    late

  fun early() -> Int!
    return Fetch.early

  fun late() -> Int!
    time.sleep(ms: 20)!
    return Fetch.late

  fun run() -> Int!
    ts = Tasks[Int!]()
    !ts.add(early()&)
    !ts.add(late()&)
    <ts.wait_first()!

  run() catch |e| print(e)

test "sets drop cancels", seeds: 20, '''
  slow stops
  done
'''
  # Dropping a set cancels the tasks that can fail, then waits for them.
  use std.time

  fun slow() -> Int!
    defer print("slow stops")
    time.sleep(10)!
    1

  fun run(early: Bool) -> Int!
    ts = Tasks[Int!]()
    !ts.add(slow()&)
    return 0 if early
    xs = >ts!
    xs.len

  run(true) catch 0
  print("done")

test "sets void", seeds: 20, '''
  1
  done 3
'''
  # A set of tasks that give nothing drops each that ended well as the
  # next is added, so it holds only those still running.
  use std.time

  sub say(n: Int)
    time.sleep(ms: n) catch print("woken")

  ts = Tasks[Void]()
  !ts.add(say(0)&)
  time.sleep(ms: 20)!
  !ts.add(say(30)&)
  print(ts.len)
  >ts
  print("done", 3)

test "sets both", seeds: 20, '''
  user2 6
  6
'''
  # `task.all` waits for two tasks of different types.
  use std.task
  use std.time

  fun user(id: Int) -> String!
    time.sleep(ms: 5)!
    String("user", id)

  fun orders(id: Int) -> Int!
    id * 3

  fun both(id: Int) -> Int!
    u, o = task.all(user(id)&, orders(id)&)!
    print(u, o)
    o

  print(both(2) catch -1)

test "sets both fails", seeds: 20, '''
  slow stops
  -1
'''
  # The first to fail cancels the other.
  use std.task
  use std.time

  error Fetch
    missing

  fun slow() -> Int!
    defer print("slow stops")
    time.sleep(10)!
    1

  fun missing() -> Int!
    return Fetch.missing

  fun run() -> Int!
    a, b = task.all(slow()&, missing()&)!
    a + b

  print(run() catch -1)

test "sets all", seeds: 20, "4 9 16 25"
  # `task.all` takes two tasks or more; a moved task too.
  use std.task

  fun sq(x: Int) -> Int
    x * x

  t = sq(5)&
  a, b, c, d = task.all(sq(2)&, sq(3)&, sq(4)&, <t)
  print(a, b, c, d)

test "sets all subs", seeds: 20, '''
  0 1
  0 30
  1
'''
  # `task.all` of tasks that give nothing gives nothing, a statement;
  # their loans end where it returns.
  use std.task
  use std.time

  sub say(xs: ?List[Int], ms: Int)
    time.sleep(ms: ms) catch print("woken")
    print(xs.len, ms)

  xs: List[Int] = List()
  task.all(say(?xs, 30)&, say(?xs, 1)&)
  !xs.push(4)
  print(xs.len)

fail "sets all subs write", "this task holds a write view while it runs, so it stays where it is bound", errors: 2
  # A task given as a write view is bound and waited for where it is bound, as
  # a task that gives a value is.
  use std.task

  sub fill(xs: !List[Int])
    !xs.push(1)

  a: List[Int] = List()
  b: List[Int] = List()
  task.all(fill(!a)&, fill(!b)&)

test "sets all subs fail", seeds: 20, '''
  slow stops
  Fetch.missing
  done
'''
  # The first to fail cancels the others, and the wait passes its
  # error on with `!`.
  use std.task
  use std.time

  error Fetch
    missing

  sub slow()!
    defer print("slow stops")
    time.sleep(10)!

  sub missing()!
    return Fetch.missing

  sub quick()!
    task.check()!

  sub run()!
    task.all(slow()&, missing()&, quick()&)!
    print("not reached")

  run() catch |e| print(e)
  print("done")

test "sets all subs catch", seeds: 20, '''
  ok
  Fetch.missing
'''
  # A `catch` handles the wait's failure where it stands.
  use std.task

  error Fetch
    missing

  sub fine(n: Int)!
    task.check()!

  sub missing()!
    return Fetch.missing

  task.all(fine(1)&, fine(2)&) catch |e| print(e)
  print("ok")
  task.all(fine(3)&, missing()&) catch |e| print(e)

test "sets all subs fail fields", seeds: 20, "E.bad(msg: \"big\")"
  # The first failure's fields pass on, as a valued wait's do.
  use std.task

  error E
    bad(msg: String)

  sub check(x: Int)!
    return E.bad(msg: String("big")) if x > 5

  sub both()!
    task.all(check(1)&, check(8)&)!

  both() catch |e| print(e)

test "sets all generic bound", seeds: 20, '''
  bound
  1
  2
  bound
'''
  # Tasks of a type parameter give a value, `T`, even where an instance
  # gives `Void`, so the generic body binds them alike for every `T`.
  use std.task
  use std.time

  sub say(n: Int)
    time.sleep(ms: n) catch print("woken")
    print(n)

  fun sq(n: Int) -> Int
    n * n

  sub both[T](a: Task[T], b: Task[T])
    x, y = task.all(<a, <b)
    print("bound")

  both(sq(2)&, sq(3)&)
  both[Void](say(1)&, say(2)&)

test "sets all generic statement", seeds: 20, '''
  1
  2
  waited
  waited
'''
  use std.task
  use std.time

  sub say(n: Int)
    time.sleep(ms: n) catch print("woken")
    print(n)

  fun sq(n: Int) -> Int
    n * n

  sub both[T](a: Task[T], b: Task[T])
    task.all(<a, <b)
    print("waited")

  both[Void](say(1)&, say(2)&)
  both(sq(2)&, sq(3)&)

test "sets all generic mixed", seeds: 20, '''
  1
  waited
'''
  # Two type parameters give values, whatever their instances: `Void`
  # and `Int` wait together here, where `say(1)&` and `sq(3)&` written
  # out would be rejected as a mix.
  use std.task

  sub say(n: Int)
    print(n)

  fun sq(n: Int) -> Int
    n * n

  sub both[T, U](a: Task[T], b: Task[U])
    task.all(<a, <b)
    print("waited")

  both[Void, Int](say(1)&, sq(3)&)

test "sets all generic fun", seeds: 20, '''
  1
  2
  1
'''
  use std.task
  use std.time

  sub say(n: Int)
    time.sleep(ms: n) catch print("woken")
    print(n)

  fun both[T](a: Task[T], b: Task[T]) -> Int
    x, y = task.all(<a, <b)
    1

  print(both[Void](say(1)&, say(2)&))

