# std: a chain's `count` and `sum` over any iterator (`(!it).count()`),
# and every std iterator an `Iter` whose item is what a `for` loop gives.

test "iter count", "4 0"
  obj Count
    n: Int
    hi: Int

    fun next(!@) -> Int?
      return none if @n >= @hi
      @n += 1
      @n

  c = Count(n: 0, hi: 4)
  e = Count(n: 0, hi: 0)
  print((!c).count(), (!e).count())

test "iter an item whose optional holds its none in the item", "3 1 2 true"
  # `I.Item` of an item whose `T?` is no Zig `?T` (a `Bool` field's
  # niche, an object naming its none) is read as `sema.iterItem` reads it
  # (`rig.IterItem` through `Payload`).
  obj Flag
    n: Int
    on: Bool

  obj Id
    id: Int
    none id == 0

  obj Flags
    n: Int

    fun next(!@) -> Flag?
      return none if @n == 0
      @n -= 1
      Flag(n: @n, on: true)

  obj Ids
    n: Int

    fun next(!@) -> Id?
      return none if @n == 0
      @n -= 1
      Id(id: @n + 1)

  fun first[I: Iter](it: !I) -> I.Item?
    (!it).next()

  f = Flags(n: 3)
  g = Flags(n: 2)
  ids = Ids(n: 2)
  n = 0
  on = false
  if first(!g) as x
    n = x.n
    on = x.on
  id = 0
  if first(!ids) as y
    id = y.id
  print((!f).count(), n, id, on)

test "iter sum", "10 7.5 0"
  obj Count
    n: Int
    hi: Int

    fun next(!@) -> Int?
      return none if @n >= @hi
      @n += 1
      @n

  obj Halves
    x: Float

    fun next(!@) -> Float?
      return none if @x < 1.0
      @x = @x / 2.0
      @x

  c = Count(n: 0, hi: 4)
  h = Halves(x: 8.0)
  e = Count(n: 0, hi: 0)
  print((!c).sum(), (!h).sum(), (!e).sum())

fail "iter sum of what is no number", "3:12: `sum` adds numbers, and these items are `?String`s"
  use std.text
  s = text.split("a b", " ")
  print((!s).sum())

fail "iter count of what is no iterator", "5:12: no method `count` on type `Label`"
  obj Label
    n: Int

  l = Label(n: 1)
  print((!l).count())

test "iter every std iterator", '''
  3 a
  3 a
  2 x
  2 x
  2 p
  2 p
  3 a
  3 a
  3 97
  3 97
  2 1
  2 1
'''
  # Each std iterator is an `Iter` whose item is what the loop gives: a
  # body bounded by `Iter` prints its count and first item, and a loop
  # over another of the same prints the same. A Map's and a Set's are
  # walked by a loop here, and by a body bounded by `Iter` in "iter a
  # map's iterator".
  use std.text
  use std.utf8

  sub show[I: Iter, I.Item: Print + Copy](a: !I)
    first = (!a).next()
    n = 1 + (!a).count()
    if first as f
      print(n, f)

  s1 = text.split("a b c", " ")
  show(!s1)
  s2 = text.split("a b c", " ")
  k = 0
  for x in !s2
    print(3, x) if k == 0
    k += 1
  l1 = text.lines("x\ny")
  show(!l1)
  l2 = text.lines("x\ny")
  for x in !l2
    print(2, x) if x == "x"
  w1 = text.words("p q")
  show(!w1)
  w2 = text.words("p q")
  for x in !w2
    print(2, x) if x == "p"
  c1 = text.chars("abc")
  show(!c1)
  c2 = text.chars("abc")
  for x in !c2
    print(3, x) if x == "a"
  r1 = utf8.runes("abc")
  show(!r1)
  r2 = utf8.runes("abc")
  for x in !r2
    print(3, x) if x == 97
  m: Map[Int, Int] = Map()
  !m.put(1, 10)
  !m.put(2, 20)
  k2 = ?m.keys()
  for x in !k2
    print(2, x) if x == 1
  st: Set[Int] = Set()
  !st.add(1)
  !st.add(2)
  e2 = ?st.items()
  for x in !e2
    print(2, x) if x == 1

test "iter a map's iterator", "2 1 2"
  # A Map's and a Set's iterators view the Map or Set, not themselves
  # (`next(!@) -> (?K)? from @map`), so a body bounded by `Iter` takes
  # them.
  m: Map[Int, Int] = Map()
  !m.put(1, 10)
  !m.put(2, 20)
  k = ?m.keys()
  st: Set[Int] = Set()
  !st.add(5)
  e = ?st.items()
  v = ?m.values()
  print((!k).count(), (!e).count(), (!v).count())

test "iter sum of a map's values", "30 2.5 0"
  # A chain's `sum` adds items that are views of numbers, a Map's
  # values, by their numbers; the sum of none is 0.
  m: Map[Int, Int] = Map()
  !m.put(1, 10)
  !m.put(2, 20)
  f: Map[String, F32] = Map()
  !f.put(String("a"), 1.5)
  !f.put(String("b"), 1.0)
  e: Map[Int, Int] = Map()
  print(?m.values().sum(), ?f.values().sum(), ?e.values().sum())

test "iter holds two items", '''
  1 2
  10 20
  5 6
  7 8
'''
  # A body bounded by `Iter` may hold two items at once: each views what
  # the iterator views, never the iterator, over a Map's, a Set's, and a
  # List cursor's items.

  obj Cursor
    items: ?List[Int]
    at: Int

    fun next(!@) -> (?Int)? from @items
      return none if @at >= @items.len
      @at += 1
      ?@items[@at - 1]

  sub two[I: Iter, I.Item: Print + Copy](it: !I)
    a = (!it).next()
    b = (!it).next()
    if a as x
      if b as y
        print(x, y)

  m: Map[Int, Int] = Map()
  !m.put(1, 10)
  !m.put(2, 20)
  k = ?m.keys()
  two(!k)
  vs = ?m.values()
  two(!vs)
  st: Set[Int] = Set()
  !st.add(5)
  !st.add(6)
  ms = ?st.items()
  two(!ms)
  l: List[Int] = List()
  !l.push(7)
  !l.push(8)
  c = Cursor(items: ?l, at: 0)
  two(!c)

test "iter an owned path", "2"
  # An item that views a field the iterator owns (`from @buf`) views the
  # iterator, and `count` holds none past the next `next`, so it takes
  # the iterator.

  obj Own
    buf: String
    at: Int

    fun next(!@) -> (?String)? from @buf
      return none if @at >= 2
      @at += 1
      ?@buf[..@at]

  o = Own(buf: String("ab"), at: 0)
  print((!o).count())

test "iter sum of items that view the iterator", "7"
  # A chain's `sum` reads each item into its total before the next
  # `next`, so an item that views the iterator's own List is added as
  # its number.

  obj Nums
    xs: List[Int]
    at: Int

    fun next(!@) -> (?Int)? from @
      return none if @at >= @xs.len
      @at += 1
      ?@xs[@at - 1]

  l: List[Int] = List()
  !l.push(3)
  !l.push(4)
  n = Nums(xs: <l, at: 0)
  print((!n).sum())
