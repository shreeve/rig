# std.datetime: the makers called with constant arguments (SPEC §13).
# `Date.new`, `Time.new`, and `DateTime.new` whose every argument is a
# constant are checked as Rig compiles and give the plain type, with no
# `!`; a constant they refuse is an error naming why and the fix; an
# argument known only as the program runs leaves the call fallible. The check agrees with std's at
# every boundary: each value either side of one is made by a constant
# call or refused by one, and std's own `new`, given it at run time,
# says the same.

use std.datetime

test "constant makers give the plain type", '''
  2024-02-29 23:59:59.999999999 -009999-01-01T00:00:00
  08:30:00 2026-11-17T00:05:00 2026-11-17T08:00:00
'''
  # Positional arguments, a keyword argument, and the defaults left out.
  print(datetime.Date.new(2024, 2, 29), datetime.Time.new(23, 59, 59, ns: 999_999_999), datetime.DateTime.new(-9999, 1, 1))
  print(datetime.Time.new(hour: 8, minute: 30, second: 0), datetime.DateTime.new(2026, 11, 17, minute: 5), datetime.DateTime.new(day: 17, month: 11, year: 2026, hour: 8))

test "a constant is what Rig's constant evaluation calls one", '''
  2026-12-31 2026-02-28 2026-12-01 2026-01-31
'''
  # A module constant, a binding never changed, constant arithmetic,
  # and the maker reached through a type alias: each is the same rule.
  LIMIT = 12
  type D = datetime.Date

  sub main()
    m = 2
    print(D.new(2026, LIMIT, 31), datetime.Date.new(2000 + 26, m, 28), datetime.Date.new(2026, LIMIT, LIMIT - 11), datetime.Date.new(2026, LIMIT - 11, 31))

test "an argument known only as the program runs needs the !", '''
  0005-01-01 2026-03-01 range 2026-01-31 2026-01-01
'''
  # A parameter, a binding the program changes, a compile-time
  # parameter (the same call serves every instance), and the maker
  # taken as a value: each call is fallible, as std declares it. The
  # maker called with constants in a generic body is checked there.
  fun at(y: Int) -> datetime.Date!
    datetime.Date.new(y, 1, 1)!

  fun month_start[m: Int]() -> datetime.Date!
    datetime.Date.new(2026, m, 1)!

  fun keep[T](x: T) -> datetime.Date
    datetime.Date.new(2026, 1, 1)

  sub main()!
    k = 1
    k += 1
    bad: datetime.Date? = datetime.Date.new(2023, k, 29) catch none
    make = datetime.Date.new
    print(at(5)!, month_start[3]()!, "range" if bad == none else "made", make(2026, 1, 31)!, keep(1))

fail "a constant the check refuses is an error", "1:32: `datetime.Date.new(2023, 2, 29)` always fails, its arguments being constants: February 2023 has 28 days; write a day from 1 to 28", "2:29: `datetime.Date.new(2026, 13, 1)` always fails, its arguments being constants: 13 is not a month; write a month from 1 to 12", "3:23: `datetime.Date.new(10000, 1, 1)` always fails, its arguments being constants: 10000 is beyond the years of a date, -9999 to 9999; write a year from -9999 to 9999", "4:23: `datetime.Time.new(24, 0, 0)` always fails, its arguments being constants: 24 is not an hour of the day; write an hour from 0 to 23", "5:43: `datetime.DateTime.new(2026, 4, 1, ns: 1_000_000_000)` always fails, its arguments being constants: 1000000000 is not a nanosecond of the second; write `ns` from 0 to 999_999_999", errors: 5
  a = datetime.Date.new(2023, 2, 29)
  b = datetime.Date.new(2026, 13, 1)!
  c = datetime.Date.new(10000, 1, 1)
  t = datetime.Time.new(24, 0, 0) catch datetime.Time.new(0, 0, 0)
  d = datetime.DateTime.new(2026, 4, 1, ns: 1_000_000_000)

fail "a refused constant through a name shows its value", "4:33: `datetime.Date.new(2026, LIMIT, 1)` always fails, its arguments being constants: 13 is not a month; write a month from 1 to 12", "5:36: `datetime.Date.new(2026, 4, m * 31)` always fails, its arguments being constants: April 2026 has 30 days; write a day from 1 to 30", errors: 2
  LIMIT = 13
  sub main()
    m = 1
    print(datetime.Date.new(2026, LIMIT, 1))
    print(datetime.Date.new(2026, 4, m * 31))

fail "! and catch on a call that cannot fail", "1:5: `!` needs a fallible operand, and `datetime.Date.new(2026, 1, 31)` cannot fail: its arguments are constants that pass its check, so it gives a `datetime.Date`; write it without `!`", "2:5: `catch` needs a fallible expression, and `datetime.Time.new(8, 30, 0)` cannot fail: its arguments are constants that pass its check, so it gives a `datetime.Time`; write it without `catch`", errors: 2
  d = datetime.Date.new(2026, 1, 31)!
  t = datetime.Time.new(8, 30, 0) catch datetime.Time.new(0, 0, 0)
  print(d, t)

fail "a value known only as the program runs still needs the !", "3:7: fallible call to `new` must be wrapped with `!` (propagate) or `catch` (handle)", "5:7: fallible call to `make` must be wrapped", errors: 2
  k = 1
  k += 1
  print(datetime.Date.new(2026, k, 1))
  make = datetime.Date.new
  print(make(2026, 1, 31))

code "a constant maker's call is unwrapped where it is made", "__rig_m2_std_datetime.Date.new(2026, 1, 31, rig.failSlot(&__rig_fail_1))) catch |__rig_fail_1_e| rig.makerPanic(__rig_fail_1_e)"
  print(datetime.Date.new(2026, 1, 31))

test "each date either side of a boundary: made by a constant call", '''
  -009999-01-01 9999-12-31 2026-01-01 2026-12-31 2026-01-31 2026-04-30
  2024-02-29 2023-02-28 2000-02-29 1900-02-28 0000-02-29 -000004-02-29 -000400-02-29 -000100-02-28
'''
  print(datetime.Date.new(-9999, 1, 1), datetime.Date.new(9999, 12, 31), datetime.Date.new(2026, 1, 1), datetime.Date.new(2026, 12, 31), datetime.Date.new(2026, 1, 31), datetime.Date.new(2026, 4, 30))
  print(datetime.Date.new(2024, 2, 29), datetime.Date.new(2023, 2, 28), datetime.Date.new(2000, 2, 29), datetime.Date.new(1900, 2, 28), datetime.Date.new(0, 2, 29), datetime.Date.new(-4, 2, 29), datetime.Date.new(-400, 2, 29), datetime.Date.new(-100, 2, 28))

fail "each date either side of a boundary: refused by a constant call", "1:23: 10000 is beyond", "2:23: -10000 is beyond", "3:29: 0 is not a month", "4:29: 13 is not a month", "5:32: January 2026 has 31 days", "6:32: January 2026 has 31 days", "7:32: April 2026 has 30 days", "8:32: February 2023 has 28 days", "9:32: February 1900 has 28 days", "10:32: February 2024 has 29 days", "11:32: February -100 has 28 days", "12:30: February -1 has 28 days", errors: 12
  a = datetime.Date.new(10000, 12, 31)
  b = datetime.Date.new(-10000, 1, 1)
  c = datetime.Date.new(2026, 0, 1)
  d = datetime.Date.new(2026, 13, 1)
  e = datetime.Date.new(2026, 1, 0)
  f = datetime.Date.new(2026, 1, 32)
  g = datetime.Date.new(2026, 4, 31)
  h = datetime.Date.new(2023, 2, 29)
  i = datetime.Date.new(1900, 2, 29)
  j = datetime.Date.new(2024, 2, 30)
  k = datetime.Date.new(-100, 2, 29)
  l = datetime.Date.new(-1, 2, 29)

test "each date either side of a boundary: std's new at run time agrees", '''
  ok ok ok ok ok ok ok ok ok ok ok ok ok ok
  range range range range range range range range range range range range
'''
  fun made(y: Int, m: Int, d: Int) -> String
    _ = datetime.Date.new(y, m, d) catch return String("range")
    String("ok")

  sub main()
    print(made(-9999, 1, 1), made(9999, 12, 31), made(2026, 1, 1), made(2026, 12, 31), made(2026, 1, 31), made(2026, 4, 30), made(2024, 2, 29), made(2023, 2, 28), made(2000, 2, 29), made(1900, 2, 28), made(0, 2, 29), made(-4, 2, 29), made(-400, 2, 29), made(-100, 2, 28))
    print(made(10000, 12, 31), made(-10000, 1, 1), made(2026, 0, 1), made(2026, 13, 1), made(2026, 1, 0), made(2026, 1, 32), made(2026, 4, 31), made(2023, 2, 29), made(1900, 2, 29), made(2024, 2, 30), made(-100, 2, 29), made(-1, 2, 29))

test "each time either side of a boundary: made by a constant call", '''
  00:00:00 23:59:59.999999999 2026-11-17T00:00:00 9999-12-31T23:59:59.999999999
'''
  print(datetime.Time.new(0, 0, 0, ns: 0), datetime.Time.new(23, 59, 59, ns: 999_999_999), datetime.DateTime.new(2026, 11, 17, hour: 0, minute: 0, second: 0, ns: 0), datetime.DateTime.new(9999, 12, 31, hour: 23, minute: 59, second: 59, ns: 999_999_999))

fail "each time either side of a boundary: refused by a constant call", "1:23: -1 is not an hour", "2:23: 24 is not an hour", "3:26: -1 is not a minute", "4:26: 60 is not a minute", "5:29: -1 is not a second", "6:29: 60 is not a second", "7:36: -1 is not a nanosecond", "8:36: 1000000000 is not a nanosecond", "9:47: 24 is not an hour", "10:69: 60 is not a second", "11:36: February 2023 has 28 days", errors: 11
  a = datetime.Time.new(-1, 0, 0)
  b = datetime.Time.new(24, 0, 0)
  c = datetime.Time.new(0, -1, 0)
  d = datetime.Time.new(0, 60, 0)
  e = datetime.Time.new(0, 0, -1)
  f = datetime.Time.new(0, 0, 60)
  g = datetime.Time.new(0, 0, 0, ns: -1)
  h = datetime.Time.new(0, 0, 0, ns: 1_000_000_000)
  i = datetime.DateTime.new(2026, 11, 17, hour: 24)
  j = datetime.DateTime.new(2026, 11, 17, hour: 0, minute: 0, second: 60)
  k = datetime.DateTime.new(2023, 2, 29, hour: 0)

test "each time either side of a boundary: std's new at run time agrees", '''
  ok ok ok ok
  range range range range range range range range range range range
'''
  fun clock(h: Int, m: Int, s: Int, ns: Int) -> String
    _ = datetime.Time.new(h, m, s, ns: ns) catch return String("range")
    String("ok")

  fun stamp(y: Int, mo: Int, d: Int, h: Int, mi: Int, s: Int, ns: Int) -> String
    _ = datetime.DateTime.new(y, mo, d, hour: h, minute: mi, second: s, ns: ns) catch return String("range")
    String("ok")

  sub main()
    print(clock(0, 0, 0, 0), clock(23, 59, 59, 999_999_999), stamp(2026, 11, 17, 0, 0, 0, 0), stamp(9999, 12, 31, 23, 59, 59, 999_999_999))
    print(clock(-1, 0, 0, 0), clock(24, 0, 0, 0), clock(0, -1, 0, 0), clock(0, 60, 0, 0), clock(0, 0, -1, 0), clock(0, 0, 60, 0), clock(0, 0, 0, -1), clock(0, 0, 0, 1_000_000_000), stamp(2026, 11, 17, 24, 0, 0, 0), stamp(2026, 11, 17, 0, 0, 60, 0), stamp(2023, 2, 29, 0, 0, 0, 0))

test "a constant maker beside a binding the program names e", "2026-01-31 1 2026-01-31T08:00:00"
  # What emit writes for the call names nothing the program can.
  e = 1
  print(datetime.Date.new(2026, 1, 31), e, datetime.DateTime.new(2026, 1, 31, hour: 8))

test "a task of a constant maker's call holds what it declares", "2026-01-31"
  # The rule is the call's: a task of it waits for a `Date!`.
  t = datetime.Date.new(2026, 1, 31)&
  print(>t!)

test "a constant maker's call is never a site of a failure's trace", exit: 1, file: "sites.rig", stderr: "error: DateTimeError.range\n  std/datetime/date.rig:18:7 in Date.new\n  sites.rig:5:7 in make\n  sites.rig:11:7 in main", release: true, '''
  2026-01-31 2026-03-01
'''
  # The constant call before the failing one passes on no failure.
  fun make(m: Int) -> datetime.Date!
    base = datetime.Date.new(2026, 1, 31)
    d = datetime.Date.new(2026, m, 1)!
    print(base, d)
    d

  sub main()!
    _ = make(3)!
    _ = make(13)!

fail "a task of a refused constant is refused as Rig compiles", "1:32: `datetime.Date.new(2026, 2, 30)` always fails, its arguments being constants: February 2026 has 28 days; write a day from 1 to 28", errors: 1
  t = datetime.Date.new(2026, 2, 30)&
  print(>t!)

fail "an argument with an error of its own gives that error alone", "1:34: overflows", errors: 1
  print(datetime.Date.new(2026, 1, Int.max + 1))

fail "a call that takes ! names the argument that is not a constant", "3:7: fallible call to `new` must be wrapped with `!` (propagate) or `catch` (handle)", "3:31: `m` is not a constant, so `datetime.Date.new(2026, m, 31)` can fail as the program runs; with every argument a constant it is checked as Rig compiles", errors: 1
  m = 1
  m += 2
  print(datetime.Date.new(2026, m, 31))
test "the last day of each month, in a leap and a common year: made by a constant call", '''
  2024-01-31 2024-02-29 2024-03-31 2024-04-30 2024-05-31 2024-06-30 2024-07-31 2024-08-31 2024-09-30 2024-10-31 2024-11-30 2024-12-31
  2023-01-31 2023-02-28 2023-03-31 2023-04-30 2023-05-31 2023-06-30 2023-07-31 2023-08-31 2023-09-30 2023-10-31 2023-11-30 2023-12-31
'''
  print(datetime.Date.new(2024, 1, 31), datetime.Date.new(2024, 2, 29), datetime.Date.new(2024, 3, 31), datetime.Date.new(2024, 4, 30), datetime.Date.new(2024, 5, 31), datetime.Date.new(2024, 6, 30), datetime.Date.new(2024, 7, 31), datetime.Date.new(2024, 8, 31), datetime.Date.new(2024, 9, 30), datetime.Date.new(2024, 10, 31), datetime.Date.new(2024, 11, 30), datetime.Date.new(2024, 12, 31))
  print(datetime.Date.new(2023, 1, 31), datetime.Date.new(2023, 2, 28), datetime.Date.new(2023, 3, 31), datetime.Date.new(2023, 4, 30), datetime.Date.new(2023, 5, 31), datetime.Date.new(2023, 6, 30), datetime.Date.new(2023, 7, 31), datetime.Date.new(2023, 8, 31), datetime.Date.new(2023, 9, 30), datetime.Date.new(2023, 10, 31), datetime.Date.new(2023, 11, 30), datetime.Date.new(2023, 12, 31))
fail "one past the last day of each month, in a leap and a common year: refused by a constant call", "1:33: January 2024 has 31 days", "2:33: February 2024 has 29 days", "3:33: March 2024 has 31 days", "4:33: April 2024 has 30 days", "5:33: May 2024 has 31 days", "6:33: June 2024 has 30 days", "7:33: July 2024 has 31 days", "8:33: August 2024 has 31 days", "9:33: September 2024 has 30 days", "10:35: October 2024 has 31 days", "11:35: November 2024 has 30 days", "12:35: December 2024 has 31 days", "13:34: January 2023 has 31 days", "14:34: February 2023 has 28 days", "15:34: March 2023 has 31 days", "16:34: April 2023 has 30 days", "17:34: May 2023 has 31 days", "18:34: June 2023 has 30 days", "19:34: July 2023 has 31 days", "20:34: August 2023 has 31 days", "21:34: September 2023 has 30 days", "22:35: October 2023 has 31 days", "23:35: November 2023 has 30 days", "24:35: December 2023 has 31 days", errors: 24
  x1 = datetime.Date.new(2024, 1, 32)
  x2 = datetime.Date.new(2024, 2, 30)
  x3 = datetime.Date.new(2024, 3, 32)
  x4 = datetime.Date.new(2024, 4, 31)
