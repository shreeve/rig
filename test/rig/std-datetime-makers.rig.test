test "days 28 to 32 of each month, in a leap and a common year: std's new at run time agrees", '''
  oooor oorrr oooor ooorr oooor ooorr oooor oooor ooorr oooor ooorr oooor
  oooor orrrr oooor ooorr oooor ooorr oooor oooor ooorr oooor ooorr oooor
'''
  fun day(y: Int, m: Int, d: Int) -> ?String
    _ = datetime.Date.new(y, m, d) catch return "r"
    "o"

  fun days(y: Int, m: Int) -> String
    `{day(y, m, 28)}{day(y, m, 29)}{day(y, m, 30)}{day(y, m, 31)}{day(y, m, 32)}`

  sub main()
    for y in [2024, 2023]
      print(days(y, 1), days(y, 2), days(y, 3), days(y, 4), days(y, 5), days(y, 6), days(y, 7), days(y, 8), days(y, 9), days(y, 10), days(y, 11), days(y, 12))
