# errors: a failure's trace. A failure that leaves `main` in a debug build
# is shown with the place of each site it passed, innermost first: where it
# began, then each `!` that passed it on; a release build shows none (the
# runner drops the trace's lines from what it expects there).

test "a trace names where a failure began and each `!` that passed it", exit: 1, file: "began.rig", stderr: "error: E.bad\n  began.rig:5:3\n  began.rig:9:7\n  began.rig:14:9", release: true, '''
  4
'''
  error E
    bad

  fun parse(s: ?String) -> Int!
    return E.bad if s == "x"
    s.len

  fun twice(s: ?String) -> Int!
    n = parse(s)!
    n * 2

  sub main()
    print(twice("ab")!)
    print(twice("x")!)

test "a trace leaves out a failure `catch` handled, and keeps one it made another", exit: 1, file: "caught.rig", stderr: "error: E.worse\n  caught.rig:6:3\n  caught.rig:10:7\n  caught.rig:16:22\n  caught.rig:20:9", '''
  errdefer ran
'''
  error E
    bad
    worse

  fun parse(s: ?String) -> Int!
    return E.bad if s == "x"
    s.len

  fun twice(s: ?String) -> Int!
    n = parse(s)!
    n * 2

  fun convert(s: ?String) -> Int!
    n = parse(s) catch 0
    errdefer print("errdefer ran")
    twice(s) catch |e| return E.worse
    n

  sub main()
    print(convert("x")!)

test "a trace passes through a closure and the function that calls it", exit: 1, file: "closure.rig", stderr: "error: E.bad\n  closure.rig:5:3\n  closure.rig:14:58\n  closure.rig:10:5\n  closure.rig:14:3"
  error E
    bad

  fun parse(s: ?String) -> Int!
    return E.bad if s == "x"
    s.len

  sub each(xs: []?String, f: ?sub(?String)!)!
    for x in xs
      f(x)!

  sub main()
    total = *Cell(0)
    each(["ab", "x"], |+total, l| !total.set(total.get() + parse(l)!))!

test "a trace carries a task's sites to its waiter", exit: 1, file: "task.rig", stderr: "error: E.bad\n  task.rig:7:3\n  task.rig:11:3\n  task.rig:15:9", seeds: 20
  use std.task

  error E
    bad

  fun parse(s: ?String) -> Int!
    return E.bad if s == "x"
    s.len

  fun work(s: String) -> Int!
    parse(s)! * 2

  sub main()
    t = work(String("x"))&
    print(>t!)

test "a trace carries the sites of the last failure `wait_first` gives", exit: 1, file: "first.rig", stderr: "error: E.bad\n  first.rig:7:3\n  first.rig:14:10", seeds: 20
  use std.task

  error E
    bad

  fun fails(k: Int) -> Int!
    return E.bad if k > 0
    k

  sub main()
    ts = Tasks[Int!]()
    !ts.add(fails(1)&)
    !ts.add(fails(2)&)
    print(<ts.wait_first()!)

test "a trace carries the sites of a failure in `task.isolate`", exit: 1, file: "isolate.rig", stderr: "error: E.bad\n  isolate.rig:7:3\n  isolate.rig:11:23\n  isolate.rig:11:7"
  use std.task

  error E
    bad

  fun parse(s: ?String) -> Int!
    return E.bad if s == "x"
    s.len

  sub main()
    n = task.isolate(|| parse("x")!)!
    print(n)

test "a trace carries the sites of the failure that stopped `par.map`", exit: 1, file: "par.rig", stderr: "error: E.bad\n  par.rig:7:3\n  par.rig:14:25\n  par.rig:14:8", seeds: 20
  use std.par

  error E
    bad

  fun parse(s: Int) -> Int!
    return E.bad if s == 7
    s

  sub main()
    xs = List[Int]()
    for i in 0..20
      !xs.push(i)
    ys = par.map(?xs, |x| parse(x)! * 2, limit: 4)!
    print(ys)

test "a trace passes through an actor's method", exit: 1, file: "actor.rig", stderr: "error: E.bad\n  actor.rig:10:5\n  actor.rig:17:9", '''
  1
'''
  use std.task

  error E
    bad

  obj Box
    n: Int

    fun take(!@, k: Int) -> Int!
      return E.bad if k > @n
      @n -= k
      @n

  sub main()
    a = *Actor(Box(n: 3))
    print((!a).take(2)!)
    print((!a).take(5)!)
