# concurrency: tests whose names start `cancel`.

test "cancel check", seeds: 20, '''
  Stop.canceled true
  -1
'''
  # `task.check()!` is the waiting point of a computation that never
  # waits: a cancel stops it there.
  use std.task
  use std.time

  fun count() -> Int!
    while true
      task.check()!

  t = count()&
  time.sleep(time.MS)!
  r = <t.cancel() catch |e|
    print(e, e == task.Stop.canceled)
    -1
  print(r)

test "cancel a bounded loop", seeds: 20, '''
  Stop.canceled true
  -1
'''
  # A loop whose trip count is known checks for waiting work between
  # strips of its turns, not in each: the cancel still reaches the task
  # spinning in one at its next `task.check()`.
  use std.task
  use std.time

  fun count() -> Int!
    total = 0
    for i in 0..1_000_000_000_000_000
      total += i
      if i % 100_000 == 99_999
        task.check()!
    total

  t = count()&
  time.sleep(time.MS)!
  r = <t.cancel() catch |e|
    print(e, e == task.Stop.canceled)
    -1
  print(r)

test "cancel sleep", seeds: 20, release: true, '''
  nap stops
  -1
  true
'''
  # A cancel interrupts a sleep, and the task's `defer`s run.
  use std.time

  fun nap() -> Int!
    defer print("nap stops")
    time.sleep(10 * time.SECOND)!
    1

  start = time.now()
  u = nap()&
  print(<u.cancel() catch -1)
  print(start.elapsed() < 5 * time.SECOND)

test "cancel sticky", seeds: 20, '''
  caught once
  -2
'''
  # A cancel stays: catching it once does not let the task carry on.
  use std.task
  use std.time

  fun stubborn() -> Int!
    time.sleep(10 * time.SECOND) catch print("caught once")
    task.check()!
    2

  v = stubborn()&
  print(<v.cancel() catch -2)

test "cancel through wait", seeds: 20, '''
  inner stops
  -1
'''
  # Waiting passes a cancel on to the task waited for.
  use std.time

  fun inner() -> Int!
    defer print("inner stops")
    time.sleep(10 * time.SECOND)!
    1

  fun outer() -> Int!
    t = inner()&
    x = >t!
    x + 1

  o = outer()&
  time.sleep(10 * time.MS)!
  print(<o.cancel() catch -1)

test "cancel infallible wait", seeds: 20, '''
  sleep canceled
  waited 5
  -1
'''
  # A wait on a task that cannot fail finishes; the cancel stays for the
  # next waiting point.
  use std.task
  use std.time

  fun quick() -> Int
    5

  fun patient() -> Int!
    q = quick()&
    time.sleep(10 * time.SECOND) catch print("sleep canceled")
    n = >q
    print("waited", n)
    task.check()!
    n

  p = patient()&
  time.sleep(10 * time.MS)!
  print(<p.cancel() catch -1)

test "cancel on drop", seeds: 20, '''
  nap stops
  7
  true
'''
  # A task that can fail is canceled where it is dropped: here, on an
  # early return.
  use std.time

  fun nap() -> Int!
    defer print("nap stops")
    time.sleep(10 * time.SECOND)!
    1

  fun first(early: Bool) -> Int!
    t = nap()&
    return 7 if early
    >t!

  start = time.now()
  print(first(true) catch -1)
  print(start.elapsed() < 5 * time.SECOND)

test "cancel passes to owned", seeds: 20, '''
  quiet woken
  -1
'''
  # A canceled task passes the cancel on to a task it drops, even one
  # that cannot fail.
  use std.time

  sub quiet()
    time.sleep(10 * time.SECOND) catch print("quiet woken")

  fun owner() -> Int!
    q = quiet()&
    time.sleep(10 * time.SECOND)!
    >q
    1

  o = owner()&
  time.sleep(10 * time.MS)!
  print(<o.cancel() catch -1)

test "cancel finished", seeds: 20, "4"
  # A task with no waiting point runs to its end, and `cancel` gives its
  # result.
  fun four() -> Int!
    4

  t = four()&
  <t.cancel() catch -1

test "cancel write loan", seeds: 20, '''
  -1
  0
'''
  # A task lent to write is canceled where it is bound.
  use std.time

  fun fill(xs: !List[Int]) -> Int!
    time.sleep(10 * time.SECOND)!
    !xs.push(1)
    xs.len

  xs: List[Int] = List()
  t = fill(!xs)&
  print(<t.cancel() catch -1)
  print(xs.len)

fail "cancel infallible", "`Task[Int]` cannot fail, so it cannot be canceled: it runs to its end; wait for it, `>t`", errors: 1
  fun sq(x: Int) -> Int
    x * x

  t = sq(3)&
  print(<t.cancel())

fail "cancel sleep unhandled", "fallible call to `time.sleep` must be wrapped with `!` (propagate) or `catch` (handle)", errors: 1
  use std.time

  sub nap()
    time.sleep(time.MS)

test "cancel storm", seeds: 20, "true"
  # Cancels that race with waits ending: a chain of waits canceled as its
  # sleep may end, a set whose deadline may or may not pass first, and a
  # sleeping task dropped on an early return, many times over.
  use std.time

  fun nap(us: Int) -> Int!
    time.sleep(us * time.US)!
    us

  fun inner(us: Int) -> Int!
    t = nap(us)&
    >t!

  fun outer(us: Int) -> Int!
    t = inner(us)&
    x = >t!
    x + 1

  fun early(i: Int) -> Int!
    d = nap(100000)&
    return 1 if i >= 0
    >d!

  fun round(i: Int) -> Int
    got = 0
    o = outer(i % 50)&
    time.sleep((i % 7) * time.US) catch print("never")
    got += <o.cancel() catch 0
    ts = Tasks[Int!]()
    for k in 0..8
      !ts.add(nap((i + k) % 40)&)
    xs = time.within((i % 30) * time.US, |<ts| >ts!) catch List[Int]()
    got += xs.len
    got += early(i) catch 0
    got

  total = 0
  for i in 0..300
    total += round(i)
  print(total > 0)

test "cancel par failure", seeds: 20, '''
  map Bad.odd
  each Bad.odd
  slept
  3
  7
  task ok
'''
  # A failed `par.map` or `par.each` cancels its own tasks, not its
  # caller: the caller's next waits succeed, and so do its owner's.
  use std.par
  use std.time

  error Bad
    odd

  fun slow(n: Int) -> Int!
    return Bad.odd if n == 50
    time.sleep(time.MS)!
    n

  sub bump(x: !Int)!
    x += slow(x)!

  fun three() -> Int!
    time.sleep(time.MS)!
    3

  sub run()!
    xs: List[Int] = List(capacity: 100)
    for i in 0..100
      !xs.push(i)
    _ = par.map(?xs, |x| slow(x)!, limit: 8) catch |e|
      print("map", e)
      List[Int]()
    par.each(!xs, bump, limit: 8) catch |e| print("each", e)
    time.sleep(time.MS)!
    print("slept")
    t = three()&
    print(>t!)
    ch = *Chan[Int](1)
    !ch.send(7)!
    print((!ch).recv()! ?? 0)

  sub checked()
    run() catch |e| print("run", e)

  c = checked()&
  >c
  time.sleep(time.MS)!
  print("task ok")

test "cancel par canceled", seeds: 20, '''
  map Stop.canceled
  still Stop.canceled
  -1
'''
  # A task canceled during a `par.map` stays canceled after it.
  use std.par
  use std.time

  fun nap(n: Int) -> Int!
    time.sleep(10 * time.SECOND)!
    n

  fun run() -> Int!
    xs = [1, 2, 3, 4, 5, 6, 7, 8]
    _ = par.map(?xs, |x| nap(x)!, limit: 4) catch |e|
      print("map", e)
      List[Int]()
    time.sleep(time.MS) catch |e| print("still", e)
    time.sleep(time.MS)!
    0

  t = run()&
  time.sleep(time.MS)!
  print(<t.cancel() catch -1)

test "cancel leaves the caller", seeds: 20, '''
  2
  set Bad.odd
  all Bad.odd
  isolate -1
  within -1
  -1
  ok
'''
  # Whatever cancels the tasks a task owns, by success, failure, panic,
  # deadline, or drop, leaves that task's own waits as they were.
  use std.task
  use std.time

  error Bad
    odd

  fun nap(n: Int) -> Int!
    time.sleep(10 * time.SECOND)!
    n

  fun quick(n: Int) -> Int!
    time.sleep(time.MS)!
    n

  fun bad(n: Int) -> Int!
    time.sleep(time.MS)!
    return Bad.odd

  fun pick(xs: [3]Int, i: Int) -> Int
    xs[i]

  fun boom(n: Int) -> Int!
    time.sleep(time.MS)!
    pick([1, 2, 3], n)

  fun under() -> Int!
    ts = Tasks[Int!]()
    !ts.add(nap(1)&)
    !ts.add(boom(9)&)
    xs = >ts!
    xs.len

  sub both()!
    a, b = task.all(nap(1)&, bad(2)&)!
    print(a + b)

  ts = Tasks[Int!]()
  !ts.add(nap(1)&)
  !ts.add(quick(2)&)
  print(<ts.wait_first()!)
  time.sleep(time.MS)!
  us = Tasks[Int!]()
  !us.add(nap(1)&)
  !us.add(bad(2)&)
  _ = >us catch |e|
    print("set", e)
    List[Int]()
  time.sleep(time.MS)!
  both() catch |e| print("all", e)
  time.sleep(time.MS)!
  print("isolate", task.isolate(|| under()!) catch -1)
  time.sleep(time.MS)!
  print("within", time.within(5 * time.MS, || nap(1)!) catch -1)
  time.sleep(time.MS)!
  vs = Tasks[Int!]()
  !vs.add(nap(1)&)
  <vs
  time.sleep(time.MS)!
  t = nap(1)&
  print(<t.cancel() catch -1)
  time.sleep(time.MS)!
  u = nap(1)&
  <u
  time.sleep(time.MS)!
  print("ok")
