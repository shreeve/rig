test "text chars table", "3238430853"
  # GENERATED by tools/gen-unicode.py; do not edit.
  # Every code point but the surrogates is put in short texts whose char
  # counts tell its char class of Unicode 17.0.0 apart, and a hash of
  # all the counts equals that of the Character Database.

  # Appends `c` to `t` in UTF-8.
  sub push_rune(t: !String, c: Int)
    if c < 0x80
      !t.push(U8(c))
    else if c < 0x800
      !t.push(U8(0xC0 + c / 64))
      !t.push(U8(0x80 + c % 64))
    else if c < 0x10000
      !t.push(U8(0xE0 + c / 4096))
      !t.push(U8(0x80 + c / 64 % 64))
      !t.push(U8(0x80 + c % 64))
    else
      !t.push(U8(0xF0 + c / 262144))
      !t.push(U8(0x80 + c / 4096 % 64))
      !t.push(U8(0x80 + c / 64 % 64))
      !t.push(U8(0x80 + c % 64))

  # The chars of `before`, `c`, and `after`, written in `t`.
  fun count(t: !String, before: ?String, c: Int, after: ?String) -> Int
    !t.clear()
    !t.add(before)
    push_rune(!t, c)
    !t.add(after)
    text.char_count(?t[..])

  t = String()
  h = 0
  for c in 0..0x110000
    continue if c >= 0xD800 and c < 0xE000
    sig = 0
    sig += (count(!t, "\u{61}", c, "") - 1) << 0
    sig += (count(!t, "", c, "\u{61}") - 1) << 2
    sig += (count(!t, "", c, "\u{301}") - 1) << 4
    sig += (count(!t, "\u{d}", c, "") - 1) << 6
    sig += (count(!t, "", c, "\u{a}") - 1) << 8
    sig += (count(!t, "", c, "\u{1161}") - 1) << 10
    sig += (count(!t, "", c, "\u{11a8}") - 1) << 12
    sig += (count(!t, "", c, "\u{1100}") - 1) << 14
    sig += (count(!t, "", c, "\u{1f1e6}") - 1) << 16
    sig += (count(!t, "\u{1f600}\u{200d}", c, "") - 1) << 18
    sig += (count(!t, "\u{915}\u{94d}", c, "") - 1) << 20
    sig += (count(!t, "\u{915}", c, "\u{915}") - 1) << 22
    sig += (count(!t, "\u{915}\u{94d}", c, "\u{915}") - 1) << 24
    sig += (count(!t, "\u{1f600}", c, "\u{200d}\u{1f600}") - 1) << 26
    sig += (count(!t, "\u{ac00}", c, "") - 1) << 28
    h = (h * 31 + sig) % 4294967296
  print(h)

test "unicode widths table", release: true, '''
  6285 922884 182895
  71774873
'''
  # GENERATED by tools/gen-unicode.py; do not edit.
  # Every code point but the surrogates: its width of Unicode 17.0.0,
  # and the width of the char it makes after a letter and before U+FE0F,
  # hashed, and the code points of each width counted, equal those of the
  # Character Database.

  # Appends `c` to `t` in UTF-8.
  sub push_rune(t: !String, c: Int)
    if c < 0x80
      !t.push(U8(c))
    else if c < 0x800
      !t.push(U8(0xC0 + c / 64))
      !t.push(U8(0x80 + c % 64))
    else if c < 0x10000
      !t.push(U8(0xE0 + c / 4096))
      !t.push(U8(0x80 + c / 64 % 64))
      !t.push(U8(0x80 + c % 64))
    else
      !t.push(U8(0xF0 + c / 262144))
      !t.push(U8(0x80 + c / 4096 % 64))
      !t.push(U8(0x80 + c / 64 % 64))
      !t.push(U8(0x80 + c % 64))

  t = String()
  counts = [0, 0, 0]
  h = 0
  for c in 0..0x110000
    continue if c >= 0xD800 and c < 0xE000
    w = unicode.width(c)
    counts[w] += 1
    !t.clear()
    !t.add("a")
    push_rune(!t, c)
    after = text.char_width(?t[..])
    !t.clear()
    push_rune(!t, c)
    !t.add("\u{fe0f}")
    before = text.char_width(?t[..])
    h = (h * 31 + w + 3 * after + 9 * before) % 4294967296
  print(counts[0], counts[1], counts[2])
  print(h)
