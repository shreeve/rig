#!/usr/bin/env bash
# Rig test suite. See test/README.md for the test file formats.
#
# Usage:
#   ./test/run [options] [filter...]
#
#   filter      only run tests whose id contains one of these substrings;
#               ids look like behavior/ownership/move_into_fn, known/emit/...,
#               reject/types/..., examples/hello, ir/..., torture/..., cli/..., unit,
#               parser, classify, vocab, doc/SPEC/L120 (the ```rig block at SPEC.md line 120),
#               oracle/corpus (the reference ownership checker over a set).
#               A bare kind name (`known`, `doc`, ...) selects that kind.
#   -v          also list passing and known-failing tests
#   -j N        parallel jobs (default: CPU count)
#   --update    rewrite test/ir snapshots from the current compiler
#   --prune     only remove the output of tests that are gone, as a run
#               with no filter does first, and exit
#   --shard I/N run only the selected tests whose id hashes to shard I
#               of N (1 <= I <= N); shard 1 also runs the whole-program
#               checks (unit, parser, classify, vocab)
#
# Environment: ZIG (the Zig executable), NEXUS (the Nexus executable),
# RIG_TEST_TIMEOUT (seconds per test, default 120; a test's own
# `# timeout: N` line can raise its limit), RIG_TEST_OUT (where test
# output goes, default .zig-cache/rig-test; one run at a time uses a
# directory), RIG_BUILD_STORE (where programs are built, default
# rig-build-store in the repository's git directory, shared by its
# worktrees; empty builds each in its test's output directory),
# RIG_BUILD_STORE_DAYS (a run with no filter removes the store's builds
# unused for longer, default 7), RIG_SANITIZE (0 builds the programs
# tests run on the plain leak checker instead of the sanitizing
# allocator).
#
# Exit status is 1 if any test fails, or a known-failing test or a
# pending doc example starts passing (move the test out of test/known/,
# or mark the example ```rig, when that happens), 2 on a usage
# error or when the filters select nothing (or only a skipped check),
# unless they only name kinds, which may be empty.

set -uo pipefail

# This script, by absolute path: it runs itself for each test, from the
# checkout root.
SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
cd "$(dirname "$SELF")/.."
ROOT=$(pwd)
RIG="$ROOT/bin/rig"
# Nexus: $NEXUS, else nexus/bin/nexus next to this checkout or any parent
# directory (so git worktrees nested inside the checkout find it too).
find_nexus() {
    local dir=$ROOT
    while [[ "$dir" != "/" ]]; do
        dir=$(dirname "$dir")
        [[ -x "$dir/nexus/bin/nexus" ]] && { echo "$dir/nexus/bin/nexus"; return; }
    done
    echo "$ROOT/../nexus/bin/nexus"
}
NEXUS=${NEXUS:-$(find_nexus)}
PANIC_RE='Segmentation fault|panic:|panic at|reached unreachable|index out of bounds|General protection|GENERAL PROTECTION|Bus error|Illegal instruction'
POS_RE='\.rig:[0-9]+:[0-9]+'
LEAK_RE='rig: memory leak detected'
# Programs run under the sanitizing allocator unless RIG_SANITIZE=0.
SANITIZE=${RIG_SANITIZE:-1}
TIMEOUT=${RIG_TEST_TIMEOUT:-120}
ZIG=${ZIG:-zig}

# -----------------------------------------------------------------------------
# Worker: run one test, write a result file. Invoked through xargs.
#   result line: <status>\t<id>\t<one-line reason>
#   status: pass | fail | known | fixed | pending
# Results go to $RESULTS/st/, details (captured output) to $RESULTS/log/.
# -----------------------------------------------------------------------------

# Expected stdout: the `# expect:` block, one `# line` per output line.
expected_stdout() {
    awk '
        inblock && /^#/ { sub(/^# ?/, ""); sub(/\r$/, ""); print; next }
        inblock { exit }
        /^# expect:[[:space:]]*$/ { inblock = 1 }
    ' "$1"
}

directive() { # directive <name> <file>  → all values of `# name: value`
    sed -n "s/^# $1:[[:space:]]*//p" "$2"
}

has_expect_block() { grep -qE '^# expect:[[:space:]]*$' "$1"; }

# run_program <entry> <outdir> [flag...]: `rig run [flag...]` the program
# under the time limit, its stdout and stderr in <outdir>.stdout and
# .stderr; sets RC.
# rig creates $STARTED (RIG_RUN_STARTED) once the program has started:
# the positive evidence a test needs that it ran. $STARTED is the test's
# own path in this run's private results directory, where no test's
# output can sit, cleared before the run.
run_program() {
    local entry=$1 outdir=$2
    shift 2
    mkdir -p "$outdir"
    rm -f "$STARTED"
    if [[ -e "$STARTED" ]]; then
        printf 'cannot clear %s\n' "$STARTED" >"$outdir.stderr"; : >"$outdir.stdout"; RC=125
        return
    fi
    # The braces keep bash's own "Abort trap" job notice out of the output.
    { RIG_SANITIZE="$SANITIZE" RIG_OUT_DIR="$outdir" RIG_RUN_STARTED="$STARTED" "$TIMEOUT_CMD" "$TIMEOUT" "$RIG" run "$@" "$entry" >"$outdir.stdout" 2>"$outdir.stderr" </dev/null; } 2>/dev/null
    RC=$?
}

# not_run <outdir> <rc>: the program did not start (no regular file at
# $STARTED, or rig says so); sets REASON. A program `rig run` rejects (an
# error at a .rig position) did not run because its check failed, and
# says so.
not_run() {
    [[ -f "$STARTED" ]] && ! grep -q 'rig: the program did not run' "$1.stderr" && return 1
    REASON=$(classify_failure "$1.stderr" "$2")
    grep -qE '\.rig:[0-9]+:[0-9]+: error' "$1.stderr" && [[ $REASON == rejected* ]] ||
        REASON="the program did not run: $REASON"
    return 0
}

# check_behavior <entry> <outdir> <logfile> → sets REASON, returns 0 on pass.
# A test with a `# release` line is also built with `--release` and must
# pass the same way.
check_behavior() {
    local entry=$1 outdir=$2 log=$3
    check_output "$entry" "$outdir" "$log" || return 1
    grep -qE '^# release[[:space:]]*$' "$entry" || return 0
    check_output "$entry" "$outdir/release" "$log.release" --release && return 0
    REASON="--release: $REASON"
    { echo "=== --release"; cat "$log.release"; } >>"$log"
    return 1
}

# check_output <entry> <outdir> <logfile> [flag...]: one `rig run` of a
# behavior test, with its flags; sets REASON, returns 0 on pass.
check_output() {
    local entry=$1 outdir=$2 log=$3
    shift 3
    local out="$outdir.stdout" err="$outdir.stderr"
    run_program "$entry" "$outdir" "$@"
    local rc=$RC
    local panic_want
    panic_want=$(directive expect-panic "$entry" | head -1)

    { echo "--- stdout"; cat "$out"; echo "--- stderr"; cat "$err"; } >"$log"

    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    not_run "$outdir" "$rc" && return 1

    if [[ -n "$panic_want" ]]; then
        if [[ $rc -eq 0 ]]; then REASON="expected panic \"$panic_want\", exited 0"; return 1; fi
        if ! grep -qF -- "$panic_want" "$err"; then
            REASON=$(classify_failure "$err" "$rc")
            REASON="expected panic \"$panic_want\"; got: $REASON"
            return 1
        fi
    elif [[ $rc -ne 0 ]]; then
        REASON=$(classify_failure "$err" "$rc")
        return 1
    fi

    if [[ -z "$panic_want" ]] || has_expect_block "$entry"; then
        if ! diff <(expected_stdout "$entry") "$out" >"$outdir.diff" 2>&1; then
            REASON="stdout differs from # expect block"
            { echo "--- diff (expected vs actual)"; cat "$outdir.diff"; } >>"$log"
            return 1
        fi
    fi
    return 0
}

classify_failure() { # <stderr file> <rc>
    local err=$1 rc=$2 line
    if grep -qE "$LEAK_RE" "$err"; then echo "memory leak"; return; fi
    if line=$(grep -m1 -E '\.rig:[0-9]+:[0-9]+: error' "$err"); then echo "rejected: ${line#*: error: }"; return; fi
    if grep -qE 'parse error|unexpected' "$err" && ! grep -q '\.zig:' "$err"; then echo "rejected: $(head -1 "$err")"; return; fi
    if line=$(grep -m1 -E '\.zig:[0-9]+:[0-9]+: error' "$err"); then echo "zig compile error: ${line#*: error: }"; return; fi
    if grep -qE 'Double free|Invalid free|rig: double free' "$err"; then echo "double free"; return; fi
    if line=$(grep -m1 -E 'rig: (use of freed memory|access past the end)' "$err"); then echo "${line#error: rig: }"; return; fi
    if grep -qE 'Segmentation fault|General protection|GENERAL PROTECTION|Bus error' "$err"; then echo "crash (segfault)"; return; fi
    if line=$(grep -m1 -E 'panic' "$err"); then echo "panic: ${line#*panic: }"; return; fi
    echo "exit $rc: $(head -1 "$err")"
}

# check_reject <entry> <logfile> → sets REASON
check_reject() {
    local entry=$1 log=$2
    local out
    out=$("$TIMEOUT_CMD" "$TIMEOUT" "$RIG" check "$entry" 2>&1 </dev/null)
    local rc=$?
    echo "$out" >"$log"
    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    if [[ $rc -gt 128 ]] || grep -qE "$PANIC_RE" <<<"$out"; then REASON="compiler crashed"; return 1; fi
    if [[ $rc -eq 0 ]]; then REASON="accepted (expected rejection)"; return 1; fi
    # Match `# error:` text against the diagnostic lines' messages only:
    # not the file paths, and not the source excerpts under them. Each
    # line of `msgs` is `L:C: message`; `# error: L:C: text` pins the
    # position too.
    local want msgs pin count
    msgs=$(sed -nE 's/^.*\.rig:([0-9]+:[0-9]+): (error|  note): /\1: /p' <<<"$out")
    while IFS= read -r want; do
        [[ -z "$want" ]] && continue
        pin=""
        if [[ $want =~ ^([0-9]+:[0-9]+):\ (.*)$ ]]; then pin=${BASH_REMATCH[1]} want=${BASH_REMATCH[2]}; fi
        if ! grep -F -- "$want" <<<"$msgs" | grep -qE "^${pin:-[0-9]+:[0-9]+}: "; then
            REASON="no diagnostic${pin:+ at $pin} contains \"$want\"; got: $(head -1 <<<"$out")"
            return 1
        fi
    done < <(directive error "$entry")
    # `# errors: N` pins the number of errors, so a cascade fails the test.
    want=$(directive errors "$entry" | head -1)
    if [[ -n "$want" ]]; then
        [[ $want =~ ^[0-9]+$ ]] || { REASON="\`# errors:\` takes a number, not \"$want\""; return 1; }
        count=$(grep -cE '(^|\.rig:[0-9]+:[0-9]+: )error: ' <<<"$out")
        if [[ $count -ne $want ]]; then
            REASON="expected $want error(s), got $count: $(head -1 <<<"$out")"
            return 1
        fi
    fi
    if ! grep -qE "$POS_RE" <<<"$out"; then
        REASON="diagnostic has no file:line:col: $(head -1 <<<"$out")"
        return 1
    fi
    return 0
}

check_torture() {
    local entry=$1 outdir=$2 log=$3
    mkdir -p "$outdir"
    local out
    out=$(RIG_OUT_DIR="$outdir" "$TIMEOUT_CMD" "$TIMEOUT" "$RIG" run "$entry" 2>&1 </dev/null)
    local rc=$?
    echo "$out" >"$log"
    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    if [[ $rc -gt 128 ]] || grep -qE "$PANIC_RE" <<<"$out"; then REASON="compiler panic on bad input"; return 1; fi
    if [[ $rc -eq 0 ]]; then REASON="bad input was accepted and ran"; return 1; fi
    if ! grep -qE "$POS_RE" <<<"$out"; then REASON="rejected without a file:line:col diagnostic: $(head -1 <<<"$out")"; return 1; fi
    return 0
}

# check_accept <entry> <logfile>: `rig check` accepts the program.
check_accept() {
    local out
    out=$("$TIMEOUT_CMD" "$TIMEOUT" "$RIG" check "$1" 2>&1 </dev/null)
    local rc=$?
    echo "$out" >"$2"
    if [[ $rc -eq 0 ]]; then return 0; fi
    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    if [[ $rc -gt 128 ]] || grep -qE "$PANIC_RE" <<<"$out"; then REASON="compiler crashed"; return 1; fi
    REASON="rejected: $(head -1 <<<"$out")"
    return 1
}

# check_parse <entry> <logfile>: the file parses.
check_parse() {
    local out
    out=$("$TIMEOUT_CMD" "$TIMEOUT" "$RIG" parse "$1" 2>&1 >/dev/null </dev/null)
    local rc=$?
    echo "$out" >"$2"
    if [[ $rc -eq 0 ]]; then return 0; fi
    REASON="does not parse: $(head -1 <<<"$out")"
    return 1
}

# check_facts <entry> <expected> <logfile>: `rig check --facts` prints
# exactly the expected facts.
check_facts() {
    local out
    out=$("$TIMEOUT_CMD" "$TIMEOUT" "$RIG" check --facts "$1" 2>&1 </dev/null)
    local rc=$?
    echo "$out" >"$3"
    if [[ $rc -ne 0 ]]; then REASON="rejected: $(head -1 <<<"$out")"; return 1; fi
    if ! diff "$2" <(printf '%s\n' "$out") >>"$3" 2>&1; then REASON='facts differ from the facts block'; return 1; fi
    return 0
}

# A doc example: a directory extracted from a ```rig block, with its
# mode in `mode` (see extract_docs). A pending example's mode is
# `pending <mode>`: it states a rule that is decided but not built, so
# the check of its mode must fail today, for a reason that means the rule
# is missing (see pending_holds). check_doc then sets PENDING to `held`,
# or to `works` once the example passes.
check_doc() {
    local dir=$1 entry=$2 outdir=$3 log=$4 mode ok
    mode=$(cat "$dir/mode")
    PENDING=""
    if [[ $mode == "pending "* ]]; then mode=${mode#pending }; PENDING=held; fi
    case $mode in
        run)      check_behavior "$entry" "$outdir" "$log" ;;
        check)    check_accept "$entry" "$log" ;;
        reject)   check_reject "$entry" "$log" ;;
        fragment) check_parse "$entry" "$log" ;;
        facts)    check_facts "$entry" "$dir/facts" "$log" ;;
        *)        REASON=$mode; return 1 ;;
    esac
    ok=$?
    if [[ -n "$PENDING" ]]; then
        if [[ $ok -eq 0 ]]; then PENDING=works
        elif pending_holds "$REASON"; then ok=0
        else REASON="pending example: $REASON"
        fi
    fi
    # Report positions relative to the example, not the scratch directory.
    REASON=${REASON//"$dir/"/}
    if [[ -f "$log" ]]; then
        local text
        text=$(<"$log")
        printf '%s\n' "${text//"$dir/"/}" >"$log"
    fi
    return $ok
}

# pending_holds <reason>: a pending example's failure means only that its
# rule is not built yet: the program is rejected, accepted where it should
# be rejected, rejected for another reason, or prints something else. A
# timeout, a compiler crash, or an accepted program that fails to compile
# or run clean is a bug, and fails the test as in any other example.
pending_holds() {
    case $1 in
        "rejected"*|"stdout differs"*|"accepted (expected rejection)"|"no diagnostic"*|"expected "*" error(s), got"*) return 0 ;;
    esac
    return 1
}

# A corpus program's run fails on what memory-safe, correctly emitted
# code never does: a leak, a use of freed memory, a Zig compile error, a
# crash, or a Zig safety check that means emitted code went wrong. Rig's
# own panics (bounds, overflow, a failed conversion) and exit statuses
# are fine: a probe need not succeed, only stay sound.
CORPUS_BAD_RE='rig: memory leak detected|rig: use of freed memory|rig: access past the end|rig: double free|\.zig:[0-9]+:[0-9]+: error|\.rig:[0-9]+:[0-9]+: error|Segmentation fault|Bus error|General protection|GENERAL PROTECTION|Illegal instruction|reached unreachable|access of union field|invalid enum value|incorrect alignment|attempt to use null value|switch on corrupt value|invalid error code|sentinel mismatch'

# check_corpus <entry> <outdir> <logfile>: `rig check` rejects the
# program with a file:line:col diagnostic, or it runs, and runs clean under
# the sanitizer. A passing run's output is removed and its Zig cache kept,
# so a later run rebuilds only the programs whose emitted Zig changed.
check_corpus() {
    local entry=$1 outdir=$2 log=$3
    local out rc line
    out=$("$TIMEOUT_CMD" "$TIMEOUT" "$RIG" check "$entry" 2>&1 </dev/null)
    rc=$?
    echo "$out" >"$log"
    if [[ $rc -eq 124 ]]; then REASON="rig check timed out after ${TIMEOUT}s"; return 1; fi
    if [[ $rc -gt 128 ]] || grep -qE "$PANIC_RE" <<<"$out"; then REASON="compiler crashed"; return 1; fi
    if [[ $rc -ne 0 ]]; then
        grep -qE "$POS_RE" <<<"$out" && return 0
        REASON="rejected without a file:line:col diagnostic: $(head -1 <<<"$out")"
        return 1
    fi
    run_program "$entry" "$outdir"
    rc=$RC
    { echo "--- stdout"; head -40 "$outdir.stdout"; echo "--- stderr"; cat "$outdir.stderr"; } >"$log"
    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    not_run "$outdir" "$rc" && return 1
    if line=$(grep -m1 -E "$CORPUS_BAD_RE" "$outdir.stderr"); then
        REASON=$(classify_failure "$outdir.stderr" "$rc")
        [[ $REASON == exit* || $REASON == panic* ]] && REASON=$line
        return 1
    fi
    # rig says when a signal ended the program (its status alone cannot:
    # a program may exit 137 itself). A Rig panic aborts (signal 6) after
    # its `panic:` report; any other signal came from outside, or is a
    # crash nothing reported.
    if line=$(grep -m1 -E 'rig: the program was killed by signal [0-9]+' "$outdir.stderr") &&
        ! { [[ $line == *"signal 6" ]] && grep -q 'panic: ' "$outdir.stderr"; }; then
        REASON="killed by signal ${line##* }: $(head -1 "$outdir.stderr")"; return 1
    fi
    find "$outdir" -mindepth 1 -maxdepth 1 ! -name .zig-cache -exec rm -rf {} +
    rm -f "$outdir.stdout" "$outdir.stderr"
    return 0
}

# check_cli <script> <outdir> <logfile>: the script exits 0. It runs in an
# empty directory with RIG, ROOT, and RIG_OUT_DIR set (test/cli/_lib.sh).
check_cli() {
    local script=$1 outdir=$2 log=$3
    mkdir -p "$outdir/work"
    (cd "$outdir/work" && RIG_OUT_DIR="$outdir" "$TIMEOUT_CMD" "$TIMEOUT" bash "$ROOT/$script") >"$log" 2>&1 </dev/null
    local rc=$?
    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    if [[ $rc -ne 0 ]]; then REASON=$(grep -m1 '^FAIL' "$log" || echo "exit $rc: $(tail -1 "$log")"); return 1; fi
    return 0
}

check_ir() {
    local entry=$1 log=$2
    local base=${entry%.rig} ok=0 kind cmd
    for kind in raw sem; do
        [[ $kind == raw ]] && cmd=parse || cmd=normalize
        local snap="$base.$kind.sexp" got rc
        got=$("$TIMEOUT_CMD" "$TIMEOUT" "$RIG" $cmd "$entry" 2>&1 </dev/null)
        rc=$?
        if [[ $rc -ne 0 ]]; then
            REASON="rig $cmd failed (exit $rc): $(head -1 <<<"$got")"; ok=1
        elif [[ -n "$UPDATE" ]]; then
            printf '%s\n' "$got" >"$snap"
        elif [[ ! -f "$snap" ]]; then
            REASON="missing snapshot $(basename "$snap") (run with --update)"; ok=1
        elif ! diff "$snap" <(printf '%s\n' "$got") >>"$log" 2>&1; then
            REASON="$kind IR differs from $(basename "$snap") (review, then --update)"; ok=1
        fi
    done
    return $ok
}

# The reference ownership checker (test/oracle/) over one set of
# programs: every function it decides must get production's verdict,
# or be listed in test/oracle/differences, and the set must keep its
# floor of decided functions (test/oracle/coverage).
ORACLE_FORBIDDEN='ownership\.zig|typecheck\.zig|storage\.zig|\b(storageOf|recordStorage|Storage|StorageKind|StorageBy|StorageLife|copiesHeader|header_copies|dropsTemp|temp_drops|readsInPlace|in_place_reads|takesSubject|taken_subjects|readsThrough|readsAsView|unboxes|unboxed|arrayViewOf|array_views|lendsText|text_lends|takes|recordTake|moveSource|MoveSource|moveLeaves|MoveLeaf|writesThrough|through_writes|lendsCellTemp|cell_temps|handsOver)\b|facts\.(reads|views)'
check_oracle() { # <set> <outdir> <logfile>
    local set=$1 outdir=$2 log=$3 list p
    if [[ $set == lint ]]; then
        # The oracle reads no ownership classification of the compiler's
        # (comments aside), and the compiler never imports the oracle.
        local hits
        hits=$(sed 's#//.*##' test/oracle/*.zig | grep -nE "$ORACLE_FORBIDDEN")
        if [[ -n "$hits" ]]; then echo "$hits" >"$log"; REASON="test/oracle/ uses a forbidden compiler fact: $(head -1 <<<"$hits")"; return 1; fi
        hits=$(grep -lE '@import\("(lib\.zig|\.\./test/[^"]*)"\)' src/*.zig | grep -v '^src/lib\.zig$')
        if [[ -n "$hits" ]]; then REASON="src/ imports the oracle's library or test code: $hits"; return 1; fi
        return 0
    fi
    mkdir -p "$outdir"
    list="$outdir.list"
    : >"$list"
    case $set in
        matrix)
            python3 test/matrix.py --oracle >"$log" 2>&1 || { REASON=$(grep -m1 -E '^(DIFF|FIXED|FAIL)' "$log" || tail -1 "$log"); return 1; }
            return 0 ;;
        tests)
            for p in test/behavior/*/* test/reject/*/* test/known/*/* examples/*.rig; do
                if [[ -f "$p/main.rig" ]]; then printf '%s\t%s\n' "$p" "$p/main.rig"
                elif [[ $p == *.rig ]]; then printf '%s\t%s\n' "$p" "$p"; fi
            done >"$list" ;;
        corpus)
            for p in test/corpus/*; do
                if [[ -f "$p/main.rig" ]]; then printf '%s\t%s\n' "$p" "$p/main.rig"
                elif [[ $p == *.rig ]]; then printf '%s\t%s\n' "$p" "$p"; fi
            done >"$list" ;;
        docs)
            # The doc examples this run extracted (test/README.md).
            local docs=${RESULTS%/results}/doc
            for p in "$docs"/*/L*; do
                [[ -f "$p/main.rig" ]] || continue
                [[ $(cat "$p/mode") == fragment || $(cat "$p/mode") == doc\ convention* ]] && continue
                printf 'doc/%s\t%s\n' "${p#"$docs"/}" "$p/main.rig"
            done >"$list" ;;
        *) REASON="no oracle set \`$set\`"; return 1 ;;
    esac
    "$TIMEOUT_CMD" "$TIMEOUT" "$ROOT/bin/rig-oracle" --set "$set" --allow test/oracle/differences \
        --coverage test/oracle/coverage --list "$list" >"$log" 2>&1
    local rc=$?
    if [[ $rc -eq 124 ]]; then REASON="timed out after ${TIMEOUT}s"; return 1; fi
    if [[ $rc -ne 0 ]]; then REASON=$(grep -m1 -E '^(DIFF|FIXED|FAIL)' "$log" || tail -1 "$log"); return 1; fi
    return 0
}

worker() { # worker <id> <path> <output directory, relative to $OUTROOT>
    local id=$1 path=$2
    STARTED="$RESULTS/started/${id//\//__}"
    local res="$RESULTS/st/${id//\//__}"
    local log="$RESULTS/log/${id//\//__}" outdir="$OUTROOT/$3"
    local entry=$path
    [[ -d "$path" ]] && entry="$path/main.rig"
    REASON=""
    local kind=${id%%/*} ok
    # A test that builds and runs programs may raise its own time limit
    # with a `# timeout: <seconds>` line.
    local TIMEOUT=$TIMEOUT limit
    case $kind in
        behavior|examples|known|cli)
            limit=$(sed -n 's/^# timeout:[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$entry" | head -1)
            [[ -n "$limit" && $limit -gt $TIMEOUT ]] && TIMEOUT=$limit ;;
    esac
    # Start from an empty output directory, except for the Zig build caches
    # rig keeps there (a CLI test keeps one per program under programs/),
    # so repeated runs stay fast.
    if [[ -d "$outdir" ]]; then
        find "$outdir" -mindepth 1 -maxdepth 1 ! -name .zig-cache ! -name programs -exec rm -rf {} +
        [[ -d "$outdir/programs" ]] && find "$outdir/programs" -mindepth 2 -maxdepth 2 ! -name .zig-cache -exec rm -rf {} +
    fi

    case $kind in
        behavior|examples) check_behavior "$entry" "$outdir" "$log"; ok=$? ;;
        reject)            check_reject "$entry" "$log"; ok=$? ;;
        torture)           check_torture "$entry" "$outdir" "$log"; ok=$? ;;
        ir)                check_ir "$entry" "$log"; ok=$? ;;
        cli)               check_cli "$path" "$outdir" "$log"; ok=$? ;;
        doc)
            check_doc "$path" "$entry" "$outdir" "$log"; ok=$?
            case $PENDING in
                held)  [[ $ok -eq 0 ]] && { printf 'pending\t%s\t%s\n' "$id" "$REASON" >"$res"; return; } ;;
                works) printf 'fixed\t%s\tthe pending example now works; change ```rig pending to ```rig\n' "$id" >"$res"; return ;;
            esac
            ;;
        corpus)            check_corpus "$entry" "$outdir" "$log"; ok=$? ;;
        oracle)            check_oracle "${id#oracle/}" "$outdir" "$log"; ok=$? ;;
        known)
            if grep -qE '^# error:' "$entry"; then check_reject "$entry" "$log"
            else check_behavior "$entry" "$outdir" "$log"; fi
            ok=$?
            if [[ $ok -eq 0 ]]; then
                printf 'fixed\t%s\tnow passes; move it to test/%s/\n' "$id" \
                    "$(grep -qE '^# error:' "$entry" && echo reject || echo behavior)/${id#known/}" >"$res"
            elif [[ $REASON == "the program did not run"* ]]; then
                # Not the known bug: nothing was checked.
                printf 'fail\t%s\t%s\n' "$id" "$REASON" >"$res"
            else
                printf 'known\t%s\t%s\n' "$id" "$REASON" >"$res"
            fi
            return
            ;;
    esac
    if [[ $ok -eq 0 ]]; then printf 'pass\t%s\t\n' "$id" >"$res"
    else printf 'fail\t%s\t%s\n' "$id" "$REASON" >"$res"; fi
}

if [[ "${1:-}" == "--worker" ]]; then
    worker "$2" "$3" "$4"
    # Whole seconds since this worker started, to schedule the next run.
    printf '%s\t%s\n' "$2" "$SECONDS" >>"$RESULTS/durations"
    exit 0
fi

# -----------------------------------------------------------------------------
# Driver
# -----------------------------------------------------------------------------

UPDATE="" VERBOSE="" PRUNE="" SHARD="" JOBS=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
FILTERS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --update) UPDATE=1 ;;
        --prune) PRUNE=1 ;;
        --shard)
            [[ $# -ge 2 && $2 =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] &&
                (( BASH_REMATCH[1] <= BASH_REMATCH[2] )) || { echo "--shard needs I/N, with 1 <= I <= N" >&2; exit 2; }
            SHARD=$2; shift ;;
        -v) VERBOSE=1 ;;
        -j) [[ $# -ge 2 && $2 =~ ^[1-9][0-9]*$ ]] || { echo "-j needs a number of jobs" >&2; exit 2; }
            JOBS=$2; shift ;;
        -h|--help) sed -n '2,/^$/p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "unknown option $1" >&2; exit 2 ;;
        *) FILTERS+=("$1") ;;
    esac
    shift
done
[[ -n "$PRUNE" && ${#FILTERS[@]} -gt 0 ]] && { echo "--prune takes no filter" >&2; exit 2; }

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    G=$'\033[32m' R=$'\033[31m' Y=$'\033[33m' D=$'\033[2m' B=$'\033[1m' X=$'\033[0m'
else
    G='' R='' Y='' D='' B='' X=''
fi

START=$SECONDS

# One run at a time per output directory: every test empties its own
# directory there, so concurrent runs would delete each other's builds.
# A lock whose owner has died is taken over.
OUTROOT=${RIG_TEST_OUT:-$ROOT/.zig-cache/rig-test}
LOCK="$OUTROOT.lock" WORK=""
mkdir -p "$(dirname "$OUTROOT")"
until mkdir "$LOCK" 2>/dev/null; do
    holder=$(cat "$LOCK/pid" 2>/dev/null)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$LOCK"; continue; fi
    [[ -n "${WAITED:-}" ]] || printf 'waiting for the test run in %s (pid %s); set RIG_TEST_OUT to run beside it\n' "$OUTROOT" "${holder:-?}" >&2
    WAITED=1
    sleep 1
done
echo $$ >"$LOCK/pid"
trap 'rm -rf "$LOCK" ${WORK:+"$WORK"}' EXIT
trap 'exit 130' INT TERM

# The run deletes old output in its directory, so it works only in one
# it has marked as its own: the default, or a RIG_TEST_OUT that is new
# or empty when first used.
if [[ ! -e "$OUTROOT/.rig-test" ]]; then
    if [[ -n "${RIG_TEST_OUT:-}" && -d "$OUTROOT" && -n "$(ls -A "$OUTROOT")" ]]; then
        printf 'RIG_TEST_OUT=%s holds files this runner did not write, and a run deletes old output there; name a new or empty directory\n' "$OUTROOT" >&2
        exit 2
    fi
    mkdir -p "$OUTROOT" && : >"$OUTROOT/.rig-test"
fi

# Programs build in the content-addressed store (see RIG_BUILD_STORE in
# `rig --help`), shared by every worktree of this repository, so a
# program built before, here or in another worktree, is not built again.
if [[ -z "${RIG_BUILD_STORE+set}" ]]; then
    RIG_BUILD_STORE=""
    if [[ -e .git ]] && common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
        RIG_BUILD_STORE=$common/rig-build-store
    fi
fi
STORE_DAYS=${RIG_BUILD_STORE_DAYS:-7}
[[ $STORE_DAYS =~ ^[0-9]+$ ]] || { echo "RIG_BUILD_STORE_DAYS takes a number of days" >&2; exit 2; }
export RIG_BUILD_STORE

printf '%sbuilding rig%s\n' "$D" "$X"
if ! "$ZIG" build 2>&1; then
    printf '%sbuild failed%s\n' "$R" "$X"
    exit 1
fi

WORK=$(mktemp -d "${TMPDIR:-/tmp}/rig-test.XXXXXX")
RESULTS="$WORK/results"
mkdir -p "$RESULTS/st" "$RESULTS/log" "$RESULTS/started" "$OUTROOT"

# Each test runs under `$TIMEOUT_CMD <seconds> <command...>`, which exits
# 124 when the time runs out: GNU timeout, or where there is none (stock
# macOS) this perl stand-in, which likewise runs the command in a
# process group of its own and stops the whole group.
if ! TIMEOUT_CMD=$(command -v timeout || command -v gtimeout); then
    command -v perl >/dev/null || { echo "test/run needs GNU timeout or perl" >&2; exit 2; }
    TIMEOUT_CMD="$WORK/timeout"
    cat >"$TIMEOUT_CMD" <<'PERL'
#!/usr/bin/env perl
use strict;
use warnings;
use POSIX ();
my $secs = shift;
my $pid = fork() // die "timeout: fork: $!\n";
if ($pid == 0) {
    setpgrp(0, 0);
    exec { $ARGV[0] } @ARGV or print STDERR "timeout: $ARGV[0]: $!\n";
    POSIX::_exit(127);
}
setpgrp($pid, $pid);
my $expired = 0;
$SIG{ALRM} = sub { kill($expired++ ? 'KILL' : 'TERM', -$pid); alarm 5 };
$SIG{$_} = sub { kill('TERM', -$pid) } for qw(INT TERM HUP);
alarm $secs;
my $r;
do { $r = waitpid($pid, 0) } while $r == -1 && $!{EINTR};
my $status = $?;
exit 124 if $expired;
exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
PERL
    chmod +x "$TIMEOUT_CMD"
fi
export ROOT RIG ZIG RESULTS OUTROOT UPDATE TIMEOUT TIMEOUT_CMD PANIC_RE POS_RE LEAK_RE SANITIZE CORPUS_BAD_RE

is_kind() {
    case $1 in behavior|reject|known|examples|ir|torture|cli|unit|parser|classify|vocab|doc|corpus|oracle) return 0 ;; esac
    return 1
}

# selected <whole-program check>: the filters select it, and this run is
# not a shard other than the first.
selected() {
    [[ -z "$SHARD" || ${SHARD%/*} -eq 1 ]] || return 1
    [[ ${#FILTERS[@]} -eq 0 ]] && return 0
    local f
    for f in "${FILTERS[@]}"; do
        if is_kind "$f"; then # a bare kind name selects that kind only
            [[ "$1" == "$f" || "$1" == "$f/"* ]] && return 0
        else
            [[ "$1" == *"$f"* ]] && return 0
        fi
    done
    return 1
}

# Discover tests: test/<kind>/<area>/<name>.rig or <name>/main.rig,
# plus examples/, test/ir/, test/torture/, test/cli/, the oracle's sets,
# and the corpus, in one pass over the tree. Each line of DISCOVERED is
# "<id>\t<path>\t<output directory>", in the order of the kinds above and
# of the paths (as their globs would list them) within each kind; the doc
# examples follow (below). `select_tests` applies the filters.
LIST="$WORK/list" DISCOVERED="$WORK/discovered"
# find follows symbolic links, as the globs of the oracle's sets do; a
# directory it cannot read, or a link that loops, stops the run.
ROOTS=()
for d in test/behavior test/reject test/known examples test/ir test/torture test/cli test/corpus; do
    [[ -e $d ]] && ROOTS+=("$d")
done
: >"$WORK/found"
if [[ ${#ROOTS[@]} -gt 0 ]] && ! find -L "${ROOTS[@]}" -maxdepth 3 \( -name '*.rig' -o -name '*.sh' \) >"$WORK/found"; then
    echo "test discovery failed: find reported the errors above" >&2
    exit 2
fi
awk -F/ -v OFS='\t' '
    function emit(rank, p, id) { print rank, p, id, p, id }
    # A path component a glob would not list.
    { for (i = 1; i <= NF; i++) if ($i ~ /^\./) next }
    $1 == "test" && ($2 == "behavior" || $2 == "reject" || $2 == "known") {
        rank = ($2 == "behavior" ? 1 : $2 == "reject" ? 2 : 3)
        if (NF == 4 && $4 ~ /\.rig$/) emit(rank, $0, $2 "/" $3 "/" substr($4, 1, length($4) - 4))
        else if (NF == 5 && $5 == "main.rig") emit(rank, $1 "/" $2 "/" $3 "/" $4, $2 "/" $3 "/" $4)
        next
    }
    $1 == "examples" && NF == 2 && $2 ~ /\.rig$/ { emit(4, $0, "examples/" substr($2, 1, length($2) - 4)); next }
    $1 == "test" && ($2 == "ir" || $2 == "torture") && NF == 3 && $3 ~ /\.rig$/ {
        emit($2 == "ir" ? 5 : 6, $0, $2 "/" substr($3, 1, length($3) - 4)); next
    }
    $1 == "test" && $2 == "cli" && NF == 3 && $3 ~ /^[^_].*\.sh$/ { emit(7, $0, "cli/" substr($3, 1, length($3) - 3)); next }
    $1 == "test" && $2 == "corpus" {
        if (NF == 3 && $3 ~ /\.rig$/) emit(9, $0, "corpus/" substr($3, 1, length($3) - 4))
        else if (NF == 4 && $4 == "main.rig") emit(9, $1 "/" $2 "/" $3, "corpus/" $3)
        next
    }
    END { n = split("lint tests corpus docs matrix", sets, " "); for (i = 1; i <= n; i++) print 8, i, "oracle/" sets[i], "test/oracle", "oracle/" sets[i] }
' "$WORK/found" | LC_ALL=C sort -t$'\t' -k1,1n -k2,2 | cut -f3- >"$DISCOVERED"
# The ids the filters select: a run with filters takes every corpus
# program they select (`./test/run corpus` takes them all); a run
# without takes one in CORPUS_SAMPLE, picked by a hash of its name (see
# test/README.md). Every corpus program's name goes to corpus.all.
CORPUS_SAMPLE=16
select_tests() { # select_tests <file> → the selected lines of it
    local filters=""
    [[ ${#FILTERS[@]} -gt 0 ]] && printf -v filters '%s\n' "${FILTERS[@]}"
    FILTER_LIST=$filters awk -F'\t' -v nf=${#FILTERS[@]} -v n=$CORPUS_SAMPLE -v all_corpus="$WORK/corpus.all" '
        BEGIN {
            for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
            split(ENVIRON["FILTER_LIST"], filter, "\n")
            split("behavior reject known examples ir torture cli unit parser classify vocab doc corpus oracle", ks, " ")
            for (k in ks) kinds[ks[k]] = 1
        }
        function selected(id,    i, f) {
            if (nf == 0) return 1
            for (i = 1; i <= nf; i++) {
                f = filter[i]
                if (f == "") return 1
                if (f in kinds) { if (id == f || substr(id, 1, length(f) + 1) == f "/") return 1 }
                else if (index(id, f)) return 1
            }
            return 0
        }
        $1 ~ /^corpus\// {
            name = substr($1, 8)
            print name >all_corpus
            if (nf == 0) {
                h = 0
                for (i = 1; i <= length(name); i++) h = (h * 31 + ord[substr(name, i, 1)]) % 1000003
                if (h % n) next
            }
        }
        selected($1)
    ' "$1"
}
: >"$WORK/corpus.all"
select_tests "$DISCOVERED" >"$LIST"

# Doc examples: every ```rig block in the Markdown docs is a test. The
# info string after `rig` sets the contract (see test/README.md):
#
#   ```rig             a program `rig check` accepts; followed by an
#                      ```output block, it is run like a behavior test
#   ```rig reject      `rig check` rejects it; a following ```error block
#                      lists text each diagnostic must contain, one a line
#   ```rig fragment    only parsed
#   ```rig facts       `rig check --facts` prints exactly the following
#                      ```facts block
#   ```rig pending     a rule decided but not built: like ```rig (with an
#                      ```output block or not), or like ```rig reject when
#                      an ```error block follows, but it must fail today;
#                      once it passes, the suite fails
#   ```rig file=m.rig  module `m.rig`, imported by the next example
#
# Each example becomes a directory holding main.rig (the directives
# appended) and its `mode`; the id names the line of the opening fence.
extract_docs() { # extract_docs <file.md> <outdir> → "id<TAB>dir" lines
    local name=${1%.md}
    name=${name#docs/}
    name=${name//\//-}
    awk -v doc="$name" -v out="$2/$name" '
        function fail(msg) { if (mode !~ /^doc convention/) mode = "doc convention: " msg }
        function emit(    dir, f, k, n, ls) {
            dir = out "/L" start
            system("mkdir -p \"" dir "\"")
            printf "%s", body > (dir "/main.rig")
            if (mode == "run" || mode == "reject") {
                n = split(extra, ls, "\n")
                printf "\n%s\n", (mode == "run" ? "# expect:" : "") > (dir "/main.rig")
                for (k = 1; k < n; k++) {
                    if (mode == "run") printf "%s\n", (ls[k] == "" ? "#" : "# " ls[k]) > (dir "/main.rig")
                    else printf "# error: %s\n", ls[k] > (dir "/main.rig")
                }
            }
            close(dir "/main.rig")
            for (f in pending) { printf "%s", pending[f] > (dir "/" f); close(dir "/" f); delete pending[f] }
            if (mode == "facts") { printf "%s", extra > (dir "/facts"); close(dir "/facts") }
            print (pend && mode !~ /^doc convention/ ? "pending " : "") mode > (dir "/mode"); close(dir "/mode")
            printf "doc/%s/L%d\t%s\n", doc, start, dir
        }
        { line[NR] = $0 }
        END {
            i = 1
            while (i <= NR) {
                if (line[i] !~ /^```rig([ \t]|$)/) { i++; continue }
                start = i; mode = "check"; fname = ""; pend = 0
                n = split(substr(line[i], 7), words, /[ \t]+/)
                for (k = 1; k <= n; k++) {
                    w = words[k]
                    if (w == "") continue
                    if (w == "reject" || w == "fragment" || w == "facts") mode = w
                    else if (w == "pending") pend = 1
                    else if (w ~ /^file=[A-Za-z_][A-Za-z0-9_]*\.rig$/) fname = substr(w, 6)
                    else fail("unknown word `" w "` after ```rig")
                }
                body = ""
                for (i++; i <= NR && line[i] != "```"; i++) body = body line[i] "\n"
                if (i > NR) fail("unterminated ```rig block")
                i++
                j = i
                while (j <= NR && line[j] ~ /^[ \t]*$/) j++
                kind = ""; extra = ""
                if (j <= NR && (line[j] == "```output" || line[j] == "```error" || line[j] == "```facts")) {
                    kind = substr(line[j], 4)
                    for (j++; j <= NR && line[j] != "```"; j++) extra = extra line[j] "\n"
                    i = j + 1
                }
                if (pend) {
                    if (mode != "check" || fname != "") fail("```rig pending takes no other word")
                    else if (kind == "error") mode = "reject"
                }
                if (fname != "") {
                    if (kind != "" || mode != "check") fail("a file= block stands alone")
                    else { pending[fname] = body; pending_at[fname] = start; continue }
                }
                if (kind == "output") { if (mode == "check") mode = "run"; else fail("```output follows a program") }
                else if (kind == "error") { if (mode != "reject") fail("```error follows a ```rig reject block") }
                else if (kind == "facts") { if (mode != "facts") fail("```facts follows a ```rig facts block") }
                else if (mode == "reject") fail("```rig reject needs an ```error block")
                else if (mode == "facts") fail("```rig facts needs a ```facts block")
                emit()
            }
            for (f in pending) { start = pending_at[f]; body = ""; fail("file=" f " is not followed by a program"); emit(); break }
        }
    ' "$1"
}
for md in *.md docs/*.md examples/*.md test/*.md; do
    [[ -e "$md" ]] || continue
    extract_docs "$md" "$WORK/doc"
done >"$WORK/docs"
# A doc example's output directory is named by a checksum of its text,
# not by its line, so an edit that moves it keeps its build cache.
# Identical examples in one file get a suffix each.
if [[ -s "$WORK/docs" ]]; then
    cut -f2 "$WORK/docs" | while IFS= read -r dir; do printf '%s\0' "$dir/main.rig"; done |
        xargs -0 cksum | cut -d' ' -f1 >"$WORK/docs.sum"
    paste "$WORK/docs" "$WORK/docs.sum" | awk -F'\t' -v OFS='\t' '
        { key = $1; sub(/[^\/]*$/, $3, key); if (n[key]++) key = key "-" n[key]; print $1, $2, key }
    ' >"$WORK/docs.keyed"
    select_tests "$WORK/docs.keyed" >>"$LIST"
fi

# A full run removes the output directories of tests that are gone (and
# of doc examples whose text changed), keeping the rest and their build
# caches: every listed test, and every corpus program, sampled or not.
# Only the directories of test kinds are touched. `--prune` does only
# this, and what follows.
if [[ ${#FILTERS[@]} -eq 0 ]]; then
    { cut -f3 "$LIST"; [[ -f "$WORK/corpus.all" ]] && sed 's#^#corpus/#' "$WORK/corpus.all"; } >"$WORK/keep"
    find "$OUTROOT" -mindepth 1 -maxdepth 3 | awk -F'\t' -v root="$OUTROOT/" '
        FILENAME == ARGV[1] {
            keep[$1] = 1
            n = split($1, p, "/"); pre = p[1]
            for (i = 1; i < n; i++) { dir[pre] = 1; pre = pre "/" p[i + 1] }
            next
        }
        {
            rel = substr($0, length(root) + 1)
            if (rel !~ /^(behavior|reject|known|examples|ir|torture|cli|doc|corpus|oracle)(\/|$)/) next
            n = split(rel, p, "/"); pre = p[1]; inside = 0
            for (i = 1; i < n; i++) { if (pre in keep || pre in gone) inside = 1; pre = pre "/" p[i + 1] }
            if (inside || rel in keep || rel in dir) next
            base = rel; sub(/\.(stdout|stderr|diff|started)$/, "", base)
            if (base in keep) next
            gone[rel] = 1
            print
        }
    ' "$WORK/keep" - | tr '\n' '\0' | xargs -0 rm -rf
    # And the store's builds that no run has used for STORE_DAYS days.
    # Each goes in one step, renamed into the trash, so no build ever sees
    # half an entry (manifests whose binaries are gone); then the trash,
    # with what an interrupted prune left there, is deleted.
    if [[ -n "$RIG_BUILD_STORE" && -d "$RIG_BUILD_STORE" ]]; then
        # -H: the store may be a link to a directory elsewhere.
        find -H "$RIG_BUILD_STORE" -mindepth 2 -maxdepth 2 -name used -mtime +"$STORE_DAYS" | sed 's#/used$##' |
            while IFS= read -r entry; do mv "$entry" "$RIG_BUILD_STORE/.trash.$$.${entry##*/}" 2>/dev/null; done
        find -H "$RIG_BUILD_STORE" -mindepth 1 -maxdepth 1 -name '.trash.*' -exec rm -rf {} +
        # The evidence files of runs killed before rig could remove them.
        [[ -d "$RIG_BUILD_STORE/.started" ]] && find -H "$RIG_BUILD_STORE/.started" -type f -mtime +1 -delete
    fi
fi
[[ -n "$PRUNE" ]] && exit 0

# --shard I/N keeps the tests whose id hashes to I - 1 modulo N. The hash
# reads bytes (LC_ALL=C), so every machine's awk agrees on it.
if [[ -n "$SHARD" ]]; then
    LC_ALL=C awk -F'\t' -v i="${SHARD%/*}" -v n="${SHARD#*/}" '
        BEGIN { for (c = 1; c < 256; c++) ord[sprintf("%c", c)] = c }
        {
            h = 0
            for (c = 1; c <= length($1); c++) h = (h * 31 + ord[substr($1, c, 1)]) % 1000003
            if (h % n == i - 1) print
        }
    ' "$LIST" >"$LIST.shard" && mv "$LIST.shard" "$LIST"
fi

# Whole-program checks run alongside the per-file tests.
UNIT_LOG="$WORK/unit.log" UNIT_PID=""
if selected unit; then
    "$ZIG" build test >"$UNIT_LOG" 2>&1 &
    UNIT_PID=$!
fi
if selected parser; then
    if [[ -x "$NEXUS" ]]; then
        if "$NEXUS" rig.grammar "$WORK/parser.zig" >"$WORK/parser.log" 2>&1 &&
            cmp -s "$WORK/parser.zig" src/parser.zig; then
            printf 'pass\tparser\t\n' >"$RESULTS/st/parser"
        else
            printf 'fail\tparser\tsrc/parser.zig is stale or hand-edited; run zig build parser\n' >"$RESULTS/st/parser"
        fi
    else
        printf '%snote: %s not built; skipping parser freshness check%s\n' "$Y" "$NEXUS" "$X"
    fi
fi

# What an expression hands over is decided once, by `sema.handsOver`: no
# pass keeps a classifier of its own. Emit names hidden storage only
# through the storage facts (`Emitter.hiddenStorage`, whose table of
# names is the one place they are spelled).
if selected classify; then
    # grep exits 1 when nothing matches, the pass; 2 when it cannot read.
    STRAY=$(grep -nE '\b(isPlaceExpr|isPlace|makesValue|isBranching|readLeaves|classifyReceiverShape)\(' src/*.zig); s1=$?
    grep -nE '__rig_(tmp|hdr|held|src|it|elem|end|subject|whole|payload|opt|lent|leaf|err|recv|env|fn|new|ix|slot)(_|"|\b)|__rig_arg_\{d\}_' src/emit.zig >"$WORK/storage"; s2=$?
    STORAGE=$(grep -vE '^[0-9]+: +\.[a-z_]+(, \.[a-z_]+)* => "__rig_[a-z]+",$' "$WORK/storage" | grep -vE '^[0-9]+: +///|^[0-9]+: +//')
    if [[ $s1 -gt 1 || $s2 -gt 1 ]]; then
        printf 'fail\tclassify\tcould not read src/ (grep exited %s, %s)\n' "$s1" "$s2" >"$RESULTS/st/classify"
    elif [[ -n "$STRAY" ]]; then
        printf 'fail\tclassify\ta classifier outside sema.handsOver: %s\n' "$(echo "$STRAY" | head -1)" >"$RESULTS/st/classify"
    elif [[ -n "$STORAGE" ]]; then
        printf 'fail\tclassify\thidden storage named outside Emitter.hiddenStorage: %s\n' "$(echo "$STORAGE" | head -1)" >"$RESULTS/st/classify"
    else
        printf 'pass\tclassify\t\n' >"$RESULTS/st/classify"
    fi
fi

# The vocabulary (docs/CORE.md, "Three words"): what users read says
# lend, view, and loan, never Rust's single word for all three. The
# check reads the Markdown docs, std/, the string literals in src/, and
# the `# error:` lines of tests and examples, and fails on that word, on
# the forms the three words never take (a hyphenated read or write lend
# as a verb, lending "again", a loan used as a verb), and on a path that
# contains the word. test/vocabulary-allow.txt lists the only lines
# allowed to quote it, each as `path: line text`; an entry that matches
# no such line, or appears twice, fails too.
if selected vocab; then
    # The files to read; a run that cannot list them fails, not passes.
    git ls-files --cached --others --exclude-standard >"$WORK/vocab.files" && [[ -s "$WORK/vocab.files" ]] ||
        echo "test/run: git ls-files listed no files to read" >"$WORK/vocab.files.err"
    sort -u "$WORK/vocab.files" | perl -e '
        my $word = qr/borr[o]w/i;   # spelled so that this script never matches itself
        my $forms = qr/\b(?:read|write)-l[e]n(?:d|ds|t|ding)\b|\bre-?l[e]nd|\bl[o]an(?:ed|ing)\b/i;
        my $allow_file = "test/vocabulary-allow.txt";
        my (%allow, @bad);
        if (open(my $a, "<", $allow_file)) {
            while (my $l = <$a>) {
                chomp $l;
                next if $l =~ /^(#|\s*$)/;
                push @bad, "$allow_file: duplicate entry: $l" if $allow{$l}++;
            }
        }
        my %used;
        while (my $path = <STDIN>) {
            chomp $path;
            next if $path eq $allow_file || !-f $path;
            push @bad, "$path: a path that says the word" if $path =~ $word;
            my $md = $path =~ /\.md$/;
            my $std = $path =~ m{^std/};
            my $src = $path =~ m{^src/.*\.zig$};
            my $exp = $path =~ m{^(test|examples)/.*\.rig$};
            next unless $md || $std || $src || $exp;
            open(my $fh, "<", $path) or next;
            while (my $line = <$fh>) {
                chomp $line;
                my $text = $line;
                if ($src) {
                    my @lits = $line =~ /"((?:[^"\\]|\\.)*)"/g;
                    push @lits, $1 if $line =~ /^\s*\\\\(.*)$/;
                    $text = join("\n", @lits);
                } elsif ($exp) {
                    $text = $line =~ /^\s*#\s*error:(.*)$/ ? $1 : "";
                }
                next unless $text =~ $word || $text =~ $forms;
                my $key = "$path: $line";
                if ($allow{$key}) { $used{$key} = 1; next }
                push @bad, "$path:$.: $line";
            }
        }
        for my $k (sort keys %allow) { push @bad, "$allow_file: stale entry: $k" unless $used{$k} }
        print "$_\n" for @bad;
    ' >"$WORK/vocab" || echo "test/run: the vocabulary check failed" >>"$WORK/vocab"
    [[ -f "$WORK/vocab.files.err" ]] && cat "$WORK/vocab.files.err" >>"$WORK/vocab"
    if [[ -s "$WORK/vocab" ]]; then
        cp "$WORK/vocab" "$RESULTS/log/vocab"
        printf 'fail\tvocab\t%s (%s in all; say lend, view, or loan: docs/CORE.md, "Three words")\n' \
            "$(head -1 "$WORK/vocab")" "$(wc -l <"$WORK/vocab" | tr -d ' ')" >"$RESULTS/st/vocab"
    else
        printf 'pass\tvocab\t\n' >"$RESULTS/st/vocab"
    fi
fi

# The oracle's sets run bin/rig-oracle.
if grep -q '^oracle/' "$LIST" && ! "$ZIG" build oracle 2>&1; then
    printf '%sbuild of bin/rig-oracle failed%s\n' "$R" "$X"
    exit 1
fi

TOTAL=$(wc -l <"$LIST" | tr -d ' ')
if [[ $TOTAL -eq 0 && -z "$UNIT_PID" ]] && ! selected parser && ! selected classify && ! selected vocab; then
    # Only kinds named (`./test/run known`) is not a mistyped filter: a
    # kind can be empty, as test/known/ is when no bug is open.
    for f in "${FILTERS[@]}"; do is_kind "$f" || { echo "no test matches ${FILTERS[*]}" >&2; exit 2; }; done
    echo "no ${FILTERS[*]} tests"
    exit 0
fi
DUPLICATES=$(cut -f1 "$LIST" | sort | uniq -d)
if [[ -n "$DUPLICATES" ]]; then
    printf 'two tests have the id %s (a name.rig beside a name/ directory?)\n' $DUPLICATES >&2
    exit 1
fi

# Longest first, by each test's time in the last run that ran it, so the
# run does not end waiting on one long test while the other jobs sit
# idle. A test with no recorded time is guessed by kind: a CLI script
# builds several programs; the rest take a second or less.
DURATIONS="$OUTROOT/.durations"
[[ -f "$DURATIONS" ]] || : >"$DURATIONS"
awk -F'\t' -v OFS='\t' '
    FILENAME == ARGV[1] { t[$1] = $2; next }
    { d = ($1 in t) ? t[$1] : ($1 ~ /^cli\// ? 60 : 1); print d, FNR, $0 }
' "$DURATIONS" "$LIST" | sort -t$'\t' -k1,1nr -k2,2n | cut -f3- >"$LIST.sorted"

printf '%srunning %s tests (-j %s)%s\n' "$D" "$TOTAL" "$JOBS" "$X"
while IFS=$'\t' read -r id path key; do printf '%s\0%s\0%s\0' "$id" "$path" "$key"; done <"$LIST.sorted" |
    xargs -0 -n 3 -P "$JOBS" "$SELF" --worker
# Keep the times of the tests this run did not select.
[[ -f "$RESULTS/durations" ]] &&
    awk -F'\t' 'FILENAME == ARGV[1] { ran[$1] = 1; print; next } !($1 in ran)' \
        "$RESULTS/durations" "$DURATIONS" >"$DURATIONS.new" &&
    mv "$DURATIONS.new" "$DURATIONS"
# A worker that died left no result.
while IFS=$'\t' read -r id _; do
    [[ -f "$RESULTS/st/${id//\//__}" ]] || printf 'fail\t%s\tno result: the test runner died\n' "$id" >"$RESULTS/st/${id//\//__}"
done <"$LIST"

if [[ -n "$UNIT_PID" ]]; then
    if wait "$UNIT_PID"; then printf 'pass\tunit\t\n' >"$RESULTS/st/unit"
    else printf 'fail\tunit\tzig build test failed\n' >"$RESULTS/st/unit"; cp "$UNIT_LOG" "$RESULTS/log/unit"; fi
fi

# -----------------------------------------------------------------------------
# Report
# -----------------------------------------------------------------------------

ALL="$WORK/all"
cat "$RESULTS"/st/* 2>/dev/null | sort -t$'\t' -k2 >"$ALL"
if [[ ! -s "$ALL" ]]; then
    echo "no test ran" >&2
    exit 2
fi

show_log() {
    local log="$RESULTS/log/${1//\//__}"
    [[ -s "$log" ]] && head -40 "$log" | sed 's/^/        /'
}

if [[ -n "$VERBOSE" ]]; then
    while IFS=$'\t' read -r st id why; do
        case $st in
            pass)  printf '  %spass%s   %s\n' "$G" "$X" "$id" ;;
            known) printf '  %sknown%s  %s %s— %s%s\n' "$Y" "$X" "$id" "$D" "$why" "$X" ;;
            pending) printf '  %spending%s %s %s— %s%s\n' "$Y" "$X" "$id" "$D" "$why" "$X" ;;
        esac
    done <"$ALL"
fi

FAILED=0
while IFS=$'\t' read -r st id why; do
    case $st in
        fail)
            FAILED=1
            printf '\n  %sFAIL%s   %s — %s\n' "$R" "$X" "$id" "$why"
            show_log "$id" ;;
        fixed)
            FAILED=1
            printf '\n  %sFIXED%s  %s — %s\n' "$Y" "$X" "$id" "$why" ;;
    esac
done <"$ALL"

# Per-area table: kind/area → pass / fail / known / pending
printf '\n%s%-26s %6s %6s %6s %8s%s\n' "$B" "area" "pass" "fail" "known" "pending" "$X"
awk -F'\t' '
    {
        n = split($2, p, "/")
        key = (p[1] == "behavior" || p[1] == "reject" || p[1] == "known" || p[1] == "doc") && n >= 3 ? p[1] "/" p[2] : p[1]
        if ($1 == "pass") pass[key]++
        else if ($1 == "known") known[key]++
        else if ($1 == "pending") pending[key]++
        else fail[key]++
        keys[key] = 1
    }
    END { for (k in keys) printf "%-26s %6d %6d %6d %8d\n", k, pass[k], fail[k], known[k], pending[k] }
' "$ALL" | sort

PASS=$(grep -c '^pass' "$ALL")
FAIL=$(grep -cE '^(fail|fixed)' "$ALL")
KNOWN=$(grep -c '^known' "$ALL")
PENDING=$(grep -c '^pending' "$ALL")
ELAPSED=$((SECONDS - START))
if [[ $FAILED -eq 0 ]]; then
    printf '\n%s%d passed%s, 0 failed, %s%d known, %d pending%s  %s(%ds)%s\n' "$G" "$PASS" "$X" "$Y" "$KNOWN" "$PENDING" "$X" "$D" "$ELAPSED" "$X"
else
    printf '\n%d passed, %s%d failed%s, %s%d known, %d pending%s  %s(%ds)%s\n' "$PASS" "$R" "$FAIL" "$X" "$Y" "$KNOWN" "$PENDING" "$X" "$D" "$ELAPSED" "$X"
    exit 1
fi
