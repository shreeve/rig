# Correctness driver for std.json (test/json/compare.py generates the
# program from this template: the cases become a table of string
# literals, and main loops over them). Prints each parse as the
# canonical dump that test/json/README.md describes.
use std.json

HEX = "0123456789abcdef"

sub put_line(out: !String, tag: ?String)
  !out.add(tag, "\n")

sub put_string(out: !String, s: ?String)
  !out.add("s ")
  for b in s
    if b == 0x5C
      !out.add("\\\\")
    else if b < 0x20 or b == 0x7F
      !out.add("\\x")
      !out.push(HEX[Int(b >> 4)])
      !out.push(HEX[Int(b & 15)])
    else
      !out.push(b)
  !out.push(0x0A)

sub dump(d: ?json.Doc, out: !String)
  for i in 0..d.size()
    match d.kind(i)
      .null => put_line(!out, "null")
      .bool => put_line(!out, "true" if d.get_bool(i) else "false")
      .int => !out.add("i ", d.get_int(i), "\n")
      .float => !out.add("f ", d.get_float(i).to_bits(), "\n")
      .string => put_string(!out, d.get_str(i))
      .array => put_line(!out, "[")
      .array_end => put_line(!out, "]")
      .object => put_line(!out, "{")
      .object_end => put_line(!out, "}")

# The case is copied into a String, as a program's input would be.
sub run(name: Static, text: Static)
  src = String(text)
  d = json.new_doc()
  out = String("=== ", name, "\n")
  if (!d).parse(?src)
    dump(?d, !out)
  else
    !out.add("error ", json.error_name(d.error), " ", d.error_pos, "\n")
  print(out)

@CASES@

sub main()
@MAIN@
