# A generic type cannot be instantiated from another module.

use lib

sub main()
  lib.hello()
  b = lib.Box[Int](v: 3)
  print(b.v, Vec[lib.Box[Int]]().len)

# error: 7:7: `lib.Box` is a generic type of another module; generic types cannot cross module boundaries yet
# error: 8:18: `lib.Box` is a generic type of another module
