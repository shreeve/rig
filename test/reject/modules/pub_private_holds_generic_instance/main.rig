# A public struct's field of a private type exposes that type's fields
# too: `Q` holds a `Wrap[*Int]`, an instance of a generic type, which
# cannot cross module boundaries. (`Fake` would otherwise be confused
# with `lib`'s `Wrap`.)

struct Fake
  v: Int

use lib

sub main()
  p = lib.P.make()
  a = p.q.b
  -p
  z = *7777
  print(a.v, z)

# error: public field `q` exposes `Wrap[*Int]`, an instance of a generic type
