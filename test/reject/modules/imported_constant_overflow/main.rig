# An imported constant is a constant here too: constant arithmetic on it
# is checked at compile time, in a module constant and in a body.
use lib

X: U8 = lib.SMALL + 6
Y = lib.HALF * 4611686018427387904

sub main()
  print(X, Y, lib.SMALL + 6, lib.BIG + 1)

