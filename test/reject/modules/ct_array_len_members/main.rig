# `module.NAME` as an array length names a public integer constant of
# the module; anything else is reported for what it is.

use lib

sub main()
  a: [lib.N]Int = [3 of 0]
  b: [lib.nope]Int = [3 of 0]
  c: [nolib.X]Int = [3 of 0]
  d: [lib.S]Int = [3 of 0]
  e: [lib.F]Int = [3 of 0]
  f: [lib.P]Int = [4 of 0]
  print(a, b, c, d, e, f)

