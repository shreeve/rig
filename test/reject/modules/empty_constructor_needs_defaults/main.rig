# `T()` makes a value only from defaults for every field: a private
# field with no default is the module's to set. And explicit fields set
# a value only when every field is `pub`, as before.

use lib

sub main()
  h = lib.Half()
  b = lib.Bag(limit: 4)
  print(h, b)

# error: 8:11: `lib.Half()` makes a `lib.Half` from its fields' defaults, and `size` has no default; its fields `items`, `size` are private to module `lib`, which alone can set them
# error: 9:11: only module `lib` can construct `lib.Bag`: its field `items` is private
