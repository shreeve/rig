# Generic functions cannot cross module boundaries yet: a `pub` generic
# function, or a generic method of a `pub` type, is rejected where it is
# declared. A private generic function serves its own module.

use lib

sub main()
  print(lib.uses_local(3))

# error: public function `same` is generic; generic functions cannot cross module boundaries yet
# error: public method `show` is generic; generic functions cannot cross module boundaries yet
