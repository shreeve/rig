# An imported struct cannot hold a write view (a write view is never
# stored inside a value), so no copy of one can be a second writer.

use wv

sub main()
  x: wv.Wrap = wv.Wrap(v: Vec())
  !x.v.push(1)
  a = wv.WV(b: !x)
  b = a
  b.b.v = Vec()
  print(a.b.v.len)

# error: 5:10: a write view is never stored inside a value, and `!Wrap` cannot stand here
# errors: 1
