# `!` before a function called through a module or a type reaches the
# module or type, which a parse cannot tell from a value's method: one
# diagnostic says so, and how to lend the value the call makes
# (`test/behavior/modules/write_lend_made_by_module`), or, before a
# `Bool`, that `!` is not negation.
use lib

struct U
  n: Int

  fun bump(!self) -> Int
    self.n += 1
    self.n

  fun make() -> U
    U(n: 1)

enum E
  a(s: String)
  b

sub sete(e: !E)
  e = .b

sub main()
  print(!lib.mk().bump())
  print(!lib.T.make().bump())
  print(!U.make().bump())
  sete(!E.a(s: "x"))
  if !lib.ok()
    print("no")

# error: 26:9: `!` here reaches `lib`, a module, not the value `lib.mk()` makes: write `!(lib.mk())` to lend that value, or remove the `!`
# error: 27:9: `!` here reaches `lib.T`, a type, not the value `lib.T.make()` makes: write `!(lib.T.make())` to lend that value, or remove the `!`
# error: 28:9: `!` here reaches `U`, a type, not the value `U.make()` makes: write `!(U.make())` to lend that value, or remove the `!`
# error: 29:8: `!` here reaches `E`, a type, not the value `E.a(s: "x")` makes: write `!(E.a(s: "x"))` to lend that value, or remove the `!`
# error: 30:6: `!` here reaches `lib`, a module, and `lib.ok()` makes a `Bool`; for negation use `not`
# errors: 5
