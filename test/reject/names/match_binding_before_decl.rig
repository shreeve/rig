# A match binding may not share a module-level name, whichever comes first
# (here the declaration comes before).

obj Thing
  v: Int

enum Sh
  circle(r: Int)
  point

fun site(s: Sh) -> Int
  match s
    .circle(Thing) => return Thing
    .point => return 0

sub main()
  print(1)

# error: `Thing` has the same name as the module-level declaration `Thing`
# error: declared here
# errors: 1
