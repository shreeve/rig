# Moving a borrow (or a value holding one) into an argument or a field
# keeps its loans in force until the call or construction ends, so a
# later argument cannot borrow or move the same root.

struct Wrap
  v: Vec[Int]

  sub eat(!self, r: ?Wrap)
    self.v = Vec()
    print(r.v.len)

struct Ed
  t: !Wrap

struct P
  r: ?Wrap
  b: Wrap

enum H
  none_
  two(a: Ed, b: Ed)

sub race(a: ?Wrap, b: !Wrap)
  print(a.v.len)
  b.v = Vec()

sub race2(a: Ed, b: !Wrap)
  print(a.t.v.len)
  b.v = Vec()

sub read_then_write()
  x = Wrap(v: Vec())
  r = ?x
  race(<r, !x)

sub write_then_write()
  x = Wrap(v: Vec())
  e = Ed(t: !x)
  race2(<e, !x)

sub field_then_move()
  x = Wrap(v: Vec())
  r = ?x
  p = P(r: <r, b: <x)
  print(p.r.v.len)

sub receiver_then_moved_arg()
  x = Wrap(v: Vec())
  r = ?x
  !x.eat(<r)

sub variant_fields()
  x = Wrap(v: Vec())
  e = Ed(t: !x)
  h: H = .two(a: <e, b: Ed(t: !x))

sub main()
  read_then_write()

# error: 34:13: cannot write-borrow `x` while a read borrow is live
# error: 39:14: cannot take a second write borrow on `x`
# error: 44:20: cannot move `x` while it is read-borrowed
# error: 50:3: cannot write-borrow `x` while a read borrow is live
# error: 55:32: cannot take a second write borrow on `x`
