# A `break` value takes what it yields: each name a branching value
# may be, a place, a field, a `??` operand, or a `catch` handler, is
# moved with `<`, as in any other taking position.
struct H
  f: Text

fun fail(c: Bool) -> Text!
  return Bad.no if c
  Text("ok")

error Bad
  no

sub main()
  a = Text("a")
  b = Text("b")
  h = H(f: Text("h"))
  o: Text? = Text("o")
  c = true
  x = while true
    break a if c else b
  y = while true
    break h.f if c else b
  z = while true
    break o ?? b
  w = while true
    break fail(c) catch b
  print(x, y, z, w)

# error: 21:11: `a` owns a `Text`, which can't be copied out by `break`: write `<a` to move it or `+a` to clone it
# error: 21:23: `b` owns a `Text`, which can't be copied out by `break`: write `<b` to move it or `+b` to clone it
# error: 23:11: `h.f` owns a `Text`, which can't be copied out by `break`: write `+h.f` to clone it
# error: 23:25: `b` owns a `Text`, which can't be copied out by `break`: write `<b` to move it or `+b` to clone it
# error: 25:11: `o` owns a `Text?`, which can't be copied out by `break`: write `<o` to move it or `+o` to clone it
# error: 25:16: `b` owns a `Text`, which can't be copied out by `break`: write `<b` to move it or `+b` to clone it
# error: 27:25: `b` owns a `Text`, which can't be copied out by `break`: write `<b` to move it or `+b` to clone it
