# A store into a field of a field of parameter `a` keeps `b` lent for
# the rest of the body.

obj Holder
  r: []Int

obj Outer
  h: Holder

fun f(a: !Outer, b: !List[Int]) -> Int keeps b
  a.h.r = ?b[..]
  for i in 0..100
    !b.push(i)
  a.h.r[0]

sub main()
  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  o = Outer(h: Holder(r: ?x[..]))
  print(f(!o, !v))

# errors: 1
# error: 13:5: cannot lend `b` to write while a read loan is live
