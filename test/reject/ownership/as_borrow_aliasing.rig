# A value borrowed by `as` keeps its optional borrowed for the block:
# the optional cannot be used under a write borrow, nor dropped or
# reassigned under any borrow, and the borrow cannot be copied out as
# an owner.

struct Res
  n: Int

  drop(!self)
    print("drop", self.n)

sub main
  r: Res? = Res(n: 1)
  if !r as v
    print(r)
    v.n = 2
  if ?r as v
    drop r
    print(v.n)
  if !r as v
    r = none
    v.n = 3
  keep: Res? = none
  if ?r as v
    keep = <v
  print(keep)

# error: 15:11: use of `r` while a write borrow is live
# error: 18:10: cannot drop `r` while borrows are live
# error: 21:5: cannot reassign `r` while borrows are live
# error: 25:12: expected `Res?`, got `?Res`
