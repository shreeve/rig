# A function cannot store a borrow of its own local into a struct the
# caller owns: the local dies when the function returns.

struct Wrap
  payload: Int

struct View
  box: ?Wrap

sub put(v: !View)
  b = Wrap(payload: 1)
  v.box = ?b

sub main()
  print(1)

# error: cannot store a borrow of `b` in `v.box`: `v` outlives it
