# A jump out of an assignment's value leaves the target's view pointing
# at a local of the scope it leaves; a use of the view after is rejected.
sub main()
  v: Vec[Int] = Vec()
  !v.push(7)
  w = !v[0..1]
  k = 0
  :out match k
    0
      w[0] = match k
        0
          y: Vec[Int] = Vec()
          !y.push(1)
          w = !y[0..1]
          break :out
        _ => 3
    _ => pass
  print(w[0])

# error: 14:16: `y` does not live long enough
# errors: 1
