# Writing to a List while iterating over it is rejected (the loop holds a
# read view).

sub main()
  count: *Cell[Int] = *Cell(0)
  cb1: *sub() = *|+count| !count.set(count.get() + 1)

  subs: List[*sub()] = List()
  !subs.push(+cb1)

  for cb in ?subs
    cb()
    !subs.push(+cb1)

# error: cannot lend `subs` to write while a read loan is live
