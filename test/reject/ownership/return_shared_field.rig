# Returning a shared-handle field would copy the handle without a
# refcount bump; clone it with `+o.inner`.

struct Wrap
  payload: Int

struct Outer
  inner: *Wrap

fun take(o: Outer) -> *Wrap
  o.inner

sub main()
  print(1)

# error: bare use of shared (`*T`) handle `o.inner` in return value would alias the handle
