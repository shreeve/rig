# Returning a shared-handle field would copy the handle without a
# refcount bump; clone it with `+o.inner`.

struct Wrap
  payload: Int

struct Outer
  inner: *Wrap

fun take(o: Outer) -> *Wrap
  o.inner

sub main()
  print(1)

# error: `o.inner` is a `*Wrap` handle, which can't be copied out by `return`: write `+o.inner` for another handle
