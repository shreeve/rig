# Lending a write borrow always shows its sigil: a held write borrow (a
# `!T` parameter, `self` in a `!self` method, a local, a field) is lent
# to a `!T` parameter, a `!self` receiver, a field, or an element
# method as `!w`. A held read borrow is lent on bare.

struct Counter
  n: Int

  sub bump(!self)
    self.n += 1

  sub twice(!self)
    self.bump()
    !self.bump()

  fun get(?self) -> Int
    self.n

struct Ed
  c: !Counter

sub bump(c: !Counter)
  !c.bump()

fun peek(c: ?Counter) -> Int
  c.get()

sub echo(c: !Counter, r: ?Counter)
  bump(c)
  print(peek(r), peek(c))
  e = Ed(c: c)
  !e.c.bump()

sub fill(xs: ![]Int)
  xs.fill(0)

sub reset(c: !Counter)
  old = replace(c, Counter(n: 0))
  print(old.n)

sub main
  c = Counter(n: 0)
  w = !c
  w.bump()
  !w.twice()
  d = Counter(n: 0)
  echo(!c, ?d)
  xs = [1, 2, 3]
  fill(!xs[..])

# error: 13:5: write `!self.bump()`: the call writes `self`
# error: 29:8: write `!c`: the call writes through `c`
# error: 31:13: write `!c`: the field writes through `c`
# error: 35:3: `fill` writes the elements; write the receiver with `!`: `!xs.fill(...)`
# error: 38:17: write `!c`: the call writes through `c`
# error: 44:3: write `!w.bump()`: the call writes `w`
