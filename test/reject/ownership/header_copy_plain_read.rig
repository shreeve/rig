# A header whose subject makes a temporary and reaches no place outside
# it binds a copy of a value made there, even of plain data that is only
# read: it is rejected, as every such header is
# (`header_temporary_rejected.rig`).

fun idx(s: String) -> Int
  s.len - 1

sub main()
  for x in [[1, 2], [3, 4]][idx(?Text("ab"))]
    print(x)

# errors: 1
# error: 10:34: this header binds a copy of its subject, since a temporary it makes ends with the header: bind the index to a name first
