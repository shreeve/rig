# A `![]T` is a write borrow of its root: two live write slices of one
# array are rejected, and so are a push to a Vec, a use of the root, and
# a write through the slice while a reslice of it is live.

sub two()
  a = [1, 2, 3, 4]
  x = !a[0..2]
  y = !a[2..4]
  x[0] = 1
  y[0] = 2

sub push()
  v: Vec[Int] = Vec()
  !v.push(1)
  w = !v[..]
  !v.push(2)
  w[0] = 3

sub root()
  a = [1, 2, 3]
  w = !a[..]
  print(a)
  w[0] = 1

sub reslice()
  a = [1, 2, 3]
  w = !a[..]
  t = !w[1..]
  w[1] = 9
  t[0] = 2

sub reader()
  a = [1, 2, 3]
  w = !a[..]
  t = ?w[1..]
  w[1] = 9
  print(t)

sub main()
  two()

# error: 8:8: cannot take a second write borrow on `a`
# error: 16:4: use of `v` while a write borrow is live
# error: 22:9: use of `a` while a write borrow is live
# error: 29:3: cannot assign to `w[...]` while `w` is borrowed
# error: 36:3: cannot assign to `w[...]` while `w` is borrowed
