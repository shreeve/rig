# `replace(!p.a, Holder(t: ?p.s))` puts in `p.a` a view of `p.s`, a
# value holding a view of itself.

obj Holder
  t: ?String

obj P
  s: String
  a: Holder

sub main()
  p = P(s: String("abc"), a: Holder(t: ""))
  old = replace(!p.a, Holder(t: ?p.s))
  print(old.t, p.a.t)

# error: 13:23: cannot let this call store a view of `p.s` in `p.a`: a value never holds a view of itself
# errors: 1
# oracle: main reject C9
