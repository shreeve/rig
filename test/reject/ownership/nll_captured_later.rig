# Capturing a borrow into a closure is a use of it.

struct Box
  n: Int

  sub bump(!self)
    self.n += 1

  drop self: !Box
    print("drop", self.n)

sub main()
  x = Box(n: 1)
  r = ?x
  w = !x
  f = |<r| print(r.n)
  f()
  w.bump()

# error: cannot write-borrow `x` while a read borrow is live
