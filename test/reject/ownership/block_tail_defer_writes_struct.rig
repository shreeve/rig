# A block-local struct at a branch's tail moves out before the branch's
# defer writes it.
obj R
  v: List[Int]

sub main()
  c = true
  x = if c
    r = R(v: List())
    !r.v.push(1)
    defer !r.v.push(2)
    r
  else
    R(v: List())
  !x.v.push(3)
  print(x.v.len, x.v[0])

# error: 11:12: use of `r` after move
# errors: 1
