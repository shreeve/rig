# No shared handle's value holds a write view, so no clone of a handle,
# even through a read view of its holder, gives two handles that write
# through one view: the field is rejected where it is declared.

struct Wrap
  v: Vec[Int]

struct WV
  b: !Wrap

struct Hold
  h: *WV

sub main()
  x = Wrap(v: Vec())
  print(x.v.len)

# error: 9:6: a write view is never stored inside a value, and `!Wrap` cannot stand here
# errors: 1
