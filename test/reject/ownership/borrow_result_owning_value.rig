# Only a number, `Bool`, `String`, or plain enum reads as the value a
# borrow reaches. A borrow of an owning value, or of a `T` that may own
# one, is not copied out where the value is expected.

fun wv(a: !Vec[Int]) -> !Vec[Int]
  a

fun take(v: Vec[Int]) -> Int
  v.len

fun wr[T](a: !T) -> !T
  a

fun copy[T](a: !T) -> T
  x: T = wr(!a)
  x

sub main()
  v = Vec[Int]()
  z: Vec[Int] = wv(!v)
  print(take(wv(!v)), z.len)

