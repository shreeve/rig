# Loans are not followed into a Cell's or Signal's contents or an owned
# closure's captures, so a String that may view a Text cannot go there:
# not a view, not a String parameter, not a closure's String parameter
# stored through a capture, and not a generic `T` that is a String.

sub put[T](c: !Cell[T], x: T)
  !c.set(x)

fun later[T](x: T) -> *sub()
  *|+x| print(x)

sub main()
  t = Text("abc")
  cell: *Cell[String] = *Cell("lit")
  put(!cell, ?t[..])
  f = later(?t[1..])
  f()
  out: Vec[String] = Vec()
  keep = |!out, s: String| !out.push(s)
  keep("x")
  sig: *Signal[String] = *Signal("s")
  !sig.set(?t[..1])
  print(cell.get(), out)

# error: 15:3: `put[String]` cannot use `T = String`: the generic body stores a `T` in a Cell, a Signal, or an owned closure, which carries no loan, and a String may view a Text
# error: 16:7: `later[String]` cannot use `T = String`
# error: 19:17: `s` does not live long enough
# error: 22:12: cannot store a view of `t` in a `Signal`
