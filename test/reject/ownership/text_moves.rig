# A Text owns its bytes, so a bare name never copies it: it moves with
# `<t` or clones with `+t`, and a moved Text cannot be used.

sub keep(t: String)
  print(t)

sub main()
  t = String("a")
  u = t
  keep(<t)
  print(t, u)

# error: 9:7: `t` owns a `String`, which can't be copied by `=`: write `<t` to move it, `+t` to clone it, or `?t` to view it
# error: 11:9: use of `t` after move
