# A value block discarded with `_ =` still hands over its tail: the
# tail name leaves before the block's defer runs.
sub main
  c = true
  _ = if c
    v: Vec[Int] = Vec()
    !v.push(1)
    defer
      for i in 0..100
        !v.push(i)
    v
  else
    Vec[Int]()
  print(1)

# error: 10:10: use of `v` after move
# errors: 1
