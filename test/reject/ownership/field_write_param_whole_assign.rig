# Through a write view `p: !P`, `p = P(...)` writes the whole value the
# caller owns, dropping the String `r` views.
# Rule: assigning a name writes all of what it names; a path through a
# write view continues, so `r`'s loan is on `p.name`, a part of `p`.
# From Trig's acceptance tests
# (docs/ownership/acceptance/reject/field_write_param_whole_assign.rig).

obj P
  name: String

sub reset(p: !P)
  r = ?p.name
  p = P(name: String("new"))
  print(r)

sub main()
  x = P(name: String("old"))
  reset(!x)
  print(x.name)

# error: 13:3: cannot reassign `p` while `p.name` is lent
# errors: 1
