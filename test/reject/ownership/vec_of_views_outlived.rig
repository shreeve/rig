# A view pushed into a List may not outlive what it views.

fun mk() -> List[?Int]
  a = 1
  v: List[?Int] = List()
  !v.push(?a)
  v

sub main()
  v: List[?Int] = List()
  for i in 0..3
    x = i
    !v.push(?x)
  print(v, mk())

# error: which this function was not lent
# error: `x` does not live long enough
