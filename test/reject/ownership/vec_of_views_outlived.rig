# A view pushed into a Vec may not outlive what it views.

fun mk() -> Vec[?Int]
  a = 1
  v: Vec[?Int] = Vec()
  !v.push(?a)
  v

sub main()
  v: Vec[?Int] = Vec()
  for i in 0..3
    x = i
    !v.push(?x)
  print(v, mk())

# error: which this function was not lent
# error: `x` does not live long enough
