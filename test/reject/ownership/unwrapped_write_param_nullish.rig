# A store through `w ?? return`, the write view a `(!H)?` parameter
# holds, lands in the caller's value, as through a `!H` parameter.

obj H
  s: ?String

  sub keep(!self, v: ?String)
    self.s = v

sub set(w: (!H)?)
  d = String("local")
  (w ?? return).s = ?d

sub main()
  t = String("outer")
  h = H(s: ?t)
  set(!h)
  print(h.s)

# errors: 1
# error: a view of `d`
