# A consuming method's receiver is taken like an argument: each name a
# `??` receiver may be is moved with `<` (`(<o ?? <b)`).
struct Bag
  items: Vec[Int]

  fun total(<self) -> Int
    self.items.len

sub main()
  o: Bag? = Bag(items: Vec())
  b = Bag(items: Vec())
  print((o ?? b).total())
  print(b.items.len)

# error: 12:10: `o` owns a `Bag?`, which can't be copied into an argument: write `<o` to move it or `+o` to pass a clone
# error: 12:15: `b` owns a `Bag`, which can't be copied into an argument: write `<b` to move it or `+b` to pass a clone
# errors: 2
