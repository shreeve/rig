# A store through local write view `c` lands in local `h`, which then
# holds the view of parameter `b`: `b` stays lent while `h` is used.

struct Holder
  r: []Int

fun f(b: !Vec[Int]) -> Int
  x = [9, 9]
  h = Holder(r: ?x[..])
  c = !h
  c.r = ?b[..]
  for i in 0..100
    !b.push(i)
  c.r[0]

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  print(f(!v))

# errors: 1
# error: 13:5: cannot lend `b` to write while a read loan is live
