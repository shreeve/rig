# A closure may run again, so its value cannot move out a captured
# owning value, even as the last expression of its body.

struct Wrap
  v: Vec[Int]

sub main()
  x = Wrap(v: Vec())
  !x.v.push(5)
  s = |<x| x
  a = s()
  b = s()
  print(a.v[0], b.v[0])

# error: 10:12: `x` is a handle the closure captures and keeps for every call, so a return value can't take it; write `+x` for another handle, or `~x` for a weak one
