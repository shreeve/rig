# A loop that does not consume its collection only views each element.
# Where a generic body takes such an element (moves, drops, or returns
# it), every instance must be plain data: the collection still owns it.

obj Res
  n: Int

  drop(!self)
    print("drop", self.n)

fun steal[T](v: ?List[T], d: T) -> T
  r = <d
  for x in v
    r = <x
  r

fun copyall[T](v: ?List[T]) -> List[T]
  out = List[T]()
  for x in v
    !out.push(<x)
  out

sub dropall[T](v: ?List[T])
  for x in v
    <x

fun first[T](v: ?List[T], d: T) -> T
  for x in v
    return x
  <d

obj Bag[T]
  items: List[T]

  fun steal(?self, d: T) -> T
    r = <d
    for x in ?self.items
      r = <x
    r

sub main()
  w = List[*Res]()
  !w.push(*Res(n: 1))
  a = steal(?w, *Res(n: 10))
  c = copyall(?w)
  dropall(?w)
  f = first(?w, *Res(n: 10))
  b: Bag[*Res] = Bag(items: List())

# error: 44:7: `steal[*Res]` cannot use `T = *Res`
# error: 45:7: `copyall[*Res]` cannot use `T = *Res`
# error: 46:3: `dropall[*Res]` cannot use `T = *Res`
# error: 47:7: `first[*Res]` cannot use `T = *Res`
# error: 48:6: `Bag[*Res]` cannot use `T = *Res`
