# A store through a local write view of parameter `a` lands in `a`'s
# value, which keeps `b` lent for the rest of the body.

obj Holder
  r: []Int

fun f(a: !Holder, b: !List[Int]) -> Int keeps b
  k = !a
  k.r = ?b[..]
  for i in 0..100
    !b.push(i)
  a.r[0]

sub main()
  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

# errors: 1
# error: 11:5: cannot lend `b` to write while a read loan is live
