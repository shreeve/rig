# A store through a local write view of parameter `a` lands in `a`'s
# value, which keeps `b` lent for the rest of the body.

struct Holder
  r: []Int

fun f(a: !Holder, b: !Vec[Int]) -> Int
  k = !a
  k.r = ?b[..]
  for i in 0..100
    !b.push(i)
  a.r[0]

sub main
  x = [9, 9]
  v: Vec[Int] = Vec()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

# errors: 1
# error: 11:5: cannot write-borrow `b` while a read borrow is live
