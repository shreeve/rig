# A `!self` method may store a view of its receiver in another `!`
# argument, which keeps the receiver lent while the argument holds it
# (SPEC "Second-class views"): reassigning the receiver, growing what
# the view sees, or using it otherwise is rejected while the argument
# lives. The oracle's verdicts are stated too, so that a weaker
# reference checker fails the run.
# oracle: store_read_view reject C4
# oracle: bang_receiver reject C4
# oracle: store_slice reject C4
# oracle: store_into_struct reject C4

obj H
  n: Int
  v: List[Int]

  sub put(!self, dst: !List[?List[Int]]) keeps self
    !self.v.push(1)
    !dst.push(?self.v)

  sub puts(!self, dst: !List[[]Int]) keeps self
    !self.v.push(1)
    !dst.push(?self.v[..])

  sub putf(!self, dst: !Slot) keeps self
    !self.v.push(1)
    dst.s = ?self.v[..]

obj Slot
  s: []Int

sub store_read_view()
  v: List[Int] = List()
  h = H(n: 1, v: <v)
  d: List[?List[Int]] = List()
  !h.put(!d)
  h = H(n: 2, v: List())
  print(d.len)

sub bang_receiver()
  v: List[Int] = List()
  h = H(n: 1, v: <v)
  d: List[?List[Int]] = List()
  !h.put(!d)
  !h.v.push(5)
  print(d.len)

sub store_slice()
  v: List[Int] = List()
  h = H(n: 1, v: <v)
  d: List[[]Int] = List()
  !h.puts(!d)
  for i in 0..100
    !h.v.push(i)
  print(d[0])

sub store_into_struct()
  v: List[Int] = List()
  h = H(n: 1, v: <v)
  e: List[Int] = List()
  sl = Slot(s: ?e[..])
  !h.putf(!sl)
  for i in 0..100
    !h.v.push(i)
  print(sl.s)

sub main()
  store_read_view()

# error: 36:3: cannot reassign `h` while it is lent
# error: 44:4: use of `h.v` while a write loan on `h` is live
# error: 53:6: use of `h.v` while a write loan on `h` is live
# error: 63:6: use of `h.v` while a write loan on `h` is live
# errors: 4
