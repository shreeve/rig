# What `if … as`, `while … as`, or `match` binds lives through the
# body, past its header, so it may not lend a temporary the header
# made.
#
# oracle: main reject C5

struct B
  o: Text?

enum E
  a(t: Text)
  z

fun mk() -> B
  B(o: Text("o"))

fun mke() -> E
  E.a(t: Text("e"))

sub main()
  if ?mk().o as t
    print(t)
  while ?mk().o as u
    print(u)
    break
  match ?mke()
    .a(t) => print(t)
    .z => pass

# error: 21:7: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `mk()` to a name first
# error: 23:10: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `mk()` to a name first
# error: 26:10: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `mke()` to a name first
# errors: 3
