# What `if … as`, `while … as`, or `match` binds lives through the
# body, past its header, so it may not borrow a temporary the header
# made: a header that lends one binds a copy of its subject, and is
# rejected (`header_temporary_rejected.rig`). One that takes a value made
# there may not keep a view of a temporary either
# (`header_taken_value_views_temporary.rig`).

struct B
  o: Text?

enum E
  a(t: Text)
  z

fun mk -> B
  B(o: Text("o"))

fun mke -> E
  E.a(t: Text("e"))

sub main
  if ?mk().o as t
    print(t)
  while ?mk().o as u
    print(u)
    break
  match ?mke()
    .a(t) => print(t)
    .z => pass

# error: 22:7: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `mk()` to a name first
# error: 24:10: bind `mk()` to a name first
# error: 27:10: bind `mke()` to a name first
# errors: 3
