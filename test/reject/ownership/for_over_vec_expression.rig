# A `for` over a Vec walks a named Vec in place, or consumes the Vec a
# call makes. Any other expression (`o?`, a ternary, a `match`) could
# name a place on one path and make a Vec on another, so it is bound
# to a name first.

fun total(o: Vec[Int]?) -> Int?
  t = 0
  for e in ?o?
    t += e
  t

sub main()
  a: Vec[Int] = Vec()
  !a.push(1)
  b: Vec[Int] = Vec()
  !b.push(2)
  c = a.len > 0
  for e in ?(a if c else b)
    print(e)
  for e in (a if c else b)
    print(e)
  print(total(<b) ?? 0, a.len)

# error: 8:13: cannot lend `o?`: it may be `o`, a value a name holds
# error: 18:14: cannot lend `a if c else b`: it may be `a`, a value a name holds
# error: 20:13: cannot lend `a if c else b`: it may be `a`, a value a name holds
