# Only a bare name returned directly moves out of the function; a handle
# chosen by an if-expression must be written `<a` or `+a`.

struct Box
  payload: Int

fun pick(c: Bool) -> *Box
  a = *Box(payload: 1)
  b = *Box(payload: 2)
  if c
    a
  else
    b

sub main()
  print(1)

# error: bare use of shared (`*T`) handle `a` in return value would alias the handle
