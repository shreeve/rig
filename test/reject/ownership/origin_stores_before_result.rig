# A call stores before its result is handed back: `next` re-points
# `self.items` at `extra`, so its result views `w`, which ends first.

obj Item
  n: Int

obj Cursor
  items: ?List[Item]

  fun next(!self, extra: ?List[Item]) -> ?Item keeps extra
    self.items = extra
    ?self.items[0]

sub main()
  v: List[Item] = List()
  !v.push(Item(n: 1))
  c = Cursor(items: ?v)
  r = ?v[0]
  if true
    w: List[Item] = List()
    !w.push(Item(n: 2))
    r = (!c).next(?w)
  print(r.n)

# error: `w` does not live long enough
