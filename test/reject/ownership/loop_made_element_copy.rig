# An element of an array a loop takes is the binding's own, and unique:
# a bare use that would copy it is rejected; `<k` moves it.

struct Counter
  hits: Cell[Int]

fun two(n: Int) -> [2]Counter
  [Counter(hits: Cell(n)), Counter(hits: Cell(n + 1))]

sub main()
  kept: Counter? = none
  for k in two(10)
    kept = k
  if <kept as c
    print(c.hits.get())

# error: 13:12: bare use of `Counter` value `k` in binding would copy a unique value; use `<k` to move it
