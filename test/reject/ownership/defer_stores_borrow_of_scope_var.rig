# A `defer` body runs when its scope exits: a borrow it stores outside
# the scope, of a var the scope drops, does not live long enough.

sub main
  e: Vec[Int] = Vec()
  s = ?e[..]
  if true
    v: Vec[Int] = Vec()
    !v.push(7)
    defer s = ?v[..]
  print(s)

# error: 10:16: `v` does not live long enough
# errors: 1
