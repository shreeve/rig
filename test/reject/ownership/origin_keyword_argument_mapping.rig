# Keyword arguments fill parameters by name: the result keeps the
# argument that fills `a`, wherever it is written.

fun first(a: ?Vec[Int], b: ?Vec[Int]) -> ?Vec[Int]
  a

sub main
  x: Vec[Int] = Vec()
  y: Vec[Int] = Vec()
  r = first(b: ?y, a: ?x)
  !x.push(1)
  print(r.len)

# error: 11:3: cannot write-borrow `x` while a read borrow is live
