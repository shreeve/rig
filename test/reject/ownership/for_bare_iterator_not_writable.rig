# `for !it` is `for _ in !it`, so the iterator must be writable where the
# loop stands, as for `for n in !it`.

obj Count
  lo: Int
  hi: Int

  fun next(!self) -> Int?
    return none if self.lo >= self.hi
    self.lo += 1
    self.lo - 1

sub scan(it: ?Count)
  for !it
    print(1)

sub peek(it: Count)
  for !it
    print(1)

sub main()
  k =! Count(lo: 0, hi: 2)
  for !k
    print(1)
  c = Count(lo: 0, hi: 2)
  for ?c
    print(1)
  for !Count(lo: 0, hi: 2)
    print(1)

# error: 14:8: cannot lend to write through a read view `?Count`
# error: 18:8: cannot lend parameter `it` to write; parameters are immutable (bind a copy with `new it = it`, or take `it: !Count` to write through to the caller)
# error: 23:8: cannot lend fixed binding `k` to write (bound with `=!`)
# error: 26:8: `for ?c` would only read an iterator, which `next` cannot advance; write `for !c` to advance it in place
# error: 28:8: `!Count(lo: 0, hi: 2)` advances a place, and this is a value made here; write `for Count(lo: 0, hi: 2)`, which holds it for the loop
# errors: 5
