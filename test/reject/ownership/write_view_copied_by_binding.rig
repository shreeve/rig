# No read match or loop binding copies a write view out of a payload or
# an element: a write view is never stored inside a value, so a struct
# field or a variant field that is one is rejected where it is declared.

struct Holder
  v: Vec[Int]

struct Ed
  t: !Holder

enum E
  a(t: !Holder)
  b

sub main()
  h = Holder(v: Vec())
  print(h.v.len)

# error: 9:6: a write view is never stored inside a value, and `!Holder` cannot stand here
# error: 12:8: a write view is never stored inside a value, and `!Holder` cannot stand here
# errors: 2
