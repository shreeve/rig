# A header's temporaries end with the header, so nothing it binds may
# view one: not a `match` binding, or what a `for` walks. A call's
# result a `for` lends would end with the header too, and a part of a
# temporary cannot be moved out of it. (`as` and `match` bindings that
# borrow one: header_temporary_view_bound.rig.)

struct B
  v: Vec[Int]
  o: Text?

enum E
  a(t: Text)
  z

struct H
  e: E

fun mk -> B
  v: Vec[Int] = Vec()
  !v.push(1)
  B(v: <v, o: Text("o"))

fun mke -> E
  E.a(t: Text("e"))

fun mv -> Vec[Int]
  v: Vec[Int] = Vec()
  !v.push(2)
  v

sub main
  match H(e: mke()).e
    .a(t) => print(t)
    .z => pass
  for x in ?mk().v
    print(x)
  for n in ?mv()
    print(n)
  x = <mk().v
  print(x)

# error: 32:9: the arms' bindings would outlive the temporary `H(e: mke())`
# error: 35:13: the loop would walk the temporary `mk()` after its header drops it
# error: 37:13: the loop would walk a borrow of the temporary `mv()` after its header drops it
# error: 39:7: cannot move a part out of the temporary `mk()`
# errors: 4
