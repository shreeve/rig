# A header's temporaries end with the header, so nothing it binds may
# view one: not what a `for` lends. A call's result a `for` lends would
# end with the header too, and a part of a temporary cannot be moved out
# of it. (A bare part of a made value is held for the construct:
# test/known/ownership/match_made_part_cell_holder.rig. `as` and `match`
# bindings that view one: header_temporary_view_bound.rig.)

struct B
  v: Vec[Int]
  o: Text?

enum E
  a(t: Text)
  z

struct H
  e: E

fun mk() -> B
  v: Vec[Int] = Vec()
  !v.push(1)
  B(v: <v, o: Text("o"))

fun mke() -> E
  E.a(t: Text("e"))

fun mv() -> Vec[Int]
  v: Vec[Int] = Vec()
  !v.push(2)
  v

sub main()
  for x in ?mk().v
    print(x)
  for n in ?mv()
    print(n)
  x = <mk().v
  print(x)

# error: 33:13: the loop would walk the temporary `mk()` after its header drops it
# error: 35:13: the loop would walk a view of the temporary `mv()` after its header drops it
# error: 37:7: cannot move a part out of the temporary `mk()`
# errors: 3
