# A closure body cannot drop a captured resource: the capture belongs to
# the closure env, and a retained closure may be called again.

sub main()
  sig: *Signal[Int] = *Signal(0)
  bump = |+sig|
    <sig
    print("dropped")
  bump()

# error: cannot drop captured `sig`; the closure keeps what it captures for every call. Use `+sig` for another handle, `~sig` for a weak one, or call its methods
