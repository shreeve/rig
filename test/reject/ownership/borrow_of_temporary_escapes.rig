# A borrow of a temporary lives only until its statement ends. Held in
# a binding, a field, or a returned value, it would outlive the
# temporary it points to; used within the statement, it is fine.

struct S
  n: Int

struct H
  s: ?S

fun rt(n: Int) -> Int
  n

fun pick(s: ?S) -> ?S
  s

fun mk(n: Int) -> H
  H(s: ?S(n: rt(n)))

fun first(s: ?S) -> Int
  s.n

sub main()
  h = H(s: ?S(n: rt(7)))
  r = ?S(n: 1)
  q = pick(?S(n: rt(7)))
  c = ?mk(3)
  print(first(?S(n: 2)))
  print(h.s.n, r.n, q.n, c.s.n)

# error: 18:9: cannot return a view of `S(n: rt(n))`, which this function was not lent
# error: 24:13: a view of the temporary `S(n: rt(7))` outlives its statement
# error: 25:8: a view of the temporary `S(n: 1)` outlives its statement
# error: 26:13: a view of the temporary `S(n: rt(7))` outlives its statement
# error: 27:8: a view of the temporary `mk(3)` outlives its statement
