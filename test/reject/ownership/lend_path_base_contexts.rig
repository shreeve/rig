# A lend of a place is never the base of a path in any context: a
# closure's expression body, a closure's or a block's last value, and a
# function's last value, each its own statement for the hint. A lend
# moved, `<(!p)`, is the lend. A written `!` on a slice only read, a
# field holding functions indexed and called, a read lend written
# through, and a write through a shared handle are reported too, each
# once, with a hint that compiles or none.

struct Set
  items: Vec[Int]

  fun insert(!self, k: Int) -> Bool
    !self.items.push(k)
    true

struct Q
  n: Int

  fun get(?self) -> Int
    self.n

struct P
  x: Int
  o: Int?
  a: [2]Int
  v: Vec[Int]
  q: Q
  s: Set
  items: Vec[Int]

fun double(n: Int) -> Int
  n * 2

struct Table
  ops: [2]fun(Int) -> Int

fun twice(n: !Int) -> Int
  n * 2

fun mk() -> P
  P(x: 1, o: 3, a: [1, 2], v: Vec(), q: Q(n: 1), s: Set(items: Vec()), items: Vec())

fun last(p: !P) -> Int
  (!p).x

fun last_bool(p: !P) -> Bool
  (!p).s.insert(1)

fun last_moved(p: !P) -> Int
  (<(!p)).a[0]

sub main()
  p = mk()
  q = mk()
  c = p.x > 0
  arr = [1, 2]
  f1 = |!p| (!p.v)[0]
  f2 = |!p| twice(!(!p.a)[1])
  f3 = |!p| (!p).q.get()
  f4 = |!p| (<(!p)).x
  f5 = |!p|
    k = 1
    (!p).a[k]
  y = if c
    (!p).x
  else
    (<(?q)).x
  print(f1(), f2(), f3(), f4(), f5(), y, last(!p), last_bool(!p), last_moved(!p))
  (<(!p)).x = 5
  (<(!arr))[0] = 7
  z = <(<(!p)).o
  n = (<(?p)).a.len
  w = (!arr[..])[0]
  m = (!arr[..]).len
  match (!arr[..])[0]
    1 => print(1)
    _ => pass
  t = Table(ops: [double, double])
  print((!t).ops[1](5))
  x = (?p).items
  (?p).x = 5
  (?p).s.insert(1)
  h = *mk()
  (!h).x = 5
  (!h).v.push(4)
  print(z, n, w, m, x)

