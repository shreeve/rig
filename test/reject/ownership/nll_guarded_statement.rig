# A guarded statement's operands are all used when it runs, though the
# guard comes last in the source.

struct Wrap
  n: Int

  sub bump(!self)
    self.n += 1

  drop(!self)
    print("drop", self.n)

sub pair(r: ?Wrap, w: !Wrap)
  print(r.n, w.n)

sub main()
  flag = true
  x = Wrap(n: 1)
  r = ?x
  pair(r, !x) if flag

# error: cannot write-borrow `x` while a read borrow is live
