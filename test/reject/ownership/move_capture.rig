# A closure keeps what it captures for every call, so `<` cannot end a
# capture: a copy (`|+n|`) would be left as it was, an owned capture
# (`|<v|`) or a weak one (`|~h|`) is the closure's own, and a captured
# view (`|?v|`, `|!w|`) is held for every call. Each is rejected, as a
# branch leaf too.
# oracle: main reject B3

fun twice(n: Int) -> Int
  n * 2

struct P
  v: Int

fun eat(p: P) -> Int
  p.v

fun eatv(v: Vec[Int]) -> Int
  v.len

fun look(v: ?Vec[Int]) -> Int
  v.len

sub main()
  n = 3
  g = |+n| twice(<n)
  p = P(v: 4)
  h = |+p| eat(<p)
  m = 5
  k = |<m| twice(<m)
  v: Vec[Int] = Vec()
  r = |?v| look(<v)
  w: Vec[Int] = Vec()
  x = |!w| look(<w)
  hh = *P(v: 1)
  y = |~hh| <hh
  yy = y()
  print(yy.upgrade() != none)
  u: Vec[Int] = Vec()
  z = |<u| eatv(<u)
  q = |+n, c: Bool| twice(<(n if c else 4))
  print(g(), h(), k(), r(), x(), z(), q(true))

# error: 25:19: cannot move `n`, a copy capture: the closure keeps it for every call; remove the `<` to copy it
# error: 27:17: cannot move `p`, a copy capture: the closure keeps it for every call; remove the `<` to copy it
# error: 29:19: cannot move captured `m`: the closure keeps what it captures for every call; write `+m` for a clone
# error: 31:18: cannot move captured view `v`; the closure holds it for every call. Use it through the view, or pass it to a call
# error: 33:18: cannot move captured view `w`; the closure holds it for every call. Use it through the view, or pass it to a call
# error: 35:14: cannot move captured `hh`: the closure keeps what it captures for every call; write `+hh` for another weak handle
# error: 39:18: cannot move captured `u`: the closure keeps what it captures for every call; write `+u` for a clone
# error: 40:29: `<` here would leave `n` as it was: the closure keeps its capture for every call; remove the `<` to copy it
# errors: 8
