# A slice of a view a call returns, as an argument, views what the
# statement holds only while it runs: the view, which owns nothing to
# drop. The message says so, and to bind the view first.

fun keep(s: String) -> String
  s

struct H
  t: Text

  fun at(!self) -> !Text
    !self.t

fun get(h: !H) -> !Text
  !h.t

sub main()
  h = H(t: Text("hello"))
  s = keep(get(!h)[1..])
  print(s)
  r = keep((!h).at()[1..])
  print(r)

# error: 19:12: a view reached through `get(!h)` outlives its statement, which holds `get(!h)`, itself a view, only while it runs; bind `get(!h)` to a name first
# error: 21:12: a view reached through `(!h).at()` outlives its statement, which holds `(!h).at()`, itself a view, only while it runs; bind `(!h).at()` to a name first
# errors: 2
