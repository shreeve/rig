# Writing through a view held in a field needs write access to the
# struct, as writing any field does: not through a plain parameter or
# a captured value.

struct H
  w: !Int

sub f(h: H)
  h.w += 1

sub main
  n = 1
  h = H(w: !n)
  g = |<h| h.w = 9
  g()

# error: 9:3: cannot assign to parameter `h`
# error: 14:12: cannot assign
# errors: 2
