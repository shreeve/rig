# A value that holds a Cell is unique: a copy would fork the state the
# Cell shares, so a bare use that would copy one is rejected, whether it
# is a name, a field, an element, an array, or a `??` operand.

struct Counter
  hits: Cell[Int]

struct Holder
  c: Counter

sub main()
  a = Counter(hits: Cell(0))
  b = a
  c = Cell(1)
  d = c
  h = Holder(c: Counter(hits: Cell(2)))
  k = h.c
  arr = [Counter(hits: Cell(0)), Counter(hits: Cell(0))]
  copy = arr
  x = arr[1]
  o: Counter? = Counter(hits: Cell(3))
  e = Counter(hits: Cell(4))
  f = o ?? e
  print(b.hits.get(), d.get(), k.hits.get(), copy[0].hits.get(), x.hits.get(), f.hits.get())

# error: 13:7: `a` is a unique `Counter`, which can't be copied by `=`: write `<a` to move it or `?a` to view it
# error: 15:7: `c` is a unique `Cell[Int]`, which can't be copied by `=`: write `<c` to move it or `?c` to view it
# error: 17:7: `h.c` is a unique `Counter`, which can't be copied by `=`: write `?h.c` to view it
# error: 19:10: `arr` is a unique `[2]Counter`, which can't be copied by `=`: write `<arr` to move it or `?arr` to view it
# error: 20:7: `arr[1]` is a unique `Counter`, which can't be copied by `=`: write `?arr[1]` to view it
# error: 23:7: `o` is a unique `Counter?`, which can't be copied by `=`: write `<o` to move it or `?o` to view it
# error: 23:12: `e` is a unique `Counter`, which can't be copied by `=`: write `<e` to move it or `?e` to view it
