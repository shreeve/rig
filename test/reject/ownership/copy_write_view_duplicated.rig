# A bare write view of a Copy value is read where its context wants
# the value, but where a `!T` is expected it would be a second writer: a
# `!T` binding or a `break` value takes it with `<w`. (`new w = w2`
# copies the value.)

sub bind(w2: !Int)
  new w = w2
  v: !Int = w2
  u: !Int = while true
    break w2
  w2 += 1
  w += 1
  v += 1
  u += 1
  print(w, v)

sub main()
  n = 1
  bind(!n)

# error: 8:13: bare use of write view `w2` in binding would copy a write view, which is unique; use `<w2` to move it
# error: 10:11: bare use of write view `w2` in `break` value would copy a write view, which is unique; use `<w2` to move it
# errors: 2
