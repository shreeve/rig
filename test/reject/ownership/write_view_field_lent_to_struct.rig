# Building a second write view from a first one lends the first out: it
# cannot be used while the second is live (here the second is read
# while the first would push, freeing the buffer).

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  !v.push(2)
  !v.push(3)
  if true
    e = !v
    f = !e
    for x in ?f
      !e.push(x)
  print(v.len)

# error: 14:8: use of `e` while a write loan is live
# errors: 1
