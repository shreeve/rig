# A written `!x` that is a leaf of a value that branches or loops is
# decided as the value is read (`sema.yieldedLeaves`): printed, an
# operand, or bound beside a held view, each leaf only reads.

struct P
  x: Int

fun mk() -> P
  P(x: 4)

sub main()
  n = 1
  m = 2
  c = n > 0
  p = P(x: 1)
  print(!n if c else !m)
  k = (!n if c else !m) + 1
  w = !p.x
  a = w if c else !m
  b = while true
    break w if c
    break !m
  d = if c
    while true
      break !n
  else
    m
  e = match n
    1 => !n
    _ => m
  print(k, a, b, d, e)

