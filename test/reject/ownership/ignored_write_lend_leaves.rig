# A written `!x` that is a leaf of a value that branches or loops is
# decided as the value is read (`sema.yieldedLeaves`): printed, an
# operand, or bound beside a held view, each leaf only reads. So is the
# base of a field or element only read (`(!p).x`, `(!arr)[0]`,
# `(!s).len`, a read slice).

struct P
  x: Int

fun mk() -> P
  P(x: 4)

sub main()
  n = 1
  m = 2
  c = n > 0
  p = P(x: 1)
  arr = [1, 2]
  s = "hi"
  print(!n if c else !m)
  k = (!n if c else !m) + 1
  w = !p.x
  a = w if c else !m
  b = while true
    break w if c
    break !m
  d = if c
    while true
      break !n
  else
    m
  e = match n
    1 => !n
    _ => m
  f = (!p).x
  g = (!arr)[0]
  h = (!s).len
  i = ?(!arr)[0..1]
  print(k, a, b, d, e, f, g, h, i)

