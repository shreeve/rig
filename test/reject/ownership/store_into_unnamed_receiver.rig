# A store reached through a write loan lands in what that loan reaches,
# whatever the syntax: a write method's receiver that is no named place
# (a write view a call returns, a branching receiver, one whose
# arguments run first, a field of a returned view), and an assignment's
# target that starts from a value no var holds (a lend `(!h).r`, a
# write view a call returns `wrap(!h).r`, an element of one). Each view
# stored here outlives `s`, whose block ends first.
# oracle: recv_part reject C5
# oracle: assign_view reject C5
# oracle: assign_elem reject C5

struct S
  n: Int
  t: Text

struct H
  r: String
  rs: Vec[String]

  sub keep(!self, r: String)
    !self.rs.push(r)

  sub keep2(!self, k: Int, r: String)
    !self.rs.push(r)

  drop(!self)
    print("dropH sees", self.r, self.rs)

fun mk(n: Int) -> S
  S(n: n, t: Text("hello"))

fun mkh() -> H
  H(r: "init", rs: Vec())

fun wrap(h: !H) -> !H
  h

fun wv(v: !Vec[H]) -> !Vec[H]
  v

fun f(n: Int) -> Int
  n

sub recv_view()
  h = mkh()
  if f(1) == 1
    s = mk(1)
    wrap(!h).keep(?s.t)

sub recv_branch()
  a = mkh()
  b = mkh()
  c = f(1) == 1
  if c
    s = mk(2)
    (!a if c else !b).keep(?s.t)

sub recv_hoisted()
  h = mkh()
  if f(1) == 1
    s = mk(3)
    wrap(!h).keep2(r: ?s.t, k: f(1))

sub recv_part()
  h = mkh()
  if f(1) == 1
    s = mk(4)
    (!wrap(!h).rs).push(?s.t)

sub assign_lend()
  h = mkh()
  if f(1) == 1
    s = mk(5)
    (!h).r = ?s.t

sub assign_lend_elem()
  h = mkh()
  !h.rs.push("a")
  if f(1) == 1
    s = mk(6)
    (!h).rs[0] = ?s.t

sub assign_view()
  h = mkh()
  if f(1) == 1
    s = mk(7)
    wrap(!h).r = ?s.t

sub assign_elem()
  v: Vec[H] = Vec()
  !v.push(mkh())
  if f(1) == 1
    s = mk(8)
    wv(!v)[0].r = ?s.t

sub main()
  recv_view()

