# A String viewing a boxed Text views the box: the box cannot be
# dropped or changed while the view is in use.

sub main()
  b = ^String("boxed")
  s = ?b[1..]
  <b
  print(s)
  c = ^String("c")
  w = ?c[..]
  c = ^String("d")
  print(w, c)

# error: 7:4: cannot drop `b` while it is lent
# error: 11:3: cannot reassign `c` while it is lent
# errors: 2
