# A String viewing a boxed Text borrows the box: the box cannot be
# dropped or changed while the view is in use.

sub main
  b = Box(Text("boxed"))
  s = ?b[1..]
  -b
  print(s)
  c = Box(Text("c"))
  w = ?c[..]
  c = Box(Text("d"))
  print(w, c)

# error: 7:4: cannot drop `b` while borrows are live
# error: 11:3: cannot reassign `c` while borrows are live
# errors: 2
