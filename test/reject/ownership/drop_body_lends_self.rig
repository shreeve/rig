# A drop body cannot lend `self` on as a write borrow: the borrower could
# replace it, and dropping the old value would run the drop body again.

struct N
  id: Int

  sub reset(!self)
    self = N(id: 0)

  drop self: !N
    self.reset()
    (!self).reset()

struct H
  id: Int

  drop self: !H
    replace(self)

sub replace(h: !H)
  h = H(id: 2)

sub main()
  x = N(id: 1)
  y = H(id: 1)

# error: cannot call `reset`, which takes `!self`, inside the drop body
# error: cannot lend `!self` inside its own drop body
# error: inside its own drop body, `self` can only be used through its fields, `?self`, or methods that take `?self`
