# A shared handle whose value holds a write borrow cannot lend it: other
# handles reach the same write borrow.

struct Wrap
  v: Vec[Int]

struct WV
  b: !Wrap

struct Hold
  h: *WV

sub reset(b: !Wrap)
  b.v = Vec()

sub main()
  x = Wrap(v: Vec())
  !x.v.push(1)
  k = Hold(h: *WV(b: !x))
  reset(!k.h.b)

# error: 20:10: cannot lend the write borrow held here through a shared handle
