# A `for` over an iterator it holds (a value made there, a place it
# takes, or a method's iterator lent from a place) keeps what the
# iterator views lent for every iteration: writing it in the body would
# free what a later `next` reads.

obj Cur
  xs: []Int
  i: Int

  fun next(!self) -> Int?
    return none if self.i >= self.xs.len
    self.i += 1
    self.xs[self.i - 1]

obj Bag
  xs: List[Int]

  fun each(?self) -> Cur from self
    Cur(xs: ?self.xs[0..self.xs.len], i: 0)

sub made(v: !List[Int])
  for x in Cur(xs: ?v[0..v.len], i: 0)
    !v.push(x)

sub taken(v: !List[Int])
  c = Cur(xs: ?v[0..v.len], i: 0)
  for x in <c
    !v.push(x)

sub lent(b: !Bag)
  for x in ?b.each()
    !b.xs.push(x)

sub labeled(v: !List[Int])
  @outer for x in Cur(xs: ?v[0..v.len], i: 0)
    for y in 0..2
      !v.push(x + y)
      continue @outer

sub main()
  v: List[Int] = List()
  made(!v)
  taken(!v)
  b = Bag(xs: List())
  lent(!b)
  labeled(!v)

# error: 23:5: cannot lend `v` to write while a read loan is live
# error: 28:5: cannot lend `v` to write while a read loan is live
# error: 32:5: cannot lend `b.xs` to write while a read loan on `b` is live
# error: 37:7: cannot lend `v` to write while a read loan is live
