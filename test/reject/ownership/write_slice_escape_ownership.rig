# A `![]T` is a write view: it is not copied, and it is returned only
# when it views from a `!` parameter.

fun local() -> ![]Int
  a = [1, 2]
  !a[..]

sub copy()
  a = [1, 2]
  w = !a[..]
  t = w
  t[0] = 5
  w[1] = 6

sub main()
  copy()

# error: 6:4: cannot return a view of `a`, which this function was not lent
# error: 11:7: bare use of write view `w` in binding would copy a write view, which is unique
