# A call whose result can hold a view views from its viewed
# arguments: `v` keeps `h` viewed.

struct Wrap
  payload: Int

struct Holder
  inner: *Wrap

struct View
  h: ?Holder

fun mk(h: ?Holder) -> View
  View(h: h)

sub main()
  h = Holder(inner: *Wrap(payload: 5))
  v = mk(?h)
  <h
  x = +v.h.inner
  print(x.payload)

# error: cannot drop `h` while it is lent
