# A branch block of a function's result: its block-local tail is
# returned before the branch's defer runs.
fun mk(c: Bool) -> Vec[Int]
  if c
    v: Vec[Int] = Vec()
    !v.push(1)
    defer
      for i in 0..100
        !v.push(i)
    v
  else
    Vec()

sub main()
  x = mk(true)
  !x.push(3)
  print(x.len, x[0])

# error: 9:10: use of `v` after move
# errors: 1
