# An element of an array a loop takes is the binding's own, and lives
# only for its iteration: a view of it cannot outlive the loop, whether
# it is stored in a binding, a field, or an optional view declared
# outside the loop.

struct Counter
  hits: Cell[Int]

struct Holder
  c: ?Counter

fun two(n: Int) -> [2]Counter
  [Counter(hits: Cell(n)), Counter(hits: Cell(n + 1))]

sub main()
  one = [Counter(hits: Cell(1))]
  saved = ?one[0]
  h = Holder(c: ?one[0])
  opt: (?Counter)? = none
  for k in two(10)
    saved = ?k
    h.c = ?k
    opt = ?k
  print(saved.hits.get(), h.c.hits.get())
  if opt as o
    print(o.hits.get())

# error: 21:14: `k` does not live long enough
# error: 23:12: `k` does not live long enough
# error: 23:12: `k` does not live long enough
