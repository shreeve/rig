# A bare name moves an owning value only where its scope ends with the
# move: `return x`, the last value of the function or block that
# declares it (`test/behavior/ownership/value_tails_leave.rig`), and
# `break x` of a name the loop declares. A name declared outside the
# block or loop takes `<x`.

fun f() -> Vec[Int]
  v: Vec[Int] = Vec()
  r = while true
    !v.push(1)
    break v
  r

sub main()
  v: Vec[Int] = Vec()
  c = true
  e: Vec[Int] = Vec()
  w = if c
    v
  else
    <e
  print(w.len, f().len)

# error: 11:11: bare use of `Vec` value `v` in `break` value would copy the buffer pointer and double-free on scope exit; use `<v` to move ownership
# error: 19:5: bare use of `Vec` value `v` in binding would copy the buffer pointer and double-free on scope exit; use `<v` to move ownership
