# A bare name moves an owning value only where its scope ends with the
# move: `return x`, the last value of the function or block that
# declares it (`test/behavior/ownership/value_tails_leave.rig`), and
# `break x` of a name the loop declares. A name declared outside the
# block or loop takes `<x`.

fun f() -> Vec[Int]
  v: Vec[Int] = Vec()
  r = while true
    !v.push(1)
    break v
  r

sub main()
  v: Vec[Int] = Vec()
  c = true
  e: Vec[Int] = Vec()
  w = if c
    v
  else
    <e
  print(w.len, f().len)

# error: 11:11: `v` owns a `Vec[Int]`, which can't be copied out by `break`: write `<v` to move it or `+v` to clone it
# error: 19:5: `v` owns a `Vec[Int]`, which can't be copied by `=`: write `<v` to move it, `+v` to clone it, or `?v` to view it
