# A bare name moves an owning value only as `return x`, or as the last
# value of the function or block that declares it
# (`test/behavior/ownership/value_tails_leave.rig`). A name declared
# outside the block, and a `break` value, take `<x`.

fun f() -> Vec[Int]
  e: Vec[Int] = Vec()
  r = while true
    v: Vec[Int] = Vec()
    !v.push(1)
    break v
  else
    <e
  r

sub main()
  v: Vec[Int] = Vec()
  c = true
  e: Vec[Int] = Vec()
  w = if c
    v
  else
    <e
  print(w.len, f().len)

# error: 11:11: bare use of `Vec` value `v` in `break` value would copy the buffer pointer and double-free on scope exit; use `<v` to move ownership
# error: 21:5: bare use of `Vec` value `v` in binding would copy the buffer pointer and double-free on scope exit; use `<v` to move ownership
# errors: 2
