# A field or element of a value made in the statement is dropped with
# it: `<` can neither end it nor empty it, so `<` on it is rejected,
# whatever its type and whatever form carries the move. One that copies
# is read with no `<`; one that moves is reached by binding the value to
# a name first. A branching value's leaf follows the same rule.
# oracle: owning reject C3
# oracle: copying reject C3
# oracle: for_owning reject C3
# oracle: for_copying reject C3
# oracle: branch_leaves reject C3
# oracle: made_optional reject C3

error E
  bad

struct S
  n: Int
  v: Vec[Int]
  arr: [2]Int
  vs: [2]Vec[Int]
  o: Int?

fun mk -> S
  v: Vec[Int] = Vec()
  !v.push(7)
  S(n: 1, v: <v, arr: [1, 2], vs: [Vec(), Vec()], o: 3)

fun get(bad: Bool) -> Vec[Int]!
  return E.bad if bad
  Vec[Int]()

fun mkh -> *S
  *mk()

struct G[T]
  f: T

fun generic[T](x: T) -> T
  <G(f: <x).f

sub owning
  a = mk()
  b = mk()
  c = a.n > 0
  w = <mk().v
  x = <(<a).v
  y = <[<b, mk()][0].v
  z = <(mk() if c else mk()).v
  print(w.len, x.len, y.len, z.len)

sub copying
  a = mk()
  m = <mk().n
  h = <mkh().n
  p = <(+a).arr
  q = <mk().o
  print(m, h, p, q)

sub for_owning
  for x in <mk().v
    print(x)

sub for_copying
  for x in <mk().arr
    print(x)

sub branch_leaves(c: Bool)
  x = <(mk().v if c else Vec[Int]())
  y = <(get(true) catch mk().v)
  print(x.len, y.len)

fun made_leaf_value(c: Bool) -> Vec[Int]
  w: Vec[Int] = Vec()
  <(mk().v if c else <w)

fun made_optional -> Int?
  x = <mk().o?
  x

sub main
  owning()
  copying()
  for_owning()
  for_copying()
  print(generic(1))
  branch_leaves(true)
  print(made_leaf_value(true).len, made_optional())

