# A bare alias of a `Cell` holding a shared handle is rejected: both
# bindings would run the destructor.

struct User
  age: Int

sub main()
  u: *User = *User(age: 30)
  c1: Cell[*User] = Cell(<u)
  c2: Cell[*User] = c1
  print(0)

# error: `c1` owns a `Cell[*User]`, which can't be copied by `=`: write `<c1` to move it or `?c1` to view it
