# Testing against a bare variant drops a value no name holds; a `catch`
# that may yield a name's value cannot be tested that way.
error E
  bad

enum Shape
  dot
  line(v: Vec[Int])

fun mk(ok: Bool) -> Shape!
  if not ok
    return E.bad
  .dot

sub main
  p: Vec[Int] = Vec()
  !p.push(1)
  d = Shape.line(<p)
  if (mk(false) catch d) != .dot
    print("line")
  match ?d
    .line(v) => print(v[0])
    .dot => print("dot")

# error: 19:7: cannot test `mk(false) catch d` against `.dot`: it may be `d`, a value a name holds, and the test drops the value it tests
# errors: 1
