# A handle no binding holds is lent to write as any value is
# (`test/behavior/ownership/write_lend_temporary_view.rig`): `!h` lends the
# handle itself. A value that may be a name's, like the value inside an
# optional parameter, would be lent as a copy, which the change would
# miss: it is rejected.

struct P
  n: Int

sub g(p: !*P)
  print(p.n)

fun f(o: (*P)?) -> Int?
  g(!o?)
  1

sub main
  print(f(none) ?? 0)

# error: 14:6: cannot lend `o?` to write: it may be `o`, a value a name holds, which lending the branching value would copy
# errors: 1
