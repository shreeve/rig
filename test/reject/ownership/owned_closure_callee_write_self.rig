# Calling an owned closure reads what holds it until the call returns,
# so the call may not lend that holder to write: the closure could
# replace itself there and free the environment it runs in. Each form
# of the callee is held: a field, an element, a view of the handle, an
# `as` binding, a field of a generic type, a box, and a write view.

obj Checker
  n: Int
  hook: *sub(!Checker)
  hooks: List[*sub(!Checker)]
  opt: (*sub(!Checker))?

  sub run(!self)
    self.hook(!self)

  sub run_element(!self)
    self.hooks[0](!self)

  sub run_view(!self)
    g = ?self.hook
    g(!self)

  sub run_as(!self)
    if self.opt as f
      f(!self)

obj H[T]
  n: T
  hook: *sub(!H[T], T)

  sub run(!self, x: T)
    self.hook(!self, x)

sub boxed(b: !^Checker)
  b.hook(!b)

sub through(c: !Checker)
  w = !c
  w.hook(!w)

sub main()
  print(1)

