# Moving a view (or a value holding one) into an argument or a field
# keeps its loans in force until the call or construction ends, so a
# later argument cannot lend or move the same root.

struct Wrap
  v: Vec[Int]

  sub eat(!self, r: ?Wrap)
    self.v = Vec()
    print(r.v.len)

struct Ed
  r: ?Wrap

struct P
  r: ?Wrap
  b: Wrap

enum H
  none_
  two(a: Ed, b: Wrap)

sub race(a: ?Wrap, b: !Wrap)
  print(a.v.len)
  b.v = Vec()

sub race2(a: Ed, b: !Wrap)
  print(a.r.v.len)
  b.v = Vec()

sub read_then_write()
  x = Wrap(v: Vec())
  r = ?x
  race(<r, !x)

sub write_then_write()
  x = Wrap(v: Vec())
  e = Ed(r: ?x)
  race2(<e, !x)

sub field_then_move()
  x = Wrap(v: Vec())
  r = ?x
  p = P(r: <r, b: <x)
  print(p.r.v.len)

sub receiver_then_moved_arg()
  x = Wrap(v: Vec())
  r = ?x
  !x.eat(<r)

sub variant_fields()
  x = Wrap(v: Vec())
  e = Ed(r: ?x)
  h: H = .two(a: <e, b: <x)
  print(h)

sub main()
  read_then_write()

# error: 34:13: cannot lend `x` to write while a read loan is live
# error: 39:14: cannot lend `x` to write while a read loan is live
# error: 44:20: cannot move `x` while a read loan is live
# error: 50:3: cannot lend `x` to write while a read loan is live
# error: 55:26: cannot move `x` while a read loan is live
