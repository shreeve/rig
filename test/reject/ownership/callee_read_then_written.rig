# The value a call calls is read before its arguments run: an argument
# cannot lend an owned closure to write while it is being called, or
# the call would run a closure the argument freed.

fun reset(f: !*fun(Int) -> Int) -> Int
  f = *|k: Int| k + 2
  1

sub main
  base = 40
  f = *|<base, k: Int| base + k
  print(f(reset(!f)))

# error: 12:18: cannot lend `f` to write while the callee's read of it is in use
# errors: 1
