# A method that stores its argument in `!self` stores a view of `b` in
# parameter `a`, which keeps `b` lent for the rest of the body.

obj Holder
  r: []Int

  sub set(!self, s: []Int) keeps s
    self.r = s

fun f(a: !Holder, b: !List[Int]) -> Int keeps b
  !a.set(?b[..])
  for i in 0..100
    !b.push(i)
  a.r[0]

sub main()
  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

# errors: 1
# error: 13:5: cannot lend `b` to write while a read loan is live
