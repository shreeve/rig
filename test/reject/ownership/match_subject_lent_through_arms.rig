# A `match` reads its subject again after a guard runs, to test the next
# arm's pattern: what the subject views stays lent through every guard,
# in a nested match too. A write lend of it there is rejected, as is one
# in an arm whose subject views it through a write view the arm uses,
# in the body of an `if … as` whose binding views it and is used after,
# and in a loop walking a view of it.

enum Shape
  circle(r: Int)
  point

fun grow(v: !List[Shape]) -> Bool
  for _ in 0..100
    !v.push(.point)
  false

obj H
  o: ^Int?

fun clear(h: !H) -> Bool
  h.o = none
  false

fun first(v: ?List[Shape]) -> []Shape
  ?v[..1]

sub main()
  v: List[Shape] = List()
  !v.push(.circle(r: 5))
  w = !v
  n = match ?w[0]
    .point => 0
    .circle(_) if grow(!v) => 1
    .circle(_) => 2
  print(n)
  x = !v
  match ?x[0]
    .point => print(0)
    .circle(_) => print(grow(!v), x.len)
  k = 1
  y = !v
  match k
    1 => match ?y[0]
      .circle(_) if grow(!v) => print(k)
      _ => print(0)
    _ => print(k)
  h = H(o: ^3)
  z = !h
  if ?z.o as s
    print(clear(!h))
    print(s)
  for s in first(?v)
    print(grow(!v), s)

# error: 33:25: cannot lend `v` to write while a write loan is live
# error: 39:31: cannot lend `v` to write while a write loan is live
# error: 44:27: cannot lend `v` to write while a write loan is live
# error: 50:18: cannot lend `h` to write while a write loan is live
# error: 53:17: cannot lend `v` to write while a read loan is live
# errors: 5
