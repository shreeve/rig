# A generic body tracks no loan in a value of a type parameter's type,
# but in an instance it may hold a view: a `T` made from a parameter
# views what that parameter's argument views, so returning it returns a
# view of that parameter, which `from` must name. Each was accepted and
# used freed memory when the caller dropped what the unnamed argument
# viewed.

fun pick[T](f: ?fun(?String) -> T, a: ?String, b: ?String) -> T from b
  f(a)

fun first[T](xs: []T, ys: []T) -> T from ys
  xs[0]

obj H[T]
  f: *fun(?String) -> T

  fun make(?self, s: ?String, t: ?String) -> T from t
    self.f(s)

fun get[T](o: T?, d: T) -> T from d
  o ?? d

fun unwrap[T](o: T?, d: T) -> T from d
  if <o as v
    return v
  d

sub main()
  pass

