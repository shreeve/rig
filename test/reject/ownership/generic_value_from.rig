# A generic body tracks no loan in a value of a type parameter's type,
# but in an instance it may hold a view: a `T` made from a parameter
# views what that parameter's argument views, so returning it returns a
# view of that parameter, which `from` must name, as does a result that
# holds a `T` beside a view, and a `match` payload of type `T` viewing
# its subject. Each was accepted and used freed memory when the caller
# dropped what the unnamed argument viewed.

fun pick[T](f: ?fun(?String) -> T, a: ?String, b: ?String) -> T from b
  f(a)

fun first[T](xs: []T, ys: []T) -> T from ys
  xs[0]

obj H[T]
  f: *fun(?String) -> T

  fun make(?self, s: ?String, t: ?String) -> T from t
    self.f(s)

fun get[T](o: T?, d: T) -> T from d
  o ?? d

fun unwrap[T](o: T?, d: T) -> T from d
  if <o as v
    return v
  d

obj P[T]
  s: ?String
  v: T

fun mk[T](x: T, c: ?String) -> P[T] from c
  P(s: c, v: x)

enum Opt[T]
  some(value: T)
  nothing

fun payload[T](o: ?Opt[T], d: T) -> T from d
  match o
    .some(v) => v
    .nothing => d

sub main()
  pass

