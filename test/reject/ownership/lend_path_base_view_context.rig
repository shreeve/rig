# A hint gives the whole path the sigil its context takes, by the type
# expected there: `!` where a write view goes, `?` where a read view is
# kept (a binding, a field, a result), and none where a value goes or a
# read view is lent for an argument. A leaf of a value that branches
# takes the branch's, as its other leaves show.

struct Q
  n: Int

struct P
  x: Int
  a: [2]Int
  q: Q
  items: Vec[Int]

struct W
  r: ?Vec[Int]

sub bump(n: !Int)
  n += 1

sub grow(v: !Vec[Int])
  !v.push(1)

sub bumpq(q: !Q)
  q.n += 1

fun count(v: ?Vec[Int]) -> Int
  v.len

fun items(p: ?P) -> ?Vec[Int] from p
  (?p).items

fun first(p: !P) -> !Int from p
  (!p.a)[0]

fun xof(p: !P) -> !Int from p
  return (!p).x

sub main()
  p = P(x: 1, a: [1, 2], q: Q(n: 1), items: Vec())
  c = p.x > 0
  bump((!p).x)
  grow((!p).items)
  bumpq((!p).q)
  bump((!p.a)[1])
  print(count((?p).items), count((!p).items))
  w: !Int = (!p).x
  w += 1
  k = W(r: (?p).items)
  print(k.r.len)
  m = (!p).q if c else !p.q
  m.n += 1
  print(p.x, items(?p).len, first(!p), xof(!p))

