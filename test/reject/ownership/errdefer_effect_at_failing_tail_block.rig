# A branch that returns an error value runs the errdefers; the success
# exit does not, so the defer checked at the success exit sees `x`
# moved: the errdefer that reassigns it has not run.
error E
  bad

sub eat(v: List[Int])
  print("eat", v.len)

fun f(ok: Bool) -> Int!
  x: List[Int] = List()
  !x.push(1)
  defer print("deferred", x[0])
  errdefer x = List()
  eat(<x)
  if ok
    1
  else
    return E.bad

sub main()
  print(f(true) catch 0)

# error: 13:27: use of `x` after move
# errors: 1
