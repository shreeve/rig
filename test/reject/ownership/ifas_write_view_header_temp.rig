# `as` over a write view a field holds, in a header that makes a
# temporary, cannot be written: a write view is never stored inside a
# value, so the field is rejected where it is declared.

struct O
  o: !Box[Int]?

fun id(o: !O) -> !O
  o

sub main()
  b: Box[Int]? = Box(5)
  if id(!O(o: !b)).o as x
    print(x)

# error: 6:6: a write view is never stored inside a value, and `!Box[Int]?` cannot stand here
# errors: 1
