# A struct holding a String that views a Text, or a List of such
# Strings, cannot outlive the Text.

obj Name
  s: ?String

sub main()
  n = Name(s: "none")
  names: List[?String] = List()
  if true
    t = String("inner")
    n = Name(s: ?t[..])
    !names.push(?t[1..])
  print(n.s, names)

# error: does not live long enough
