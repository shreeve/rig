# Calling a closure yields a value that may lend what the closure
# captured, so it cannot outlive the viewed value.

obj Wrap
  v: List[Int]

sub main()
  y = Wrap(v: List())
  !y.v.push(1)
  out = ?y
  if true
    x = Wrap(v: List())
    !x.v.push(42)
    r = ?x
    s = |<r| r
    out = s()
  print(out.v[0])

# error: 14:10: `x` does not live long enough
