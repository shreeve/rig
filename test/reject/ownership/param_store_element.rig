# A store into an element of write slice `a` keeps `b` lent for the
# rest of the body.

fun f(a: ![2][]Int, b: !List[Int]) -> Int keeps b
  a[0] = ?b[..]
  for i in 0..100
    !b.push(i)
  a[0][0]

sub main()
  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  hs = [?x[..], ?x[..]]
  print(f(!hs, !v))

# errors: 1
# error: 7:5: cannot lend `b` to write while a read loan is live
