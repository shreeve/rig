# A shared handle chosen by a match expression is still a bare copy of
# the handle: each arm must write `<rc` or `+rc`.

struct Wrap
  payload: Int

sub main()
  rc = *Wrap(payload: 5)
  n = 1
  x = match n
    1 => rc
    _ => rc
  print(x.payload)

# error: 11:10: bare use of shared (`*T`) handle `rc` in binding would alias the handle; use `<rc` to move or `+rc` to clone
# error: 12:10: bare use of shared (`*T`) handle `rc` in binding would alias the handle; use `<rc` to move or `+rc` to clone
