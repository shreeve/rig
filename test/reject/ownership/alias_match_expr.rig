# A shared handle chosen by a match expression is still a bare copy of
# the handle: each arm must write `<rc` or `+rc`.

struct Wrap
  payload: Int

sub main()
  rc = *Wrap(payload: 5)
  n = 1
  x = match n
    1 => rc
    _ => rc
  print(x.payload)

# error: 11:10: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it
# error: 12:10: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it
