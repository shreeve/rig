# `??` taking the value out of an optional a binding still holds would
# copy an owner; move it out with `<o ?? return`.

struct Res
  id: Int

  drop(!self)
    print("drop", self.id)

fun first(o: Res?) -> Int
  r = o ?? return 0
  r.id

sub main
  print(first(Res(id: 1)))

# error: 11:7: bare use of `Res` value `o` in binding would alias an owning value; `Res` carries drop glue (resource fields or a user `drop` declaration), so two bindings would each run the destructor. Use `<o` to move ownership
