# `??` taking the value out of an optional a binding still holds would
# copy an owner; move it out with `<o ?? return`.

struct Res
  id: Int

  drop(!self)
    print("drop", self.id)

fun first(o: Res?) -> Int
  r = o ?? return 0
  r.id

sub main()
  print(first(Res(id: 1)))

# error: 11:7: `o` owns a `Res?`, which can't be copied by `=`: write `<o` to move it or `?o` to view it
