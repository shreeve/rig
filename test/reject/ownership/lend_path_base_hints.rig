# Each hint of a lend as a path's base compiles where it is given: the
# sigil follows the type the context takes (an owned or generic argument
# a clone, an element or a binding of a value that does not copy its
# lend, an optional view a `?`, a slice of an array or a Text a `?`), and
# none is given where no plain form fits: a part taken that is no
# optional, a temporary bound where no statement can go first, a path
# that draws another error of its own, or a path spread over lines. A
# method a call does not find is the call's to report.

obj Log
  log: Cell[List[Int]]

obj P
  x: Int
  o: Int?
  arr: [3]Int
  items: List[Int]
  name: String
  v: List[Int]

fun own(v: List[Int]) -> Int
  v.len

fun gid[T](x: T) -> T
  x

fun sum(xs: []Int) -> Int
  xs[0]

fun mk() -> P
  P(x: 1, o: 2, arr: [1, 2, 3], items: List(), name: String("nm"), v: List())

fun add(a: Int, b: Int, c: Int, d: Int) -> Int
  a + b + c + d

sub poke(k: ?Log)
  (?k).log[0] = 1

sub main()
  p = mk()
  k = *Log(log: Cell(List()))
  t = String("abcd")
  arr = [1, 2, 3]
  print(own((?p).items))
  a = gid((?p).items)
  b: List[Int] = (?p).items
  ys = [(?p).items, (?p).items]
  c = <(!p).items
  w: (?List[Int])? = (?p).items
  print((?t)[1..3])
  d = (?t)[1..3]
  print(sum((?p).arr))
  f = || (!mk()).x = 5
  match p.x
    1 => (!mk()).x = 5
    _ => pass
  (?p).x = 5
  e = (?p).v.len()
  (!t).push_str("d")
  g = <(?p).items
  poke(k)
  s: ?String = (?p).name
  yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy = add(1111111111, 2222222222, 3333333333, (?p).x) + add(1111111111, 2222222222, 3333333333, 4)
  h = (
    ?p
  ).x
  ((!p)).x = 6
  print(a, b, ys, c, w, d, f, e, g, s, yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy, h, arr)

