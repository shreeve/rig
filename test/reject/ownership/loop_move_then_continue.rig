# A move followed by `continue` reaches the loop head, so the next
# iteration sees the value moved.

struct Box
  payload: Int

sub eat(rc: *Box)
  print(rc.payload)

sub main()
  rc = *Box(payload: 1)
  i = 0
  while i < 3
    i += 1
    if i == 1
      eat(<rc)
      continue
    print(rc.payload)

# error: use of `rc` after move
