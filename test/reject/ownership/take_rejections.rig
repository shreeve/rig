# Taking an optional out of a field writes the field: not through a read
# view or a shared handle.

struct N
  v: Int
  next: Box[N]?

struct S
  top: Box[N]?
  n: N

sub rd(s: ?S)
  x = <s.top
  print(x)

sub main()
  h = *S(top: none, n: N(v: 1, next: none))
  z = <h.top
  s = S(top: none, n: N(v: 1, next: none))
  print(z)
  rd(?s)

# error: 13:8: cannot take through a read view (`?T`)
# error: 18:7: cannot take through a shared handle (`*T`)
