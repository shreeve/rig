# A `break` value is consumed: an owning binding is moved with `<b`.

struct Wrap
  n: Int

sub main()
  b = *Wrap(n: 1)
  x = for i in 0..3
    break b if i == 2
  else
    *Wrap(n: 0)
  print(x.n)

# error: 9:11: `b` is a `*Wrap` handle, which can't be copied out by `break`: write `<b` to move it or `+b` for another handle
