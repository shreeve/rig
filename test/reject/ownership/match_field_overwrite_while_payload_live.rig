# The matched value stays lent while a payload binding is in use:
# overwriting it would drop the value the payload views.

obj Tok
  v: List[Int]

enum Slot
  empty
  full(t: *Tok)

obj Holder
  s: Slot

sub clear(h: !Slot)
  match h
    .full(t)
      h = .empty
      print(t.v[0])
    .empty => print("empty")

sub main()
  t0 = Tok(v: List())
  !t0.v.push(1)
  h = Holder(s: .full(*<t0))
  match h.s
    .full(t)
      h.s = .empty
      print(t.v[0])
    .empty => print("empty")

# error: cannot assign to `h.s` while `h.s` is lent
# error: cannot reassign `h` while it is lent
