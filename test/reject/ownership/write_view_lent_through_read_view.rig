# No two read views of one value reach the same write view: a write view
# is never stored inside a value, so a field holding one is rejected
# where it is declared.

struct Holder
  v: Vec[Int]

struct Ed
  t: !Holder

sub main()
  h = Holder(v: Vec())
  print(h.v.len)

# error: 9:6: a write view is never stored inside a value, and `!Holder` cannot stand here
# errors: 1
