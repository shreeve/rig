# A view of write parameter `b` stored in write parameter `a` keeps `b`
# lent for the rest of the body: the caller reads `a` after the return,
# so `!b.push` cannot reallocate the buffer `a.r` views.

obj Holder
  r: []Int

fun f(a: !Holder, b: !List[Int]) -> Int keeps b
  a.r = ?b[..]
  for i in 0..100
    !b.push(i)
  a.r[0]

sub main()
  x = [9, 9]
  v: List[Int] = List()
  !v.push(1)
  h = Holder(r: ?x[..])
  print(f(!h, !v))

# errors: 1
# error: 11:5: cannot lend `b` to write while a read loan is live
