# A view a call stores through a write view lands in the value the
# write view leads to, so it may not outlive that value.

struct In
  v: Vec[Int]

struct Wrap
  r: ?In

struct View
  b: ?In

sub fill(w: !View, b: ?In)
  w.b = b

sub fill_wrap(t: !Wrap, b: ?In)
  t.r = b

sub main()
  a = In(v: Vec())
  v = View(b: ?a)
  if true
    y = In(v: Vec())
    w = !v
    fill(!w, ?y)
  print(v.b.v.len)
  x = Wrap(r: ?a)
  if true
    z = In(v: Vec())
    fill_wrap(!x, ?z)
  print(x.r.v.len)

# error: `y` does not live long enough
# error: `z` does not live long enough
