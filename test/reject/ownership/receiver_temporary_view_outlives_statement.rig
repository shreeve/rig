# A method called on a temporary runs on it where its statement keeps
# it, so the view it returns may be used only within the statement
# (Core §3): plain data, a fallible call's value, and a field holding a
# Cell of one. A value of plain data that branches is read as a copy,
# which its statement keeps the same way.

struct P
  xs: [4]Int

  fun arr(?self) -> ?[4]Int
    ?self.xs

struct Q
  c: Cell[Int]
  n: Int

  fun me(?self) -> ?Q
    self

struct H
  q: Q

error Bad
  oops

fun mk() -> P
  P(xs: [9, 9, 9, 9])

fun mkf(n: Int) -> P!
  return Bad.oops if n > 5
  P(xs: [1, 2, 3, 4])

fun mkh() -> H
  H(q: Q(c: Cell(1), n: 42))

sub main()
  r = mk().arr()
  s = mkh().q.me()
  b = mk()
  t = (mkf(1) catch b).arr()
  print(r, s.n, t, mk().arr()[0])

# errors: 3
# error: 37:7: a view of the temporary `mk()` outlives its statement
# error: 38:7: a view of the temporary `mkh()` outlives its statement
# error: 40:8: a view of the temporary `mkf(1) catch b` outlives its statement
