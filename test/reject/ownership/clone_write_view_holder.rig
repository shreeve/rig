# A write view is never stored inside a value, so no shared handle's
# value holds one, and no clone, weak handle, or clone capture of a
# handle can give two handles that both write through it.

obj Wrap
  v: List[Int]

obj Ed
  t: !Wrap

sub main()
  b = Wrap(v: List())
  !b.v.push(1)
  s = *Ed(t: !b)
  h = +s
  print(h.t.v.len)

# error: 9:6: a write view is never stored inside a value, and `!Wrap` cannot stand here
# errors: 1
