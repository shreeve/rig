# A module's constant lives for the whole program: `<` can neither end
# it nor empty it, whichever module names it, so `<K`, `<geo.K`, and
# `<` on an element of one are rejected; a plain read copies it. So is
# `<geo.mk`: a function lives for the whole program too.
# oracle: main reject C3

use geo

K = 7
KP = [4, 5]

sub main()
  a = <K
  b = <geo.K
  c = <KP[0]
  d = <geo.KP[0]
  e = <geo.mk
  print(a, b, c, d, e(), K, geo.K, KP[0], geo.KP[0])

# error: 13:8: cannot move module-level `K` inside a function; later calls would still use it
# error: 14:8: cannot move module-level `geo.K` inside a function; later calls would still use it
# error: 15:8: cannot move out of `KP[0]`: it copies, so `<` would leave it as it was; remove the `<` to copy it
# error: 16:8: cannot move out of `geo.KP[0]`: it copies, so `<` would leave it as it was; remove the `<` to copy it
# error: 17:8: cannot move function `geo.mk`: a function lives for the whole program; remove the `<` to use it
# errors: 5
