# `Cell.get` on a Cell of shared handles is rejected: the copy would
# alias the owned handle.

struct User
  age: Int

sub main()
  u: *User = *User(age: 30)
  c: Cell[*User] = Cell(<u)
  copy = c.get()
  print(0)

# error: `Cell.get` returns a copy of the value, and a `*User` owns what it must release, so it can't be copied; write `(!cell).replace(<new)`, which puts `new` in and hands back the old value
