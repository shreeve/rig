# No struct holds a write view, so no copy of one is a second live
# mutable path to the viewed value: a write view is never stored inside
# a value, and the field is rejected where it is declared.

struct Wrap
  payload: Int

struct Editor
  target: !Wrap

sub main()
  b = Wrap(payload: 1)
  print(b.payload)

# error: 9:11: a write view is never stored inside a value, and `!Wrap` cannot stand here
# errors: 1
