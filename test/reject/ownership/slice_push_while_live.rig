# A slice of a Vec points into its buffer, which `push` may move: the
# Vec cannot be written or moved while the slice is live.

sub eat(v: Vec[Int])
  print(v.len)

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  s = ?v[0..1]
  !v.push(2)
  eat(<v)
  print(s)

# error: 11:3: cannot lend `v` to write while a read loan is live
# error: 12:8: cannot move `v` while a read loan is live
