# A `[]?String` of a `Static` List keeps the List's loan through a
# function's result, a struct's field, a call that stores it, and a
# List of such structs, as a `[]Static` does.
obj H
  v: []?String

fun conv(xs: []Static) -> []?String
  xs

sub put(h: !H, xs: []Static) keeps xs
  h.v = xs

sub main()
  a = List[Static]()
  !a.push("x")
  r = conv(?a)
  !a.push("y")
  print(r[0])

  b = List[Static]()
  !b.push("x")
  h = H(v: ?b)
  !b.push("y")
  print(h.v[0])

  c = List[Static]()
  !c.push("x")
  d = List[Static]()
  g = H(v: ?d)
  put(!g, ?c)
  !c.push("y")
  print(g.v[0])

  e = List[Static]()
  !e.push("x")
  hold = List[H]()
  !hold.push(H(v: ?e))
  !e.push("y")
  print(hold[0].v[0])

# error: 17:3: cannot lend `a` to write while a read loan is live
# error: 23:3: cannot lend `b` to write while a read loan is live
# error: 31:3: cannot lend `c` to write while a read loan is live
# error: 38:3: cannot lend `e` to write while a read loan is live
