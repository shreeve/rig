# Only a value that copies is copied out of a view where the value is
# expected. A view of an owning value, or of a `T` that may own one, is
# not.

fun wv(a: !Vec[Int]) -> !Vec[Int]
  a

fun take(v: Vec[Int]) -> Int
  v.len

fun wr[T](a: !T) -> !T
  a

fun copy[T](a: !T) -> T
  x: T = wr(!a)
  x

sub main()
  v = Vec[Int]()
  z: Vec[Int] = wv(!v)
  print(take(wv(!v)), z.len)

