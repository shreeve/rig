# A value written through a `!T` field lands in what the field borrows,
# so a borrow it carries must outlive that place.

struct V
  r: ?Int

struct H
  w: !V

sub set(h: !H)
  c = 3
  h.w = V(r: ?c)

sub main
  a = 1
  x = V(r: ?a)
  h = H(w: !x)
  if true
    b = 2
    h.w = V(r: ?b)
  set(!h)
  print(x.r)

# error: 12:3: cannot store a view of `c` through `h`: `h` outlives it
# error: 20:17: `b` does not live long enough
