# A box is its value's one owner: it cannot be copied, and a field of
# the boxed value cannot be moved out or copied out when it owns a
# resource.

struct Res
  n: Int

  drop(!self)
    print("drop", self.n)

struct H
  r: Res

sub main()
  b = Box(H(r: Res(n: 1)))
  d = b
  s = <b.r
  t = b.r

# error: 16:7: bare use of `Box` value `b` in binding would copy the box's pointer and free its value twice; use `<b` to move ownership
# error: 17:8: cannot move out of `b.r`
# error: 18:7: bare use of `Res` value `b.r` in binding would alias an owning value
