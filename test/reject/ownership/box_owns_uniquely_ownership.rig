# A box is its value's one owner: it cannot be copied, and a field of
# the boxed value cannot be moved out or copied out when it owns a
# resource.

struct Res
  n: Int

  drop(!self)
    print("drop", self.n)

struct H
  r: Res

sub main()
  b = Box(H(r: Res(n: 1)))
  d = b
  s = <b.r
  t = b.r

# error: 16:7: `b` owns a `Box[H]`, which can't be copied by `=`: write `<b` to move it or `?b` to view it
# error: 17:8: cannot move out of `b.r`
# error: 18:7: `b.r` owns a `Res`, which can't be copied by `=`: write `?b.r` to view it
