# A read `match` never binds a payload field that is a write view (`!P`,
# `!List[T]`, `![]T`, `!String`): a write view is never stored inside a
# value, so each such payload field is rejected where it is declared.

obj P
  t: String

enum WP
  a(w: !P)
  b

enum WV
  a(w: !List[String])
  b

enum WS
  a(s: ![]String)
  b

enum WT
  a(w: !String)
  b

sub main()
  print(1)

# error: 9:8: a write view is never stored inside a value, and `!P` cannot stand here
# error: 13:8: a write view is never stored inside a value, and `!List[String]` cannot stand here
# error: 17:8: a write view is never stored inside a value, and `![]String` cannot stand here
# error: 21:8: a write view is never stored inside a value, and `!String` cannot stand here
# errors: 4
