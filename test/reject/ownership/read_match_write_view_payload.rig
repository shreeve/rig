# A read `match` binds a payload field that is a write view as the read
# view of what it views (`!P` as `?P`, `!Vec[T]` as `?Vec[T]`, `![]T` as
# `[]T`), as `if o as x` binds one: no write goes through the binding,
# whole or by a path (a field, an element, a method, a `|!w|` capture),
# whether or not a view of it is live, and two read matches cannot alias
# one write view. So for every subject: a place, a `!E` parameter, and a
# part of a value made in the header, also when that part is itself a
# write view. Each error names the match that writes: `match !e`, or,
# for a part of a value made in the header, that value bound first.

struct P
  t: Text

enum WP
  a(w: !P)
  b

enum WV
  a(w: !Vec[Text])
  b

enum WS
  a(s: ![]Text)
  b

enum WN
  a(s: ![]Vec[Int])
  b

enum WI
  a(s: ![]Int)
  b

enum WT
  a(w: !Text)
  b

sub field_assign(e: WP)
  match e
    .a(w)
      r = ?w.t[1..]
      w.t = Text("other")
      print(r)
    .b => pass

sub field_method(e: WP)
  match e
    .a(w)
      r = ?w.t[1..]
      !w.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r)
    .b => pass

sub param_subject(e: !WP)
  match e
    .a(w)
      r = ?w.t[1..]
      !w.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r)
    .b => pass

sub vec_index(e: WV)
  match e
    .a(w)
      r = ?w[0][1..]
      w[0] = Text("other")
      print(r)
    .b => pass

sub slice_index(e: WS)
  match e
    .a(s)
      r = ?s[0][1..]
      s[0] = Text("other")
      print(r)
    .b => pass

sub slice_method(e: WS)
  match e
    .a(s)
      r = ?s[0][1..]
      !s[0].add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r)
    .b => pass

sub slice_push(e: WN)
  match e
    .a(s)
      r = ?s[0][..]
      !s[0].push(2)
      print(r)
    .b => pass

sub slice_clear(e: WS)
  match e
    .a(s)
      r = ?s[0][1..]
      !s[0].clear()
      print(r)
    .b => pass

sub slice_int(e: WI)
  match e
    .a(s)
      r = ?s[0]
      s[0] = 2
      print(r)
    .b => pass

sub whole(e: WT)
  match e
    .a(w)
      !w.add("x")
    .b => pass

sub two_matches(e: WS)
  r = ""
  match e
    .a(s)
      r = ?s[0][1..]
    .b => pass
  match e
    .a(s)
      s[0] = Text("other")
    .b => pass
  print(r)

sub no_lend(e: WP)
  match e
    .a(w) => w.t = Text("other")
    .b => pass

struct H
  e: WP

struct HS
  e: WS

struct HW
  e: !WP

enum WP2
  a(w: !P, v: ?P)
  b

struct H2
  e: WP2

fun mk(p: !P) -> H from p
  H(e: WP.a(!p))

fun mks(s: ![]Text) -> HS from s
  HS(e: WS.a(!s))

fun mkw(e: !WP) -> HW from e
  HW(e: !e)

fun mk2(p: !P, q: ?P) -> H2 from p, q
  H2(e: WP2.a(w: !p, v: q))

sub held_field(p: !P)
  match mk(!p).e
    .a(w)
      r = ?w.t[1..]
      w.t = Text("other")
      print(r)
    .b => pass

sub held_method(p: !P)
  match mk(!p).e
    .a(w)
      r = ?w.t[1..]
      !w.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r)
    .b => pass

sub held_slice(v: ![]Text)
  match mks(!v).e
    .a(s)
      r = ?s[0][1..]
      s[0] = Text("other")
      print(r)
    .b => pass

sub held_whole_lend(p: !P)
  match mk(!p).e
    .a(w)
      r = ?w
      w.t = Text("other")
      print(r.t)
    .b => pass

sub held_capture(p: !P)
  match mk(!p).e
    .a(w)
      g = |!w| w.t = Text("other")
      g()
    .b => pass

sub held_write_view_part(e: !WP)
  match mkw(!e).e
    .a(w)
      r = ?w.t[1..]
      w.t = Text("other")
      print(r)
    .b => pass

sub held_named(p: !P, q: ?P)
  match mk2(!p, q).e
    .a(w: w, v: v)
      r = ?w.t[1..]
      !w.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(r, v.t)
    .b => pass

sub rewrap(e: WI)
  match e
    .a(s)
      f = WI.a(s)
      print(f)
    .b => pass

sub main()
  pass

