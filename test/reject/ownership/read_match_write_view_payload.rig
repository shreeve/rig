# A read `match` never binds a payload field that is a write view (`!P`,
# `!List[T]`, `![]T`, `!Text`): a write view is never stored inside a
# value, so each such payload field is rejected where it is declared.

struct P
  t: Text

enum WP
  a(w: !P)
  b

enum WV
  a(w: !List[Text])
  b

enum WS
  a(s: ![]Text)
  b

enum WT
  a(w: !Text)
  b

sub main()
  print(1)

# error: 9:8: a write view is never stored inside a value, and `!P` cannot stand here
# error: 13:8: a write view is never stored inside a value, and `!List[Text]` cannot stand here
# error: 17:8: a write view is never stored inside a value, and `![]Text` cannot stand here
# error: 21:8: a write view is never stored inside a value, and `!Text` cannot stand here
# errors: 4
