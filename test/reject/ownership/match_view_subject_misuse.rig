# `match <s` on a write view points at `match !s`; `match !s` through a
# read view is one error, not a cascade; a bare match's binding of a
# write view, or of the whole viewed value, only reads.

struct B
  n: Int

  drop(!self)
    print("drop", self.n)

enum Slot
  full(b: *B)
  empty

enum E
  w(p: !Int)
  none

sub take(s: !Slot)
  match <s
    .full(b) => print(b.n)
    .empty => print("e")

sub show(s: ?Slot)
  match !s
    .full(b) => b = *B(n: 3)
    .empty => print("e")

sub clear(s: !Slot)
  match s
    x => x = .empty

sub main()
  a = 1
  e: E = .w(p: !a)
  match e
    .w(p) => p = 5
    .none => print("n")
  print(a)

# error: 20:9: `match <s` consumes an owned value, and `s` is a write view (`!Slot`); write the payload in place with `match !s`, or read it with `match s`
# error: 25:10: cannot lend to write through a read view `?Slot`
# error: 31:10: cannot assign to `x`: `match s` reads `s`, and so do its bindings; to write through `x`, match with `match !s`
# error: 37:14: cannot assign to `p`: it is a read view of a field of `e`; to change the field in place, match with `match !e`
