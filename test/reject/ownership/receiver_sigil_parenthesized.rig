# Parentheses around the call make `!` apply to its value, a temporary,
# not to the receiver, which the call then needs lent to write.

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  n = !(v.pop())
  print(n ?? 0)

# error: 7:11: method `pop` needs its receiver lent to write; write `(!v).pop()`
# errors: 1
