# `swap` moves a value holding a String that views `b` into parameter
# `a`, which keeps `b` lent for the rest of the body.

obj Holder
  s: ?String

fun f(a: !Holder, b: !String) -> Int keeps b
  q = Holder(s: ?b[0..1])
  swap(!a, !q)
  for _ in 0..100
    !b.add("abcdefgh")
  print(a.s)
  0

sub main()
  t = String("zz")
  w = String("abc")
  h = Holder(s: ?t[..])
  print(f(!h, !w))

# errors: 1
# error: 11:5: cannot lend `b` to write while a read loan is live
