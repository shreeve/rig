# A local closure cannot be passed as a call argument, where the callee
# could retain it.

sub consume(f: fun() -> Int)
  print(f())

sub main()
  const n = 3
  f = |+n|
    n
  consume(f)

# error: 11:11: closure `f` cannot be moved, returned, stored, or copied; call it as `f()`, lend it to a call as `?f`, or make the literal owned (`*|...| body`) to pass it around
