# A write borrow passed on keeps its holder borrowed while the result
# is used.

struct Box
  n: Int

  sub bump(!self)
    self.n += 1

  drop self: !Box
    print("drop", self.n)

fun lend(b: !Box) -> !Box
  b

sub main()
  x = Box(n: 1)
  w = !x
  w2 = lend(<w)
  print(x.n)
  w2.bump()

# error: use of `x` while a write borrow is live
