# A write borrow passed on keeps its holder borrowed while the result
# is used.

struct Wrap
  n: Int

  sub bump(!self)
    self.n += 1

  drop(!self)
    print("drop", self.n)

fun lend(b: !Wrap) -> !Wrap
  b

sub main()
  x = Wrap(n: 1)
  w = !x
  w2 = lend(<w)
  print(x.n)
  w2.bump()

# error: use of `x` while a write borrow is live
