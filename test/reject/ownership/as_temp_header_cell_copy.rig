# `if … as` over a view a call returns, whose header makes a temporary,
# would bind a copy of a Cell holder inside the optional, and a change
# to its Cell would be lost. No optional holds a Cell holder: a value of
# one lives only behind a shared handle, so the form is rejected where
# the optional is written.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

struct H
  o: Counter?

fun geto(h: ?H, n: Int) -> ?Counter?
  ?h.o

sub main()
  h = H(o: Counter(hits: Cell(1)))
  if geto(h, Text("xyz").len) as c
    c.hit()
  print(h)

# error: 12:6: a value of `Counter` holds a Cell, so it lives only behind a shared handle
