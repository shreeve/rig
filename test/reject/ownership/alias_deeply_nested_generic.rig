# A resource nested deep inside generic wrappers still gives the whole
# value drop glue, so copying it is rejected.

struct P
  n: Int

struct Wrap[T]
  value: T

sub main()
  h: *P = *P(n: 5)
  b: Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[*P]]]]]]]]]] = Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: Wrap(value: <h))))))))))
  c = b
  print(c.value.value.value.value.value.value.value.value.value.value.n)

# error: 13:7: `b` owns a `Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[Wrap[*P]]]]]]]]]]`, which can't be copied by `=`: write `<b` to move it, `+b` to clone it, or `?b` to view it
