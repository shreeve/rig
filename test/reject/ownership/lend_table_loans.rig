# A view the lend table makes (Core §4) carries the loan of what was
# lent, whatever rows made it: a List's elements, a handle's value, an
# optional's value, a box's array, a box's box, a handle's Text, and a
# view a parameter holds. Each owner below is changed while its view
# is still used.
use std.sort

obj S
  n: Int

fun keep(xs: []Int) -> []Int
  xs

fun keep_s(s: ?S) -> ?S
  s

fun keep_o(xs: ([]Int)?) -> ([]Int)?
  xs

fun keep_t(s: ?String) -> ?String
  s

fun via(v: ?List[Int]) -> []Int
  keep(v)

sub vec_elems()
  v: List[Int] = List()
  !v.push(1)
  s = keep(?v)
  !v.push(2)
  print(s)

sub handle_view()
  h = *S(n: 3)
  r = keep_s(?h)
  <h
  print(r.n)

sub optional_view()
  v: List[Int] = List()
  o: List[Int]? = <v
  s = keep_o(?o)
  o = none
  print(s)

sub boxed_array()
  b = ^[1, 2, 3]
  s = keep(?b)
  <b
  print(s)

sub boxed_struct()
  b = ^S(n: 2)
  r = keep_s(?b)
  <b
  print(r.n)

sub handle_text()
  h = *String("hello")
  s = keep_t(?h)
  <h
  print(s)

sub held_view()
  v: List[Int] = List()
  s = via(?v)
  <v
  print(s)

sub write_elems()
  v: List[Int] = List()
  w = !v
  sort.sort(!v)
  print(w.len)

sub main()
  vec_elems()

# error: 30:3: cannot lend `v` to write while a read loan is live
# error: 36:4: cannot drop `h` while it is lent
# error: 43:3: cannot reassign `o` while it is lent
# error: 49:4: cannot drop `b` while it is lent
# error: 55:4: cannot drop `b` while it is lent
# error: 61:4: cannot drop `h` while it is lent
# error: 67:4: cannot drop `v` while it is lent
# error: 73:13: cannot lend `v` to write while a write loan is live
# errors: 8
