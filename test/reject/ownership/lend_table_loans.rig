# A view the lend table makes (Core §4) carries the loan of what was
# lent, whatever rows made it: a Vec's elements, a handle's value, an
# optional's value, a box's array, a box's box, a handle's Text, and a
# view a parameter holds. Each owner below is changed while its view
# is still used.
use std.sort

struct S
  n: Int

fun keep(xs: []Int) -> []Int
  xs

fun keep_s(s: ?S) -> ?S
  s

fun keep_o(xs: ([]Int)?) -> ([]Int)?
  xs

fun keep_t(s: String) -> String
  s

fun via(v: ?Vec[Int]) -> []Int
  keep(v)

sub vec_elems()
  v: Vec[Int] = Vec()
  !v.push(1)
  s = keep(?v)
  !v.push(2)
  print(s)

sub handle_view()
  h = *S(n: 3)
  r = keep_s(?h)
  -h
  print(r.n)

sub optional_view()
  v: Vec[Int] = Vec()
  o: Vec[Int]? = <v
  s = keep_o(?o)
  o = none
  print(s)

sub boxed_array()
  b = Box([1, 2, 3])
  s = keep(?b)
  -b
  print(s)

sub boxed_box()
  b = Box(Box(S(n: 2)))
  r = keep_s(?b)
  -b
  print(r.n)

sub handle_text()
  h = *Text("hello")
  s = keep_t(?h)
  -h
  print(s)

sub held_view()
  v: Vec[Int] = Vec()
  s = via(?v)
  -v
  print(s)

sub write_elems()
  v: Vec[Int] = Vec()
  w = !v
  sort.sort(!v)
  print(w.len)

sub main()
  vec_elems()

# error: 30:3: cannot write-borrow `v` while a read borrow is live
# error: 36:4: cannot drop `h` while borrows are live
# error: 43:3: cannot reassign `o` while borrows are live
# error: 49:4: cannot drop `b` while borrows are live
# error: 55:4: cannot drop `b` while borrows are live
# error: 61:4: cannot drop `h` while borrows are live
# error: 67:4: cannot drop `v` while borrows are live
# error: 73:13: cannot take a second write borrow on `v`
# errors: 8
