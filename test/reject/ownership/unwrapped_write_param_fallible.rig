# A store through a fallible write view, `must(<w)!` or
# `must(<w) catch return`, made from a `(!H)?` parameter, lands in the
# caller's value, as through a `!H` parameter.

obj H
  s: ?String

  sub keep(!self, v: ?String)
    self.s = v

error E
  bad

fun must(w: (!H)?) -> (!H)!
  <w ?? return E.bad

fun bang(w: (!H)?) -> Int!
  d = String("local")
  must(<w)!.s = ?d
  0

sub caught(w: (!H)?)
  d = String("local")
  (must(<w) catch return).s = ?d

sub main()
  t = String("outer")
  h = H(s: ?t)
  print(bang(!h) catch 1)
  caught(!h)
  print(h.s)

# errors: 2
# error: a view of `d`
# error: a view of `d`
