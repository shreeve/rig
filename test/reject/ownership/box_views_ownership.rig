# Views reach a boxed value through the box: its owner cannot be
# reassigned or dropped while one is live.

obj Node
  key: Int
  left: ^Node?

fun first(n: ?^Node) -> ?Node
  ?n

sub main()
  root: ^Node? = ^Node(key: 1, left: none)
  if !root as n
    root = none
    print(n.key)
  a = ^Node(key: 1, left: none)
  f = first(?a)
  a = ^Node(key: 2, left: none)
  print(f.key)
  r = ?a
  <a
  print(r.key)

# error: 14:5: cannot reassign `root` while it is lent
# error: 18:3: cannot reassign `a` while it is lent
# error: 21:4: cannot drop `a` while it is lent
