# Pointing a fixed (`=!`) handle elsewhere would free a box another view reads.
# (A handle is lent as itself, `!*T`, only where it may be written; the
# review probe of that name.)

sub k(a: ?Cell[List[Int]], b: !*Cell[List[Int]])
  b = *Cell(List[Int]())
  print(a.len)

sub main()
  c: *Cell[List[Int]] =! *Cell(List())
  !c.push(1)
  k(c, !c)

