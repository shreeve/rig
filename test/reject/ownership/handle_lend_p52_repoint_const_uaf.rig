# Pointing a `const` handle elsewhere would free a box another view reads.
# (A handle is lent as itself, `!*T`, only where it may be written; the
# review probe of that name.)

sub k(a: ?Cell[Vec[Int]], b: !*Cell[Vec[Int]])
  b = *Cell(Vec[Int]())
  print(a.len)

sub main()
  const c: *Cell[Vec[Int]] = *Cell(Vec())
  !c.push(1)
  k(c, !c)

