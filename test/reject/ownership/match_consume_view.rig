# `match <e` consumes an owned value: a view owns no fields to hand
# over, and a box is matched through a view of it.

enum Shape
  circle(r: Int)
  square(s: Int)

sub show(s: ?Shape)
  match <s
    .circle(r) => print(r)
    .square(q) => print(q)

sub main
  c: Shape = .circle(r: 1)
  show(?c)
  b = Box(Shape.square(s: 2))
  match <b
    .circle(r) => print(r)
    .square(q) => print(q)

# error: 9:9: `match <s` consumes an owned value, and `s` is a view (`?Shape`); match what it views with `match s`
# error: 17:9: a `match` reaches the value inside a box by lending the box: `match ?b` or `match !b`; to take the value out, bind it first: `v = <b.unbox()`
