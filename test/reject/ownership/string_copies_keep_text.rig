# A String copied out of a List or a slice of one views the Text it
# views, not the List: dropping the List is fine, changing the Text is not,
# and the Text must outlive the copy.

fun first[T](xs: ?List[T]) -> T
  xs[0]

sub main()
  v: List[?String] = List()
  t = String("scoped text here")
  !v.push(?t[..])
  s = first(?v)
  <v
  !t.add("more")
  print(s)
  o: ?String = "x"
  if true
    u = String("abcdefghijklmnop")
    w: List[?String] = List()
    !w.push(?u[..])
    sl = ?w[..]
    o = sl[0]
  print(o)

# error: 14:3: cannot lend `t` to write while a read loan is live
# error: 20:14: `u` does not live long enough
# errors: 2
