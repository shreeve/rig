# A branching value in a `match` header is taken leaf by leaf, as a
# binding takes it (Core §3, §5). A type holding a `Cell` is unique
# (Core §1), so a bare leaf of one (a field of a value behind `*`) would
# be copied, forking its Cell: it is rejected, as for a declared unique
# type (test/reject/ownership/header_branch_moves_unique.rig).
#
# oracle: matches reject C2
struct Counter
  hits: Cell[Int]

enum E
  a(c: Counter)
  b

struct P
  x: E
  y: E

sub matches(f: Bool)
  p = *P(x: E.a(c: Counter(hits: Cell(3))), y: E.b)
  match (p.x if f else p.y)
    .a(c) => print(c.hits.get())
    .b => pass

sub main()
  matches(true)

# error: 21:10: a `match` reads a place or takes a call's result; bind this `E` to a name first
# errors: 1
