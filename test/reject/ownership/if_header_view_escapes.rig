# The temporaries of an `if` header live through the `if`, and no
# longer: a view of one the body leaves in a binding, a List, or through
# a view outlives them.

use std.text

obj N
  v: List[Int]

fun mk() -> N
  v: List[Int] = List()
  !v.push(1)
  N(v: <v)

fun idp(n: ?N) -> (?List[Int])?
  ?n.v

sub main()
  o: ?String = "init"
  if text.strip_prefix(?String("pre-fix"), "pre-") as rest
    o = rest
  v: List[?String] = List()
  if text.cut(?String("q,r"), ",") as kv
    !v.push(kv.before)
  if text.cut(?String("s,t"), ",") as kv and kv.before.len > 0
    o = kv.after
  keep: List[Int] = List()
  p = ?keep
  if idp(?mk()) as r
    p = r
  if false
    print("x")
  else if text.cut(?String("u,w"), ",") as kv
    o = kv.before
  print(o, v, p)

# error: 20:25: a view of the temporary `String("pre-fix")` outlives its statement
# error: 23:16: a view of the temporary `String("q,r")` outlives its statement
# error: 25:16: a view of the temporary `String("s,t")` outlives its statement
# error: 29:11: a view of the temporary `mk()` outlives its statement
# error: 33:21: a view of the temporary `String("u,w")` outlives its statement
