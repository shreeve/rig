# An enum whose payload holds a shared handle owns it; copying the enum
# would drop the handle twice.

struct Wrap
  n: Int

enum Slot
  full(b: *Wrap)
  empty

sub main()
  rc = *Wrap(n: 5)
  s: Slot = .full(b: <rc)
  t = s
  match t
    .full(b) => print(b.n)
    .empty => print(0)

# error: 14:7: bare use of `Slot` value `s` in binding would alias an owning value; `Slot` carries drop glue (resource fields or a user `drop` declaration), so two bindings would each run the destructor. Use `<s` to move ownership
