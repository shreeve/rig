# An enum whose payload holds a shared handle owns it; copying the enum
# would drop the handle twice.

struct Wrap
  n: Int

enum Slot
  full(b: *Wrap)
  empty

sub main()
  rc = *Wrap(n: 5)
  s: Slot = .full(b: <rc)
  t = s
  match t
    .full(b) => print(b.n)
    .empty => print(0)

# error: 14:7: `s` owns a `Slot`, which can't be copied by `=`: write `<s` to move it, `+s` to clone it, or `?s` to view it
