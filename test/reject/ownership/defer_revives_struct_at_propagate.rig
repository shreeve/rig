# The defers run at `e!` only on the path that fails. On the path that
# goes on, the defer has not run, so its reassignment does not revive
# the moved `x`.
error E
  bad

struct R
  n: Int
  drop(!self)
    print("drop", self.n)

sub eat(r: R)
  print("eat", r.n)

fun maybe(ok: Bool) -> Int!
  return E.bad if not ok
  1

fun f(ok: Bool) -> Int!
  x = R(n: 1)
  defer x = R(n: 9)
  eat(<x)
  k = maybe(ok)!
  print(x.n)
  k

sub main
  print(f(true) catch 0)

# error: 24:9: use of `x` after move
# errors: 1
