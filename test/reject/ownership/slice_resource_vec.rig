# A slice of a Vec is a view of plain data: a Vec of handles is not
# sliced, since a slice would copy the handles out.

struct N
  v: Int

sub main()
  v = Vec[*N]()
  (!v).push(*N(v: 1))
  r = ?v[0..1]
  w = !v[0..1]
  print(r.len, w.len)

# error: 10:8: cannot slice a `Vec[*N]`: a slice would copy owning handles out of the Vec; iterate with `for x in v` or `for x in !v` instead
# error: 11:8: cannot slice a `Vec[*N]`
