# No write view is held in a field of a binding that cannot lend it (a
# plain parameter, a fixed binding, a read view): a write view is never
# stored inside a value, so the field is rejected where it is declared.

struct H
  w: !Int

sub main()
  n = 1
  print(n)

# error: 6:6: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
