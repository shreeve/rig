# A call whose place argument (a write borrow, or a receiver) is taken
# before its later arguments run: a later argument cannot write-borrow
# the place's root, as Rust's two-phase borrows also forbid.

struct B
  xs: Vec[Int]

fun grow(v: !Vec[Int]) -> Int
  for i in 0..100
    !v.push(i)
  5

fun pair(v: !Vec[Int]) -> [2]Int
  !v.push(0)
  [5, 6]

fun renew(b: !B) -> Vec[Int]
  b.xs = Vec()
  Vec()

sub main
  v: Vec[Int] = Vec()
  !v.push(7)
  !v.push(8)
  old = replace(!v[0], grow(!v))
  !v.push(grow(!v))
  !v[..].fill(grow(!v))
  !v[..2].copy(pair(!v))
  b = B(xs: Vec())
  xs = replace(!b.xs, renew(!b))
  print(old, v, xs)

# error: 25:30: cannot take a second write borrow on `v`
# error: 26:17: cannot write-borrow `v` while a read borrow is live
# error: 27:21: cannot write-borrow `v` while a read borrow is live
# error: 28:22: cannot write-borrow `v` while a read borrow is live
# error: 30:30: cannot take a second write borrow on `b`
# errors: 5
