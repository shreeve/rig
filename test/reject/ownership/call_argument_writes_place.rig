# A call whose place argument (a write view, or a receiver) is taken
# before its later arguments run: a later argument cannot lend to write
# the place's root, as Rust's two-phase views also forbid.

obj B
  xs: List[Int]

fun grow(v: !List[Int]) -> Int
  for i in 0..100
    !v.push(i)
  5

fun pair(v: !List[Int]) -> [2]Int
  !v.push(0)
  [5, 6]

fun renew(b: !B) -> List[Int]
  b.xs = List()
  List()

sub main()
  v: List[Int] = List()
  !v.push(7)
  !v.push(8)
  old = replace(!v[0], grow(!v))
  !v.push(grow(!v))
  !v[..].fill(grow(!v))
  !v[..2].copy(pair(!v))
  b = B(xs: List())
  xs = replace(!b.xs, renew(!b))
  print(old, v, xs)

# error: 25:30: cannot lend `v` to write while a write loan is live
# error: 26:17: cannot lend `v` to write while a read loan is live
# error: 27:21: cannot lend `v` to write while a read loan is live
# error: 28:22: cannot lend `v` to write while a read loan is live
# error: 30:30: cannot lend `b` to write while a write loan on `b.xs` is live
# errors: 5
