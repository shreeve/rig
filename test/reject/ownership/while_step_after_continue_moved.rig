# A `continue` in the body goes on to the step, so the step sees what
# the `continue` path moved, also when the step reads the condition's
# binding and runs in its scope.
#
# oracle: main reject C1

obj S
  s: []Int

fun mk(v: ?List[Int]) -> S?
  if v.len < 40
    return S(s: ?v[..])
  none

fun take(a: List[Int]) -> Int
  a.len

sub main()
  v: List[Int] = List()
  !v.push(1)
  a: List[Int] = List()
  k = 0
  i = 0
  while mk(?v) as h: k += h.s[0] + a.len
    a = List()
    i += 1
    if i == 2
      k += take(<a)
      continue
    break if i > 3
  print(k, v.len)

# error: 24:36: use of `a` after move
# errors: 1
