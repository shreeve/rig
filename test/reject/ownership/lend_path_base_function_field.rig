# error: 38:8: `(<(?w.ts[1])).f`: write a lend on the whole path, not its base: `u = w.ts[1].f(5) + 1`
# error: 39:13: `(<(!w.t)).f`: write a lend on the whole path, not its base: `v: Int = w.t.f(5)`
