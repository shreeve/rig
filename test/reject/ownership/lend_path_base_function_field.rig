# A field holding a function, called, is a path like any field: a lend
# of a place as its base is rejected, through a lend, a moved lend, a
# shared handle, an element, and an owned closure's field, wherever the
# call's value goes. A method's receiver is not a path.

fun double(n: Int) -> Int
  n * 2

fun yes(n: Int) -> Bool
  n > 0

struct T
  f: fun(Int) -> Int
  g: fun(Int) -> Bool
  ops: [2]fun(Int) -> Int

struct W
  t: T
  ts: [2]T

struct C
  cb: *fun(Int) -> Int

fun mk() -> T
  T(f: double, g: yes, ops: [double, double])

sub main()
  t = mk()
  w = W(t: mk(), ts: [mk(), mk()])
  c = C(cb: *|k: Int| k + 1)
  h = *mk()
  arr = [0, 0, 0, 0, 0, 0, 0, 0, 0]
  print((!t).f(1), (?t).f(1))
  y = (<(?t)).f(3)
  z = (<(!t)).f(1) + 1
  if (<(!t)).g(1)
    print(y, z)
  u = (<(?w.ts[1])).f(5) + 1
  v: Int = (<(!w.t)).f(5)
  print(u, v, (?c).cb(1), (!c).cb(2), (?h).f(1), (?w.ts[0]).f(2))
  arr[(<(?t)).f(4)] = 1
  print((!t).ops[1](5), arr)

