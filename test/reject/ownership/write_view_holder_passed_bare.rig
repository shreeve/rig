# No value holds a write view to be passed bare to a call or placed bare
# in a constructor: a write view is never stored inside a value, so the
# field is rejected where it is declared.

struct Wrap
  v: Vec[Int]

struct Ed
  t: !Wrap

sub main()
  x = Wrap(v: Vec())
  print(x.v.len)

# error: 9:6: a write view is never stored inside a value, and `!Wrap` cannot stand here
# errors: 1
