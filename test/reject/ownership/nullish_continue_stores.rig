# `?? continue` leaves the body's scope: a loan on a body local stored
# in an outer value cannot survive it.
struct H
  r: ?Vec[Int]

fun opt(n: Int) -> Int?
  none

sub main()
  z: Vec[Int] = Vec()
  h = H(r: ?z)
  i = 0
  while i < 2 : i += 1
    inner: Vec[Int] = Vec()
    !inner.push(9)
    h.r = ?inner
    k = opt(i) ?? continue
    print(k)
  print(h.r[0])

# error: 16:12: `inner` does not live long enough
# errors: 1
