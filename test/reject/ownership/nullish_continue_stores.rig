# `?? continue` leaves the body's scope: a loan on a body local stored
# in an outer value cannot survive it.
obj H
  r: ?List[Int]

fun opt(n: Int) -> Int?
  none

sub main()
  z: List[Int] = List()
  h = H(r: ?z)
  i = 0
  while i < 2 : i += 1
    inner: List[Int] = List()
    !inner.push(9)
    h.r = ?inner
    k = opt(i) ?? continue
    print(k)
  print(h.r[0])

# error: 16:12: `inner` does not live long enough
# errors: 1
