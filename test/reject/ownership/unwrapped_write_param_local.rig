# A local holding the write view a `(!H)?` parameter holds, unwrapped
# or not, or lent on from it, stores in the caller's value.

obj H
  s: ?String

  sub keep(!self, v: ?String) keeps v
    self.s = v

sub unwrapped(w: (!H)?)
  d = String("local")
  x = <w ?? return
  x.s = ?d

sub whole(w: (!H)?)
  d = String("local")
  x = <w ?? return
  x = H(s: ?d)

sub optional(w: (!H)?)
  d = String("local")
  x = <w
  (x ?? return).s = ?d

sub optional_header(w: (!H)?)
  d = String("local")
  x = <w
  if <x as y
    y.s = ?d

sub lent_on(w: (!H)?)
  d = String("local")
  x = <w ?? return
  y = !x
  y.s = ?d

sub main()
  t = String("outer")
  h = H(s: ?t)
  unwrapped(!h)
  whole(!h)
  optional(!h)
  optional_header(!h)
  lent_on(!h)
  print(h.s)

# errors: 5
# error: 13:3: cannot store a view of `d` in `x.s`: `x` outlives it
# error: 18:3: cannot store a view of `d` through `x`: what `x` views outlives it
# error: 23:3: cannot store a view of `d` through `x ?? return`: `w` outlives it
# error: 29:5: cannot store a view of `d` in `y.s`: `y` outlives it
# error: 35:3: cannot store a view of `d` through `y`: `w` outlives it
