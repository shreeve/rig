# A closure binding cannot be aliased (`g = f`): copying the closure
# would duplicate its captures.

sub main()
  const n = 5
  f = |+n|
    n + 1
  g = f
  g()

# error: closure `f` cannot be moved, returned, stored, or copied; call it as `f()`, lend it to a call as `?f`, or make the literal owned (`*|...| body`) to pass it around
