# A view of a String is read as the String it reaches, so storing one
# in a Cell or Signal stores that view: rejected when it views a Text or
# may (a parameter), and accepted for a literal.

sub stash(c: !Cell[String], s: ?String)
  !c.set(s)

sub main()
  t = Text("abcdefghijklmnop")
  s = ?t[..]
  c: *Cell[String] = *Cell("x")
  !c.set(?s)
  d = *Cell(?s)
  sig: *Signal[String] = *Signal("x")
  !sig.set(?s)
  old = (!c).replace(?s)
  cv: *Cell[Vec[String]] = *Cell(Vec())
  !cv.push(?s)
  f = |?s| s
  !c.set(f())
  lit = "free"
  !c.set(?lit)
  print(c.get(), d.get(), sig.get(), old, cv.len)

