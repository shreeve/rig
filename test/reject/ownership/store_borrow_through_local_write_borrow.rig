# Assigning through a local write borrow stores the value in the place
# it borrows, which outlives a borrow of a later local.

struct In
  n: Int

struct View
  b: ?In

sub main
  a = In(n: 1)
  v = View(b: ?a)
  w = !v
  if true
    y = In(n: 2)
    w = View(b: ?y)
  print(v.b.n)

# error: 16:18: `y` does not live long enough
