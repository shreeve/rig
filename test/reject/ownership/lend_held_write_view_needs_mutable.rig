# A write view is never held in a field, so no lend of one (`!h.w`)
# writes through what holds it: the field is rejected where it is
# declared.

struct H
  w: !Int

sub poke(w: !Int)
  w += 1

sub main()
  n = 1
  poke(!n)

# error: 6:6: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
