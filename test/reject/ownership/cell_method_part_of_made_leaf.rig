# A `?self` method may change a Cell of the value it is called on, which
# needs a place. A part of a value that branches reaches a name's leaf
# where it is, but a leaf made there that no statement slot keeps (it
# needs no cleanup) has no place, as `Cell.set` on the same part has
# none: the call is rejected for every branching form.

error E
  bad

struct N
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

struct W
  t: N

fun mk(n: Int) -> W
  W(t: N(c: Cell(n)))

fun mkf(n: Int) -> W!
  return E.bad if n < 0
  mk(n)

fun mko(n: Int) -> W?
  return none if n < 0
  mk(n)

sub go(k: Bool)!
  w = mk(1)
  o: W? = mk(2)
  (w if k else mk(5)).t.hit()
  (w if k else mkf(5)!).t.hit()
  (o ?? mk(5)).t.hit()
  (mko(5) ?? w).t.hit()
  (w if k else (mk(5) if k else mk(6))).t.hit()
  (w if k else mk(5)).t.c.set(3)
  (w if k else o ?? w).t.hit()

sub main()
  go(true) catch print("failed")

# error: 33:3: cannot call `hit` on a part of `w if k else mk(5)`, which may be the temporary `mk(5)`
# error: 34:3: cannot call `hit` on a part of `w if k else mkf(5)!`, which may be the temporary `mkf(5)!`
# error: 35:3: cannot call `hit` on a part of `o ?? mk(5)`, which may be the temporary `mk(5)`
# error: 36:3: cannot call `hit` on a part of `mko(5) ?? w`, which may be the temporary `mko(5)`
# error: 37:3: cannot call `hit` on a part of `w if k else (mk(5) if k else mk(6))`, which may be the temporary `mk(5) if k else mk(6)`
# error: 38:27: `Cell.set` needs a Cell that has a place
# errors: 6
