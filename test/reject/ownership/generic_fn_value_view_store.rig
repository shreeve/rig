# A generic function's `T` may hold a view of its `?String` argument, so its result keeps that argument lent.
obj K
  s: ?String

sub put(k: !K, s: ?String) keeps s
  k.s = s

sub run[T](f: sub(!T, ?String), k: !T, s: ?String) keeps s
  f(!k, s)

sub main()
  k = K(s: "x")
  t = String("abc")
  run(put, !k, ?t)
  <t
  print(k.s)

# error: cannot drop `t` while it is lent
