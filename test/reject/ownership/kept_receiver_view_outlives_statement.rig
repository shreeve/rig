# A temporary receiver of a method that may keep a view of it, or a
# Cell-holding part of one, is kept in its statement's slot, also when
# the call's arguments run first: a view of it that the method returns,
# or stores in what it was lent to write, may be used within the
# statement (`test/behavior/ownership/cell_part_receiver_view_in_statement.rig`),
# and nowhere after.

struct S
  n: Int
  m: Int

  fun me(?self) -> ?S
    self

struct Q
  c: Cell[Int]
  n: Int

  fun me(?self) -> ?Q
    self

  fun put(?self, h: !Holder) -> Int
    h.r = self
    self.n

struct Holder
  r: (?Q)?

struct H
  q: Q

fun mk() -> S
  S(n: 5, m: 6)

fun mkh() -> *H
  *H(q: Q(c: Cell(1), n: 42))

sub main()
  r = mk().me()
  print(r.n)
  h = Holder(r: none)
  print(mkh().q.put(!h))
  if h.r as q
    print(q.n)

# errors: 2
# error: 39:7: a view of the temporary `mk()` outlives its statement, which drops it; bind the value to a name first
# error: 42:9: a view of the temporary `mkh()` outlives its statement
