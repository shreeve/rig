# A `match` takes a call's result, as `match <e` would: a payload an
# arm binds is dropped when the arm ends, so a view of it cannot
# outlive the arm.

enum M
  a(t: Text)
  b

fun mk -> M
  M.a(t: Text("in m"))

sub main
  o = "x"
  match mk()
    .a(t) => o = ?t[..]
    .b => print("b")
  print(o)

# error: 15:19: `t` does not live long enough
# errors: 1
