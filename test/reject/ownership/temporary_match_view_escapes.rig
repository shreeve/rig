# A view of a `match` subject that is a temporary cannot outlive the
# statement, which drops the subject.

enum M
  a(t: Text)
  b

fun mk -> M
  M.a(t: Text("in m"))

sub main
  o = "x"
  match mk()
    .a(t) => o = ?t[..]
    .b => print("b")
  print(o)

# error: 14:8: a borrow of the temporary `mk()` outlives its statement
# errors: 1
