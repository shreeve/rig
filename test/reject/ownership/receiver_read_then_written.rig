# A read receiver that is no place is copied where it runs, before the
# arguments: a later argument cannot lend what it may be to write, or
# the call would read the copy after its buffer was freed.

struct P
  v: Vec[Int]

  fun peek(?self, other: !P) -> Int
    for i in 0..100
      !other.v.push(i)
    self.v[0]

fun mk(k: Int) -> P
  v: Vec[Int] = Vec()
  !v.push(k)
  P(v: <v)

sub main()
  a = mk(1)
  b = mk(2)
  c = true
  print((a if c else b).peek(!a))

# error: 22:31: cannot lend `a` to write while the receiver's read of it is in use
# errors: 1
