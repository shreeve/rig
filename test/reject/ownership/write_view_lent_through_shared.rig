# No shared handle's value holds a write view that other handles could
# reach: a write view is never stored inside a value, so the field is
# rejected where it is declared.

struct Wrap
  v: Vec[Int]

struct WV
  b: !Wrap

sub main()
  x = Wrap(v: Vec())
  print(x.v.len)

# error: 9:6: a write view is never stored inside a value, and `!Wrap` cannot stand here
# errors: 1
