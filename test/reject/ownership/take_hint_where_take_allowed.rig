# The copy rejection offers `<p.o`, which takes an optional field out
# and leaves `none`, only where the take itself is accepted: not through
# a read view or a shared handle, nor out of a parameter, which is fixed.

struct Bag
  items: Vec[Int]

struct H
  o: Bag?

sub viaread(p: ?H)
  x = p.o
  print(x == none)

sub viashared(rc: *H)
  x = rc.o
  print(x == none)

sub viaparam(h: H)
  x = h.o
  print(x == none)

sub local()
  h = H(o: none)
  x = h.o
  print(x == none)

sub viawrite(p: !H)
  x = p.o
  print(x == none)

sub main()
  local()

# error: 12:7: `p.o` owns a `Bag?`, which can't be copied by `=`: write `+p.o` to clone it or `?p.o` to view it
