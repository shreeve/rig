# An array cannot hold write views (`[2]!Int`, `[1]!H`): a write view is
# never stored inside a value, so no loop walks elements that are write
# views.

struct H
  n: Int

sub main()
  n = 1
  m = 2
  xs = [!n, !m]
  a = H(n: 1)
  hs = [!a]
  print(xs.len, hs.len)

# error: 11:8: a write view is never stored inside a value, and `!Int` cannot stand here
# error: 13:8: a write view is never stored inside a value, and `!H` cannot stand here
# errors: 2
