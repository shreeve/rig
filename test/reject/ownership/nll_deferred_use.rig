# Deferred code runs at scope exit: a view it uses is live until
# then.

struct Wrap
  n: Int

  sub bump(!self)
    self.n += 1

  drop(!self)
    print("drop", self.n)

sub main()
  x = Wrap(n: 1)
  r = ?x
  defer print(r.n)
  !x.bump()

# error: cannot lend `x` to write while a read loan is live
