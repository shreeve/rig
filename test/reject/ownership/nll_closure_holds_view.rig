# A closure that captured a view holds it for as long as the closure
# lives.

struct Wrap
  n: Int

  sub bump(!self)
    self.n += 1

  drop(!self)
    print("drop", self.n)

sub main()
  x = Wrap(n: 1)
  r = ?x
  f = |<r| print(r.n)
  !x.bump()
  f()

# error: cannot lend `x` to write while a read loan is live
