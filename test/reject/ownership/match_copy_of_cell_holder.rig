# A match that reads a part of a made value binds a copy of each
# payload: a change through the copy, by a `?self` method or `set`,
# would not reach the payload, so it is rejected.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

enum E
  a(c: Counter)
  b

struct H
  e: E

fun mkh() -> H
  H(e: E.a(c: Counter(hits: Cell(0))))

sub main()
  match H(e: E.a(c: Counter(hits: Cell(0)))).e
    .a(c) => c.hit()
    .b => pass
  match mkh().e
    .a(c) => c.hit()
    .b => pass
  match [E.a(c: Counter(hits: Cell(0))), E.b][0]
    .a(c) => c.hit()
    .b => pass
  match H(e: E.a(c: Counter(hits: Cell(0)))).e
    .a(c) => c.hits.set(2)
    .b => pass

# error: 23:14: cannot call `hit` here: the value holds a Cell the method may change, and `c` is a loop or match binding, a copy
# error: 26:14: cannot call `hit` here
# error: 29:14: cannot call `hit` here
# error: 32:21: `Cell.set` needs a Cell that has a place
