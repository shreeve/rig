# A view stored through a write view in a loop lands in what it
# views, and a copy made on the next iteration keeps the Text viewed.

obj Holder
  s: ?String

sub main()
  t = String("scoped text here")
  h = Holder(s: "lit")
  o: ?String = "x"
  i = 0
  while i < 2
    w = !h
    o = w.s
    w.s = ?t[..]
    i += 1
  <t
  print(o)

# error: 17:4: cannot drop `t` while it is lent
# errors: 1
