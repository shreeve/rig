# `m?` hands over the handle inside `m`: an owning binding is moved,
# `(<m)?`.

struct Wrap
  n: Int

fun f(m: *Wrap?) -> Int?
  b = m?
  b.n

sub main()
  print(f(none))

# error: 8:7: `m` is a `*Wrap?` handle, which can't be copied by `=`: write `<m` to move it, `+m` for another handle, or `?m` to view it
