# A borrow returned through an if-expression must come from a borrowed
# parameter on every branch.

struct Wrap
  payload: Int

fun pick(a: ?Wrap, c: Bool) -> ?Wrap
  b = Wrap(payload: 1)
  if c
    ?b
  else
    a

sub main()
  print(1)

# error: returned borrow of `b` does not originate from a borrowed parameter
