# Testing `o ?? d` against a bare variant would drop the value `o` or `d`
# holds.
enum Shape
  dot
  line(v: Vec[Int])

sub main
  p: Vec[Int] = Vec()
  !p.push(1)
  o: Shape? = none
  d = Shape.line(<p)
  if (o ?? d) != .dot
    print("line")
  match ?d
    .line(v) => print(v[0])
    .dot => print("dot")

# error: 12:7: cannot test `o ?? d` against `.dot`: it may be `o`, a value a name holds, and the test drops the value it tests
# errors: 1
