# `for x in !xs` needs a place it may write.

fun make() -> Vec[Int]
  Vec()

sub read_only(xs: ?Vec[Int])
  for x in !xs
    x += 1

sub main()
  for c in !"abc"
    print(c)
  for y in !make()
    y = 1

