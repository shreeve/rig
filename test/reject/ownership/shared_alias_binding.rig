# `rc2 = rc` on a shared handle is rejected: it would alias the handle
# without a refcount bump. Use `<rc` or `+rc`.

struct Wrap
  value: Int

sub main()
  rc = *Wrap(value: 1)
  rc2 = rc
  <rc2
  <rc

# error: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it
