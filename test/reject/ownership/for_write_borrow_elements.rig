# An element that is itself a write borrow (`[2]!Int`) is written
# through by index, `xs[i] += 1`: a loop binding would be a borrow of
# the borrow. A loop still walks elements that hold write borrows in
# their fields with `for x in !xs`.

struct H
  n: Int

sub main
  n = 1
  m = 2
  xs = [!n, !m]
  for x in !xs
    x += 5
  for x in xs
    print(x)
  a = H(n: 1)
  hs = [!a]
  for h in !hs
    h.n += 5

# error: 13:13: each element of `xs` is a write view, which a loop binding cannot hold; loop over the indices and write `xs[i]`
# error: 15:12: each element of `xs` is a write view, which a loop binding cannot hold; loop over the indices and write `xs[i]`
# error: 19:13: each element of `hs` is a write view, which a loop binding cannot hold; loop over the indices and write `hs[i]`
# errors: 3
