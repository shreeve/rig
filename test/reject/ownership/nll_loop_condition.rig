# A loop condition runs again after the body: a view it uses is live
# throughout the loop.

obj Wrap
  n: Int

  sub bump(!self)
    self.n += 1

  drop(!self)
    print("drop", self.n)

sub main()
  v: List[Int] = List()
  r = ?v
  while r.len < 3
    !v.push(1)

# error: cannot lend `v` to write while a read loan is live
