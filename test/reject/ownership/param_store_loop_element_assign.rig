# Assigning a `for k in !a` element writes into parameter `a`'s
# elements, which keeps `b` lent for the rest of the body.

struct Holder
  r: []Int

fun f(a: ![]Holder, b: !Vec[Int]) -> Int
  for k in !a
    k = Holder(r: ?b[..])
  for i in 0..100
    !b.push(i)
  a[0].r[0]

sub main()
  x = [9, 9]
  v: Vec[Int] = Vec()
  !v.push(1)
  hs = [Holder(r: ?x[..])]
  print(f(!hs, !v))

# errors: 1
# error: 11:5: cannot lend `b` to write while a read loan is live
