# The hint for a read match's payload view kept past its arm names only
# forms that compile: a copy (`+t`) of a payload that has one, and a take
# (`match <e`, then `<t`) of a subject that is an owner's name. A view
# subject, `?e` of a `?E` parameter, cannot be taken, and a `unique`
# payload has no copy. Both forms run:
# `test/behavior/ownership/match_payload_owner_kept.rig`.

enum E
  a(t: Text)
  b

struct Key unique
  n: Int

enum K
  k(key: Key)
  none

fun pick(e: ?E) -> String
  match ?e
    .a(t) => return ?t
    .b => return "b"

fun first(o: ?K, d: ?Key) -> ?Key
  match o
    .k(kk) => ?kk
    .none => d

sub main()
  e = E.a(t: Text("abc"))
  r: String = "x"
  match e
    .a(t) => r = ?t
    .b => pass
  print(r, pick(?e))
  o = K.k(key: Key(n: 1))
  d = Key(n: 0)
  print(first(?o, ?d).n)

# error: 21:8: a view of `t` does not outlive the `match` that reads `?e`: use it in the arm, or keep an owner of what it holds: copy it with `+t`
# error: 26:8: a view of `kk` does not outlive the `match` that reads `o`: use it in the arm
# error: 33:8: a view of `t` does not outlive the `match` that reads `e`: use it in the arm, or keep an owner of what it holds: copy it with `+t`, or take the subject with `match <e` and move it with `<t`
# errors: 3
