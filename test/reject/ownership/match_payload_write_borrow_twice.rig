# A `match !h` payload write-borrows its scrutinee while it is live, so
# a nested match on the same value cannot bind a second view of it. (A
# read match views a payload holding a write borrow, `?Ed`, which only
# reads.)

struct Wrap
  v: Vec[Int]

struct Ed
  t: !Wrap

enum Hold
  none_
  has(e: Ed)

sub main()
  x = Wrap(v: Vec())
  !x.v.push(1)
  h: Hold = .has(Ed(t: !x))
  match !h
    .has(a)
      for n in ?a.t.v
        match !h
          .has(b)
            b.t.v = Vec()
          .none_
            print("n")
        print(n)
    .none_
      print("none")

# error: 23:16: cannot lend `h` to write while a write loan is live
