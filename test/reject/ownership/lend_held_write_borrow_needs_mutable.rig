# Lending a write borrow held in a field (`!h.w`) writes through it, as
# `h.w += 1` does, so it needs write access to what holds it: a plain
# parameter and a fixed binding do not give it, and a temporary would
# be gone after the statement.

struct H
  w: !Int

sub poke(w: !Int)
  w += 1

fun mk(w: !Int) -> H
  H(w: <w)

sub by_value(h: H)
  poke(!h.w)
  h.w += 1

sub main
  n = 1
  const h = H(w: !n)
  poke(!h.w)
  poke(!mk(!n).w)

# error: 16:9: cannot write-borrow parameter `h`; parameters are immutable
# error: 17:3: cannot assign to parameter `h`; parameters are immutable
# error: 22:9: cannot write-borrow fixed binding `h` (bound with `const`)
# error: 23:9: cannot write-borrow a temporary: the change would be lost
