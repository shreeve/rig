# A payload binding views the matched value, which cannot be moved while
# the binding is in use.

struct Wrap
  payload: Int

enum Slot
  full(b: *Wrap)
  empty

sub both(s: Slot, b: ?*Wrap)
  print(1)

sub main()
  rc = *Wrap(payload: 5)
  s: Slot = .full(b: <rc)
  match s
    .full(b) => both(<s, ?b)
    .empty => print(0)

# error: cannot move `s` while it is read-borrowed
