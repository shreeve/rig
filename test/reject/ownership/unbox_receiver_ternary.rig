# `unbox` consumes its receiver: each name a branching receiver yields is
# moved with `<`.
obj N
  v: List[Int]

sub main()
  p: List[Int] = List()
  !p.push(5)
  a = ^N(v: <p)
  b = ^N(v: List())
  c = true
  n = (a if c else b).unbox()
  print(n.v.len)
  print(a.v[0])

# error: 12:8: `a` owns a `^N`, which can't be copied into an argument: write `<a` to move it or `+a` to pass a clone
# error: 12:20: `b` owns a `^N`, which can't be copied into an argument: write `<b` to move it or `+b` to pass a clone
# errors: 2
