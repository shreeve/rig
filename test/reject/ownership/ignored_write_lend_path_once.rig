# A path through a write lend whose write is rejected for another
# reason is reported once, for that reason: the `!` is not also said to
# be only read.

struct P
  items: Vec[Int]

sub main()
  p = P(items: Vec[Int]())
  (!p).items.push(3)
  print(p.items.len)

# error: 10:14: method `push` needs its receiver lent to write
# errors: 1
