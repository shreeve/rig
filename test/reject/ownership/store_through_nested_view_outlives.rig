# A value stored through write views lands in the value the last one
# reaches, which must not outlive what the value views: `o.i =
# Inner(x: R(y: ?k))` stores into `o`, and `o.i.x = R(y: ?k)` into its
# part, however the path gets there: through nested local write views,
# an element, or a `match !e` binding.

struct R
  y: ?Int

struct Inner
  x: R

struct Outer
  i: Inner

struct Pair
  xs: [1]R

enum E
  one(i: Inner)
  two

sub main()
  n = 0
  o = Outer(i: Inner(x: R(y: ?n)))
  if true
    k = 5
    o.i = Inner(x: R(y: ?k))
  print(o.i.x.y)
  if true
    k = 5
    o.i.x = R(y: ?k)
  print(o.i.x.y)
  w = !o
  w2 = !w
  if true
    k = 5
    w2.i.x = R(y: ?k)
  print(o.i.x.y)
  p = Pair(xs: [R(y: ?n)])
  wp = !p
  if true
    k = 5
    wp.xs[0] = R(y: ?k)
  print(p.xs[0].y)
  e: E = .one(i: Inner(x: R(y: ?n)))
  if true
    k = 5
    match !e
      .one(i) => i.x = R(y: ?k)
      _ => pass
  print(e)

# error: 28:26: `k` does not live long enough
# error: 32:19: `k` does not live long enough
# error: 38:20: `k` does not live long enough
# error: 44:22: `k` does not live long enough
# error: 50:30: `k` does not live long enough
# errors: 5
