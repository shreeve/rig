# Values are dropped youngest first at the end of their block. A value
# whose `drop` body runs must not lend a younger value, directly or
# through a view: the younger one is dropped first, and the body would
# read it after.

obj Wrap
  v: List[Int]

obj View
  b: ?Wrap

obj Holder
  b: ?Wrap

  drop(!self)
    print("holder drop reads", self.b.v[0])

obj Watcher
  w: ?View

  drop(!self)
    print("watcher drop reads", self.w.b.v[0])

sub main()
  y0 = Wrap(v: List())
  !y0.v.push(0)
  h = Holder(b: ?y0)
  x = Wrap(v: List())
  !x.v.push(42)
  h.b = ?x
  v0 = View(b: ?y0)
  w = Watcher(w: ?v0)
  z = Wrap(v: List())
  vw = View(b: ?z)
  w.w = ?vw

sub early(c: Bool)
  y0 = Wrap(v: List())
  h = Holder(b: ?y0)
  if c
    x = Wrap(v: List())
    h.b = ?x
    return

# error: `x` is dropped before `h`
# error: `z` is dropped before `w`
# error: `x` is dropped before `h`
