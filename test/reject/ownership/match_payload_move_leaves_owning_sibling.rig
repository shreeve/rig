# Moving one payload field out of a matched value consumes the value, so
# no other field of the variant may own a resource: it would never be
# dropped.

struct Wrap
  payload: Int

sub eat(rc: *Wrap)
  print(rc.payload)

enum Slot
  pair(a: *Wrap, b: *Wrap)
  empty

sub main()
  x = *Wrap(payload: 1)
  y = *Wrap(payload: 2)
  s: Slot = .pair(a: <x, b: <y)
  match s
    .pair(a, b) => eat(<a)
    .empty => print(0)

# error: cannot move `a` out of `s`: another field of the variant owns a resource
