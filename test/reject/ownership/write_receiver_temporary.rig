# A `!self` method changes its receiver. Called on a value made in place,
# which no name holds, the change would be lost, and the call shows no
# `!` (Core sentences 4 and 9): it is rejected, as `!mk().bump()` is.
# The same holds for a part of such a value, a field or an element, for
# a branching value whose every branch is made there, for a method that
# returns a view of the receiver, and in a generic body. A write view a
# call returns is no temporary: the method writes through it
# (`test/behavior/ownership/write_receiver_through_returned_view.rig`).

struct S
  n: Int
  inner: T

  sub bump(!self)
    self.n += 1

  fun next(!self) -> Int
    self.n += 1
    self.n

  fun at(!self) -> !Int
    !self.n

struct T
  k: Int

  sub bump(!self)
    self.k += 1

struct Wrap[V]
  v: V

  sub bump(!self)
    pass

  fun twice(?self) -> Wrap[V]
    Wrap(v: self.v)

  sub again(?self)
    self.twice().bump()

fun mk -> S
  S(n: 1, inner: T(k: 0))

sub main
  c = mk().n == 1
  s = mk()
  mk().bump()
  S(n: 1, inner: T(k: 0)).bump()
  print(mk().next())
  (mk() if c else S(n: 2, inner: T(k: 0))).bump()
  (+s).bump()
  mk().inner.bump()
  [T(k: 1), T(k: 2)][0].bump()
  print(mk().at() + 1)
  Wrap(v: 1).again()
  print(s.n)

# error: 40:5: `bump` changes its receiver, a temporary no name holds; bind it to a name first
# error: 48:3: `bump` changes its receiver, a temporary no name holds
# error: 49:3: `bump` changes its receiver, a temporary no name holds
# error: 50:9: `next` changes its receiver, a temporary no name holds
# error: 51:4: `bump` changes its receiver, a temporary no name holds
# error: 52:4: `bump` changes its receiver, a temporary no name holds
# error: 53:3: `bump` changes its receiver, a temporary no name holds
# error: 54:3: `bump` changes its receiver, a temporary no name holds
# error: 55:9: `at` changes its receiver, a temporary no name holds
# errors: 9
