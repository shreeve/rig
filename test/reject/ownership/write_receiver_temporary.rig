# A `!self` method changes its receiver, and every change is marked by
# `!` (Core sentences 4 and 9): called on a value made in place, which no
# name holds, with no `!`, it is rejected, with the hint to add one. The
# same holds for a part of such a value, a field or an element, for a
# branching value whose every branch is made there, for a method that
# returns a view of the receiver, and in a generic body. Each hint, as
# written, runs: `test/behavior/ownership/write_receiver_temporary_lent.rig`.
# A write view a call returns is no temporary: the method writes through
# it (`test/behavior/ownership/write_receiver_through_returned_view.rig`).

struct S
  n: Int
  inner: T

  sub bump(!self)
    self.n += 1

  fun next(!self) -> Int
    self.n += 1
    self.n

  fun at(!self) -> !Int
    !self.n

struct T
  k: Int

  sub bump(!self)
    self.k += 1

struct Wrap[V]
  v: V

  sub bump(!self)
    pass

  fun twice(?self) -> Wrap[V]
    Wrap(v: self.v)

  sub again(?self)
    self.twice().bump()

fun mk() -> S
  S(n: 1, inner: T(k: 0))

sub main()
  c = mk().n == 1
  s = mk()
  mk().bump()
  S(n: 1, inner: T(k: 0)).bump()
  print(mk().next())
  (mk() if c else S(n: 2, inner: T(k: 0))).bump()
  (+s).bump()
  mk().inner.bump()
  [T(k: 1), T(k: 2)][0].bump()
  print(mk().at() + 1)
  Wrap(v: 1).again()
  print(s.n)

# error: 41:5: `bump` changes its receiver, a temporary no name holds; add `!`: `!(self.twice()).bump()`
# error: 49:3: `bump` changes its receiver, a temporary no name holds; add `!`: `!mk().bump()`
# error: 50:3: `bump` changes its receiver, a temporary no name holds; add `!`: `!S(n: 1, inner: T(k: 0)).bump()`
# error: 51:9: `next` changes its receiver, a temporary no name holds; add `!`: `(!mk()).next()`
# error: 52:4: `bump` changes its receiver, a temporary no name holds; add `!`: `!(mk() if c else S(n: 2, inner: T(k: 0))).bump()`
# error: 53:4: `bump` changes its receiver, a temporary no name holds; add `!`: `!(+s).bump()`
# error: 54:3: `bump` changes its receiver, a temporary no name holds; add `!`: `!mk().inner.bump()`
# error: 55:3: `bump` changes its receiver, a temporary no name holds; add `!`: `![T(k: 1), T(k: 2)][0].bump()`
# error: 56:9: `at` changes its receiver, a temporary no name holds; add `!`: `(!mk()).at()`
