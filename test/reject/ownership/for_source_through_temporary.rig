# A `for` over a place reached through a temporary its header makes (an
# index or a call's argument on the place's path) is rejected, read or
# write, as a `match` or `as` over one is: emit evaluates the source in
# a block that ends the temporary. `for x in <p` is not affected.

struct C
  hits: Cell[Int]

fun idx(s: ?Text) -> Int
  0

sub main()
  v: Vec[[2]Int] = Vec()
  !v.push([1, 2])
  for x in !v[idx(?Text("k"))]
    x = 9
  w: Vec[[1]C] = Vec()
  !w.push([C(hits: Cell(0))])
  for c in w[idx(?Text("k"))]
    c.hits.set(5)
  a = [[1, 2], [3, 4]]
  for x in !a[idx(?Text("k"))]
    x = 9
  m: Vec[Vec[Text]] = Vec()
  for t in m[idx(?Text("k"))]
    print(t)
  print(v.len, w.len, a, m.len)

# error: 15:20: this header binds a copy of its subject, since a temporary it makes ends with the header: bind the index to a name first
# error: 19:19: bind the index to a name first
# error: 22:20: bind the index to a name first
# error: 25:19: bind the index to a name first
# errors: 4
