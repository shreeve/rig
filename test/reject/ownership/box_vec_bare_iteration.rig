# A Vec of boxes is walked by viewed slot, written or not: each
# element of `for x in v` is a view of a box the Vec still owns, which
# cannot be moved out.

struct R
  n: Int

sub eat(b: ^R)
  print(b.n)

sub f(v: ?Vec[^R])
  for x in v
    eat(<x)

sub main()
  v: Vec[^R] = Vec()
  !v.push(^R(n: 1))
  f(?v)

# error: 13:9: type mismatch: expected `^R`, got `?^R`
