# No read view of a struct reaches a write view the struct holds, which
# other read views could reach too: a write view is never stored inside
# a value, so the field is rejected where it is declared.

struct H
  w: !Int

sub main()
  n = 1
  print(n)

# error: 6:6: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
