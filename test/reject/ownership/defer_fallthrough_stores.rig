# A `defer` that stores a loan on a local of its scope runs as the
# scope ends, after which the local is gone.
obj H
  r: ?List[Int]

sub main()
  z: List[Int] = List()
  h = H(r: ?z)
  if true
    inner: List[Int] = List()
    !inner.push(9)
    defer h.r = ?inner
    print("in")
  print(h.r[0])

# error: 12:18: `inner` does not live long enough
# errors: 1
