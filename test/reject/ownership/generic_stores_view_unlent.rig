# A Cell, a Signal, and an owned closure carry no loan, so a generic
# body that stores its `T` there cannot take a view of an owner.

fun cell[T](x: T) -> Int
  c = *Cell(x)
  1

fun signal[T](x: T) -> Int
  s = *Signal(x)
  1

sub main()
  v: List[Int] = List()
  print(cell(?v), signal(?v))

# error: 14:9: `cell[?List[Int]]` instantiates `Cell[?List[Int]]`
# error: 14:19: `signal[?List[Int]]` instantiates `Signal[?List[Int]]`
# errors: 2
