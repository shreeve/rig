# A header that reads a bare place keeps it lent while what it binds is
# used, as `?p` does; a value it holds ends with the construct.

obj Res
  n: Int
  t: String

enum E
  a(r: Res)
  b

obj H
  e: E

fun mkh() -> H
  H(e: E.a(r: Res(n: 1, t: String("a"))))

sub loops()
  v: List[Int] = List()
  !v.push(1)
  for x in v
    !v.push(x)

sub ifs()
  o: List[Int]? = List()
  if o as x
    o = none
    print(x.len)

sub boxes()
  b = ^E.a(r: Res(n: 2, t: String("b")))
  match b
    .a(r)
      <b
      print(r.n)
    .b => pass

sub held()
  keep = Res(n: 0, t: String("c"))
  saved = ?keep
  match mkh().e
    .a(r) => saved = ?r
    .b => pass
  print(saved.n)

sub main()
  loops()

# error: 22:5: cannot lend `v` to write while a read loan is live
# error: 27:5: cannot reassign `o` while it is lent
# error: 34:8: cannot drop `b` while it is lent
# error: 42:8: a view of the temporary `mkh()` outlives its statement
# errors: 4
