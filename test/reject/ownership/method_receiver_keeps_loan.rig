# A `!self` receiver whose type holds a view may keep what the
# method's arguments view, so the view lives as long as it does,
# even when the receiver is written through a write view.

struct View
  xs: []Int

  sub point(!self, ys: []Int)
    self.xs = ys

sub main()
  a = [1, 2, 3]
  b = [4, 5]
  v = View(xs: ?b)
  !v.point(?a)
  !a.swap(0, 1)
  print(v.xs)

# error: cannot lend `a` to write while a read loan is live
# errors: 1
