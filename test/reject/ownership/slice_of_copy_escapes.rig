# A loop element is a copy: a slice of one points into the copy and
# cannot outlive it. (A read borrow of an array points at the array, so
# a slice of it may outlive the borrow; see
# test/behavior/ownership/slice_return_array_param.rig.)

sub main()
  a = [1, 2, 3]
  s = ?a[0..1]
  g = [[1, 2], [3, 4]]
  for row in g
    s = ?row[0..2]
  print(s)

# error: 11:10: `row` does not live long enough
