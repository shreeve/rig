# A store through a `!Holder` field of parameter `c` lands in what the
# caller lent, which keeps `b` lent for the rest of the body.

struct Holder
  r: []Int

struct Ctx
  w: !Holder

fun f(c: !Ctx, b: !Vec[Int]) -> Int
  c.w.r = ?b[..]
  for i in 0..100
    !b.push(i)
  c.w.r[0]

sub main
  x = [9, 9]
  v: Vec[Int] = Vec()
  !v.push(1)
  h = Holder(r: ?x[..])
  c = Ctx(w: !h)
  print(f(!c, !v))

# errors: 1
# error: 13:5: cannot write-borrow `b` while a read borrow is live
