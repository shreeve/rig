# A shared handle chosen by an if-expression is still a bare copy of
# the handle: each branch must write `<rc` or `+rc`.

struct Wrap
  payload: Int

sub main()
  rc = *Wrap(payload: 7)
  x = if true
    rc
  else
    rc
  print(x.payload)

# error: 10:5: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it
# error: 12:5: `rc` is a `*Wrap` handle, which can't be copied by `=`: write `<rc` to move it, `+rc` for another handle, or `?rc` to view it
