# A shared handle chosen by an if-expression is still a bare copy of
# the handle: each branch must write `<rc` or `+rc`.

struct Wrap
  payload: Int

sub main()
  rc = *Wrap(payload: 7)
  x = if true
    rc
  else
    rc
  print(x.payload)

# error: 10:5: bare use of shared (`*T`) handle `rc` in binding would alias the handle; use `<rc` to move or `+rc` to clone
# error: 12:5: bare use of shared (`*T`) handle `rc` in binding would alias the handle; use `<rc` to move or `+rc` to clone
