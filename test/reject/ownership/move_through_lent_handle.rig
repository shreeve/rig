# A path through a shared handle reaches the handle's value, which other
# handles may still use: nothing is moved out of it.

obj S
  items: List[Int]

sub main()
  h = *S(items: List())
  x = <h.items
  print(x)

# error: 9:8: cannot move out of `h.items`: it is reached through a shared handle and other handles may still use it
