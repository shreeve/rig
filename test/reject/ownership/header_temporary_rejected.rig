# A `match`, `if … as`, `while … as`, or `for` header that makes a
# statement temporary and has no place outside it to reach (a value made
# in the header, or a part of one) is emitted over a copy of that value,
# in the block that drops the temporary, so what it binds would be in
# that copy: a write, a Cell change, or a view through a binding would
# reach the copy. Such a header is rejected, whatever it binds, unless it
# takes a value made there (`match mke(?String("a"))`, `if opt(3) as p`),
# and the hint says what to bind to a name first. A header that reaches a
# place binds the place's own (`header_temporary_points.rig`).

enum E
  a(xs: [4]Int)
  b

obj P
  x: Int

obj H
  e: E
  t: String

fun idx(s: ?String) -> Int
  s.len - 1

fun opt(n: ?String) -> P?
  if n.len > 0
    return P(x: n.len)
  none

fun mkh(n: Int) -> H
  H(e: E.a(xs: [n, n, n, n]), t: String("h"))

fun mke(s: ?String) -> E
  .a(xs: [s.len, 0, 0, 0])

sub main()
  if ?opt(?String("abc")) as p
    print(p.x)
  while ?opt(?String("")) as q
    print(q.x)
  match mkh(4).e
    .a(xs) => print(xs[0])
    .b => pass
  for x in [[1, 2], [3, 4]][idx(?String("ab"))]
    print(x)
  match mke(?String("a"))
    .a(xs) => print(xs[0])
    .b => pass
  if opt(?String("abc")) as p
    print(p.x)

# errors: 4
# error: 37:7: this header binds a copy of its subject, since a temporary it makes ends with the header: bind `opt(?String("abc"))` to a name first
# error: 39:10: bind `opt(?String(""))` to a name first
# error: 41:9: bind `mkh(4)` to a name first
# error: 44:34: bind the index to a name first
