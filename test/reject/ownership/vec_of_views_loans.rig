# A Vec of views keeps each pushed view's loan while it lives, and a
# write view in it is unique.

sub main
  a = 1
  v: Vec[?Int] = Vec()
  !v.push(?a)
  a = 2
  print(v.len)
  b = 1
  w: Vec[!Int] = Vec()
  !w.push(!b)
  !w.push(!b)
  print(w.len)

# error: 8:3: cannot reassign `a` while borrows are live
# error: 13:12: cannot take a second write borrow on `b`
