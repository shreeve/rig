# An owned closure carries the borrows of its captures, so it cannot be
# returned when it captured a borrow of a local.

struct Box
  payload: Int

fun mk() -> *sub()
  b = Box(payload: 1)
  r = ?b
  *|<r| print(r.payload)

sub main()
  cb = mk()
  cb()

# error: returned borrow of `b` does not originate from a borrowed parameter
