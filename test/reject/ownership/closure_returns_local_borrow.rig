# An owned closure can be returned, so it cannot capture a borrow (here
# of a local that the return would outlive).

struct Box
  payload: Int

fun mk() -> *sub()
  b = Box(payload: 1)
  r = ?b
  *|<r| print(r.payload)

sub main()
  cb = mk()
  cb()

# error: an owned closure cannot capture `r`, which holds a borrow of `b`
