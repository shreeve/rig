# A struct never holds a `!T` field whose write view would keep what it
# views lent while the struct is used: a write view is never stored
# inside a value, so the field is rejected where it is declared.

struct H
  w: !Vec[Int]

sub main()
  v: Vec[Int] = Vec()
  print(v.len)

# error: 6:6: a write view is never stored inside a value, and `!Vec[Int]` cannot stand here
# errors: 1
