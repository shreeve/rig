# An assignment is `{ __v = value; place op= __v }`: every scope nested
# in the value ends before the target is used, so a view the target reads
# may not be pointed at a local of such a scope, the last one included
# (the last `match` arm, an `else` block, a `catch` block).
error E
  bad

obj S
  n: Int

fun fail(n: Int) -> Int!
  return E.bad if n < 0
  n

sub first_arm(k: Int)
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = match k
    0
      u: List[Int] = List()
      !u.push(1)
      w = !u[0..1]
      3
    _ => 4

sub last_arm(k: Int)
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = match k
    1 => 4
    _
      u: List[Int] = List()
      !u.push(1)
      w = !u[0..1]
      3

sub if_block(k: Bool)
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = if k
    u: List[Int] = List()
    !u.push(1)
    w = !u[0..1]
    3
  else
    4

sub else_block(k: Bool)
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = if k
    4
  else
    u: List[Int] = List()
    !u.push(1)
    w = !u[0..1]
    3

sub catch_block()
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] = fail(-1) catch |_|
    u: List[Int] = List()
    !u.push(1)
    w = !u[0..1]
    3

sub compound(k: Int)
  v: List[Int] = List()
  !v.push(7)
  w = !v[0..1]
  w[0] += match k
    1 => 4
    _
      u: List[Int] = List()
      !u.push(1)
      w = !u[0..1]
      3

sub field(k: Int)
  v: List[S] = List()
  !v.push(S(n: 7))
  w = !v[0]
  w.n = match k
    1 => 4
    _
      u: List[S] = List()
      !u.push(S(n: 1))
      w = !u[0]
      3

sub name_first(k: Int)
  v: List[Int] = List()
  !v.push(7)
  w = !v[0]
  w = match k
    0
      u: List[Int] = List()
      !u.push(1)
      w = !u[0]
      3
    _ => 4

sub name_last(k: Int)
  v: List[Int] = List()
  !v.push(7)
  w = !v[0]
  w = match k
    1 => 4
    _
      u: List[Int] = List()
      !u.push(1)
      w = !u[0]
      3

sub index_view(k: Int)
  v: List[Int] = List()
  !v.push(2)
  t: List[Int] = List()
  !t.push(0)
  w = ?v[0..1]
  t[w[0]] = match k
    1 => 4
    _
      u: List[Int] = List()
      !u.push(0)
      w = ?u[0..1]
      9

