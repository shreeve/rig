# A match on a part of a made value holds that value for the match, and
# each payload is a view of it there: the view does not outlive the
# match.

struct Counter
  hits: Cell[Int]

enum E
  a(c: Counter)
  b

struct H
  e: E

fun mkh(n: Int) -> H
  H(e: E.a(c: Counter(hits: Cell(n))))

fun mk(n: Int) -> [1]E
  [E.a(c: Counter(hits: Cell(n)))]

sub main()
  one = [Counter(hits: Cell(1))]
  saved = ?one[0]
  match mkh(7).e
    .a(c) => saved = c
    .b => pass
  match mk(7)[0]
    .a(c) => saved = c
    .b => pass
  print(saved.hits.get())

# error: 25:8: a borrow of the temporary `mkh(7)` outlives its statement
# error: 28:8: a borrow of the temporary `mk(7)` outlives its statement
