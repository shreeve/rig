# `set` and `replace` need a Cell that has a place. Every binding of a
# value holding a Cell is one (the value is unique, so a by-value
# parameter owns it and a loop or match binding views it:
# test/behavior/ownership/cell_holder_places.rig), but a temporary has
# no place at all.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

fun made() -> Counter
  Counter(hits: Cell(0))

fun fresh() -> Cell[Int]
  Cell(3)

sub main()
  fresh().set(4)
  made().hit()

# error: 20:11: `Cell.set` needs a Cell that has a place
# error: 21:3: cannot call `hit` on a temporary that holds a Cell
