# `set` and `replace` need a Cell that has a place. A by-value parameter
# is immutable, and a temporary has no place at all.

struct Counter
  hits: Cell[Int]

  sub hit(?self)
    self.hits.set(self.hits.get() + 1)

sub bump(c: Cell[Int])
  c.set(1)

fun swap(c: Cell[Int]) -> Int
  c.replace(2)

fun made() -> Counter
  Counter(hits: Cell(0))

fun fresh() -> Cell[Int]
  Cell(3)

sub main()
  c: Cell[Int] = Cell(0)
  bump(c)
  print(swap(c))
  fresh().set(4)
  made().hit()

# error: `Cell.set` needs a Cell that has a place
# error: `Cell.replace` needs a Cell that has a place
# error: cannot call `hit` on a temporary that holds a Cell
# error: `Cell.set` needs a Cell that has a place
