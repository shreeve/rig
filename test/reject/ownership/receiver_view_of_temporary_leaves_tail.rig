# A view a method returns of a temporary receiver, a write view of a
# `!self` method's included, lives only until its statement ends, also
# where the call is a function's or closure's tail, `return`'s value, an
# `if` or `match` arm's value, or a `break` value: each leaves the
# statement the temporary ends with.

struct S
  n: Int
  m: Int

  fun at(!self) -> !Int
    !self.n

  fun rd(?self) -> ?Int
    ?self.n

fun mk(k: Int) -> S
  S(n: k, m: 6)

fun tail(d: !Int) -> !Int
  !mk(42).at()

fun ret(d: !Int) -> !Int
  return !mk(43).at()

fun read_tail(d: ?Int) -> ?Int
  mk(44).rd()

sub main
  z = 0
  c = z == 0
  r = !mk(45).at()
  a = if c
    !mk(46).at()
  else
    !mk(47).at()
  m = match z
    0 => !mk(48).at()
    _ => !mk(49).at()
  b = for k in [1, 2]
    break !mk(50).at() if k > 0
  else
    !mk(51).at()
  y = 1
  w = 2
  v = 3
  f = |?y| mk(y).rd()
  print(tail(!w), ret(!v), read_tail(?z), r, a, m, b, f())

# error: 21:4: returned borrow of `mk(42)` does not originate from a borrowed parameter
# error: 24:11: returned borrow of `mk(43)` does not originate from a borrowed parameter
# error: 27:3: returned borrow of `mk(44)` does not originate from a borrowed parameter
# error: 32:8: a borrow of the temporary `mk(45)` outlives its statement
# error: 34:6: a borrow of the temporary `mk(46)` outlives its statement
# error: 36:6: a borrow of the temporary `mk(47)` outlives its statement
# error: 38:11: a borrow of the temporary `mk(48)` outlives its statement
# error: 39:11: a borrow of the temporary `mk(49)` outlives its statement
# error: 41:12: a borrow of the temporary `mk(50)` outlives its statement
# error: 43:6: a borrow of the temporary `mk(51)` outlives its statement
# error: 47:12: returned borrow of `mk(y)` does not originate from a borrowed parameter
