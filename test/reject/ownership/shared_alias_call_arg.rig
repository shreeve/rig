# Passing a bare shared handle as a call argument is rejected: caller
# and callee would both own it. Use `<rc` or `+rc`.

struct Box
  value: Int

sub use_rc(rc: *Box)
  -rc

sub main()
  rc = *Box(value: 1)
  use_rc(rc)
  -rc

# error: bare use of shared (`*T`) handle `rc` in call argument would alias the handle
