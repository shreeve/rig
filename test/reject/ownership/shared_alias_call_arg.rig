# Passing a bare shared handle as a call argument is rejected: caller
# and callee would both own it. Use `<rc` or `+rc`.

struct Wrap
  value: Int

sub use_rc(rc: *Wrap)
  <rc

sub main()
  rc = *Wrap(value: 1)
  use_rc(rc)
  <rc

# error: `use_rc` takes ownership of a `*Wrap`, and `rc` can't be copied: write `<rc` to move it or `+rc` for another handle; if `use_rc` only reads it, make its parameter a `?*Wrap`
