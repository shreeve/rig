# A struct with a resource field has drop glue, so a bare alias
# (`o2 = o1`) is rejected: both bindings would run the destructor.

struct Owner
  cell: *Cell[Int]

sub main()
  o1 = Owner(cell: *Cell(0))
  o2 = o1
  print(o2.cell.get())

# error: `o1` owns an `Owner`, which can't be copied by `=`: write `<o1` to move it, `+o1` to clone it, or `?o1` to view it
