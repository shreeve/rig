# A shared handle whose value holds a write borrow cannot be cloned, even
# through a read borrow of its holder: two handles would write through
# one borrow.

struct Wrap
  v: Vec[Int]

struct WV
  b: !Wrap

struct Hold
  h: *WV

  fun dup(?self) -> *WV
    +self.h

sub main()
  x = Wrap(v: Vec())
  !x.v.push(1)
  k = Hold(h: *WV(b: !x))
  d = k.dup()
  print(d.b.v.len)

# error: 15:6: cannot clone `self.h`: it holds a write borrow
