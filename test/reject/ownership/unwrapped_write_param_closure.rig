# A closure that captures the write view a `(!H)?` parameter holds, or
# the view unwrapped from it, stores in the caller's value when it is
# called: the closure literal is reported, and a store through a base
# that is no place (`w ?? return`) is reported where it stands too.

obj H
  s: ?String

  sub keep(!self, v: ?String)
    self.s = v

sub captured(w: (!H)?)
  d = String("local")
  f = |<w, ?d| (w ?? return).s = d
  f()

sub unwrapped(w: (!H)?)
  d = String("local")
  x = <w ?? return
  f = |<x, ?d| x.s = d
  f()

sub main()
  t = String("outer")
  h = H(s: ?t)
  captured(!h)
  unwrapped(!h)
  print(h.s)

# errors: 3
# error: 13:9: cannot let this call store a view of `d` in `w`: `w` outlives it
# error: 13:16: cannot store a view of `d` through `w ?? return`: `w` outlives it
# error: 19:9: cannot let this call store a view of `d` in `w`: `w` outlives it
