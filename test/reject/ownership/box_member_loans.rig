# Member access through a box lends what it reaches, with a loan on the
# box's binding: the box may not be dropped or written while a view
# through it is used.

obj S
  n: Int
  t: String

fun first(s: ?String) -> ?String
  s

sub a()
  b = ^S(n: 1, t: String("x"))
  r = first(?b.t)
  <b
  print(r)

sub c()
  bt = ^String("hi")
  s = first(?bt)
  !bt.add("!")
  print(s)

sub d()
  v: ^List[Int] = ^List()
  !v.push(1)
  w = ?v
  !v.push(2)
  print(w.len)

sub main()
  a()

# error: 15:4: cannot drop `b` while `b.t` is lent
# error: 21:3: cannot lend `bt` to write while a read loan is live
# error: 28:3: cannot lend `v` to write while a read loan is live
# errors: 3
