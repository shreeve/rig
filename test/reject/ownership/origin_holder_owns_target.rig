# A cursor that also owns items of the type it hands out keeps itself
# lent, to read: its result may view its own `scratch`.

obj Item
  n: Int

obj Cursor
  items: ?List[Item]
  scratch: List[Item]
  i: Int

  fun next(!self) -> ?Item
    k = self.i
    self.i += 1
    ?self.items[k]

sub main()
  v: List[Item] = List()
  !v.push(Item(n: 1))
  !v.push(Item(n: 2))
  c = Cursor(items: ?v, scratch: List(), i: 0)
  a = (!c).next()
  b = (!c).next()
  print(a.n, b.n)

# error: 23:8: cannot lend `c` to write while a read loan is live
