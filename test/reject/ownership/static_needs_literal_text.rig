# A `Static` carries no loan, so a `String`, which may view a `Text`,
# cannot go where one is required: a `Static` parameter, a `Static`
# field, a `Cell[Static]`, or an owned closure's `Static`.

struct Tag
  name: Static

sub need(s: Static)
  print(s)

sub fill(c: !Cell[Static], s: String)
  !c.set(s)

sub main()
  t = Text("abcdefghijklmnop")
  s: String = ?t[..]
  need(s)
  tag = Tag(name: s)
  v: Vec[Static] = Vec()
  !v.push(s)
  print(tag.name, v.len)

