# A Signal keeps its subscribers, owned closures that any handle to the
# Signal can run, so a subscriber cannot capture a borrow.

struct Box
  payload: Int

  drop self: !Box
    print("drop")

sub main()
  sig: *Signal[Int] = *Signal(value: 0)
  a = Box(payload: 1)
  r = ?a
  cb: *sub() = *|<r| print(r.payload)
  sig.subscribe(+cb)
  -cb
  -a
  sig.set(1)

# error: an owned closure cannot capture `r`, which holds a borrow of `a`
