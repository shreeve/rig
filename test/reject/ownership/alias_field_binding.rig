# Binding a shared-handle field (`x = p.a`) would copy the handle without
# a refcount bump. Clone it (`+p.a`); fields cannot be moved out.

obj Wrap
  payload: Int

obj Pair
  a: *Wrap

sub main()
  p = Pair(a: *Wrap(payload: 1))
  x = p.a
  print(x.payload)

# error: 12:7: `p.a` is a `*Wrap` handle, which can't be copied by `=`: write `+p.a` for another handle or `?p.a` to view it
