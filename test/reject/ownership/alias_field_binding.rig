# Binding a shared-handle field (`x = p.a`) would copy the handle without
# a refcount bump. Clone it (`+p.a`); fields cannot be moved out.

struct Wrap
  payload: Int

struct Pair
  a: *Wrap

sub main()
  p = Pair(a: *Wrap(payload: 1))
  x = p.a
  print(x.payload)

# error: 12:7: bare use of shared (`*T`) handle `p.a` in binding would alias the handle; use `+p.a` to clone
