# A header that takes a value a call makes binds that value, but what it
# binds lives through the body: a view in it of a temporary the header
# made outlives the temporary, in a `match`, an `if … as`, or a `for`.

enum F
  a(s: String)
  b

fun mkf(t: String) -> F
  .a(s: t)

fun mko(t: String) -> String?
  t

fun mka(t: String) -> [2]String
  [t, t]

sub main
  match mkf(?Text("a text long enough to live on the heap"))
    .a(s) => print(s)
    .b => print("b")
  if mko(?Text("a text long enough to live on the heap")) as s
    print(s)
  for s in mka(?Text("a text long enough to live on the heap"))
    print(s)

# errors: 3
# error: 19:14: a borrow of the temporary `Text("a text long enough to live on the heap")` outlives its statement
# error: 22:11: a borrow of the temporary `Text("a text long enough to live on the heap")` outlives its statement
# error: 24:17: a borrow of the temporary `Text("a text long enough to live on the heap")` outlives its statement
