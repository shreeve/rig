# An element of a Vec of handles is a place: a bare use would copy the
# handle out of it.

struct N
  v: Int

sub main()
  xs: Vec[*N] = Vec()
  a = *N(v: 1)
  !xs.push(<a)
  b = xs[0]
  print(b.v)

# error: 11:7: `xs[0]` is a `*N` handle, which can't be copied by `=`: write `+xs[0]` for another handle or `?xs[0]` to view it
