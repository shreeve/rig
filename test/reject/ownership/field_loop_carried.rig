# The view made in one iteration is used in the next, after the same
# field was written: on the second turn `prev` views a buffer the first
# turn's push may have moved.
# Rule: a loan lasts until the last use of every view carrying it,
# around a loop's back edge too (Core sentence 6).
# From Trig's acceptance tests
# (docs/ownership/acceptance/reject/field_loop_carried.rig).

obj P
  items: List[Int]
  n: Int

sub main()
  p = P(items: List(), n: 0)
  !p.items.push(0)
  prev = ?p.items[..]
  for i in 0..3
    print(prev.len)
    !p.items.push(i)
    prev = ?p.items[..]

# error: 19:5: cannot lend `p.items` to write while a read loan is live
# errors: 1
