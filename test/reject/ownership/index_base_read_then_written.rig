# A value that is no place is read where it runs and indexed after its
# index runs: the index cannot lend what the value may be to write. A
# place is found after its index (`a[grow(!a)]` is accepted).

struct P
  v: Vec[Int]

fun mk(k: Int) -> P
  v: Vec[Int] = Vec()
  !v.push(k)
  P(v: <v)

fun growp(p: !P) -> Int
  for i in 0..100
    !p.v.push(i)
  0

sub main()
  a = mk(1)
  b = mk(2)
  c = true
  print((a if c else b).v[growp(!a)])

# error: 22:34: cannot lend `a` to write while the indexed value's read of it is in use
# errors: 1
