# A consuming method's receiver is taken like an argument: each name a
# branching receiver yields is moved with `<` (`(<a if c else <b)`).
struct Bag
  items: Vec[Int]

  fun total(<self) -> Int
    self.items.len

sub main()
  a = Bag(items: Vec())
  b = Bag(items: Vec())
  !a.items.push(1)
  c = true
  print((a if c else b).total())
  print(a.items[0])

# error: 14:10: `a` owns a `Bag`, which can't be copied into an argument: write `<a` to move it or `+a` to pass a clone
# error: 14:22: `b` owns a `Bag`, which can't be copied into an argument: write `<b` to move it or `+b` to pass a clone
# errors: 2
