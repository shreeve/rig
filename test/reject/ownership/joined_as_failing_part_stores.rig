# When a later part of `if a as x and ...` or `while a as x and ...`
# fails, `x` goes out of scope; a view of it that the part stored in
# an outer value cannot survive, even when the body never falls through.

obj Big
  v: List[Int]

obj View
  b: ?Big

fun put(v: !View, t: ?Big) -> Bool keeps t
  v.b = t
  false

sub viaIf()
  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: Big? = Big(v: List())
  if <o as x and put(!vw, ?x)
    return
  print(vw.b.v.len)

sub viaWhile()
  x0 = Big(v: List())
  vw = View(b: ?x0)
  o: Big? = Big(v: List())
  while <o as x and put(!vw, ?x)
    return
  print(vw.b.v.len)

sub main()
  viaIf()
  viaWhile()

# error: 19:28: `x` does not live long enough
# error: 27:31: `x` does not live long enough
