# When a later part of `if a as x and ...` or `while a as x and ...`
# fails, `x` goes out of scope; a borrow of it that the part stored in
# an outer value cannot survive, even when the body never falls through.

struct Big
  v: Vec[Int]

struct View
  b: ?Big

fun put(v: !View, t: ?Big) -> Bool
  v.b = t
  false

sub viaIf
  x0 = Big(v: Vec())
  vw = View(b: ?x0)
  o: Big? = Big(v: Vec())
  if <o as x and put(!vw, ?x)
    return
  print(vw.b.v.len)

sub viaWhile
  x0 = Big(v: Vec())
  vw = View(b: ?x0)
  o: Big? = Big(v: Vec())
  while <o as x and put(!vw, ?x)
    return
  print(vw.b.v.len)

sub main
  viaIf()
  viaWhile()

# error: 19:28: `x` does not live long enough
# error: 27:31: `x` does not live long enough
