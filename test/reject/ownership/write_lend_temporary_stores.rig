# A temporary lent to write as a method's receiver, or a part of one,
# holds what the call stores in it, as a name does
# (`store_into_unnamed_receiver.rig`): a view of a temporary made after
# it, which its statement drops first, would be read by its `drop`.
# oracle: stores_string reject C5
# oracle: pushes_string reject C5
# oracle: stores_through_bang reject C5

struct S
  n: Int
  t: Text
  items: Vec[Int]

struct H
  rs: Vec[String]

  sub keep(!self, r: String)
    !self.rs.push(r)

  drop(!self)
    print(self.rs)

fun mk(n: Int) -> S
  S(n: n, t: Text("t"), items: Vec())

fun mkh() -> H
  H(rs: Vec())

fun wrap(h: !H) -> !H
  h

sub stores_string()
  !mkh().keep(?mk(1).t)

sub pushes_string()
  !mkh().rs.push(?mk(1).t)

sub stores_through_bang()
  h = mkh()
  if h.rs.len == 0
    s = mk(1)
    !wrap(!h).keep(?s.t)

sub main()
  stores_string()

# error: 33:16: a view of the temporary `mk(1)` is held by `mkh()`, a temporary its statement drops after it; bind the value to a name first
# error: 36:19: a view of the temporary `mk(1)` is held by `mkh()`, a temporary its statement drops after it; bind the value to a name first
# error: 42:20: `s` does not live long enough
# errors: 3
