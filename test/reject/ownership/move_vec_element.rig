# An element that moves cannot be moved out of a Vec: the Vec still
# owns the slot. (An element of plain data is copied out.)

struct P
  n: Int

sub eat(p: *P)
  print(p.n)

sub main()
  v: Vec[*P] = Vec()
  !v.push(*P(n: 7))
  eat(<v[0])

# error: 13:8: cannot move out of `v[...]`: elements cannot be moved out of their container
