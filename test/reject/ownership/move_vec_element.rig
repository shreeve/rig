# An element that moves cannot be moved out of a Vec: the Vec still
# owns the slot. (`<` on an element that copies is rejected too.)

struct P
  n: Int

sub eat(p: *P)
  print(p.n)

sub main()
  v: Vec[*P] = Vec()
  !v.push(*P(n: 7))
  eat(<v[0])

# error: 13:8: cannot move out of `v[0]`: elements cannot be moved out of their container
