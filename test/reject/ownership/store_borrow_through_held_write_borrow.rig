# A store through a local write borrow lands in what it borrows, and in
# what a write borrow held there borrows in turn: here the parameter
# `p`, which outlives the local `t`. The error names the store, not a
# call.

struct S
  n: Int

struct H
  r: ?S

struct V
  h: !H

sub put(p: !H)
  v = V(h: !p)
  w = !v
  t = S(n: 99)
  w.h.r = ?t

sub main()
  a = S(n: 1)
  outer = H(r: ?a)
  put(!outer)
  print(outer.r.n)

# error: 19:3: cannot store a view of `t` through `w`: `p` outlives it
# errors: 1
