# The `*T?` from `upgrade()` owns a strong handle; copying it would
# drop the handle twice.

obj Wrap
  n: Int

sub main()
  rc = *Wrap(n: 5)
  w = ~rc
  m = *w
  n = m
  <w

# error: 11:7: `m` is a `*Wrap?` handle, which can't be copied by `=`: write `<m` to move it, `+m` for another handle, or `?m` to view it
