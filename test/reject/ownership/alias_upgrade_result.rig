# The `*T?` from `upgrade()` owns a strong handle; copying it would
# drop the handle twice.

struct Wrap
  n: Int

sub main()
  rc = *Wrap(n: 5)
  w = ~rc
  m = w.upgrade()
  n = m
  <w

# error: 11:7: bare use of shared (`*T`) handle `m` in binding would alias the handle; use `<m` to move or `+m` to clone
