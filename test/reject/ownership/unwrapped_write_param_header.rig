# `if <w as x` and `while <w as x` bind the write view a `(!H)?`
# parameter holds: a store through `x`, to a field or to the whole value,
# lands in the caller's value.

obj H
  s: ?String

  sub keep(!self, v: ?String) keeps v
    self.s = v

sub field(w: (!H)?)
  d = String("local")
  if <w as x
    x.s = ?d

sub whole(w: (!H)?)
  d = String("local")
  if <w as x
    x = H(s: ?d)

sub looped(w: (!H)?)
  d = String("local")
  while <w as x
    x.s = ?d
    break

sub main()
  t = String("outer")
  h = H(s: ?t)
  field(!h)
  whole(!h)
  looped(!h)
  print(h.s)

# errors: 3
# error: 14:5: cannot store a view of `d` in `x.s`: `x` outlives it
# error: 19:5: cannot store a view of `d` through `x`: what `x` views outlives it
# error: 24:5: cannot store a view of `d` in `x.s`: `x` outlives it
