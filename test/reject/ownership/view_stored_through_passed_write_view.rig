# A callee may store a view wherever a write view passed to it
# leads, also one moved in from a local.

struct Res
  v: Vec[Int]

struct View
  r: ?Res

struct Outer
  inner: View?

sub fill(o: !Outer, r: ?Res)
  o.inner = View(r: r)

sub main()
  a = Outer(inner: none)
  if true
    x = Res(v: Vec())
    !x.v.push(5)
    w = !a
    fill(<w, ?x)
  if a.inner as v
    print(v.r.v[0])

# error: 22:15: `x` does not live long enough
