# A generic body that copies a `T` cannot take `T = *Counter`, the
# handle a value that holds a Cell lives behind: the copy would
# duplicate the handle.

struct Counter
  hits: Cell[Int]

struct Wrap[T]
  v: T

fun keep[T](x: T) -> Wrap[T]
  Wrap(v: x)

sub main()
  a = *Counter(hits: Cell(0))
  w = keep(<a)
  print(w.v.hits.get())

# error: 16:7: `keep[*Counter]` cannot use `T = *Counter`: the generic body copies a `T`, which would duplicate the resource `*Counter` owns
# errors: 1
