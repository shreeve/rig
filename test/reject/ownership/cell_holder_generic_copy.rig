# A generic body that copies a `T` cannot take `T = Counter`, a value
# that holds a Cell: the copy would fork it.

struct Counter
  hits: Cell[Int]

struct Wrap[T]
  v: T

fun keep[T](x: T) -> Wrap[T]
  Wrap(v: x)

sub main()
  a = Counter(hits: Cell(0))
  w = keep(<a)
  print(w.v.hits.get())

# error: 15:7: `keep[Counter]` cannot use `T = Counter`: the generic body copies a `T`, and `Counter` is unique
# errors: 1
