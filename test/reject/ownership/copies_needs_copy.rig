# Only a value that copies is copied out of a view (Core §4), or by
# `[n of x]`: one that owns a resource moves, and a write view has one
# holder.

struct O
  v: Vec[Int]

fun owner_out(p: ?O) -> O
  p

sub fill_write()
  n = 1
  a = [2 of !n]
  print(a[0])

sub main()
  print(1)

