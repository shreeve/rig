# A store through a `for k in !hs` element lands in local `hs`, which
# then holds the view of parameter `b`: `b` stays lent while `hs` is used.

struct Holder
  r: []Int

fun f(b: !Vec[Int]) -> Int
  x = [9, 9]
  hs = [Holder(r: ?x[..])]
  for k in !hs
    k.r = ?b[..]
  for i in 0..100
    !b.push(i)
  hs[0].r[0]

sub main
  v: Vec[Int] = Vec()
  !v.push(1)
  print(f(!v))

# errors: 1
# error: 13:5: cannot write-borrow `b` while a read borrow is live
