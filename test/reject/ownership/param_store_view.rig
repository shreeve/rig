# Storing a String viewing `b` in a field of parameter `a` keeps `b`
# lent for the rest of the body.

obj Holder
  s: ?String

fun f(a: !Holder, b: !String) -> Int keeps b
  a.s = ?b[0..1]
  for _ in 0..100
    !b.add("abcdefgh")
  print(a.s)
  0

sub main()
  t = String("zz")
  w = String("abc")
  h = Holder(s: ?t[..])
  print(f(!h, !w))

# errors: 1
# error: 10:5: cannot lend `b` to write while a read loan is live
