# A write through a binding that only reads names what writes: a read
# match of a place, `match !p`; of a part of a value made in the
# header, that value bound to a name first; of `o?`, `if !o as x`; of
# another value, that value bound to a name first; of a call that
# returns a read view, a write view instead; and `if o as x` of a place,
# `if !o as x`.

struct P
  t: Text

enum E
  a(w: !P)
  b

struct H
  e: E

fun mk(p: !P) -> H from p
  H(e: E.a(!p))

fun peek(h: ?H) -> ?E from h
  ?h.e

sub place(p: !P)
  e = E.a(!p)
  match e
    .a(w) => w.t = Text("x")
    .b => pass

sub held(p: !P)
  match mk(!p).e
    .a(w) => w.t = Text("x")
    .b => pass

fun unwrapped(p: !P) -> Int?
  o: E? = E.a(!p)
  match o?
    .a(w) => w.t = Text("x")
    .b => pass
  1

sub coalesce(p: !P)
  o: E? = E.a(!p)
  match o ?? E.b
    .a(w) => w.t = Text("x")
    .b => pass

sub viewed_call(h: ?H)
  match peek(h)
    .a(w) => w.t = Text("x")
    .b => pass

sub optional(p: !P)
  o: (!P)? = !p
  if o as x
    x.t = Text("x")

sub main()
  pass

