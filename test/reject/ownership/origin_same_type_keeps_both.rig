# Without `from`, a result carries every argument whose type could hold
# what it views: two arguments of the same type stay lent.

fun first(a: ?Vec[Int], b: ?Vec[Int]) -> ?Vec[Int]
  a

sub main
  x: Vec[Int] = Vec()
  y: Vec[Int] = Vec()
  r = first(?x, ?y)
  !y.push(1)
  print(r.len)

# error: 11:3: cannot write-borrow `y` while a read borrow is live
