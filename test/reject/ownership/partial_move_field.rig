# Moving a resource field out of an owned local struct is rejected: the
# struct's drop glue would still drop the field at scope exit. Move the
# struct whole, or clone a shared field with `+p.a`.

struct Wrap
  payload: Int

  drop(!self)
    print(self.payload + 100)

struct Pair
  a: *Wrap
  b: *Wrap

sub eat(rc: *Wrap)
  print(rc.payload)

sub main()
  p = Pair(a: *Wrap(payload: 1), b: *Wrap(payload: 2))
  eat(<p.a)
  print("after")

# error: cannot move out of `p.a`: `p` would still drop it
