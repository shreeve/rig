# A lend is never the base of a path: `(!p).x`, `(?v).len`, and
# `(!arr)[0..1]` are rejected wherever they stand, each once, with the
# statement written as it should be. The lend goes on the whole path
# (`!p.items.push(3)`, `if !o[0] as w`, `match !p.e`, `for x in !p.items`,
# `?arr[0..1]`), and an assignment or a read needs none (`p.x = 5`,
# `arr[i] += 7`, `v.len`).

enum E
  a(n: Int)
  b

struct Set
  items: Vec[Int]

  fun insert(!self, k: Int) -> Bool
    !self.items.push(k)
    true

struct Q
  n: Int

  sub bump(!self)
    self.n += 1

struct P
  x: Int
  o: Int?
  e: E
  items: Vec[Int]
  a: [2]Int
  s: Set

sub bump(n: !Int)
  n += 1

fun total(xs: ![]Int) -> Int
  xs[0] + xs[1]

sub set(v: !Vec[Int], q: !P)
  (!v)[0] = 4
  (!q).x += 1

sub main()
  p = P(x: 1, o: 2, e: E.a(n: 1), items: Vec(), a: [1, 2], s: Set(items: Vec()))
  arr = [1, 2]
  o: [2]Int? = [5, none]
  qs = [Q(n: 1), Q(n: 2)]
  v: Vec[Int] = Vec()
  t = "hi"
  i = 1
  (!p).x = 5
  (!arr)[i] += 7
  (!(!p).a)[0] = 3
  (!p).a[1] = 4
  (!qs)[0].n = 5
  if !(!o)[0] as w
    w += 1
  if <(!o)[0] as m
    print(m)
  if (!p).o as k
    print(k)
  while (!p).o as k
    print(k)
    p.o = none
  match !(!p).e
    .a(n) => n += 1
    .b => pass
  match (?p).e
    .a(n) => print(n)
    .b => pass
  for x in !(!p).items
    x += 1
  for x in (!p).items
    print(x)
  (!p).items.push(3)
  print((!p).s.insert(1))
  !(!qs)[1].bump()
  bump(!(!arr)[0])
  f = (!p).x
  g = (?v).len
  h = (!t).len
  s = ?(!arr)[0..1]
  n = total(!(!arr)[0..2])
  c = <(!p).o
  print(f, g, h, s, n, c)

