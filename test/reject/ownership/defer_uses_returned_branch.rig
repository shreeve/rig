# `return v` and a bare `v` in a returned branch move `v` out before the
# defers of the function run.

fun early(c: Bool) -> List[Int]
  v: List[Int] = List()
  defer print(v.len)
  return v if c
  List()

fun pick(c: Bool) -> List[Int]
  a: List[Int] = List()
  b: List[Int] = List()
  defer !a.push(1)
  if c
    a
  else
    <b

sub main()
  x = early(true)
  y = pick(true)
  print(x.len, y.len)

# error: use of `v` after move
# error: use of `a` after move
