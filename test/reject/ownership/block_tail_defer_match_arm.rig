# A `match` arm's block-local tail leaves the arm before its defer runs.
sub main()
  k = 0
  x = match k
    0
      v: Vec[Int] = Vec()
      !v.push(1)
      defer
        for i in 0..100
          !v.push(i)
      v
    _
      w: Vec[Int] = Vec()
      w
  !x.push(3)
  print(x.len, x[0])

# error: 10:12: use of `v` after move
# errors: 1
