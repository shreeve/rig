# A value that holds a Cell lives only behind a shared handle, so a
# `for` header cannot make one by value to lend: the made value is
# rejected where it is written.

struct Counter
  hits: Cell[Int]

sub main()
  for k in ?[Counter(hits: Cell(1))]
    print(k.hits.get())

# error: 9:14: `Counter(hits: Cell(1))` makes a `Counter`, which holds a Cell, so it lives only behind a shared handle: write `*Counter(hits: Cell(1))`
# errors: 1
