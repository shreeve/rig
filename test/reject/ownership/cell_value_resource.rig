# Reading `cell.value` on a Cell of shared handles is rejected: the copy
# would alias the owned handle.

struct User
  age: Int

sub main()
  u: *User = *User(age: 30)
  c: Cell(*User) = Cell(value: <u)
  view = c.value
  print(0)

# error: `cell.value` reads `T` by value but `T = *User` has drop glue
