# An iterator a method returns views the place it came from, so the
# loop keeps that place lent: the lend is written on the receiver, as
# `for x in ?b.each()`. No iterator holds a write view, so `!` before
# the source is rejected.

obj Cur
  xs: ?List[Int]
  i: Int

  fun next(!self) -> Int?
    return none if self.i >= self.xs.len
    self.i += 1
    self.xs[self.i - 1]

obj Bag
  xs: List[Int]

  fun each(?self) -> Cur from self
    Cur(xs: ?self.xs, i: 0)

sub main()
  b = Bag(xs: List())
  !b.xs.push(4)
  for x in b.each()
    print(x)
  for x in !b.each()
    print(x)

# error: 24:12: `b.each()` keeps `b` lent while the loop walks it; write `for ... in ?b.each()`
# error: 26:13: `!b.each()` advances a place, and this is a value made here, which holds no write view; write `for x in ?b.each()`, which holds it for the loop
# errors: 2
