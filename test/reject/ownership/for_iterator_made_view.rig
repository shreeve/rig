# An iterator a method returns views the place it came from, so the
# loop cannot hold it as a made value. Every hint names the form that
# compiles: bind the iterator with the lend written, then advance it.

obj Cur
  xs: ?List[Int]
  i: Int

  fun next(!self) -> Int?
    return none if self.i >= self.xs.len
    self.i += 1
    self.xs[self.i - 1]

obj Bag
  xs: List[Int]

  fun each(?self) -> Cur from self
    Cur(xs: ?self.xs, i: 0)

sub main()
  b = Bag(xs: List())
  !b.xs.push(4)
  for x in b.each()
    print(x)
  for x in ?b.each()
    print(x)
  for x in !b.each()
    print(x)

# error: 23:12: `b.each()` keeps `b` lent while the loop walks it; bind the iterator first, `it = ?b.each()`, then write `for ... in !it`
# error: 25:13: `for x in ?b.each()` would only read an iterator made here, which `next` cannot advance; it views a place it keeps lent, so bind it first: `it = ?b.each()`, then `for x in !it`
# error: 27:13: `!b.each()` advances a place, and this is a value made here; it views a place it keeps lent, so bind it first: `it = ?b.each()`, then `for x in !it`
# errors: 3
