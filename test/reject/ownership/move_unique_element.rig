# A unique element stays in its array, and a field in its struct: `<`
# cannot take one out while the container still holds it.

struct Counter
  hits: Cell[Int]

struct H
  c: Counter
  n: Int

sub main()
  a = [Counter(hits: Cell(0)), Counter(hits: Cell(0))]
  k = <a[0]
  h = H(c: Counter(hits: Cell(1)), n: 1)
  j = <h.c
  print(k.hits.get(), j.hits.get())

# error: 13:8: cannot move out of `a[...]`: elements cannot be moved out of their container
# error: 15:8: cannot move out of `h.c`: `h` would still drop it
