# A write view is never held in a field, so no `<h.w` can move one out
# of its holder: the field is rejected where it is declared.

struct H
  w: !Int

sub main()
  n = 1
  h = H(w: !n)
  x = <h.w
  x += 1
  print(n)

# error: 5:6: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
