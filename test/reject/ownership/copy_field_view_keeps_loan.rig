# A struct cannot hold `!Int`: a write view is never stored inside a
# value, so no struct carries a write loan past the call that lends it.

struct H
  w: !Int

sub main()
  n = 1
  h = H(w: !n)
  print(n)
  h.w += 1

# error: 5:6: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
