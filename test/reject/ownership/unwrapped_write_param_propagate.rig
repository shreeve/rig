# A store through `w?`, the write view a `(!H)?` parameter holds, lands
# in the caller's value, which outlives this function's own: a view of a
# local may not go there, as through a `!H` parameter.

obj H
  s: ?String

  sub keep(!self, v: ?String) keeps v
    self.s = v

fun set(w: (!H)?) -> Int?
  d = String("local")
  w?.s = ?d
  0

sub main()
  t = String("outer")
  h = H(s: ?t)
  print(set(!h))
  print(h.s)

# errors: 1
# error: 13:3: cannot store a view of `d` through `w?`: `w` outlives it
