# A read `match` binding views the subject where it is, so a view of
# one lives as long as the subject's loan allows, and no longer: it is
# not returned from a function that owns the subject, the subject may
# not change, move, or end while the view is used, and a view of a value
# the header makes ends with the header.

struct Res
  n: Int
  t: Text

enum E
  a(r: Res)
  b

struct H
  e: E

fun mk() -> E
  E.a(r: Res(n: 1, t: Text("m")))

fun mkh() -> H
  H(e: mk())

fun local(d: ?Res) -> ?Res from d
  e = mk()
  match e
    .a(r) => ?r
    .b => d

sub changed()
  e = mk()
  k = Res(n: 0, t: Text("k"))
  saved = ?k
  match e
    .a(r) => saved = ?r
    .b => pass
  e = E.b
  print(saved.n)

sub moved()
  e = mk()
  k = Res(n: 0, t: Text("k"))
  saved = ?k
  match e
    .a(r) => saved = ?r
    .b => pass
  f = <e
  print(saved.n)

sub dropped()
  k = Res(n: 0, t: Text("k"))
  saved = ?k
  match mkh().e
    .a(r) => saved = ?r
    .b => pass
  print(saved.n)

sub inner()
  k = Res(n: 0, t: Text("k"))
  saved = ?k
  if true
    e = mk()
    match e
      .a(r) => saved = ?r
      .b => pass
  print(saved.n)

sub main()
  changed()

