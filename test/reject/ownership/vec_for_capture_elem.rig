# The element of `for cb in ?subs` is a borrow; clone-capturing it into
# a lambda is rejected.

sub main()
  count: *Cell(Int) = *Cell(value: 0)
  cb1: *Closure() = *Closure(|+count| count.set(count.get() + 1))

  subs: Vec(*Closure()) = Vec()
  (!subs).push(+cb1)

  for cb in ?subs
    f = |+cb| cb()
    f()

# error: clone-capture `|+cb|` requires a shared `*T`, weak `~T`, or Copy type
