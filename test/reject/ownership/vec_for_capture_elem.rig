# The element of `for cb in ?subs` is a borrow; clone-capturing it into
# a lambda is rejected.

sub main()
  count: *Cell(Int) = *Cell(value: 0)
  cb1: *sub() = *|+count| count.set(count.get() + 1)

  subs: Vec(*sub()) = Vec()
  (!subs).push(+cb1)

  for cb in ?subs
    f = |+cb| cb()
    f()

# error: `|+cb|` copies a Copy value or clones a `*T` / `~T` handle, but `cb` is `?*sub()`
