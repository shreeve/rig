# `*o` moves `o` into a new counted handle; with a bare name that would leave
# `o` owning the same resources. Write `*<o`.

obj Wrap
  payload: Int

obj Owner
  b: *Wrap

sub main()
  o = Owner(b: *Wrap(payload: 3))
  s = *o
  print(1)

# error: `o` owns an `Owner`, which can't be copied into a counted handle: write `<o` to move it or `+o` to clone it
