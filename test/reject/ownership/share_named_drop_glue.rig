# `*o` moves `o` into a new shared box; with a bare name that would leave
# `o` owning the same resources. Write `*<o`.

struct Wrap
  payload: Int

struct Owner
  b: *Wrap

sub main()
  o = Owner(b: *Wrap(payload: 3))
  s = *o
  print(1)

# error: `o` owns an `Owner`, which can't be copied into a shared box: write `<o` to move it or `+o` to clone it
