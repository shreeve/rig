# `*o` moves `o` into a new shared box; with a bare name that would leave
# `o` owning the same resources. Write `*<o`.

struct Box
  payload: Int

struct Owner
  b: *Box

sub main()
  o = Owner(b: *Box(payload: 3))
  s = *o
  print(1)

# error: bare use of `Owner` value `o` in shared allocation would alias an owning value
