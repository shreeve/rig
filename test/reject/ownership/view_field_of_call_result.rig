# A view of a field reached through a view a call returns keeps what
# the call views, bound by `=` or by `as`.

obj R
  n: Int

obj H2
  r: R
  b: ^R?

obj H
  h2: H2

fun inner(h: ?H) -> ?H2
  ?h.h2

sub main()
  h = H(h2: H2(r: R(n: 1), b: ^R(n: 1)))
  x = ?inner(?h).r
  h = H(h2: H2(r: R(n: 2), b: none))
  print(x.n)
  if ?inner(?h).b as y
    h = H(h2: H2(r: R(n: 3), b: none))
    print(y.n)
  while ?inner(?h).b as y
    h = H(h2: H2(r: R(n: 4), b: none))
    print(y.n)

# error: 20:3: cannot reassign `h` while it is lent
# error: 23:5: cannot reassign `h` while it is lent
# error: 26:5: cannot reassign `h` while it is lent
