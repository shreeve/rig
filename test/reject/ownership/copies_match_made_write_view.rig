# A `match` takes a value made in its subject only when the value moves
# (it owns or is unique); a write view a call returns does not copy, but
# stays a view, so a read `match` of it binds read views of its payload,
# which cannot be written.

struct Res
  n: Int
  t: Text

enum E
  a(r: Res)
  b

fun getw(e: !E) -> !E
  e

sub main
  e = E.a(r: Res(n: 1, t: Text("x")))
  match getw(!e)
    .a(r) => r.n = 60
    .b => pass
  print(e)

# error: 20:14: cannot assign through a read view (`?T`); take a write view (`!T`) to mutate
