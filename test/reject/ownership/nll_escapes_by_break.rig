# A borrow of a loop-body local that is used after the loop cannot
# leave the loop by `break`.

struct Wrap
  n: Int

  sub bump(!self)
    self.n += 1

  drop(!self)
    print("drop", self.n)

sub main()
  a = Wrap(n: 1)
  r = ?a
  while true
    b = Wrap(n: 2)
    r = ?b
    break
  print(r.n)

# error: `b` does not live long enough
