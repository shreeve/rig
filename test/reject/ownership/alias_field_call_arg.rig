# Passing a shared-handle field as an owned argument would copy the
# handle without a refcount bump.

struct Wrap
  payload: Int

struct Outer
  inner: *Wrap

sub eat(rc: *Wrap)
  print(rc.payload)

sub main()
  b = *Wrap(payload: 7)
  o = *Outer(inner: <b)
  eat(o.inner)
  eat(o.inner)

# error: 16:7: `eat` takes ownership of a `*Wrap`, and `o.inner` can't be copied: write `+o.inner` for another handle; if `eat` only reads it, make its parameter a `?*Wrap`
# error: 17:7: `eat` takes ownership of a `*Wrap`, and `o.inner` can't be copied: write `+o.inner` for another handle; if `eat` only reads it, make its parameter a `?*Wrap`
