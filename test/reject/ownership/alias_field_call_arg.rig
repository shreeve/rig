# Passing a shared-handle field as an owned argument would copy the
# handle without a refcount bump.

struct Wrap
  payload: Int

struct Outer
  inner: *Wrap

sub eat(rc: *Wrap)
  print(rc.payload)

sub main()
  b = *Wrap(payload: 7)
  o = *Outer(inner: <b)
  eat(o.inner)
  eat(o.inner)

# error: would alias the handle
