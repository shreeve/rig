# A bare write-view field or element reads the value it sees only where
# that value copies (a number, `Bool`, `String`, or plain enum) and the
# context takes a value: a write view of anything else, or one bound
# with a `!T` type, would be copied out of its holder. A String copied
# out of a `!String` field keeps viewing the Text it views.
# oracle: owner_field reject C2
# oracle: plain_field reject C2
# oracle: typed_view reject C2
# oracle: element_view reject C2
# oracle: string_view reject C4

struct P
  x: Int

struct H
  w: !Int
  v: !Vec[Int]
  p: !P

struct HS
  s: !String

sub owner_field
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  y = h.v
  print(y.len)

sub plain_field
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  q = h.p
  print(q.x)

sub typed_view
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  w: !Int = h.w
  w += 1

sub element_view
  a = 1
  ws: Vec[!Int] = Vec()
  !ws.push(!a)
  w: !Int = ws[0]
  w += 1

sub string_view
  t = Text("abc")
  s: String = ?t
  hs = HS(s: !s)
  x = hs.s
  !t.add("d")
  print(x)

sub main
  owner_field()

# error: 28:7: bare use of `h.v` in binding would copy a write view; a field cannot be moved out of its parent
# error: 36:7: bare use of `h.p` in binding would copy a write view; a field cannot be moved out of its parent
# error: 44:13: bare use of `h.w` in binding would copy a write view; a field cannot be moved out of its parent
# error: 51:13: bare use of `ws[...]` in binding would copy a write view; an element cannot be moved out of its container
# error: 59:3: cannot lend `t` to write while a read loan is live
# errors: 5
