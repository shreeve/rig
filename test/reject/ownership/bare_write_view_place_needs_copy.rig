# A binding takes the type of what is on its right (Core §5): bound
# without a type, a write-view field or element, or a branching value of
# them, would copy the write view out of what holds it, and so would one
# bound with a `!T` type. An annotation reads the value only where it
# copies (a number, `Bool`, `String`, or plain enum). A String read out
# of a `!String` field keeps viewing the Text it views.
# oracle: untyped_field reject C2
# oracle: untyped_element reject C2
# oracle: untyped_branches reject C2
# oracle: owner_field reject C2
# oracle: plain_field reject C2
# oracle: typed_view reject C2
# oracle: element_view reject C2
# oracle: string_view reject C4

struct P
  x: Int

struct H
  w: !Int
  v: !Vec[Int]
  p: !P

struct HS
  s: !String

fun pick -> Bool
  true

sub untyped_field
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  x = h.w
  print(x)

sub untyped_element
  a = 1
  ws: Vec[!Int] = Vec()
  !ws.push(!a)
  w = ws[0]
  print(w)

sub untyped_branches
  n = 1
  m = 2
  xs: Vec[Int] = Vec()
  ys: Vec[Int] = Vec()
  p = P(x: 1)
  q = P(x: 2)
  h = H(w: !n, v: !xs, p: !p)
  g = H(w: !m, v: !ys, p: !q)
  y = h.w if pick() else g.w
  print(y)

sub owner_field
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  y = h.v
  print(y.len)

sub plain_field
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  q = h.p
  print(q.x)

sub typed_view
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  w: !Int = h.w
  w += 1

sub element_view
  a = 1
  ws: Vec[!Int] = Vec()
  !ws.push(!a)
  w: !Int = ws[0]
  w += 1

sub string_view
  t = Text("abc")
  s: String = ?t
  hs = HS(s: !s)
  x: String = hs.s
  !t.add("d")
  print(x)

sub main
  owner_field()

# error: 35:7: bare use of `h.w` in binding would copy a write view, which is unique; write `x: Int = h.w` to read its value, or `x = !h.w` to lend the view on
# error: 42:7: bare use of `ws[0]` in binding would copy a write view, which is unique; write `w: Int = ws[0]` to read its value, or `w = !ws[0]` to lend the view on
# error: 54:7: bare use of `h.w` in binding would copy a write view; a field cannot be moved out of its parent
# error: 54:26: bare use of `g.w` in binding would copy a write view; a field cannot be moved out of its parent
# error: 62:7: bare use of `h.v` in binding would copy a write view, which is unique; write `y = !h.v` to lend the view on
# error: 70:7: bare use of `h.p` in binding would copy a write view, which is unique; write `q = !h.p` to lend the view on
# error: 78:13: bare use of `h.w` in binding would copy a write view, which is unique; write `w: Int = h.w` to read its value, or `w = !h.w` to lend the view on
# error: 85:13: bare use of `ws[0]` in binding would copy a write view, which is unique; write `w: Int = ws[0]` to read its value, or `w = !ws[0]` to lend the view on
# error: 93:3: cannot lend `t` to write while a read loan is live
# errors: 9
