# A bare name or place only reads (Core sentence 1), but only a value
# that copies is read out of a write view: a number, `Bool`, `String`,
# or plain enum. A bare field or element that is a write view of
# anything else would copy the view out of its holder, and so would one
# bound with a `!T` type. A String read out of a `!String` field keeps
# viewing the Text it views.
# oracle: owner_field reject C2
# oracle: plain_field reject C2
# oracle: typed_view reject C2
# oracle: element_view reject C2
# oracle: string_view reject C4

struct P
  x: Int

struct H
  w: !Int
  v: !Vec[Int]
  p: !P

struct HS
  s: !String

sub owner_field
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  y = h.v
  print(y.len)

sub plain_field
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  q = h.p
  print(q.x)

sub typed_view
  n = 1
  xs: Vec[Int] = Vec()
  p = P(x: 1)
  h = H(w: !n, v: !xs, p: !p)
  w: !Int = h.w
  w += 1

sub element_view
  a = 1
  ws: Vec[!Int] = Vec()
  !ws.push(!a)
  w: !Int = ws[0]
  w += 1

sub string_view
  t = Text("abc")
  s: String = ?t
  hs = HS(s: !s)
  x = hs.s
  !t.add("d")
  print(x)

sub main
  owner_field()

# error: 29:7: bare use of `h.v` in binding would copy a write view, which is unique; write `y = !h.v` to lend the view on
# error: 37:7: bare use of `h.p` in binding would copy a write view, which is unique; write `q = !h.p` to lend the view on
# error: 45:13: bare use of `h.w` in binding would copy a write view, which is unique; write `w = h.w` to read its value, or `w = !h.w` to lend the view on
# error: 52:13: bare use of `ws[0]` in binding would copy a write view, which is unique; write `w = ws[0]` to read its value, or `w = !ws[0]` to lend the view on
# error: 60:3: cannot lend `t` to write while a read loan is live
# errors: 5
