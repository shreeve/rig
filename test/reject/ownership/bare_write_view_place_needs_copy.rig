# A bare field or element of a value never copies a write view out of
# it, because a write view is never stored inside a value: not as a
# field of any type, nor as a Vec's element. Each is rejected where it
# is written.

struct P
  x: Int

struct H
  w: !Int
  v: !Vec[Int]
  p: !P

struct HS
  s: !String

sub main()
  ws: Vec[!Int] = Vec[!Int]()
  print(ws.len)

# error: 10:6: a write view is never stored inside a value, and `!Int` cannot stand here
# error: 11:6: a write view is never stored inside a value, and `!Vec[Int]` cannot stand here
# error: 12:6: a write view is never stored inside a value, and `!P` cannot stand here
# error: 15:6: a write view is never stored inside a value, and `!String` cannot stand here
# error: 18:11: a write view is never stored inside a value, and `!Int` cannot stand here
# error: 18:19: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 6
