# `for x in <v` moves `v`: it cannot be used afterwards, consumed while
# viewed, or consumed again by a later loop iteration.

obj B
  n: Int

sub main()
  v: List[*B] = List()
  for x in <v
    print(x.n)
  print(v.len)

  w: List[*B] = List()
  r = ?w
  for x in <w
    print(x.n)
  print(r.len)

  u: List[*B] = List()
  i = 0
  while i < 2
    for x in <u
      print(x.n)
    i += 1

# error: use of `v` after move
# error: cannot move `w` while a read loan is live
# error: use of `u` after move
