# A loop over a List whose elements move walks a List a name holds, or a
# field or element of one. Any other source, a List made here (bare,
# taken, or lent), a call's returned view of one, a part of a value made
# here, or a branching value, gets one diagnostic, whose hint compiles
# (`test/behavior/ownership/vec_for_moving_elements_bound.rig`); a
# branching value is read in place, so it is a lend of a name it may be.

obj H
  items: List[String]

fun mk() -> List[String]
  v: List[String] = List()
  !v.push(String("a"))
  v

fun mkh() -> H
  H(items: mk())

fun items(v: ?List[String], k: ?List[String]) -> ?List[String]
  v

sub main()
  v = mk()
  k = mk()
  c = v.len > 0
  for x in mk()
    print(x)
  for x in <mk()
    print(x)
  for x in ?mk()
    print(x)
  for x in !mk()
    print(x)
  for x in items(?v, ?k)
    print(x)
  for x in mkh().items
    print(x)
  for x in v if c else k
    print(x)

