# Assigning a `!T` binding writes through it, so a value goes there. A
# write borrow on the right (`!m`, a moved `<w2`, or an expression that
# yields one) would be a re-point; that takes a new binding.

fun slot(a: !Int) -> !Int
  a

sub moved
  m = 1
  n = 2
  w = !m
  w2 = !n
  w = <w2
  print(m, n)

sub branches(c: Bool)
  m = 1
  n = 2
  k = 3
  w = !m
  w2 = !n
  w3 = !k
  w = <w2 if c else <w3
  print(m, n, k)

sub called
  m = 1
  n = 2
  w = !m
  w = slot(!n)
  print(m, n)

sub param(w: !Int, other: !Int)
  w = <other

sub slice
  a = [1, 2]
  b = [3, 4]
  s = !a
  s2 = !b
  s = <s2
  print(a, b)

sub element(xs: ![]Int, other: !Int)
  for x in !xs
    x = <other

sub main
  m = 1
  n = 2
  moved()
  branches(true)
  called()
  param(!m, !n)
  slice()

# errors: 6
# error: 13:7: `w = <w2` would write through `w`; to point `w` at another place, write `new w = <w2`
# error: 23:7: `w = <w2 if c else <w3` would write through `w`
# error: 30:7: `w = slot(!n)` would write through `w`; to point `w` at another place, write `new w = slot(!n)`
# error: 34:7: `w = <other` would write through `w`; to point `w` at another place, write `new w = <other`
# error: 41:7: `s = <s2` would write through `s`
# error: 46:9: `x = <other` would write through `x`
