# A call evaluates its arguments left to right and uses them all when
# it runs. An argument that reads a value owning storage (a Vec, a Box,
# a shared handle, or a struct holding one) shares that storage with
# the place it reads, so a later argument cannot lend to write or move
# that place: the call would see a stale or freed value. A view, a
# slice, or a read receiver in an earlier argument holds it the same
# way.

struct Node
  n: Int

struct S
  a: Vec[Int]
  b: Int

  fun count(?self, n: Int) -> Int
    self.a.len + n

struct View
  r: ?Vec[Int]
  n: Int

fun grow(v: !Vec[Int]) -> Int
  !v.push(7)
  2

fun eat(v: Vec[Int]) -> Int
  v.len

fun reset(r: !*Node) -> Int
  r = *Node(n: 9)
  0

fun rebox(b: !Box[Int]) -> Int
  b = Box(5)
  0

fun clear(o: !Vec[Int]?) -> Int
  o = none
  0

fun rd(v: ?Vec[Int], n: Int) -> Int
  v.len + n

fun take(s: []Int, n: Int) -> Int
  s.len + n

sub main()
  v: Vec[Int] = Vec()
  !v.push(0)
  print(v, grow(!v), v)
  print(v, eat(<v))
  u: Vec[Int] = Vec()
  w = !u
  print(w, grow(!w))
  s = S(a: Vec(), b: 1)
  print(s, grow(!s.a))
  print(s.a, grow(!s.a))
  rc = *Node(n: 1)
  print(rc, reset(!rc))
  b = Box(3)
  print(b, rebox(!b))
  x: Vec[Int] = Vec()
  print(x, (!x).pop() ?? 0)
  z: Vec[Int] = Vec()
  print(rd(?z, grow(!z)))
  print(take(?z[..], grow(!z)))
  vw = View(r: ?z, n: grow(!z))
  print(z.len, vw.n)
  print(s.count(grow(!s.a)))
  o: Vec[Int]? = Vec()
  print(o, clear(!o))

# error: 51:18: cannot lend `v` to write while an earlier argument's read of it is in use
# error: 52:17: cannot move `v` while an earlier argument's read of it is in use
# error: 55:18: cannot lend `w` to write while an earlier argument's read of it is in use
# error: 57:18: cannot lend `s` to write while an earlier argument's read of it is in use
# error: 58:20: cannot lend `s` to write while an earlier argument's read of it is in use
# error: 60:20: cannot lend `rc` to write while an earlier argument's read of it is in use
# error: 62:19: cannot lend `b` to write while an earlier argument's read of it is in use
# error: 64:13: cannot lend `x` to write while an earlier argument's read of it is in use
# error: 66:22: cannot lend `z` to write while a read loan is live
# error: 67:28: cannot lend `z` to write while a read loan is live
# error: 68:29: cannot lend `z` to write while a read loan is live
# error: 70:23: cannot lend `s` to write while a read loan is live
# error: 72:19: cannot lend `o` to write while an earlier argument's read of it is in use
# errors: 13
