# What `!` on a temporary does not make valid (Core sentences 4, 8, 9,
# §3): a write method with no `!` (the hint adds it); a branching value
# that may be a name's, which would be lent as a copy (each branch is
# lent instead); writing through a shared handle, which only reads; a
# `for` that would walk it after its header; and assigning into it,
# which no `!` marks. A literal is no temporary but a constant, which
# lives for the whole program (Core sentence 7) and is never lent to
# write (`test/reject/types/write_lend_constant.rig`). (A view of a temporary held past its statement:
# `write_lend_temporary_outlives.rig`.)

struct S
  n: Int
  items: Vec[Int]

  sub bump(!self)
    self.n += 1

  fun at(!self) -> !Int
    !self.n

fun mk() -> S
  S(n: 1, items: Vec())

fun mkh() -> *S
  *S(n: 1, items: Vec())

fun mkv() -> Vec[Int]
  Vec()

sub setb(b: !Bool)
  b = true

sub main()
  a = mk()
  b = mk()
  c = a.n == 1
  mkv().push(1)
  !(a if c else b).bump()
  !(*S(n: 1, items: Vec())).bump()
  !mkh().bump()
  for x in !mk().items
    print(x)
  mk().n = 5
  setb(!false)

# error: 37:3: `push` changes its receiver, a temporary no name holds; add `!`: `!mkv().push(...)`
# error: 38:5: cannot lend `a if c else b` to write: it may be `a`, a value a name holds
# error: 39:29: cannot call write-receiver method `bump` through a shared handle
# error: 40:10: cannot call write-receiver method `bump` through a shared handle
# error: 41:13: the loop would walk the temporary `mk()` after its header drops it
# error: 43:3: cannot assign to a field or element of a temporary
# error: 44:9: cannot lend constant `false` to write: it lives for the whole program
