# A variant's one field given by position is moved in, as by name: an
# owning value takes `<`.

enum Option[T]
  some(value: T)
  nothing

sub main()
  v: Vec[Int] = Vec()
  o: Option[Vec[Int]] = .some(v)
  p = Option.some(v)
  print(v.len)

# error: 10:31: `v` owns a `Vec[Int]`, which can't be copied into an argument: write `<v` to move it or `+v` to pass a clone
# error: 11:19: `some` takes ownership of a `Vec[Int]`, and `v` can't be copied: write `<v` to move it or `+v` to pass a clone; if `some` only reads it, make its parameter a `?Vec[Int]`
