# Each mistake around write slices gets one diagnostic that names it,
# and no hint that suggests code which fails too.

struct S
  arr: [2]Int

fun by_value(a: [2]Int) -> ![]Int
  !a[..]

sub shared()
  h: *S = *S(arr: [1, 2])
  h.arr.fill(4)

sub main()
  shared()

# error: 8:4: cannot write-borrow parameter `a`
# error: 12:3: cannot write-borrow through a shared handle
