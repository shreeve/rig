# A view reached through a write view keeps its holder lent: two items a
# write cursor hands out could alias, so the second call is rejected.

struct Item
  n: Int

struct Cursor
  items: ![]Item
  i: Int

  fun next(!self) -> !Item
    k = self.i
    self.i += 1
    !self.items[k]

sub main()
  a = [Item(n: 1), Item(n: 2)]
  c = Cursor(items: !a, i: 0)
  x = (!c).next()
  y = (!c).next()
  x.n = 5
  print(y.n)

# error: 20:9: use of `c` while a write loan is live
