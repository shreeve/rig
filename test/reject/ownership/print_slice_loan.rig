# A slice that `print` or `String` reads implicitly is lent to read as
# `?v[..]` would be: the loan lasts the statement, so a later argument
# may not write the owner.

fun bump(v: !List[Int]) -> Int
  !v.push(1)
  v.len

sub main()
  v: List[Int] = List()
  !v.push(1)
  print(v[..], (!v).pop())
  w: List[Int] = List()
  t = String(w[..], bump(!w))
  print(t)

# errors: 2
# error: 12:17: cannot lend `v` to write while a read loan is live
# error: 14:27: cannot lend `w` to write while a read loan is live
