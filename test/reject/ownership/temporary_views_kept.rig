# A view of a temporary cannot outlive its statement, which drops the
# temporary: not in a binding, a field, a List, or a result. A `while`
# header's temporaries last one pass, since the next pass evaluates the
# header again, so a view kept for a later pass is rejected.

use std.text

obj E
  s: ?String

fun f() -> ?String
  text.trim(?String(" x "))

sub main()
  s = text.trim(?String(" a "))
  e = E(s: text.trim(?String(" b ")))
  v: List[?String] = List()
  !v.push(text.trim(?String(" c ")))
  r = ?String("d")
  last: ?String = "none"
  while text.cut(?String("k=v"), "=") as kw
    print(last)
    last = kw.after
  print(s, e, v, r, f())

# error: 12:14: cannot return a view of `String(" x ")`, which this function was not lent
# error: 15:18: a view of the temporary `String(" a ")` outlives its statement
# error: 16:23: a view of the temporary `String(" b ")` outlives its statement
# error: 18:22: a view of the temporary `String(" c ")` outlives its statement
# error: 19:8: a view of the temporary `String("d")` outlives its statement
# error: 21:19: a view of the temporary `String("k=v")` outlives its statement
# errors: 6
