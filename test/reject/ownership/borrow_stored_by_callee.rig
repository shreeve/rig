# A call may store the borrows it is given into its `!` arguments, so
# after `put(!v, ?b)` the view keeps `b` borrowed.

struct Wrap
  payload: Int
  log: Vec[Int]

struct View
  box: ?Wrap

sub put(v: !View, b: ?Wrap)
  v.box = b

sub main()
  a = Wrap(payload: 1, log: Vec())
  b = Wrap(payload: 2, log: Vec())
  v = View(box: ?a)
  put(!v, ?b)
  -b
  print(v.box.payload)

# error: cannot drop `b` while borrows are live
