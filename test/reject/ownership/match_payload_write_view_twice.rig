# A `match !h` payload lends to write its scrutinee while it is live, so
# a nested match on the same value cannot bind a second view of it.

struct Wrap
  v: Vec[Int]

enum Hold
  none_
  has(w: Wrap)

sub main()
  x = Wrap(v: Vec())
  !x.v.push(1)
  h: Hold = .has(<x)
  match !h
    .has(a)
      for n in ?a.v
        match !h
          .has(b)
            b.v = Vec()
          .none_
            print("n")
        print(n)
    .none_
      print("none")

# error: 18:16: cannot lend `h` to write while a write loan is live
