# A `for ... else` value's block-local tail leaves the `else` block
# before its defer runs.
sub main()
  xs = [1, 2]
  x = for k in xs
    break List[Int]() if k > 5
  else
    v: List[Int] = List()
    !v.push(1)
    defer !v.push(2)
    v
  !x.push(3)
  print(x.len, x[0])

# error: 10:12: use of `v` after move
# errors: 1
