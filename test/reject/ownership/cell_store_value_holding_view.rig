# A Cell is reached through every clone of its handle and every view
# of it, so a value put in it (`Cell(v)`, `set`, `replace`) may
# not hold a view: another path to the cell could read it after the
# viewed value is gone.

obj Wrap
  v: List[Int]

obj View
  b: ?Wrap

sub stash(c: !Cell[*View], vw: *View)
  !c.set(<vw)

sub park(h: *Cell[*View])
  x = Wrap(v: List())
  !x.v.push(42)
  _ = !h.replace(*View(b: ?x))

sub main()
  y0 = Wrap(v: List())
  a: *Cell[*View] = *Cell(*View(b: ?y0))
  if true
    x = Wrap(v: List())
    !x.v.push(41)
    b = +a
    !b.set(*View(b: ?x))
  park(+a)
  print("done")

# error: cannot store a view of `vw` in a `Cell`
# error: cannot store a view of `x` in a `Cell`
# error: cannot store a view of `y0` in a `Cell`
