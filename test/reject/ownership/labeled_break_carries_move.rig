# The state at `break :outer` flows to the end of the outer loop: a value
# moved before it may be gone there.

struct Wrap
  payload: Int

sub eat(b: *Wrap)
  print(b.payload)

sub main()
  rc = *Wrap(payload: 1)
  :outer while true
    while true
      eat(<rc)
      break :outer
  print(rc.payload)

# error: use of `rc` after move
