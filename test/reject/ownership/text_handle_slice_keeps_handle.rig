# A slice of a Text reached through a handle (`*String`) lends the
# handle (Core §4: a `*T` lends the read views of its `T`): the handle may
# not be dropped, moved, or replaced while the String is used.

obj W
  t: *String

fun peek(h: *String) -> ?String
  ?h[..]

sub local()
  h = *String("hello")
  s = ?h[..]
  <h
  print(s)

sub field()
  w = W(t: *String("hello"))
  s = ?w.t[1..]
  w = W(t: *String("other"))
  print(s)

sub upgraded()
  h = *String("hello")
  w = ~h
  if *w as g
    s = ?g[1..]
    <g
    print(s)

sub main()
  local()
  field()
  upgraded()

# errors: 4
# error: 9:4: cannot return a view of `h`
# error: 14:4: cannot drop `h` while it is lent
# error: 20:3: cannot reassign `w` while `w.t` is lent
# error: 28:6: cannot drop `g` while it is lent
