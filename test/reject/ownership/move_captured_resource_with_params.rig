# Moving a captured resource out is rejected in an owned closure that
# takes parameters too.

sub takes_owned(c: *Cell[Int])
  !c.set(0)

sub main()
  sig: *Cell[Int] = *Cell(0)
  bad: *sub(Int) = *|+sig, a: Int| takes_owned(<sig)

# error: cannot move captured `sig`: the closure keeps what it captures for every call; write `+sig` for another handle, or `~sig` for a weak one
