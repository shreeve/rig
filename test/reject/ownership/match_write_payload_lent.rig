# A binding of `match !e` is a write view of the payload it binds, so a
# lend of it is a loan on the binding, as a lend of any write view is
# (`!T` parameters, `if !o as w`, `for x in !v`): while a view of it is
# live, nothing writes through the binding. Each binding kind, payload
# type, and lend is rejected at the write, a bare slice argument's
# read lend too.
# oracle: slice reject C4
# oracle: argument reject C4
# oracle: whole reject C4
# oracle: reassign reject C4
# oracle: param reject C4
# oracle: boxed_subject reject C4
# oracle: named reject C4
# oracle: box_payload reject C4
# oracle: vec_payload reject C4
# oracle: struct_payload reject C4
# oracle: catch_all reject C4
# oracle: nested reject C4
# oracle: read_call reject C4
# oracle: held_subject reject C4
# oracle: field_subject reject C4
# oracle: bare_argument reject C4

use std.text

enum E
  a(t: Text)
  b

enum N
  a(t: Text, n: Int)
  b

enum B
  a(b: Box[Text])
  b

enum V
  a(xs: Vec[Int])
  b

struct P
  t: Text
  xs: Vec[Int]

enum S
  a(p: P)
  b

enum O
  a(e: E)
  b

struct HE
  e: E

fun keep(s: String) -> String
  s

fun keepv(s: []Int) -> []Int
  s

sub slice()
  e = E.a(Text("hello"))
  match !e
    .a(t)
      s = ?t[1..]
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub argument()
  e = E.a(Text("hello"))
  match !e
    .a(t)
      s = keep(?t[1..])
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub whole()
  e = E.a(Text("hello"))
  match !e
    .a(t)
      r = ?t
      !t.add("x")
      print(r)
    .b => pass

sub reassign()
  e = E.a(Text("hello"))
  match !e
    .a(t)
      s = keep(?t[1..])
      t = Text("other")
      print(s)
    .b => pass

sub param(e: !E)
  match !e
    .a(t)
      s = ?t[1..]
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub boxed_subject()
  e = Box(E.a(Text("hello")))
  match !e
    .a(t)
      s = ?t[1..]
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub named()
  e = N.a(t: Text("hello"), n: 1)
  match !e
    .a(t: x)
      s = ?x[1..]
      !x.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    _ => pass

sub box_payload()
  e = B.a(Box(Text("hello")))
  match !e
    .a(b)
      s = keep(?b[1..])
      b = Box(Text("other"))
      print(s)
    .b => pass

sub vec_payload()
  v: Vec[Int] = Vec()
  !v.push(1)
  e = V.a(<v)
  match !e
    .a(xs)
      r = ?xs
      !xs.push(2)
      print(r.len)
      s = ?xs[..]
      !xs.push(3)
      print(s)
    .b => pass

sub struct_payload()
  e = S.a(P(t: Text("hello"), xs: Vec()))
  match !e
    .a(p)
      s = ?p.t[1..]
      !p.t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
      r = ?p.xs[..]
      !p.xs.push(1)
      print(r)
    .b => pass

sub catch_all()
  e = E.a(Text("hello"))
  match !e
    x
      r = ?x
      x = E.b
      print(r)

sub nested()
  e = O.a(E.a(Text("hello")))
  match !e
    .a(i)
      match !i
        .a(t)
          s = ?t[1..]
          !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
          print(s)
        .b => pass
    .b => pass

sub read_call()
  e = E.a(Text("  hello  "))
  match !e
    .a(t)
      s = text.trim(?t)
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub held_subject()
  e = E.a(Text("hello"))
  w = !e
  match !w
    .a(t)
      s = ?t[1..]
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub field_subject()
  h = HE(e: E.a(Text("hello")))
  match !h.e
    .a(t)
      s = ?t[1..]
      !t.add("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
      print(s)
    .b => pass

sub bare_argument(e: !E, f: !V)
  match !e
    .a(t)
      s = keep(t[1..])
      t = Text("other")
      print(s)
    .b => pass
  match !f
    .a(xs)
      s = keepv(xs[..])
      !xs.push(2)
      print(s)
    .b => pass

sub main()
  slice()

# error: 68:7: cannot lend `t` to write while a read loan is live
# error: 77:7: cannot lend `t` to write while a read loan is live
# error: 86:7: cannot lend `t` to write while a read loan is live
# error: 95:7: cannot reassign `t` while it is lent
# error: 103:7: cannot lend `t` to write while a read loan is live
# error: 112:7: cannot lend `t` to write while a read loan is live
# error: 121:7: cannot lend `x` to write while a read loan is live
# error: 130:7: cannot reassign `b` while it is lent
# error: 141:7: cannot lend `xs` to write while a read loan is live
# error: 144:7: cannot lend `xs` to write while a read loan is live
# error: 153:7: cannot lend `p` to write while a read loan is live
# error: 156:7: cannot lend `p` to write while a read loan is live
# error: 165:7: cannot reassign `x` while it is lent
# error: 175:11: cannot lend `t` to write while a read loan is live
# error: 185:7: cannot lend `t` to write while a read loan is live
# error: 195:7: cannot lend `t` to write while a read loan is live
# error: 204:7: cannot lend `t` to write while a read loan is live
# error: 212:7: cannot reassign `t` while it is lent
# error: 218:7: cannot lend `xs` to write while a read loan is live
