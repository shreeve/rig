# A method may store what its receiver lends or holds in what it was lent
# to write, as it may an argument's: a write receiver, a view of the
# receiver itself, a field or element of a value, a value reached
# through a handle, a consumed receiver's views, and a temporary
# receiver, which ends with its statement.

obj Holder
  r: []Int

obj VH
  s: ?Src

obj Src
  items: List[Int]

  sub put(?self, out: !Holder) keeps self
    out.r = ?self.items[..]

  sub putw(!self, out: !Holder) keeps self
    out.r = ?self.items[..]

  sub me(?self, out: !VH) keeps self
    out.s = self

obj Outer
  b: Src

obj P
  xs: [2]Int

  sub put(?self, out: !Holder) keeps self
    out.r = ?self.xs[..]

obj HV
  r: []Int

  sub give(<self, out: !Holder)
    out.r = self.r

fun mk() -> Src
  s = Src(items: List())
  !s.items.push(4)
  s

sub write_receiver(h: !Holder)
  s = Src(items: List())
  !s.items.push(5)
  !s.putw(!h)
  <s
  print(h.r[0])

sub view_of_self(t: ?Src)
  v = VH(s: t)
  s = Src(items: List())
  ?s.me(!v)
  <s
  print(v.s.items.len)

sub nested_field(h: !Holder)
  o = Outer(b: Src(items: List()))
  !o.b.items.push(5)
  ?o.b.put(!h)
  <o
  print(h.r[0])

sub element(h: !Holder)
  ps = [P(xs: [1, 1]), P(xs: [2, 2])]
  ?ps[1].put(!h)
  ps[1].xs[0] = 9
  print(h.r[0])

sub through_handle(h: !Holder)
  v: List[Int] = List()
  !v.push(5)
  s = *Src(items: <v)
  ?s.put(!h)
  <s
  print(h.r[0])

sub consumed(h: !Holder)
  y: List[Int] = List()
  !y.push(9)
  hv = HV(r: ?y[..])
  <hv.give(!h)
  <y
  print(h.r[0])

sub temporary(h: !Holder)
  mk().put(!h)
  print(h.r[0])

sub main()
  x = [1, 2]
  h = Holder(r: ?x[..])
  write_receiver(!h)
  t = Src(items: List())
  view_of_self(?t)
  nested_field(!h)
  element(!h)
  through_handle(!h)
  consumed(!h)
  temporary(!h)

