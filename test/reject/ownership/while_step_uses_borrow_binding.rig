# A borrow the condition of `while e as x` binds lives only in the body,
# so the step, which runs after it, cannot use it; a box's value is
# reached the same way.

struct P
  n: Int

sub main
  o: P? = P(n: 1)
  k = 0
  while !o as x : x.n += 1
    k += 1
    break if k == 3
  b: Box[P]? = Box(P(n: 1))
  while ?b as y : print(y.n)
    k += 1
    break if k == 6
  print(k)

# error: 11:19: the loop step cannot use `x`: it is a view (`!P`) that lives only in the body; use it at the end of the body instead
# error: 15:25: the loop step cannot use `y`: it is a view (`?Box[P]`) that lives only in the body
