# A String stored into a place makes the place a view of what it views:
# through an element method (`copy`, `fill`) and an element or field
# assignment, so the Text cannot be dropped while the place is in use.

obj Name
  s: ?String

sub main()
  t = String("ab")
  a: [2]?String = ["x", "y"]
  b = [?t[..1], ?t[1..]]
  !a.copy(?b[..])
  c: [2]?String = ["x", "y"]
  !c.fill(?t[..1])
  d: [1]?String = ["x"]
  d[0] = ?t[..]
  n = Name(s: "x")
  n.s = ?t[..1]
  <t
  print(a, c, d, n)

# error: 19:4: cannot drop `t` while it is lent
# errors: 1
