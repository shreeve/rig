# A String stored into a place makes the place a view of what it views:
# through `replace`, `swap`, an element method (`copy`, `fill`), and an
# element or field assignment, so the Text cannot be dropped while the
# place is in use.

struct Name
  s: String

sub main()
  t = Text("ab")
  a: [2]String = ["x", "y"]
  b = [?t[..1], ?t[1..]]
  !a.copy(?b[..])
  c: [2]String = ["x", "y"]
  !c.fill(?t[..1])
  s: String = "x"
  old = replace(!s, ?t[..])
  u: String = "u"
  w = ?t[1..]
  swap(!u, !w)
  d: [1]String = ["x"]
  d[0] = ?t[..]
  n = Name(s: "x")
  n.s = ?t[..1]
  <t
  print(a, c, s, old, u, d, n)

# error: 25:4: cannot drop `t` while it is lent
# errors: 1
