# A field cannot be moved out of a borrowed parameter: the caller still
# owns and drops it.

struct Box
  payload: Int

struct Pair
  a: *Box

sub eat(rc: *Box)
  print(rc.payload)

sub steal(p: ?Pair)
  eat(<p.a)

sub main()
  p = Pair(a: *Box(payload: 1))
  steal(?p)
  print("back")

# error: cannot move out of
