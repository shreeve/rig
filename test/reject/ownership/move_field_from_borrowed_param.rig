# A field cannot be moved out of a borrowed parameter: the caller still
# owns and drops it.

struct Wrap
  payload: Int

struct Pair
  a: *Wrap

sub eat(rc: *Wrap)
  print(rc.payload)

sub steal(p: ?Pair)
  eat(<p.a)

sub main()
  p = Pair(a: *Wrap(payload: 1))
  steal(?p)
  print("back")

# error: cannot move out of
