# No value is written through a `!T` field into what the field views: a
# write view is never stored inside a value, so the field is rejected
# where it is declared.

struct V
  r: ?Int

struct H
  w: !V

sub main()
  a = 1
  x = V(r: ?a)
  print(x.r)

# error: 9:6: a write view is never stored inside a value, and `!V` cannot stand here
# errors: 1
