# A struct holding a List, moved out at a branch's tail: the defer that
# grows the List would write a value the result now owns.
obj R
  v: List[Int]

sub main()
  c = true
  x = if c
    r = R(v: List())
    !r.v.push(1)
    defer
      for i in 0..100
        !r.v.push(i)
    r
  else
    R(v: List())
  !x.v.push(3)
  print(x.v.len, x.v[0])

# error: 13:10: use of `r` after move
# errors: 1
