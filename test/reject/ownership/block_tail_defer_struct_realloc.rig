# A struct holding a Vec, moved out at a branch's tail: the defer that
# grows the Vec would write a value the result now owns.
struct R
  v: Vec[Int]

sub main
  c = true
  x = if c
    r = R(v: Vec())
    !r.v.push(1)
    defer
      for i in 0..100
        !r.v.push(i)
    r
  else
    R(v: Vec())
  !x.v.push(3)
  print(x.v.len, x.v[0])

# error: 13:10: use of `r` after move
# errors: 1
