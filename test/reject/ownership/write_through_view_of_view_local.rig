# Pointing a view a write view reaches at another place stores that view
# where the write view reaches: the caller's List here, which outlives a
# local. So for a call's write view and a `!T` binding of it.

obj P
  x: Int

fun gslot[T](v: !List[T], i: Int) -> !T from v
  !v[i]

sub call(v: !List[?P])
  d = P(x: 1)
  gslot(!v, 0) = ?d

sub bind(v: !List[?P])
  d = P(x: 1)
  w = gslot(!v, 0)
  w = ?d

sub main()
  a = P(x: 0)
  v: List[?P] = List()
  !v.push(?a)
  call(!v)
  bind(!v)
  print(v[0].x)

# errors: 2
# error: 13:3: cannot store a view of `d`
# error: 18:3: cannot store a view of `d`
