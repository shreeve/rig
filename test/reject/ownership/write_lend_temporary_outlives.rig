# `!` lends any value to write, a temporary too, but a temporary lives
# only until its statement ends (Core §3): a write view of it, or of a
# field or element of it, or one a write method returns, that is held
# past the statement, or returned, is rejected, as a read view of it is.
# oracle: view reject C5
# oracle: main reject C5

struct S
  n: Int
  arr: [2]Int

  fun at(!self) -> !Int
    !self.n

  fun all(!self) -> !S
    self

  drop(!self)
    print("drop", self.n)

fun mk() -> S
  S(n: 1, arr: [1, 2])

fun view() -> !Int
  (!mk()).at()

sub main()
  w = !mk()
  print(w.n)
  r = (!mk()).at()
  print(r)
  f = !mk().n
  print(f)
  a = (!mk()).all()
  print(a.n)
  z = !mk().arr[..]
  print(z)

