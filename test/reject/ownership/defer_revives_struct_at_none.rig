# The defers run at `o?` only on the path that leaves with `none`. On
# the path that goes on, the defer has not run, so its reassignment
# does not revive the moved `x`.
struct R
  n: Int
  drop(!self)
    print("drop", self.n)

sub eat(r: R)
  print("eat", r.n)

fun f(o: Int?) -> Int?
  x = R(n: 1)
  defer x = R(n: 9)
  eat(<x)
  k = o?
  print(x.n)
  k

sub main
  print(f(3) ?? 0)

# error: 17:9: use of `x` after move
# errors: 1
