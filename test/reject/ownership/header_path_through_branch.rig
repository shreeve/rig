# A header's subject that reaches a write view a name holds through a
# branch, the branch itself or a path through it (`(a if c else b).e`,
# `(a if c else b)[0].e`, `o?`, `o ?? !d`, a `catch` part), reads the
# branch in place, which is a lend of it: lending the branching value
# would copy the write view out of the name with no loan on it. This
# holds for `match`, `if … as`, `while … as`, and `for` alike. The hint
# lends each leaf; a part of a branch of lends is matched to write once
# the branch has a name.

struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

error Bad
  nope

struct W
  e: E
  o: E?
  v: Vec[Int]

fun tg(w: !W, ok: Bool) -> (!W)!
  return Bad.nope if not ok
  w

sub part(a: !W, b: !W, c: Bool)
  match (a if c else b).e
    .a(r) => print(r.n)
    .b => pass

sub part_index(a: !Vec[W], b: !Vec[W], c: Bool)
  match (a if c else b)[0].e
    .a(r) => print(r.n)
    .b => pass

sub catch_part(a: !W, b: !W)
  match (tg(!a, false) catch |_| b).e
    .a(r) => print(r.n)
    .b => pass

sub as_part(a: !W, b: !W, c: Bool)
  if (a if c else b).o as x
    print(x)

sub while_as_part(a: !W, b: !W, c: Bool)
  while (a if c else b).o as x
    print(x)
    break

sub for_part(a: !W, b: !W, c: Bool)
  for x in (a if c else b).v
    print(x)

sub for_branch(a: !Vec[Int], b: !Vec[Int], c: Bool)
  for x in (a if c else b)
    print(x)

fun for_unwrapped(v: !Vec[Int]) -> Int?
  o: (!Vec[Int])? = !v
  for x in o?
    print(x)
  1

sub for_coalesce(v: !Vec[Int], d: !Vec[Int])
  o: (!Vec[Int])? = !v
  for x in o ?? !d
    print(x)

sub lends_part(a: !W, b: !W, c: Bool)
  match (!a if c else !b).e
    .a(r) => r.n = 1
    .b => pass

sub main()
  pass

