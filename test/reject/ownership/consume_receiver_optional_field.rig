# `h.o?` as a consuming receiver would copy the value out of the field
# without moving it.
struct Bag
  items: Vec[Int]

  fun total(<self) -> Int
    self.items.len

struct Holder
  o: Bag?

fun go(h: !Holder) -> Int?
  n = (h.o?).total()
  n

sub main()
  b = Bag(items: Vec())
  !b.items.push(3)
  h = Holder(o: <b)
  print(go(!h) ?? 0)
  if ?h.o as x
    print(x.items[0])

# error: 13:8: `h.o` owns a `Bag?`, which can't be copied into an argument: write `<h.o` to take it out (leaving `none`) or `+h.o` to pass a clone
