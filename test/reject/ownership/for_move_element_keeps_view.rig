# The elements of `for x in <v` carry the views the List held, so an
# element moved elsewhere cannot outlive what it views.

obj Wrap
  v: List[Int]

obj View
  b: ?Wrap

sub main()
  outer: List[*View] = List()
  if true
    y = Wrap(v: List())
    !y.v.push(42)
    v: List[*View] = List()
    !v.push(*View(b: ?y))
    for f in <v
      !outer.push(<f)
  for g in ?outer
    print(g.b.v[0])

# error: `y` does not live long enough
