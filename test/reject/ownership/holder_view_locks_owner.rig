# A value that holds a read view keeps the viewed owner lent while the
# value is used: a box, a generic function's result, an optional, and a
# generic struct, each of a List. The owner can be neither written nor
# moved nor dropped until the last use of the holder.

obj Hold[T]
  v: T

fun same[T](x: T) -> T
  x

sub main()
  a: List[Int] = List()
  b = ^?a
  !a.push(1)
  print(b.len)
  c: List[Int] = List()
  r = same(?c)
  d = <c
  print(r.len, d.len)
  e: List[Int] = List()
  o: (?List[Int])? = ?e
  !e.push(1)
  if o as w
    print(w.len)
  f: List[Int] = List()
  h = Hold(v: ?f)
  <f
  print(h.v.len)

# error: 15:3: cannot lend `a` to write while a read loan is live
# error: 19:8: cannot move `c` while a read loan is live
# error: 23:3: cannot lend `e` to write while a read loan is live
# error: 28:4: cannot drop `f` while it is lent
# errors: 4
