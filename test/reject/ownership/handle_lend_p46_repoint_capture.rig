# A `|+c|` capture is fixed when the closure is made, so `!c` lends only what it holds.
# (A handle is lent as itself, `!*T`, only where it may be written; the
# review probe of that name.)

sub g(x: !*Cell[Int])
  x = *Cell(9)

sub main()
  c = *Cell(1)
  f = |+c|
    g(!c)
    print(c.get())
  f()
  f()

