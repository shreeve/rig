# A field cannot be moved out through a shared handle: other handles may
# still use it, and the last one drops it.

struct Wrap
  payload: Int

struct Outer
  inner: *Wrap

sub eat(rc: *Wrap)
  print(rc.payload)

sub main()
  b = *Wrap(payload: 7)
  o = *Outer(inner: <b)
  eat(<o.inner)
  print("back")

# error: cannot move out of
