# An optional Text read as the left operand of `==` is held until the
# right operand has run.

fun grow2(o: !String?) -> String?
  if !o as t
    for _ in 0..100
      !t.add("abcdefgh")
  String("x")

sub main()
  a: String? = String("a")
  print(a == grow2(!a))

# error: 12:21: cannot lend `a` to write while the left operand's read of it is in use
# errors: 1
