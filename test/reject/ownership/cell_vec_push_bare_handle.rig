# Pushing to a Cell's List takes an owning element as List push does: moved
# (`<a`) or cloned (`+a`).

obj N
  id: Int

sub main()
  hs: *Cell[List[*N]] = *Cell(List())
  a = *N(id: 1)
  !hs.push(a)
  print(hs.len, a.id)

# error: 10:12: `a` is a `*N` handle, which can't be copied into an argument: write `<a` to move it or `+a` for another handle
