# Pushing to a Cell's Vec takes an owning element as Vec push does: moved
# (`<a`) or cloned (`+a`).

struct N
  id: Int

sub main()
  hs: *Cell[Vec[*N]] = *Cell(Vec())
  a = *N(id: 1)
  !hs.push(a)
  print(hs.len, a.id)

# error: 10:12: `a` is a `*N` handle, which can't be copied into an argument: write `<a` to move it or `+a` for another handle
