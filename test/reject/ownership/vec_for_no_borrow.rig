# Iterating a Vec, here of resources, needs an explicit read borrow of
# the source (`for x in ?vec`).

sub main()
  count: *Cell[Int] = *Cell(0)
  cb1: *sub() = *|+count| count.set(count.get() + 1)

  subs: Vec[*sub()] = Vec()
  !subs.push(+cb1)

  for cb in subs
    cb()

# error: write `for cb in ?subs` to read the Vec's elements
