# A call may store the views it is given into its `!` arguments, so
# after `put(!v, ?b)` the view keeps `b` viewed.

obj Wrap
  payload: Int
  log: List[Int]

obj View
  box: ?Wrap

sub put(v: !View, b: ?Wrap) keeps b
  v.box = b

sub main()
  a = Wrap(payload: 1, log: List())
  b = Wrap(payload: 2, log: List())
  v = View(box: ?a)
  put(!v, ?b)
  <b
  print(v.box.payload)

# error: cannot drop `b` while it is lent
