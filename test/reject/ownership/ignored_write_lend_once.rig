# A write lend a construction's field ignores is reported once: the
# construction, built without the view, is not reported again where a
# `Opt[!Int]` is expected of it, which is itself rejected, since a write
# view is never a generic type argument.

enum Opt[T]
  some(v: T)
  nothing

sub takeo(o: Opt[!Int])
  match o
    .some(v) => print(v)
    .nothing => pass

sub main()
  n = 1
  takeo(Opt.some(v: !n))

# error: 10:18: a write view is never stored inside a value, and `!Int` cannot stand here
# error: 17:21: `!n` here is read, not held: `Opt.some` stores an `Int`. Write `Opt.some(v: n)` to store a copy
# errors: 2
