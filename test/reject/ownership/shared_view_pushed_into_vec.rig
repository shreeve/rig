# Pushing a shared view into a List makes the List hold that view's
# view.

obj Wrap
  payload: Int

  drop(!self)
    print("drop")

obj View
  b: ?Wrap

sub main()
  vs: List[*View] = List()
  a = Wrap(payload: 1)
  !vs.push(*View(b: ?a))
  <a
  for v in ?vs
    print(v.b.payload)

# error: cannot drop `a` while it is lent
