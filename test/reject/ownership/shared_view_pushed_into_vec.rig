# Pushing a shared view into a Vec makes the Vec hold that view's
# borrow.

struct Wrap
  payload: Int

  drop(!self)
    print("drop")

struct View
  b: ?Wrap

sub main()
  vs: Vec[*View] = Vec()
  a = Wrap(payload: 1)
  !vs.push(*View(b: ?a))
  -a
  for v in ?vs
    print(v.b.payload)

# error: cannot drop `a` while borrows are live
