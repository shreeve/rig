# Pushing a shared view into a Vec makes the Vec hold that view's
# borrow.

struct Box
  payload: Int

  drop self: !Box
    print("drop")

struct View
  b: ?Box

sub main()
  vs: Vec(*View) = Vec()
  a = Box(payload: 1)
  !vs.push(*View(b: ?a))
  -a
  for v in ?vs
    print(v.b.payload)

# error: cannot drop `a` while borrows are live
