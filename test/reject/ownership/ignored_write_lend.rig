# A write lend `!x` where a plain value goes would be read, its `!`
# ignored: a generic's inferred `T`, a constructor's or variant's
# field, a declared parameter, a method's parameter, an array element,
# a typed binding, a result, and each arm of a value that branches.
# The diagnostic offers both fixes: a write view kept, or a copy.

enum Opt[T]
  some(v: T)
  nothing

struct G[T]
  r: T

  sub set(!self, x: T)
    self.r = x

  fun make(x: T) -> G[T]
    G(r: x)

struct P
  x: Int

fun get[T](x: T) -> T
  x

fun f(x: Int) -> Int
  x

fun ret(x: !Int) -> Int
  !x

fun mk() -> P
  P(x: 4)

sub main()
  n = 1
  m = 2
  c = n > 0
  o: Int? = none
  e1 = Opt.some(v: !n)
  e2 = Opt.some(!n)
  e3 = Opt[Int].some(v: !n)
  e4: Opt[Int] = .some(v: !n)
  s1 = G(r: !n)
  s2 = G[Int](r: !n)
  s3 = P(x: !n)
  g1 = get(!n)
  g2 = G.make(!n)
  g3 = f(!n)
  !s1.set(!m)
  v: Vec[Int] = Vec()
  !v.push(!m)
  a1 = [!n, 3]
  a2: [1]Int = [!n]
  b1: Int = !n
  b2: Int = !n if c else !m
  b3: Int = o ?? !n
  b4 = match n
    1 => !n
    _ => 0
  b5: Int = !mk().x
  print(e1, e2, e3, e4, s1.r, s2.r, s3.x, g1, g2.r, g3, a1, a2, b1, b2, b3, b4, b5, ret(!n))

