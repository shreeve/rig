# A branch a `match` reads in place is lent there (every in-place read
# of a branch is a lend), and a leaf that is a name holding a write view
# would be copied by lending the branching value, a second writer that
# holds no loan on it: bare write views, a call beside a name, `??` and
# `?` of an optional write view. None is lent on (`sema.makesWriteView`
# lends on only write lends and calls), so no binding writes through a
# copy. The hint lends each leaf.

struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

fun getw(e: !E) -> !E
  e

sub call_and_name(x: !E, y: !E, c: Bool)
  match (getw(!x) if c else y)
    .a(r) => !r.v.push(1)
    .b => pass

sub bare_write_views(a: !E, b: !E, c: Bool)
  match (a if c else b)
    .a(r)
      s = ?r.v[..]
      match !a
        .a(r2) => !r2.v.push(1)
        .b => pass
      print(s)
    .b => pass

sub bare_and_lend(a: !E, d: !E, c: Bool)
  match (a if c else !d)
    .a(r) => print(r.n)
    .b => pass

fun unwrapped(e: !E) -> Int?
  o: (!E)? = <e
  match o?
    .a(r) => print(r.n)
    .b => pass
  1

sub coalesce(e: !E, d: !E)
  o: (!E)? = <e
  match o ?? !d
    .a(r) => print(r.n)
    .b => pass

sub main()
  pass

