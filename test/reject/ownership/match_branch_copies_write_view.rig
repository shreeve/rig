# A branch that reads a place holding a write view would copy the write
# view out of the place, a second writer that holds no loan on it
# (`sema.headerCopiesWriteView`), for `match` and `if … as` alike: fields
# reached through a read view or a handle, bare write views, a call
# beside a field, `??` and `?` of an optional write view. None is lent
# on (`sema.makesWriteView` lends on only write lends and calls), so no
# binding writes through a read view, a handle, or a copy.

struct Res
  n: Int
  v: Vec[Int]

enum E
  a(r: Res)
  b

struct H
  w: !E

struct HO
  o: (!E)?

fun getw(e: !E) -> !E
  e

sub read_view_fields(h1: ?H, h2: ?H, c: Bool)
  match (h1.w if c else h2.w)
    .a(r) => !r.v.push(1)
    .b => pass

sub handle_fields(h1: *H, h2: *H, c: Bool)
  match (h1.w if c else h2.w)
    .a(r) => !r.v.push(1)
    .b => pass

sub call_and_field(x: !E, h1: ?H, c: Bool)
  match (getw(!x) if c else h1.w)
    .a(r) => !r.v.push(1)
    .b => pass

sub bare_write_views(a: !E, b: !E, c: Bool)
  match (a if c else b)
    .a(r)
      s = ?r.v[..]
      match !a
        .a(r2) => !r2.v.push(1)
        .b => pass
      print(s)
    .b => pass

sub bare_and_lend(a: !E, d: !E, c: Bool)
  match (a if c else !d)
    .a(r) => print(r.n)
    .b => pass

fun unwrapped(e: !E) -> Int?
  o: (!E)? = <e
  match o?
    .a(r) => print(r.n)
    .b => pass
  1

sub coalesce(e: !E, d: !E)
  o: (!E)? = <e
  match o ?? !d
    .a(r) => print(r.n)
    .b => pass

fun read_view_field_unwrapped(h: ?HO) -> Int?
  match h.o?
    .a(r) => !r.v.push(1)
    .b => pass
  1

sub as_branch(h1: ?HO, h2: ?HO, c: Bool)
  if (h1.o if c else h2.o) as x
    print(x)

sub main()
  pass

