# A generic struct instantiated with a resource (`Holder[*Wrap]`) owns it;
# copying the struct would drop the handle twice.

struct Holder[T]
  value: T

struct Wrap
  n: Int

sub main()
  rc = *Wrap(n: 5)
  h: Holder[*Wrap] = Holder(value: <rc)
  g = h
  print(g.value.n)

# error: would alias an owning value
