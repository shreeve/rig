# A generic struct instantiated with a resource (`Holder[*Wrap]`) owns it;
# copying the struct would drop the handle twice.

struct Holder[T]
  value: T

struct Wrap
  n: Int

sub main()
  rc = *Wrap(n: 5)
  h: Holder[*Wrap] = Holder(value: <rc)
  g = h
  print(g.value.n)

# error: 13:7: `h` owns a `Holder[*Wrap]`, which can't be copied by `=`: write `<h` to move it, `+h` to clone it, or `?h` to view it
