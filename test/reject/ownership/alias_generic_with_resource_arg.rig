# A generic struct instantiated with a resource (`Holder[*Wrap]`) owns it;
# copying the struct would drop the handle twice.

struct Holder[T]
  value: T

struct Wrap
  n: Int

sub main()
  rc = *Wrap(n: 5)
  h: Holder[*Wrap] = Holder(value: <rc)
  g = h
  print(g.value.n)

# error: 13:7: bare use of `Holder` value `h` in binding would alias an owning value; `Holder` carries drop glue (resource fields or a user `drop` declaration), so two bindings would each run the destructor. Use `<h` to move ownership
