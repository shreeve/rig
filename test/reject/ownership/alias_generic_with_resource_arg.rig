# A generic struct instantiated with a resource (`Holder[*Box]`) owns it;
# copying the struct would drop the handle twice.

struct Holder[T]
  value: T

struct Box
  n: Int

sub main()
  rc = *Box(n: 5)
  h: Holder[*Box] = Holder(value: <rc)
  g = h
  print(g.value.n)

# error: would alias an owning value
