# A struct that holds a `Random` is unique too: binding it to another
# name without `<` would copy the generator.
use std.random

struct Game
  rng: random.Random
  score: Int

sub main()
  g = Game(rng: random.Random.seeded(7), score: 0)
  h = g
  print(h.score)

# error: 11:7: `g` is a unique `Game`, which can't be copied by `=`: write `<g` to move it or `?g` to view it
# errors: 1
