# A `Random` is unique, so nothing copies one: a loop over a place reads
# each element where it is (`?Random`), and one over an array made here
# takes it, but a branching source, which may be a name's, is bound to a
# name first, and a generic body whose loop copies a `T` cannot take
# `T = Random`.
use std.random

fun count[T](xs: ?[2]T) -> Int
  new n = 0
  for x in xs
    n += 1
  n

sub look(s: []random.Random)
  for r in s
    print(r)

sub main()
  a = [random.Random.seeded(1), random.Random.seeded(2)]
  b = [random.Random.seeded(3), random.Random.seeded(4)]
  f = true
  for r in a
    print(r)
  for r in ?a
    print(r)
  for r in (a if f else b)
    print(r)
  for r in [random.Random.seeded(5), random.Random.seeded(6)]
    print(r)
  look(?a[..])
  print(count(?a))

# error: 26:13: cannot lend `a if f else b`: it may be `a`, a value a name holds
# error: 31:9: `count[random.Random]` cannot use `T = random.Random`: the generic body copies into a loop binding a value that holds a `T`, and `random.Random` is unique
