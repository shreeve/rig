# An `Rng` is unique: `==` is not defined for it, and `Cell.get` would
# copy it out of its cell.
use std.random

sub main()
  r = random.Rng.seeded(1)
  s = random.Rng.seeded(1)
  print(r == s)
  c = Cell(random.Rng.seeded(4))
  t = c.get()

# error: 8:9: `==` is not defined for `random.Rng`: `random.Rng` is unique
# error: 10:9: `Cell.get` returns `T` by value but `T = random.Rng` is unique
