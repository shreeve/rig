# A step that reads a binding of a joined `while` condition runs after
# the body, inside the `if`s that bind it: every binding there must be
# plain data, and no `continue` in the condition may skip binding one.

struct Res
  id: Int

  drop(!self)
    print(self.id)

fun get(k: Int) -> Int?
  k if k > 0 else none

fun make(k: Int) -> Res?
  Res(id: k) if k > 0 else none

sub main
  n = 3
  while make(n) as r and get(r.id) as x : n = x - 1
    print(x)
  m = 3
  while (get(m) ?? continue) > 0 and get(m) as y : m = y - 1
    print(y)

# error: 19:47: the loop step reads `x`, a binding of a joined condition, so each binding there must be plain data; `r` is a `Res`
# error: 22:56: the loop step reads `y`, a binding of the condition, which a `continue` in the condition leaves unbound
