# `print`, `warn`, and `panic` take values to write, separated by a
# space and ended by a newline; they take no keyword arguments.

sub main()
  print("a", sep: "x")
  warn("a", end: "")
  panic("a", sep: "x")

# error: 5:14: `print` takes no keyword arguments
# error: 6:13: `warn` takes no keyword arguments
# error: 7:14: `panic` takes no keyword arguments
# errors: 3
