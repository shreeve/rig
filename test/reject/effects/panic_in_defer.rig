# Deferred code runs as its scope ends, and a `panic` there would end
# the program in the middle of leaving it: `defer` and `errdefer` reject
# it.

error Bad
  no

fun g() -> Int!
  errdefer panic("b")
  return Bad.no

sub main()
  defer panic("a")
  print(g() catch 0)

# error: 9:12: `panic` cannot stand in deferred code, which runs as its scope ends; check before the scope ends instead
# error: 13:9: `panic` cannot stand in deferred code, which runs as its scope ends; check before the scope ends instead
# errors: 2
