# A `return` as a fallback is checked as the statement is, against the
# function's result. A bare error value is no fallback for `??`.

error E
  missing

fun get(k: Int) -> Int?
  k if k > 0 else none

fun wrong(k: Int) -> Int
  n = get(k) ?? return "none"
  n

fun empty(k: Int) -> Int
  n = get(k) ?? return
  n

fun err(k: Int) -> Int!
  n = get(k) ?? E.missing
  n

sub nothing(k: Int)
  n = get(k) ?? return 0
  print(n)

sub main()
  n = get(1) ?? 0
  print(n, wrong(1), empty(1), err(1) catch 0)
  nothing(1)

# error: 11:24: expected `Int`, got `String`
# error: 15:17: `return` needs a value of type `Int`
# error: 19:17: expected `Int`, got
# error: 23:24: a `sub` returns no value
