# An extern function can only be called, inside `raw`: storing it in a
# field would let it be called later without `raw`.

extern fun abs(n: I32) -> I32

struct Op
  f: fun(I32) -> I32

sub main()
  raw
    op = Op(f: abs)
    print(op.f(-1))

# error: an extern function can only be called, inside `raw`
