# `panic` gives no value, so it stands only as a statement or as a
# branch's value: not as an operand, an argument, a binding's value, a
# `return` value, or a module constant.

X = panic("module")

sub f(n: Int)
  print(n)

fun g() -> Int
  return panic("returned")

sub main()
  a = panic("a") + 1
  f(panic("argument"))
  b = panic("bound")
  print(a, b, g(), X)

