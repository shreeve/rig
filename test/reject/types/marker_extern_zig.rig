# An `extern zig` function's body is Zig code, which a marker cannot
# reach.

extern zig "fast.zig"
  rarely sub slow()
  called fun kept() -> Int

sub main()
  print(kept())

# error: only the standard library binds declarations to Zig code
# error: 5:3: `slow` is an `extern zig` function, whose body is Zig code: it takes no `rarely`
# error: 6:3: `kept` is an `extern zig` function, whose body is Zig code: it takes no `called`
