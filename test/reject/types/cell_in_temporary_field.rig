# A Cell lives only behind a shared handle, so no temporary holds one: a
# call cannot return a value that holds a Cell to have a part of it
# lent. The rule that a Cell lives only behind `*` rejects the result
# type `Q`, the constructor that makes the value, and the temporary the
# call makes.

struct P
  c: Cell[Int]

struct Q
  p: P

fun mk() -> Q
  Q(p: P(c: Cell(1)))

sub bump(p: !P)
  !p.c.set(p.c.get() + 10)

sub main()
  bump(?mk().p)

