# A shift of literals is checked against `Int`, the type the result
# takes.

sub main()
  a = 1 << 127
  b = 3 << 126
  c = 922337203685 << 4775807
  print(a, b, c)

# error: 5:12: shift amount `127` is out of range for `Int` (0..63)
# error: 6:12: shift amount `126` is out of range for `Int` (0..63)
# error: 7:23: shift amount `4775807` is out of range for `Int` (0..63)
