# A generic type whose method uses its own instance nested deeper, here
# through a generic function, would need ever deeper instances.

fun keep[T](x: T) -> T
  x

struct Wrap[T]
  v: T

  fun rewrap(self: Wrap[T]) -> Wrap[Wrap[T]]
    keep(Wrap(v: <self))

sub main()
  d = <Wrap(v: 1).rewrap()
  print(d.v.v)

# error: 14:8: `Wrap[Int]` leads to ever deeper instances of generic functions (through `keep[Wrap[Wrap[T]]]`); a generic type's body cannot nest itself in its own type arguments
