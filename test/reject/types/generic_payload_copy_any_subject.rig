# A generic body that copies a `T` out of what a `match`, an `if … as`,
# or a `for` reads, and gives the copy away, needs every instance's `T`
# to own nothing, whatever the subject: a place, a lend, a view a call
# returns, a branching value, a field or element of any of these, and a
# guarded match. Each instance below would free its Text twice.

enum Opt[T]
  some(v: T)
  nothing

obj P[T]
  x: T

enum E[T]
  has(p: P[T])
  empty

obj W[T]
  o: Opt[T]
  p: T?

fun get[T](o: ?Opt[T]) -> ?Opt[T] from o
  o

fun getw[T](w: ?W[T]) -> ?W[T] from w
  w

fun geta[T](a: ?List[Opt[T]]) -> ?List[Opt[T]] from a
  a

fun gete[T](e: ?E[T]) -> ?E[T] from e
  e

fun getxs[T](xs: ?List[T]) -> ?List[T] from xs
  xs

fun place[T](o: ?Opt[T], d: T) -> T
  match o
    .some(v) => v
    .nothing => <d

fun lend[T](o: ?Opt[T], d: T) -> T
  match ?o
    .some(v) => v
    .nothing => <d

fun call[T](o: ?Opt[T], d: T) -> T
  match get(o)
    .some(v) => v
    .nothing => <d

fun lend_call[T](o: ?Opt[T], d: T) -> T
  match ?get(o)
    .some(v) => v
    .nothing => <d

fun branch[T](o: ?Opt[T], o2: ?Opt[T], c: Bool, d: T) -> T
  match (o if c else o2)
    .some(v) => v
    .nothing => <d

fun branch_call[T](o: ?Opt[T], o2: ?Opt[T], c: Bool, d: T) -> T
  match (get(o) if c else get(o2))
    .some(v) => v
    .nothing => <d

fun field[T](w: ?W[T], d: T) -> T
  match w.o
    .some(v) => v
    .nothing => <d

fun field_of_call[T](w: ?W[T], d: T) -> T
  match getw(w).o
    .some(v) => v
    .nothing => <d

fun field_of_branch[T](w: ?W[T], w2: ?W[T], c: Bool, d: T) -> T
  match (w if c else w2).o
    .some(v) => v
    .nothing => <d

fun elem[T](a: ?List[Opt[T]], d: T) -> T
  match a[0]
    .some(v) => v
    .nothing => <d

fun elem_of_call[T](a: ?List[Opt[T]], d: T) -> T
  match geta(a)[0]
    .some(v) => v
    .nothing => <d

fun guarded[T](o: ?Opt[T], c: Bool, d: T) -> T
  match get(o)
    .some(v) if c => v
    _ => <d

fun branch_value[T](o: ?Opt[T], c: Bool, d: T) -> T
  match get(o)
    .some(v) => v if c else <d
    .nothing => <d

fun holder[T](e: ?E[T], d: T) -> P[T]
  match gete(e)
    .has(p) => p
    _ => P(x: <d)

fun nested[T](o: ?Opt[Opt[T]], d: T) -> T
  match get(o)
    .some(inner)
      match inner
        .some(v) => v
        .nothing => <d
    .nothing => <d

fun catch_all[T](w: ?W[T]) -> Opt[T]
  match getw(w).o
    x => x

fun as_field_of_call[T](w: ?W[T], d: T) -> T
  if getw(w).p as v
    return v
  <d

fun while_field_of_branch[T](w: ?W[T], w2: ?W[T], c: Bool, d: T) -> T
  while (w if c else w2).p as v
    return v
  <d

fun for_call[T](xs: ?List[T], d: T) -> T
  for x in getxs(xs)
    return x
  <d

sub main()
  o: Opt[String] = .some(v: String("o"))
  w: W[String] = W(o: .some(v: String("w")), p: String("p"))
  a: List[Opt[String]] = List()
  !a.push(.some(v: String("a")))
  e2: E[String] = .has(p: P(x: String("p")))
  xs: List[String] = List()
  !xs.push(String("x"))
  print(place(?o, String("d")))
  print(lend(?o, String("d")))
  print(call(?o, String("d")))
  print(lend_call(?o, String("d")))
  print(branch(?o, ?o, true, String("d")))
  print(branch_call(?o, ?o, true, String("d")))
  print(field(?w, String("d")))
  print(field_of_call(?w, String("d")))
  print(field_of_branch(?w, ?w, true, String("d")))
  print(elem(?a, String("d")))
  print(elem_of_call(?a, String("d")))
  print(guarded(?o, true, String("d")))
  print(branch_value(?o, true, String("d")))
  print(holder(?e2, String("d")).x)
  n: Opt[Opt[String]] = .some(v: .some(v: String("n")))
  print(nested(?n, String("d")))
  match catch_all(?w)
    .some(v) => print(v)
    .nothing => pass
  print(as_field_of_call(?w, String("d")))
  print(while_field_of_branch(?w, ?w, true, String("d")))
  print(for_call(?xs, String("d")))

