# A `Cell[T]` holds its `T` inline, and a `Signal[T]` its value and a
# pending one: both count toward the 8 MiB a value takes.

type Arr = [600000]Int

struct Two
  a: Cell[Arr]
  b: Cell[Arr]

sub main()
  s = *Signal[Arr](value: [600000 of 0])
  print(s.get()[0])

# error: 6:8: `Two` takes 9600000 bytes; a value takes at most 8388608 (8 MiB), since it may live on the stack. Keep larger data in a `Vec`
# error: 11:8: `Signal[[600000]Int]` takes 9600026 bytes; a value takes at most 8388608 (8 MiB), since it may live on the stack. Keep larger data in a `Vec`
