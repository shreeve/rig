# A generic function's body is checked for a `T` that holds no view,
# so a type argument cannot be a view, or hold one: take `?T` or `!T`
# in the signature instead. (A write view is never a type argument at
# all; a `!p` of a value that copies binds `T` to the value, whose `!`
# is then ignored: test/reject/ownership/ignored_write_lend.rig.)

struct P
  n: Int

struct H
  r: ?P

fun same[T](x: T) -> T
  x

fun show[T](x: ?T) -> Int
  1

sub main()
  p = P(n: 1)
  q = same(?p)
  t = same(H(r: ?p))
  print(show(?p), q.n, t.r.n)

# error: 21:7: `same[?P]` cannot use `T = ?P`: a generic function is checked for a `T` that holds no `?T`, `!T`, or slice; take `?T` or `!T` in its signature instead
# error: 22:7: `same[H]` cannot use `T = H`: a generic function is checked for a `T` that holds no `?T`, `!T`, or slice; take `?T` or `!T` in its signature instead
# errors: 2
