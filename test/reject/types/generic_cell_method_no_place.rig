# In a generic body, a `?self` method that may change a Cell, called on
# a value with no place (a temporary, or a part of a branch whose leaf is
# made there), requires every instance to hold no Cell: at an instance
# that holds one the call is rejected, as it is in concrete code.

struct T
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

struct H[X]
  x: X

  sub run(?self, f: ?sub(?X))
    f(?self.x)

struct P[X]
  h: H[X]

sub bump(t: ?T)
  t.hit()

sub show(n: ?Int)
  print(n)

fun mkh[X](x: X) -> H[X]
  H(x: <x)

fun mkp[X](x: X) -> P[X]
  P(h: H(x: <x))

sub temp[X](x: X, f: ?sub(?X))
  mkh(<x).run(f)

fun branch[X](p: P[X], x: X, f: ?sub(?X), k: Bool) -> P[X]
  (p if k else mkp(<x)).h.run(f)
  p

sub main()
  temp(5, show)
  temp(T(c: Cell(0)), bump)
  print(branch(mkp(1), 2, show, true).h.x)
  print(branch(mkp(T(c: Cell(0))), T(c: Cell(1)), bump, false).h.x.c.get())

# error: 42:3: `temp[T]` cannot use `X = T`: the generic body calls `run` on a temporary
# error: 44:9: `branch[T]` cannot use `X = T`: the generic body calls `run` on a part of a value that may be the temporary `mkp(<x)`
# errors: 2
