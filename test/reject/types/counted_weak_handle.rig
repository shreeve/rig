# A weak handle reaches its value only through `upgrade`, which takes
# the handle itself. Behind a handle it is lent out first; the hint
# says how, in a form that compiles (see
# test/behavior/types/weak_in_box_upgrade.rig).

obj S
  n: Int

sub main()
  h = *S(n: 1)
  c: *~S = *(~h)
  print(c.n)
  w = ~h
  print(w.n)

# error: 12:11: a weak handle `~S` reaches its value only through `upgrade`, which takes the handle itself: lend it first, `w: ?~S = ?c`, then `if w.upgrade() as s`
# error: 14:11: a weak handle `~S` reaches its value only through `upgrade`: `if w.upgrade() as s`
# errors: 2
