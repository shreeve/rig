# Stacking arrives through an alias as it does in a written type: the
# rule is on the resolved type, not on the spelling.

type Boxed = ^Int
type Counted = *Int

obj Holder
  a: ^Boxed
  b: *Boxed
  c: ^Counted

sub main()
  pass

# error: 8:6: `^^Int` stacks one heap holding on another
# error: 9:6: `*^Int` stacks one heap holding on another
# error: 10:6: `^*Int` stacks one heap holding on another
