# A generic body that uses a deeper instance of its own type (`Wrap[T]`
# using `Wrap[Wrap[T]]`) would need ever deeper instances; it is rejected
# rather than expanded forever.

struct B
  n: Int

struct Wrap[T]
  v: T

  fun wrap(self: Wrap[T]) -> Wrap[Wrap[T]]
    Wrap(v: <self)

sub main()
  b: Wrap[*B] = Wrap(v: *B(n: 1))

# error: `Wrap[*B]` leads to ever deeper instances of generic types (through `Wrap[Wrap[T]]`)
