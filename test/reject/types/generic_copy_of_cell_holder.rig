# A generic body binds a loop element of a type parameter by copy, so
# an instance whose type argument holds a Cell (a unique value) is
# rejected: a change through the copy would not reach the original. (A
# read payload matched in place is bound by address:
# `test/behavior/types/generic_in_place_cell_holder.rig`.)

struct Counter
  hits: Cell[Int]

sub each[T](xs: ?[2]T, f: ?fun(?T) -> Int)
  for k in xs
    _ = f(?k)

fun look(c: ?Counter) -> Int
  c.hits.get()

sub main()
  a = [Counter(hits: Cell(0)), Counter(hits: Cell(0))]
  each(?a, look)
  n = [1, 2]
  each(?n, |x: ?Int| x)

# error: 19:3: `each[Counter]` cannot use `T = Counter`: the generic body copies into a loop binding a value that holds a `T`, and `Counter` is unique
# errors: 1
