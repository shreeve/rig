# A generic body never binds a loop element of a type parameter that
# holds a Cell: such a value lives only behind a shared handle, so it is
# never an array's element nor a generic type argument, and the array
# is rejected where it is written.

struct Counter
  hits: Cell[Int]

sub each[T](xs: ?[2]T, f: ?fun(?T) -> Int)
  for k in xs
    _ = f(?k)

fun look(c: ?Counter) -> Int
  c.hits.get()

sub all(xs: ?[2]Counter)
  each(xs, look)

sub main()
  n = [1, 2]
  each(?n, |x: ?Int| x)

