# A generic body that calls itself with a larger length would have no
# last instance; arithmetic on a compile-time parameter is rejected, so
# it cannot.

fun grow[n: Int](xs: [n]Int) -> Int
  grow([n + 1 of 0])

sub main()
  print(grow([1]))

# error: 6:9: an array length `n + 1` does arithmetic on a compile-time parameter
