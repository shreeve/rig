# Inside a generic body, constructor fields are checked symbolically:
# a String is not a `T`.

struct Wrap[T]
  value: T

  fun bad(?self) -> Self
    b: Self = Wrap(value: "hello")
    b

sub main()
  b: Wrap[Int] = Wrap(value: 5)
  print(b.value)

# error: type mismatch: expected `T`, got `String`
