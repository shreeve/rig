# `get` copies an element out, and no array has write views for it to
# copy: a write view is never stored inside a value, so an array of
# them is rejected where it is made.

sub main()
  a = 1
  b = 2
  xs = [!a, !b]
  print(xs.len)

# error: 8:8: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
