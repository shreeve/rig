# No field is a `!T` that an assignment could write through or point
# elsewhere: a write view is never stored inside a value, so the field
# is rejected where it is declared.

obj H
  w: !List[Int]

sub main()
  v: List[Int] = List()
  print(v.len)

# error: 6:6: a write view is never stored inside a value, and `!List[Int]` cannot stand here
# errors: 1
