# A type parameter names a type, not a function: it cannot be called or
# constructed, in a generic function or in a generic type's method.

fun f[T](x: T) -> T
  T(x)

fun g[T](x: Int) -> Int
  y = T(n: x)
  2

fun h[print](x: print) -> Int
  print(1)
  2

struct Box[T]
  v: T

  fun make(?self, x: Int) -> Int
    y = T(x)
    2

sub main
  print(f(3), g[Int](1), h(3), Box(v: 1).make(3))

# error: 5:3: `T` is a type parameter; it cannot be called or constructed
# error: 8:7: `T` is a type parameter; it cannot be called or constructed
# error: 12:3: `print` is a type parameter; it cannot be called or constructed
# error: 19:9: `T` is a type, not a value
