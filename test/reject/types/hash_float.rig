# `.hash()` takes what `==` compares less a float, whose `==` calls
# `0.0` and `-0.0` equal and NaN equal to nothing, and so a Map takes no
# Float key.

use std.hash

obj P
  x: Int
  w: Float

sub main()
  print(1.5.hash())
  p = P(x: 1, w: 2.0)
  print(p.hash())
  m = hash.Map[Float, Int].new()
  print(m.len)

# error: `.hash()` does not take a `Float`
# error: `.hash()` does not take a `P`: field `w` is a `Float`
# error: cannot use `K = Float`: the generic body hashes a `K` with `.hash()`, which `Float` does not support
