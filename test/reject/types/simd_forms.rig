# A vector is one value: a `for` walks its lanes through `v.array()`, a
# `match` does not take it, and a lane index is checked against the lane
# count. A module constant holds a vector made of constants, and no
# arithmetic on one; a vector type is no value.

LOW = Simd[U8, 4]([1, 2, 3, 4])
HIGH = LOW + 1
PAIR = [Simd[U8, 4].splat(200), Simd[U8, 4].splat(100)]
FILL = [2 of Simd[U8, 4].splat(200)]
PICK = Simd[U8, 4].splat(1) if 1 < 2 else Simd[U8, 4].splat(2)

sub main()
  v = Simd[U8, 4].splat(1)
  for x in v
    print(x)
  match v
    _ => print(1)
  print(v[4], v[-1])
  t = Simd[U8, 4]
  print(t, LOW)

