# A type parameter neither the arguments nor the type expected of the
# result determine cannot be inferred: `none` and `.variant` say nothing
# about it, and a parameter used nowhere in the signature has nothing
# at all. The hint marks the type to give with `...`.

enum Color
  red
  blue

fun make[T](n: Int) -> Int
  n

fun first[T](x: T?, y: T?) -> Int
  1

fun pick[T](x: T) -> Int
  1

sub main()
  print(make(3))
  print(first(none, none))
  print(pick(.red))

# error: 20:9: cannot infer `T` for `make` from its arguments or the type expected of its result; give `T` in brackets: `make[...](...)`
# error: 21:9: cannot infer `T` for `first` from its arguments or the type expected of its result; give `T` in brackets: `first[...](...)`
# error: 22:9: cannot infer `T` for `pick` from its arguments or the type expected of its result; give `T` in brackets: `pick[...](...)`
