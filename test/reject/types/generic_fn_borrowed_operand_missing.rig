# A borrowed `T` operand records the requirement a `T` operand would:
# an instance whose type lacks the operation is reported at the call,
# with a note at the body line.

struct P
  n: Int

struct H
  p: *P

fun same[T](a: ?T, b: ?T) -> Bool
  a == b

fun bigger[T](a: !T, b: ?T) -> Bool
  a > b

sub main()
  s = H(p: *P(n: 0))
  p = P(n: 1)
  q = P(n: 2)
  print(same(?s, ?s))
  print(bigger(!p, ?q))

# error: 21:9: `same[H]` cannot use `T = H`: the generic body applies `==` to `T`, which `H` does not support: field `p` is a handle `*P`
# error: 12:3: `==` used on `T` here
# error: 22:9: `bigger[P]` cannot use `T = P`: the generic body applies `>` to `T`, which `P` does not support
# error: 15:3: `>` used on `T` here
