# A value holding a Cell lives only behind a shared handle: no
# parameter, result, local, optional, element, slice, or type argument
# holds one by value.

struct Counter
  hits: Cell[Int]

sub take(k: Counter)
  print(k.hits.get())

fun make() -> Counter?
  none

sub each(xs: [2]Cell[Int], s: []Counter)
  print(xs.len, s.len)

sub main()
  a: Cell[Int]? = none
  v: Vec[Counter] = Vec()
  print(a, v.len)

