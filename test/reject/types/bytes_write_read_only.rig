# `write` needs writable bytes: not those of a read slice, a String, or
# anything but a byte buffer; and `read` reads bytes only.

sub f(r: []U8)
  r.write[U16, .big](0, 1)
  !r.write[U16, .big](0, 1)

sub main()
  page: [8]U8 = [8 of 0]
  r = ?page[..]
  r.write[U32, .little](0, 1)
  s = "abcd"
  !s.write[U16, .big](0, 1)
  a = [1, 2, 3, 4]
  print(a.read[U16, .big](0))
  page.write[U16, .big](0, 1)

# error: 5:3: cannot `write` a `[]U8`; its elements are read-only
# error: 6:4: cannot write-borrow a `[]U8`: its elements are read-only
# error: 11:3: cannot `write` a `[]U8`; its elements are read-only
# error: 13:3: cannot `write` a String; a String is read-only
# error: 15:9: `read` works on bytes: a `[]U8`, an `![]U8`, a `[N]U8`, a `Vec[U8]`, or a String; got `[4]Int`
# error: 16:3: `write` writes the elements; write the receiver with `!`
