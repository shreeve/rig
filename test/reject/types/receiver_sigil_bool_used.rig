# A write call whose value is used is written `(!s).m(...)` wherever
# the value goes, not only where its `!` could read as negation: here a
# `Bool` in a binding, an argument, a `return`, a body's value, a
# `match` subject, a ternary's branch, a `catch` value that is used.

struct Set
  items: Vec[Int]
  fun insert(!self, k: Int) -> Bool
    for x in ?self.items
      return false if x == k
    !self.items.push(k)
    true
  fun checked(!self, k: Int) -> Bool!
    !self.insert(k)

fun add(s: !Set, k: Int) -> Bool
  return !s.insert(k)

fun again(s: !Set, k: Int) -> Bool
  !s.insert(k)

fun fill(s: !Set) -> Int!
  added = !s.checked(3)!
  1 if added else 0

sub main()
  set = Set(items: Vec())
  fresh = !set.insert(1)
  print(!set.insert(1))
  match !set.insert(2)
    true => print("new")
    false => print("old")
  n = fresh if fresh else !set.insert(3)
  ok = !set.checked(4) catch false
  !set.insert(5)
  print(fresh, n, ok)

