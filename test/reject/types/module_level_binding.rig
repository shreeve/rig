# A module-level binding is a constant whose value is known at compile
# time, bound once, and whose name no function reuses.

struct B
  n: Int

  drop(!self)
    print("drop", self.n)

fun f() -> Int
  3

k = 3
h = *B(n: 1)
c = f()
d = later
later = 1
big = 9223372036854775807
over = big + 1
k += 1

fun uses(big: Int) -> Int
  big

sub main()
  const over = 2

t = 1 if k > 2 else f()

