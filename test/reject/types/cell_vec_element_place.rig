# An element of a Cell's List is a copy: it cannot be lent, and it is
# written whole with `c[i] = e`, not through a field or `+=`.

obj P
  x: Int

sub main()
  ps: Cell[List[P]] = Cell(List())
  !ps.push(P(x: 1))
  r = ?ps[0]
  ps[0].x = 2
  ns: Cell[List[Int]] = Cell(List())
  !ns.push(1)
  ns[0] += 1
  ns.len = 3
  print(r)

# error: 10:8: cannot lend an element of a Cell's List
# error: 11:3: an element of a Cell's List is written whole
# error: 14:3: an element of a Cell's List is written whole
# error: 15:6: cannot assign to `.len`; a length is read-only
