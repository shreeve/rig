# An array's length runs from 0 to 2^32 - 1. A compile-time parameter
# used as one is checked at each instance: called directly, and through
# a generic body that passes it on.

NEG =! -1
BIG =! 4294967296

fun zeros[n: Int] -> [n]Int
  [n of 0]

fun wrap[n: Int] -> Int
  zeros[n]().len

sub main()
  a: [NEG]Int = [0 of 0]
  b: [BIG]U8 = [0 of 0]
  c = [99999999999999999999999999999999999999999 of 0]
  print(zeros[-1]().len)
  print(wrap[-2]())
  d: [-3]Int = []
  print(a, b, c, d)

# error: 20:7: array length -3 is out of range
# error: 15:7: array length -1 is out of range: an array length runs from 0 to 4294967295
# error: 16:7: array length 4294967296 is out of range
# error: 17:8: an array length `99999999999999999999999999999999999999999` is too large to compute
# error: 18:9: `zeros[-1]` cannot use `n = -1`: the generic body uses `n` as an array length, which runs from 0 to 4294967295
# error: 19:9: `zeros[-2]` cannot use `n = -2`: the generic body uses `n` as an array length
# error: 19:9: `zeros[-2]` is made by `wrap[-2]`
