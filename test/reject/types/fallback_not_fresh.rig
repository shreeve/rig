# The fallback of `??` over a fresh optional is moved into the result: a
# value that only reaches owners names cannot be. A value that is not
# fresh says how to read or take the optional instead.

fun mko(k: Int) -> Text?
  Text("o") if k > 0 else none

fun f(o: Text?) -> Int?
  print(o?)
  1

sub main
  e = Text("e")
  g = Text("g")
  c = true
  y = mko(0) ?? (e if c else g)
  print(y, f(none))

# error: 16:18: `e if c else g` is not a fresh value: it reaches an owner a name holds, which `??` would move out
# error: 9:9: read an optional through `if ?o as x`, or take it with `if <o as x`
# errors: 2
