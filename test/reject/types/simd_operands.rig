# Both sides of a lane-wise operator are one `Simd` type, or a vector and
# a scalar of its lane type; a literal must fit a lane. `/` and `%` take
# no vector, ordering takes number lanes, the wrapping and saturating
# forms and the shifts integer lanes, and `-` signed or float lanes. A
# shift moves every lane by one integer, below the lane width.

sub main()
  a = Simd[U8, 4].splat(1)
  b = Simd[U16, 4].splat(1)
  n = 3
  f = Simd[F32, 4].splat(1.0)
  m = a == 1
  print(a + b)
  print(a + n)
  print(a + 300)
  print(a / 2, a % 2)
  print(a << a, a >> 8, f <<% 1)
  print(m < m)
  print(f +% f, f & f, f +| f, m -| m)
  print(-a)
  a += b
  a <<= 9
  m += m
  a /= 2
  m >>= 1

