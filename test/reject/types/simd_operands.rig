# Both sides of a lane-wise operator are one `Simd` type, or a vector and
# a scalar of its lane type; a literal must fit a lane. `/`, `%`, and the
# shifts take no vector, ordering takes number lanes, the wrapping forms
# integer lanes, and `-` signed or float lanes.

sub main()
  a = Simd[U8, 4].splat(1)
  b = Simd[U16, 4].splat(1)
  n = 3
  f = Simd[F32, 4].splat(1.0)
  m = a == 1
  print(a + b)
  print(a + n)
  print(a + 300)
  print(a / 2, a % 2)
  print(a << 1, a >> 1, a <<% 1)
  print(m < m)
  print(f +% f, f & f)
  print(-a)
  a += b
  a <<= 1
  m += m

