# A constant expression of a sized type must fit it, and so must
# arithmetic on constant bindings.

sub main()
  a: U8 = 200 + 100
  b: U8 = 250
  c = b + 10
  print(a, c)

# error: 5:11: integer value `300` does not fit in `U8` (0..255)
# error: 7:7: integer value `260` does not fit in `U8` (0..255)
