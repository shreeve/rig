# A variant with one field takes it by position or by name; a variant
# with more than one field sets them by name, like a struct's.

enum Shape
  circle(radius: Int)
  rect(w: Int, h: Int)

sub main()
  a = Shape.rect(2, h: 3)
  b: Shape = .rect(2, 3)
  c: Shape = .circle(2, 3)
  d: Shape = .circle(2, radius: 3)
  e: Shape = .circle("two")
  print(a, b, c, d, e)

# error: 9:13: a variant with more than one field sets them by name: `.rect(w: ...)`
# error: 10:15: a variant with more than one field sets them by name: `.rect(w: ...)`
# error: 11:15: variant `circle` has one field: write `.circle(value)` or `.circle(radius: value)`
# error: 12:15: variant `circle` has one field: write `.circle(value)` or `.circle(radius: value)`
# error: 13:22: type mismatch: expected `Int`, got `String`
