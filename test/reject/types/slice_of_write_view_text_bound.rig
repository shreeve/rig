# A slice of a write view of a Text lends that view, so a binding writes
# the lend, as for a slice of the Text itself: a `!Text` parameter and
# local, a `!*Text`, and a `!Box[Text]`.

sub param(t: !Text)
  s = t[1..]
  print(s)

sub local()
  t = Text("hello")
  w = !t
  s = w[1..]
  print(s)

sub shared(h: !*Text)
  s = h[1..]
  print(s)

sub boxed(b: !Box[Text])
  s = b[1..]
  print(s)

sub main()
  t = Text("hello")
  param(!t)

# error: 6:7: a slice of a Text views it; write `?t[1..]`
# error: 12:7: a slice of a Text views it; write `?w[1..]`
# error: 16:7: a slice of a Text views it; write `?h[1..]`
# error: 20:7: a slice of a Text views it; write `?b[1..]`
# errors: 4
