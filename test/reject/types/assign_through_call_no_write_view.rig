# Only a write view `!T` a call returns is assigned through: not a read
# view, not a value, and not a `![]T`, whose elements are written instead.

fun first(v: ?List[Int]) -> ?Int from v
  ?v[0]

fun count(v: ?List[Int]) -> Int
  v.len

fun all(v: !List[Int]) -> ![]Int from v
  !v[..]

sub main()
  v: List[Int] = List()
  !v.push(1)
  first(?v) = 2
  count(?v) += 1
  all(!v) = !v[..]

