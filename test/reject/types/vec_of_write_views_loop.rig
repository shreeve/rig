# No Vec holds write views for a loop binding to hold or `get` to copy:
# a write view is never stored inside a value, so `Vec[!Int]` is
# rejected where it is written.

sub main()
  a = 1
  w = Vec[!Int]()
  print(w.len, a)

# error: 7:7: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
