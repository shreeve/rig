# A function with a `pre` parameter is instantiated per call, so it can
# only be called, not used as a function value.

fun rep(pre n: Int, x: Int) -> Int
  x * n

struct P
  x: Int

  fun times(?self, pre n: Int) -> Int
    self.x * n

sub main()
  g = rep
  f: fun(Int, Int) Int = rep
  h = P.times
  print(rep(2, 3))

# error: 14:7: `rep` takes a `pre` parameter, so it can only be called
# error: 15:26: `rep` takes a `pre` parameter, so it can only be called
# error: 16:9: `P.times` takes a `pre` parameter, so it can only be called
