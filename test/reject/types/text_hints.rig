# A Text is indexed through its String view, and lent as a String to
# read with `?t`: a written `!t` there only reads.

sub f(s: String)
  print(s)

sub main()
  t = Text("abc")
  print(t[0])
  f(!t)

# error: 9:9: cannot index a value of type `Text`; index its String view: `(?t[..])[i]`
# error: 10:5: `!t` here is read, not held: `f` only reads `t`; write `f(?t)`
# errors: 2
