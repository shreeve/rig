# A Cell's `set`, `replace`, and its Vec's `push`, `pop`, and `clear`
# take their receiver lent to write, as any `!self` method does, so a
# `*Cell` handle moved there with `<` is rejected: `<` would end the
# binding for a call that only lends it.

sub main()
  c: *Cell[Vec[Int]] = *Cell(Vec[Int]())
  (<c).push(1)
  d: *Cell[Vec[Int]] = *Cell(Vec[Int]())
  x = (<d).pop()
  e: *Cell[Vec[Int]] = *Cell(Vec[Int]())
  (<e).clear()
  n: *Cell[Int] = *Cell(1)
  (<n).set(2)
  m: *Cell[Int] = *Cell(1)
  y = (<m).replace(2)
  print(x ?? 0, y)

# error: 8:8: method `push` needs its receiver lent to write, not moved
# error: 10:12: method `pop` needs its receiver lent to write, not moved
# error: 12:8: method `clear` needs its receiver lent to write, not moved
# error: 14:8: method `set` needs its receiver lent to write, not moved
# error: 16:12: method `replace` needs its receiver lent to write, not moved
# errors: 5
