# `[n of x]` copies a value that copies into each of its `n` slots, where `n` is
# known at compile time; with no expected type, `x` gives the element
# type.

fun make[T](x: T) -> [3]T
  [3 of x]

sub main()
  k = 3
  v = List[Int]()
  y = 5
  a = [k of 0]
  b = [3 of none]
  c: Int = [3 of 0]
  d = [-1 of 0]
  e: [4]Int = [3 of 0]
  f = [2 of <v]
  g = [2 of !y]
  h = make(List[Int]())
  print(a, b, c, d, e, f, g, h)

# error: 12:8: an array length must be known at compile time; `k` is not
# error: 13:13: the element of `[n of x]` needs a type
# error: 14:12: type mismatch: expected `Int`, got `[3]Int`
# error: 15:8: array length -1 is out of range
# error: 16:15: `[3 of 0]` has length `3`; `[4]Int` needs `4`
# error: 17:13: `[n of x]` copies its element into every slot, and a `List[Int]` owns a resource, so it cannot be copied: write a loop that makes each element with `+x` (`for 0..n` with `!xs.push(+x)`, into a List), or write the elements out, `[+x, +x]`
# error: 18:13: `[n of x]` copies its element into every slot, and a `!Int` holds a write view, which has one holder, so it cannot be copied
# error: 19:7: `make[List[Int]]` cannot use `T = List[Int]`
