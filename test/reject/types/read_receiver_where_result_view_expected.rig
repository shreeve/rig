# `?p.m()` reads `p` for the call; where a view of the call's result
# is kept (a binding), the hint puts the view around the call. (As an
# argument, the result is lent as a temporary of the statement.)

struct Point
  x: Int

  fun shifted(?self, d: Int) -> Point
    Point(x: self.x + d)

sub show(p: ?Point)
  print(p.x)

sub main()
  p = Point(x: 1)
  r: ?Point = ?p.shifted(4)
  h = *Point(x: 9)
  s: ?Point = ?h.shifted(1)
  show(r)
  show(s)

# error: 16:15: `?p.shifted(4)` reads `p` for the call; write `?(p.shifted(4))` to lend the call's result
# error: 18:15: write `?(h.shifted(1))` to lend the call's result
