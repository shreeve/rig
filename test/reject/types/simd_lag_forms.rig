# `cur.lag[k](prev)` takes one compile-time `k` from 1 to the lane count
# less one, and one argument of `cur`'s type. `k` is a constant: on a
# compile-time parameter, or a lane count a generic body does not know,
# Rig cannot check it.

fun back[k: Int](v: Simd[U8, 16]) -> Simd[U8, 16]
  v.lag[k](v)

fun any_lanes[n: Int](v: Simd[U8, n]) -> Simd[U8, n]
  v.lag[1](v)

sub main()
  v = Simd[U8, 16].splat(1)
  w = Simd[U16, 16].splat(1)
  k = 2
  print(v.lag[0](v), v.lag[16](v), v.lag[-1](v), v.lag[k](v))
  print(v.lag[1, 2](v), v.lag[1](w), v.lag[1](), v.lag[1](v, v), v.lag[1](1))
  print(back[2](v), any_lanes(v))

