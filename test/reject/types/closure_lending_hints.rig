# Each mistake in lending a closure gets one diagnostic whose hint
# compiles: a closure or a borrow is captured with `|?f|`, a closure
# literal goes to a parameter declared `?fun(...)`, and no type argument
# is a borrowed callable. (An owned closure, bare or made, is lent to a
# `?fun(...)` argument as `?cb` lends it.)

fun apply(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

fun run(f: fun(Int) -> Int) -> Int
  f(1)

fun mk -> *fun(Int) -> Int
  *|a: Int| a + 5

fun keep[T](x: T) -> Vec[T]
  v: Vec[T] = Vec()
  !v.push(x)
  v

sub outer(f: ?fun(Int) -> Int)
  h = |+f| f(1)
  print(h())

fun double(n: Int) -> Int
  n * 2

sub main
  k = 2
  f = |+k, a: Int| a * k
  h = |+f| f(1)
  cb = *|a: Int| a + 1
  print(h(), apply(cb, 1), apply(+cb, 1), apply(mk(), 1))
  v = keep(?f)
  c = Cell(?f)
  m = |?double| apply(double, 3)
  print(run(|a| a + 1), run(?f), v.len, m())
  s = *Signal(0)
  x = 1
  s.subscribe(|?x| print(x))

# error: 22:9: `|+f|` copies a Copy value or clones a `*T` / `~T` handle, but `f` is `?fun(Int) -> Int`; capture it with `|?f|`
# error: 31:9: but `f` is a closure of type `fun(Int) -> Int`; capture it with `|?f|`
# error: 34:7: `keep` cannot take a borrowed callable for `T`
# error: 35:7: `Cell` cannot take a borrowed callable for `T`
# error: 36:9: only a local can be captured; `double` is declared at module level
# error: 37:13: a closure literal is not a function value `fun(Int) -> Int`; declare the parameter `?fun(Int) -> Int`
# error: 37:29: a lent closure goes to a parameter declared `?fun(Int) -> Int`
# error: 40:15: `*sub()` is an owned closure; write `*|...| body` to make one
