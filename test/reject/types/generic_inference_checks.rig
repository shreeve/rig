# An inferred instance is checked like a spelled one: each type
# parameter needs a value to come from, the values must agree, and the
# instance must meet the generic body's requirements and the built-in
# generics' element rules.

obj Same[T]
  a: T
  b: T

obj Adder[T]
  v: T

  fun next(?self) -> T
    self.v + 1

obj Plain
  n: Int

sub main()
  p = Plain(n: 1)
  x = Same(a: none, b: none)
  v = List()
  y = Same(a: 1, b: "two")
  z = Adder(v: "s")
  c = Cell(?p)

# error: cannot infer `T` for `Same` from the arguments
# error: `List()` needs its element type: name it (`List[T]()`)
# error: conflicting types for `T` in `Same`: `Int` (argument 1) and `Static` (argument 2)
# error: `Adder[Static]` cannot use `T = Static`
# error: `Cell[T]` requires `T` to be a value that copies
