# `[N]T` in a generic type needs plain data for `T`: an instance whose
# argument owns a resource is rejected.

struct Wrap[T]
  xs: [2]T

sub main()
  a: Wrap[Int] = Wrap(xs: [1, 2])
  b: Wrap[*Int] = Wrap(xs: [*1, *2])
  print(a.xs[0], b.xs[0])

# error: `Wrap[*Int]` cannot use `T = *Int`: the generic body keeps in an array a value that holds a `T`
