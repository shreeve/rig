# No enum names a variant `none`, nor an error set an error: a plain
# variant, one with a value, a payload variant, and one of a generic
# enum, with payload or without.

enum A
  none

enum B
  one = 1
  none = 2

enum C
  some(v: Int)
  none(why: String)

enum D[T]
  some(v: T)
  none

enum E[T]
  none(v: T)

error Bad
  none

sub main()
  pass

