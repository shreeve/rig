# `.text` and `from_text` are a plain enum's: a payload or generic enum
# has neither, a plain enum declares no member that clashes with them,
# and a variant's name is read as it is, never written or lent.

enum Shape
  dot
  circle(r: Int)

enum Color
  red
  from_text

  fun text(?self) -> Static
    "red"

enum Mode
  on

  fun from_text(word: ?String) -> Int
    0

enum Tag[T]
  a
  b

sub main()
  s: Shape = .dot
  print(s.text, Shape.from_text("dot"))
  m: Mode = .on
  m.text = "off"
  print(m.text(), Mode.from_text(word: "on"), Mode.from_text("a", "b"), Mode.from_text(1))
  t: Tag[Int] = .a
  r = ?m.text
  print(t.text, Tag[Int].from_text("a"), r)

# errors: 13
