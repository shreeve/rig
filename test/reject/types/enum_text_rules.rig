# `.text` and `from_text` are a plain enum's: a payload enum has
# neither, a plain enum declares no member that clashes with them, and
# a variant's name is read, never written.

enum Shape
  dot
  circle(r: Int)

enum Color
  red
  from_text

  fun text(?self) -> Static
    "red"

enum Mode
  on

  fun from_text(word: ?String) -> Int
    0

sub main()
  s: Shape = .dot
  print(s.text, Shape.from_text("dot"))
  m: Mode = .on
  m.text = "off"
  print(m.text(), Mode.from_text(word: "on"), Mode.from_text("a", "b"), Mode.from_text(1))

# errors: 10
# error: 11:3: `from_text` is built into every plain enum
# error: 13:7: `text` is built into every plain enum: `e.text` is the name of `e`'s variant; give the method another name
# error: 19:7: `from_text` is built into every plain enum
# error: 24:11: `.text` is the name of a plain enum's variant; `Shape` has variants with payloads
# error: 24:23: `from_text` gives a plain enum's variant by its name; `Shape` has variants with payloads, which a name cannot build
# error: 26:5: cannot assign to `.text`; a variant's name is read-only
# error: 27:11: no method `text` on type `Mode`; a variant's name is a member, read without a call: `m.text`
# error: 27:24: `Mode.from_text(word)` takes its argument by position
# error: 27:52: `Mode.from_text(word)` takes one argument, a `?String`; got 2
# error: 27:88: type mismatch: expected `?String`, got `Int`
