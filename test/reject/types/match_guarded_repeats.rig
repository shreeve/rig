# A guarded arm may not repeat what an arm before it covers, an integer,
# a Bool, or a variant, nor repeat itself across its alternatives; what
# it covers is its own, so a later arm may repeat it.

enum Light
  red
  amber
  green

fun count(n: Int, k: Int) -> Int
  match n
    1, 2 => 1
    3..6 if k > 0 => 2
    2 if k > 1 => 3
    4..9 if k > 2 => 4
    3..6 => 5
    7, 7 if k > 3 => 6
    _ => 0

fun truth(b: Bool, k: Int) -> Int
  match b
    true => 1
    true if k > 0 => 2
    false if k > 0 => 3
    false => 4

fun light(l: Light, k: Int) -> Int
  match l
    .red => 1
    .amber if k > 0 => 2
    .red if k > 1 => 3
    .green, .green if k > 2 => 4
    .amber => 5

sub main()
  print(count(1, 0), truth(true, 0), light(.red, 0))

# error: 14:5: this pattern overlaps an earlier arm
# error: 17:8: this pattern overlaps an earlier arm
# error: 23:5: this pattern overlaps an earlier arm
# error: 31:5: duplicate arm for variant `red`
# error: 32:13: duplicate arm for variant `green`
# error: 28:9: `match` is not exhaustive: it misses `.green` (its arm has a guard)
