# A slice of a branching value whose branches are write views a name
# holds would copy a write view: each branch is lent instead, and the
# hint writes the slice that way.

fun keep(s: String) -> String
  s

sub f(a: !Text, b: !Text, c: Bool)
  s = keep((a if c else b)[1..])
  r = keep(?(a if c else b)[..2])
  print(s, r)

sub main()
  x = Text("hello")
  y = Text("world")
  f(!x, !y, true)

# error: 9:13: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend what each branch reaches instead (`(?a if c else ?b)[1..]`)
# error: 10:14: cannot lend `a if c else b`: it may be `a`, a value a name holds, which lending the branching value would copy; lend what each branch reaches instead (`(?a if c else ?b)[..2]`)
