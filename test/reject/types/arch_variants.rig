# `Arch`'s variants are Zig's names for the architectures, no others,
# and like `Endian`'s they have no integer value.

fun pick() -> Bool
  x: Arch = .amd64
  x == .x86_64

sub main()
  print(pick(), Int(Arch.x86_64), Int(Endian.big))

