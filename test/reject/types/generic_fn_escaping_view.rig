# Views in a generic function follow the ordinary rules: a view of
# a `?T` parameter may be returned, but not a view of a local copy.

fun keep[T](x: ?T) -> ?T
  x

fun local[T](x: T) -> ?T
  y = <x
  ?y

sub main()
  n = 1
  print(keep(?n), local(2))

# error: 9:4: cannot return a view of `y`, which this function was not lent
