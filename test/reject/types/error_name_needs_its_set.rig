# An error belongs to its set. Against any error (`catch |e|`), a bare
# `.name` is the member of the one error set that has it; when two sets
# have it, the match arm or comparison that one of them used to satisfy
# must name the set. A qualified pattern names a member of an error set,
# and only one the subject can hold.

error Net
  timeout
  refused

error Disk
  timeout

enum Color
  red
  green

struct S
  err: Net

fun fetch(n: Int) -> Int!
  return Disk.timeout if n == 0
  n

sub main
  a = fetch(0) catch |e|
    match e
      .timeout => 1
      Net.bogus => 2
      Net.refused => 3
      Net.refused => 4
      _ => 5
  b = fetch(0) catch |e| 1 if e == .timeout else 2
  n: Net = .refused
  match n
    Disk.timeout => print("disk")
    .timeout => print("timeout")
    .refused => print("refused")
  c = Color.red
  match c
    Color.red => print("red")
    _ => print("other")
  s = S(err: .refused)
  match n
    s.err => print("same")
    _ => pass
  d: Disk = Net.timeout
  print(a, b, n == Disk.timeout, d)

# error: 28:8: error sets `Net` and `Disk` both have a member `timeout`; name the set: `Net.timeout` or `Disk.timeout`
# error: 29:11: no member `bogus` on type `Net`
# error: 31:7: duplicate arm for variant `Net.refused`
# error: 33:37: error sets `Net` and `Disk` both have a member `timeout`; name the set: `Net.timeout` or `Disk.timeout`
# error: 36:5: type mismatch: expected `Net`, got `Disk`
# error: 41:5: a pattern names a variant without its enum: `.red`
# error: 45:5: `s.err` is not a pattern
# error: 47:13: type mismatch: expected `Disk`, got `Net`
# error: 48:15: cannot compare `Net` with `Disk`
# errors: 9
