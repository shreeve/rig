# A closure's `return`s must agree with the value it ends with; one that
# returns a value with `return` must not fall off its end.

sub main()
  a = |x: Int|
    if x > 0
      return 1
  b = |x: Int|
    if x > 0
      return
    5
  c = |x: Int|
    if x > 0
      return "big"
    5

# error: this closure returns `Int` with `return`, so its body must end with a value or a `return`
# error: a bare `return` in a closure that returns `Int`; give it a value
# error: this closure returns `Int`, but this `return` gives `String`
