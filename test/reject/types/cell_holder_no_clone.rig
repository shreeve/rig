# A value that holds a Cell is unique, also as a field of a value behind
# `*`: it has no `+x` clone, and `[n of x]` does not copy one.

struct Counter
  hits: Cell[Int]

struct Holder
  c: Counter
  k: Cell[Int]

sub main()
  h = *Holder(c: Counter(hits: Cell(0)), k: Cell(1))
  b = +h.c
  d = +h.k
  all = [2 of h.c]

# error: 13:8: `+x` cannot clone a `Counter`: it is unique, and a copy would duplicate it; move it with `<x`
# error: 14:8: `+x` cannot clone a `Cell[Int]`: it is unique, and a copy would duplicate it; move it with `<x`
# error: 15:15: `[n of x]` copies its element into every slot; `Counter` is unique, so it cannot be copied
