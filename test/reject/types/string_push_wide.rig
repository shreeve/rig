# `push[T, e]` takes an integer type and, for more than one byte, a
# byte order; `reserve` takes a count.

sub main()
  s = String()
  !s.push[F32, .big](1.5)
  !s.push[Bool, .big](true)
  !s.push[U16](1)
  !s.push[U16, .native](1)
  !s.push[U8, .big, .little](1)
  !s.push[U16, .big]()
  !s.push[U16, .big](1, 2)
  !s.push[U16, .big]("x")
  !s.reserve()
  !s.reserve[U8](1)
  !s.reserve("x")
  !s.push()

