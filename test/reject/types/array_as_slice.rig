# A bare named array where a `![]T` is expected would be written unseen:
# it is written `!a`. A temporary array kept in a field is lent nowhere.
# (A bare array, or a temporary one, as a `[]T` argument is lent to
# read: test/behavior/types/implicit_argument_lends.rig.)

fun total(xs: []Int) -> Int
  xs.len

fun id(xs: []Int) -> []Int
  xs

sub zero(s: ![]Int)
  !s.fill(0)

struct View
  xs: []Int

sub main()
  a = [1, 2, 3]
  print(total(a))
  zero(a)
  r = id([1, 2])
  v = View(xs: [1, 2])
  print(r, v.xs)

# error: 21:8: type mismatch: expected `![]Int`, got `[3]Int`; write `!a` or `!a[..]`
# error: 23:16: a temporary array is lent as a `[]Int` only to a call that keeps no borrow of it; bind it to a name and pass `?name`
