# Only integers, floats, and Bool cross the C boundary; an extern taking
# a `String` (a Zig slice) is rejected.

extern fun puts(s: String) -> Int

sub safe_puts(s: String)
  raw
    puts(s)

sub main()
  safe_puts("hello")

# error: 4:12: `extern` function `puts` cannot take `String`; only integers, floats, and Bool cross the C boundary
