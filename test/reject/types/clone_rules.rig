# A value with a `drop` body has no clone, nor one holding one, nor a
# unique value (Core sentence 2).

obj File
  name: String

  drop(!self)
    print("closing", self.name)

obj Holder
  f: File

obj C unique
  n: Int
  t: String

sub main()
  a = File(name: String("a"))
  b = +a
  hs: List[Holder] = List()
  c = +hs
  d = C(n: 1, t: String("x"))
  e = +d

# error: 19:8: `+x` cannot clone a `File`: a value with a `drop` body
# error: 21:8: `+x` cannot clone a `List[Holder]`
# error: 23:8: `+x` cannot clone a `C`: it holds a unique value
