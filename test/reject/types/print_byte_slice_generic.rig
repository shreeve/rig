# Printability is a fact of each type, checked for each instance of a
# generic body: a `T` that is `[]U8` would print as text. `warn` and
# `panic` print as `print` does.

sub show[T](x: T)
  print(x)

sub main()
  a: [3]U8 = [72, 105, 33]
  show(?a[0..3])
  warn(?a[0..3])
  panic("bad", ?a[0..2])

# error: 10:3: `show[[]U8]` cannot use `T = []U8`: the generic body prints a value that holds a `T`, and a `[]U8` would print as text, like a `?String`
# error: 11:8: cannot warn a `[]U8`: it would warn as text, like a `?String`; warn the bytes one by one
# error: 12:16: cannot print a `[]U8`: it would print as text, like a `?String`; print the bytes one by one
# errors: 3
