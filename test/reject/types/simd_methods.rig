# A vector's methods: `bits`, `any`, `all`, and `select` are a mask's;
# each takes its own arguments; a vector type has only `splat`, and a
# vector is made by naming its lanes and count.

sub main()
  v = Simd[U8, 4].splat(1)
  m = v == 1
  print(v.bits(), v.any(), v.select(v, v))
  print(m.select(v), m.bits(1), v.with(4, 1), v.with(0, 300))
  print(m.select(v, Simd[U8, 8].splat(0)), m.select(v, 1.5))
  print(Simd[U8, 4].zero(), Simd[U8, 4].splat(), Simd[U8, 4].splat(256))
  print(Simd(1), Simd[U8, 4](1), Simd[U8, 4]([1, 2, 3]))
  print(v.sum(), v.min())

