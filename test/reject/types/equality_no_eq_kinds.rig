# A weak handle, a Cell, a Signal, and an owned closure have no `==`.

struct N
  n: Int

struct H
  c: Cell[Int]

sub main()
  s = *N(n: 1)
  w = ~s
  print(w == w)
  h = *H(c: Cell(1))
  print(h.c == h.c)
  g = *Signal(1)
  print(g == g)
  f = *|x: Int| x + 1
  print(f == f)

# error: 12:9: `==` is not defined for `~N`: `~N` is a handle, which could compare by identity or by content
# error: 14:9: `==` is not defined for `Cell[Int]`: `Cell[Int]` has no `==`
# error: 16:9: `==` is not defined for `*Signal[Int]`: `*Signal[Int]` is a handle
# error: 18:9: `==` is not defined for `*fun(Int) -> Int`: `*fun(Int) -> Int` is an owned closure
