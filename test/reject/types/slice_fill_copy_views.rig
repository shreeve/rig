# `fill` and `copy` copy values into the elements, so, as in `[n of x]`,
# the elements must copy: a copy of a value holding a write view would
# give the view two holders. (Read-view elements copy: see
# test/behavior/ownership/copies_fill_read_views.rig.)

struct V
  s: ![]Int

sub fill()
  a = [1, 2]
  b = [3, 4]
  c = [5, 6]
  vs = [V(s: !a[..]), V(s: !b[..])]
  !vs.fill(V(s: !c[..]))
  vs[0].s[0] = 9

sub copy()
  c = [5, 6]
  d = [7, 8]
  xs = [V(s: !c[..])]
  ys = [V(s: !d[..])]
  !ys.copy(?xs[..])
  ys[0].s[0] = 1

sub main()
  fill()

# error: 14:7: `fill` copies values into the elements; a `V` holds a write view, which has one holder
# error: 22:7: `copy` copies values into the elements; a `V` holds a write view, which has one holder
