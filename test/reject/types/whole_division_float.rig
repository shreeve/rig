# Dividing whole-number literals is integer division: a literal's
# context does not reach through `/` or `%`, so where a float is
# expected, `7 / 2` would silently be 3.0. It is rejected, with the
# float spelling.

fun half(x: Float) -> Float
  x / 2

sub main()
  a: Float = 7 / 2
  b = 7 / 2 + 1.5
  c: F32 = 1 + 9 % 4
  d = half(1 / 3)
  x = 2.0
  print(a, b, c, d, x * (5 / 2))

# error: 10:14: `7 / 2` divides whole numbers (3); for 3.5 write `7.0 / 2`
# error: 11:7: `7 / 2` divides whole numbers (3); for 3.5 write `7.0 / 2`
# error: 12:16: `9 % 4` divides whole numbers (1); for 1.0 write `9.0 % 4`
# error: 13:12: `1 / 3` divides whole numbers (0); for 0.3333333333333333 write `1.0 / 3`
# error: 15:26: `5 / 2` divides whole numbers (2); for 2.5 write `5.0 / 2`
