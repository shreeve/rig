# `?p.m()` reads `p` for the call; where a borrow of the call's result
# is expected, the hint puts the borrow around the call.

struct Point
  x: Int

  fun shifted(?self, d: Int) -> Point
    Point(x: self.x + d)

sub show(p: ?Point)
  print(p.x)

sub main
  p = Point(x: 1)
  show(?p.shifted(4))
  h = *Point(x: 9)
  show(?h.shifted(1))

# error: 15:8: `?p.shifted(4)` reads `p` for the call; write `?(p.shifted(4))` to borrow the call's result
# error: 17:8: write `?(h.shifted(1))` to borrow the call's result
