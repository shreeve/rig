# A generic loop over a `?Vec[T]` binds a copy of each element that it
# only reads, so each instance must give a `T` that holds no Cell: a
# change to the Cell would land in the copy alone. (A `T` that owns is
# read in the copy, and never dropped there.)

struct C
  c: Cell[Int]

  sub hit(?self)
    self.c.set(self.c.get() + 1)

sub each[T](v: ?Vec[T], f: ?sub(?T))
  for x in v
    f(x)

sub main
  v: Vec[C] = Vec()
  !v.push(C(c: Cell(1)))
  each(?v, |x| x.hit())
  print(v[0].c.get())

# error: `each[C]` cannot use `T = C`: the generic body copies into a loop binding a value that holds a `T`, and `C` holds a Cell
