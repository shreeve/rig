# A shared handle is already counted: calling `upgrade` on one (whose
# type has no `upgrade` method) is rejected, pointing at `*w` of a weak
# handle.

obj User
  name: ?String

sub main()
  rc = *User(name: "x")
  m  = rc.upgrade()
  <rc

# error: 10:11: a shared handle `*User` is already counted, and has no `upgrade`; a weak handle `w` of one (`~h`) upgrades with `*w`
