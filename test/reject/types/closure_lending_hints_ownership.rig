# A closure does not move a view out of its capture: a viewed
# parameter is captured with `|?f|`, and a captured view stays with the
# closure for every call.

struct Res
  id: Int

sub outer(f: ?fun(Int) -> Int)
  g = |<f| f(1)
  print(g())

sub eat(r: !Res)
  print(r.id)

sub main
  outer(|a: Int| a + 1)
  r = Res(id: 1)
  e = |!r|
    eat(<r)
  e()

# error: 9:9: cannot move-capture view parameter `f`; the caller still owns what it views. Capture the view with `|?f|`
# error: 19:10: cannot move captured view `r`; the closure holds it for every call
