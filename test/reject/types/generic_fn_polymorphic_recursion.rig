# A generic function that calls itself with a deeper instance of its own
# type parameter (`nest[Wrap[T]]` from `nest[T]`) would need ever deeper
# instances; it is rejected rather than expanded forever.

struct Wrap[T]
  v: T

fun nest[T](x: T, n: Int) -> Int
  if n == 0
    return 0
  nest(Wrap(v: <x), n - 1)

sub main()
  print(nest(1, 3))

# error: 14:9: `nest[Int]` leads to ever deeper instances of generic functions (through `nest[Wrap[T]]`); a generic function cannot call itself with its own type parameters nested deeper
