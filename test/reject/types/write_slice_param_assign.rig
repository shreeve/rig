# A `![]T` parameter views the caller's elements: it is written element
# by element, and never points elsewhere.

sub f(s: ![]Int, t: ![]Int)
  s = <t
  s[0] = 7

sub main()
  a = [1, 2]
  b = [3, 4]
  f(!a[..], !b[..])

# error: 5:7: cannot point parameter `s` at another place: parameters are immutable, and `s[i] = v` writes its elements
