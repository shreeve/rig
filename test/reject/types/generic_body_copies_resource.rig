# A generic body is checked once, for any `T`. Where it discards a `T`,
# leaves one as a temporary, or copies one into a closure, every
# instantiation must use plain data for `T`.

struct B
  n: Int

struct Keeper[T]
  v: T

  fun id(?self, x: T) -> T
    <x

  sub run(?self, x: T)
    self.id(<x)

struct Counter[T]
  v: T

  fun count(?self, x: T) -> Int
    f = |+x| 1
    f()

sub main()
  k: Keeper[*B] = Keeper(v: *B(n: 2))
  c: Counter[*B] = Counter(v: *B(n: 4))
  i: Counter[Int] = Counter(v: 4)
  print(i.count(5))

# error: `Keeper[*B]` cannot use `T = *B`: the generic body discards a value that holds a `T`
# error: `Counter[*B]` cannot use `T = *B`: the generic body copies into a closure a value that holds a `T`
