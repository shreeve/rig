# A generic body is checked once, for any `T`. Where it copies a `T`,
# discards one, leaves one as a temporary, or copies one into a
# closure, every instantiation must use plain data for `T`, including
# instantiations reached through another generic's body (`Opt[*B]`
# through `Holder[*B]`).

struct B
  n: Int

struct Box[T]
  v: T

  fun get(?self) -> T
    self.v

struct Keeper[T]
  v: T

  fun id(?self, x: T) -> T
    <x

  sub run(?self, x: T)
    self.id(<x)

enum Opt[T]
  some(v: T)
  nothing

  fun copy_out(?self, d: T) -> T
    match self
      .some(v) => v
      .nothing => <d

struct Counter[T]
  v: T

  fun count(?self, x: T) -> Int
    f = |+x| 1
    f()

struct Holder[T]
  v: T

  fun peek(?self, x: T, d: T) -> Int
    o: Opt[T] = .some(v: <x)
    c = o.copy_out(<d)
    1

sub main()
  a: Box[Int] = Box(v: 1)
  print(a.get())
  b: Box[*B] = Box(v: *B(n: 1))
  k: Keeper[*B] = Keeper(v: *B(n: 2))
  h: Holder[*B] = Holder(v: *B(n: 3))
  c: Counter[*B] = Counter(v: *B(n: 4))
  i: Counter[Int] = Counter(v: 4)
  print(i.count(5))

# error: `Box[*B]` cannot use `T = *B`: the generic body copies a `T`
# error: `Keeper[*B]` cannot use `T = *B`: the generic body discards a value that holds a `T`
# error: `Opt[*B]` cannot use `T = *B`: the generic body copies a `T`
# error: `Counter[*B]` cannot use `T = *B`: the generic body copies into a closure a value that holds a `T`
