# Only a boxed struct or enum has its fields and methods reached through
# the box; a box of anything else is lent (`?b`, `!b`) or taken apart
# (`<b.unbox()`). A box holds no borrow, has no `==`, and its own
# consuming `unbox` and its value's consuming methods need an owned box.

struct View
  p: ?Int

struct R
  n: Int

  sub eat(<self)
    print(self.n)

sub f(b: ?Box[R])
  <b.eat()
  q = <b.unbox()
  print(q.n)

sub main
  c = Box(value: 5)
  print(c.value + 1)
  v = Box(value: Vec[Int]())
  !v.push(3)
  n = 3
  w = Box(value: View(p: ?n))
  a = Box(value: R(n: 1))
  b = Box(value: R(n: 1))
  print(a == b)
  print(c + 1)

# error: 16:6: method `eat` consumes the receiver; cannot consume through a borrowed value
# error: 17:10: method `unbox` consumes the receiver; cannot consume through a borrowed value
# error: 22:11: a `Box[Int]` reaches no fields of its value; lend the value with `?c` or `!c`, or move it out with `<c.unbox()`
# error: 24:6: a `Box[Vec[Int]]` reaches no methods of its value
# error: 26:7: `Box[T]` owns its value, so `T` holds no borrow; got `View`
# error: 29:9: `==` is not defined for `Box[R]`
# error: 30:9: operator `+` requires numeric operands; got `Box[Int]`
