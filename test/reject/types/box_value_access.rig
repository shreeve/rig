# A box's value has its fields and methods reached through the box (a
# List's `push`), but a box has no field `value` of its own. A box holds
# has no `==`, and its own consuming `unbox` and its value's consuming
# methods need an owned box.

obj R
  n: Int

  sub eat(<self)
    print(self.n)

sub f(b: ?^R)
  <b.eat()
  q = <b.unbox()
  print(q.n)

sub main()
  c = ^5
  print(c.value + 1)
  v = ^List[Int]()
  !v.push(3)
  a = ^R(n: 1)
  b = ^R(n: 1)
  print(a == b)
  print(c + 1)

# error: 13:6: method `eat` consumes the receiver; cannot consume through a view
# error: 14:10: method `unbox` consumes the receiver; cannot consume through a view
# error: 19:11: type `^Int` has no field `value`
# error: 24:9: `==` is not defined for `^R`
# error: 25:9: operator `+` requires numeric operands; got `^Int`
