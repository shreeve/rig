# A box's value has its fields and methods reached through the box (a
# Vec's `push`), but a box has no field `value` of its own. A box holds
# has no `==`, and its own consuming `unbox` and its value's consuming
# methods need an owned box.

struct R
  n: Int

  sub eat(<self)
    print(self.n)

sub f(b: ?Box[R])
  <b.eat()
  q = <b.unbox()
  print(q.n)

sub main()
  c = Box(5)
  print(c.value + 1)
  v = Box(Vec[Int]())
  !v.push(3)
  a = Box(R(n: 1))
  b = Box(R(n: 1))
  print(a == b)
  print(c + 1)

# error: 13:6: method `eat` consumes the receiver; cannot consume through a view
# error: 14:10: method `unbox` consumes the receiver; cannot consume through a view
# error: 19:11: type `Box[Int]` has no field `value`
# error: 24:9: `==` is not defined for `Box[R]`
# error: 25:9: operator `+` requires numeric operands; got `Box[Int]`
