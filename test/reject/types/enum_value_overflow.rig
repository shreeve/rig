# A variant's value that overflows its type is reported as an overflow,
# and the enum stays a plain one: converting its variants to integers
# reports nothing further.

enum Small
  a = U8(300)
  b

enum Shifted
  low = I8.max + 1

sub main()
  print(Int(Small.b), Int(Shifted.low))

# error: 6:10: an enum value `U8(300)` overflows `U8` (0..255)
# error: 10:9: an enum value `I8.max + 1` overflows `I8` (-128..127)
