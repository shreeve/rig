# A variant literal whose enum comes from where it goes is, where a
# view held by address goes, the value `Val.V(...)` is, and is rejected
# where that value is: lent to write, kept in a field, an element, or a
# binding, returned, a view of an optional, or a parameter's default.

enum Val
  Num(n: Int)
  Table(m: List[Int])
  Empty

enum Color
  Red
  Green

obj Ref
  v: ?Val

sub write(v: !Val)
  print("write")

sub paint(c: !Color)
  print("paint")

sub opt(v: ?Val?)
  print("opt")

sub fallback(v: ?Val = .Empty)
  print("fallback")

fun made() -> ?Val
  return .Num(n: 3)

sub main()
  write(.Num(n: 3))
  paint(.Red)
  r = Ref(v: .Num(n: 3))
  xs: [1]?Val = [.Num(n: 3)]
  v: ?Val = .Table(m: List())
  opt(.Num(n: 3))
  fallback()
  print(r, xs, v, made())

