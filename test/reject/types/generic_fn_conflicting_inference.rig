# Every argument that determines a type parameter must agree on it. A
# literal takes its default type only when no other argument gives the
# parameter a type. The diagnostic suggests brackets only when every
# argument can have the suggested type, and otherwise a conversion.

fun max[T](a: T, b: T) -> T
  a if a > b else b

sub main()
  x: I32 = 3
  y: I64 = 4
  z: Float = 1.5
  print(max("s", 2))
  print(max(x, y))
  print(max(x, 2.5))
  print(max(2.5, x))
  print(max(2, z), max(x, 2))
  print(max(1, "s"))

# error: 13:9: conflicting types for `T` in the call to `max`: `String` (argument 1) and `Int` (argument 2); they must have one type
# error: 14:9: conflicting types for `T` in the call to `max`: `I32` (argument 1) and `Int` (argument 2); convert argument 1 with `Int(...)`
# error: 15:9: conflicting types for `T` in the call to `max`: `I32` (argument 1) and `Float` (argument 2); convert argument 1 with `Float(...)`
# error: 16:9: conflicting types for `T` in the call to `max`: `Float` (argument 1) and `I32` (argument 2); convert argument 2 with `Float(...)`
# error: 18:9: conflicting types for `T` in the call to `max`: `Int` (argument 1) and `String` (argument 2)
