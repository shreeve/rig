# A name bound by `for`, a match pattern, or `as` must be read, or be
# `_`, unless its value moves, as the error `catch |e|` names does: a
# value that moves may be bound only to be dropped at the scope's end.

enum Shape
  circle(r: Int)
  dot

fun maybe(n: Int) -> Int?
  n if n > 0 else none

sub main()
  for i in 0..2
    print("tick")
  s: Shape = .circle(r: 1)
  match s
    .circle(r) => print("circle")
    other => print("other")
  if maybe(1) as m
    print("some")

# error: 13:7: `i` is bound but never read
# error: 17:13: `r` is bound but never read
# error: 18:5: `other` is bound but never read
# error: 19:18: `m` is bound but never read
