# A function marked `inline` that is generic over a type adds its values
# to the frame of each function it is inlined into, at the instance the
# call makes: `near_limit` is under 13 MiB without `bump`'s 32 KB, and
# over with it.

inline fun bump[T](x: T, i: Int) -> T
  t = [4000 of x]
  t[i % 4000]

sub near_limit(i: Int)
  a = [850000 of 1]
  b = [850000 of 2]
  print(bump(7, i) + a[i] + b[i])

sub main()
  near_limit(3)

# error: 10:5: `near_limit` keeps 13632032 bytes of values on its stack
# errors: 1
