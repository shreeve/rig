# `<` before a method call moves the receiver into it, so the method
# must consume it (`self: Self`); a call's result moves without `<`.

struct Stack
  items: Vec[Int]
  fun top(?self) -> Int?
    self.items.get(0)
  fun pop(!self) -> Int?
    !self.items.pop()

sub main
  s = Stack(items: Vec())
  a = <s.top()
  b = <s.pop()
  print(a ?? 0, b ?? 0)

# error: 13:7: `top` does not consume its receiver; drop the `<`: a call's result moves without it
# error: 14:7: `pop` does not consume its receiver; it writes it: `!s.pop(...)`, and its result needs no `<`
