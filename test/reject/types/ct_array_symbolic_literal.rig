# An array whose length is a compile-time parameter is built with
# `[n of x]`: a list of elements has a length of its own.

fun zeros[n: Int] -> [n]Int
  a: [n]Int = [0, 0]
  a

sub main()
  print(zeros[2]())

# error: 5:15: an array of compile-time length `n` is built with `[n of x]`, not a list of elements
