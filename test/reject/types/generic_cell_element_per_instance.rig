# A built-in generic constructed in a generic body (`Cell(value: self.v)`
# in `Box[T]`) is checked for each instance: `Cell[Pt]` holds plain data
# that is neither a Copy primitive nor has drop glue.

type Box[T]
  v: T

  fun peek(?self) -> Int
    c = Cell(value: self.v)
    1

struct Pt
  x: Int

sub main()
  b: Box[Pt] = Box(v: Pt(x: 1))
  print(b.peek())

# error: `Box[Pt]` instantiates `Cell[Pt]`: `Cell[T]` requires `T` to be a Copy primitive
