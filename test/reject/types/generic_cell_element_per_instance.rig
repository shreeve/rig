# A built-in generic constructed in a generic body (`Cell(self.v)` in
# `Wrap[T]`) is checked for each instance: `Cell[fun(Int) -> Int]` holds
# a function, which is neither plain data nor has drop glue.

struct Wrap[T]
  v: T

  fun peek(?self) -> Int
    c = Cell(self.v)
    _ = c
    1

fun inc(x: Int) -> Int
  x + 1

sub main()
  b: Wrap[fun(Int) -> Int] = Wrap(v: inc)
  print(b.peek())

# error: instantiates `Cell[fun(Int) -> Int]`: `Cell[T]` requires `T` to be a value that copies
