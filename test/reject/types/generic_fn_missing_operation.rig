# A generic function's body is checked for every instance its calls
# make: `>` is defined for numbers and Strings, not for a struct, and
# the error names the call and, in a note, the body line that needs it.

struct P
  n: Int

fun max[T](a: T, b: T) -> T
  a if a > b else b

fun bump[T](x: T) -> T
  x + 1

sub main()
  print(max(3, 7))
  print(max(P(n: 1), P(n: 2)).n)
  print(bump(P(n: 1)).n)
  print(bump(true))

# error: 16:9: `max[P]` cannot use `T = P`: the generic body applies `>` to `T`, which `P` does not support
# error: 17:9: `bump[P]` cannot use `T = P`: the generic body applies `+` to `T`, which `P` does not support
# error: 18:9: `bump[Bool]` cannot use `T = Bool`: the generic body applies `+` to `T`, which `Bool` does not support
