# A type parameter, `fun size[T]`, would declare a generic function,
# which Rig does not support yet; the function is reported once, not at
# each use of `T` or at its calls.

fun size[T](x: T) -> Int
  y: T = x
  3

sub main()
  print(size[Int](5))

# error: generic functions are not supported yet: the type parameter `T` would make `size` generic
