# A generic body's operations on `T` are requirements on every
# instantiation: `self.value + 1` needs a numeric `T`, so `Wrap[String]` is
# rejected.

struct Wrap[T]
  value: T

  fun bump(?self) -> T
    self.value + 1

sub main()
  b: Wrap[String] = Wrap(value: "a")
  print(b.bump())

# error: 12:6: `Wrap[String]` cannot use `T = String`: the generic body applies `+` to `T`, which `String` does not support
