# A named Text is lent where a String is expected with a visible `?`:
# `?t` means `?t[..]`, and a borrow of one lends it as is. A bare Text
# says what to write.

fun n(s: String) -> Int
  s.len

fun a(p: ?Text) -> Int
  n(?p) + n(?p[1..])

fun b(p: ?Text) -> Int
  n(p)

sub main
  t = Text("abc")
  print(a(?t), n(t), n(?Text("x")))

# error: 16:18: type mismatch: expected `String`, got `Text`; lend it as a String with `?t` or `?t[..]`
