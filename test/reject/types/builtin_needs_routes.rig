# A built-in method that copies a `T` declares that `T` must copy, and
# every call meets it, as `xs.m(...)` and as `Type.m(xs, ...)` through
# the type, and in a generic body for each instance: `Cell.get` and
# `List.get` copy a value out of what they keep, `List.filled` and
# `resize` copy one into every element they make.

type Names = List[String]

fun first[T](xs: ?List[T]) -> T?
  List.get(xs, 0)

fun peek[T](c: ?Cell[T]) -> T
  Cell[T].get(c)

fun look[T](c: ?Cell[T]) -> T
  c.get()

sub grow[T](xs: !List[T], x: T)
  List.resize(!xs, 3, x)

sub main()
  c = *Cell(String("a"))
  a = c.get()
  b = Cell[String].get(?c)
  xs: List[String] = List()
  !xs.push(String("x"))
  d = xs.get(0)
  e = List.get(?xs, 0)
  f = Names.get(?xs, 0)
  bx = ^List[String]()
  g = bx.get(0)
  !xs.resize(2, String("y"))
  List[String].resize(!xs, 2, String("z"))
  h = List.filled(2, String("w"))
  k = List[String].filled(2, String("v"))
  print(first(?xs), peek(?c), look(?c))
  grow(!xs, String("u"))
  print(a, b, d, e, f, g, h, k)

