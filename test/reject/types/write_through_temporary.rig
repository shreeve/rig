# No value a binding does not hold carries a write view in a field to be
# written through (`mk(!n).w = 5`): a write view is never stored inside
# a value, so the field is rejected where it is declared.

struct H
  w: !Int

sub main()
  n = 1
  print(n)

# error: 6:6: a write view is never stored inside a value, and `!Int` cannot stand here
# errors: 1
