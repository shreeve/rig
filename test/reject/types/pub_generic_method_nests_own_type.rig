# A generic method of a public generic type that calls itself on an
# instance of its type nested in its own and the method's parameters
# (`Chain[Pair[T, U]]` from `Chain[T]`) nests ever deeper; it is reported
# where it is declared.

pub obj Pair[A, B]
  a: A
  b: B

pub obj Chain[T]
  items: List[T]

  fun deep[U](?self, u: U) -> Int
    out: List[Pair[T, U]] = List()
    l = Chain(items: <out)
    l.deep(u)

sub main()
  v: List[Int] = List()
  l = Chain(items: <v)
  print(l.items.len)

# error: 13:7: `deep[U]` leads to ever deeper instances of generic types (through `List[Pair[T, U]]`)
