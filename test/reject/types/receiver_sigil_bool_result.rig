# A write-borrowing call whose value is a `Bool` is written with the
# borrow in parentheses where a leading `!` could read as negation: a
# condition and an operand of `and`, `or`, or `not`.

struct Set
  items: Vec[Int]
  fun insert(!self, k: Int) -> Bool
    for x in ?self.items
      return false if x == k
    !self.items.push(k)
    true
  fun checked(!self, k: Int) -> Bool!
    self.insert(k)

fun fill(s: !Set) -> Int!
  if !s.checked(3)!
    return 1
  0

sub main
  set = Set(items: Vec())
  if !set.insert(1)
    print("new")
  while !set.insert(2)
    print("again")
  print("dup") if !set.insert(3)
  a = true and !set.insert(4)
  b = !set.insert(5) or false
  c = not !set.insert(6)
  d = 1 if !set.insert(7) else 0
  print(a, b, c, d)
  print(fill(!set) catch 0)

# error: 16:6: a write-borrowing call that returns `Bool` is written `(!s).checked(...)`, so it is never read as negation
# error: 22:6: a write-borrowing call that returns `Bool` is written `(!set).insert(...)`, so it is never read as negation
# error: 24:9: `(!set).insert(...)`
# error: 26:19: `(!set).insert(...)`
# error: 27:16: `(!set).insert(...)`
# error: 28:7: `(!set).insert(...)`
# error: 29:11: `(!set).insert(...)`
# error: 30:12: `(!set).insert(...)`
