# A write call whose value is used is written with the lend in
# parentheses, `(!s).m(...)`, so a leading `!` never reads as negation:
# here, a `Bool` in a condition and an operand of `and`, `or`, or `not`.

struct Set
  items: Vec[Int]
  fun insert(!self, k: Int) -> Bool
    for x in ?self.items
      return false if x == k
    !self.items.push(k)
    true
  fun checked(!self, k: Int) -> Bool!
    self.insert(k)

fun fill(s: !Set) -> Int!
  if !s.checked(3)!
    return 1
  0

sub main()
  set = Set(items: Vec())
  if !set.insert(1)
    print("new")
  while !set.insert(2)
    print("again")
  print("dup") if !set.insert(3)
  a = true and !set.insert(4)
  b = !set.insert(5) or false
  c = not !set.insert(6)
  d = 1 if !set.insert(7) else 0
  print(a, b, c, d)
  print(fill(!set) catch 0)
  if !set.insert(8) == false
    print("seen")
  e = true and !set.insert(9) == true
  f = not (!set.insert(10) == true)
  print("x") if !set.insert(11) != false
  g = 1 if !set.insert(12) == true else 2
  print(e, f, g)
# error: 16:6: write `(!s).checked(3)`: a write call whose value is used puts its `!` in parentheses
# error: 22:6: write `(!set).insert(1)`: a write call whose value is used puts its `!` in parentheses
# error: 24:9: write `(!set).insert(2)`: a write call whose value is used puts its `!` in parentheses
# error: 26:19: write `(!set).insert(3)`: a write call whose value is used puts its `!` in parentheses
# error: 27:16: write `(!set).insert(4)`: a write call whose value is used puts its `!` in parentheses
# error: 28:7: write `(!set).insert(5)`: a write call whose value is used puts its `!` in parentheses
# error: 29:11: write `(!set).insert(6)`: a write call whose value is used puts its `!` in parentheses
# error: 30:12: write `(!set).insert(7)`: a write call whose value is used puts its `!` in parentheses
# error: 33:6: write `(!set).insert(8)`: a write call whose value is used puts its `!` in parentheses
# error: 35:16: write `(!set).insert(9)`: a write call whose value is used puts its `!` in parentheses
# error: 36:12: write `(!set).insert(10)`: a write call whose value is used puts its `!` in parentheses
# error: 37:17: write `(!set).insert(11)`: a write call whose value is used puts its `!` in parentheses
