# The elements of a Cell's List of handles are not read or overwritten in
# place: that would copy a handle out, or release one, while the cell
# holds the List. `pop` them, or `replace` the List.

obj N
  id: Int

sub main()
  hs: Cell[List[*N]] = Cell(List())
  !hs.push(*N(id: 1))
  a = hs[0]
  b = hs.get(0)
  hs[0] = *N(id: 2)
  c = hs.get()
  print(a, b, c)

# error: 11:7: cannot read or overwrite an element of a `Cell[List[*N]]` in place
# error: 12:10: cannot read or overwrite an element of a `Cell[List[*N]]` in place
# error: 13:3: cannot read or overwrite an element of a `Cell[List[*N]]` in place
# error: 14:10: `Cell.get` returns a copy of the value, and a `List[*N]` owns what it must release, so it can't be copied; write `(!cell).replace(<new)`, which puts `new` in and hands back the old value
