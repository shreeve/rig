# A constant lives for the whole program and never changes (Core
# sentence 7), so it is never lent to write: a literal, `none`, an enum
# variant that holds no payload, an error value, a number type's limit,
# an operator applied to constants, or a value that branches, every
# value of which is a constant. One that may be a value made at run time
# is a temporary instead. (A module's constant is a name:
# `module_constant_write.rig`; another module's variant:
# `modules/foreign_variant_write`.)

enum Color
  red
  green

error E
  bad
  worse

sub setc(c: !Color)
  c = .green

sub sete(e: !E)
  e = .worse

sub setb(b: !Bool)
  b = true

sub sets(s: !String)
  s = "x"

sub seto(o: !Int?)
  o = 1

sub inc(n: !Int)
  n += 1

sub setu(u: !U8)
  u = 1

fun f(n: Int) -> Int
  n

sub main
  setc(!Color.red)
  sete(!E.bad)
  setb(!false)
  sets(!"abc")
  seto(!none)
  inc(!5)
  inc(!-5)
  inc(!(2 + 3))
  setb(!(not true))
  setc(!(Color.red if f(1) == 1 else Color.green))
  inc(!Int.max)
  setu(!U8.max)
  inc(!(Int.max - 1))
  inc(!(5 if f(1) == 1 else f(2)))

