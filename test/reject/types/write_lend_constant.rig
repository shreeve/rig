# A constant lives for the whole program and never changes (Core
# sentence 7), so it is never lent to write: a literal, `none`, an enum
# variant that holds no payload, an error value, an operator applied to
# constants, or a branch of a value that may be one. (A module's
# constant is a name: `module_constant_write.rig`.)

enum Color
  red
  green

error E
  bad
  worse

sub setc(c: !Color)
  c = .green

sub sete(e: !E)
  e = .worse

sub setb(b: !Bool)
  b = true

sub sets(s: !String)
  s = "x"

sub seto(o: !Int?)
  o = 1

sub inc(n: !Int)
  n += 1

fun f(n: Int) -> Int
  n

sub main
  setc(!Color.red)
  sete(!E.bad)
  setb(!false)
  sets(!"abc")
  seto(!none)
  inc(!5)
  inc(!-5)
  inc(!(2 + 3))
  setb(!(not true))
  setc(!(Color.red if f(1) == 1 else Color.green))

# error: 37:9: cannot lend `Color.red` to write: it is a constant, which lives for the whole program and never changes
# error: 38:9: cannot lend `E.bad` to write: it is a constant
# error: 39:9: cannot lend `false` to write: it is a constant
# error: 40:9: cannot lend `"abc"` to write: it is a constant
# error: 41:9: cannot lend `none` to write: it is a constant
# error: 42:8: cannot lend `5` to write: it is a constant
# error: 43:8: cannot lend `-5` to write: it is a constant
# error: 44:9: cannot lend `2 + 3` to write: it is a constant
# error: 45:10: cannot lend `not true` to write: it is a constant
# error: 46:10: cannot lend `Color.red` to write: it is a constant
