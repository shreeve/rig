# A closure whose result type is inferred gives its `return`s no type to
# take: a later `return max(3, 4)` stays `Int`. The error says to give
# the closure its type where it goes, which every `return` then takes.

fun max[T](a: T, b: T) -> T
  a if a > b else b

sub main
  c = true
  f = |+c, x: U8|
    if c
      return x
    return max(3, 4)
  print(f(7))

# error: 13:5: this closure returns `U8`, but this `return` gives `Int`; give the closure its type where it goes (`f: fun(...) -> U8 = |...| ...`), and every `return` takes it
