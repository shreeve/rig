# The length of a Vec, String, array, or slice is the field `len`, not a
# method.

fun count(xs: []Int) -> Int
  xs.len()

sub main()
  v: Vec[Int] = Vec()
  s = "abc"
  a = [1, 2]
  print(v.len(), s.len(), a.len(), ?v.len(), count(?a[..]))

