# An enum with a payload variant and Bools have no ordering.

enum Shape
  dot
  circle(r: Int)

sub main()
  c = Shape.dot
  print(c < Shape.dot)
  print(true >= false)

# error: 9:9: operator `<` orders a plain enum's values; `Shape` has variants with payloads, which have no integer value
# error: 10:9: operator `>=` orders numbers, plain enums, Strings, and `[]U8` slices; got `Bool`
