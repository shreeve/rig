# The diagnostic names the field path to what has no `==`, through
# nested structs, arrays, optionals, and enum payloads; a List has none.

obj Res
  n: Int

  drop(!self)
    print("drop", self.n)

obj Inner
  items: List[Int]

obj Outer
  tag: Int
  inner: Inner

enum Slot
  empty
  full(held: Res)

obj Rack
  slots: [2]Slot?

sub main()
  a = Outer(tag: 1, inner: Inner(items: List()))
  b = Outer(tag: 1, inner: Inner(items: List()))
  print(a == b)
  r = Rack(slots: [none, none])
  s = Rack(slots: [none, none])
  print(r == s)

# error: 27:9: `==` is not defined for `Outer`: field `inner.items` is a `List[Int]`, which has no `==`
# error: 30:9: `==` is not defined for `Rack`: field `slots.full.held` is a `Res`: `Res` declares `drop`
