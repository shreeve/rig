# A shared handle cannot itself be shared: `*(*T)` adds a second
# refcount for nothing. Clone the handle with `+x` instead.

struct Noisy
  id: Int

sub main()
  inner = *Noisy(id: 4)
  outer: *(*Noisy) = *(<inner)
  print("wrapped")

# error: 9:12: nested shared type `**T` is not meaningful; use a single `*T`
