# A generic body's `m.get(k) ?? d` copies out the `T` the view reaches,
# so an instance whose `T` does not copy is rejected where it is made.

use std.hash

fun lookup[T](m: ?hash.Map[String, T], k: ?String, d: T) -> T
  m.get(k) ?? d

sub main()
  n = hash.Map[String, Int]()
  print(lookup(?n, "a", 0))
  m = hash.Map[String, String]()
  print(lookup(?m, "a", String("d")))

# errors: 1
# error: 13:9: `lookup[String]` cannot use `T = String`: the generic body copies out with `??` a value that holds a `T`
