# `push` appends one `U8`; `for` walks no iterator, and says how to.

use std.text

sub main
  t = Text()
  !t.push("ab")
  !t.push(1, 2)
  !t.push(b: U8(68))
  for p in text.split("a,b", ",")
    print(p)

# error: 7:11: type mismatch: expected `U8`, got `String`
# error: 8:6: `push` takes one byte, a `U8`; got 2 arguments
# error: 9:11: `push` takes its byte by position, not by name: `!t.push(U8(68))`
# error: 10:12: to walk an iterator, bind it and loop: `it = text.split("a,b", ",")` then `while !it.next() as x`
# errors: 4
