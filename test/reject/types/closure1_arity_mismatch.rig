# Calling a `*Closure1(Int)` with zero or two arguments is an arity
# error.

sub main()
  v: *Cell(Int) = *Cell(value: 0)
  cb: *Closure1(Int) = *Closure1(Int)(|+v| (a: Int) v.set(a))
  cb()
  cb(1, 2)

# error: owned closure `cb` invocation expects 1 argument(s); got 0
# error: owned closure `cb` invocation expects 1 argument(s); got 2
