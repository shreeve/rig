# A generic parameter needs a name of its own: not a built-in type, not
# `Self`, not a module-level declaration or a method of the type. Inside
# the type, locals and parameters cannot reuse it either.

obj Item
  n: Int

obj Shadow[Item]
  v: Item

obj Prim[Int]
  v: Int

obj Builtin[List]
  v: List

obj Own[T]
  v: T

  fun T(?self) -> Int
    1

obj Uses[U]
  v: U

  fun f(?self, U: Int) -> Int
    U = 3
    U

sub main()
  print(1)

# error: generic parameter `Item` has the same name as the module-level declaration `Item`
# error: generic parameter `Int` has the name of a built-in type
# error: generic parameter `List` has the same name as the module-level declaration `List`
# error: generic parameter `T` has the same name as a method of the type
# error: parameter `U` has the name of the generic parameter `U`
