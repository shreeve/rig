# `?T?` is a view of a `T?`, not an optional view: `none` is no value of
# it, and the hint names the spelling of a view that may be missing.

fun first(v: ?List[Int]) -> ?List[Int]?
  return none if v.len == 0
  v

fun head(t: ?String) -> !String?
  return none if t.len == 0
  t

sub main()
  v: List[Int] = List()
  _ = first(?v)

# error: 5:10: `none` needs an optional type; `?List[Int]?` is a view of an optional, not an optional view (write `(?List[Int])?`)
# error: 9:10: `none` needs an optional type; `!String?` is a view of an optional, not an optional view (write `(!String)?`)
