# Only a call's write view, or that call's `!` or `?`, is assigned
# through. `w?` of a parameter `w: (!H)?` is not: assigning it would
# store a view of local `d` in the caller's `H`, which outlives `d`.

obj H
  s: ?String

fun set(w: (!H)?) -> Int?
  d = String("local")
  w? = H(s: ?d)
  0

sub main()
  t = String("outer")
  h = H(s: ?t)
  print(set(!h))
  print(h.s)

# errors: 1
# error: 10:3: cannot assign to `w?`: only a call that returns a write view (`!T`), or that call's `!` or `?`, is assigned through
