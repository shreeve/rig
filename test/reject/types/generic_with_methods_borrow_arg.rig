# The methods of a generic type are checked for a `T` that holds no
# borrow, so such a type cannot be instantiated with a borrow. (A generic
# type without methods can hold one.)

struct P
  n: Int

struct Wrap[T]
  v: T

  fun get(?self) -> T
    self.v

sub main()
  p = P(n: 1)
  b: Wrap[?P] = Wrap(v: ?p)

# error: `Wrap[?P]` cannot use `T = ?P`: the methods of `Wrap` are checked for a `T` that holds no borrow
