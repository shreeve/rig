# A write call whose value is used, whatever its type, is written
# `(!v).m(...)`: a binding, an `as` header of `if` and `while`,
# an operand, `??`, an argument, an array element, `return`, a
# function's and a closure's last line, a `match` subject, a value
# `if`'s branch, and a `catch` whose value is used. The hint is the
# call to write.

error E
  bad

struct Counter
  n: Int

  fun next(!self) -> Int
    self.n += 1
    self.n

  fun twice(!self) -> Int
    !self.next()
    !self.next()

  fun take(!self) -> Int!
    return E.bad if self.n > 9
    self.n

fun last(c: !Counter) -> Int
  return !c.next() if c.n > 5
  !c.next()

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  !v.push(2)
  c = Counter(n: 0)
  x = !v.remove(0)
  !v.pop()
  if !v.pop() as t
    print(t)
  while !v.pop() as t
    print(t)
  n = !c.next() + 1
  m = !v.pop() ?? 0
  print(!c.next(), [!c.next()], last(!c))
  match !c.next()
    1 => print("one")
    _ => pass
  y = !c.next() if x > 0 else 0
  z = !c.take() catch 0
  f = |!c| !c.next()
  print(x, n, m, y, z, f())

