# A generic `match` never matches a copy of a value that holds a Cell:
# such a value is never a generic type argument (`Opt[C]`, `W[C]`), since
# it lives only behind a shared handle, so each is rejected where it is
# written.

struct C
  c: Cell[Int]

enum Opt[T]
  some(v: T)
  nothing

struct W[T]
  o: Opt[T]

fun hit(o: ?Opt[C]) -> Int
  0

sub main()
  w: *W[C] = *W(o: .nothing)
  print(hit(?w.o))

# error: 20:7: a value of `C` holds a Cell, so it lives only behind a shared handle: write `*C`
# error: 16:13: a value of `C` holds a Cell, so it lives only behind a shared handle: write `*C`
# errors: 2
