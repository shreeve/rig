# A loop's `else` runs after the loop, so a jump there cannot name it.
struct S
  s: []Int

fun mk(v: ?Vec[Int], i: Int) -> S?
  if i < 3
    return S(s: ?v[..])
  none

sub main()
  v: Vec[Int] = Vec()
  !v.push(1)
  k = 0
  n = 0
  for _ in 0..2
    i = 0
    :a while mk(?v, i) as h and i >= 0: k += h.s[0]
      i += 1
    else
      n += 1
      continue :a
    k += 100
  print("end", k, n)

# error: `continue :a` names no enclosing loop or block
