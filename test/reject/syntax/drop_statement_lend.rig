# A statement `<?a` or `<!a` moves a view nowhere. A view owns nothing,
# so the statement does nothing, and is rejected; `<a` drops `a`.

struct F
  n: Int

  drop(!self)
    print("drop", self.n)

sub main()
  a = F(n: 1)
  <?a
  <!a
  print("end")

# errors: 2
# error: 12:3: this expression does nothing as a statement: `<?a` moves a view nowhere, and a view owns nothing to drop
# error: 13:3: this expression does nothing as a statement: `<!a` moves a view nowhere, and a view owns nothing to drop
