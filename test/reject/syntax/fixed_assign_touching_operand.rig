# `x =!y` could be a fixed binding of `y` or a write borrow `x = !y`;
# `=!` is one token, so the source does not say which, and it is
# rejected.

sub main()
  y = 1
  x =!y
  print(x)

# error: 7:5: `=!` touches the operand after it: write `x =! y` for a fixed binding, or `x = !y` for a write borrow
