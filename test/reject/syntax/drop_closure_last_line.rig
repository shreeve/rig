# A closure's last line is its value, and so is the last line of a
# branch that ends it, so `<x` there moves `x` out as the closure's
# result rather than dropping it. A closure that gives no value drops
# there with `_ = <x`, or drops before it.

struct F
  n: Int

  drop(!self)
    print("drop", self.n)

sub each(f: ?sub(Int))
  f(1)

sub main()
  each(|i|
    q = F(n: i)
    print(q.n)
    <q
  )
  each(|i|
    q = F(n: i)
    <q
    print(i)
  )
  each(|i|
    q = F(n: i)
    print(q.n)
    _ = <q
  )
  each(|i|
    q = F(n: i)
    if i > 0
      print(q.n)
      <q
    else
      print(0)
  )

# errors: 2
# error: 19:5: a closure's last line is its value, and so is the last line of a branch that ends it, so `<q` here is no drop, and this closure gives no value; to drop `q` here, write `_ = <q`
# error: 35:7: so `<q` here is no drop
