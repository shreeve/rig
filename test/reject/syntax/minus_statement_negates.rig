# A statement `-e` negates a value and throws it away, in every place a
# statement stands; a drop is written `<x`.

fun f() -> Int
  3

struct P
  n: Int

  fun get(?self) -> Int
    self.n

sub tail()
  -f()

sub main()
  a = 1
  b = 2
  c = a > 0
  p = P(n: 1)
  -f()
  -(a + b)
  -p.get()
  (-f())
  -f() if c
  defer -f()
  match a
    1 => -f()
    _ => pass
  if c
    -f()
  tail()
  print(a, b, p.n)

