# `-x` on the last line of a `fun` is its value, so it negates; a
# value that is not a number there is reported as such, with the way to
# drop it.

fun total(v: Vec[Int]) -> Int
  print(v.len)
  -v

fun pick(c: Bool, v: Vec[Int]) -> Int
  x = if c
    1
  else
    -v
  x

sub main()
  print(total(Vec()), pick(true, Vec()))

# error: 7:3: `-v` here is the function's value, and negation needs a number; to drop `v`, drop it before the last line
# error: 13:5: `-v` here is the value of its block, and negation needs a number
