# `-x` always negates: on the last line of a `fun` or of a block whose
# value is used, a value that is not a number is reported as such.

fun total(v: Vec[Int]) -> Int
  print(v.len)
  -v

fun pick(c: Bool, v: Vec[Int]) -> Int
  x = if c
    1
  else
    -v
  x

sub main()
  print(total(Vec()), pick(true, Vec()))

# error: 6:4: operator `-` requires a numeric operand; got `Vec[Int]`
# error: 12:6: operator `-` requires a numeric operand; got `Vec[Int]`
