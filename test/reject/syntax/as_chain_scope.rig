# A binding of a joined condition is visible to the parts after it and
# to the body, not to the parts before it or to `else`; a loop step
# cannot use one that owns a resource, which the body drops first.

struct Res
  id: Int

  drop(!self)
    print(self.id)

fun get(k: Int) -> Int?
  k if k > 0 else none

fun make(k: Int) -> Res?
  Res(id: k) if k > 0 else none

sub main
  if y > 0 and get(1) as y
    print(y)
  if get(1) as x and get(2) as y
    print(x, y)
  else
    print(x)
  i = 0
  while make(i) as r and r.id < 3: print(r.id)
    i += 1

# error: 18:6: use of unbound name `y`
# error: 23:11: use of unbound name `x`
# error: 25:42: the loop step cannot use `r`
