# A closure body laid out below its bar list ends with the bracket around
# it on a line of its own, at the indentation of the line that opened the
# bracket. The bracket may not end the body's last line, nor may that
# line start with anything else, nor stand at another indentation.

sub each_n(n: Int, f: ?sub(Int))
  i = 0
  while i < n : i += 1
    f(i)

fun run(f: ?fun(Int) -> Int, x: Int) -> Int
  f(x)

sub main()
  each_n(2, |i|
    print("hanging", i))
  n = (|k: Int|
    m = k * 2
    m + 1)(3)
  t = run(|x: Int|
    x + 1
  , 3)
  each_n(1, |i|
    print("deep", i)
    )
  each_n(1,
    |i|
      print("shallow", i)
 )
  print(n, t)

# errors: 5
