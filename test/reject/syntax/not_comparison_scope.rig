# `not` applies to the whole comparison after it, which reads as
# `(not a) > b` too: a comparison directly under `not` is written in
# parentheses, or flipped where the flip means the same (integers,
# text, and any `==`), wherever `not` stands.

struct Item
  qty: Int
  price: Float
  name: String

sub ordered(it: ?Item)
  print(not it.qty > 3)
  print(not it.qty <= 3)

sub equality(a: Int, b: Float)
  print(not a == 2)
  print(not b != 1.5)

sub floats(it: ?Item)
  print(not it.price < 2.5)

sub text(it: ?Item)
  print(not it.name >= "m")

sub joined(a: Int, b: Bool)
  if not a > 1 and b
    print(1)
  while b or not a < 0
    break
  print(1) if b and not (a) > (2)

sub nested(a: Int)
  print(not not a == 1)

sub main()
  it = Item(qty: 4, price: 1.0, name: "x")
  ordered(?it)
  equality(1, 2.0)
  floats(?it)
  text(?it)
  joined(1, true)
  nested(1)

