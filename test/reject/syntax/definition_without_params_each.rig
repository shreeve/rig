# Every definition that leaves out its parameter list is reported, each
# with its own header to write, so one run shows them all.

fun answer -> Int
  42

struct Box
  n: Int

  fun get -> Int
    1

sub main
  print(answer())

# error: 4:5: write `fun answer() -> Int`: a function's parameter list is always written, even when empty
