# Rig has no `<-` operator (a move-assignment is `a = <b`): whitespace
# means nothing inside an expression, so `a <- b` is `a < -b`, which
# compares, negating an array.

sub main()
  a = [1]
  b = [2]
  a <- b
  print(a)

# error: 8:8: operator `-` requires a numeric operand; got `[1]Int`
# error: 8:3: this expression does nothing as a statement
