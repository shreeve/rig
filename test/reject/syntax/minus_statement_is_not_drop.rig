# `-x` only negates. As a statement it does nothing, so it is rejected
# with a pointer to the early drop, `drop x`.

sub main
  v: Vec[Int] = Vec()
  n = 3
  -v
  -n
  defer -v
  match n
    3 => -v
    _ => print(n)
  -n if n > 2

# error: 7:3: `-v` negates `v`, which does nothing as a statement; write `drop v` to drop it early
# error: 8:3: `-n` negates `n`, which does nothing as a statement; write `drop n` to drop it early
# error: 9:9: write `drop v` to drop it early
# error: 11:10: write `drop v` to drop it early
# error: 13:3: write `drop n` to drop it early
