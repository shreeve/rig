# The value-yielding `try` block (with an indented `catch |e|` block) is
# reserved and does not parse; use `expr!` to propagate or
# `expr catch |e| handler` inline.

fun may_fail() -> Int!
  return 42

sub main()
  r = try
    may_fail()!
  catch |e|
    0
  print(r)

# error: unexpected keyword `try`
# error: `try` blocks are reserved
