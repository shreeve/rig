{
  "name": "vscode-rig",
  "displayName": "Rig Language",
  "description": "Syntax highlighting and the language server for Rig (.rig) files.",
  "version": "0.2.0",
  "publisher": "rig-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreeve/rig.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "rig",
    "ownership",
    "systems",
    "zig"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:rig"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "rig",
        "extensions": [
          ".rig"
        ],
        "aliases": [
          "Rig",
          "rig"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rig",
        "scopeName": "source.rig",
        "path": "./syntaxes/rig.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Rig",
      "properties": {
        "rig.lsp.path": {
          "type": "string",
          "default": "rig",
          "markdownDescription": "The `rig` executable whose `rig lsp` serves .rig files: a path, or a name on `PATH`."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "invalid",
        "description": "A token the Rig lexer rejects."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "control",
        "description": "A keyword of control flow."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "rig",
        "scopes": {
          "keyword": [
            "keyword.other.rig"
          ],
          "keyword.control": [
            "keyword.control.rig"
          ],
          "operator": [
            "keyword.operator.rig"
          ],
          "string": [
            "string.quoted.rig"
          ],
          "number": [
            "constant.numeric.rig"
          ],
          "comment": [
            "comment.rig"
          ],
          "type": [
            "entity.name.type.rig"
          ],
          "struct": [
            "entity.name.type.rig"
          ],
          "enum": [
            "entity.name.type.rig"
          ],
          "function": [
            "entity.name.function.rig"
          ],
          "method": [
            "entity.name.function.rig"
          ],
          "function.defaultLibrary": [
            "support.function.rig"
          ],
          "parameter": [
            "variable.parameter.rig"
          ],
          "label": [
            "entity.name.label.rig"
          ],
          "modifier": [
            "storage.modifier.rig"
          ],
          "invalid": [
            "invalid.illegal.rig"
          ]
        }
      }
    ]
  }
}
