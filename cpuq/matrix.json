{
  "label": "rig:matrix",
  "setup": "zig build -j\"$CPUQ_CORES\"",
  "run": "python3 test/matrix.py -j \"$CPUQ_CORES\" --delta \"$@\"",
  "cores": "8-32",
  "on": ["burst"],
  "time": "150m",
  "mem": "96G",
  "packs": { "zig": "0.17.0", "nexus": "latest" },
  "exclude": [".git", ".zig-cache", "zig-out", "bin", "src/parser.zig", "bench/json/rust-bench/target-native", ".claude", ".rip", ".DS_Store"],
  "caches": { "RIG_RESULTS_CACHE": "rig-results", "RIG_BUILD_STORE": "rig-build-store" }
}
