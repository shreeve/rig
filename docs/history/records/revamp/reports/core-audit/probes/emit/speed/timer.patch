diff --git c/src/timing.zig i/src/timing.zig
new file mode 100644
index 0000000..0e2868b
--- /dev/null
+++ i/src/timing.zig
@@ -0,0 +1,72 @@
+//! Crude phase timers (scratch instrumentation): RIG_TIME=1 prints them.
+const std = @import("std");
+
+pub var enabled = false;
+
+pub const Phase = enum {
+    parse_tree,
+    rewrite,
+    register_builtins,
+    resolve_symbols,
+    resolve_declarations,
+    compute_contents,
+    check_infinite_types,
+    check_type_sizes,
+    check_declarations,
+    typecheck_module,
+    check_frames,
+    check_unread_locals,
+    expand_instantiations,
+    check_generic_instantiations,
+    ownership,
+    diagnostics,
+    emit,
+    write_files,
+    zig,
+};
+
+var totals = [_]u64{0} ** @typeInfo(Phase).@"enum".fields.len;
+var cpu_totals = [_]u64{0} ** @typeInfo(Phase).@"enum".fields.len;
+var counts = [_]u32{0} ** @typeInfo(Phase).@"enum".fields.len;
+
+const TS = std.Io.Clock.Timestamp;
+pub const T = struct { wall: TS, cpu: TS };
+
+fn io() std.Io {
+    return std.Io.Threaded.global_single_threaded.io();
+}
+
+pub fn start() T {
+    return .{ .wall = TS.now(io(), .awake), .cpu = TS.now(io(), .cpu_thread) };
+}
+
+fn ns(a: TS, b: TS) u64 {
+    return @intCast(a.durationTo(b).raw.toNanoseconds());
+}
+
+pub fn stop(phase: Phase, t0: T) void {
+    const now = start();
+    totals[@intFromEnum(phase)] += ns(t0.wall, now.wall);
+    cpu_totals[@intFromEnum(phase)] += ns(t0.cpu, now.cpu);
+    counts[@intFromEnum(phase)] += 1;
+}
+
+pub fn report(total0: T) void {
+    if (!enabled) return;
+    const now = start();
+    var sum: u64 = 0;
+    var csum: u64 = 0;
+    std.debug.print("RIG_TIME {s:<30} {s:>10}    {s:>10}\n", .{ "phase", "wall_ms", "cpu_ms" });
+    for (totals, cpu_totals, 0..) |w, c, i| {
+        if (counts[i] == 0) continue;
+        sum += w;
+        csum += c;
+        std.debug.print("RIG_TIME {s:<30} {d:>10.3}    {d:>10.3}  (x{d})\n", .{ @tagName(@as(Phase, @enumFromInt(i))), ms(w), ms(c), counts[i] });
+    }
+    std.debug.print("RIG_TIME {s:<30} {d:>10.3}    {d:>10.3}\n", .{ "sum_of_phases", ms(sum), ms(csum) });
+    std.debug.print("RIG_TIME {s:<30} {d:>10.3}    {d:>10.3}\n", .{ "total_in_main", ms(ns(total0.wall, now.wall)), ms(ns(total0.cpu, now.cpu)) });
+}
+
+fn ms(x: u64) f64 {
+    return @as(f64, @floatFromInt(x)) / 1e6;
+}
