diff --git a/test/behavior/ownership/break_moves_loop_local.rig b/test/behavior/ownership/break_moves_loop_local.rig
new file mode 100644
index 00000000..71b9d466
--- /dev/null
+++ b/test/behavior/ownership/break_moves_loop_local.rig
@@ -0,0 +1,37 @@
+# `break x` of a name declared in the loop moves it out of the loop, as
+# `return x` moves a local out of its function.
+
+struct R
+  n: Int
+
+  drop(!self)
+    print("drop", self.n)
+
+sub main
+  i = 0
+  x = while i < 3
+    r = R(n: i)
+    i += 1
+    if i == 2
+      s = R(n: 7)
+      break r
+  else
+    R(n: 99)
+  print(x.n)
+  v: Vec[R] = Vec()
+  !v.push(R(n: 10))
+  !v.push(R(n: 11))
+  y = for e in <v
+    break e if e.n == 10
+  else
+    R(n: 0)
+  print(y.n)
+
+# expect:
+# drop 0
+# drop 7
+# 1
+# drop 11
+# 10
+# drop 10
+# drop 1
diff --git a/test/reject/ownership/break_outer_name.rig b/test/reject/ownership/break_outer_name.rig
new file mode 100644
index 00000000..d04c60fe
--- /dev/null
+++ b/test/reject/ownership/break_outer_name.rig
@@ -0,0 +1,32 @@
+# A bare `break x` moves only a name declared in the loop it leaves; a
+# name from outside it, or from an outer loop, is moved with `<x`, and a
+# `defer` that reads the name runs after it moved.
+
+struct R
+  n: Int
+
+  drop(!self)
+    print("drop", self.n)
+
+sub main
+  x = for _ in 0..2
+    r = R(n: 10)
+    y = for _ in 0..2
+      break r
+    else
+      R(n: 0)
+    break y
+  else
+    R(n: 1)
+  i = 0
+  z = while i < 3
+    q = R(n: i)
+    defer print("defer", q.n)
+    i += 1
+    break q if i == 2
+  else
+    R(n: 99)
+  print(x.n, z.n)
+
+# error: 15:13: bare use of `R` value `r` in `break` value would alias an owning value
+# error: 24:26: use of `q` after move
