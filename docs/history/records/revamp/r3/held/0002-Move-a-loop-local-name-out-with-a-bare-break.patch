+    /// Whether `break value` moves the bare name `value` out of its
+    /// binding: one that owns, declared since the loop's entry
+    /// (`vars`), so its scope ends at this `break`.
+    fn breakMovesName(self: *Checker, value: Sexp, vars: u32) Error!bool {
+        if (value != .src) return false;
+        const id = self.boundVar(value) orelse return false;
+        if (id < vars) return false;
+        const v = self.vars.items[id];
+        if (v.closure or v.loop_borrow or v.capture_resource or v.alias_of != null or self.owningKind(v.ty) == null) return false;
+        try self.checkNoImplicitCopy(value, .brk, true);
+        return true;
+    }
