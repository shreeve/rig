diff --git a/src/study.zig b/src/study.zig
new file mode 100644
index 00000000..09935df1
--- /dev/null
+++ b/src/study.zig
@@ -0,0 +1,498 @@
+//! STUDY ONLY (never merged): measures four candidate rules on write views
+//! and Cells, and counts which compiler sites a program reaches.
+//!
+//! RIG_STUDY=report        report every rule hit on stderr, change nothing
+//! RIG_STUDY=enforce:1234  reject the listed rules as errors
+//! With RIG_STUDY set, `hit` prints each probe site once per process.
+//!
+//! Rule 1: a write view is never data (no strict closure rule).
+//! Rule 2: a Cell lives only behind `*`.
+//! Rule 3: a branch over write views is never a place.
+//! Rule 4: `(!T)?` and `(!T)!` only as parameter or result types.
+
+const std = @import("std");
+const parser = @import("parser.zig");
+const sema = @import("sema.zig");
+
+const Sexp = parser.Sexp;
+const ir = parser.ir;
+const SemContext = sema.SemContext;
+const TypeId = sema.TypeId;
+
+pub const Mode = enum { off, report, enforce };
+pub var mode: Mode = .off;
+pub var enforced: [5]bool = .{ false, false, false, false, false };
+
+pub fn configure(value: ?[]const u8) void {
+    const v = value orelse return;
+    if (std.mem.eql(u8, v, "report")) {
+        mode = .report;
+    } else if (std.mem.startsWith(u8, v, "enforce:")) {
+        mode = .enforce;
+        for (v["enforce:".len..]) |ch| if (ch >= '1' and ch <= '4') {
+            enforced[ch - '0'] = true;
+        };
+    }
+}
+
+/// Print probe `name` once per process.
+pub fn hit(comptime name: []const u8) void {
+    const S = struct {
+        const id = name;
+        var seen: bool = false;
+    };
+    if (mode == .off or S.seen) return;
+    S.seen = true;
+    std.debug.print("STUDYPROBE {s}\n", .{name});
+}
+
+/// `hit` when `cond`; returns `cond`.
+pub fn hitIf(comptime name: []const u8, cond: bool) bool {
+    if (cond) hit(name);
+    return cond;
+}
+
+const Checker = struct {
+    ctx: *SemContext,
+    a: std.mem.Allocator,
+    covered: std.AutoHashMapUnmanaged(usize, void) = .empty,
+    seen: std.AutoHashMapUnmanaged(u64, void) = .empty,
+
+    fn report(c: *Checker, rule: u8, comptime kind: []const u8, pos: u32, comptime fmt: []const u8, args: anytype) !void {
+        const k = (@as(u64, rule) << 40) | pos;
+        if (c.seen.contains(k)) return;
+        try c.seen.put(c.a, k, {});
+        const lc = @import("diag.zig").lineCol(c.ctx.source, pos);
+        const detail = try std.fmt.allocPrint(c.a, fmt, args);
+        if (mode == .report) {
+            std.debug.print("STUDY r{d} {s} {s}{s}:{d}:{d} {s}\n", .{ rule, kind, if (c.ctx.is_std) "std:" else "", c.ctx.name, lc.line, lc.col, detail });
+        } else if (mode == .enforce and enforced[rule]) {
+            try c.ctx.err(pos, "study rule {d} ({s}): {s}", .{ rule, kind, detail });
+        }
+    }
+
+    fn info(c: *Checker, ty: TypeId) sema.TypeInfo {
+        return c.ctx.typeInfo(ty);
+    }
+
+    fn tyName(c: *Checker, ty: TypeId) ![]const u8 {
+        return sema.formatTypeIn(c.ctx, c.a, ty);
+    }
+
+    fn poison(c: *Checker, ty: TypeId) bool {
+        return c.info(ty).poison or ty == c.ctx.types.invalid_id or ty == c.ctx.types.unknown_id;
+    }
+
+    // ---- Rule 1 ----------------------------------------------------------
+
+    /// A type a binding, parameter, result, or expression may have: one
+    /// that holds no write view, `!U`, `(!U)?`, or `(!U)!`, where `U` holds
+    /// none.
+    fn rule1Ok(c: *Checker, ty: TypeId) bool {
+        if (!c.nestsWrite(ty, 0)) return true;
+        switch (c.ctx.types.get(ty)) {
+            .write_view => |u| return !c.nestsWrite(u, 0),
+            .optional, .fallible => |x| switch (c.ctx.types.get(x)) {
+                .write_view => |u| return !c.nestsWrite(u, 0),
+                else => return false,
+            },
+            .function, .callable => return true,
+            else => return false,
+        }
+    }
+
+    /// Whether `ty` is or holds a write view anywhere, through views and
+    /// handles too.
+    fn nestsWrite(c: *Checker, ty: TypeId, depth: u8) bool {
+        if (depth > 24) return false;
+        if (c.info(ty).views.write) return true;
+        return switch (c.ctx.types.get(ty)) {
+            .write_view => true,
+            .read_view, .shared, .weak, .optional, .fallible => |x| c.nestsWrite(x, depth + 1),
+            .array => |arr| c.nestsWrite(arr.elem, depth + 1),
+            .slice => |sl| c.nestsWrite(sl.elem, depth + 1),
+            .parameterized_nominal => |pn| for (pn.args) |arg| {
+                if (c.nestsWrite(arg, depth + 1)) break true;
+            } else false,
+            else => false,
+        };
+    }
+
+    /// A lend's type: `!S` or `?S` of a type a binding may have.
+    fn lendOfOk(c: *Checker, ty: TypeId) bool {
+        return switch (c.ctx.types.get(ty)) {
+            .read_view, .write_view => |s| c.rule1Ok(s),
+            else => false,
+        };
+    }
+
+    // ---- Rule 2 ----------------------------------------------------------
+
+    /// A Cell held by value somewhere inside `ty` where rule 2 forbids it,
+    /// below its top.
+    fn rule2Nested(c: *Checker, ty: TypeId, depth: u8) bool {
+        if (depth > 24) return false;
+        switch (c.ctx.types.get(ty)) {
+            .shared, .weak, .read_view, .write_view, .callable => |x| return c.rule2Nested(x, depth + 1),
+            .optional, .fallible => |x| return c.info(x).cell or c.rule2Nested(x, depth + 1),
+            .array => |arr| return c.info(arr.elem).cell or c.rule2Nested(arr.elem, depth + 1),
+            .slice => |s| return c.info(s.elem).cell or c.rule2Nested(s.elem, depth + 1),
+            .parameterized_nominal => |pn| {
+                for (pn.args) |arg| if (c.info(arg).cell or c.rule2Nested(arg, depth + 1)) return true;
+                return false;
+            },
+            else => return false,
+        }
+    }
+
+    /// A type a binding, parameter, result, or value may have.
+    fn rule2Ok(c: *Checker, ty: TypeId) bool {
+        if (c.info(ty).cell) return false;
+        return !c.rule2Nested(ty, 0);
+    }
+
+    fn isCellType(c: *Checker, ty: TypeId) bool {
+        return switch (c.ctx.types.get(ty)) {
+            .parameterized_nominal => |pn| pn.sym == c.ctx.cell_sym_id,
+            else => false,
+        };
+    }
+
+    // ---- Declarations and bindings ---------------------------------------
+
+    fn checkDecls(c: *Checker) !void {
+        for (c.ctx.symbols.items) |sym| {
+            if (sema.isProxy(sym) or sym.decl_pos == sema.builtin_decl_pos) continue;
+            switch (sym.kind) {
+                .nominal_type, .generic_type => {
+                    const fields = sym.fields orelse continue;
+                    for (fields) |f| {
+                        if (f.is_method) {
+                            try c.checkSignature(f.ty, f.decl_pos);
+                            continue;
+                        }
+                        if (f.is_variant) {
+                            for (f.payload orelse &.{}) |pf| try c.checkField(pf.ty, pf.decl_pos, false);
+                            continue;
+                        }
+                        try c.checkField(f.ty, f.decl_pos, true);
+                    }
+                },
+                .function, .@"extern" => try c.checkSignature(sym.ty, sym.decl_pos),
+                .param, .local, .capture => try c.checkBinding(sym),
+                else => {},
+            }
+        }
+    }
+
+    fn checkField(c: *Checker, ty: TypeId, pos: u32, in_struct: bool) !void {
+        if (c.poison(ty)) return;
+        if (c.nestsWrite(ty, 0)) try c.report(1, "field", pos, "a field or payload holds a write view: `{s}`", .{try c.tyName(ty)});
+        const bad2 = if (in_struct and c.isCellType(ty)) c.rule2Nested(ty, 0) else !c.rule2Ok(ty);
+        if (bad2) try c.report(2, "field", pos, "a field or payload holds a Cell by value: `{s}`", .{try c.tyName(ty)});
+    }
+
+    fn checkSignature(c: *Checker, ty: TypeId, pos: u32) !void {
+        const f = switch (c.ctx.types.get(ty)) {
+            .function => |f| f,
+            else => return,
+        };
+        for (f.params) |p| {
+            if (c.poison(p)) continue;
+            if (!c.rule1Ok(p)) try c.report(1, "param", pos, "a parameter nests a write view: `{s}`", .{try c.tyName(p)});
+            if (!c.rule2Ok(p)) try c.report(2, "param", pos, "a parameter holds a Cell by value: `{s}`", .{try c.tyName(p)});
+        }
+        if (!c.poison(f.returns)) {
+            if (!c.rule1Ok(f.returns)) try c.report(1, "result", pos, "a result nests a write view: `{s}`", .{try c.tyName(f.returns)});
+            if (!c.rule2Ok(f.returns)) try c.report(2, "result", pos, "a result holds a Cell by value: `{s}`", .{try c.tyName(f.returns)});
+        }
+    }
+
+    fn checkBinding(c: *Checker, sym: sema.Symbol) !void {
+        const ty = sym.ty;
+        if (c.poison(ty)) return;
+        if (std.mem.eql(u8, sym.name, "_")) return;
+        if (!c.rule1Ok(ty)) try c.report(1, "binding", sym.decl_pos, "`{s}` nests a write view: `{s}`", .{ sym.name, try c.tyName(ty) });
+        if (sym.kind != .param and !c.rule2Ok(ty)) try c.report(2, "binding", sym.decl_pos, "`{s}` holds a Cell by value: `{s}`", .{ sym.name, try c.tyName(ty) });
+        if (sym.kind != .param) switch (c.ctx.types.get(ty)) {
+            .optional, .fallible => |x| if (c.ctx.types.get(x) == .write_view) {
+                const what: []const u8 = if (sym.kind == .capture) "capture" else if (sym.flags.as_bound) "as" else if (sym.flags.pattern_bound) "pattern" else "local";
+                try c.report(4, "binding", sym.decl_pos, "{s} `{s}` has type `{s}`", .{ what, sym.name, try c.tyName(ty) });
+            },
+            else => {},
+        };
+    }
+
+    fn checkInstances(c: *Checker) !void {
+        for (c.ctx.fn_instances.items) |f| {
+            for (f.inst.ownArgs()) |arg| {
+                if (c.poison(arg)) continue;
+                if (c.nestsWrite(arg, 0)) try c.report(1, "typearg", f.site, "a function's type argument holds a write view: `{s}`", .{try c.tyName(arg)});
+                if (c.info(arg).cell or c.rule2Nested(arg, 0)) try c.report(2, "typearg", f.site, "a function's type argument holds a Cell by value: `{s}`", .{try c.tyName(arg)});
+            }
+        }
+    }
+
+    // ---- Expressions -------------------------------------------------------
+
+    fn key(n: Sexp) usize {
+        return switch (n) {
+            .list => |l| @intFromPtr(l.ptr),
+            .src => |s| (@as(usize, s.pos) << 1) | 1,
+            else => 0,
+        };
+    }
+
+    fn cover(c: *Checker, n: Sexp) !void {
+        if (n == .nil) return;
+        try c.covered.put(c.a, key(n), {});
+        try c.coverParts(n);
+    }
+
+    /// Mark every node whose value `n`'s value is.
+    fn coverParts(c: *Checker, n: Sexp) std.mem.Allocator.Error!void {
+        switch (n.kind() orelse return) {
+            .@"if" => {
+                try c.cover(ir.If.then(n));
+                try c.cover(ir.If.@"else"(n));
+            },
+            .match => for (ir.Match.arms(n)) |arm| try c.cover(ir.Arm.body(arm)),
+            .block => {
+                const stmts = ir.Block.stmts(n);
+                if (stmts.len > 0) try c.cover(stmts[stmts.len - 1]);
+            },
+            .raw_block => try c.cover(ir.get(n, .body)),
+            .@"??" => {
+                try c.cover(ir.@"??".left(n));
+                try c.cover(ir.@"??".right(n));
+            },
+            .@"catch" => {
+                try c.cover(ir.Catch.value(n));
+                try c.cover(ir.Catch.handler(n));
+            },
+            .propagate => try c.cover(ir.Propagate.value(n)),
+            .propagate_none => try c.cover(ir.PropagateNone.value(n)),
+            .labeled, .@"while", .@"for" => {
+                var vals: std.ArrayList(Sexp) = .empty;
+                try sema.loopValues(c.a, c.ctx.source, n, &vals);
+                for (vals.items) |v| try c.cover(v);
+                if (n.isKind(.labeled)) try c.covered.put(c.a, key(ir.Labeled.stmt(n)), {});
+            },
+            else => {},
+        }
+    }
+
+    const Leaves = struct { place: bool = false, lend: bool = false, call: bool = false, move: bool = false, other: bool = false };
+
+    fn leaves(c: *Checker, n: Sexp, out: *Leaves, depth: u8) std.mem.Allocator.Error!void {
+        if (n == .nil or depth > 40) return;
+        const k = n.kind();
+        if (k) |tag| switch (tag) {
+            .@"if" => {
+                try c.leaves(sema.tailOf(ir.If.then(n)), out, depth + 1);
+                try c.leaves(sema.tailOf(ir.If.@"else"(n)), out, depth + 1);
+                return;
+            },
+            .match => {
+                for (ir.Match.arms(n)) |arm| try c.leaves(sema.tailOf(ir.Arm.body(arm)), out, depth + 1);
+                return;
+            },
+            .block, .raw_block => return c.leaves(sema.tailOf(n), out, depth + 1),
+            .@"??" => {
+                try c.leaves(ir.@"??".left(n), out, depth + 1);
+                try c.leaves(ir.@"??".right(n), out, depth + 1);
+                return;
+            },
+            .@"catch" => {
+                try c.leaves(ir.Catch.value(n), out, depth + 1);
+                try c.leaves(sema.tailOf(ir.Catch.handler(n)), out, depth + 1);
+                return;
+            },
+            .propagate => return c.leaves(ir.Propagate.value(n), out, depth + 1),
+            .propagate_none => return c.leaves(ir.PropagateNone.value(n), out, depth + 1),
+            .labeled, .@"while", .@"for" => {
+                var vals: std.ArrayList(Sexp) = .empty;
+                try sema.loopValues(c.a, c.ctx.source, n, &vals);
+                for (vals.items) |v| try c.leaves(v, out, depth + 1);
+                return;
+            },
+            .@"return", .@"break", .@"continue" => return,
+            .write => {
+                out.lend = true;
+                return;
+            },
+            .call, .builtin, .inst => {
+                out.call = true;
+                return;
+            },
+            .move => {
+                out.move = true;
+                return;
+            },
+            else => {},
+        };
+        switch (sema.handsOver(c.ctx, n).kind) {
+            .place, .part_of_made => out.place = true,
+            .jump => {},
+            else => out.other = true,
+        }
+    }
+
+    fn walk(c: *Checker, n: Sexp, stack: *std.ArrayList(Sexp)) std.mem.Allocator.Error!void {
+        if (n != .list) {
+            if (n == .src) try c.checkExpr(n, stack.items);
+            return;
+        }
+        const tag = n.kind();
+        if (tag) |t| switch (t) {
+            .fun, .sub, .lambda, .@"test", .drop_decl => try c.cover(ir.get(n, .body)),
+            .@"return" => try c.cover(ir.Return.value(n)),
+            else => {},
+        };
+        if (tag != null) try c.checkExpr(n, stack.items);
+        // A branch's parts are its value, checked with it.
+        if (isBranchRoot(n)) try c.coverParts(n);
+        try stack.append(c.a, n);
+        defer _ = stack.pop();
+        for (n.items()) |child| try c.walk(child, stack);
+    }
+
+    fn parentTagged(stack: []const Sexp) struct { node: Sexp, idx: usize } {
+        var i = stack.len;
+        while (i > 0) {
+            i -= 1;
+            if (stack[i].kind() != null) return .{ .node = stack[i], .idx = i };
+        }
+        return .{ .node = .nil, .idx = 0 };
+    }
+
+    fn same(a: Sexp, b: Sexp) bool {
+        return key(a) == key(b) and key(a) != 0;
+    }
+
+    fn checkExpr(c: *Checker, n: Sexp, stack: []const Sexp) !void {
+        const ty = c.ctx.typeOf(n) orelse return;
+        if (c.poison(ty)) return;
+        // Rule 1: an expression's type may not nest a write view.
+        if (!c.rule1Ok(ty) and !c.lendOfOk(ty) and n != .src) {
+            const kind_ok = switch (c.ctx.types.get(ty)) {
+                .nominal, .imported_nominal => true, // reported at the declaration
+                else => false,
+            };
+            if (!kind_ok) try c.report(1, "expr", c.ctx.startOf(n), "a value nests a write view: `{s}`", .{try c.tyName(ty)});
+        }
+        // Rule 2: a value made holding a Cell by value, outside `*`.
+        if (n == .list) {
+            if (c.rule2Nested(ty, 0)) try c.report(2, "expr", c.ctx.startOf(n), "a value's type holds a Cell by value inside it: `{s}`", .{try c.tyName(ty)});
+            if (c.info(ty).cell and sema.handsOver(c.ctx, n).kind == .made) {
+                const p = parentTagged(stack).node;
+                const under_share = p.isKind(.share);
+                const field_arg = p.isKind(.kwarg) and c.isCellType(ty) and (n.isKind(.call) or n.isKind(.inst));
+                if (!under_share and !field_arg) try c.report(2, "made", c.ctx.startOf(n), "a value holding a Cell made outside `*`: `{s}`", .{try c.tyName(ty)});
+            }
+        }
+        // Rule 3.
+        if (n == .list) try c.checkBranch(n, ty, stack);
+    }
+
+    fn isBranchRoot(n: Sexp) bool {
+        return switch (n.kind() orelse return false) {
+            .@"if", .@"??", .@"catch", .propagate, .propagate_none, .match, .labeled, .@"while", .@"for" => sema.isBranchingForm(n) or n.isKind(.match) or n.isKind(.labeled) or n.isKind(.@"while") or n.isKind(.@"for"),
+            else => false,
+        };
+    }
+
+    fn checkBranch(c: *Checker, n: Sexp, ty: TypeId, stack: []const Sexp) !void {
+        if (!isBranchRoot(n)) return;
+        if (!c.info(ty).views.write) return;
+        if (c.covered.contains(key(n))) return;
+        // A statement `if`/`match`/loop gives no value.
+        const top = parentTagged(stack);
+        if (top.node.isKind(.block) or top.node.isKind(.module)) {
+            // A block's statement: only its tail is a value, and only when
+            // the block's own value is used (covered).
+            const items = top.node.items();
+            const is_tail = items.len > 1 and same(items[items.len - 1], n);
+            if (!is_tail or !c.covered.contains(key(top.node))) return;
+        }
+        if (top.node.isKind(.arm) and !c.covered.contains(key(ir.Arm.body(top.node)))) return;
+        var lv: Leaves = .{};
+        try c.leaves(n, &lv, 0);
+        if (!lv.place and !lv.lend and !lv.call and !lv.move and !lv.other) return;
+        const leafkind: []const u8 = if (lv.place) "placeleaf" else "madeleaf";
+        const form: []const u8 = @tagName(n.kind().?);
+        // The path this branch is the base of.
+        var p = n;
+        var i = stack.len;
+        var parent: Sexp = .nil;
+        while (i > 0) {
+            i -= 1;
+            const s = stack[i];
+            if (s.kind() == null) continue;
+            if ((s.isKind(.member) or s.isKind(.index)) and same(ir.get(s, .object), p)) {
+                // A method call's receiver stops the path.
+                if (s.isKind(.member) and i > 0) {
+                    const up = parentTagged(stack[0..i]).node;
+                    if (up.isKind(.call) and same(ir.Call.callee(up), s)) {
+                        parent = s;
+                        break;
+                    }
+                }
+                p = s;
+                continue;
+            }
+            parent = s;
+            break;
+        }
+        const use = c.useOf(p, parent);
+        if (!same(p, n)) {
+            // A part read out of the branch: allowed when it copies and the
+            // context only reads it.
+            const pty = c.ctx.typeOf(p) orelse return;
+            if (c.poison(pty)) return;
+            const writes = std.mem.eql(u8, use, "assign") or std.mem.eql(u8, use, "lend") or std.mem.eql(u8, use, "move") or std.mem.eql(u8, use, "receiver") or std.mem.eql(u8, use, "for");
+            if (!writes and sema.copies(c.ctx, pty) == .yes) return;
+            try c.report(3, "part", c.ctx.startOf(n), "{s} {s} form={s} of a part `{s}` of a branch over write views", .{ leafkind, use, form, try c.tyName(pty) });
+            return;
+        }
+        // The branch itself: allowed where its context reads the value it
+        // views as a copy.
+        if (c.ctx.studyReadTag(n)) |tag| if (tag == 0 or tag == 1) return;
+        try c.report(3, "whole", c.ctx.startOf(n), "{s} {s} form={s} of a branch over write views `{s}`", .{ leafkind, use, form, try c.tyName(ty) });
+    }
+
+    /// What context `parent` does with `p`, by a positive list.
+    fn useOf(c: *Checker, p: Sexp, parent: Sexp) []const u8 {
+        _ = c;
+        const k = parent.kind() orelse return "other";
+        return switch (k) {
+            .set => if (same(ir.get(parent, .target), p)) "assign" else "bind",
+            .read, .write => "lend",
+            .move => "move",
+            .member => "receiver",
+            .call => if (same(ir.Call.callee(parent), p)) "call" else "pass",
+            .kwarg => "pass",
+            .builtin => "read",
+            .match => if (same(ir.Match.subject(parent), p)) "match" else "other",
+            .as => "as",
+            .@"for" => if (ir.For.mode(parent).tag == .iter) "forin" else "for",
+            .array, .array_fill => "store",
+            .@"return" => "return",
+            .@"break" => "break",
+            .@"+", .@"-", .@"*", .@"/", .@"%", .@"+%", .@"-%", .@"*%", .@"==", .@"!=", .@"<", .@">", .@"<=", .@">=", .@"&", .@"|", .@"^", .@"<<", .@">>", .@"and", .@"or", .neg, .not, .@"if", .@"while", .index => "read",
+            else => "other",
+        };
+    }
+};
+
+/// Check module `tree` against the four rules (`mode`).
+pub fn check(ctx: *SemContext, tree: Sexp) std.mem.Allocator.Error!void {
+    if (mode == .off) return;
+    var arena: std.heap.ArenaAllocator = .init(ctx.allocator);
+    defer arena.deinit();
+    var c: Checker = .{ .ctx = ctx, .a = arena.allocator() };
+    try c.checkDecls();
+    try c.checkInstances();
+    var stack: std.ArrayList(Sexp) = .empty;
+    try c.walk(tree, &stack);
+}
