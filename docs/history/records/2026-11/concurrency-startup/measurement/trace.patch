+/// SCRATCH: map a fresh reservation of `chunk` stacks for `x`, as
+/// `takeStack` maps one, so its first tasks need no system call.
+fn xMapChunk(x: *Worker) void {
+    const guard = rt.task_guard;
+    const len = rt.task_stack_size;
+    const span = guard + len + std.heap.pageSize();
+    const got = std.posix.mmap(null, span * chunk, .{}, .{ .TYPE = .PRIVATE, .ANONYMOUS = true, .NORESERVE = true }, -1, 0) catch rt.oom();
+    const base = @intFromPtr(got.ptr);
+    rt.fast_alloc.keepSmall(base, span * chunk);
+    for (0..chunk) |i| {
+        const b = base + i * span;
+        if (std.posix.errno(std.posix.system.mprotect(@ptrFromInt(b + guard), len, .{ .READ = true, .WRITE = true })) != .SUCCESS) rt.oom();
+    }
+    x.stacks.fresh_next = base;
+    x.stacks.fresh_left = chunk;
+}
