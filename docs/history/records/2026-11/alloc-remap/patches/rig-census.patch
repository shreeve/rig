+/// Scratch: the census of `remap`, by path, written to stderr at exit
+/// (`report`) when `RIG_REMAP_CENSUS` is set.
+pub const census = struct {
+    pub const Path = enum(u8) { same, small_small, small_large, shrink_small, shrink_large, mapped_run, span_grow_warm, span_copy_warm, span_grow_fresh, span_copy_new, span_move_pages, map_copy_kept, map_move, map_small_null, fail };
+    pub const Src = enum(u8) { none, warm, kept, steal, cold, cold_kept, carve, map };
+    const np = @typeInfo(Path).@"enum".field_names.len;
+    const ns = @typeInfo(Src).@"enum".field_names.len;
+    const nb = 40;
+    pub threadlocal var src: Src = .none;
+    pub const Rec = struct {
+        ret: usize,
+        old: usize,
+        new: usize,
+        path: Path = .fail,
+        copied: usize = 0,
+        src: Src = .none,
+        // Of a span: the free units after it, warm or cold, and the
+        // units of its segment never carved when that free span (or
+        // the span itself) ends at `used`; the units it needs more.
+        after: usize = 0,
+        rest: usize = 0,
+        cold: bool = false,
+        extra: usize = 0,
+        page_off: usize = 0,
+        fn set(r: *Rec, p: Path, copied: usize) void {
+            r.path = p;
+            r.copied = copied;
+        }
+    };
+    const Pair = struct { n: u64 = 0, b: u64 = 0 };
+    const Caller = struct { ret: usize = 0, n: [np]u64 = @splat(0), b: [np]u64 = @splat(0) };
+    const ncallers = 8192;
+    var lock: SpinLock = .{};
+    var by_path: [np]Pair = @splat(.{});
+    var hist: [np][nb]Pair = @splat(@splat(.{}));
+    var by_src: [ns]Pair = @splat(.{});
+    // Copying span remaps (span_copy_warm, span_copy_new): could the
+    // span have grown where it lies into fresh pages? [0] warm copy,
+    // [1] new copy. follow: after+rest >= extra; cold_after: of those,
+    // a cold free span alone was enough; end: needs the segment's end.
+    var follow: [2]Pair = @splat(.{});
+    var follow_cold: [2]Pair = @splat(.{});
+    var follow_end: [2]Pair = @splat(.{});
+    // Copies (all copying paths of large blocks: span copies) of at
+    // least N system pages, N = 4, 16, 64; and also page-aligned.
+    const ns_pages = [_]usize{ 4, 16, 64 };
+    var ge: [2][3]Pair = @splat(@splat(.{}));
+    var ge_aligned: [2][3]Pair = @splat(@splat(.{}));
+    var ge_follow: [2][3]Pair = @splat(@splat(.{}));
+    var callers: [ncallers]Caller = @splat(.{});
+    var callers_full: u64 = 0;
+
+    fn peek(r: *Rec, p: usize, old_size: usize, new_size: usize) void {
+        const seg = spanSegmentOf(p);
+        const sp = &seg.heap.spans;
+        const s = spanIndex(seg, p);
+        const n = spanUnits(old_size);
+        r.extra = spanUnits(new_size) - n;
+        r.page_off = p % std.heap.pageSize();
+        const next = s + n;
+        sp.lock.lock();
+        defer sp.lock.unlock();
+        const tag = if (next < seg.used) seg.tags[next] else 0;
+        r.after = if (tag & tag_free != 0) tag & tag_len else 0;
+        r.rest = if (next + r.after == seg.used) span_units - seg.used else 0;
+        r.cold = tag & tag_cold != 0;
+    }
+
+    fn bucket(x: usize) usize {
+        if (x == 0) return 0;
+        return @min(nb - 1, std.math.log2_int(usize, x) + 1);
+    }
+
+    fn add(r: *const Rec) void {
+        const pi = @intFromEnum(r.path);
+        lock.lock();
+        defer lock.unlock();
+        by_path[pi].n += 1;
+        by_path[pi].b += r.copied;
+        hist[pi][bucket(r.copied)].n += 1;
+        hist[pi][bucket(r.copied)].b += r.copied;
+        if (r.path == .span_copy_new) {
+            by_src[@intFromEnum(r.src)].n += 1;
+            by_src[@intFromEnum(r.src)].b += r.copied;
+        }
+        if (r.path == .span_copy_warm or r.path == .span_copy_new) {
+            const k: usize = if (r.path == .span_copy_warm) 0 else 1;
+            const ok = r.after + r.rest >= r.extra;
+            if (ok) {
+                follow[k].n += 1;
+                follow[k].b += r.copied;
+                if (r.after >= r.extra) {
+                    follow_cold[k].n += 1;
+                    follow_cold[k].b += r.copied;
+                } else {
+                    follow_end[k].n += 1;
+                    follow_end[k].b += r.copied;
+                }
+            }
+            for (ns_pages, 0..) |np_, j| {
+                if (r.old < np_ * std.heap.pageSize()) continue;
+                ge[k][j].n += 1;
+                ge[k][j].b += r.copied;
+                if (r.page_off == 0) {
+                    ge_aligned[k][j].n += 1;
+                    ge_aligned[k][j].b += r.copied;
+                }
+                if (ok) {
+                    ge_follow[k][j].n += 1;
+                    ge_follow[k][j].b += r.copied;
+                }
+            }
+        }
+        if (r.path == .same) return;
+        var i = (r.ret *% 0x9E3779B97F4A7C15) >> 51;
+        var tries: usize = 0;
+        while (tries < ncallers) : (tries += 1) {
+            const e = &callers[i];
+            if (e.ret == 0) e.ret = r.ret;
+            if (e.ret == r.ret) {
+                e.n[pi] += 1;
+                e.b[pi] += r.copied;
+                return;
+            }
+            i = (i + 1) % ncallers;
+        }
+        callers_full += 1;
+    }
+
+    // Clones of Lists and Strings (`+v`), by caller: count, bytes held
+    // (capacity) and bytes live (length); and of those whose capacity is
+    // a span (past max_small): live bytes that are a span too (an in-place
+    // shrink keeps them where they lie, no copy) and the span units an
+    // in-place shrink would give back.
+    const Clone = struct { ret: usize = 0, n: u64 = 0, cap: u64 = 0, len: u64 = 0, span_n: u64 = 0, span_cap: u64 = 0, span_len: u64 = 0, span_keep_n: u64 = 0, span_keep_len: u64 = 0, span_free: u64 = 0, small_slack: u64 = 0 };
+    const nclones = 4096;
+    var clones: [nclones]Clone = @splat(.{});
+    pub fn cloned(ret: usize, cap: usize, len: usize) void {
+        if (len == 0) return;
+        lock.lock();
+        defer lock.unlock();
+        var i = (ret *% 0x9E3779B97F4A7C15) >> 52;
+        var tries: usize = 0;
+        while (tries < nclones) : (tries += 1) {
+            const e = &clones[i];
+            if (e.ret == 0) e.ret = ret;
+            if (e.ret == ret) {
+                e.n += 1;
+                e.cap += cap;
+                e.len += len;
+                if (cap > max_small) {
+                    e.span_n += 1;
+                    e.span_cap += cap;
+                    e.span_len += len;
+                    if (len > max_small) {
+                        e.span_keep_n += 1;
+                        e.span_keep_len += len;
+                        e.span_free += (spanUnits(largeSize(cap)) - spanUnits(largeSize(len))) * span_unit;
+                    } else e.span_free += spanUnits(largeSize(cap)) * span_unit;
+                } else e.small_slack += cap - len;
+                return;
+            }
+            i = (i + 1) % nclones;
+        }
+    }
+
+    fn print(comptime fmt: []const u8, args: anytype) void {
+        var buf: [1024]u8 = undefined;
+        const line = std.fmt.bufPrint(&buf, fmt, args) catch return;
+        _ = std.posix.system.write(2, line.ptr, line.len);
+    }
+
+    var reported: bool = false;
+
+    pub fn report() void {
+        if (reported) return;
+        reported = true;
+        lock.lock();
+        defer lock.unlock();
+        const slide: usize = if (builtin.os.tag == .macos) @bitCast(std.c._dyld_get_image_vmaddr_slide(0)) else 0;
+        print("remap-census: page={d} span_unit={d} span_max={d} max_small={d} slide=0x{x} remap_at=0x{x}\n", .{ std.heap.pageSize(), span_unit, span_max, max_small, slide, @intFromPtr(&remap) });
+        inline for (@typeInfo(Path).@"enum".field_names, 0..) |f, i| {
+            print("remap-census: path {s} n={d} copied={d}\n", .{ f, by_path[i].n, by_path[i].b });
+            for (hist[i], 0..) |h, b| if (h.n != 0) print("remap-census: hist {s} log2<{d} n={d} copied={d}\n", .{ f, b, h.n, h.b });
+        }
+        inline for (@typeInfo(Src).@"enum".field_names, 0..) |f, i| print("remap-census: src {s} n={d} copied={d}\n", .{ f, by_src[i].n, by_src[i].b });
+        const kinds = [_][]const u8{ "copy_warm", "copy_new" };
+        for (kinds, 0..) |kn, k| {
+            print("remap-census: follow {s} any n={d} copied={d}\n", .{ kn, follow[k].n, follow[k].b });
+            print("remap-census: follow {s} cold n={d} copied={d}\n", .{ kn, follow_cold[k].n, follow_cold[k].b });
+            print("remap-census: follow {s} end n={d} copied={d}\n", .{ kn, follow_end[k].n, follow_end[k].b });
+            for (ns_pages, 0..) |np_, j| {
+                print("remap-census: ge {s} pages>={d} n={d} copied={d} aligned_n={d} aligned_copied={d} follow_n={d} follow_copied={d}\n", .{ kn, np_, ge[k][j].n, ge[k][j].b, ge_aligned[k][j].n, ge_aligned[k][j].b, ge_follow[k][j].n, ge_follow[k][j].b });
+            }
+        }
+        for (clones) |e| if (e.ret != 0) print("remap-census: clone 0x{x} n={d} cap={d} len={d} span_n={d} span_cap={d} span_len={d} span_keep_n={d} span_keep_len={d} span_free={d} small_slack={d}\n", .{ e.ret, e.n, e.cap, e.len, e.span_n, e.span_cap, e.span_len, e.span_keep_n, e.span_keep_len, e.span_free, e.small_slack });
+        print("remap-census: callers_full={d}\n", .{callers_full});
+        for (callers) |e| {
+            if (e.ret == 0) continue;
+            var tn: u64 = 0;
+            var tb: u64 = 0;
+            for (e.n, e.b) |n, b| {
+                tn += n;
+                tb += b;
+            }
+            if (tb == 0) continue;
+            var buf: [1024]u8 = undefined;
+            var w: usize = 0;
+            inline for (@typeInfo(Path).@"enum".field_names, 0..) |f, i| {
+                if (e.b[i] != 0) {
+                    const t = std.fmt.bufPrint(buf[w..], " {s}={d}/{d}", .{ f, e.n[i], e.b[i] }) catch break;
+                    w += t.len;
+                }
+            }
+            print("remap-census: caller 0x{x} n={d} copied={d}{s}\n", .{ e.ret, tn, tb, buf[0..w] });
+        }
+    }
+};
