+/// Scratch (arm c): the span of `old_size` bytes at `p` cut to
+/// `new_size` where it lies: its tail is handed out on its own, then
+/// freed as any span is (`freeSpan`), so it joins the free spans beside
+/// it, warm or cold.
+fn shrinkSpan(h: *Heap, p: usize, old_size: usize, new_size: usize) void {
+    const seg = spanSegmentOf(p);
+    const sp = &seg.heap.spans;
+    const s = spanIndex(seg, p);
+    const n = spanUnits(old_size);
+    const m = spanUnits(new_size);
+    if (m >= n) return;
+    sp.lock.lock();
+    handOutSpan(seg, s, m);
+    handOutSpan(seg, s + m, n - m);
+    sp.lock.unlock();
+    freeSpan(h, spanAt(seg, s + m), (n - m) * span_unit);
+}
