+/// Scratch (remap ceiling, arm b): a span of at least this many bytes
+/// that cannot grow where it lies moves its pages into a new span
+/// (`moveSpan`) rather than being copied.
+const move_span: usize = @as(usize, move_span_pages) * 4096;
+const move_span_pages = 16;
+
+/// Linux: the span of `old_size` bytes at `at` moved, its pages and not
+/// its bytes, into a span of `new_size` bytes whose pages are not
+/// resident (cold, or never carved; a warm one last), by
+/// `mremap(MREMAP_MAYMOVE | MREMAP_FIXED | MREMAP_DONTUNMAP)`, which
+/// leaves the old range mapped and reading zero, as a span segment's
+/// units must stay mapped. Null, with nothing moved, when no span is
+/// free or the system refuses.
+fn moveSpan(h: *Heap, at: usize, old_size: usize, new_size: usize) ?[*]u8 {
+    const n = spanUnits(new_size);
+    const cold = takeSpan(h, true, n);
+    var carved = false;
+    const q = cold orelse if (carveSpan(h, n)) |c| blk: {
+        carved = true;
+        break :blk c;
+    } else takeSpan(h, false, n) orelse return null;
+    if (carved) {
+        h.took(n * span_unit);
+        _ = coolSpans(h, false);
+    }
+    const linux = std.os.linux;
+    const whole = spanUnits(old_size) * span_unit;
+    const rc = linux.mremap(@ptrFromInt(at), whole, whole, .{ .MAYMOVE = true, .FIXED = true, .DONTUNMAP = true }, @ptrFromInt(q));
+    if (@as(isize, @bitCast(rc)) < 0 and @as(isize, @bitCast(rc)) > -4096) {
+        freeSpan(h, q, new_size);
+        return null;
+    }
+    if (cold != null) recommit(q, n * span_unit);
+    freeSpan(h, at, old_size);
+    prefault(h, q + whole, likelyFilled((n * span_unit - whole) / 2));
+    return @ptrFromInt(q);
+}
