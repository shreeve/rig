+/// SCRATCH: stall trace (never committed). Per-thread rings of events,
+/// frozen and written out on SIGUSR1 (`RIG_STALL_TRACE=DIR`).
+pub const ST = struct {
+    pub const Ev = extern struct { t: u64, k: u8, pad: u8 = 0, w: u16, a: u32 };
