+// The generator's own health: a goroutine that sleeps 1 ms and notes how
+// late it wakes, and every 200 us a busy check of the wall clock's gaps.
+func ticker() {
+	for {
+		want := time.Now().Add(time.Millisecond)
+		time.Sleep(time.Millisecond)
+		got := time.Now()
+		if late := got.Sub(want); late > 5*time.Millisecond {
+			stallLog("T %d %d\n", got.UnixNano(), late.Microseconds())
+		}
+	}
+}
+
+var lastGC uint32
+
+func gcPauses() {
+	var ms runtime.MemStats
+	runtime.ReadMemStats(&ms)
+	for n := lastGC; n < ms.NumGC; n++ {
+		i := n % 256
+		if ms.PauseNs[i] > 500000 {
+			stallLog("G %d %d\n", ms.PauseEnd[i], ms.PauseNs[i]/1000)
+		}
+	}
+	lastGC = ms.NumGC
+}
