+        const n = if (i == 65) shared_len.fetchAdd(1, .monotonic) else blk: {
+            const v = lens[i];
+            lens[i] = v + 1;
+            break :blk v;
+        };
+        bufs[i][n & (per - 1)] = .{ .t = now(), .k = k, .w = w, .a = a };
+    }
+    pub fn widx(w: *const Worker) u16 {
+        return @intCast((@intFromPtr(w) - @intFromPtr(all_workers.*.ptr)) / @sizeOf(Worker));
+    }
+    pub fn pidx(p: *const Poller) u16 {
+        const w: *const Worker = @alignCast(@fieldParentPtr("poller", p));
+        return widx(w);
+    }
+    fn onUsr1(_: std.posix.SIG, _: *const std.posix.siginfo_t, _: ?*anyopaque) callconv(.c) void {
+        _ = freeze_req.fetchAdd(1, .monotonic);
+    }
+    pub fn start() void {
+        const p = rt.process.* orelse return;
+        const d = p.environ.getPosix("RIG_STALL_TRACE") orelse return;
+        if (d.len == 0 or d.len >= dir.len) return;
+        @memcpy(dir[0..d.len], d);
+        dir_len = d.len;
+        for (0..slots) |i| {
+            const m = std.posix.mmap(null, per * @sizeOf(Ev), .{ .READ = true, .WRITE = true }, .{ .TYPE = .PRIVATE, .ANONYMOUS = true }, -1, 0) catch return;
+            bufs[i] = @as([*]Ev, @ptrCast(@alignCast(m.ptr)))[0..per];
+            const bytes = std.mem.sliceAsBytes(bufs[i]);
+            var j: usize = 0;
+            while (j < bytes.len) : (j += 4096) @as(*volatile u8, &bytes[j]).* = 0;
+        }
+        const act: std.posix.Sigaction = .{ .handler = .{ .sigaction = onUsr1 }, .mask = std.posix.sigemptyset(), .flags = std.posix.SA.SIGINFO | std.posix.SA.RESTART };
+        std.posix.sigaction(.USR1, &act, null);
+        on = true;
+        _ = std.Thread.spawn(.{ .stack_size = 256 << 10 }, dumper, .{}) catch {};
+    }
+    fn dumper() void {
+        var seq: u32 = 0;
+        while (true) {
+            sleepNs(2 * std.time.ns_per_ms);
+            if (freeze_req.load(.monotonic) == 0) continue;
+            // Record on past the stall the signal reports, then freeze.
+            const t_sig = now();
+            sleepNs(300 * std.time.ns_per_ms);
+            frozen.store(true, .seq_cst);
+            sleepNs(1 * std.time.ns_per_ms);
+            dumpOne(seq, t_sig);
+            seq += 1;
+            for (0..slots) |i| lens[i] = 0;
+            shared_len.store(0, .monotonic);
+            freeze_req.store(0, .monotonic);
+            frozen.store(false, .seq_cst);
+        }
+    }
+    fn dumpOne(seq: u32, t_freeze: u64) void {
+        var path: [400]u8 = undefined;
+        const name = std.mem.printSentinel(&path, "{s}/dump-{d}-{d}.bin", .{ dir[0..dir_len], std.c.getpid(), seq }, 0) catch return;
+        const fd = std.c.open(name.ptr, .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true }, @as(std.c.mode_t, 0o644));
+        if (fd < 0) return;
+        defer _ = std.c.close(fd);
+        const from = t_freeze -| 2 * std.time.ns_per_s;
+        const hdr = [4]u64{ 0x5354414c4c, t_freeze, slots, per };
+        _ = std.c.write(fd, @ptrCast(&hdr), @sizeOf(@TypeOf(hdr)));
+        for (0..slots) |i| {
+            const n: u64 = if (i == 65) shared_len.load(.monotonic) else lens[i];
+            const have = @min(n, per);
+            const first = n - have;
+            // Skip events older than `from`.
+            var s = first;
+            while (s < n and bufs[i][s & (per - 1)].t < from) s += 1;
+            const h2 = [2]u64{ i, n - s };
+            _ = std.c.write(fd, @ptrCast(&h2), 16);
+            var k = s;
+            while (k < n) {
+                const at = k & (per - 1);
+                const run = @min(n - k, per - at);
+                _ = std.c.write(fd, @ptrCast(bufs[i][at..].ptr), run * @sizeOf(Ev));
+                k += run;
+            }
+        }
+        _ = std.c.write(fd, @ptrCast(&ports), @sizeOf(@TypeOf(ports)));
+    }
+};
