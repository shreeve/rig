+/// INTMODEL (scratch): `x` as the integer type `T`, as Rust's `as`: a
+/// narrower type keeps the low bits, a wider one extends by `x`'s sign.
+pub inline fn asInt(comptime T: type, x: anytype) T {
+    const F = @TypeOf(x);
+    const fw = @typeInfo(F).int.bits;
+    const tw = @typeInfo(T).int.bits;
+    if (tw <= fw) {
+        const UF = @Int(.unsigned, fw);
+        const UT = @Int(.unsigned, tw);
+        return @bitCast(@as(UT, @truncate(@as(UF, @bitCast(x)))));
+    }
+    const W = @Int(@typeInfo(F).int.signedness, tw);
+    return @bitCast(@as(W, x));
+}
