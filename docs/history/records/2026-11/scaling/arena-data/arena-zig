#!/usr/bin/env python3
"""arena-zig: measuring only. Before each compile of a Rig program, copies
the runtime files named in ARENA_FILES (a directory holding table.zig and
alloc.zig from the table-arena branch) over the program's out/rig/ copies,
whenever they differ. Everything else is the Rig that emitted the program."""
import os, sys, shutil, filecmp
src = os.environ["ARENA_FILES"]
def patch(out):
    rig = os.path.join(out, "rig")
    if not os.path.isdir(rig): return
    for f in ("table.zig", "alloc.zig"):
        a, b = os.path.join(src, f), os.path.join(rig, f)
        if os.path.exists(b) and not filecmp.cmp(a, b, shallow=False):
            shutil.copyfile(a, b); print("arena-zig: patched " + b, file=sys.stderr)
args = sys.argv[1:]
for a in args:
    if a.endswith(".zig") and os.path.isfile(a):
        patch(os.path.dirname(os.path.abspath(a))); break
real = os.environ.get("REAL_ZIG", "zig"); os.execvp(real, [real] + args)
