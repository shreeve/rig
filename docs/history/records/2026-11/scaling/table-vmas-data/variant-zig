#!/usr/bin/env python3
"""variant-zig: measuring only (after table-arena's arena-zig). Before each
compile of a Rig program, copies table.zig and alloc.zig from VARIANT_FILES
over the program's out/rig/ copies whenever they differ; everything else is
the Rig that emitted the program."""
import os, sys, shutil, filecmp
src = os.environ["VARIANT_FILES"]
def patch(out):
    rig = os.path.join(out, "rig")
    if not os.path.isdir(rig): return
    for f in ("table.zig", "alloc.zig"):
        a, b = os.path.join(src, f), os.path.join(rig, f)
        if os.path.exists(b) and not filecmp.cmp(a, b, shallow=False):
            shutil.copyfile(a, b); print("variant-zig: patched " + b, file=sys.stderr)
for a in sys.argv[1:]:
    if a.endswith(".zig") and os.path.isfile(a):
        patch(os.path.dirname(os.path.abspath(a))); break
real = os.environ.get("REAL_ZIG", "zig"); os.execvp(real, [real] + sys.argv[1:])
