sub each(n: Int, step: Int = 1, f: ?sub(Int))
  i = 0
  while i < n
    f(i)
    i += step

fun mid(a: Int, b: Int = 2, c: Int) -> Int
  a + b + c

fun opt(a: Int, f: (fun(Int) -> Int)? = none) -> Int
  if f as g
    return g(a)
  a

sub main()
  each(4, step: 2, |i| print("b", i))
  each(4, 2, |i| print("c", i))
  print(mid(1, c: 5))
  print(mid(1, 3, 5))
