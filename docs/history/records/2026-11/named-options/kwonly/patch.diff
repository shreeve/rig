index 000000000..096f4a1dc
--- /dev/null
+++ w/src/kwonly.zig
@@ -0,0 +1,36 @@
+//! TEMPORARY measurement: logs calls that pass a defaulted non-first
+//! parameter by position, and functions with one used as values.
+const std = @import("std");
+const diag = @import("diag.zig");
+
+pub var cur_path: []const u8 = "";
+pub var root_path: []const u8 = "";
+var fd: ?std.posix.fd_t = null;
+var failed = false;
+const log_path = "/private/tmp/claude-501/-Users-shreeve-Data-Code-undat/6fff74ce-077f-4bc9-afce-9c419f622ac3/scratchpad/kwonly/raw.log";
+
+fn clean(buf: []u8, s: []const u8) []const u8 {
+    const n = @min(buf.len, s.len);
+    for (s[0..n], 0..) |c, i| buf[i] = if (c == '\t' or c == '\n' or c == '\r') ' ' else c;
+    return buf[0..n];
+}
+
+/// kind, root, path, line:col, callee, param index, param name, argument text, source line
+pub fn log(kind: []const u8, source: []const u8, pos: u32, callee: []const u8, pidx: usize, pname: []const u8, arg: []const u8) void {
+    if (fd == null) {
+        if (failed) return;
+        fd = std.posix.openat(std.posix.AT.FDCWD, log_path, .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true }, 0o644) catch {
+            failed = true;
+            return;
+        };
+    }
+    const lc = diag.lineCol(source, pos);
+    const p = @min(pos, source.len);
+    const start = if (std.mem.lastIndexOfScalar(u8, source[0..p], '\n')) |i| i + 1 else 0;
+    const end = std.mem.indexOfScalarPos(u8, source, p, '\n') orelse source.len;
+    var b1: [400]u8 = undefined;
+    var b2: [600]u8 = undefined;
+    var buf: [4096]u8 = undefined;
+    const line = std.mem.print(&buf, "{s}\t{s}\t{s}\t{d}:{d}\t{s}\t{d}\t{s}\t{s}\t{s}\n", .{ kind, root_path, cur_path, lc.line, lc.col, callee, pidx, pname, clean(&b1, arg), clean(&b2, std.mem.trim(u8, source[start..end], " \t")) }) catch return;
+    _ = std.c.write(fd.?, line.ptr, line.len);
+}
