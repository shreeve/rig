+/// `RIG_SMALL_BORROW` (scratch), read once from /proc/self/environ: 0
+/// unread, else 1 + how many classes above its own a small request whose
+/// class would take a new page may take a free block of (at most 4).
+var small_borrow_var: std.atomic.Value(u8) = .init(0);
+const small_borrow = split.cell(&small_borrow_var, "alloc.small_borrow");
+
+fn smallBorrow() usize {
+    const v = small_borrow.load(.monotonic);
+    if (v != 0) return v - 1;
+    return readSmallBorrow();
+}
+
+noinline fn readSmallBorrow() usize {
+    @branchHint(.cold);
+    var n: usize = 0;
+    if (builtin.os.tag == .linux) {
+        const linux = std.os.linux;
+        const rc = linux.openat(linux.AT.FDCWD, "/proc/self/environ", .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, 0);
+        if (@as(isize, @bitCast(rc)) >= 0) {
+            const fd: linux.fd_t = @intCast(rc);
+            defer _ = linux.close(fd);
+            var m: HugeMinMatch = .{ .key = "RIG_SMALL_BORROW=" };
+            var buf: [512]u8 = undefined;
+            while (true) {
+                const r: isize = @bitCast(linux.read(fd, &buf, buf.len));
+                if (r <= 0) break;
+                m.feed(buf[0..@intCast(r)]);
+            }
+            m.feed(&.{0});
+            n = @min(m.found orelse 0, 4);
+        }
+    }
+    small_borrow.store(@intCast(n + 1), .monotonic);
+    return n;
+}
+
+/// A free block of one of the `smallBorrow` classes above `c`, for a
+/// request of class `c` aligned to 8 or less whose list and remote list
+/// are empty and whose page is carved to its end: so a class reuses the
+/// free blocks of the class above it before it takes a new page. Freed,
+/// the block goes on `c`'s list, as its length says.
+fn borrowUp(h: *Heap, c: usize, alignment: std.mem.Alignment) ?[*]u8 {
+    const n = smallBorrow();
+    if (n == 0 or alignment.toByteUnits() > 8) return null;
+    if (h.free[c] != null or h.remote[c].load(.monotonic) != null) return null;
+    if (h.carve[c] + classSize(c) <= h.carve_end[c]) return null;
+    var k = c + 1;
+    while (k <= c + n and k < class_count) : (k += 1) {
+        if (h.free[k]) |b| {
+            mustOwn(h);
+            h.free[k] = b.next;
+            return @ptrCast(b);
+        }
+    }
+    return null;
+}
