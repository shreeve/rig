+test "RIG_SMALL_BORROW: a class whose page is carved takes a free block of the class above" {
+    const a = allocator;
+    small_borrow.store(2, .monotonic);
+    defer small_borrow.store(1, .monotonic);
+    const h = heapForTest();
+    const c = classOf(100, .@"8").?;
+    // Carve the class's page to its end.
+    var held: [4096][]u8 = undefined;
+    var n: usize = 0;
+    while (n == 0 or h.carve[c] + classSize(c) <= h.carve_end[c]) : (n += 1) held[n] = try a.alloc(u8, 100);
+    // One block of the class above, freed.
+    const up = try a.alloc(u8, classSize(c + 1));
+    a.free(up);
+    const got = try a.alloc(u8, 100);
+    try std.testing.expectEqual(@intFromPtr(up.ptr), @intFromPtr(got.ptr));
+    a.free(got);
+    // Freed, it went on the list of its own length's class.
+    try std.testing.expectEqual(@intFromPtr(up.ptr), @intFromPtr(h.free[c].?));
+    for (held[0..n]) |p| a.free(p);
+}
