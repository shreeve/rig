+/// Probe (code-align round): `align(N) ` on every emitted function when
+/// RIG_PROBE_ALIGN=N is set at emit time.
+fn probeAlign(w: anytype) !void {
+    const v = std.c.getenv("RIG_PROBE_ALIGN") orelse return;
+    try w.print("align({s}) ", .{std.mem.span(v)});
