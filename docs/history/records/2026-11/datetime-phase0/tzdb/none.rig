# `none [NAME [SECONDS]]`: zone.rig without the zone: it reads the same
# arguments and prints SECONDS plus the length of NAME.
use std.os
use std.text

sub main()
  args = os.args()
  name = args[1] if args.len > 1 else "America/New_York"
  t = (text.parse_int(args[2]) catch 0) if args.len > 2 else 1700000000
  print(t + name.len)
