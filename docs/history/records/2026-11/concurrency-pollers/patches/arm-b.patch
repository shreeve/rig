diff --git i/src/sched.zig w/src/sched.zig
index 3fa69557c..722896119 100644
--- i/src/sched.zig
+++ w/src/sched.zig
@@ -2347,6 +2347,22 @@ fn registerIn(fd: i32) ?*Registration {
     return r;
 }
 
+// ARM B (scratch): watch `fd` with the workers' pollers by turns.
+var spread_next: std.atomic.Value(usize) = .init(0);
+pub noinline fn registerSpread(fd: i32) ?*Registration {
+    if (!started.*) startWorkers();
+    if (deterministic.*) return registerIn(fd);
+    const ws = workersNow();
+    const w = &ws[spread_next.fetchAdd(1, .monotonic) % ws.len];
+    const r = std.heap.smp_allocator.create(Registration) catch rt.oom();
+    r.* = .{ .fd = fd, .poller = &w.poller };
+    if (!w.poller.add(fd, r)) {
+        std.heap.smp_allocator.destroy(r);
+        return null;
+    }
+    return r;
+}
+
 /// Every registration, in a deterministic run, which runs on one thread.
 var registered_var: ?*Registration = null;
 const registered = split.cell(&registered_var, "sched.registered");
