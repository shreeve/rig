+// COUNT (scratch): tally a kqueue return, and append every worker's
+// counts to RIG_POLL_COUNT's file at most once a second.
+var count_path: ?[*:0]const u8 = null;
+var count_read: std.atomic.Value(u8) = .init(0);
+var count_last: std.atomic.Value(i64) = .init(0);
+var count_took: [64]std.atomic.Value(u64) = @splat(.init(0));
+fn countEvents(p: *Poller, evs: []const std.c.Kevent) void {
+    var rd: u64 = 0;
+    var wr: u64 = 0;
+    for (evs) |ev| {
+        if (ev.udata == 0) continue;
+        if (ev.filter == std.c.EVFILT.READ) rd += 1 else wr += 1;
+    }
+    if (evs.len == Poller.max_events) _ = p.c_full.fetchAdd(1, .monotonic);
+    if (rd + wr == 0) return;
+    _ = p.c_rd.fetchAdd(rd, .monotonic);
+    _ = p.c_wr.fetchAdd(wr, .monotonic);
+    const owner: *Worker = @alignCast(@fieldParentPtr("poller", p));
+    const m = me();
+    if (m == owner) _ = p.c_own.fetchAdd(rd + wr, .monotonic) else _ = p.c_other.fetchAdd(rd + wr, .monotonic);
+    if (m) |w| {
+        const i = (@intFromPtr(w) - @intFromPtr(all_workers.*.ptr)) / @sizeOf(Worker);
+        if (i < 64) _ = count_took[i].fetchAdd(rd + wr, .monotonic);
+    }
+    countDump();
+}
+fn countDump() void {
+    if (count_read.load(.acquire) == 0) {
+        if (count_read.cmpxchgStrong(0, 1, .seq_cst, .monotonic) == null) {
+            if (rt.process.*) |pr| if (pr.environ.getPosix("RIG_POLL_COUNT")) |v| {
+                const buf = std.heap.smp_allocator.allocSentinel(u8, v.len, 0) catch return;
+                @memcpy(buf, v);
+                count_path = buf.ptr;
+            };
+            count_read.store(2, .release);
+        }
+        return;
+    }
+    if (count_read.load(.acquire) != 2) return;
+    const path = count_path orelse return;
+    const now: i64 = @truncate(nowNs());
+    const last = count_last.load(.monotonic);
+    if (now - last < std.time.ns_per_s) return;
+    if (count_last.cmpxchgStrong(last, now, .monotonic, .monotonic) != null) return;
+    const fd = std.c.open(path, .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true }, @as(std.c.mode_t, 0o644));
+    if (fd < 0) return;
+    defer _ = std.c.close(fd);
+    var buf: [256]u8 = undefined;
+    for (workersNow(), 0..) |*w, i| {
+        const q = &w.poller;
+        const line = std.fmt.bufPrint(&buf, "t {d} w {d} cur {d} regs {d} rd {d} wr {d} own {d} other {d} full {d} miss {d} took {d}\n", .{
+            now, i, q.count.load(.monotonic), q.c_regs.load(.monotonic), q.c_rd.load(.monotonic), q.c_wr.load(.monotonic),
+            q.c_own.load(.monotonic), q.c_other.load(.monotonic), q.c_full.load(.monotonic), q.c_miss.load(.monotonic),
+            count_took[i].load(.monotonic),
+        }) catch continue;
+        _ = std.c.write(fd, line.ptr, line.len);
+    }
+}
