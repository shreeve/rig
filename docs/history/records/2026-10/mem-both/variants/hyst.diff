 /// The bytes of freed large blocks `h` keeps, resident and cold.
+/// PROTOTYPE: move the oldest resident blocks (each bucket's last) to the
+/// cold list, their pages given back, until `h` keeps `to` bytes resident.
+fn evictOldest(h: *Heap, to: usize) void {
+    while (h.kept.bytes > to) {
+        const j = lastHeld(&h.kept) orelse return;
+        var at = &h.kept.large[j];
+        while (at.*.?.next != null) at = &at.*.?.next;
+        const f = at.*.?;
+        at.* = null;
+        if (h.kept.large[j] == null) h.kept.held[j / 64] &= ~(@as(u64, 1) << @intCast(j % 64));
+        h.kept.bytes -= f.len;
+        const len = f.len;
+        decommit(@intFromPtr(f), len);
+        keepPiece(&h.cold, @intFromPtr(f), len);
+    }
+}
