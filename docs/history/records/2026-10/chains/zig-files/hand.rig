obj Image
  id: Int
  name: String

obj Rendered
  image: Image

enum State
  loading
  ready(rendered: Rendered?)

obj Entry
  state: State
  touched: Int
  bytes: Int

obj Cache
  entries: Map[String, Entry]
  bytes: Int
  retired: List[Image]

  sub trim(!@)
    while @entries.len > 2 or @bytes > 100
      oldest: String? = none
      touched = 0
      for e in ?@entries.items()
        if e.value.state matches .ready(_)
          if oldest == none or e.value.touched < touched
            oldest = +e.key
            touched = e.value.touched
      key = <oldest ?? break
      entry = !@entries.take(key) ?? break
      @bytes -= entry.bytes
      if <entry.state matches .ready(rendered?)
        !@retired.push(<rendered.image)

sub main()
  c = Cache(entries: Map[String, Entry](), bytes: 0, retired: List[Image]())
  names = ["a", "b", "c", "d", "e", "f"]
  for n, i in names
    !c.entries.put(String(n), Entry(state: State.ready(rendered: Rendered(image: Image(id: i, name: String(n)))), touched: 10 - i, bytes: 30))
    c.bytes += 30
  (!c).trim()
  print(c.entries.len, c.bytes, c.retired.len)
