--- i/std/file.zig
+++ w/std/file.zig
@@ -30,8 +30,59 @@ const not_found = error.@"std.file.FileError.not_found";
 /// So `args` hold nothing the task may free meanwhile: paths and bytes,
 /// which the pool copies, and plain values; a result that owns something
 /// (a String, a descriptor, `Fd`) is freed by its drop.
+const Stat = struct { n: u64 = 0, wall: u64 = 0, run: u64 = 0, fiber: u64 = 0 };
+var stats: [8]Stat = @splat(.{});
+var hooked = false;
+fn nowNs() u64 {
+    return @intCast(std.Io.Timestamp.now(rig.io(), .awake).nanoseconds);
+}
+fn same(comptime f: anytype, comptime g: anytype) bool {
+    if (@TypeOf(f) != @TypeOf(g)) return false;
+    return f == g;
+}
+fn kindOf(comptime f: anytype) usize {
+    if (same(f, readHere)) return 0;
+    if (same(f, statHere)) return 1;
+    if (same(f, entriesHere)) return 2;
+    if (same(f, realpathHere)) return 3;
+    if (same(f, existsHere)) return 4;
+    if (same(f, openHere)) return 5;
+    return 6;
+}
+const kind_names = [_][]const u8{ "read", "stat", "read_dir", "realpath", "exists", "open", "other", "-" };
+fn dump() void {
+    var buf: [2048]u8 = undefined;
+    var w: usize = 0;
+    for (stats, 0..) |s, i| {
+        if (s.n == 0) continue;
+        const line = std.fmt.bufPrint(buf[w..], "filestat {s} n={d} wall_us={d} run_us={d} handoff_us={d} on_fiber={d}\n", .{ kind_names[i], s.n, s.wall / 1000, s.run / 1000, (s.wall -| s.run) / 1000, s.fiber }) catch break;
+        w += line.len;
+    }
+    const line = std.fmt.bufPrint(buf[w..], "filestat spin calls={d} iters={d} us={d}\n", .{ rig.sched.spin_calls, rig.sched.spin_iters, rig.sched.spin_ns / 1000 }) catch "";
+    w += line.len;
+    _ = std.posix.system.write(2, &buf, w);
+}
 fn pool(comptime T: type, comptime f: anytype, args: anytype) Error!T {
-    return try (try rig.blockingStop(f, args));
+    if (!hooked) {
+        hooked = true;
+        rig.exit_hook = dump;
+    }
+    const k = comptime kindOf(f);
+    const Args = @TypeOf(args);
+    const R = @typeInfo(@TypeOf(f)).@"fn".return_type.?;
+    const W = struct {
+        fn g(a: Args) R {
+            const t = nowNs();
+            defer _ = @atomicRmw(u64, &stats[k].run, .Add, nowNs() - t, .monotonic);
+            return @call(.auto, f, a);
+        }
+    };
+    const t0 = nowNs();
+    const r = rig.blockingStop(W.g, .{args});
+    stats[k].wall += nowNs() - t0;
+    stats[k].n += 1;
+    if (rig.sched.current() != null) stats[k].fiber += 1;
+    return try (try r);
 }
 
