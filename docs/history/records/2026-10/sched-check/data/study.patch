+inline fn callKeepingNoMem(comptime f: fn () callconv(.c) void) void {
+    if (comptime !keeps_registers) return f();
+    switch (builtin.cpu.arch) {
+        .x86_64 => asm volatile (
+            \\ leaq -128(%%rsp), %%rsp
+            \\ callq %[call:P]
+            \\ leaq 128(%%rsp), %%rsp
+            :
+            : [call] "X" (&Keeping(f).call),
+            : .{ .rflags = true, .memory = false }),
+        .aarch64 => asm volatile (
+            \\ sub sp, sp, #144
+            \\ str x30, [sp]
+            \\ bl %[call]
+            \\ ldr x30, [sp]
+            \\ add sp, sp, #144
+            :
+            : [call] "X" (&Keeping(f).call),
+            : .{ .nzcv = true, .memory = false }),
+        else => comptime unreachable,
+    }
+}
