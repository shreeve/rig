+    /// Move `n` bytes, at most 16, from `src` to `dst` by loads that may
+    /// overlap, all done before any store, so the ranges may overlap too.
+    inline fn moveShort(dst: [*]u8, src: [*]const u8, n: usize) void {
+        if (n >= 8) {
+            const a = src[0..8].*;
+            const b = src[n - 8 ..][0..8].*;
+            dst[0..8].* = a;
+            dst[n - 8 ..][0..8].* = b;
+        } else if (n >= 4) {
+            const a = src[0..4].*;
+            const b = src[n - 4 ..][0..4].*;
+            dst[0..4].* = a;
+            dst[n - 4 ..][0..4].* = b;
+        } else if (n > 0) {
+            const a = src[0];
+            const b = src[n / 2];
+            const c = src[n - 1];
+            dst[0] = a;
+            dst[n / 2] = b;
+            dst[n - 1] = c;
+        }
+    }
