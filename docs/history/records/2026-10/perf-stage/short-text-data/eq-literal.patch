+/// The length of a string literal's type, a pointer to a byte array
+/// with a sentinel; null for any other type.
+fn litLen(comptime T: type) ?usize {
+    return switch (@typeInfo(T)) {
+        .pointer => |p| if (p.size == .one) switch (@typeInfo(p.child)) {
+            .array => |a| if (a.child == u8 and a.sentinel_ptr != null) a.len else null,
+            else => null,
+        } else null,
+        else => null,
+    };
+}
+
+/// Whether `x` has the bytes of `lit`, a literal: the lengths first, then
+/// up to 16 bytes by loads that may overlap, the rest by `std.mem.eql`.
+inline fn eqlLit(x: []const u8, lit: anytype) bool {
+    const n = comptime litLen(@TypeOf(lit)).?;
+    if (x.len != n) return false;
+    if (n == 0) return true;
+    if (n > 16) return std.mem.eql(u8, x, lit);
+    const p = x.ptr;
+    const q: [*]const u8 = lit;
+    if (n >= 8) return (load(u64, p) ^ load(u64, q)) | (load(u64, p + n - 8) ^ load(u64, q + n - 8)) == 0;
+    if (n >= 4) return (load(u32, p) ^ load(u32, q)) | (load(u32, p + n - 4) ^ load(u32, q + n - 4)) == 0;
+    if (n >= 2) return (load(u16, p) ^ load(u16, q)) | (load(u16, p + n - 2) ^ load(u16, q + n - 2)) == 0;
+    return p[0] == q[0];
+}
+
+/// `T` read from `p`, unaligned, in native byte order.
+inline fn load(comptime T: type, p: [*]const u8) T {
+    return std.mem.readInt(T, p[0..@sizeOf(T)], builtin.cpu.arch.endian());
+}
