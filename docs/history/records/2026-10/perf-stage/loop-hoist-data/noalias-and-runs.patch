+/// Where the next run of a range loop's turns stops, from `i` toward
+/// `end` (`i < end`), in a program that makes tasks: after the turns
+/// left of `n`, or at `end` if that comes first. The loop runs those
+/// turns as a loop of its own with no yield check in it, then counts
+/// them all at once (`turnsRan`), so that inner loop calls nothing the
+/// body does not, and LLVM may keep in registers what it reads there.
+/// With no scheduler the run is the whole range.
+pub inline fn turnStop(i: anytype, end: @TypeOf(i), n: u32) @TypeOf(i) {
+    if (!scheduled or @inComptime()) return end;
+    const T = @TypeOf(i);
+    const U = @Int(.unsigned, @bitSizeOf(T));
+    const left: U = @bitCast(end -% i);
+    const k: U = if (left < n) left else @intCast(n);
+    return i +% @as(T, @bitCast(k));
+}
+
+/// The turns a range loop ran from `from` to `stop` (`turnStop`),
+/// counted down in `n` together: when they use up the count, the task
+/// yields if other work waits for its worker, as `turn` does.
+pub inline fn turnsRan(n: *u32, from: anytype, stop: @TypeOf(from)) void {
+    if (!scheduled or @inComptime()) return;
+    const U = @Int(.unsigned, @bitSizeOf(@TypeOf(from)));
+    const k: U = @bitCast(stop -% from);
+    n.* -|= @intCast(k);
+    if (n.* == 0) {
+        @branchHint(.unlikely);
+        n.* = tick_turns;
+        sched.tick();
+    }
+}
