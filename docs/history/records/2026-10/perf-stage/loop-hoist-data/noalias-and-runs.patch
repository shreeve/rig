+  # A task reading a List in a range loop holds its loan across every
+  # yield check, so no task may write the List until it is done.
+  sub grow(xs: !List[Int])
+    !xs.push(1)
+
+  fun sum(xs: ?List[Int]) -> Int
+    total = 0
+    for i in 0..xs.len
+      total += xs[i]
+    total
+
+  xs: List[Int] = List()
+  !xs.push(0)
+  s = sum(?xs)&
+  t = grow(!xs)&
+  print(>s)
+  >t
+
