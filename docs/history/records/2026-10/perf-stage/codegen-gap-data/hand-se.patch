From 94d999e80f4a28530c17e484eaaa27612660cec0 Mon Sep 17 00:00:00 2001
From: Steve Shreeve <steve.shreeve@gmail.com>
Date: Tue, 27 Oct 2026 20:28:17 -0600
Subject: [PATCH] se4_active

---
 checker.zig | 16 +++++++---------
 1 file changed, 7 insertions(+), 9 deletions(-)

diff --git a/checker.zig b/checker.zig
index 7b2c47b..c91a93f 100644
--- a/checker.zig
+++ b/checker.zig
@@ -46343,17 +46343,15 @@ pub const Checker = struct {
     pub inline fn find_active_mapper(__rig_in_self: *const Checker, __rig_in_mapper: rig.SlotOf(16777216)) i64 {
         const self = rig.rt(__rig_in_self);
         const mapper = rig.rt(__rig_in_mapper);
-        var i: i64 = rig.lenOf(self.active_mappers);
+        // CEILING se4: the List read once; `i` counts down from its
+        // length and nothing writes it in the loop, so no test.
+        const items = self.active_mappers.items();
+        var i: usize = items.len;
         {
             var __rig_turns_7236: u32 = rig.tick_turns;
-            while (true) : (rig.turn(&__rig_turns_7236)) {
-                if (!(i > 0)) break;
-                {
-                    i -= 1;
-                    if (self.active_mappers.at(i) == mapper) {
-                        return i;
-                    }
-                }
+            while (i > 0) : (rig.turn(&__rig_turns_7236)) {
+                i -= 1;
+                if (items[i] == mapper) return @intCast(i);
             }
         }
         return @as(i64, -1);
