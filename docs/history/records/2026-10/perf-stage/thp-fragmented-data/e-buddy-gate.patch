index 063dad438..9fa330824 100644
--- i/src/alloc.zig
+++ w/src/alloc.zig
@@ -440,10 +440,45 @@ fn mapPages(size: usize) ?usize {
 /// system that cannot leaves them as they are.
 fn adviseHuge(p: usize, len: usize) void {
     if (builtin.os.tag != .linux) return;
+    if (!hugeFree(@min(len / huge_page, 16))) return;
     const at: [*]align(std.heap.page_size_min) u8 = @ptrFromInt(p);
     std.posix.madvise(at, len, std.os.linux.MADV.HUGEPAGE) catch {};
 }
 
+/// Whether Linux has `n` free blocks of 2 MiB or more and 16 to spare
+/// (`/proc/buddyinfo`, orders 9 and up, every zone but `DMA`, whose blocks
+/// no user page takes): memory advised for huge pages and faulted with
+/// none free compacts memory in the fault, under the default `defrag` of
+/// `madvise`. Where the file cannot be read, true.
+fn hugeFree(n: usize) bool {
+    const linux = std.os.linux;
+    const rc = linux.openat(linux.AT.FDCWD, "/proc/buddyinfo", .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, 0);
+    if (@as(isize, @bitCast(rc)) < 0) return true;
+    const fd: linux.fd_t = @intCast(rc);
+    defer _ = linux.close(fd);
+    var buf: [4096]u8 = undefined;
+    var len: usize = 0;
+    while (len < buf.len) {
+        const r = linux.read(fd, buf[len..].ptr, buf.len - len);
+        if (@as(isize, @bitCast(r)) <= 0) break;
+        len += r;
+    }
+    var units: usize = 0;
+    var lines = std.mem.splitScalar(u8, buf[0..len], '\n');
+    while (lines.next()) |line| {
+        // "Node 0, zone   Normal  c0 c1 ... c10": four words, then a count per order.
+        var words = std.mem.tokenizeScalar(u8, line, ' ');
+        var order: isize = -4;
+        while (words.next()) |w| : (order += 1) {
+            if (order == -1 and std.mem.eql(u8, w, "DMA")) break;
+            if (order < 9) continue;
+            const c = std.fmt.parseUnsigned(usize, w, 10) catch continue;
+            units += c << @intCast(order - 9);
+        }
+    }
+    return units >= n + 16;
+}
+
 /// `size` more bytes of large blocks handed out. The settled peak is
 /// raised by a free (`freeLarge`), not here, so a block handed out
 /// before the one it replaces is freed does not count twice.
