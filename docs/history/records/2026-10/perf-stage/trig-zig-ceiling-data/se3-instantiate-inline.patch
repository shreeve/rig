From 21a2a2dd155b6348d1ade03e843b8af8b1fef658 Mon Sep 17 00:00:00 2001
From: Steve Shreeve <steve.shreeve@gmail.com>
Date: Tue, 27 Oct 2026 20:28:47 -0600
Subject: [PATCH] se3_instantiate

---
 checker.zig | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/checker.zig b/checker.zig
index 86503d7..11df922 100644
--- a/checker.zig
+++ b/checker.zig
@@ -46206,8 +46206,11 @@ pub const Checker = struct {
         return false;
     }
 
-    pub fn instantiate_type(self: *Checker, t: rig.SlotOf(134217728), m: rig.SlotOf(16777216)) rig.SlotOf(134217728) {
-        @setEvalBranchQuota(rig.eval_quota);
+    pub inline fn instantiate_type(self: *Checker, t: rig.SlotOf(134217728), m: rig.SlotOf(16777216)) rig.SlotOf(134217728) {
+        // CEILING se3: the exits that touch nothing, at the call; the
+        // rest out of line.
+        if (t == 0 or m == 0) return t;
+        if (!self.could_contain_type_variables(t) and self.type_alias(t) == 0) return t;
         return self.instantiate_type_with_alias(t, m, 0);
     }
 
