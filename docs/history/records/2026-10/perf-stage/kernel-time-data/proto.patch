+// PROTOTYPE (kernel-time): RIG_KT letters switch policies for measurement.
+//   s no segment prefault, l no new-large prefault, g no growth prefault,
+//   S a new segment prefaults whole (4 MiB) and none after,
+//   t tag each kernel call by its site (an invalid madvise just before it),
+//   k never give kept blocks back (no trim, no unmap on free).
+const Exp = struct { read: bool = false, s: bool = false, l: bool = false, g: bool = false, S: bool = false, t: bool = false, k: bool = false };
+var exp: Exp = .{};
+var env_buf: [1 << 16]u8 = undefined;
+inline fn ex() Exp {
+    if (!exp.read) readExp();
+    return exp;
+}
+noinline fn readExp() void {
+    @branchHint(.cold);
+    var e: Exp = .{ .read = true };
+    if (builtin.os.tag == .linux) blk: {
+        const linux = std.os.linux;
+        const rc = linux.openat(linux.AT.FDCWD, "/proc/self/environ", .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, 0);
+        if (@as(isize, @bitCast(rc)) < 0) break :blk;
+        const fd: linux.fd_t = @intCast(rc);
+        defer _ = linux.close(fd);
+        var len: usize = 0;
+        while (len < env_buf.len) {
+            const r: isize = @bitCast(linux.read(fd, env_buf[len..].ptr, env_buf.len - len));
+            if (r <= 0) break;
+            len += @intCast(r);
+        }
+        var it = std.mem.splitScalar(u8, env_buf[0..len], 0);
+        while (it.next()) |kv| if (std.mem.startsWith(u8, kv, "RIG_KT=")) {
+            for (kv[7..]) |ch| switch (ch) {
+                's' => e.s = true,
+                'l' => e.l = true,
+                'g' => e.g = true,
+                'S' => e.S = true,
+                't' => e.t = true,
+                'k' => e.k = true,
+                else => {},
+            };
+        };
+    }
+    exp = e;
+}
+/// PROTOTYPE: an invalid madvise naming the site of the kernel call after it.
+pub fn tag(p: usize, len: usize, site: u32) void {
+    if (builtin.os.tag != .linux) return;
+    if (!ex().t) return;
+    _ = std.os.linux.syscall3(.madvise, p & ~(std.heap.pageSize() - 1), len, 0x7700 + site);
+}
