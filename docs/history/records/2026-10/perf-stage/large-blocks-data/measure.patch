+    fn largeSnapshot(self: *HeapProfile) void {
+        self.lg_snaps += 1;
+        self.lg_snap.clearRetainingCapacity();
+        for (self.owners.items) |o| {
+            o.lg_blocks = 0;
+            o.lg_cap = 0;
+            o.lg_size = 0;
+            o.lg_used = 0;
+            o.lg_res = 0;
+        }
+        var it = self.live.iterator();
+        while (it.next()) |e| {
+            const b = e.value_ptr.*;
+            if (b.size <= fast_alloc.max_small) continue;
+            const addr = e.key_ptr.*;
+            const bytes: [*]const u8 = @ptrFromInt(addr);
+            var used: usize = b.size;
+            while (used > 0 and bytes[used - 1] == 0) used -= 1;
+            const size = fast_alloc.largeSize(b.size);
+            var res: usize = 0;
