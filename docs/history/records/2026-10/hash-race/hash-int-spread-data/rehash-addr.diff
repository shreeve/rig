+                while (m != 0) : (m &= m - 1) {
+                    const e = &es[g * NL + laneOf(m)];
+                    const hash = hashOf(e);
+                    const h = homeOf(hash, new.shift);
+                    const in1 = h.pos == p1;
+                    const in2 = h.pos == p2;
+                    const kept = in1 or in2;
