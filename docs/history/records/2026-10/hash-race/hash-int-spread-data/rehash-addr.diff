+                        const slot = emplace(new, hash);
+                        pos = slot / NL;
+                        lane = slot - pos * NL;
+                    }
+                    new.elements[pos * NL + lane] = e.*;
+                    if (pos != p1) {
+                        p2 = p1;
+                        l2 = l1;
+                    }
+                    p1 = pos;
+                    l1 = lane;
+                }
