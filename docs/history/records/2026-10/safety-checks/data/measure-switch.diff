     no_proofs: bool = false,
+    /// MEASURING ONLY (`RIG_MEASURE_UNCHECKED` has `index`): every Int
+    /// index is treated as proven in both directions.
+    measure_index: bool = false,
     /// The Zig name of each flag written (`emitFlag`), by the statement
