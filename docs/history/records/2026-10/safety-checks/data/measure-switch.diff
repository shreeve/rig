 /// stderr after everything `print` has buffered, with Zig's stack trace
 /// in a debug build, then the end of the program by `abort` (status
 /// 134). It is the same event as a `panic(...)` (`fail`).
-pub const panic = std.debug.FullPanic(panicAfterFlush);
+pub const panic = if (@hasDecl(root, "__rig_measure_unchecked")) MeasurePanic else std.debug.FullPanic(panicAfterFlush);
+
+/// MEASURING ONLY (`RIG_MEASURE_UNCHECKED=kind,...`): each safety-check
+/// handler of a kind named is unreachable, so LLVM deletes the check that
+/// calls it, as `-OReleaseFast` never makes it.
+fn measured(comptime kind: []const u8) bool {
+    if (!@hasDecl(root, "__rig_measure_unchecked")) return false;
+    return comptime std.mem.indexOf(u8, root.__rig_measure_unchecked, "," ++ kind ++ ",") != null;
+}
+
+const MeasurePanic = struct {
+    const F = std.debug.FullPanic(panicAfterFlush);
+    pub const call = F.call;
+    pub fn sentinelMismatch(expected: anytype, found: @TypeOf(expected)) noreturn {
