diff --git a/test/cli/std_proofs.sh b/test/cli/std_proofs.sh
new file mode 100644
index 000000000..f4a4dec4e
--- /dev/null
+++ b/test/cli/std_proofs.sh
@@ -0,0 +1,48 @@
+# The hash tables of the standard library index their Lists with every
+# test proven (docs/internals/INTERNALS.md, "Proven checks"): in a
+# table's probe (`find`, `place`) and an iterator's `next`, each index
+# by `i` or `j` has both its tests proven, but an entry's own index
+# `@es[j]` or `@ks[j]`, whose `j` comes from the table: valid by
+# construction, and not something a fact can show.
+source "$ROOT/test/cli/_lib.sh"
+
+check_file() {
+    local src=$1
+    local dump
+    dump=$("$RIG" check --facts=proofs "$src" 2>err.txt) || fail "rig check --facts=proofs $src: $(cat err.txt)"
+    local fn= line=0 checked=0
+    while IFS= read -r text; do
+        line=$((line + 1))
+        if [[ $text =~ ^[[:space:]]*(pub\ )?(fun|sub|called\ sub)\ ([a-z_]+) ]]; then
+            fn=${BASH_REMATCH[3]}
+            continue
+        fi
+        case $fn in find | place | next) ;; *) continue ;; esac
+        local uses
+        uses=$(grep -oE '[@a-z_.]+\[[ij]\]' <<<"$text" | grep -vE '^@(es|ks)\[j\]$' | wc -l | tr -d ' ')
+        [[ $uses -gt 0 ]] || continue
+        local proven
+        proven=$(grep -cE "^$line:[0-9]+ index lower upper$" <<<"$dump")
+        [[ $proven -ge $uses ]] || fail "$(basename "$src"):$line ($fn): $uses index(es), $proven proven: $text"
+        checked=$((checked + uses))
+    done <"$src"
+    [[ $checked -ge ${2:-1} ]] || fail "$(basename "$src"): only $checked indexes checked"
+}
+
+check_file "$ROOT/std/__rig_builtin.rig" 20
+
+# std.text's Interner probes its table as a Map does; it binds Zig code,
+# so it is checked in the Zig a program that uses it is given.
+cat >interner.rig <<'EOF'
+use std.text
+
+sub main()
+  names = text.Interner()
+  for i in 0..40
+    _ = !names.intern(String("n", i))
+  print(names.id("n7") ?? 99, names.id("x") ?? 99)
+EOF
+out=$(RIG_OUT_DIR=$PWD/interner "$RIG" run interner.rig 2>&1) || fail "rig run interner.rig: $out"
+expect_eq "$out" "7 99" "the Interner's ids"
+grep -qF 'rig.atProven(ats, i, .both)' interner/__rig_std_text.zig || fail "the Interner's probe reads an id with a test"
+grep -qF 'rig.elemPtrProven(ats, __rig_ix' interner/__rig_std_text.zig || fail "the Interner's table writes an id with a test"
