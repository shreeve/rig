# Reading JSON with std.json. `json.parse` checks the whole document and
# gives a Doc, a tape with one entry per value, in document order. Walking the tape
# with `kind` and `next` reads an object's keys and values, an array's
# items, and skips what is not wanted. Strings without escapes view
# the source, so `src` stays lent while `doc` is in use.

use std.json

sub main()
  src = "{\"name\": \"Ada\", \"born\": 1815, \"langs\": [\"en\", \"fr\"], \"ratio\": 0.5, \"notes\": {\"x\": [1, 2]}}"
  doc = json.parse(?src) catch |e|
    print("error", e)
    return
  print(doc.len, doc.kind(0))

  i = 1
  while doc.kind(i) != .object_end
    key = ?doc.string(i)
    i += 1
    k = doc.kind(i)
    if k == .string
      print(key, "is the text", doc.string(i))
    else if k == .int
      print(key, "is the integer", doc.int(i))
    else if k == .float
      print(key, "is the float", doc.float(i))
    else if k == .array
      print(key, "holds")
      for j in i + 1..doc.next(i) - 1
        print("-", doc.string(j))
    else
      print(key, "is skipped")
    i = doc.next(i)

  # A Doc made empty is filled by `load`, again and again, reusing its
  # lists; a failure names its reason and the byte where reading stopped.
  bad = "[1, 2"
  again = json.Doc()
  !again.load(?bad) catch |e|
    match e
      .eof(at) => print("cut short at byte", at)
      _ => print(e)

# expect:
# 21 .object
# name is the text Ada
# born is the integer 1815
# langs holds
# - en
# - fr
# ratio is the float 0.5
# notes is skipped
# cut short at byte 5
