# ==============================================================================
# rig.grammar — Rig lexer and parser grammar
# ==============================================================================
#
# Processed by Nexus 1.0 into src/parser.zig (`zig build parser`). The
# @schema at the top of the parser section declares every IR node kind and
# its roles; Nexus checks every action against it and generates the IR
# accessors (`parser.ir`) the compiler reads the tree with.
#
# The generated BaseLexer only splits the source into raw tokens. The lexer
# rewriter in src/rig.zig then:
#
#   * turns indentation into INDENT / OUTDENT / NEWLINE, and joins lines
#     inside ( ) and [ ] (a newline there is plain whitespace), except in
#     a closure body that starts below its bar list, which is laid out in
#     blocks as anywhere else;
#   * classifies keywords (every keyword is reserved, but reads as a name
#     where it names a member: after `.`, before `:` inside ( ), and in a
#     member list before `:` or after `fun` / `sub`); `of` is a keyword
#     only after a value directly inside [ ] (`[n of x]`), and a name
#     everywhere else;
#   * marks a `..` whose next token is `]` as DOTDOT_OPEN, the end of an
#     open range (`xs[a..]`, `xs[..]`);
#   * classifies the characters whose meaning depends on spacing. The rule
#     is the same for all of them: a character that touches its operand and
#     not the preceding value is a prefix; otherwise it is an infix
#     operator or a suffix.
#
#       <x +x ?x !x *x ~x -x         ownership sigils / negation
#       |+a, b|  ||  *|a|            closure bar list (vs bitwise `|`)
#       f(x) a[i] Vec[Int]           call / index or compile-time
#                                    arguments (vs `f (x)`, `f [1, 2]`,
#                                    which pass a new operand to `f`)
#       .red                         enum literal (vs member access a.b)
#       T? T! x! x?                  type / propagation suffixes
#       a if c else b                ternary vs postfix guard `stmt if c`
#
# The grammar has no LALR conflicts; see docs/INTERNALS.md (Conflicts policy).
# ==============================================================================

@lang = "rig"

@lexer

tokens
    # Literals
    ident           # identifier
    integer         # 0, 42, 1_000, 0xff, 0b1010, 0o17
    real            # 3.14, .5, 1.0e10, 2e-3
    string_sq       # 'single'
    string_dq       # "double"

    # Keywords (classified by the rewriter; every keyword is reserved)
    true
    false
    and
    as
    break
    catch
    continue
    defer
    drop
    else
    enum
    errdefer
    error
    extern
    for
    fun
    if
    in
    match
    new             # a keyword only at statement start (`new x = ...`)
    not
    or
    pub
    raw
    return
    struct
    sub
    test
    try             # reserved; no form uses it
    type
    use
    while
    zig             # reserved; no form uses it

    # Operators
    plus            # +
    minus           # -  infix
    minus_prefix    # -x negation
    star            # *
    slash           # /
    percent         # %
    power           # ** (not a Rig operator; lexed so it can be rejected)
    eq              # ==
    ne              # !=
    lt              # <
    gt              # >
    le              # <=
    ge              # >=
    and_sym         # && (not a Rig operator; the rewriter rejects it)
    or_sym          # || (not a Rig operator; the rewriter rejects it)
    not_sym         # !
    question        # ?
    nullish         # ??
    bar             # |  bitwise or
    ampersand       # &
    caret           # ^
    tilde           # ~
    lshift          # <<
    rshift          # >>
    at              # @
    assign          # =
    fixed_assign    # =!
    move_assign     # <-
    plus_assign     # +=
    minus_assign    # -=
    star_assign     # *=
    slash_assign    # /=
    percent_assign  # %=
    amp_assign      # &=
    bar_assign      # |=
    caret_assign    # ^=
    lshift_assign   # <<=
    rshift_assign   # >>=

    # Punctuation
    lparen          # (  grouping, parameter list, or a new operand
    rparen          # )
    lbracket        # [  array literal or slice/array type
    rbracket        # ]
    comma           # ,
    colon           # :
    arrow           # ->
    fat_arrow       # =>
    dot             # .  member access
    dotdot          # ..

    # Layout (produced by the rewriter)
    indent
    outdent
    newline

    # Rewriter-classified tokens
    lparen_call     # (  touching the preceding value: call
    lbracket_index  # [  touching the preceding value: index, or
                    #    compile-time arguments and parameters
    post_if         # if  postfix guard: `stmt if cond`
    ternary_if      # if  inline ternary: `a if cond else b`
    bar_capture     # |   closure bar list delimiter: `|+a, b|`
    bar_empty       # ||  an empty closure bar list: `|| print(1)`
    dot_lit         # .   enum literal: `.red`
    kwarg_name      # name directly followed by `:` inside ( )
    move_pfx        # <x  move
    clone_pfx       # +x  clone
    read_pfx        # ?x  read borrow, ?T read-borrowed type
    write_pfx       # !x  write borrow, !T write-borrowed type
    share_pfx       # *x  share, *T shared type
    drop_stmt       # -x  drop, as a whole statement
    suffix_q        # T?  optional type
    suffix_bang     # T!  fallible type, x! propagate failure
    of              # of  after a value inside [ ]: a fill literal `[n of x]`
    dotdot_open     # ..  directly before `]`: an open range `xs[a..]`, `xs[..]`

    # Misc
    comment
    eof
    err

# ==============================================================================
# LEXER RULES
# ==============================================================================

'#' [^\n]*                                  → comment

"\\\n"                                      → skip         # line continuation
"\\\r\n"                                    → skip
"\r\n"                                      → newline
'\n'                                        → newline

# Strings hold no control characters: a tab or newline is written as an
# escape (`\t`, `\n`), which only double-quoted strings take.
'"' ([^"\\\x00-\x1f\x7f] | '\\' [^\x00-\x1f\x7f])* '"'  → string_dq
"'" ([^'\x00-\x1f\x7f] | "''")* "'"             → string_sq

# Numbers: `_` may separate digits; radix prefixes are lowercase, and a
# decimal number has no leading zero. Anything else that starts with a
# digit is one malformed-number error.
"0x" [0-9a-fA-F] ('_'? [0-9a-fA-F])*        → integer
"0b" [01] ('_'? [01])*                      → integer
"0o" [0-7] ('_'? [0-7])*                    → integer
('0' | [1-9] ('_'? [0-9])*)? '.' [0-9] ('_'? [0-9])* ([eE] [+-]? [0-9] ('_'? [0-9])*)? → real
('0' | [1-9] ('_'? [0-9])*) [eE] [+-]? [0-9] ('_'? [0-9])* → real
'0' | [1-9] ('_'? [0-9])*                   → integer
[0-9] [0-9a-zA-Z_]*                         → err

"<<="                                       → lshift_assign
">>="                                       → rshift_assign
"**"                                        → power
"=="                                        → eq
"!="                                        → ne
"<="                                        → le
">="                                        → ge
"&&"                                        → and_sym
"||"                                        → or_sym
"=!"                                        → fixed_assign
"<-"                                        → move_assign
"+="                                        → plus_assign
"-="                                        → minus_assign
"*="                                        → star_assign
"/="                                        → slash_assign
"%="                                        → percent_assign
"&="                                        → amp_assign
"|="                                        → bar_assign
"^="                                        → caret_assign
"->"                                        → arrow
"=>"                                        → fat_arrow
"??"                                        → nullish
".."                                        → dotdot
"<<"                                        → lshift
">>"                                        → rshift

'+'                                         → plus
'-'                                         → minus
'*'                                         → star
'/'                                         → slash
'%'                                         → percent
'<'                                         → lt
'>'                                         → gt
'!'                                         → not_sym
'?'                                         → question
'|'                                         → bar
'&'                                         → ampersand
'^'                                         → caret
'~'                                         → tilde
'@'                                         → at
'='                                         → assign
'('                                         → lparen
')'                                         → rparen
'['                                         → lbracket
']'                                         → rbracket
','                                         → comma
':'                                         → colon
'.'                                         → dot

[a-zA-Z_][a-zA-Z0-9_]*                      → ident

.                                           → err

# ==============================================================================
# PARSER
# ==============================================================================

@parser

# ==============================================================================
# THE SEMANTIC IR
# ==============================================================================
#
# Every node the parser builds, one kind per line with its roles in slot
# order. Nexus checks every action below against this schema (each role
# filled with a value of its declared type, every value-bearing element
# used) and generates the `Tag` and `Role` enums and the `ir` accessors
# the compiler reads the tree with. A node always has all of its slots:
# `_` where an optional role (`?`) is absent. A `...role` takes the
# remaining children. See docs/INTERNALS.md (The semantic IR).
#
# Role types: `leaf` is a name or literal; `group` an untagged list (a
# parameter list); `tag(...)` a marker; `a|b` a node of one of those
# kinds; an untyped role takes a leaf or any node.

@schema
    # Declarations
    module                      ...decls
    use                         name:leaf
    fun                         name:leaf tparams:group? params:group? returns? body:block
    sub                         name:leaf tparams:group? params:group? body:block
    lambda                      captures:captures? params:group? body:block
    struct, enum, errors        name:leaf ...members
    generic_struct, generic_enum name:leaf tparams:group ...members
    type                        name:leaf type
    test                        name:leaf body:block
    pub                         decl:fun|sub|struct|enum|errors|type|generic_struct|generic_enum|test|set
    extern                      name:leaf type
    extern_fun                  name:leaf params:group? returns?
    extern_sub                  name:leaf params:group?
    drop_decl                   params:group body:block
    labeled                     label:leaf stmt

    # Parameters, fields, and enum members
    ":"                         name:leaf type
    default                     name:leaf type value
    valued                      name:leaf value
    variant                     name:leaf params:group

    # Bindings: `op` is the binding kind (see BindingKind in src/rig.zig)
    set                         op:tag(fixed|shadow|move|"+="|"-="|"*="|"/="|"%="|"&="|"|="|"^="|"<<="|">>=")? target type? value
    drop                        name:leaf

    # Control flow
    if                          cond then else?
    as                          value name:leaf
    while                       cond step? body:block else:block?
    for                         mode:tag(iter|read|write|move) var:leaf index:leaf? source body:block else:block?
    match                       subject ...arms:arm
    arm                         pattern body
    range_pattern               lo hi
    variant_pattern             name:leaf ...bindings:leaf
    enum_lit                    name:leaf
    return                      value?
    break                       value? label:leaf?
    continue                    label:leaf?
    defer, errdefer             body
    raw_block                   body:block
    propagate, propagate_none   value
    catch                       value name:leaf? handler
    block                       ...stmts

    # Closures: the Parser wrapper splits a bar list into captures and
    # parameters
    captures                    ...caps:cap_clone|cap_move|cap_weak @wrapper
    cap_clone, cap_move, cap_weak  name:leaf

    # Calls and access
    call                        callee ...args
    builtin                     name:leaf ...args
    member                      object name:leaf
    index                       object index
    inst                        object ...args
    array                       ...elems
    array_fill                  size value
    kwarg                       name:leaf value

    # Operators
    "+", "-", "*", "/", "%"     left right
    "==", "!=", "<", ">", "<=", ">="  left right
    "&", "|", "^", "<<", ">>"   left right
    "??", and, or               left right
    ".."                        left? right?
    neg, not                    operand

    # Ownership sigils (`~T`, `?T`, `!T`, `*T` in type position are the
    # type kinds below, except `weak`, which is both)
    move, read, write, clone, share, weak  operand

    # Types
    optional, error_union, borrow_read, borrow_write, shared, slice  type
    generic_inst                name ...args
    array_type                  size type
    fun_type                    params:group? returns?

@display
    # Tokens by what they read as in a message; every keyword and
    # operator as it is written.
    IDENT: "a name", INTEGER: "an integer", REAL: "a number"
    STRING_SQ: "a string", STRING_DQ: "a string"
    NEWLINE: "the end of the line", INDENT: "an indented block"
    OUTDENT: "the end of the block"
    LPAREN_CALL: "`(`", LBRACKET_INDEX: "`[`"
    POST_IF: "`if`", TERNARY_IF: "`if`"
    BAR_CAPTURE: "`|`", BAR_EMPTY: "`||`", DOT_LIT: "`.`"
    KWARG_NAME: "a keyword argument"
    MOVE_PFX: "`<`", CLONE_PFX: "`+`", READ_PFX: "`?`"
    WRITE_PFX: "`!`", SHARE_PFX: "`*`", DROP_STMT: "`-`", MINUS_PREFIX: "`-`"
    SUFFIX_Q: "`?`", SUFFIX_BANG: "`!`", OF: "`of`", DOTDOT_OPEN: "`..`"
    TRUE: "`true`", FALSE: "`false`", AND: "`and`", AS: "`as`", BREAK: "`break`", CATCH: "`catch`"
    CONTINUE: "`continue`", DEFER: "`defer`", DROP: "`drop`", ELSE: "`else`", ENUM: "`enum`", ERRDEFER: "`errdefer`"
    ERROR: "`error`", EXTERN: "`extern`", FOR: "`for`", FUN: "`fun`", IF: "`if`", IN: "`in`"
    MATCH: "`match`", NEW: "`new`", NOT: "`not`", OR: "`or`", PUB: "`pub`"
    RAW: "`raw`", RETURN: "`return`", STRUCT: "`struct`", SUB: "`sub`", TEST: "`test`", TRY: "`try`"
    TYPE: "`type`", USE: "`use`", WHILE: "`while`", ZIG: "`zig`"
    "=": "`=`", "+=": "`+=`", "-=": "`-=`", "*=": "`*=`", "/=": "`/=`", "%=": "`%=`"
    "&=": "`&=`", "|=": "`|=`", "^=": "`^=`", "<<=": "`<<=`", ">>=": "`>>=`", "=!": "`=!`"
    "<-": "`<-`", ":": "`:`", "->": "`->`", "(": "`(`", ")": "`)`", "[": "`[`"
    "]": "`]`", ",": "`,`", ".": "`.`", "..": "`..`", "=>": "`=>`", "~": "`~`"
    "@": "`@`", "==": "`==`", "!=": "`!=`", "<": "`<`", ">": "`>`", "<=": "`<=`"
    ">=": "`>=`", "??": "`??`", "|": "`|`", "^": "`^`", "&": "`&`", "<<": "`<<`"
    ">>": "`>>`", "+": "`+`", "-": "`-`", "*": "`*`", "/": "`/`", "%": "`%`"

@errors
    stmt: "a statement", block: "an indented block", type: "a type"
    expr: "an expression", tail: "an expression", rhs: "an expression"
    value: "a value"
    field: "a parameter", member: "a member"
    pattern: "a pattern", arm: "a match arm", params: "a parameter list"
    unary: "an operand", step: "an assignment or a call"

# ==============================================================================
# PROGRAM STRUCTURE
# ==============================================================================

name     = IDENT

program! = [decls:body]                             → (module)

body     = stmt                                     → (1)
         | body NEWLINE stmt                        → (...1 3)
         | body NEWLINE                             → 1

block    = INDENT [stmts:body] OUTDENT              → (block)

stmt     = use
         | decl
         | extvar
         | ext_fun
         | ext_sub
         | ":" label:name stmt:stmt                 → (labeled)
         | simple
         | simple POST_IF cond:value                → (if then:(block 1))

# A simple statement: an expression, a paren-free call, a binding, or a
# flow statement. Only these take a postfix guard (`return x if done`).
# A compound assignment's `op` is the tag its operator names (`+=`).
simple   = tail
         | assign
         | target:postfix "=!"  value:rhs           → (set op:fixed)
         | target:postfix "<-"  value:rhs           → (set op:move)
         | target:name ":" type:type "="  value:rhs  → (set)
         | target:name ":" type:type "=!" value:rhs  → (set op:fixed)
         | NEW target:name "=" value:rhs            → (set op:shadow)
         | DROP_STMT name:name                      → (drop)
         | RETURN [value:rhs]                       → (return)
         | BREAK [":" label:name] [value:rhs]       → (break)
         | CONTINUE [":" label:name]                → (continue)
         | DEFER body:(block | simple)              → (defer)
         | ERRDEFER body:(block | simple)           → (errdefer)
         | RAW body:block                           → (raw_block)

assign   = target:postfix "="   value:rhs           → (set)
         | target:postfix
           op:("+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=")
           value:rhs                                → (set)

# ==============================================================================
# DECLARATIONS
# ==============================================================================

decl     = defn
         | PUB decl:defn                            → (pub)
         | PUB decl:const                           → (pub)

# A public module-level constant.
const    = target:name "=!" value:rhs               → (set op:fixed)
         | target:name ":" type:type "=!" value:rhs  → (set op:fixed)

defn     = fun | sub | enum | struct | errors | typedef | test

use      = USE name:name                            → (use)

fun      = FUN name:name [tparams:tparams] [params:params] [returns:returns] body:block → (fun)
sub      = SUB name:name [tparams:tparams] [params:params] body:block → (sub)

returns  = "->" type                                → 2

params   = !lparen fields [","] ")"                 → (...2)
         | !lparen          ")"                     → ()

lparen   = LPAREN_CALL | "("

# Compile-time parameters, in brackets touching the declared name: a
# bare name is a type parameter, `name: Type` a compile-time value.
tparams  = LBRACKET_INDEX tfields [","] "]"         → (...2)

tfields  = tfield                                   → (1)
         | tfields "," tfield                       → (...1 3)

tfield   = name
         | name:name ":" type:type                  → (:)

# Written out rather than `L(field)`, which conflicts with a trailing
# comma.
fields   = field                                    → (1)
         | fields "," field                         → (...1 3)

# Parameters, struct fields, and enum variants share one shape.
field    = fname
         | name:fname ":" type:type                 → (:)
         | name:fname ":" type:type "=" value:expr  → (default)
         | READ_PFX  operand:fname                  → (read)       # `?self`
         | WRITE_PFX operand:fname                  → (write)      # `!self`
         | MOVE_PFX  operand:fname                  → (move)       # `<self`

# Inside ( ) the rewriter turns a name followed by `:` into KWARG_NAME.
fname    = name | KWARG_NAME

enum     = ENUM name:name INDENT members:members OUTDENT     → (enum)
         | ENUM name:name tparams:tparams INDENT members:members OUTDENT
                                                    → (generic_enum)
errors   = ERROR name:name INDENT members:members OUTDENT    → (errors)
struct   = STRUCT name:name INDENT members:members OUTDENT   → (struct)
         | STRUCT name:name tparams:tparams INDENT members:members OUTDENT
                                                    → (generic_struct)

typedef  = TYPE name:name "=" type:type             → (type)

members  = member                                   → (1)
         | members NEWLINE member                   → (...1 3)
         | members NEWLINE                          → 1

member   = field
         | name:name "=" value:expr                 → (valued)     # `ok = 200`
         | name:name params:params                  → (variant)    # `circle(r: Int)`
         | fun
         | sub
         | DROP params:params body:block            → (drop_decl)  # `drop(!self)`

test     = TEST name:(STRING_DQ | STRING_SQ) body:block → (test)

extvar   = EXTERN name:name ":" type:type           → (extern)

ext_fun  = EXTERN FUN name:name [params:params] [returns:returns] → (extern_fun)
ext_sub  = EXTERN SUB name:name [params:params]     → (extern_sub)

# ==============================================================================
# TYPES
# ==============================================================================
#
# The handle sigils `*` and `~` bind to the type they touch, tighter than
# the suffixes: `*User?` is an optional shared handle, and a handle to an
# optional is `*(User?)`. A borrow applies to the whole type after it,
# suffixes included: `?User?` borrows an optional User. The element of a
# slice or array takes the suffixes too (`[]Int?`), and a function type
# takes none, so an optional of one is written in parentheses.

type     = READ_PFX  type:type                      → (borrow_read)
         | WRITE_PFX type:type                      → (borrow_write)
         | ptype
         | tsuffix

# A prefix type that takes no suffix, alone or behind handles.
ptype    = "[" "]" type:inner                       → (slice)
         | "[" size:dim "]" type:inner              → (array_type)
         | FUN "(" [params:L(type)] ")" "->" returns:type → (fun_type)  # `fun(Int) -> Int`
         | SUB "(" [params:L(type)] ")"             → (fun_type)   # `sub(Int)`
         | SHARE_PFX type:ptype                     → (shared)     # `*fun(Int) -> Int`
         | "~"       operand:ptype                  → (weak)

# An element type after `[]` or `[N]`. A nested prefix's `[` touches the
# `]` before it, so the lexer marks it as an index bracket.
inner    = type
         | LBRACKET_INDEX "]" type:inner             → (slice)
         | LBRACKET_INDEX size:dim "]" type:inner    → (array_type)

tsuffix  = type:tsuffix SUFFIX_Q                    → (optional)
         | type:tsuffix SUFFIX_BANG                 → (error_union)
         | thandle

thandle  = SHARE_PFX type:thandle                   → (shared)
         | "~"       operand:thandle                → (weak)
         | tatom

tatom    = tname
         | name:tname LBRACKET_INDEX args:types [","] "]" → (generic_inst)
         | "(" type ")"                             → 2
         | LPAREN_CALL type ")"                     → 2      # `[2](N?)?`: touching `]`

# A named type, of this module or another: `Point`, `geo.Point`. Its
# instance names it the same way: `Wrap[Int]`, `lib.Wrap[Int]`.
tname    = name
         | object:name "." name:name                → (member)

# Compile-time arguments; written out rather than `L(targ)`, which
# conflicts with a trailing comma.
types    = targ                                     → (1)
         | types "," targ                           → (...1 3)

# A compile-time argument in a type: a type, or a compile-time integer.
# A bare name is read as a type; the checker reads it as a value where
# the parameter is one. An integer or arithmetic is always a value.
targ     = type
         | INTEGER
         | MINUS_PREFIX operand:INTEGER             → (neg)
         | "(" INTEGER ")"                          → 2
         | cexp

# An array size: an integer, a name (a constant or a compile-time
# parameter), a module's constant, or arithmetic on them, any of them
# in parentheses. A negative integer parses, to be reported as out of
# range.
dim      = INTEGER
         | MINUS_PREFIX operand:INTEGER             → (neg)
         | "(" INTEGER ")"                          → 2
         | name
         | "(" name ")"                             → 2
         | object:name "." name:name                → (member)
         | cexp

# Arithmetic on compile-time integers, with at least one operator, so
# that a bare name stays a type. Operands are integers, names, module
# constants, and parenthesized arithmetic.
cexp     = cmulop
         | caddop
         | "(" cexp ")"                             → 2
caddop   = left:cadd "+" right:cmul                 → (+)
         | left:cadd "-" right:cmul                 → (-)
cadd     = caddop
         | cmul
cmulop   = left:cmul "*" right:cunit                → (*)
         | left:cmul "/" right:cunit                → (/)
         | left:cmul "%" right:cunit                → (%)
cmul     = cmulop
         | cunit
cunit    = INTEGER
         | name
         | object:name "." name:name                → (member)
         | "(" cexp ")"                             → 2

# ==============================================================================
# EXPRESSIONS
# ==============================================================================
#
#   tail    an expression, a paren-free call, or a closure whose body is one:
#           a statement or a match arm. A paren-free call is a command,
#           never a value.
#   rhs     an expression, or a closure whose body is a paren-free call:
#           the right side of a binding, `return` and `break`. Inside ( )
#           only this closure may appear (`cclosure`).
#   expr    anything that yields a value, including block forms.
#   value   an expression without a block or closure: conditions, sources,
#           subjects, operands, ternary branches.

tail     = expr
         | cmd
         | cclosure

rhs      = expr
         | cclosure

expr     = value
         | if
         | while
         | for
         | match
         | value:logic CATCH BAR_CAPTURE name:name BAR_CAPTURE handler:block → (catch)
         | closure

value    = then:logic TERNARY_IF cond:logic ELSE else:value → (if)
         | value:logic CATCH [BAR_CAPTURE name:name BAR_CAPTURE] handler:value → (catch)
         | logic

logic    = left:logic OR right:conj                 → (or)
         | conj
conj     = left:conj AND right:neg                  → (and)
         | neg
neg      = NOT operand:neg                          → (not)
         | @infix

# --- Paren-free calls ---------------------------------------------------------
#
# `print p.x` is print(p.x); `send encode <packet` is send(encode(<packet)).
# A paren-free call is a command: a statement, a match arm, a closure
# body, or the last argument of another paren-free call. Anywhere a
# value is expected, a call takes parentheses. A leading `!` or `<` is
# the receiver's mode, which the Parser wrapper moves onto the receiver:
# `!v.push 3`.

cmd      = callee:postfix args:cmdargs              → (call)
         | WRITE_PFX operand:cmd                    → (write)
         | MOVE_PFX  operand:cmd                    → (move)

# These argument lists are written out rather than `L(expr)`:
# `L(expr) "," cmdtail` conflicts on the comma.
cmdargs  = exprs                                    → 1
         | exprs "," cmdtail                        → (...1 3)
         | cmdtail                                  → (1)

exprs    = expr                                     → (1)
         | exprs "," expr                           → (...1 3)

cmdtail  = cmd
         | cclosure

# --- Control flow -------------------------------------------------------------

# `if e as name` / `while e as name`: `e` is an optional; the body runs
# with `name` bound to the value inside it.
ifcond   = value
         | value:value AS name:name                 → (as)

if       = IF cond:ifcond then:block [ELSE else:block] → (if)
         | IF cond:ifcond then:block ELSE else:if   → (if)

while    = WHILE cond:ifcond [":" step:step] body:block [ELSE else:block] → (while)

# A `while` step runs after each iteration: an assignment, or a call,
# which may propagate its failure (the checker rejects other forms). A
# call's receiver may take `!` or `<` (see the Parser wrapper).
step     = assign
         | postfix
         | WRITE_PFX operand:postfix                → (write)
         | MOVE_PFX  operand:postfix                → (move)

# The Parser wrapper moves a `?xs` / `!xs` / `<xs` source sigil into the
# mode slot.
for      = FOR var:name ["," index:name] IN source:value body:block [ELSE else:block]
                                                    → (for mode:iter)

match    = MATCH subject:value INDENT arms:arms OUTDENT → (match)

arms     = arm                                      → (1)
         | arms NEWLINE arm                         → (...1 3)
         | arms NEWLINE                             → 1

arm      = pattern:pattern "=>" body:simple         → (arm)
         | pattern:pattern body:block               → (arm)

pattern  = patatom
         | lo:patatom ".." hi:patatom               → (range_pattern)

patatom  = name
         | INTEGER
         | MINUS_PREFIX operand:INTEGER             → (neg)
         | TRUE
         | FALSE
         | DOT_LIT name:name                        → (enum_lit)
         | DOT_LIT name:name LPAREN_CALL ")"        → (variant_pattern)
         | DOT_LIT name:name LPAREN_CALL bindings:names [","] ")" → (variant_pattern)

# Written out rather than `L(name)`, which conflicts with a trailing
# comma.
names    = name                                     → (1)
         | names "," name                           → (...1 3)

# --- Closures -----------------------------------------------------------------
#
# A closure starts with its bar list. An entry with a sigil is a capture;
# a bare name is a parameter, optionally typed:
#   |+x| clone (a copy, for a Copy value)   |<x| move   |~x| weak
#   |a, b| a + b      |+v, a: Int| v.set(a)      || print("tick")
# `*` before the bars makes an owned closure: `*|+v, a| v.set(a)`. The
# grammar puts every entry in `params`; the Parser wrapper moves the
# captures into `(captures ...)`.

closure  = lambda
         | SHARE_PFX operand:lambda                 → (share)

lambda   = params:bars body:block                   → (lambda)
         | params:bars expr                         → (lambda body:(block 2))

# A closure whose inline body is a paren-free call.
cclosure = clambda
         | SHARE_PFX operand:clambda                → (share)

clambda  = params:bars cmd                          → (lambda body:(block 2))

bars     = BAR_CAPTURE barents [","] BAR_CAPTURE    → (...2)
         | BAR_EMPTY                                → ()

barents  = barent                                   → (1)
         | barents "," barent                       → (...1 3)

barent   = fname
         | name:fname ":" type:type                 → (:)
         | CLONE_PFX name:name                      → (cap_clone)
         | MOVE_PFX  name:name                      → (cap_move)
         | "~"       name:name                      → (cap_weak)


# ==============================================================================
# OPERANDS
# ==============================================================================

unary    = MINUS_PREFIX operand:unary               → (neg)
         | MOVE_PFX  operand:unary                  → (move)
         | CLONE_PFX operand:unary                  → (clone)
         | READ_PFX  operand:unary                  → (read)
         | WRITE_PFX operand:unary                  → (write)
         | SHARE_PFX operand:unary                  → (share)
         | "~"       operand:unary                  → (weak)
         | postfix

postfix  = object:postfix "." name:name             → (member)
         | object:postfix LBRACKET_INDEX index:expr "]" → (index)
         | object:postfix LBRACKET_INDEX index:open "]" → (index)
         | object:postfix LBRACKET_INDEX args:targs "]" → (inst)
         | callee:postfix LPAREN_CALL args:args ")" → (call)
         | value:postfix SUFFIX_BANG                → (propagate)
         | value:postfix SUFFIX_Q                   → (propagate_none)
         | atom

# A slice's open range: `xs[a..]`, `xs[..b]`, `xs[..]`. The rewriter
# marks a `..` whose next token is `]` as DOTDOT_OPEN, so `xs[a == b..]`
# ends the expression before it; a `..` that starts an operand needs no
# mark, since no expression starts with one.
open     = left:expr DOTDOT_OPEN                    → (..)
         | ".." right:expr                          → (..)
         | DOTDOT_OPEN                              → (..)

args     = callargs                                 → 1
         | callargs ","                             → 1
         | callargs "," cclosure                    → (...1 3)
         | cclosure                                 → (1)
         |                                          → ()

# Two or more compile-time arguments (`Pair[Int, String]`); sema reads
# one (`Vec[Int]`, an `index`) as compile-time arguments or an index by
# what the object names.
targs    = expr ","                                 → (1)
         | expr "," expr                            → (1 3)
         | expr "," targs                           → (1 ...3)

callargs = callarg                                  → (1)
         | callargs "," callarg                     → (...1 3)

callarg  = name:KWARG_NAME ":" value:expr           → (kwarg)
         | expr

atom     = name
         | INTEGER
         | REAL
         | STRING_SQ
         | STRING_DQ
         | TRUE
         | FALSE
         | DOT_LIT name:name                        → (enum_lit)
         | "@" name:name LPAREN_CALL args:args ")"  → (builtin)
         | "[" [elems:exprs] "]"                    → (array)
         | "[" elems:exprs "," "]"                  → (array)
         | "[" size:expr OF value:expr "]"          → (array_fill)  # `[n of 0]`
         | "(" expr ")"                             → 2
         | "(" cclosure ")"                         → 2

# ==============================================================================
# INFIX OPERATORS (lowest precedence first; operands are `unary`)
# ==============================================================================

@infix unary
    "==" none, "!=" none, "<" none, ">" none, "<=" none, ">=" none
    "??" right
    ".." none
    "|"  left
    "^"  left
    "&"  left
    "<<" left, ">>" left
    "+"  left, "-"  left
    "*"  left, "/"  left, "%"  left
