#!/usr/bin/env python3
"""tools/emit-diff [--keep] [--rig PATH] BASE: whether the current bin/rig
emits the same Zig as a rig built at commit BASE (tools/baseline BASE).

Each program is emitted twice, with `rig emit` and a temp RIG_OUT_DIR,
which receives every module's Zig and the runtime: examples/*.rig, every
Rig program under bench/, a program that uses every std module (those at
both commits), and Trig (its src/ with tools/trig/main.rig, copied from
$TRIG, default ~/Data/Code/trig, which is only read; skipped when absent).
The sources are this checkout's for both compilers, and neither reads
RIG_STD. Prints `identical`, or each file that differs with its lines
added and removed (a runtime file once, for every program that carries
it) and the directory holding both emits. Exits 0 when identical, 1 when
not, 2 on a usage error or a failed baseline build.
"""

import argparse
import concurrent.futures
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)


def programs(work, base_sha):
    """(label, directory, file) for each program to emit."""
    out = []
    for name in sorted(os.listdir(os.path.join(ROOT, "examples"))):
        if name.endswith(".rig"):
            out.append(("examples/" + name, os.path.join(ROOT, "examples"), name))
    for dirpath, dirs, files in sorted(os.walk(os.path.join(ROOT, "bench"))):
        dirs.sort()
        for name in sorted(files):
            if name.endswith(".rig"):
                rel = os.path.relpath(os.path.join(dirpath, name), ROOT)
                out.append((rel, dirpath, name))
    # Every std module both commits have.
    here = {n[:-4] for n in os.listdir(os.path.join(ROOT, "std")) if n.endswith(".rig")}
    listed = subprocess.run(["git", "-C", ROOT, "ls-tree", "--name-only", base_sha, "std/"], capture_output=True, text=True, check=True).stdout
    there = {os.path.basename(p)[:-4] for p in listed.split() if p.endswith(".rig")}
    mods = sorted(m for m in here & there if not m.startswith("__"))
    std_dir = os.path.join(work, "std")
    os.makedirs(std_dir)
    with open(os.path.join(std_dir, "all.rig"), "w") as f:
        f.write("".join("use std.%s\n" % m for m in mods) + "\nsub main()\n  print(%d)\n" % len(mods))
    out.append(("std (%d modules)" % len(mods), std_dir, "all.rig"))
    trig = os.environ.get("TRIG", os.path.expanduser("~/Data/Code/trig"))
    main = os.path.join(trig, "tools", "trig", "main.rig")
    if os.path.isfile(main) and os.path.isdir(os.path.join(trig, "src")):
        trig_dir = os.path.join(work, "trig")
        shutil.copytree(os.path.join(trig, "src"), trig_dir)
        shutil.copy(main, os.path.join(trig_dir, "main.rig"))
        out.append(("trig", trig_dir, "main.rig"))
    else:
        print("emit-diff: no Trig at %s (set TRIG); skipped" % trig, file=sys.stderr)
    return out


def slug(label):
    """A program's directory in the work directory: `bench_json_checks_probe.rig`."""
    return label.split(" ")[0].replace("/", "_")


def emit(rig, label, cwd, name, out):
    env = {k: v for k, v in os.environ.items() if k not in ("RIG_STD", "RIG_BUILD_STORE")}
    env["RIG_OUT_DIR"] = out
    env["RIG_NO_CRASH_REPORT"] = "1"
    p = subprocess.run([rig, "emit", name], cwd=cwd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    err = "" if p.returncode == 0 else p.stderr.replace(out, "OUT")
    return label, p.returncode, err


def files(top):
    found = {}
    for dirpath, _, names in os.walk(top):
        for n in names:
            path = os.path.join(dirpath, n)
            with open(path, "rb") as f:
                found[os.path.relpath(path, top)] = hashlib.sha256(f.read()).hexdigest()
    return found


def stat(a, b):
    """Lines added and removed from file a to file b (either may be None)."""
    p = subprocess.run(["diff", a or "/dev/null", b or "/dev/null"], capture_output=True, text=True, errors="replace")
    lines = p.stdout.splitlines()
    return sum(1 for l in lines if l.startswith(">")), sum(1 for l in lines if l.startswith("<"))


def main():
    ap = argparse.ArgumentParser(prog="tools/emit-diff", description=__doc__.split("\n\n")[0])
    ap.add_argument("base", help="the commit to compare with (a hash, branch, or origin/main)")
    ap.add_argument("--rig", default=os.path.join(ROOT, "bin", "rig"), help="the rig under test (default: this checkout's bin/rig)")
    ap.add_argument("--keep", action="store_true", help="keep the emitted Zig even when it is identical")
    a = ap.parse_args()
    if not os.access(a.rig, os.X_OK):
        sys.exit("emit-diff: no rig at %s: run zig build" % a.rig)
    sha = subprocess.run(["git", "-C", ROOT, "rev-parse", "--verify", "--quiet", a.base + "^{commit}"], capture_output=True, text=True).stdout.strip()
    if not sha:
        print("emit-diff: no commit `%s`" % a.base, file=sys.stderr)
        sys.exit(2)
    b = subprocess.run([os.path.join(HERE, "baseline"), sha], stdout=subprocess.PIPE, text=True)
    if b.returncode != 0:
        sys.exit(2)
    base_rig = b.stdout.strip()

    work = tempfile.mkdtemp(prefix="rig-emit-diff.")
    progs = programs(work, sha)
    sides = {"base": base_rig, "cur": a.rig}
    status = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        jobs = []
        for label, cwd, name in progs:
            for side, rig in sides.items():
                out = os.path.join(work, side, slug(label))
                jobs.append((side, pool.submit(emit, rig, label, cwd, name, out)))
        for side, job in jobs:
            label, code, err = job.result()
            status[(side, label)] = (code, err)

    differ = []  # (shown path, added, removed)
    programs_differ = set()
    runtime = {}  # runtime path -> {(base hash, cur hash): [labels]}
    total = 0
    for label, _, _ in progs:
        (bc, be), (cc, ce) = status[("base", label)], status[("cur", label)]
        if bc or cc:
            if (bc, be) != (cc, ce):
                programs_differ.add(label)
                for side, (code, err) in (("base", (bc, be)), ("cur", (cc, ce))):
                    if code:
                        first = next((l for l in err.splitlines() if "error" in l), err.strip()[:200])
                        differ.append(("%s: emit fails with %s: %s" % (label, side, first), 0, 0))
            continue
        bd, cd = os.path.join(work, "base", slug(label)), os.path.join(work, "cur", slug(label))
        bf, cf = files(bd), files(cd)
        total += len(set(bf) | set(cf))
        for rel in sorted(set(bf) | set(cf)):
            if bf.get(rel) == cf.get(rel):
                continue
            programs_differ.add(label)
            if rel.startswith("rig" + os.sep):
                key = (bf.get(rel), cf.get(rel))
                if rel not in runtime or key not in runtime[rel]:
                    runtime.setdefault(rel, {})[key] = (bd if rel in bf else None, cd if rel in cf else None, [])
                runtime[rel][key][2].append(label)
                continue
            added, removed = stat(os.path.join(bd, rel) if rel in bf else None, os.path.join(cd, rel) if rel in cf else None)
            differ.append(("%s: %s" % (label, rel), added, removed))
    for rel, versions in sorted(runtime.items()):
        for (bh, ch), (bd, cd, labels) in versions.items():
            added, removed = stat(os.path.join(bd, rel) if bd else None, os.path.join(cd, rel) if cd else None)
            differ.append(("%s (in %d programs)" % (rel, len(labels)), added, removed))

    names = "rig at %s and %s" % (sha[:12], os.path.relpath(a.rig, os.getcwd()) if a.rig.startswith(ROOT) else a.rig)
    if not differ:
        print("emit-diff: identical: %d programs, %d files, %s" % (len(progs), total, names))
        if a.keep:
            print("emit-diff: the emitted Zig is in %s/base and %s/cur" % (work, work))
        else:
            shutil.rmtree(work, ignore_errors=True)
        return 0
    print("emit-diff: differs in %d of %d programs, %s:" % (len(programs_differ), len(progs), names))
    width = max([len(d[0]) for d in differ if d[1] or d[2]] or [0])
    for shown, added, removed in differ:
        print("  %-*s  +%d -%d" % (width, shown, added, removed) if added or removed else "  " + shown)
    print("emit-diff: the emitted Zig is in %s/base and %s/cur (a directory per program)" % (work, work))
    return 1


if __name__ == "__main__":
    sys.exit(main())
