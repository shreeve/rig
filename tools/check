#!/usr/bin/env bash
# tools/check: a quick local sample of the test suite, run on this Mac, as
# a sniff test before a push.
#
#   tools/check N [--matrix] [--slice I]
#
# N is the share of the suite to sample, in percent, 1 to 100: the suite
# splits into K = 100/N equal parts, rounded to a whole number (5 is 20
# parts of about 200 tests, 1 is 100 parts of about 40, 30 is 3 parts), and
# one part runs. When K parts are not exactly N%, it says what share ran.
#
# It runs two things, each through the Mac's job queue (cpuq run --local
# --cores 2-6), each with --delta, so a program that passed before with
# the same inputs is checked but not run again:
#
#   1. The whole-program checks, every time: oracle (the reference
#      ownership checker over its sets, which also finds a test missing
#      from test/oracle/rejections), classify, vocab and style, about 15
#      seconds in all. With them, the branch's own tests, in full: every
#      test the branch adds or
#      changes since the merge-base with origin/main (working-tree changes
#      and new files included), found by test id from the files the diff
#      touches (test/behavior, reject, known, ir, torture, cli, corpus,
#      examples/), and every doc example of a Markdown file whose ```rig
#      blocks changed (ids doc/<file>/L<line>, run as the whole file). A
#      change to test/cli/_*.sh, which every CLI test shares, runs them all.
#   2. One random slice of the suite, `./test/run --delta --shard I/K` with
#      I chosen at random, so repeated checks cover more over time. Slice 1
#      also runs the unit tests.
#
# --matrix adds the same slice of the generated grids
# (test/matrix.py --delta --shard I/K).
# --slice I picks the slice instead of choosing it at random (1 <= I <= K).
#
# The report gives the passed and failed counts of each run, the slice that
# ran, and a one-line command that reruns just the failures. The exit
# status is 1 if anything failed, 2 on a usage error. Each phase's
# wall-clock time is printed as it ends. It never touches the network
# except for one `git fetch` of origin/main.
# (bash 3.2, as macOS ships it.)
set -uo pipefail

MATRIX="" SLICE="" N=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --matrix) MATRIX=1 ;;
        --slice) [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || { echo "tools/check: --slice takes a slice's number" >&2; exit 2; }
            SLICE=$2; shift ;;
        -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
        -*) echo "tools/check: unknown option $1 (see --help)" >&2; exit 2 ;;
        *) [[ -z $N ]] || { echo "tools/check: one N only (see --help)" >&2; exit 2; }
            N=$1 ;;
    esac
    shift
done
[[ $N =~ ^[0-9]+$ ]] || { echo "tools/check: needs N, a percent from 1 to 100 (see --help)" >&2; exit 2; }

# N → the number of slices K, the nearest whole number to 100/N.
(( N >= 1 && N <= 100 )) || { echo "tools/check: N is a percent, 1 to 100" >&2; exit 2; }
K=$(( (200 + N) / (2 * N) ))
BEST=$(( (100 + K / 2) / K ))
[[ $BEST -eq $N ]] || echo "check: $N% of the suite is $K slices of about $BEST% each; running one"
if [[ -n $SLICE ]]; then
    [[ $SLICE -le $K ]] || { echo "tools/check: --slice takes 1 to $K for $N%" >&2; exit 2; }
    I=$SLICE
else
    I=$((RANDOM % K + 1))
fi

START=$(date +%s)
LAST=$START
# phase <what>: print the time since the last phase and since the start.
phase() {
    local now
    now=$(date +%s)
    printf 'check: %-46s %5ss  (%ss in all)\n' "$1" $((now - LAST)) $((now - START))
    LAST=$now
}
die() { echo "tools/check: $*" >&2; exit 1; }

cd "$(git rev-parse --show-toplevel)" || die "not in a git worktree"
for tool in cpuq python3; do
    command -v "$tool" >/dev/null || die "needs $tool"
done

WORK=$(mktemp -d "${TMPDIR:-/tmp}/rig-check.XXXXXX") || die "cannot make a temporary directory"
trap 'rm -rf "$WORK"' EXIT
trap 'exit 130' INT TERM

# --- The branch's own tests ----------------------------------------------

REMOTE=${CHECK_REMOTE:-origin}
git fetch -q "$REMOTE" main 2>/dev/null || echo "check: cannot fetch $REMOTE main; using the last one fetched"
BASE=$(git merge-base "$REMOTE/main" HEAD) || die "no merge-base with $REMOTE/main"

# Everything the branch adds or changes: committed, staged, or not, and
# new files; deletions have no test left to run.
{ git diff --name-only --diff-filter=d "$BASE" --; git ls-files -o --exclude-standard; } | sort -u >"$WORK/changed"

# The ids those files name. A test is test/<kind>/<area>/<name>.rig or a
# directory <name>/ of files; the filters are substrings of ids, so an id
# selects its test (and any whose id it starts), as ./test/run does.
: >"$WORK/ids"
ALL_CLI=""
while IFS= read -r f; do
    case $f in
        test/behavior/*|test/reject/*|test/known/*)
            IFS=/ read -r -a p <<<"$f"
            if [[ ${#p[@]} -eq 4 && ${p[3]} == *.rig ]]; then echo "${p[1]}/${p[2]}/${p[3]%.rig}"
            elif [[ ${#p[@]} -ge 5 ]]; then echo "${p[1]}/${p[2]}/${p[3]}"; fi ;;
        test/ir/*.rig) b=${f#test/ir/}; echo "ir/${b%.rig}" ;;
        test/ir/*.sexp) b=${f#test/ir/}; echo "ir/${b%%.*}" ;;
        test/torture/*.rig) b=${f#test/torture/}; echo "torture/${b%.rig}" ;;
        test/cli/_*) ALL_CLI=1 ;;
        test/cli/*.sh) b=${f#test/cli/}; echo "cli/${b%.sh}" ;;
        test/corpus/*)
            IFS=/ read -r -a p <<<"$f"
            if [[ ${#p[@]} -eq 3 && ${p[2]} == *.rig ]]; then echo "corpus/${p[2]%.rig}"
            elif [[ ${#p[@]} -ge 4 ]]; then echo "corpus/${p[2]}"; fi ;;
        examples/*.rig) b=${f#examples/}; [[ $b == */* ]] || echo "examples/${b%.rig}" ;;
    esac
done <"$WORK/changed" >>"$WORK/ids"
[[ -z $ALL_CLI ]] || echo cli >>"$WORK/ids"

# A Markdown file whose ```rig examples changed: a fence line added or
# removed, or an added line inside a rig example or its output/error/facts
# block. test/run names an example doc/<file>/L<line> (the file without
# .md or a docs/ prefix, / as -); lines move, so the whole file is run.
python3 -I - "$BASE" "$WORK/changed" >>"$WORK/ids" <<'PY'
import re, subprocess, sys

base, listing = sys.argv[1], sys.argv[2]
tracked = set(subprocess.run(["git", "ls-files"], capture_output=True, text=True).stdout.split("\n"))
for path in open(listing).read().split("\n"):
    # The doc files test/run reads: *.md, docs/*.md, examples/*.md, test/*.md, formal/docs/*.md.
    if not re.fullmatch(r"([^/]+|docs/[^/]+|examples/[^/]+|test/[^/]+|formal/docs/[^/]+)\.md", path):
        continue
    try:
        new = open(path, encoding="utf-8").read().split("\n")
    except OSError:
        continue
    # Lines inside a rig example or the block that follows it.
    inside, i = set(), 0
    while i < len(new):
        if re.match(r"```rig([ \t]|$)", new[i]):
            start = i
            i += 1
            while i < len(new) and new[i] != "```":
                i += 1
            end = i
            j = end + 1
            while j < len(new) and new[j].strip() == "":
                j += 1
            if j < len(new) and new[j] in ("```output", "```error", "```facts"):
                j += 1
                while j < len(new) and new[j] != "```":
                    j += 1
                end = j
            inside.update(range(start + 1, end + 2))
            i = end
        i += 1
    hit = False
    if path not in tracked:
        hit = bool(inside)
    else:
        diff = subprocess.run(["git", "diff", "-U0", base, "--", path], capture_output=True, text=True).stdout
        line = 0
        for d in diff.split("\n"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", d)
            if m:
                line = int(m[1])
            elif d.startswith("+") and not d.startswith("+++"):
                hit = hit or line in inside or d.startswith("+```")
                line += 1
            elif d.startswith("-") and not d.startswith("---"):
                hit = hit or d.startswith("-```")
    if hit:
        name = path[:-3]
        if name.startswith("docs/"):
            name = name[5:]
        print("doc/%s/" % name.replace("/", "-"))
PY
sort -u "$WORK/ids" -o "$WORK/ids"

# The shell and matrix commands run under cpuq with its grant of cores.
# run_job <log> <label> <script> [args...]: bash runs the script with the
# args as "$@" under cpuq; its output goes to the log as well as the
# screen, and its status is returned.
# --local keeps the run on this Mac; drop it once cpuq places hosts itself.
CPUQ_RUN="cpuq run --local --cores 2-6"
run_job() {
    local log=$1 label=$2 script=$3
    shift 3
    $CPUQ_RUN --label "rig:$label" -- bash -c "$script" _ "$@" 2>&1 | tee "$log"
    return "${PIPESTATUS[0]}"
}

PASSED=0 FAILED=0 BROKEN=0
RERUN_TESTS="" RERUN_CELLS=""
# summarize <log> <status> <what> <what-it-ran>: add a run's counts.
summarize() {
    local log=$1 status=$2 what=$3 line p f
    line=$(sed -E 's/\x1b\[[0-9;]*m//g' "$log" | grep -E '^[0-9]+ passed|^[0-9]+ programs ' | tail -1)
    if [[ $line =~ ^([0-9]+)\ passed.*,\ ([0-9]+)\ failed ]]; then
        p=${BASH_REMATCH[1]} f=${BASH_REMATCH[2]}
    elif [[ $line =~ ^[0-9]+\ programs.*:\ ([0-9]+)\ ran\ clean.*,\ ([0-9]+)\ rejected,\ ([0-9]+)\ failed ]]; then
        p=$((BASH_REMATCH[1] + BASH_REMATCH[2])) f=${BASH_REMATCH[3]}
    else
        # No count: it never got to report (a build failure, a usage error, a queue timeout).
        if [[ $status -ne 0 ]]; then BROKEN=$((BROKEN + 1)); echo "check: $what did not finish (exit $status)"; fi
        return
    fi
    PASSED=$((PASSED + p))
    FAILED=$((FAILED + f))
    [[ $status -eq 0 || $f -gt 0 ]] || { BROKEN=$((BROKEN + 1)); echo "check: $what exited $status"; }
}
# failing_tests <log>: the ids test/run reported failing, one a line.
failing_tests() { sed -E 's/\x1b\[[0-9;]*m//g' "$1" | sed -nE 's/^  (FAIL|FIXED) +([^ ]+) .*/\2/p'; }
failing_cells() { sed -nE 's/^fail +([^ ]+) .*/\1/p' "$1"; }

# 1. The whole-program checks and the branch's own tests. The checks are
# bare kind names, so a branch id that matches no test is not an error.
IDS=(oracle classify vocab style)
if [[ -s $WORK/ids ]]; then
    while IFS= read -r id; do IDS+=("$id"); done <"$WORK/ids"
    echo "check: the whole-program checks and the branch's tests: ${IDS[*]:4}"
else
    echo "check: the whole-program checks; the branch changes no test or doc example"
fi
run_job "$WORK/branch.log" check-branch './test/run --delta -j "$CPUQ_CORES" "$@"' "${IDS[@]}"
status=$?
summarize "$WORK/branch.log" $status "the whole-program checks and the branch's tests"
RERUN_TESTS=$(failing_tests "$WORK/branch.log" | tr '\n' ' ')
phase "the whole-program checks and the branch's tests"

# 2. One slice of the suite.
echo "check: slice $I/$K"
run_job "$WORK/slice.log" check-slice './test/run --delta -j "$CPUQ_CORES" --shard "$1"' "$I/$K"
status=$?
summarize "$WORK/slice.log" $status "slice $I/$K"
RERUN_TESTS="$RERUN_TESTS$(failing_tests "$WORK/slice.log" | tr '\n' ' ')"
phase "slice $I/$K of the suite"

# 3. The same slice of the matrix.
if [[ -n $MATRIX ]]; then
    run_job "$WORK/matrix.log" check-matrix 'test/matrix.py --delta -j "$CPUQ_CORES" --shard "$1"' "$I/$K"
    status=$?
    summarize "$WORK/matrix.log" $status "matrix slice $I/$K"
    RERUN_CELLS=$(failing_cells "$WORK/matrix.log" | sed 's/^/-k /' | tr '\n' ' ')
    phase "slice $I/$K of the matrix"
fi

# --- Report ---------------------------------------------------------------

WHAT="slice $I/$K"
[[ -z $MATRIX ]] || WHAT="$WHAT, with the matrix"
WHAT="$WHAT; the whole-program checks"
echo
RERUN_TESTS=$(printf '%s\n' $RERUN_TESTS | sort -u | tr '\n' ' ')
if [[ $FAILED -eq 0 && $BROKEN -eq 0 ]]; then
    echo "check: $PASSED passed, 0 failed ($WHAT; the branch's tests in full)"
    exit 0
fi
echo "check: $PASSED passed, $FAILED failed ($WHAT; the branch's tests in full)"
RERUN=""
if [[ -n ${RERUN_TESTS// /} ]]; then
    RERUN="$CPUQ_RUN -- bash -c './test/run --delta -j \"\$CPUQ_CORES\" \"\$@\"' _ ${RERUN_TESTS% }"
    echo "rerun the failures:  $RERUN"
fi
if [[ -n ${RERUN_CELLS// /} ]]; then
    echo "rerun the matrix failures:  $CPUQ_RUN -- bash -c 'test/matrix.py --delta -j \"\$CPUQ_CORES\" \"\$@\"' _ ${RERUN_CELLS% }"
fi
[[ -n $RERUN$RERUN_CELLS || $BROKEN -eq 0 ]] || echo "rerun:  tools/check $N --slice $I"
exit 1
