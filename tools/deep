#!/usr/bin/env bash
# tools/deep: the deep gate. Test main's head on burst, all of it, and
# post the verdict to GitHub as the commit status `rig/deep` on that
# commit.
#
#   tools/deep [--force] [--dry-run]
#   tools/deep --bisect [SHA] [--dry-run] [-- ID...]
#
# Pull requests are gated alone, and only some of them (tools/gate); this
# tests what merged, together. It runs from a clean worktree of its own,
# DEEP_WORKTREE (default ~/Data/Code/worktrees/rig/deep-main), made on its
# first run and reset hard to origin/main on every run, so what burst
# tests is exactly main's head, whichever worktree it is started from.
# It submits the suite, the corpus and the full matrix (cpuq/suite.json,
# corpus.json, matrix.json, with no filter) with the note "deep <sha>",
# lets every one finish, and posts `success` on the commit when all pass,
# `failure` when a test fails, `error` when a job could not finish. A pass
# moves the tag `deep-green` to the commit, here and on GitHub. A failure
# keeps the failing test ids and matrix cells for --bisect.
#
# It exits at once when main's head is the commit the last deep run
# passed or failed (a run that ended in `error` is tried again), or when
# another deep run or bisect holds the lock; --force runs it anyway.
# It runs when Steve asks, by hand; nothing starts it on a schedule.
#
# --bisect finds the merge that broke a red run: `git bisect --first-parent`
# between SHA (default: the last run, if it failed) and `deep-green`, in
# the deep worktree, rerunning at each step only the tests that failed
# (cpuq submit cpuq/suite.json -- ID...) and the matrix cells (matrix.json
# -- -k CELL...). IDs after -- replace the failing tests. A step whose
# tests do not exist yet at that commit counts as good; one whose jobs
# could not finish is skipped. It ends with the worktree back on
# origin/main and prints the first bad merge.
#
# --dry-run says what it would do, and submits, posts, and tags nothing.
#
# DEEP_REMOTE names the remote of the GitHub repository (default origin).
# It keeps its state in the repository's git directory, rig-deep/: the
# last run (`last`: sha, time, verdict), one line per run (`history`),
# and each failed run's logs and failing ids (runs/<sha>/).
# (bash 3.2, as macOS ships it.)
set -uo pipefail

FORCE="" DRY="" BISECT="" RED="" IDS_GIVEN=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --force) FORCE=1 ;;
        --dry-run) DRY=1 ;;
        --bisect) BISECT=1
            if [[ ${2:-} =~ ^[0-9a-f]{7,40}$ ]]; then RED=$2; shift; fi ;;
        --) shift; IDS_GIVEN=("$@"); break ;;
        -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
        *) echo "tools/deep: unknown option $1 (see --help)" >&2; exit 2 ;;
    esac
    shift
done
[[ -n $BISECT || ${#IDS_GIVEN[@]} -eq 0 ]] || { echo "tools/deep: test ids go with --bisect" >&2; exit 2; }

START=$(date +%s)
LAST_PHASE=$START
# phase <what>: print the time since the last phase and since the start.
phase() {
    local now
    now=$(date +%s)
    printf 'deep: %-46s %5ss  (%ss in all)\n' "$1" $((now - LAST_PHASE)) $((now - START))
    LAST_PHASE=$now
}
die() { echo "tools/deep: $*" >&2; exit 1; }

cd "$(git rev-parse --show-toplevel)" || die "not in a git worktree"
for tool in gh jq cpuq; do
    command -v "$tool" >/dev/null || die "needs $tool"
done
COMMON=$(cd "$(git rev-parse --git-common-dir)" && pwd) || die "no git directory"
STATE=$COMMON/rig-deep
DEEP=${DEEP_WORKTREE:-$HOME/Data/Code/worktrees/rig/deep-main}
REMOTE=${DEEP_REMOTE:-origin}
REPO=$(git remote get-url "$REMOTE" | sed -nE 's#^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)([^/]+/[^/]+)$#\2#p')
REPO=${REPO%.git}
[[ -n $REPO ]] || die "the remote $REMOTE is not a GitHub repository"
mkdir -p "$STATE/runs" || die "cannot make $STATE"

git fetch -q "$REMOTE" main --tags || die "cannot fetch $REMOTE main"
MAIN=$(git rev-parse "$REMOTE/main") || die "no $REMOTE/main"
SHORT=${MAIN:0:12}

# The last run that passed or failed: its sha, when it started, its verdict.
LAST_SHA="" LAST_TIME=0 LAST_VERDICT=""
[[ -f $STATE/last ]] && read -r LAST_SHA LAST_TIME LAST_VERDICT <"$STATE/last"

# --- The lock: one deep run or bisect at a time ---------------------------

WORK=$(mktemp -d "${TMPDIR:-/tmp}/rig-deep.XXXXXX") || die "cannot make a temporary directory"
LOCKED=""
cleanup() {
    [[ -n $LOCKED ]] && rm -rf "$STATE/lock"
    rm -rf "$WORK"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
lock() {
    if ! mkdir "$STATE/lock" 2>/dev/null; then
        local pid
        pid=$(cat "$STATE/lock/pid" 2>/dev/null)
        if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
            echo "deep: another deep run or bisect holds the lock (pid $pid); nothing to do"
            exit 0
        fi
        # Its holder is gone: take the lock over.
        rm -rf "$STATE/lock"
        mkdir "$STATE/lock" 2>/dev/null || die "cannot take $STATE/lock"
    fi
    LOCKED=1
    echo $$ >"$STATE/lock/pid"
}

# worktree_at <commit>: the deep worktree, made if need be, clean and
# detached at the commit.
worktree_at() {
    if [[ ! -e $DEEP/.git ]]; then
        mkdir -p "$(dirname "$DEEP")" || die "cannot make $(dirname "$DEEP")"
        git worktree add -q --detach "$DEEP" "$1" || die "cannot add the worktree $DEEP"
    fi
    git -C "$DEEP" bisect reset >/dev/null 2>&1
    git -C "$DEEP" checkout -q --detach "$1" && git -C "$DEEP" reset -q --hard "$1" &&
        git -C "$DEEP" clean -ffdxq || die "cannot reset $DEEP to ${1:0:12}"
}

# status <state> <description>: post rig/deep on MAIN.
status() {
    if [[ -n $DRY ]]; then echo "deep: would post rig/deep $1: $2"; return 0; fi
    gh api -X POST "repos/$REPO/statuses/$MAIN" -f state="$1" -f context=rig/deep \
        -f description="${2:0:140}" --jq '"deep: posted rig/deep " + .state + " as " + .creator.login' ||
        echo "deep: posting rig/deep $1 failed" >&2
}

# job_id <log>: the id cpuq printed on its first line (`job ID`).
job_id() { sed -n '1s/^job \([0-9a-f]*\).*/\1/p' "$1" 2>/dev/null; }
verdict() { tail -n 1 "$1"; }
# The ids test/run reported failing, and the matrix cells, one a line.
failing_tests() { sed -E 's/\x1b\[[0-9;]*m//g' "$1" | sed -nE 's/^  (FAIL|FIXED) +([^ ]+) .*/\2/p'; }
failing_cells() { sed -E 's/\x1b\[[0-9;]*m//g' "$1" | sed -nE 's/^fail +([^ ]+) .*/\1/p'; }

if [[ -n $BISECT ]]; then
# --- Bisect a red run -----------------------------------------------------

    if [[ -z $RED ]]; then
        [[ $LAST_VERDICT == failure ]] || die "the last deep run did not fail; name the red commit: tools/deep --bisect SHA"
        RED=$LAST_SHA
    fi
    red_arg=$RED
    RED=$(git rev-parse --verify -q "$RED^{commit}") || die "no commit $red_arg"
    GOOD=$(git rev-parse --verify -q "deep-green^{commit}") || die "no tag deep-green: no deep run has passed yet"
    [[ $GOOD != "$RED" ]] || die "${RED:0:12} is deep-green"
    git merge-base --is-ancestor "$GOOD" "$RED" || die "deep-green (${GOOD:0:12}) is not an ancestor of ${RED:0:12}"
    RUN=$STATE/runs/${RED:0:12}
    if [[ ${#IDS_GIVEN[@]} -gt 0 ]]; then
        printf '%s\n' "${IDS_GIVEN[@]}" >"$WORK/ids"
        : >"$WORK/cells"
    else
        [[ -f $RUN/failing ]] || die "no failing ids of ${RED:0:12} in $RUN; name them: tools/deep --bisect ${RED:0:12} -- ID..."
        cp "$RUN/failing" "$WORK/ids"
        cp "$RUN/failing-cells" "$WORK/cells" 2>/dev/null || : >"$WORK/cells"
    fi
    [[ -s $WORK/ids || -s $WORK/cells ]] || die "no failing test or cell of ${RED:0:12} to bisect with; name them after --"
    STEPS=$(git rev-list --first-parent --count "$GOOD..$RED")
    echo "deep: bisect ${RED:0:12} (red) against deep-green ${GOOD:0:12}: $STEPS merges, with$(tr '\n' ' ' <"$WORK/ids" | sed 's/^/ /;s/ $//')$( [[ -s $WORK/cells ]] && echo "; cells$(tr '\n' ' ' <"$WORK/cells" | sed 's/^/ /;s/ $//')")"
    if [[ -n $DRY ]]; then
        echo "deep: would bisect in $DEEP: git bisect start --first-parent ${RED:0:12} ${GOOD:0:12}; git bisect run (the step below)"
        exit 0
    fi
    lock

    # The step runs from outside the worktree: an older commit has no
    # tools/deep, or another one.
    cat >"$WORK/step" <<'STEP'
#!/usr/bin/env bash
# One bisect step, in the deep worktree at the commit to test: 0 good,
# 1 bad, 125 skip (a job that could not finish).
set -uo pipefail
work=$1
sha=$(git rev-parse HEAD)
ids=()
# A test id the commit has no test for yet would select nothing, which
# test/run fails; such a commit is good for that test.
while IFS= read -r id; do
    [[ -n $id ]] || continue
    case $id in
        behavior/*|reject/*|known/*) p=test/$id ;;
        ir/*|torture/*) p=test/$id ;;
        cli/*) p=test/$id.sh ;;
        corpus/*) p=test/corpus/${id#corpus/} ;;
        examples/*) p=$id ;;
        doc/*) f=${id#doc/}; f=${f%%/*}; p=$f.md; [[ -e $p ]] || p=docs/$f.md ;;
        *) p="" ;;
    esac
    if [[ -z $p || -e $p || -e $p.rig ]]; then ids+=("$id"); fi
done <"$work/ids"
cells=()
while IFS= read -r c; do [[ -n $c ]] && cells+=(-k "$c"); done <"$work/cells"
rc=0
if [[ ${#ids[@]} -gt 0 ]]; then
    cpuq submit cpuq/suite.json --note "deep bisect ${sha:0:12}" -- "${ids[@]}" >"$work/step.log" 2>&1
    rc=$?
    echo "step ${sha:0:12}: suite $(tail -n 1 "$work/step.log")"
fi
if [[ $rc -eq 0 && ${#cells[@]} -gt 0 ]]; then
    cpuq submit cpuq/matrix.json --note "deep bisect ${sha:0:12}" -- "${cells[@]}" >"$work/step.log" 2>&1
    rc=$?
    echo "step ${sha:0:12}: matrix $(tail -n 1 "$work/step.log")"
fi
[[ ${#ids[@]} -gt 0 || ${#cells[@]} -gt 0 ]] || echo "step ${sha:0:12}: none of the tests exists yet; good"
case $rc in
    0) exit 0 ;;
    1|122|124) exit 1 ;;
    *) exit 125 ;;
esac
STEP
    chmod +x "$WORK/step"
    worktree_at "$RED"
    (cd "$DEEP" && git bisect start --first-parent "$RED" "$GOOD" >/dev/null &&
        git bisect run "$WORK/step" "$WORK") | tee "$WORK/bisect.log"
    FIRST=$(sed -nE 's/^([0-9a-f]{40}) is the first bad commit$/\1/p' "$WORK/bisect.log")
    git -C "$DEEP" bisect log >"$STATE/runs/bisect-${RED:0:12}.log" 2>/dev/null
    worktree_at "$REMOTE/main"
    phase "bisected"
    if [[ -z $FIRST ]]; then
        echo "deep: the bisect found no first bad merge (see $STATE/runs/bisect-${RED:0:12}.log)"
        exit 1
    fi
    echo "deep: the first bad merge: $(git log -1 --format='%h %s' "$FIRST")"
    echo "deep: revert it, or fix forward"
    exit 0
fi

# --- Has main moved? -----------------------------------------------------

if [[ -z $FORCE && $MAIN == "$LAST_SHA" ]]; then
    echo "deep: main ($SHORT) is the last deep run's commit, which ended $LAST_VERDICT; nothing to do (--force runs it again)"
    exit 0
fi

NAMES="suite corpus matrix"
if [[ -n $DRY ]]; then
    echo "deep: would reset $DEEP to $REMOTE/main ($SHORT) and submit $NAMES with --note \"deep $SHORT\""
    echo "deep: last run: ${LAST_SHA:0:12} ${LAST_VERDICT:-none}"
    exit 0
fi
lock
worktree_at "$MAIN"
cd "$DEEP" || die "cannot enter $DEEP"
phase "reset $DEEP to $SHORT"

# --- The tests, on burst --------------------------------------------------

status pending "burst: testing $SHORT: suite, corpus, matrix"
for name in $NAMES; do
    cpuq submit "cpuq/$name.json" --note "deep $SHORT" >"$WORK/$name.log" 2>&1 &
    echo $! >"$WORK/$name.pid"
done
phase "submitted $NAMES"
# cpuq stops each job at its spec's time limit (150 minutes at most).
for name in $NAMES; do
    wait "$(cat "$WORK/$name.pid")"
    echo $? >"$WORK/$name.rc"
    phase "$name: $(verdict "$WORK/$name.log" | awk '{print $1}') (job $(job_id "$WORK/$name.log"))"
done

STATE_WORD=success FAILED="" IDS=""
for name in $NAMES; do
    IDS="$IDS $name $(job_id "$WORK/$name.log")"
    case $(cat "$WORK/$name.rc") in
        0) [[ $(verdict "$WORK/$name.log") == PASS* ]] || { STATE_WORD=error; FAILED="$FAILED $name"; } ;;
        1|122|124) [[ $STATE_WORD == error ]] || STATE_WORD=failure; FAILED="$FAILED $name" ;;
        *) STATE_WORD=error; FAILED="$FAILED $name" ;;
    esac
done
IDS=${IDS# } FAILED=${FAILED# }
[[ -z $(git status --porcelain --untracked-files=no) && $(git rev-parse HEAD) == "$MAIN" ]] ||
    { STATE_WORD=error; FAILED="${FAILED:+$FAILED, }the worktree changed"; }

echo "$MAIN $START $STATE_WORD $IDS" >>"$STATE/history"
if [[ $STATE_WORD == success ]]; then
    status success "$SHORT: $IDS"
    git tag -f deep-green "$MAIN" >/dev/null && git push -q -f "$REMOTE" refs/tags/deep-green ||
        echo "deep: moving the tag deep-green failed" >&2
    echo "$MAIN $START success" >"$STATE/last"
    phase "passed; deep-green is $SHORT"
    exit 0
fi

RUN=$STATE/runs/$SHORT
mkdir -p "$RUN"
for name in $NAMES; do cp "$WORK/$name.log" "$RUN/$name.log"; done
{ failing_tests "$WORK/suite.log"; failing_tests "$WORK/corpus.log"; } | sort -u >"$RUN/failing"
failing_cells "$WORK/matrix.log" | sort -u >"$RUN/failing-cells"
for name in $FAILED; do
    [[ -f $WORK/$name.log ]] || continue
    echo "--- $name"
    tail -n 25 "$WORK/$name.log"
done
status "$STATE_WORD" "burst: $FAILED $STATE_WORD; $IDS"
# A run that could not finish is tried again; a failing test is not.
[[ $STATE_WORD == failure ]] && echo "$MAIN $START failure" >"$STATE/last"
phase "posted $STATE_WORD"
echo "deep: logs and failing ids in $RUN"
[[ $STATE_WORD == failure ]] && echo "deep: find the merge: tools/deep --bisect $SHORT"
exit 1
