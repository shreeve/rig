# std.datetime's and std.time's answers to the oracle's cases
# (README.md): one line out for each line of the file named first, in the
# line format. A case or a part not answered (the abbreviation, phase 6's
# `format("%Z")`) prints `-`, which the comparison passes over, as it
# passes over each part Jiff answers `skip`, where Rig differs on purpose
# (test/cli/jiff_oracle.sh). A value that fails prints `error`, as Jiff's
# does.
#
#   bin/rig build --release tools/jiff-oracle/answer.rig -o DIR/answer
#   DIR/answer DIR/calendar.in > DIR/calendar.rig

use std.datetime
use std.file
use std.os
use std.text
use std.time

sub main()!
  src = file.read(os.args()[1])! ?? String()
  rows = text.lines(?src)
  for row in !rows
    if text.cut(row, " ") as c
      answer(c.before, c.after)
    else
      answer(row, "")

sub answer(op: ?String, rest: ?String)
  a: [7]?String = ["", "", "", "", "", "", ""]
  n = 0
  for w in text.words(rest)
    if n < 7
      a[n] = w
    n += 1
  if op == "date.add"
    d = date(a[0])
    print(show(d.add(years: int(a[1]), months: int(a[2]), weeks: int(a[3]), days: int(a[4])) catch none))
  else if op == "date.info"
    d = date(a[0])
    print(d.weekday(), d.day_of_year(), d.days_in_month(), d.iso_week(), d.iso_week_year(), d.first_of_month(), d.last_of_month())
  else if op == "datetime.add"
    dt = datetime_of(a[0])
    if maybe_duration(a[5]) as d
      print(show(dt.add(duration: d, years: int(a[1]), months: int(a[2]), weeks: int(a[3]), days: int(a[4])) catch none))
    else
      print("-")
  else if op == "instant.add"
    i = instant(a[0])
    if maybe_duration(a[1]) as d
      print(show(i.add(d) catch none))
    else
      print("-")
  else if op == "instant.unix"
    # `unix()` is exact at any instant (§7.8), and the instant again from
    # its parts.
    i = instant(a[0])
    u = i.unix()
    print(u.iso(), i.unix_s(), i.unix_ms(), i.unix_us(), show(datetime.Instant.from_unix_s(u.seconds(), ns: u.subsec_ns()) catch none))
  else if op == "instant.since"
    print(instant(a[0]).since(instant(a[1])).iso())
  else if op == "zoned.add"
    z = zoned(a[0], a[1])
    if maybe_duration(a[6]) as d
      print(show(z.add(duration: d, years: int(a[2]), months: int(a[3]), weeks: int(a[4]), days: int(a[5])) catch none))
    else
      print("-")
  else if op == "instant.in_zone"
    # The offset as Jiff writes it, `offset_text()` with no `:00` of
    # minutes alone; the abbreviation is `format("%Z")`'s, not yet built:
    # `-`.
    z = instant(a[0]).in_zone(zone(a[1]))
    print(z, short_offset(z.offset_text()), "-")
  else if op == "datetime.in_zone"
    dt = datetime_of(a[0])
    tz = zone(a[1])
    print(show(dt.in_zone(tz) catch none), show(dt.in_zone(tz, resolve: .earlier) catch none), show(dt.in_zone(tz, resolve: .later) catch none), show(dt.in_zone(tz, resolve: .reject) catch none))
  else if op == "date.in_zone"
    print(show(date(a[0]).in_zone(zone(a[1])) catch none))
  else if op == "zoned.with"
    z = zoned(a[0], a[1])
    dt = datetime_of(a[2])
    print(zoned_with(z, dt, .compatible), zoned_with(z, dt, .earlier), zoned_with(z, dt, .later), zoned_with(z, dt, .reject))
  else if op == "zoned.start_of_day"
    print(show(zoned(a[0], a[1]).start_of_day() catch none))
  else if op == "zoned.count"
    x = zoned(a[0], a[1])
    y = zoned(a[0], a[2])
    early = x if x < y else y
    late = y if x < y else x
    # DATETIME-DESIGN §6.4, as for dates and times.
    days = late.days_since(early)
    step = early.add(days: days) catch |e|
      print("-", e)
      return
    left = late.since(step)
    d0 = early.date()
    d1 = d0.add(days: days) catch |e|
      print("-", e)
      return
    m = d1.months_since(d0)
    print(x.days_since(y), x.weeks_since(y), x.months_since(y), x.years_since(y), m / 12, m % 12, days_after(d0, d1, m), left.iso())
  else if op == "zoned.parse"
    print(show(datetime.ZonedDateTime.parse(rest) catch none), show(datetime.ZonedDateTime.parse(rest, conflict: .keep_instant) catch none), show(datetime.ZonedDateTime.parse(rest, conflict: .keep_clock) catch none))
  else if op == "zoned.round"
    z = zoned(a[0], a[1])
    k = int(a[3])
    print(zoned_round(z, a[2], k, false), zoned_round(z, a[2], k, true))
  else if op == "zone.offset"
    print(zone(a[0]).offset_at(instant(a[1])).seconds())
  else if op == "zone.name"
    print(zone(a[0]).name())
  else if op == "zone.eq"
    print(zone(a[0]) == zone(a[1]))
  else if op == "instant.parse"
    print(show(datetime.Instant.parse(rest) catch none))
  else if op == "instant.round"
    i = instant(a[0])
    k = int(a[2])
    print(instant_round(i, a[1], k, false), instant_round(i, a[1], k, true))
  else if op == "time.add"
    t = time_of(a[0])
    if maybe_duration(a[1]) as d
      print(t.add(d))
    else
      print("-")
  else if op == "date.count"
    x = date(a[0])
    y = date(a[1])
    early = x if x < y else y
    late = y if x < y else x
    m = late.months_since(early)
    print(x.days_since(y), x.weeks_since(y), x.months_since(y), x.years_since(y), m / 12, m % 12, days_after(early, late, m))
  else if op == "datetime.count"
    x = datetime_of(a[0])
    y = datetime_of(a[1])
    early = x if x < y else y
    late = y if x < y else x
    # DATETIME-DESIGN §6.4: whole days and the rest, then years, months
    # and days between the two dates.
    # The steps from the earlier value stay within the later one, so none
    # fails; were one to, the line shows it.
    days = late.days_since(early)
    step = early.add(days: days) catch |e|
      print("-", e)
      return
    left = late.since(step)
    d0 = early.date()
    d1 = d0.add(days: days) catch |e|
      print("-", e)
      return
    m = d1.months_since(d0)
    print(x.days_since(y), x.weeks_since(y), x.months_since(y), x.years_since(y), m / 12, m % 12, days_after(d0, d1, m), left.iso())
  else if op == "date.parse"
    print(show(datetime.Date.parse(rest) catch none))
  else if op == "time.parse"
    print(show(datetime.Time.parse(rest) catch none))
  else if op == "datetime.parse"
    print(show(datetime.DateTime.parse(rest) catch none))
  else if op == "duration.parse"
    print(show_iso(maybe_duration(rest)))
  else if op == "duration.round"
    if maybe_duration(a[0]) as d
      k = int(a[2])
      print(show_iso(duration_round(d, a[1], k, false)), show_iso(duration_round(d, a[1], k, true)))
    else
      print("-")
  else if op == "time.round"
    t = time_of(a[0])
    k = int(a[2])
    print(time_round(t, a[1], k, false), time_round(t, a[1], k, true))
  else if op == "datetime.round"
    dt = datetime_of(a[0])
    k = int(a[2])
    print(datetime_round(dt, a[1], k, false), datetime_round(dt, a[1], k, true))
  else if op == "date.nth_weekday"
    print(show(date(a[0]).nth_weekday(int(a[1]), weekday(a[2])) catch none))
  else if op == "date.nth_weekday_of_month"
    print(show(date(a[0]).nth_weekday_of_month(int(a[1]), weekday(a[2])) catch none))
  else if op == "date.with"
    print(show(date(a[0]).with(year: int(a[1]), month: int(a[2]), day: int(a[3])) catch none))
  else if op == "time.since"
    print(time_of(a[0]).since(time_of(a[1])).iso())
  else if op == "datetime.since"
    print(datetime_of(a[0]).since(datetime_of(a[1])).iso())
  else
    print("-")

# A value, or `error` when there is none.
fun show[T](r: T?) -> String
  if r as v
    return String(v)
  String("error")

# A duration in ISO 8601, or `error` when there is none.
fun show_iso(r: time.Duration?) -> String
  if r as v
    return v.iso()
  String("error")

# The days from `early` plus `m` months to `late`, which is not before
# it, as §6.4 counts what is left after the years and months.
fun days_after(early: datetime.Date, late: datetime.Date, m: Int) -> String
  at = early.add(months: m) catch return String("-")
  String(late.days_since(at))

fun duration_round(d: time.Duration, unit: ?String, k: Int, down: Bool) -> time.Duration?
  if unit == "ns"
    if down
      return d.floor(ns: k) catch none
    return d.round(ns: k) catch none
  if unit == "us"
    if down
      return d.floor(us: k) catch none
    return d.round(us: k) catch none
  if unit == "ms"
    if down
      return d.floor(ms: k) catch none
    return d.round(ms: k) catch none
  if unit == "seconds"
    if down
      return d.floor(seconds: k) catch none
    return d.round(seconds: k) catch none
  if unit == "minutes"
    if down
      return d.floor(minutes: k) catch none
    return d.round(minutes: k) catch none
  if down
    return d.floor(hours: k) catch none
  return d.round(hours: k) catch none

# The duration `s` writes, or `none` beyond a `Duration`'s range.
fun maybe_duration(s: ?String) -> time.Duration?
  time.Duration.parse(s) catch return none

fun int(s: ?String) -> Int
  text.parse_int(s) catch panic("not an integer:", s)

fun date(s: ?String) -> datetime.Date
  datetime.Date.parse(s) catch panic("not a date:", s)

fun time_of(s: ?String) -> datetime.Time
  datetime.Time.parse(s) catch panic("not a time:", s)

fun zone(s: ?String) -> datetime.TimeZone
  datetime.TimeZone.parse(s) catch panic("not a zone:", s)

# `z` with its date and time on the clock replaced by `dt`'s.
fun zoned_with(z: datetime.ZonedDateTime, dt: datetime.DateTime, how: datetime.Resolve) -> String
  show(z.with(year: dt.year(), month: dt.month(), day: dt.day(), hour: dt.hour(), minute: dt.minute(), second: dt.second(), ns: dt.nanosecond(), resolve: how) catch none)

# An offset as Jiff writes it: `+03` for `+03:00`.
fun short_offset(o: ?String) -> String
  if o.len == 6 and ?o[3..] == ":00"
    return String(?o[..3])
  String(o)

fun zoned(z: ?String, at: ?String) -> datetime.ZonedDateTime
  instant(at).in_zone(zone(z))

fun instant(s: ?String) -> datetime.Instant
  datetime.Instant.parse(s) catch panic("not an instant:", s)

fun datetime_of(s: ?String) -> datetime.DateTime
  datetime.DateTime.parse(s) catch panic("not a datetime:", s)

fun weekday(s: ?String) -> datetime.Weekday
  for w in $variants(datetime.Weekday)
    if String(w) == s
      return w
  panic("not a weekday:", s)

# A `Time` rounded by an increment read from the line: a `Time`'s
# `round` takes a constant increment only, so it rounds as a date and
# time, whose time of day is the same answer, wrapped past midnight.
fun time_round(t: datetime.Time, unit: ?String, k: Int, down: Bool) -> String
  on = datetime.Date.new(2000, 1, 1).at(t)
  if datetime_rounded(on, unit, k, down) as r
    return String(r.time())
  String("error")

fun datetime_round(t: datetime.DateTime, unit: ?String, k: Int, down: Bool) -> String
  show(datetime_rounded(t, unit, k, down))

fun datetime_rounded(t: datetime.DateTime, unit: ?String, k: Int, down: Bool) -> datetime.DateTime?
  if unit == "ns"
    if down
      return t.floor(ns: k) catch none
    return t.round(ns: k) catch none
  if unit == "us"
    if down
      return t.floor(us: k) catch none
    return t.round(us: k) catch none
  if unit == "ms"
    if down
      return t.floor(ms: k) catch none
    return t.round(ms: k) catch none
  if unit == "seconds"
    if down
      return t.floor(seconds: k) catch none
    return t.round(seconds: k) catch none
  if unit == "minutes"
    if down
      return t.floor(minutes: k) catch none
    return t.round(minutes: k) catch none
  if unit == "hours"
    if down
      return t.floor(hours: k) catch none
    return t.round(hours: k) catch none
  if down
    return t.floor(days: k) catch none
  return t.round(days: k) catch none

fun instant_round(t: datetime.Instant, unit: ?String, k: Int, down: Bool) -> String
  if unit == "ns"
    if down
      return show(t.floor(ns: k) catch none)
    return show(t.round(ns: k) catch none)
  if unit == "us"
    if down
      return show(t.floor(us: k) catch none)
    return show(t.round(us: k) catch none)
  if unit == "ms"
    if down
      return show(t.floor(ms: k) catch none)
    return show(t.round(ms: k) catch none)
  if unit == "seconds"
    if down
      return show(t.floor(seconds: k) catch none)
    return show(t.round(seconds: k) catch none)
  if unit == "minutes"
    if down
      return show(t.floor(minutes: k) catch none)
    return show(t.round(minutes: k) catch none)
  if down
    return show(t.floor(hours: k) catch none)
  return show(t.round(hours: k) catch none)

fun zoned_round(t: datetime.ZonedDateTime, unit: ?String, k: Int, down: Bool) -> String
  if unit == "ns"
    if down
      return show(t.floor(ns: k) catch none)
    return show(t.round(ns: k) catch none)
  if unit == "us"
    if down
      return show(t.floor(us: k) catch none)
    return show(t.round(us: k) catch none)
  if unit == "ms"
    if down
      return show(t.floor(ms: k) catch none)
    return show(t.round(ms: k) catch none)
  if unit == "seconds"
    if down
      return show(t.floor(seconds: k) catch none)
    return show(t.round(seconds: k) catch none)
  if unit == "minutes"
    if down
      return show(t.floor(minutes: k) catch none)
    return show(t.round(minutes: k) catch none)
  if unit == "hours"
    if down
      return show(t.floor(hours: k) catch none)
    return show(t.round(hours: k) catch none)
  if down
    return show(t.floor(days: k) catch none)
  return show(t.round(days: k) catch none)
