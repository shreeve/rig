#!/usr/bin/env bash
# tools/gate: test a pull request's head on burst, and post the verdict to
# GitHub as the commit status `rig/gate` on that commit.
#
#   tools/gate [--pr N] [--matrix | --no-matrix] [--force]
#              [--allow-gate-changes] [--no-wait]
#   tools/gate --skip REASON [--pr N]
#
# Gating is a choice, not a step every pull request takes: the required
# checks (.github/workflows/gate.yml) pass for a head with no `rig/gate`
# status, and fail only after a gate on it failed. A pull request is gated
# when Steve asks, once it is ready (a draft is refused), and only when it changes
# what burst tests (TESTED, below); for any other it says why and exits 0
# without posting anything. The deep gate on main (tools/deep) tests the
# rest, and every merge together.
#
# Run it from the worktree of a branch with an open pull request, after
# merging the pull request's base and pushing. It refuses unless the
# worktree is clean, holds no ignored file that cpuq would ship, its HEAD
# is the pull request's pushed head, and that head contains the base; so
# the bytes burst tests are exactly that commit. It cancels the burst jobs
# of an older gate of the same pull request, for another head, that still
# run. It then submits the suite and the corpus (cpuq/suite.json,
# corpus.json, each a --delta run), and the matrix (matrix.json) when the
# branch changes a file of MATRIX_PATHS (below), together, and burst runs
# them at once. Once every
# one passes it posts `success` on the commit, with its tree and the job
# ids. A failing test posts `failure`, a job that could not finish
# `error`, and the jobs still running are cancelled. Last, it re-runs the
# pull request's gate workflow (.github/workflows/gate.yml), whose two
# jobs are the required checks, and waits for them to turn green;
# --no-wait stops once the re-run starts.
#
# --pr N gates pull request N, whose head HEAD must be: the way to gate a
# fork's pull request, from a local branch of its head (test/README.md,
# "The merge gate and CI").
# --matrix runs the matrix whatever the branch changes, and --no-matrix
# leaves it out whatever it changes; a success without it says so.
# --force gates a branch that changes nothing of TESTED.
# --allow-gate-changes tests a branch that changes this script or
# cpuq/*.json, which decide what the gate runs; without it such a branch
# is refused.
# A branch that changes formal/ also builds its Lean proofs here (burst
# has no Lean) and fails on an unfinished one (`sorry`).
# --skip REASON tests nothing: it posts `success` with "skipped: REASON"
# on the pull request's pushed head and re-runs the checks, which clears a
# failed gate (the worktree need not be clean or contain the base).
#
# GATE_REMOTE names the remote of the GitHub repository (default origin).
# It posts with this machine's `gh` login: no credential goes to GitHub
# or to burst. Each phase's wall-clock time is printed as it ends.
# (bash 3.2, as macOS ships it.)
set -uo pipefail

MATRIX="" FORCE="" ALLOW_GATE_CHANGES="" WAIT=1 PR="" SKIP=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --pr) [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "tools/gate: --pr takes a pull request's number" >&2; exit 2; }
            PR=$2; shift ;;
        --matrix) MATRIX=yes ;;
        --no-matrix) MATRIX=no ;;
        --force) FORCE=1 ;;
        --allow-gate-changes) ALLOW_GATE_CHANGES=1 ;;
        --no-wait) WAIT="" ;;
        --skip) [[ -n ${2:-} && $2 != -* ]] || { echo "tools/gate: --skip takes a reason" >&2; exit 2; }
            SKIP=$2; shift ;;
        -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
        *) echo "tools/gate: unknown option $1 (see --help)" >&2; exit 2 ;;
    esac
    shift
done

START=$(date +%s)
LAST=$START
# phase <what>: print the time since the last phase and since the start.
phase() {
    local now
    now=$(date +%s)
    printf 'gate: %-46s %5ss  (%ss in all)\n' "$1" $((now - LAST)) $((now - START))
    LAST=$now
}
die() { echo "tools/gate: $*" >&2; exit 1; }

cd "$(git rev-parse --show-toplevel)" || die "not in a git worktree"
TOOLS="gh jq"
[[ -n $SKIP ]] || TOOLS="$TOOLS cpuq python3"
for tool in $TOOLS; do
    command -v "$tool" >/dev/null || die "needs $tool"
done

# --- What is tested: exactly the pushed head of the pull request ----------

BRANCH=$(git symbolic-ref --short -q HEAD) || BRANCH=""
[[ -n $BRANCH || -n $PR ]] || die "HEAD is detached; check out the pull request's branch, or name it with --pr"
[[ $BRANCH != main ]] || die "main is not gated; run it from a pull request's branch"
[[ -n $SKIP || -z $(git status --porcelain --untracked-files=all) ]] ||
    die "the worktree has changes or untracked files, which cpuq would ship and test; commit or remove them"

# The GitHub repository behind the remote (GATE_REMOTE, default origin).
REMOTE=${GATE_REMOTE:-origin}
REPO=$(git remote get-url "$REMOTE" | sed -nE 's#^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)([^/]+/[^/]+)$#\2#p')
REPO=${REPO%.git}
[[ -n $REPO ]] || die "the remote $REMOTE is not a GitHub repository"
PR_JSON=$(gh pr view "${PR:-$BRANCH}" -R "$REPO" --json number,state,isDraft,headRefOid,baseRefName,isCrossRepository,url) ||
    die "no pull request for ${PR:-$BRANCH}; open one first (gh pr create --draft)"
read -r PR STATE DRAFT HEAD_OID BASE CROSS URL < <(jq -r '[.number, .state, .isDraft, .headRefOid, .baseRefName, .isCrossRepository, .url] | @tsv' <<<"$PR_JSON")
[[ $STATE == OPEN ]] || die "pull request #$PR is $STATE"
[[ -n $SKIP || $DRAFT != true ]] ||
    die "#$PR is a draft; mark it ready first (gh pr ready $PR), then run tools/gate again"

SHA=$(git rev-parse HEAD)
if [[ $CROSS == true ]]; then
    # A fork's head is fetched from the pull request itself.
    git fetch -q "$REMOTE" "$BASE" "pull/$PR/head" || die "cannot fetch $REMOTE"
    [[ $SHA == "$(git rev-parse FETCH_HEAD)" ]] || die "HEAD is not the head of #$PR (pull/$PR/head)"
else
    [[ -n $BRANCH ]] || die "check out #$PR's branch"
    git fetch -q "$REMOTE" "$BRANCH" "$BASE" || die "cannot fetch $REMOTE"
    [[ $SHA == "$(git rev-parse "$REMOTE/$BRANCH")" ]] || die "HEAD is not $REMOTE/$BRANCH; push first (or pull)"
fi
[[ $SHA == "$HEAD_OID" ]] || die "HEAD is not the head of #$PR ($HEAD_OID)"
[[ -n $SKIP ]] || git merge-base --is-ancestor "$REMOTE/$BASE" HEAD || die "HEAD does not contain $REMOTE/$BASE; merge it and push"
if [[ -z $SKIP && -z $ALLOW_GATE_CHANGES ]] && ! git diff --quiet "$REMOTE/$BASE" HEAD -- tools/gate cpuq; then
    die "this branch changes tools/gate or cpuq/, which decide what the gate runs; review them, then pass --allow-gate-changes"
fi
# Burst has no Lean: a branch that changes formal/ builds its proofs here,
# and an unfinished proof (`sorry`, which lake only warns of) fails it.
FORMAL=""
if [[ -z $SKIP ]] && ! git diff --quiet "$REMOTE/$BASE" HEAD -- formal; then
    command -v lake >/dev/null || die "this branch changes formal/, which needs lake (elan) to build"
    FORMAL=1
fi

# --- What runs: decided by the paths the branch changes -------------------

# TESTED: what burst's runs depend on. The compiler and the standard
# library, the grammar and the build, and the harness: the runners, the
# shared CLI helpers, the reference ownership checker's code (its lists
# are checked by tools/check), the JSON comparison, the specs and the
# script that set up and submit the runs. A branch that changes only
# tests, examples, or docs is not gated: tools/check runs its own tests,
# and the deep gate runs everything again.
TESTED='src/*|std/*|rig.grammar|build.zig|build.zig.zon|test/run|test/matrix.py|test/equiv.py|test/hints.py|test/cli/_*|test/oracle/*.zig|test/json/compare.py|test/json/driver.rig.tmpl|cpuq/*|tools/gate|tools/fetch-json-data.sh'
# MATRIX_PATHS: what decides the verdicts the matrix tests, a form's
# ownership, loans, storage, proofs and emitted code, and the matrix's own
# harness. The classifiers: sema.zig (`handsOver`, the one classifier of
# what an expression hands over), facts.zig and storage.zig (the facts
# recorded once, AGENTS.md rule 4); the checks: ownership.zig (moves,
# loans, drops) and proofs.zig (the omitted checks the proof. and unit.
# grids test); emit: emit.zig and runtime.zig, the Zig every cell runs.
# typecheck.zig is left out: it changes in most rounds, mostly types, and
# the suite's reject/ and behavior/ tests cover it; the deep gate runs
# the matrix over it.
MATRIX_PATHS='src/facts.zig|src/storage.zig|src/proofs.zig|src/emit.zig|src/ownership.zig|src/sema.zig|src/runtime.zig|test/matrix.py|cpuq/matrix.json'
# matches <patterns> <file>: the file matches one of the |-separated globs.
matches() {
    local pats pat
    IFS='|' read -r -a pats <<<"$1"
    for pat in "${pats[@]}"; do
        # shellcheck disable=SC2053 # a glob, on purpose
        [[ $2 == $pat ]] && return 0
    done
    return 1
}
TESTED_HIT="" MATRIX_HIT=""
if [[ -z $SKIP ]]; then
    while IFS= read -r f; do
        [[ -n $f ]] || continue
        [[ -z $TESTED_HIT ]] && matches "$TESTED" "$f" && TESTED_HIT=$f
        [[ -z $MATRIX_HIT ]] && matches "$MATRIX_PATHS" "$f" && MATRIX_HIT=$f
    done < <(git diff --name-only "$REMOTE/$BASE" HEAD)
fi
BURST=1
if [[ -z $SKIP && -z $TESTED_HIT && -z $FORCE ]]; then
    BURST=""
    if [[ -z $FORMAL ]]; then
        echo "gate: #$PR changes nothing burst tests (src/, std/, rig.grammar, build.zig, the harness); not gated."
        echo "gate: tools/check runs its tests, and the deep gate on main runs everything; --force gates it anyway"
        exit 0
    fi
    echo "gate: #$PR changes formal/ and nothing burst tests; building its proofs only"
fi
case $MATRIX in
    yes) MATRIX=1 ;;
    no) MATRIX="" ;;
    *) MATRIX=""
        if [[ -n $MATRIX_HIT ]]; then
            MATRIX=1
            echo "gate: with the matrix: the branch changes $MATRIX_HIT"
        fi ;;
esac

# cpuq ships every file but the specs' excludes, ignored ones too. The
# JSON test data is checked by sha256 when the suite fetches it.
NAMES="suite corpus"
if [[ -z $SKIP && -n $BURST ]]; then
[[ -n $MATRIX ]] && NAMES="$NAMES matrix"
SPECS=""
for name in $NAMES; do SPECS="$SPECS cpuq/$name.json"; done
# shellcheck disable=SC2086 # the spec paths hold no spaces
SHIPPED=$(git ls-files -z -o -i --exclude-standard | python3 -c '
import json, sys
excludes = {"test/json/data", "formal/.lake"}
for spec in sys.argv[1:]:
    excludes.update(e.rstrip("/") for e in json.load(open(spec)).get("exclude", []))
for path in sys.stdin.read().split("\0"):
    if path and not any(path == e or path.startswith(e + "/") for e in excludes):
        print(path)
' $SPECS) || die "cannot read the specs"
[[ -z $SHIPPED ]] || die "ignored files cpuq would ship and test (remove them):
$SHIPPED"
fi

TREE=$(git rev-parse "HEAD^{tree}")
SHORT=${SHA:0:12}
FROM=""
[[ $CROSS == true ]] && FROM=", from a fork"
echo "gate: #$PR ${BRANCH:-HEAD} at $SHORT (tree ${TREE:0:12}), base $BASE$FROM"

# status <state> <description>: post rig/gate on SHA.
status() {
    gh api -X POST "repos/$REPO/statuses/$SHA" -f state="$1" -f context=rig/gate \
        -f description="${2:0:140}" --jq '"gate: posted rig/gate " + .state + " as " + .creator.login' ||
        die "posting rig/gate $1 failed"
}
# rerun_checks [wait]: re-run the newest gate workflow run for this commit,
# which reads rig/gate anew, and with `wait` wait for the required checks
# to turn green. The run happened when the commit was pushed; a re-run
# uses the workflow as main held it then (pull_request_target always runs
# the default branch's copy).
rerun_checks() {
    local runs RUN="" ATTEMPT="" RUN_STATUS="" now_attempt now_status conclusion checks
    for _ in $(seq 1 60); do
        # Nothing when there is no run, or no gate.yml on the default branch.
        runs=$(gh api "repos/$REPO/actions/workflows/gate.yml/runs?event=pull_request_target&head_sha=$SHA&per_page=1" \
            --jq '.workflow_runs[0] // empty | [.id, .run_attempt, .status] | @tsv' 2>/dev/null) || runs=""
        [[ -n $runs ]] || break
        read -r RUN ATTEMPT RUN_STATUS <<<"$runs"
        [[ $RUN_STATUS == completed ]] && break
        sleep 2
    done
    if [[ -z $RUN ]]; then
        echo "gate: no gate workflow run for $SHORT (none yet, or no gate.yml on the default branch); the next one, as #$PR is pushed or reopened, reads the status"
        return 0
    fi
    [[ $RUN_STATUS == completed ]] || die "gate run $RUN did not complete within 2 minutes; re-run it: gh run rerun $RUN -R $REPO"
    gh run rerun "$RUN" -R "$REPO" >/dev/null || die "cannot re-run gate run $RUN"
    phase "re-ran gate run $RUN"
    [[ -n ${1:-} ]] || return 0

    # Wait (up to 5 minutes) for the re-run to complete, then read the checks.
    for _ in $(seq 1 100); do
        read -r now_attempt now_status conclusion < <(gh api "repos/$REPO/actions/runs/$RUN" \
            --jq '[.run_attempt, .status, (.conclusion // "-")] | @tsv' 2>/dev/null)
        [[ ${now_attempt:-} =~ ^[0-9]+$ ]] || now_attempt=0
        [[ $now_attempt -gt $ATTEMPT && $now_status == completed ]] && break
        sleep 3
    done
    [[ ${now_attempt:-0} -gt $ATTEMPT && $now_status == completed ]] || die "gate run $RUN did not finish within 5 minutes"
    checks=$(gh api "repos/$REPO/commits/$SHA/check-runs?filter=latest&per_page=100" \
        --jq '[.check_runs[] | select(.app.id == 15368) | select(.name == "test (ubuntu-latest)" or .name == "test (macos-latest)") | .name + ": " + (.conclusion // .status)] | sort | join(", ")')
    [[ $conclusion == success && $checks == "test (macos-latest): success, test (ubuntu-latest): success" ]] ||
        die "gate run $RUN ended $conclusion; checks: $checks"
    phase "required checks green"
    echo "gate: $checks"
    echo "gate: $URL"
}
phase "checked the worktree and #$PR"
if [[ -n $SKIP ]]; then
    login=$(gh api user --jq .login) || die "cannot read the gh login"
    status success "skipped by $login: $SKIP"
    phase "posted success, skipped"
    W=""; [[ -n $WAIT ]] && W=wait
    rerun_checks $W
    exit 0
fi
status pending "burst: testing tree ${TREE:0:12}"
phase "posted pending"
if [[ -n $FORMAL ]]; then
    if ! (cd formal && lake build) >"${TMPDIR:-/tmp}/rig-gate-formal.log" 2>&1; then
        tail -n 25 "${TMPDIR:-/tmp}/rig-gate-formal.log"
        status failure "formal: lake build failed"
        phase "posted failure"
        rerun_checks
        exit 1
    fi
    if grep -rnw sorry formal/LambdaRig formal/LambdaRig.lean; then
        status failure "formal: a proof is unfinished (sorry)"
        phase "posted failure"
        rerun_checks
        exit 1
    fi
    phase "formal: lake build, no sorry"
fi
if [[ -z $BURST ]]; then
    status success "formal only: lake build, no sorry; nothing for burst"
    phase "posted success, formal only"
    W=""; [[ -n $WAIT ]] && W=wait
    rerun_checks $W
    exit 0
fi

# --- The tests, on burst --------------------------------------------------

# An older gate of this pull request, for another head, is out of date:
# cancel its jobs that still wait or run (a finished job's state is a
# verdict in capitals; a live one's is lowercase). Its tools/gate then
# posts `error` on its own head, which is no longer the pull request's.
while read -r id label hash word sha state _; do
    [[ $hash == "#$PR" && $word == gate && $sha != "$SHORT" && $state =~ ^[a-z] ]] || continue
    cpuq job "$id" --cancel >/dev/null 2>&1 && echo "gate: cancelled $label $id, an older gate of #$PR ($sha)"
done < <(cpuq jobs --all 2>/dev/null | grep -E '^[0-9a-f]+  rig:')

WORK=$(mktemp -d "${TMPDIR:-/tmp}/rig-gate.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
for name in $NAMES; do
    cpuq submit "cpuq/$name.json" --note "#$PR gate $SHORT" >"$WORK/$name.log" 2>&1 &
    echo $! >"$WORK/$name.pid"
done
phase "submitted $NAMES"

# job_id <name>: the id cpuq printed on its first line (`job ID`).
job_id() { sed -n '1s/^job \([0-9a-f]*\).*/\1/p' "$WORK/$1.log" 2>/dev/null; }
verdict() { tail -n 1 "$WORK/$1.log"; }

# Wait for each job as it ends; at the first that does not pass, cancel
# the rest. cpuq stops each job at its spec's time limit (150 minutes at
# most); this loop gives up after 4 hours.
FAILED="" REMAINING=$NAMES DEADLINE=$((START + 4 * 3600))
while [[ -n $REMAINING ]]; do
    (($(date +%s) < DEADLINE)) || die "the jobs did not end within 4 hours: $REMAINING"
    still=""
    for name in $REMAINING; do
        if kill -0 "$(cat "$WORK/$name.pid")" 2>/dev/null; then still="$still $name"; continue; fi
        wait "$(cat "$WORK/$name.pid")"
        echo $? >"$WORK/$name.rc"
        phase "$name: $(verdict "$name" | awk '{print $1}') (job $(job_id "$name"))"
        if [[ $(cat "$WORK/$name.rc") -ne 0 && -z $FAILED ]]; then
            FAILED=$name
            for other in $NAMES; do
                [[ -f $WORK/$other.rc ]] && continue
                id=$(job_id "$other")
                [[ -n $id ]] && cpuq job "$id" --cancel >/dev/null 2>&1 && echo "gate: cancelled $other (job $id)"
            done
        fi
    done
    REMAINING=${still# }
    [[ -n $REMAINING ]] && sleep 2
done

IDS=""
for name in $NAMES; do IDS="$IDS $name $(job_id "$name")"; done
IDS=${IDS# }
if [[ -n $FAILED ]]; then
    echo "--- $FAILED"
    tail -n 25 "$WORK/$FAILED.log"
    # A failing test is a failure (FAIL, OOM, TIMEOUT); a job that could not
    # finish (NOT RUN, LOST, CANCELLED, CPUQ ERROR, NOT STARTED, RUNNING) is
    # an error.
    case $(cat "$WORK/$FAILED.rc") in
        1|122|124) state=failure ;;
        *) state=error ;;
    esac
    status "$state" "burst: $FAILED $(verdict "$FAILED" | awk '{print $1}'); $IDS"
    phase "posted $state"
    rerun_checks
    exit 1
fi

# Every verdict is PASS, cpuq records each job as passed, and the worktree
# is still the commit it was.
for name in $NAMES; do
    [[ $(verdict "$name") == PASS* ]] || die "$name exited 0 without a PASS verdict: $(verdict "$name")"
    id=$(job_id "$name")
    [[ -n $id ]] && cpuq job "$id" --json 2>/dev/null | jq -e '.verdict == "pass"' >/dev/null ||
        die "cpuq does not record job $id ($name) as passed"
done
[[ $(git rev-parse HEAD) == "$SHA" && -z $(git status --porcelain --untracked-files=all) ]] ||
    die "the worktree changed while the jobs ran; run tools/gate again"

if [[ -z $MATRIX ]]; then
    status success "no matrix; tree ${TREE:0:12}: $IDS"
    phase "posted success, without the matrix"
else
    status success "tree ${TREE:0:12}: $IDS"
    phase "posted success"
fi
W=""; [[ -n $WAIT ]] && W=wait
rerun_checks $W

