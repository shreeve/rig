# std.unicode: properties of one rune, an `Int`, from the Unicode
# Character Database of the version in `VERSION`. The identifier classes
# are those of UAX #31 at `ID_VERSION`, generated into
# `unicode_tables.zig` by `tools/gen-unicode.py`, and the widths are
# generated into `width_tables.zig`; white space is the White_Space
# property of PropList.txt. A value that is not a rune (a negative, a
# surrogate, or past 0x10FFFF) has no property. The classes are the
# Unicode ones: a language that begins identifiers with `$` or `_` adds
# those itself.

# The Unicode version of every property here but the identifier classes.
pub VERSION = "17.0.0"
# The Unicode version of the identifier classes: TypeScript's, so a
# scanner built on them reads the identifiers tsc reads.
pub ID_VERSION = "15.1.0"

# Whether `r` is white space: the 25 runes of Unicode's White_Space
# property, ASCII's tab, line feed, vertical tab, form feed, carriage
# return, and space among them. Go's `unicode.IsSpace`.
pub fun is_space(r: Int) -> Bool
  if r < 0x80
    return r == 0x20 or (r >= 0x09 and r <= 0x0D)
  match r
    0x85, 0xA0, 0x1680, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000 => true
    0x2000..0x200B => true
    _ => false

extern zig "unicode_tables.zig"
  # Whether `r` is ID_Start: it may begin an identifier. The letters,
  # the letter numbers, and Other_ID_Start.
  pub fun is_id_start(r: Int) -> Bool
  # Whether `r` is ID_Continue: it may follow the first rune of an
  # identifier. ID_Start, marks, decimal digits, connector punctuation,
  # and Other_ID_Continue.
  pub fun is_id_continue(r: Int) -> Bool

extern zig "width_tables.zig"
  # The columns `r` takes in a terminal, 0, 1, or 2, by the rules of
  # Ghostty's tables: 0 for a control, a separator, a surrogate, a
  # nonspacing or enclosing mark, a Hangul vowel or trailing consonant,
  # and a default-ignorable rune but the soft hyphen; 2 for an East Asian
  # Wide or Fullwidth rune, a regional indicator, and the two- and
  # three-em dashes; else 1. 0 for a value that is not a rune.
  pub fun width(r: Int) -> Int
