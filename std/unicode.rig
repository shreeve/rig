# std.unicode: properties of Unicode code points, each an `Int`, and of
# UTF-16 code units. The identifier classes are those of UAX #31 for the
# Unicode version in `VERSION`, generated into `unicode_tables.zig` by
# `tools/gen-unicode.py`; a code point outside `0..0x10FFFF` is in no
# class. The classes are the Unicode ones: a language that adds `$`, `_`
# at the start, or the joiners U+200C and U+200D adds them itself.

# The Unicode version the tables come from.
pub VERSION = "15.1.0"

# Whether `c` is a high (leading) UTF-16 surrogate, U+D800 to U+DBFF.
pub fun is_high_surrogate(c: Int) -> Bool
  c >= 0xD800 and c < 0xDC00

# Whether `c` is a low (trailing) UTF-16 surrogate, U+DC00 to U+DFFF.
pub fun is_low_surrogate(c: Int) -> Bool
  c >= 0xDC00 and c < 0xE000

# The code point that the UTF-16 pair `hi`, `lo` encodes. Panics unless
# `hi` is a high surrogate and `lo` a low one.
pub fun surrogate_pair_to_code_point(hi: Int, lo: Int) -> Int
  if not is_high_surrogate(hi) or not is_low_surrogate(lo)
    not_a_pair()
  (hi - 0xD800) * 0x400 + (lo - 0xDC00) + 0x10000

# How many UTF-16 code units code point `c` takes: 2 from U+10000 up,
# else 1 (a lone surrogate is one unit). Panics unless `c` is in
# `0..0x10FFFF`.
pub fun utf16_len(c: Int) -> Int
  if c < 0 or c > 0x10FFFF
    not_a_code_point()
  2 if c >= 0x10000 else 1

extern zig "unicode.zig"
  # Panics: `surrogate_pair_to_code_point`'s arguments are not a pair.
  sub not_a_pair()
  # Panics: `utf16_len`'s argument is not a code point.
  sub not_a_code_point()

extern zig "unicode_tables.zig"
  # Whether code point `c` is ID_Start: it may begin an identifier. The
  # letters, the letter numbers, and Other_ID_Start.
  pub fun is_id_start(c: Int) -> Bool
  # Whether code point `c` is ID_Continue: it may follow the first
  # character of an identifier. ID_Start, marks, decimal digits,
  # connector punctuation, and Other_ID_Continue.
  pub fun is_id_continue(c: Int) -> Bool
