# std.datetime: reading and writing dates and times as ISO 8601 text,
# by Jiff's grammar (`fmt/temporal/parser.rs`, `printer.rs`), where a
# `Date`, a `Time`, and a `DateTime` each read only their own form
# (DATETIME-DESIGN §8.1).

# ---- Reading -------------------------------------------------------------

# The date at `at` in `s`, and where it ends: a year of four digits, or
# a sign and six; then the month and the day of two digits each, all
# joined by `-` or none at all (Jiff's `parse_date_spec`,
# `fmt/temporal/parser.rs:524`).
fun date_text(s: ?String, at: Int) -> (Int, Date)!
  i, year = year_text(s, at)!
  extended = i < s.len and s[i] == '-'
  i = date_separator(s, i, extended)!
  month = two_digits(s, i)!
  i = date_separator(s, i + 2, extended)!
  day = two_digits(s, i)!
  if not within(month, 1, 12) or not within(day, 1, 31)
    return DateTimeError.invalid
  out = Date.new(year, month, day) catch return DateTimeError.invalid
  return i + 2, out

# The year at `at`, and where it ends (`parse_year`, `parser.rs:693`).
fun year_text(s: ?String, at: Int) -> (Int, Int)!
  if at < s.len and (s[at] == '+' or s[at] == '-')
    v = digits_value(s, at + 1, 6)!
    if v == 0 and s[at] == '-'
      return DateTimeError.invalid
    if v > MAX_YEAR
      return DateTimeError.invalid
    return at + 7, (-v if s[at] == '-' else v)
  return at + 4, digits_value(s, at, 4)!

# Past the `-` between a date's parts when `extended`, else where it is
# (`parse_date_separator`, `parser.rs:858`).
fun date_separator(s: ?String, at: Int, extended: Bool) -> Int!
  if not extended
    if at < s.len and s[at] == '-'
      return DateTimeError.invalid
    return at
  if at >= s.len or s[at] != '-'
    return DateTimeError.invalid
  at + 1

# The time of day at `at` in `s`, where it ends, and whether its parts
# are joined by `:`: the hour, then the minute and the second, each of
# two digits, and a fraction of one to nine digits after `.` or `,`.
# A second of 60 is read as 59 (`parse_time_spec`, `parser.rs:560`).
fun time_text(s: ?String, at: Int) -> (Int, Time, Bool)!
  hour = two_digits(s, at)!
  if hour > 23
    return DateTimeError.invalid
  i = at + 2
  extended = i < s.len and s[i] == ':'
  more = false
  i, more = time_separator(s, i, extended)
  if not more
    return i, clock(hour, 0, 0, 0), extended
  minute = two_digits(s, i)!
  if minute > 59
    return DateTimeError.invalid
  i, more = time_separator(s, i + 2, extended)
  if not more
    return i, clock(hour, minute, 0, 0), extended
  second = two_digits(s, i)!
  if second > 60
    return DateTimeError.invalid
  i += 2
  ns = 0
  if i < s.len and (s[i] == '.' or s[i] == ',')
    i, ns = fraction_text(s, i + 1)!
  return i, clock(hour, minute, 59 if second == 60 else second, ns), extended

# Whether another part of a time follows at `at`, and where it starts
# (`parse_time_separator`, `parser.rs:892`): in the extended form, after
# a `:`; in the basic form, where two digits follow.
fun time_separator(s: ?String, at: Int, extended: Bool) -> (Int, Bool)
  if not extended
    return at, at + 2 <= s.len and is_digit(s[at]) and is_digit(s[at + 1])
  if at < s.len and s[at] == ':'
    return at + 1, true
  return at, false

# The fraction of a second from `at`, one to nine digits, as
# nanoseconds, and where it ends (`parse_temporal_fraction`,
# `fmt/util.rs:727`).
fun fraction_text(s: ?String, at: Int) -> (Int, Int)!
  i = at
  v = 0
  while i < s.len and i - at < 9 and is_digit(s[i])
    v = v * 10 + Int(s[i] - '0')
    i += 1
  if i == at
    return DateTimeError.invalid
  for _ in i - at..9
    v *= 10
  return i, v

# Whether the start of a time written in the basic form, `consumed`,
# also reads as a month and day or as a year and month, which ISO 8601
# leaves ambiguous (`parse_temporal_time`, `parser.rs:335`, by
# `parse_month_day` and `parse_year_month`).
fun ambiguous(s: ?String) -> Bool
  month_day(s) or year_month(s)

fun month_day(s: ?String) -> Bool
  month = two_digits(s, 0) catch return false
  i = 2
  if i < s.len and s[i] == '-'
    i += 1
  day = two_digits(s, i) catch return false
  within(month, 1, 12) and within(day, 1, 31) and day <= month_days(2024, month)

fun year_month(s: ?String) -> Bool
  i, _ = year_text(s, 0) catch return false
  if i < s.len and s[i] == '-'
    i += 1
  month = two_digits(s, i) catch return false
  within(month, 1, 12)

# The offset from UTC at `at` in `s`, in seconds east of it, and where
# it ends: `Z` or `z` when `subminute`; else a sign and the hours, then
# the minutes, each of two digits, joined by `:` or none at all, and
# when `subminute` the seconds, with a fraction rounded to the nearest
# second. At most 25:59:59, and with no seconds after the minutes when
# not `subminute`, as in a zone in brackets (Jiff's `offset::Parser`,
# `fmt/offset.rs:422` to `:658`).
fun offset_text(s: ?String, at: Int, subminute: Bool) -> (Int, Int)!
  if at >= s.len
    return DateTimeError.invalid
  if subminute and (s[at] == 'Z' or s[at] == 'z')
    return at + 1, 0
  if s[at] != '+' and s[at] != '-'
    return DateTimeError.invalid
  sign = -1 if s[at] == '-' else 1
  hours = two_digits(s, at + 1)!
  if hours > 25
    return DateTimeError.invalid
  i = at + 3
  extended = i < s.len and s[i] == ':'
  more = false
  i, more = time_separator(s, i, extended)
  if not more
    return i, sign * hours * 3600
  minutes = two_digits(s, i)!
  if minutes > 59
    return DateTimeError.invalid
  i += 2
  total = hours * 3600 + minutes * 60
  if not subminute
    if i < s.len and s[i] == ':'
      return DateTimeError.invalid
    return i, sign * total
  i, more = time_separator(s, i, extended)
  if not more
    return i, sign * total
  seconds = two_digits(s, i)!
  if seconds > 59
    return DateTimeError.invalid
  i += 2
  total += seconds
  if i < s.len and (s[i] == '.' or s[i] == ',')
    frac = 0
    i, frac = fraction_text(s, i + 1)!
    if frac >= 500_000_000
      total += 1
  if total > 93_599
    return DateTimeError.invalid
  return i, sign * total

# Where the annotations of RFC 9557 at `at` in `s` end: a zone in
# brackets, its name or its offset, then any `[key=value]`, each with a
# `!` that marks it critical or not. Each is checked as written and none
# is used; a critical `[!key=value]` fails, since none is understood
# (Jiff's `rfc9557::Parser`, `fmt/rfc9557.rs:238`).
fun annotations_text(s: ?String, at: Int) -> Int!
  i = zone_annotation(s, at)!
  while i < s.len and s[i] == '['
    i = key_annotation(s, i)!
  i

# Past a zone in brackets at `at`, `[America/Denver]` or `[-07:00]`; `at`
# when there is none, or the brackets hold a key and a value
# (`parse_time_zone_annotation`, `rfc9557.rs:261`).
fun zone_annotation(s: ?String, at: Int) -> Int!
  if at >= s.len or s[at] != '['
    return at
  i = at + 1
  if i < s.len and s[i] == '!'
    i += 1
  if i < s.len and (s[i] == '+' or s[i] == '-')
    j, _ = offset_text(s, i, false)!
    return close_bracket(s, j)!
  i = zone_component(s, i)!
  if i < s.len and s[i] == '='
    return at
  while i < s.len and s[i] == '/'
    i = zone_component(s, i + 1)!
  close_bracket(s, i)!

# Past one part of a zone's name at `at`: a letter, `.`, or `_`, then
# any of those, a digit, `+`, or `-`.
fun zone_component(s: ?String, at: Int) -> Int!
  if at >= s.len or not (is_alpha(s[at]) or s[at] == '.' or s[at] == '_')
    return DateTimeError.invalid
  i = at + 1
  while i < s.len and (is_alpha(s[i]) or is_digit(s[i]) or s[i] == '.' or s[i] == '_' or s[i] == '+' or s[i] == '-')
    i += 1
  i

# Past `[key=value]` at `at`, its key a lowercase letter or `_`, then
# any of those, a digit, or `-`; its value letters and digits, in parts
# joined by `-` (`parse_annotation`, `rfc9557.rs:331`).
fun key_annotation(s: ?String, at: Int) -> Int!
  i = at + 1
  critical = i < s.len and s[i] == '!'
  if critical
    i += 1
  if i >= s.len or not (is_lower(s[i]) or s[i] == '_')
    return DateTimeError.invalid
  i += 1
  while i < s.len and (is_lower(s[i]) or is_digit(s[i]) or s[i] == '_' or s[i] == '-')
    i += 1
  if i >= s.len or s[i] != '='
    return DateTimeError.invalid
  i = value_component(s, i + 1)!
  while i < s.len and s[i] == '-'
    i = value_component(s, i + 1)!
  i = close_bracket(s, i)!
  if critical
    return DateTimeError.invalid
  i

fun value_component(s: ?String, at: Int) -> Int!
  i = at
  while i < s.len and (is_alpha(s[i]) or is_digit(s[i]))
    i += 1
  if i == at
    return DateTimeError.invalid
  i

fun close_bracket(s: ?String, at: Int) -> Int!
  if at >= s.len or s[at] != ']'
    return DateTimeError.invalid
  at + 1

fun is_alpha(b: U8) -> Bool
  is_lower(b) or (b >= 'A' and b <= 'Z')

fun is_lower(b: U8) -> Bool
  b >= 'a' and b <= 'z'

# The two digits at `at` as a number.
fun two_digits(s: ?String, at: Int) -> Int!
  digits_value(s, at, 2)!

# The `n` digits at `at` as a number; fails unless all `n` are digits.
fun digits_value(s: ?String, at: Int, n: Int) -> Int!
  if at + n > s.len
    return DateTimeError.invalid
  v = 0
  for i in at..at + n
    if not is_digit(s[i])
      return DateTimeError.invalid
    v = v * 10 + Int(s[i] - '0')
  v

fun is_digit(b: U8) -> Bool
  b >= '0' and b <= '9'

# ---- Writing -------------------------------------------------------------

# `d` in ISO 8601: a year of four digits, or below 0 its sign and six
# (Jiff's `DateTimePrinter`, `fmt/temporal/printer.rs`).
sub print_date(out: !Printer, d: Date)
  y = Int(d.y)
  if y < 0
    !out.text("-")
    pad(!out, -y, 6)
  else
    pad(!out, y, 4)
  !out.text("-")
  pad(!out, Int(d.m), 2)
  !out.text("-")
  pad(!out, Int(d.d), 2)

# `t` as `HH:MM:SS`, then a fraction when it is not zero, without its
# trailing zeros.
sub print_time(out: !Printer, t: Time)
  pad(!out, Int(t.h), 2)
  !out.text(":")
  pad(!out, Int(t.m), 2)
  !out.text(":")
  pad(!out, Int(t.s), 2)
  f = Int(t.ns)
  if f == 0
    return
  !out.text(".")
  digit = 100_000_000
  while f != 0
    !out.value(f / digit)
    f = f % digit
    digit = digit / 10

# `n`, not negative, with zeros before it to `width` digits.
sub pad(out: !Printer, n: Int, width: Int)
  limit = 10
  for _ in 1..width
    if n < limit
      !out.text("0")
    limit *= 10
  !out.value(n)
