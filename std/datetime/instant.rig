# std.datetime: instants on the shared timeline, and the wall clock.

use std.time

# The range of instants, in whole seconds from 1970-01-01T00:00Z:
# -9999-01-02T01:59:59Z and 9999-12-30T22:00:00Z, narrower than the
# dates by 25:59:59 at each end, so that every instant has a date under
# every offset (DATETIME-DESIGN §7.1; jiff-core `bounds.rs`,
# `UnixEpochSeconds`).
MIN_UNIX_S = -377_705_023_201
MAX_UNIX_S = 253_402_207_200
DAY_S = 86_400

# An exact point on the shared timeline, to the nanosecond, the same
# everywhere: its date and time of day are those of a zone. It runs from
# -9999-01-02T01:59:59Z to 9999-12-30T22:00:00.999999999Z. `==` compares
# two, `<` orders them, a `Map` keys on one, and `print` writes RFC 3339
# in UTC, `2026-11-17T15:07:03.512094Z`: the seconds always, and a
# fraction only when it is not zero, without its trailing zeros.
pub obj Instant: Eq + Ord + Hash + Print
  # The whole seconds since 1970-01-01T00:00Z, floored, and the
  # nanoseconds after them, 0 to 999,999,999.
  s: Int
  ns: U32

  # The first and the last instant: -009999-01-02T01:59:59Z and
  # 9999-12-30T22:00:00.999999999Z.
  pub fun min() -> Instant
    Instant(s: MIN_UNIX_S, ns: 0)

  pub fun max() -> Instant
    Instant(s: MAX_UNIX_S, ns: 999_999_999)

  # The instant `s` seconds and `ns` nanoseconds after
  # 1970-01-01T00:00Z, before it when negative, as Unix tools count:
  # `Instant.from_unix_s(1_700_000_000)`. The two may differ in sign and
  # are summed: `from_unix_s(0, ns: -1)` is
  # 1969-12-31T23:59:59.999999999Z. Fails with `DateTimeError.range`
  # beyond the range of instants and for an `ns` outside ±999,999,999.
  # With constant arguments it is checked as Rig compiles and takes no
  # `!`.
  pub fun from_unix_s(s: Int, ns: Int = 0) -> Instant!
    if ns <= -SECOND_NS or ns >= SECOND_NS
      return DateTimeError.range
    instant_of(I128(s) * I128(SECOND_NS) + I128(ns)) ?? return DateTimeError.range

  # The instant `ms` milliseconds after 1970-01-01T00:00Z, a JavaScript
  # or Java time, and `us` microseconds after it. Fail with
  # `DateTimeError.range` beyond the range of instants; with a constant
  # argument each is checked as Rig compiles and takes no `!`.
  pub fun from_unix_ms(ms: Int) -> Instant!
    instant_of(I128(ms) * 1_000_000) ?? return DateTimeError.range

  pub fun from_unix_us(us: Int) -> Instant!
    instant_of(I128(us) * 1_000) ?? return DateTimeError.range

  # The instant `ns` nanoseconds after 1970-01-01T00:00Z: an `Int` of
  # them reaches the years 1677 to 2262, inside the range, so it does
  # not fail. Go's `UnixNano` read back.
  pub fun from_unix_ns(ns: Int) -> Instant
    Instant(s: floor_div(ns, SECOND_NS), ns: U32(floor_mod(ns, SECOND_NS)))

  # The instant `s` seconds after 1970-01-01T00:00Z, a `Float` as
  # Python's `time.time()` and many JSON APIs write it, to the nearest
  # nanosecond, a half away from zero. A `Float` near 1.7e9 resolves
  # only about 240 ns, so a finer time is given as `Int`s. Fails with
  # `DateTimeError.invalid` for a NaN and `DateTimeError.range` for an
  # infinity or a time beyond the range of instants.
  pub fun from_unix_float(s: Float) -> Instant!
    if s != s
      return DateTimeError.invalid
    if s < Float(MIN_UNIX_S - 1) or s > Float(MAX_UNIX_S + 1)
      return DateTimeError.range
    whole = Int(s)
    n = (s - Float(whole)) * 1e9
    ns = Int(n)
    rest = n - Float(ns)
    if rest >= 0.5
      ns += 1
    else if rest <= -0.5
      ns -= 1
    instant_of(I128(whole) * I128(SECOND_NS) + I128(ns)) ?? return DateTimeError.range

  # The instant `text` writes in RFC 3339: a date, `T`, `t`, or a space,
  # a time of day, and an offset, `Z`, `z`, or a sign and the hours, then
  # the minutes and the seconds, each with `:` or without:
  # `2026-11-17T15:07:03.5Z`, `2026-11-17 08:07:03,5-07:00`. A zone in
  # brackets after the offset is read and not used, since the offset
  # alone gives the instant: `…-07:00[America/Denver]`. A second of 60 is
  # read as 59, and a fraction of a second in the offset is rounded to
  # the second. Fails with `DateTimeError.invalid`, also for text with no
  # offset and for an instant beyond the range.
  pub fun parse(text: ?String) -> Instant!
    i, d = date_text(text, 0)!
    if i == text.len or (text[i] != 'T' and text[i] != 't' and text[i] != ' ')
      return DateTimeError.invalid
    j, t, _ = time_text(text, i + 1)!
    k, offset = offset_text(text, j, true)!
    k = annotations_text(text, k)!
    if k != text.len
      return DateTimeError.invalid
    secs = I128(d.number()) * I128(DAY_S) + I128(t.total() / SECOND_NS) - I128(offset)
    instant_of(secs * I128(SECOND_NS) + I128(t.ns)) ?? return DateTimeError.invalid

  # The duration since 1970-01-01T00:00Z, negative before it, exact at
  # any instant: `i.unix().seconds()`, truncated toward zero, or
  # `i.unix().ns()`, an `I128`.
  pub fun unix(?@) -> time.Duration
    span(@total())

  # The whole seconds, milliseconds, and microseconds since
  # 1970-01-01T00:00Z, each floored, as Unix tools count them: half a
  # second before 1970 is -1 second. Exact at any instant, and each the
  # inverse of its maker.
  pub fun unix_s(?@) -> Int
    @s

  pub fun unix_ms(?@) -> Int
    @s * 1_000 + Int(@ns) / 1_000_000

  pub fun unix_us(?@) -> Int
    @s * 1_000_000 + Int(@ns) / 1_000

  # The instant a duration later, or earlier when it is negative:
  # `i.add(90)!`, `i.add(hours: 1, minutes: 30)!`. Fails with
  # `DateTimeError.range` beyond the range. An instant has no calendar: a
  # day on the clock is a zone's.
  pub fun add(?@, d: time.Duration) -> Instant!
    instant_of(@total() + d.ns()) ?? return DateTimeError.range

  # The time from `other` to this instant, negative when `other` is the
  # later; exact for any two instants.
  pub fun since(?@, other: Instant) -> time.Duration
    span(@total() - other.total())

  # The nearest multiple of one unit's increment, counted from
  # 1970-01-01T00:00Z, a half going to the later, before 1970 too:
  # `i.round(seconds: 1)!` prints without a fraction. A call names
  # exactly one unit, from `ns:` to `hours:`, and an increment that
  # divides a day, `minutes: 15`, `hours: 6`, checked where it is called
  # when it is a constant; another fails with `DateTimeError.invalid`,
  # and a result beyond the range with `DateTimeError.range`.
  pub fun round(?@, ns: Int? = none, us: Int? = none, ms: Int? = none, seconds: Int? = none, minutes: Int? = none, hours: Int? = none) -> Instant!
    instant_multiple(@, instant_increment([ns, us, ms, seconds, minutes, hours])!, false) ?? return DateTimeError.range

  # The multiple of one unit's increment at or before the instant:
  # `i.floor(hours: 1)!`. Its argument and its failures are `round`'s.
  pub fun floor(?@, ns: Int? = none, us: Int? = none, ms: Int? = none, seconds: Int? = none, minutes: Int? = none, hours: Int? = none) -> Instant!
    instant_multiple(@, instant_increment([ns, us, ms, seconds, minutes, hours])!, true) ?? return DateTimeError.range

  sub print(?@, out: !Printer)
    print_date(!out, date_of(floor_div(@s, DAY_S)))
    !out.text("T")
    print_time(!out, time_at(floor_mod(@s, DAY_S) * SECOND_NS + Int(@ns)))
    !out.text("Z")

  # The nanoseconds since 1970-01-01T00:00Z.
  fun total(?@) -> I128
    I128(@s) * I128(SECOND_NS) + I128(@ns)

# The wall clock now: the system's idea of the current instant, which
# can be set, so it may jump; to time something, `time.monotonic()`.
# It is the real clock under the deterministic scheduler too. It reads
# an `Int` of nanoseconds since 1970, inside the range, so it does not
# fail.
pub fun now() -> Instant
  Instant.from_unix_ns(wall_ns())

# The instant `n` nanoseconds after 1970-01-01T00:00Z, or `none` beyond
# the range.
fun instant_of(n: I128) -> Instant?
  s = n / I128(SECOND_NS)
  r = n % I128(SECOND_NS)
  if r < 0
    s -= 1
    r += I128(SECOND_NS)
  if s < I128(MIN_UNIX_S) or s > I128(MAX_UNIX_S)
    return none
  Instant(s: Int(s), ns: U32(r))

# `n` nanoseconds as a `Duration`, for the span between two instants or
# two dates and times, which a `Duration` always holds: the standard
# library makes one from its parts.
fun span(n: I128) -> time.Duration
  time.Duration(s: Int(n / I128(SECOND_NS)), nano: I32(n % I128(SECOND_NS)))

# The nanoseconds of the one unit and increment `round` or `floor` is
# given, as `[ns, us, ms, seconds, minutes, hours]`: from 1 to
# 1,000,000,000, and dividing a day (Jiff's `Increment::for_timestamp`,
# `util/round.rs:148`); `DateTimeError.invalid` for anything else.
fun instant_increment(given: [6]Int?) -> I128!
  units = [1, 1_000, 1_000_000, SECOND_NS, MINUTE_NS, HOUR_NS]
  out: I128 = 0
  for i in 0..6
    if given[i] == none
      continue
    k = given[i] ?? 0
    if out != 0 or k < 1 or k > 1_000_000_000 or (DAY_NS / units[i]) % k != 0
      return DateTimeError.invalid
    out = I128(k) * I128(units[i])
  if out == 0
    return DateTimeError.invalid
  out

# `i` rounded, a half going to the later, or with `down` floored, to a
# multiple of `inc` nanoseconds from 1970-01-01T00:00Z (Jiff's
# `TimestampRound::round`, `timestamp.rs:3471`, with a half before 1970
# going to the later too: DATETIME-DESIGN §6.8); `none` beyond the
# range.
fun instant_multiple(i: Instant, inc: I128, down: Bool) -> Instant?
  t = i.total()
  q = t / inc
  r = t % inc
  if r < 0
    q -= 1
    r += inc
  if not down and r * 2 >= inc
    q += 1
  instant_of(q * inc)

extern zig "datetime.zig"
  # Nanoseconds since 1970-01-01T00:00Z on the wall clock.
  fun wall_ns() -> Int
