# std.sort: sorting slices and searching sorted ones, written in Rig.
# Every function takes a slice, `![]T` to sort or `[]T` to search: pass
# an array or a List as `!a` or `?a`. Order is
# `<`'s, or a comparator's. A float provides no `Ord`, since a NaN is
# neither below nor above a number: sort floats with `sort_by` and
# `total_order`, `sort_by(!xs, |a, b| a.total_order(?b) == .less)`.

use std.math

# Sort `xs` in place, in the order of `<`, keeping equal elements that
# can be told apart in the order they had. Allocates as `sort_by` does
# when equal elements can be told apart, and otherwise nothing.
pub sub sort[T: Ord](xs: ![]T)
  # Where elements `<` finds equal are the same value, their order cannot
  # be seen, and pattern-defeating quicksort, which does not keep it,
  # sorts them; the stable merge sorts the rest.
  if equal_is_same[T]()
    unstable(!xs)
  else
    sort_by(!xs, |a, b| a < b)

# Sort `xs` in place in the order `less` gives: `less(a, b)` says
# whether `a` belongs before `b`. Keeps elements neither of which is
# less than the other in the order they had. Allocates room for half of
# `xs`, or all of it while that takes at most 8 MB, freed before it
# returns, unless `xs` holds at most 20 elements or is in order already
# (or strictly in reverse order); when memory runs out, the program
# panics, as at any allocation.
pub inline sub sort_by[T](xs: ![]T, less: ?fun(?T, ?T) -> Bool)
  # driftsort (Orson Peters and Lukas Bergdoll, as Rust's `sort`): runs
  # found and merged in powersort's order (Munro and Wild), and input with
  # no long runs sorted by a stable quicksort through the room, in pieces
  # as large as the room, which the merges then join. O(n log n)
  # comparisons; O(n) on input in order or in reverse, and O(n log k) on
  # input of k distinct values. Everything this calls with `less` is
  # inline, with no recursion, so the whole sort compiles into its
  # caller, where `less` is inlined too.
  n = xs.len
  if n <= 20
    insertion_by(!xs, 0, n, less)
    return
  # A run is its length times 2, plus 1 when it is sorted. A run too
  # short to keep is left unsorted, and two unsorted runs that fit in
  # the room together become one: so a stretch with no runs is sorted
  # by the quicksort once, as long as the room, and not merged up from
  # small pieces.
  room = Room(addr: 0, cap: 0, bytes: 0)
  s_len = scratch_len[T](n)
  eager = n <= 64
  good = math.min(n - n / 2, 64) if n <= 4096 else sqrt_about(n)
  scale = ((U64(1) << 62) + U64(n) - 1) / U64(n)
  # The runs not yet merged, each with the depth in powersort's tree of
  # the boundary after it, deeper up the stack; the first an empty run.
  runs: [66]Int = [66 of 0]
  depths: [66]U8 = [66 of 0]
  top = 0
  scan = 0
  prev = 1
  loop
    next = 1
    depth: U8 = 0
    if scan < n
      next = create_run(!xs, scan, good, eager, !room, s_len, less)
      depth = U8(((U64(scan - (prev >> 1) + scan) * scale) ^ (U64(scan + scan + (next >> 1)) * scale)).leading_zeros())
    # At the end every run merges, into the empty one too, which sorts
    # what is still unsorted.
    while top > (1 if scan < n else 0) and depths[top - 1] >= depth
      left = runs[top - 1]
      merged = (left >> 1) + (prev >> 1)
      prev = logical_merge(!xs, scan - merged, left, prev, !room, s_len, less)
      top -= 1
    runs[top] = prev
    depths[top] = depth
    top += 1
    if scan >= n
      break
    scan += next >> 1
    prev = next

# Sort `xs` in place in the order of the key `key` gives each element,
# by `<`, keeping elements of equal keys in the order they had.
# Allocates as `sort_by` does; `key` is called twice for each comparison.
pub inline sub sort_by_key[T, K: Ord](xs: ![]T, key: ?fun(?T) -> K)
  # Each key is bound to a name, which drops a key that owns a resource.
  sort_by(!xs, |?key, a, b|
    ka = key(a)
    kb = key(b)
    ka < kb
  )

# Memory for the elements a stable sort moves out of the slice it sorts,
# none of which the room owns: its drop frees the memory and drops no
# element. Empty until the sort first needs it: `cap` slots, the
# scratch the quicksort partitions through and the merges move runs to,
# then 48 for the quicksort's pivots.
obj Room
  addr: Int
  cap: Int
  bytes: Int

  drop(!@)
    room_free(@addr, @bytes)

# Make `room` hold `s_len` slots of scratch and 48 for pivots.
inline sub fill_room[T](room: !Room, s_len: Int)
  if room.cap == 0
    room.cap = s_len + 48
    room.addr = room_alloc[T](room.cap)
    room.bytes = room_bytes[T](room.cap)

# About the square root of `n`: 2 to half its bits, one Newton step.
fun sqrt_about(n: Int) -> Int
  shift = (64 - U64(n | 1).leading_zeros()) / 2
  ((1 << shift) + (n >> shift)) / 2

# The run of `xs` from `a`: a natural one of at least `good` elements,
# sorted (a strictly falling one reversed); else, when `eager`, the next
# 32 elements sorted small; else the next `good`, unsorted.
inline fun create_run[T](xs: ![]T, a: Int, good: Int, eager: Bool, room: !Room, s_len: Int, less: ?fun(?T, ?T) -> Bool) -> Int
  len = xs.len - a
  run = natural_run(!xs, a, good, less)
  if run > 0
    return run * 2 + 1
  if eager
    e = math.min(32, len)
    fill_room[T](!room, s_len)
    buf = room_slots[T](!room)
    small_sort_by(!xs, a, a + e, !buf, less)
    return e * 2 + 1
  math.min(good, len) * 2

# Merge the neighbouring runs `left` and `right` that start at `a`. Two
# unsorted runs that fit in the room together become one unsorted run;
# otherwise each unsorted one is quicksorted and the two merged.
inline fun logical_merge[T](xs: ![]T, a: Int, left: Int, right: Int, room: !Room, s_len: Int, less: ?fun(?T, ?T) -> Bool) -> Int
  m = a + (left >> 1)
  b = m + (right >> 1)
  if b - a <= s_len and left & 1 == 0 and right & 1 == 0
    return (b - a) * 2
  if left & 1 == 1 and right & 1 == 1 and (m == a or m == b)
    return (b - a) * 2 + 1
  fill_room[T](!room, s_len)
  buf = room_slots[T](!room)
  part = 0
  while part < 2 : part += 1
    lo = a if part == 0 else m
    hi = m if part == 0 else b
    if (left if part == 0 else right) & 1 == 0
      quicksort(!xs, lo, hi, !buf, s_len, less)
  merge_by(!xs, a, m, b, !buf, less)
  (b - a) * 2 + 1

# Sort xs[lo..hi], at most `s_len` elements, by a stable quicksort
# through `buf`. Each partition's pivot is a pseudomedian; one not above
# the last pivot that the range lies right of, which every element of
# it is at least, splits off the elements equal to it, which are then
# done. The right part is sorted first and the left pushed, so the
# stack holds at most one entry per partition on a path; after 2
# log2(n) partitions on one path (48 at most), a merge sort finishes
# the range. Pivots are kept, by their bits, in the slots of `buf`
# after `s_len`.
inline sub quicksort[T](xs: ![]T, lo: Int, hi: Int, buf: ![]T, s_len: Int, less: ?fun(?T, ?T) -> Bool)
  new lo = lo
  new hi = hi
  # A pushed range: its start, its end, and its partitions left, the
  # slot of the pivot it lies right of (plus one, 0 for none), and the
  # first free pivot slot, packed in bytes. At most 48 partitions on a
  # path (2 log2(n) up to 2^24 elements), which keeps these arrays, and
  # the frame the sort is inlined into, small.
  starts: [48]Int = [48 of 0]
  ends: [48]Int = [48 of 0]
  marks: [48]Int = [48 of 0]
  top = 0
  limit = math.min(2 * (63 - U64((hi - lo) | 1).leading_zeros()), 48)
  pivot = -1
  free = 0
  loop
    len = hi - lo
    if len <= 32
      small_sort_by(!xs, lo, hi, !buf, less)
    else if limit == 0
      merge_sort_by(!xs, lo, hi, !buf, less)
    else
      limit -= 1
      p = pivot_by(?xs, lo, hi, less)
      same = pivot >= 0 and not less(?buf[s_len + pivot], ?xs[p])
      below = 0
      if not same
        move_one(!buf, s_len + free, ?xs, p)
        below = partition_lt(!xs, lo, hi, p, !buf, less)
        same = below == 0
      if same
        lo += partition_le(!xs, lo, hi, p, !buf, less)
        pivot = -1
        continue
      starts[top] = lo
      ends[top] = lo + below
      marks[top] = limit | (pivot + 1) << 8 | free << 16
      top += 1
      lo += below
      pivot = free
      free += 1
      continue
    if top == 0
      return
    top -= 1
    lo = starts[top]
    hi = ends[top]
    limit = marks[top] & 255
    pivot = (marks[top] >> 8 & 255) - 1
    free = marks[top] >> 16

# Pattern-defeating quicksort (Orson Peters' pdqsort, as Rust's
# `sort_unstable` and Zig's `std.sort.pdq`): quicksort on a median of
# three or of nine, partitioned in blocks; insertion sort below 25
# elements; a run of equal elements split off in one pass; a sorted or
# reversed slice found in O(n); and heapsort after too many unbalanced
# partitions, so O(n log n) at worst. O(log n) stack, no other memory.
sub unstable[T: Ord](xs: ![]T)
  n = xs.len
  if n < 2
    return
  limit = 0
  m = n
  while m > 1 : m /= 2
    limit += 1
  pdq(!xs, 0, n, limit + 1, true, true, true)

# Sort xs[a..b]. `leftmost` is false when xs[a - 1] exists and is not
# above any element of xs[a..b]; `balanced` and `partitioned` say how the
# last partition went; `limit` counts the unbalanced partitions left.
sub pdq[T: Ord](xs: ![]T, a: Int, b: Int, limit: Int, leftmost: Bool, balanced: Bool, partitioned: Bool)
  new a = a
  new b = b
  new limit = limit
  new leftmost = leftmost
  new balanced = balanced
  new partitioned = partitioned
  loop
    len = b - a
    if len <= 24
      if leftmost
        insert_ord(!xs[a..b])
      else
        insert_unguarded(!xs, a, b)
      return
    if limit == 0
      heapsort(!xs, a, b)
      return
    if not balanced
      break_patterns(!xs, a, b)
      limit -= 1
    pivot = a + len / 4 * 2
    swaps = choose_pivot(!xs, a, b)
    likely_sorted = swaps == 0
    if swaps == 12
      # Every comparison swapped: likely reversed, so reverse it.
      k = 0
      while k < len / 2 : k += 1
        !xs.swap(a + k, b - 1 - k)
      pivot = b - 1 - (pivot - a)
      likely_sorted = true
    if balanced and partitioned and likely_sorted
      if partial_insertion(!xs, a, b)
        return
    # A pivot not above the element before the slice is the slice's
    # least: split off the elements equal to it, then sort the rest.
    if not leftmost and not (xs[a - 1] < xs[pivot])
      a = partition_equal(!xs, a, b, pivot)
      continue
    p = partition(!xs, a, b, pivot)
    mid = p.mid
    left = mid - a
    right = b - (mid + 1)
    partitioned = p.partitioned
    balanced = math.min(left, right) >= len / 8
    # Recurse into the smaller side, loop on the larger, so the stack
    # holds at most log2(n) frames.
    if left < right
      pdq(!xs, a, mid, limit, leftmost, true, partitioned)
      a = mid + 1
      leftmost = false
    else
      pdq(!xs, mid + 1, b, limit, false, true, partitioned)
      b = mid

sub insert_ord[T: Ord](xs: ![]T)
  i = 1
  while i < xs.len : i += 1
    j = i
    while j > 0 and xs[j] < xs[j - 1] : j -= 1
      !xs.swap(j, j - 1)

# Insertion sort of xs[a..b], where xs[a - 1] is not above any of them,
# so no element moves before `a`.
sub insert_unguarded[T: Ord](xs: ![]T, a: Int, b: Int)
  i = a + 1
  while i < b : i += 1
    j = i
    while xs[j] < xs[j - 1] : j -= 1
      !xs.swap(j, j - 1)

sub heapsort[T: Ord](xs: ![]T, a: Int, b: Int)
  i = a + (b - a) / 2
  while i > a
    i -= 1
    sift_down(!xs, a, i, b)
  i = b
  while i > a
    i -= 1
    !xs.swap(a, i)
    sift_down(!xs, a, a, i)

sub sift_down[T: Ord](xs: ![]T, a: Int, at: Int, b: Int)
  cur = at
  loop
    child = 2 * (cur - a) + a + 1
    if child >= b
      return
    if child + 1 < b and xs[child] < xs[child + 1]
      child += 1
    if not (xs[cur] < xs[child])
      return
    !xs.swap(cur, child)
    cur = child

# Swap three elements near the middle of xs[a..b] with others chosen by
# a fixed xorshift, to break a pattern that unbalanced the partitions.
sub break_patterns[T](xs: ![]T, a: Int, b: Int)
  len = b - a
  if len < 8
    return
  r = U64(len)
  modulus = 1
  while modulus < len
    modulus *= 2
  i = a + len / 4 * 2 - 1
  while i <= a + len / 4 * 2 + 1 : i += 1
    r ^= r <<% 13
    r ^= r >> 7
    r ^= r <<% 17
    other = Int(r & U64(modulus - 1))
    if other >= len
      other -= len
    !xs.swap(i, a + other)

# Order the elements at a quarter, a half, and three quarters of xs[a..b]
# (each first the median of its neighbourhood, from 50 elements), leaving
# their median in the middle. The number of swaps: 0 when the slice looks
# sorted, 12 when it looks reversed.
fun choose_pivot[T: Ord](xs: ![]T, a: Int, b: Int) -> Int
  len = b - a
  i = a + len / 4
  j = a + len / 4 * 2
  k = a + len / 4 * 3
  swaps = 0
  if len >= 8
    if len >= 50
      swaps += sort3(!xs, i - 1, i, i + 1)
      swaps += sort3(!xs, j - 1, j, j + 1)
      swaps += sort3(!xs, k - 1, k, k + 1)
    swaps += sort3(!xs, i, j, k)
  swaps

fun sort3[T: Ord](xs: ![]T, a: Int, b: Int, c: Int) -> Int
  swaps = 0
  if xs[b] < xs[a]
    swaps += 1
    !xs.swap(b, a)
  if xs[c] < xs[b]
    swaps += 1
    !xs.swap(c, b)
    if xs[b] < xs[a]
      swaps += 1
      !xs.swap(b, a)
  swaps

# Shift a few out-of-order elements of xs[a..b] into place; whether the
# slice is sorted after. O(n).
fun partial_insertion[T: Ord](xs: ![]T, a: Int, b: Int) -> Bool
  i = a + 1
  step = 0
  while step < 5 : step += 1
    while i < b and not (xs[i] < xs[i - 1])
      i += 1
    if i == b
      return true
    if b - a < 50
      return false
    !xs.swap(i, i - 1)
    if i - a >= 2
      j = i - 1
      while j > a and xs[j] < xs[j - 1] : j -= 1
        !xs.swap(j, j - 1)
    if b - i >= 2
      j = i + 1
      while j < b and xs[j] < xs[j - 1] : j += 1
        !xs.swap(j, j - 1)
  false

obj Split
  mid: Int
  partitioned: Bool

# Partition xs[a..b] around xs[pivot]: the elements below it, then it,
# then the rest. Where it lands, and whether no element had to move.
# Elements are classified 64 at a time from each end, and the misplaced
# ones of both blocks then swapped in pairs (BlockQuicksort), so the
# comparisons do not branch.
fun partition[T: Ord](xs: ![]T, a: Int, b: Int, pivot: Int) -> Split
  !xs.swap(a, pivot)
  i = a + 1
  j = b - 1
  while i <= j and xs[i] < xs[a]
    i += 1
  while i <= j and not (xs[j] < xs[a])
    j -= 1
  if i > j
    !xs.swap(j, a)
    return Split(mid: j, partitioned: true)
  !xs.swap(i, j)
  i += 1
  j -= 1
  # Offsets within a block, below 64, as bytes, so the arrays cost
  # little to clear.
  offsets_l: [64]U8 = [64 of 0]
  offsets_r: [64]U8 = [64 of 0]
  base_l = i
  base_r = j
  num_l = 0
  num_r = 0
  start_l = 0
  start_r = 0
  while i <= j
    unknown = j + 1 - i
    split_l = 0
    if num_l == 0
      split_l = math.min(64, unknown / 2 if num_r == 0 else unknown)
    split_r = 0
    if num_r == 0
      split_r = math.min(64, unknown - split_l)
    k = 0
    while k < split_l : k += 1
      offsets_l[num_l] = U8(k)
      if not (xs[i + k] < xs[a])
        num_l += 1
    i += split_l
    k = 0
    while k < split_r : k += 1
      offsets_r[num_r] = U8(k)
      if xs[j - k] < xs[a]
        num_r += 1
    j -= split_r
    num = math.min(num_l, num_r)
    k = 0
    while k < num : k += 1
      !xs.swap(base_l + Int(offsets_l[start_l + k]), base_r - Int(offsets_r[start_r + k]))
    num_l -= num
    num_r -= num
    start_l += num
    start_r += num
    if num_l == 0
      start_l = 0
      base_l = i
    if num_r == 0
      start_r = 0
      base_r = j
  if num_l > 0
    while num_l > 0
      num_l -= 1
      !xs.swap(base_l + Int(offsets_l[start_l + num_l]), j)
      j -= 1
    i = j + 1
  if num_r > 0
    while num_r > 0
      num_r -= 1
      !xs.swap(base_r - Int(offsets_r[start_r + num_r]), i)
      i += 1
    j = i - 1
  !xs.swap(j, a)
  Split(mid: j, partitioned: false)

# Move the elements of xs[a..b] equal to xs[pivot], the least, to its
# front; the index after them.
fun partition_equal[T: Ord](xs: ![]T, a: Int, b: Int, pivot: Int) -> Int
  !xs.swap(a, pivot)
  i = a + 1
  j = b - 1
  loop
    while i <= j and not (xs[a] < xs[i])
      i += 1
    while i <= j and xs[a] < xs[j]
      j -= 1
    if i > j
      return i
    !xs.swap(i, j)
    i += 1
    j -= 1
  i

# The index where `x` belongs in `xs`, which is sorted in the order of
# `<`: the first element not less than `x`, or `xs.len` when there is
# none. Inserting `x` there keeps `xs` sorted.
pub fun lower_bound[T: Ord](xs: []T, x: ?T) -> Int
  lo = 0
  hi = xs.len
  while lo < hi
    mid = lo + (hi - lo) / 2
    if xs[mid] < x
      lo = mid + 1
    else
      hi = mid
  lo

# The index of an element equal to `x` in `xs`, which is sorted in the
# order of `<`, found by binary search: the first such element; `none`
# when there is none.
pub fun search[T: Ord](xs: []T, x: ?T) -> Int?
  lo = 0
  hi = xs.len
  while lo < hi
    mid = lo + (hi - lo) / 2
    if xs[mid] < x
      lo = mid + 1
    else
      hi = mid
  if lo < xs.len and xs[lo] == x
    return lo
  none

extern zig "sort.zig"
  # Whether two `T`s that `<` finds equal are the same value, so their
  # order cannot be seen: true for numbers, `Bool`, text, plain enums,
  # and the optionals, arrays, objects, and enums made only of these that
  # order as `Ord` derives it; false for a type with an `order` of its
  # own, and for a handle.
  fun equal_is_same[T]() -> Bool

  # A `Room`'s memory for `n` elements, none written; the bytes they
  # take; and its free, which drops no element.
  fun room_alloc[T](n: Int) -> Int
  fun room_bytes[T](n: Int) -> Int
  sub room_free(addr: Int, bytes: Int)
  # The slots of `r`'s memory, as elements of type `T`.
  fun room_slots[T](r: !Room) -> ![]T from r
  # The scratch a stable sort of `n` elements takes: half of them, or
  # all while they take at most 8 MB; at least 48.
  fun scratch_len[T](n: Int) -> Int
  # Move `from[i]` to `to[at]`, as bits, dropping nothing: `to[at]` held
  # no element before.
  sub move_one[T](to: ![]T, at: Int, from: ?[]T, i: Int)

  # The stable sort's kernels (sort.zig): each moves the elements of the
  # range it is given by their bits, every one of them exactly once
  # whatever `less` answers, and `buf` holds none after.
  #
  # Sort xs[lo..hi] by insertion.
  sub insertion_by[T](xs: ![]T, lo: Int, hi: Int, less: ?fun(?T, ?T) -> Bool)
  # The run of xs from `a` if it is at least `good` long (a strictly
  # falling one reversed), else 0.
  fun natural_run[T](xs: ![]T, a: Int, good: Int, less: ?fun(?T, ?T) -> Bool) -> Int
  # Sort xs[lo..hi], at most 32, through `buf`, 16 longer.
  sub small_sort_by[T](xs: ![]T, lo: Int, hi: Int, buf: ![]T, less: ?fun(?T, ?T) -> Bool)
  # The index of a pseudomedian of xs[lo..hi], at least 8 elements.
  fun pivot_by[T](xs: ?[]T, lo: Int, hi: Int, less: ?fun(?T, ?T) -> Bool) -> Int
  # Partition xs[lo..hi] around xs[p] through `buf`, each part in the
  # order it had: those below it first (`_lt`), or those not above it
  # (`_le`); the number of the first part.
  fun partition_lt[T](xs: ![]T, lo: Int, hi: Int, p: Int, buf: ![]T, less: ?fun(?T, ?T) -> Bool) -> Int
  fun partition_le[T](xs: ![]T, lo: Int, hi: Int, p: Int, buf: ![]T, less: ?fun(?T, ?T) -> Bool) -> Int
  # Merge the sorted xs[lo..mid] and xs[mid..hi] through `buf`.
  sub merge_by[T](xs: ![]T, lo: Int, mid: Int, hi: Int, buf: ![]T, less: ?fun(?T, ?T) -> Bool)
  # Sort xs[lo..hi] by merges alone through `buf`.
  sub merge_sort_by[T](xs: ![]T, lo: Int, hi: Int, buf: ![]T, less: ?fun(?T, ?T) -> Bool)
