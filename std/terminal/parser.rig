# The parser of std.terminal: the DEC state machine of vt100.net
# (https://vt100.net/emu/dec_ansi_parser), as Ghostty runs it, turning
# bytes into the operations of terminal.rig. In the ground state bytes are
# UTF-8, read by utf8.Decoder, as Ghostty reads them; in a sequence a byte
# from 0x80 to 0x9F is a C1 control. Strings (OSC, DCS, SOS, PM, and APC)
# are read to their end and ignored so far.

ESC: U8 = b'\x1b'
CAN: U8 = b'\x18'
SUB: U8 = b'\x1a'
DEL: U8 = b'\x7f'

# Where the parser is in a sequence.
enum State
  ground
  escape
  escape_intermediate
  csi_entry
  csi_param
  csi_intermediate
  csi_ignore
  osc
  # DCS: its parameters and intermediates, then its body (passthrough, or
  # ignored when malformed), where C1 bytes are data.
  dcs_entry
  dcs_param
  dcs_intermediate
  dcs_body
  # SOS, PM, and APC, to ST.
  apc

# The most parameters a CSI sequence may have; one with more does nothing.
MAX_PARAMS = 24

# The largest parameter value; a larger one is this.
MAX_PARAM = 65535

# Take `bytes` as a program's output, in order. In the ground state a run
# of printable ASCII goes to `print_run` whole, and one that starts with a
# byte of 0x80 or more to `print_utf8`; a byte it stops at (one that is
# ill-formed UTF-8, or starts a rune cut off at the end of `bytes`), and
# any byte while a rune is under way, goes to the UTF-8 decoder.
pub sub Terminal.feed(!@, bytes: ?String)
  i = 0
  n = bytes.len
  while i < n
    b = bytes[i]
    if @state == .ground
      if not @decoder.pending()
        j = printable_end(bytes, i)
        if j > i
          (!@).print_run(bytes, i, j)
          i = j
          continue
        if b >= 0x80
          j = (!@).print_utf8(bytes, i)
          if j > i
            i = j
            continue
        else
          # The commonest controls, run here without the state machine.
          if b == b'\r'
            (!@).carriage_return()
            if i + 1 < n and bytes[i + 1] == b'\n'
              # CR LF, the commonest line end, at once.
              (!@).index()
              i += 2
              continue
          else if b == b'\n'
            (!@).index()
            (!@).carriage_return() if @newline
          else
            (!@).step(b)
          i += 1
          continue
      if (!@decoder).next(b) as r
        # A UTF-8-encoded C1 control is ignored, as Ghostty does.
        (!@).print(U32(r)) if r > 0x9F
      i += 1 if not @decoder.retry
      continue
    (!@).step(b)
    i += 1

# The first byte at or after `i` that is not printable in the ground state
# (below 0x20, or 0x80 and up), or `s.len`. Most runs between sequences are
# short, so the first 16 bytes are tested one at a time; a longer run is
# tested 16 bytes at once, and its last bytes by reading the last 16 of
# `s` again.
fun printable_end(s: ?String, i: Int) -> Int
  if i >= 0
    k = i
    stop = i + 16 if i + 16 < s.len else s.len
    while k < stop
      b = s[k]
      return k if b < 0x20 or b >= 0x80
      k += 1
    while k + 16 <= s.len
      v = s.read[Simd[U8, 16]](k)
      if ((v < 0x20) | (v >= 0x80)).first() as j
        return k + j
      k += 16
    if k < s.len
      # Fewer than 16 are left: read the last 16 of `s` again, and drop
      # the lanes before `k`, which were tested.
      m = ((s.read[Simd[U8, 16]](s.len - 16) < 0x20) | (s.read[Simd[U8, 16]](s.len - 16) >= 0x80)).bits() >> (k + 16 - s.len)
      return k + m.trailing_zeros() if m != 0
  s.len

sub Terminal.step(!@, b: U8)
  if b >= 0x80
    (!@).high(b)
    return
  if b == ESC
    (!@).clear()
    @state = .escape
    return
  if b == CAN or b == SUB
    @state = .ground
    return
  match @state
    .ground
      # Ghostty prints DEL as a character, where xterm ignores it.
      if b >= 0x20
        (!@).print(U32(b))
      else
        (!@).execute(b)
    .escape
      if b < 0x20
        (!@).execute(b)
      else if b < 0x30
        (!@).collect(b)
        @state = .escape_intermediate
      else if b == b'['
        @state = .csi_entry
      else if b == b']'
        @state = .osc
      else if b == b'P'
        (!@).clear()
        @state = .dcs_entry
      else if b == b'X' or b == b'^' or b == b'_'
        @state = .apc
      else if b != DEL
        @state = .ground
        (!@).esc_dispatch(b)
    .escape_intermediate
      if b < 0x20
        (!@).execute(b)
      else if b < 0x30
        (!@).collect(b)
      else if b != DEL
        @state = .ground
        (!@).esc_dispatch(b)
    .csi_entry
      if b < 0x20
        (!@).execute(b)
      else if b < 0x30
        (!@).collect(b)
        @state = .csi_intermediate
      else if b == b':'
        @state = .csi_ignore
      else if b < 0x3C
        (!@).param(b)
        @state = .csi_param
      else if b < 0x40
        (!@).collect(b)
        @state = .csi_param
      else if b != DEL
        (!@).csi_final(b)
    .csi_param
      # Ghostty executes only C0 bytes below 0x10 here, and drops the rest.
      if b < 0x10
        (!@).execute(b)
      else if b < 0x20
        pass
      else if b < 0x30
        (!@).collect(b)
        @state = .csi_intermediate
      else if b < 0x3C
        (!@).param(b)
      else if b < 0x40
        @state = .csi_ignore
      else if b != DEL
        (!@).csi_final(b)
    .csi_intermediate
      if b < 0x20
        (!@).execute(b)
      else if b < 0x30
        (!@).collect(b)
      else if b < 0x40
        @state = .csi_ignore
      else if b != DEL
        (!@).csi_final(b)
    .csi_ignore
      if b < 0x20
        (!@).execute(b)
      else if b >= 0x40 and b != DEL
        @state = .ground
    .osc
      @state = .ground if b == b'\x07' else .osc
    .dcs_entry
      if b >= 0x20 and b != DEL
        if b < 0x30
          @state = .dcs_intermediate
        else if b == b':' or b >= 0x40
          @state = .dcs_body
        else
          @state = .dcs_param
    .dcs_param
      if b >= 0x20 and b != DEL
        if b < 0x30
          @state = .dcs_intermediate
        else if b == b':' or b >= 0x3C
          @state = .dcs_body
    .dcs_intermediate
      @state = .dcs_body if b >= 0x30 and b != DEL
    .dcs_body, .apc => pass

# A byte of 0x80 or more outside the ground state. In an OSC or DCS body it
# is data; elsewhere one from 0x80 to 0x9F is a C1 control, which acts from
# any state: ST ends a string, CSI, OSC, DCS, SOS, PM, and APC begin one,
# and the rest run as ESC and the byte less 0x40 would.
sub Terminal.high(!@, b: U8)
  return if @state == .osc or @state == .dcs_body or b >= 0xA0
  if b == 0x9C
    @state = .ground
  else if b == 0x9B
    (!@).clear()
    @state = .csi_entry
  else if b == 0x9D
    @state = .osc
  else if b == 0x90
    (!@).clear()
    @state = .dcs_entry
  else if b == 0x98 or b == 0x9E or b == 0x9F
    @state = .apc
  else
    @state = .ground
    @inter = 0
    @inter_count = 0
    (!@).esc_dispatch(b - 0x40)

sub Terminal.clear(!@)
  @count = 0
  @acc = 0
  @digits = false
  @colon = false
  @inter = 0
  @inter_count = 0
  @seps = 0

# An intermediate (or a private marker such as `?`), up to four.
sub Terminal.collect(!@, b: U8)
  if @inter_count < 4
    @inter = @inter << 8 | Int(b)
    @inter_count += 1

# A digit of a parameter, or a `;` or `:` that ends one.
sub Terminal.param(!@, b: U8)
  if b == b';' or b == b':'
    if @count < MAX_PARAMS
      @params[@count] = @acc
      if b == b':'
        @colon = true
        @seps |= 1 << @count
    @count += 1
    @acc = 0
    @digits = false
    return
  @acc = @acc * 10 + Int(b - b'0')
  @acc = MAX_PARAM if @acc > MAX_PARAM
  @digits = true

# A C0 control.
sub Terminal.execute(!@, b: U8)
  match b
    b'\x08' => (!@).backspace()
    b'\t' => (!@).tab(1)
    b'\n', b'\x0b', b'\x0c'
      (!@).index()
      (!@).carriage_return() if @newline
    b'\r' => (!@).carriage_return()
    # SO and SI: G1 or G0 into GL.
    b'\x0e' => @gl = 1
    b'\x0f' => @gl = 0
    _ => pass

sub Terminal.esc_dispatch(!@, b: U8)
  # SCS: `ESC ( F` designates set F into G0, `)` G1, `*` G2, `+` G3.
  if b == b'B' or b == b'A' or b == b'0'
    if @inter_count == 1 and @inter >= Int(b'(') and @inter <= Int(b'+')
      @g[@inter - Int(b'(')] = ASCII if b == b'B' else (BRITISH if b == b'A' else DEC_SPECIAL)
    return
  if @inter == Int(b'#')
    (!@).align() if b == b'8'
    return
  return if @inter != 0
  match b
    b'7' => (!@).save_cursor()
    b'8' => (!@).restore_cursor()
    b'D' => (!@).index()
    b'E'
      (!@).index()
      (!@).carriage_return()
    b'H' => (!@).tab_set()
    b'M' => (!@).reverse_index()
    b'c' => (!@).full_reset()
    b'Z' => (!@).device_attributes(0)
    # SS2 and SS3: G2 or G3 for the next rune; LS2 and LS3: into GL.
    b'N' => @single = 2
    b'O' => @single = 3
    b'n' => @gl = 2
    b'o' => @gl = 3
    _ => pass

# The final byte of a CSI sequence: the parameters are complete.
sub Terminal.csi_final(!@, b: U8)
  @state = .ground
  if @digits
    if @count < MAX_PARAMS
      @params[@count] = @acc
    @count += 1
  return if @count > MAX_PARAMS
  return if @colon and b != b'm'
  n = @count
  p0 = @params[0] if n > 0 else 0
  p1 = @params[1] if n > 1 else 0
  # ED and EL with `?` (selective erase) erase as plain ED and EL do while
  # no cell is protected.
  if @inter == Int(b'?') and (b == b'J' or b == b'K')
    @inter = 0
  # Replies, and the kitty keyboard flags.
  if b == b'c' and (@inter == 0 or @inter == Int(b'>') or @inter == Int(b'='))
    (!@).device_attributes(@inter)
    return
  if b == b'n' and n == 1 and (@inter == 0 or @inter == Int(b'?'))
    if @inter == 0 and p0 == 5
      !@replies.add("\x1b[0n")
    else if @inter == 0 and p0 == 6
      (!@).report_cursor()
    return
  if b == b'p' and @inter == 0x3F24 and n == 1
    (!@).report_mode(p0)
    return
  if b == b'q' and @inter == Int(b'>')
    !@replies.add("\x1bP>|", NAME, "\x1b\\")
    return
  if b == b'u' and @inter == Int(b'?')
    (!@).report_kitty()
    return
  if b == b'u' and @inter == Int(b'>')
    (!@).kitty_push(p0 if n == 1 else 0) if n != 1 or p0 <= 31
    return
  if b == b'u' and @inter == Int(b'<')
    (!@).kitty_pop(p0 if n == 1 else 1)
    return
  if b == b'u' and @inter == Int(b'=')
    how = p1 if n >= 2 else 1
    v = p0 if n >= 1 else 0
    (!@).kitty_set(v, how) if v <= 31 and how >= 1 and how <= 3
    return
  if (b == b's' or b == b'r') and @inter == Int(b'?')
    for k in 0..(@count if @count < MAX_PARAMS else MAX_PARAMS)
      if b == b's'
        (!@).save_mode(@params[k])
      else
        (!@).restore_mode(@params[k])
    return
  if (b == b'h' or b == b'l') and (@inter == 0 or @inter == Int(b'?'))
    for k in 0..(@count if @count < MAX_PARAMS else MAX_PARAMS)
      (!@).set_mode(@params[k], @inter != 0, b == b'h')
    return
  return if @inter != 0
  # The count of a movement: 1 when it is left out or 0.
  move = (1 if p0 == 0 else p0) if n <= 1 else -1
  # The count of an edit: 1 when it is left out, and 0 when it is 0.
  count = (1 if n == 0 else p0) if n <= 1 else -1
  match b
    b'A', b'k' if move > 0 => (!@).cursor_up(move)
    b'B' if move > 0 => (!@).cursor_down(move)
    b'C' if move > 0 => (!@).cursor_right(move)
    b'D', b'j' if move > 0 => (!@).cursor_left(move)
    b'E' if move > 0
      (!@).cursor_down(move)
      (!@).carriage_return()
    b'F' if move > 0
      (!@).cursor_up(move)
      (!@).carriage_return()
    b'G', b'`' if move > 0 => (!@).cursor_to(@row + 1, move)
    # HPR and VPR are CUP from the cursor, as in Ghostty: they move by their
    # parameter as given (0 stays, but ends a pending wrap), and in origin
    # mode the row counts from the top margin.
    b'a' if count >= 0 => (!@).cursor_to(@row + 1, @col + 1 + count)
    b'd' if move > 0 => (!@).cursor_to(move, @col + 1)
    b'e' if count >= 0 => (!@).cursor_to(@row + 1 + count, @col + 1)
    b'H', b'f' if n <= 2 => (!@).cursor_to(p0, p1)
    b'I' if count >= 0 => (!@).tab(count)
    b'Z' if count >= 0 => (!@).tab_back(count)
    # Ghostty's TBC needs its parameter: `CSI g` alone does nothing.
    b'g' if n == 1 => (!@).tab_clear(p0)
    b'J' if n <= 1 => (!@).erase_display(p0)
    b'K' if n <= 1 => (!@).erase_line(p0)
    b'X' if count >= 0 => (!@).erase_chars(count)
    b'L' if count >= 0 => (!@).insert_lines(count)
    b'M' if count >= 0 => (!@).delete_lines(count)
    b'@' if n <= 1 => (!@).insert_blanks(1 if p0 == 0 else p0)
    b'P' if count >= 0 => (!@).delete_chars(count)
    b'S' if count >= 0 => (!@).scroll_up(count)
    b'T' if count >= 0 => (!@).scroll_down(count)
    b'r' if n <= 2 => (!@).set_margins(p0, p1)
    # With no left and right margin mode, `CSI s` alone saves the cursor,
    # and with parameters does nothing.
    b's' if n == 0 => (!@).save_cursor()
    b'u' => (!@).restore_cursor()
    b'b' if count >= 0 => (!@).repeat(count)
    b'm'
      (!@).sgr()
      (!@).pen_changed()
    _ => pass
