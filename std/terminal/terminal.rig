# std.terminal: a terminal emulator as a library. Bytes a program writes
# go in through `feed`; the screen, the cursor, and the bytes the terminal
# answers with come out. It reads nothing and writes nothing itself: a
# caller owns the pty, the keyboard, and the drawing. Its behavior is
# xterm's, as Ghostty implements it; the cases of
# test/rig/std-terminal-ghostty.rig.test hold Ghostty's answers
# (tools/terminal_ghostty.py records them).
#
# This file holds the screen and the operations on it; parser.rig turns
# bytes into those operations.

use std.utf8

# The index of `s` in `styles`, added when it is new.
fun intern(styles: !List[Style], s: ?Style) -> Int
  for t, k in styles
    return k if t.same(s)
  !styles.push(+s)
  styles.len - 1

# Every mode Ghostty knows, DEC private and ANSI, and each one's default,
# in Ghostty's order (modes.zig). A mode the terminal does nothing for is
# still set, reset, saved, and reported.
MODE_VALUES = [2, 4, 12, 20, 1, 3, 4, 5, 6, 7, 8, 9, 12, 25, 40, 45, 47, 66, 67, 69, 1000, 1002, 1003, 1004, 1005, 1006, 1007, 1015, 1016, 1035, 1036, 1039, 1045, 1047, 1048, 1049, 2004, 2026, 2027, 2031, 2033, 2048]
MODE_ANSI_COUNT = 4
MODE_DEFAULTS = [false, false, true, false, false, false, false, false, false, true, false, false, false, true, false, false, false, false, false, false, false, false, false, false, false, false, true, false, false, true, true, false, false, false, false, false, false, false, false, false, false, false]

# The index of mode `m` in MODE_VALUES, ANSI or DEC private; -1 when
# Ghostty knows no such mode.
fun mode_index(m: Int, ansi: Bool) -> Int
  first = 0 if ansi else MODE_ANSI_COUNT
  last = MODE_ANSI_COUNT if ansi else MODE_VALUES.len
  for i in first..last
    return i if MODE_VALUES[i] == m
  -1

# What XTVERSION names the terminal.
NAME = "std.terminal"

# A cursor DECSC saved: its place, pending wrap, pen, origin mode, and
# character sets; `set` is false before the first save.
obj Saved
  set: Bool
  row: Int
  col: Int
  wrap: Bool
  pen: Style
  origin: Bool
  g: [4]Int
  gl: Int
  single: Int

  fun none() -> Saved
    Saved(set: false, row: 0, col: 0, wrap: false, pen: Style.plain(), origin: false, g: [4 of UTF8], gl: 0, single: -1)

# Character sets.
UTF8 = 0
ASCII = 1
BRITISH = 2
DEC_SPECIAL = 3

# DEC Special Graphics from 0x60 to 0x7E: line drawing and symbols.
DEC_GRAPHICS = [0x25C6, 0x2592, 0x2409, 0x240C, 0x240D, 0x240A, 0x00B0, 0x00B1, 0x2424, 0x240B, 0x2518, 0x2510, 0x250C, 0x2514, 0x253C, 0x23BA, 0x23BB, 0x2500, 0x23BC, 0x23BD, 0x251C, 0x2524, 0x2534, 0x252C, 0x2502, 0x2264, 0x2265, 0x03C0, 0x2260, 0x00A3, 0x00B7]

# Rune `r` as character set `set` shows it.
fun map_rune(set: Int, r: U32) -> U32
  return r if set <= ASCII
  return 0x20 if r > 0xFF
  if set == BRITISH
    return 0xA3 if r == 0x23 else r
  return r if r < 0x60 or r > 0x7E
  U32(DEC_GRAPHICS[Int(r) - 0x60])

# The rune of a cell.
fun rune(c: U64) -> Int
  Int(c & 0xFFFFFFFF)

# The style index of a cell.
fun mark(c: U64) -> Int
  Int(c >> 32)

# A terminal of `cols` columns and `rows` rows. A cell is a U64: its rune
# in the low 32 bits (0 for empty) and its style, an index into `styles`,
# in the high 32. The screen's rows are kept in any order: row `y` is
# cells `map[y] * cols` to `map[y] * cols + cols - 1`, so a scroll moves
# entries of `map`, not cells.
pub obj Terminal
  # The bytes the terminal answers with (DA, DSR, DECRQM, XTVERSION, ...),
  # in order, for the caller to send to the program and then clear.
  pub replies: String
  cols: Int
  rows: Int
  cells: List[U64]
  map: List[Int]
  # The styles cells use, the first the plain one.
  styles: List[Style]
  # The style the next rune is printed in (SGR), and its index; the index
  # of an erased cell, which keeps only the pen's background; and both as
  # the high bits of a cell.
  pen: Style
  pen_id: Int
  blank_id: Int
  pen_bits: U64
  blank_cell: U64
  row: Int
  col: Int
  # The cursor is past the last column: the next printed rune wraps first.
  pending_wrap: Bool
  # The last rune printed, for REP; -1 before any, and after RIS.
  last: Int
  # Character sets (SCS): the set in each of G0 to G3 (UTF8, ASCII,
  # BRITISH, or DEC_SPECIAL), the slot invoked into GL, and a slot invoked
  # for the next rune only (SS2, SS3), or -1.
  g: [4]Int
  gl: Int
  single: Int
  # The scroll margins (DECSTBM): the first and last rows that scroll.
  top: Int
  bottom: Int
  # Modes: autowrap (DECAWM), origin (DECOM), insert (IRM), and new line
  # (LNM, a line feed also returns).
  autowrap: Bool
  origin: Bool
  insert: Bool
  newline: Bool
  cursor_visible: Bool
  # What XTSAVE saved of the private modes, for XTRESTORE; their defaults
  # until then.
  # Every mode Ghostty knows (MODE_VALUES), set or not, as SM, RM, DECSET,
  # and DECRST leave it, whether or not it does anything here yet; and what
  # XTSAVE saved of each, their defaults until then.
  modes: List[Bool]
  saved_modes: List[Bool]
  # The kitty keyboard flags: a ring of 8 entries and the one in use, per
  # screen (`other_kitty` the other screen's).
  kitty: [8]Int
  kitty_idx: Int
  other_kitty: [8]Int
  other_kitty_idx: Int
  # Whether a tab stop is set at each column.
  tabs: List[Bool]
  # What DECSC saved, for DECRC.
  saved: Saved
  # The other screen, primary or alternate (47, 1047, 1049): its cells, row
  # map, and saved cursor, swapped with these at a switch. The alternate
  # screen is made blank the first time it is used.
  alt: Bool
  alt_made: Bool
  other_cells: List[U64]
  other_map: List[Int]
  other_saved: Saved
  # The background of the other screen's cursor when it was left, which a
  # screen is erased with as 1049 enters it, before the cursor comes over.
  other_bg: Int
  # The parser (parser.rig): its state, the CSI parameters so far, and the
  # intermediate bytes, packed with the first in the highest byte.
  state: State
  params: [24]Int
  count: Int
  acc: Int
  digits: Bool
  colon: Bool
  inter: Int
  inter_count: Int
  # Bit i: parameter i ended with a colon.
  seps: Int

  # An empty terminal of `cols` by `rows`, the cursor at the top left and a
  # tab stop every 8 columns.
  pub fun new(cols: Int, rows: Int) -> Terminal
    tabs = List[Bool].filled(cols, false)
    for x in 0..cols
      tabs[x] = x % 8 == 0
    map = List[Int].filled(rows, 0)
    for y in 0..rows
      map[y] = y
    Terminal(cols: cols, rows: rows, cells: List[U64].filled(cols * rows, 0), map: <map,
      styles: List([Style.plain()]), pen: Style.plain(), pen_id: 0, blank_id: 0, pen_bits: 0, blank_cell: 0,
      row: 0, col: 0, pending_wrap: false, last: -1, g: [4 of UTF8], gl: 0, single: -1, top: 0, bottom: rows - 1,
      autowrap: true, origin: false, insert: false, newline: false, cursor_visible: true,
      modes: List(MODE_DEFAULTS), saved_modes: List(MODE_DEFAULTS),
      kitty: [8 of 0], kitty_idx: 0, other_kitty: [8 of 0], other_kitty_idx: 0, replies: String(),
      tabs: <tabs, saved: Saved.none(), alt: false, alt_made: false, other_cells: List(), other_map: List(), other_saved: Saved.none(), other_bg: NONE,
      state: .ground, params: [24 of 0], count: 0, acc: 0, digits: false, colon: false, inter: 0, inter_count: 0, seps: 0)

  # REP: the last rune printed, `n` more times (at least once).
  sub repeat(!@, n: Int)
    return if @last < 0
    for _ in 0..(n if n > 1 else 1)
      (!@).print(U32(@last))

  # RIS: everything as a new terminal of the same size has it, but the
  # replies already made, which are sent.
  sub full_reset(!@)
    sent = String()
    swap(!sent, !@replies)
    @ = Terminal.new(@cols, @rows)
    swap(!sent, !@replies)

  # The pen changed: find its index, and the index of an erased cell.
  sub pen_changed(!@)
    @pen_id = intern(!@styles, ?@pen)
    erased = Style.plain()
    erased.bg = @pen.bg
    @blank_id = intern(!@styles, ?erased)
    @pen_bits = U64(@pen_id) << 32
    @blank_cell = U64(@blank_id) << 32

  # The index in `cells` of row `y`, column `x`.
  fun at(?@, y: Int, x: Int) -> Int
    @map[y] * @cols + x

  # Write `r` at the cursor and move right, wrapping first when a wrap is
  # pending.
  sub print(!@, r: U32)
    # The rune through the character set invoked, which a single shift
    # names for this rune only.
    slot = @single if @single >= 0 else @gl
    @single = -1
    shown = map_rune(@g[slot], r)
    if @pending_wrap and @autowrap
      @pending_wrap = false
      @col = 0
      (!@).index()
    (!@).insert_blanks(1) if @insert
    @cells[@map[@row] * @cols + @col] = U64(shown) | @pen_bits
    @last = Int(r)
    # At the last column a wrap is pending even with autowrap off, as in
    # Ghostty: the next rune only wraps once autowrap is on again.
    if @col == @cols - 1
      @pending_wrap = true
    else
      @col += 1

  # Print the bytes `from` to `to` (not included) of `s`, every one of
  # them a rune of one byte (0x20 to 0x7F), as `print` would one at a time:
  # whole stretches go into a row at once.
  sub print_run(!@, s: ?String, from: Int, to: Int)
    if @insert or @single >= 0 or @g[@gl] > ASCII
      for i in from..to
        (!@).print(U32(s[i]))
      return
    k = from
    while k < to
      if @pending_wrap and @autowrap
        @pending_wrap = false
        @col = 0
        (!@).index()
      else if @pending_wrap and @col == @cols - 1
        # Autowrap is off at the last column: every rune left overwrites
        # it, and the last one stays.
        @cells[@map[@row] * @cols + @col] = U64(s[to - 1]) | @pen_bits
        @last = Int(s[to - 1])
        return
      take = @cols - @col if @cols - @col < to - k else to - k
      base = @map[@row] * @cols + @col
      bits = @pen_bits
      for t in 0..take
        @cells[base + t] = U64(s[k + t]) | bits
      k += take
      # As `print` does, a pending wrap (kept with autowrap off, after CBT)
      # stays when the run ends short of the last column.
      if @col + take == @cols
        @col = @cols - 1
        @pending_wrap = true
      else
        @col += take
    @last = Int(s[to - 1])

  sub carriage_return(!@)
    @col = 0
    @pending_wrap = false

  # Down one row; at the bottom margin the scroll region scrolls up.
  sub index(!@)
    @pending_wrap = false
    if @row == @bottom
      (!@).scroll_up(1)
    else if @row < @rows - 1
      @row += 1

  # Up one row; at the top margin the scroll region scrolls down, and the
  # cursor keeps its pending wrap.
  sub reverse_index(!@)
    if @row == @top
      (!@).scroll_down(1)
    else
      (!@).cursor_up(1)

  # Cells `from` to `to` (not included) of `cells`, within one row, erased:
  # empty, keeping the pen's background.
  sub blank(!@, from: Int, to: Int)
    !@cells[from..to].fill(@blank_cell)

  # Rows `first` to `last` (not included) erased.
  sub blank_rows(!@, first: Int, last: Int)
    for y in first..last
      base = @map[y] * @cols
      (!@).blank(base, base + @cols)

  # The entries `a` to `b` of `map`, both included, in reverse order.
  sub reverse_rows(!@, a: Int, b: Int)
    i = a
    j = b
    while i < j
      t = @map[i]
      @map[i] = @map[j]
      @map[j] = t
      i += 1
      j -= 1

  # The rows `first` to `last` move up `n`; the `n` at the bottom are
  # blank. Rows move as entries of `map`: a rotation, by three reversals.
  sub shift_up(!@, first: Int, last: Int, n: Int)
    k = n if n < last - first + 1 else last - first + 1
    if k == 1
      # The common scroll, by one row: the top row's entry moves to the
      # bottom, two moves of `map` in memory.
      y = (!@map).remove(first)
      !@map.insert(last, y)
      (!@).blank_rows(last, last + 1)
      return
    (!@).reverse_rows(first, first + k - 1)
    (!@).reverse_rows(first + k, last)
    (!@).reverse_rows(first, last)
    (!@).blank_rows(last + 1 - k, last + 1)

  # The rows `first` to `last` move down `n`; the `n` at the top are blank.
  sub shift_down(!@, first: Int, last: Int, n: Int)
    k = n if n < last - first + 1 else last - first + 1
    (!@).reverse_rows(first, last)
    (!@).reverse_rows(first, first + k - 1)
    (!@).reverse_rows(first + k, last)
    (!@).blank_rows(first, first + k)

  # The scroll region moves up `n` rows (SU); the cursor stays.
  sub scroll_up(!@, n: Int)
    (!@).shift_up(@top, @bottom, n)

  # The scroll region moves down `n` rows (SD); the cursor stays.
  sub scroll_down(!@, n: Int)
    (!@).shift_down(@top, @bottom, n)

  # IL: `n` blank rows at the cursor's, pushing the rest of the scroll
  # region down; the cursor goes to the first column. Nothing outside the
  # region.
  sub insert_lines(!@, n: Int)
    return if n == 0 or @row < @top or @row > @bottom
    (!@).shift_down(@row, @bottom, n)
    @col = 0
    @pending_wrap = false

  # DL: `n` rows from the cursor's go, pulling the rest of the scroll
  # region up; the cursor goes to the first column.
  sub delete_lines(!@, n: Int)
    return if n == 0 or @row < @top or @row > @bottom
    (!@).shift_up(@row, @bottom, n)
    @col = 0
    @pending_wrap = false

  # ICH: `n` blank cells at the cursor, pushing the rest of the row right.
  sub insert_blanks(!@, n: Int)
    @pending_wrap = false
    base = @map[@row] * @cols
    k = n if n < @cols - @col else @cols - @col
    x = @cols
    while x > @col + k
      x -= 1
      @cells[base + x] = @cells[base + x - k]
    (!@).blank(base + @col, base + @col + k)

  # DCH: `n` cells from the cursor go, pulling the rest of the row left.
  sub delete_chars(!@, n: Int)
    return if n == 0
    base = @map[@row] * @cols
    k = n if n < @cols - @col else @cols - @col
    for x in @col..@cols - k
      @cells[base + x] = @cells[base + x + k]
    (!@).blank(base + @cols - k, base + @cols)
    @pending_wrap = false

  # ECH: `n` cells from the cursor emptied, at least one, not past the row.
  sub erase_chars(!@, n: Int)
    k = n if n > 0 else 1
    k = k if k < @cols - @col else @cols - @col
    base = @map[@row] * @cols + @col
    (!@).blank(base, base + k)
    @pending_wrap = false

  # EL: 0 from the cursor to the end of the row, 1 from its start to the
  # cursor, 2 the whole row.
  sub erase_line(!@, how: Int)
    base = @map[@row] * @cols
    match how
      0 => (!@).blank(base + @col, base + @cols)
      1 => (!@).blank(base, base + @col + 1)
      2 => (!@).blank(base, base + @cols)
      _ => return
    @pending_wrap = false

  # ED: 0 from the cursor to the end of the screen, 1 from its start to the
  # cursor, 2 the whole screen; 3 the scrollback, which holds nothing yet.
  sub erase_display(!@, how: Int)
    match how
      0
        (!@).erase_line(0)
        (!@).blank_rows(@row + 1, @rows)
      1
        (!@).erase_line(1)
        (!@).blank_rows(0, @row)
      2
        (!@).blank_rows(0, @rows)
        @pending_wrap = false
      _ => pass

  # DECSTBM: rows `top` to `bottom`, counted from 1 (0 is the edge), scroll;
  # the cursor goes home. A region of fewer than two rows is ignored.
  sub set_margins(!@, top: Int, bottom: Int)
    t = top if top > 1 else 1
    b = bottom if bottom > 0 and bottom < @rows else @rows
    return if t >= b
    @top = t - 1
    @bottom = b - 1
    (!@).cursor_to(1, 1)

  # DECALN: the screen full of `E`, the margins reset, the cursor home. As
  # in Ghostty, the pen keeps only its colors, and stays so.
  sub align(!@)
    colors = Style.plain()
    colors.fg = @pen.fg
    colors.bg = @pen.bg
    @pen = <colors
    (!@).pen_changed()
    @top = 0
    @bottom = @rows - 1
    (!@).set_origin(false)
    (!@).cursor_to(1, 1)
    !@cells[..].fill(U64(0x45) | @pen_bits)

  sub backspace(!@)
    @pending_wrap = false
    @col -= 1 if @col > 0 else 0

  # Up `n` rows, stopping at the top margin, or at the top when above it.
  sub cursor_up(!@, n: Int)
    @pending_wrap = false
    limit = @top if @row >= @top else 0
    @row = @row - n if @row - n > limit else limit

  # Down `n` rows, stopping at the bottom margin, or at the bottom when
  # below it.
  sub cursor_down(!@, n: Int)
    @pending_wrap = false
    limit = @bottom if @row <= @bottom else @rows - 1
    @row = @row + n if @row + n < limit else limit

  # Right `n` columns, stopping at the last.
  sub cursor_right(!@, n: Int)
    @pending_wrap = false
    @col = @col + n if @col + n < @cols - 1 else @cols - 1

  # Left `n` columns, stopping at the first.
  sub cursor_left(!@, n: Int)
    @pending_wrap = false
    @col = @col - n if @col - n > 0 else 0

  # Row `row` and column `col`, counted from 1 (0 is 1), kept on the screen;
  # in origin mode the row counts from the top margin and stops at the
  # bottom one.
  sub cursor_to(!@, row: Int, col: Int)
    @pending_wrap = false
    r = (row if row > 0 else 1) + (@top if @origin else 0)
    c = col if col > 0 else 1
    last = @bottom + 1 if @origin else @rows
    @row = (r if r < last else last) - 1
    @col = (c if c < @cols else @cols) - 1

  # Forward to the next tab stop, `n` times, stopping at the last column.
  sub tab(!@, n: Int)
    k = n
    while k > 0 and @col < @cols - 1
      @col += 1
      while @col < @cols - 1 and not @tabs[@col]
        @col += 1
      k -= 1

  # Back to the previous tab stop, `n` times, stopping at the first column;
  # as in Ghostty, a pending wrap stays.
  sub tab_back(!@, n: Int)
    k = n
    while k > 0 and @col > 0
      @col -= 1
      while @col > 0 and not @tabs[@col]
        @col -= 1
      k -= 1

  sub tab_set(!@)
    @tabs[@col] = true

  # TBC: 0 clears the stop at the cursor, 3 every stop.
  sub tab_clear(!@, how: Int)
    if how == 0
      @tabs[@col] = false
    else if how == 3
      for x in 0..@cols
        @tabs[x] = false

  sub save_cursor(!@)
    @saved = Saved(set: true, row: @row, col: @col, wrap: @pending_wrap, pen: +@pen, origin: @origin, g: @g, gl: @gl, single: @single)

  sub restore_cursor(!@)
    if @saved.set
      @row = @saved.row
      @col = @saved.col
      @pending_wrap = @saved.wrap
      @pen = +@saved.pen
      (!@).set_origin(@saved.origin)
      @g = @saved.g
      @gl = @saved.gl
      @single = @saved.single
    else
      @row = 0
      @col = 0
      @pending_wrap = false
      @pen = Style.plain()
      (!@).set_origin(false)
      @g = [4 of UTF8]
      @gl = 0
      @single = -1
    (!@).pen_changed()

  # To the alternate screen (`alt`) or back to the primary; nothing when
  # already there. The cursor, the pen, the character sets, the margins,
  # and the modes stay as they are; the cells and the saved cursor are the
  # other screen's. The background of the cursor the screen had when it
  # was left, or of this one when there is no switch.
  fun switch_screen(!@, alt: Bool) -> Int
    return @pen.bg if @alt == alt
    if not @alt_made
      @other_cells = List[U64].filled(@cols * @rows, 0)
      map = List[Int].filled(@rows, 0)
      for y in 0..@rows
        map[y] = y
      @other_map = <map
      @alt_made = true
    swap(!@cells, !@other_cells)
    swap(!@map, !@other_map)
    swap(!@saved, !@other_saved)
    swap(!@kitty, !@other_kitty)
    swap(!@kitty_idx, !@other_kitty_idx)
    stale = @other_bg
    @other_bg = @pen.bg
    @alt = alt
    stale

  # ED 2 with the background `bg` instead of the pen's.
  sub erase_with(!@, bg: Int)
    kept = @blank_cell
    erased = Style.plain()
    erased.bg = bg
    @blank_cell = U64(intern(!@styles, ?erased)) << 32
    (!@).erase_display(2)
    @blank_cell = kept

  # XTSAVE: remember DEC private mode `m`.
  sub save_mode(!@, m: Int)
    i = mode_index(m, false)
    @saved_modes[i] = @modes[i] if i >= 0

  # XTRESTORE: set DEC private mode `m` as XTSAVE remembered it, with the
  # effects of setting it.
  sub restore_mode(!@, m: Int)
    i = mode_index(m, false)
    (!@).set_mode(m, true, @saved_modes[i]) if i >= 0

  # DECRQM: the DECRPM report of DEC private mode `m`: 1 set, 2 reset, 0
  # unknown, and, as Ghostty answers for DECECM (117), 4 permanently reset.
  sub report_mode(!@, m: Int)
    i = mode_index(m, false)
    state = 4 if m == 117 else (0 if i < 0 else (1 if @modes[i] else 2))
    !@replies.add("\x1b[?", m, ";", state, "$y")

  # DA: the primary (`which` 0), secondary (`>`), or tertiary (`=`) device
  # attributes, as Ghostty's defaults give them: a VT220 with ANSI color.
  sub device_attributes(!@, which: Int)
    if which == 0
      !@replies.add("\x1b[?62;22c")
    else if which == Int(b'>')
      !@replies.add("\x1b[>1;0;0c")
    else
      !@replies.add("\x1bP!|00000000\x1b\\")

  # DSR 6: the cursor's row and column from 1, from the top margin in
  # origin mode.
  sub report_cursor(!@)
    y = @row - @top if @origin and @row >= @top else (0 if @origin else @row)
    !@replies.add("\x1b[", y + 1, ";", @col + 1, "R")

  # The kitty keyboard flags in use (CSI ? u).
  sub report_kitty(!@)
    !@replies.add("\x1b[?", @kitty[@kitty_idx], "u")

  # CSI > u: push `flags`, the oldest falling off a full ring.
  sub kitty_push(!@, flags: Int)
    @kitty_idx = (@kitty_idx + 1) % 8
    @kitty[@kitty_idx] = flags

  # CSI < u: pop `n`; 8 or more empties the ring.
  sub kitty_pop(!@, n: Int)
    if n >= 8
      @kitty = [8 of 0]
      @kitty_idx = 0
      return
    for _ in 0..n
      @kitty[@kitty_idx] = 0
      @kitty_idx = (@kitty_idx + 7) % 8

  # CSI = u: set (1), add (2), or clear (3) the bits of `flags`.
  sub kitty_set(!@, flags: Int, how: Int)
    f = @kitty[@kitty_idx]
    @kitty[@kitty_idx] = flags if how == 1 else (f | flags if how == 2 else f & flags.not() & 31)

  # Origin mode on or off, in the mode table too, without moving the
  # cursor (DECRC and DECALN set it so).
  sub set_origin(!@, on: Bool)
    @origin = on
    @modes[mode_index(6, false)] = on

  # SM and RM (`private` false) or DECSET and DECRST: mode `m` on or off.
  sub set_mode(!@, m: Int, private: Bool, on: Bool)
    i = mode_index(m, not private)
    return if i < 0
    @modes[i] = on
    if not private
      match m
        4 => @insert = on
        20 => @newline = on
        _ => pass
      return
    match m
      6
        @origin = on
        (!@).cursor_to(1, 1)
      7 => @autowrap = on
      25 => @cursor_visible = on
      1048
        if on
          (!@).save_cursor()
        else
          (!@).restore_cursor()
      # As xterm (and Ghostty): 47 switches; 1047 also clears the alternate
      # screen on the way back; 1049 saves the cursor and clears the
      # alternate screen on the way in, and restores the cursor on the
      # primary on the way back.
      47 => _ = (!@).switch_screen(on)
      1047
        (!@).erase_display(2) if not on and @alt
        _ = (!@).switch_screen(on)
      1049
        if on
          # The erase is of the alternate screen's own cursor; the cursor
          # coming over after it keeps its pending wrap, unless there was
          # no switch to bring it.
          (!@).save_cursor()
          came = not @alt
          wrap = @pending_wrap
          bg = (!@).switch_screen(true)
          (!@).erase_with(bg)
          @pending_wrap = wrap if came else false
        else
          _ = (!@).switch_screen(false)
          (!@).restore_cursor()
      _ => pass

  # The screen and cursor as text: a line per row, `|` and the row's runes
  # with its trailing blanks dropped (an empty cell is a space); a line
  # `~ROW FIRST-LAST STYLE` per run of cells in a row with the same style
  # other than the plain one (Style.text); a line `reply BYTES` when there
  # are replies, each byte below 0x20 or above 0x7E written `\xNN`, ESC
  # `\e`, and `\` doubled; then `cursor ROW COL`, with ` wrap` when a wrap
  # is pending.
  pub fun dump(?@) -> String
    out = String()
    for y in 0..@rows
      start = @map[y] * @cols
      end = start + @cols
      while end > start and (rune(@cells[end - 1]) == 0 or rune(@cells[end - 1]) == 0x20)
        end -= 1
      !out.push(b'|')
      for i in start..end
        r = rune(@cells[i])
        utf8.push_rune(!out, 0x20 if r == 0 else r)
      !out.push(b'\n')
    for y in 0..@rows
      base = @map[y] * @cols
      first = 0
      for x in 0..@cols + 1
        m = mark(@cells[base + x]) if x < @cols else -1
        if x == @cols or m != mark(@cells[base + first])
          k = mark(@cells[base + first])
          if k != 0 and not @styles[k].is_plain()
            !out.add("~", y, " ", first, "-", x - 1, " ")
            line = String()
            @styles[k].text(!line)
            !out.add(line, "\n")
          first = x
    if @replies.len > 0
      !out.add("reply ")
      for b in @replies
        if b == 0x1B
          !out.add("\\e")
        else if b == b'\\'
          !out.add("\\\\")
        else if b < 0x20 or b > 0x7E
          !out.add("\\x")
          !out.push(HEX[b >> 4])
          !out.push(HEX[b & 15])
        else
          !out.push(b)
      !out.push(b'\n')
    !out.add("cursor ", @row, " ", @col)
    !out.add(" wrap") if @pending_wrap
    out
