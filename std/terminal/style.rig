# Styles of std.terminal: what SGR sets, and how a style is written in a
# dump. A color is NONE, a palette index (0 to 255), or RGB | 0xRRGGBB.

NONE = -1
RGB = 0x1000000

# Flag bits, in the order a dump writes them.
BOLD = 1
ITALIC = 2
FAINT = 4
BLINK = 8
INVERSE = 16
INVISIBLE = 32
STRIKE = 64
OVERLINE = 128

FLAG_NAMES = ["bold", "italic", "faint", "blink", "inverse", "invisible", "strike", "overline"]
UNDERLINE_NAMES = ["none", "single", "double", "curly", "dotted", "dashed"]

# How a cell looks besides its rune.
obj Style
  flags: Int
  # 0 none, then single, double, curly, dotted, dashed.
  underline: Int
  fg: Int
  bg: Int
  ulc: Int

  fun plain() -> Style
    Style(flags: 0, underline: 0, fg: NONE, bg: NONE, ulc: NONE)

  fun same(?@, o: ?Style) -> Bool
    @flags == o.flags and @underline == o.underline and @fg == o.fg and @bg == o.bg and @ulc == o.ulc

  fun is_plain(?@) -> Bool
    @flags == 0 and @underline == 0 and @fg == NONE and @bg == NONE and @ulc == NONE

  # The style as a dump writes it: the flags set, then ul=, fg=, bg=, ulc=.
  sub text(?@, out: !String)
    for name, k in FLAG_NAMES
      if @flags & (1 << k) != 0
        !out.push(b' ') if out.len > 0
        !out.add(name)
    if @underline != 0
      !out.push(b' ') if out.len > 0
      !out.add("ul=", UNDERLINE_NAMES[@underline])
    color_text(!out, "fg=", @fg)
    color_text(!out, "bg=", @bg)
    color_text(!out, "ulc=", @ulc)

sub color_text(out: !String, name: ?String, c: Int)
  return if c == NONE
  !out.push(b' ') if out.len > 0
  !out.add(name)
  if c < RGB
    !out.add(c)
    return
  !out.push(b'#')
  for shift in [16, 8, 0]
    v = (c >> shift) & 0xFF
    !out.push(HEX[v >> 4])
    !out.push(HEX[v & 15])

HEX = b"0123456789abcdef"

# SGR: each attribute of the parameters, in order, applied to the pen, as
# Ghostty's sgr.Parser reads them. `seps` has bit i set when parameter i
# ended with a colon.
sub Terminal.sgr(!@)
  n = @count if @count < MAX_PARAMS else MAX_PARAMS
  if n == 0
    @pen = Style.plain()
    return
  i = 0
  while i < n
    i = (!@).sgr_one(i, n)

# The attribute at parameter `i`; where the next one starts.
fun Terminal.sgr_one(!@, i: Int, n: Int) -> Int
  v = @params[i]
  colon = (@seps >> i) & 1 != 0
  rest = n - i
  if colon and v != 4 and v != 38 and v != 48 and v != 58
    return colon_end(@seps, i, n) + 1
  match v
    0 => @pen = Style.plain()
    1 => @pen.flags |= BOLD
    2 => @pen.flags |= FAINT
    3 => @pen.flags |= ITALIC
    4
      if colon
        return i + 1 if rest < 2
        if (@seps >> (i + 1)) & 1 != 0
          return colon_end(@seps, i + 1, n) + 1
        u = @params[i + 1]
        @pen.underline = u if u <= 5 else 1
        return i + 2
      @pen.underline = 1
    5, 6 => @pen.flags |= BLINK
    7 => @pen.flags |= INVERSE
    8 => @pen.flags |= INVISIBLE
    9 => @pen.flags |= STRIKE
    21 => @pen.underline = 2
    22 => @pen.flags &= (BOLD | FAINT).not()
    23 => @pen.flags &= ITALIC.not()
    24 => @pen.underline = 0
    25 => @pen.flags &= BLINK.not()
    27 => @pen.flags &= INVERSE.not()
    28 => @pen.flags &= INVISIBLE.not()
    29 => @pen.flags &= STRIKE.not()
    30..38 => @pen.fg = v - 30
    38, 48, 58
      if rest >= 2
        kind = @params[i + 1]
        if kind == 5 and rest >= 3
          (!@).set_color(v, @params[i + 2] & 0xFF)
          return i + 3
        if kind == 2 and rest >= 5
          if not colon
            (!@).set_color(v, rgb(@params[i + 2], @params[i + 3], @params[i + 4]))
            return i + 5
          # Colons after the `2`: three for r:g:b, four with a color space.
          k = colon_end(@seps, i + 1, n) - i - 1
          if k == 3
            (!@).set_color(v, rgb(@params[i + 2], @params[i + 3], @params[i + 4]))
            return i + 5
          if k == 4
            (!@).set_color(v, rgb(@params[i + 3], @params[i + 4], @params[i + 5]))
            return i + 6
          return colon_end(@seps, i, n) + 1
    39 => @pen.fg = NONE
    40..48 => @pen.bg = v - 40
    49 => @pen.bg = NONE
    53 => @pen.flags |= OVERLINE
    55 => @pen.flags &= OVERLINE.not()
    59 => @pen.ulc = NONE
    90..98 => @pen.fg = v - 82
    100..108 => @pen.bg = v - 92
    _ => pass
  i + 1

sub Terminal.set_color(!@, which: Int, c: Int)
  match which
    38 => @pen.fg = c
    48 => @pen.bg = c
    _ => @pen.ulc = c

fun rgb(r: Int, g: Int, b: Int) -> Int
  RGB | (r & 0xFF) << 16 | (g & 0xFF) << 8 | (b & 0xFF)

# The last parameter of the run of colon-joined parameters from `i`.
fun colon_end(seps: Int, i: Int, n: Int) -> Int
  k = i
  while k < n - 1 and (seps >> k) & 1 != 0
    k += 1
  k
