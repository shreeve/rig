# std.crypto: wiping secrets and comparing them in constant time.

# True when `a` and `b` hold the same bytes, in a time that depends on
# their lengths alone: every byte is read, whatever the first difference.
pub fun equal(a: []U8, b: []U8) -> Bool
  return false if a.len != b.len
  d: U8 = 0
  for i in 0..a.len
    d |= a[i] ^ b[i]
  barrier(U64(d)) == 0

extern zig "crypto.zig"
  # Zeroes `b` with stores the optimizer keeps, even when nothing reads
  # `b` again.
  pub sub wipe(b: ![]U8)

  # `x`, through an empty `asm` the optimizer cannot see into, so a mask
  # made from a secret stays a mask and never becomes a branch.
  fun barrier(x: U64) -> U64
