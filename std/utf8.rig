# std.utf8: runes in UTF-8 (RFC 3629), which encodes each rune, one
# Unicode scalar value (0 to 0xD7FF or 0xE000 to 0x10FFFF), as one to
# four bytes. A valid sequence has no overlong form, encodes no surrogate
# (U+D800 to U+DFFF), and nothing past U+10FFFF. Every index and size is
# in bytes, and nothing here allocates but `push_rune`, which grows the
# `String` it is given. Each function reads every input, valid or not,
# as Go's unicode/utf8 does.

# The rune read in place of a byte that is not valid UTF-8, and written in
# place of a value that is not a rune: U+FFFD, Go's `utf8.RuneError`.
pub REPLACEMENT = 0xFFFD

# The bytes below this are each a whole rune, as in ASCII: Go's
# `utf8.RuneSelf`.
pub RUNE_SELF = 0x80

# A rune read from a `?String`, and the bytes it took there: `size` is 1
# for a bad byte read as `REPLACEMENT`, and 0 where there was nothing to
# read, while `utf8.size(REPLACEMENT)` is 3.
pub obj Decoded
  pub rune: Int
  pub size: Int

# ---- Reading ---------------------------------------------------------------

# The rune whose sequence starts at `i`, `0 <= i <= s.len`: `i` is a
# cursor between bytes, and this is the rune just after it. A byte
# that does not start a valid sequence reads as `REPLACEMENT`, of size 1,
# so a reader moves past one bad byte at a time; at `s.len` the result is
# `REPLACEMENT` of size 0. Go's `DecodeRuneInString(s[i:])`.
pub fun rune_after(s: ?String, i: Int) -> Decoded
  return Decoded(rune: REPLACEMENT, size: 0) if i == s.len
  b = s[i]
  return Decoded(rune: Int(b), size: 1) if b < 0x80
  e = end_multi(s, i)
  return Decoded(rune: REPLACEMENT, size: 1) if e < 0
  r = Int(b) & (0x7F >> (e - i))
  for k in i + 1..e
    r = (r << 6) | (Int(s[k]) & 0x3F)
  Decoded(rune: r, size: e - i)

# The rune whose sequence ends at `i`, `0 <= i <= s.len`: the rune
# just before the cursor, which `rune_after` reads at `i - d.size`. When
# no valid sequence ends at `i`, the byte before `i` reads as
# `REPLACEMENT`, of size 1; at 0 the result is `REPLACEMENT` of size 0.
# It looks back at most four bytes. Go's `DecodeLastRuneInString(s[:i])`.
pub fun rune_before(s: ?String, i: Int) -> Decoded
  return Decoded(rune: REPLACEMENT, size: 0) if i == 0
  b = s[i - 1]
  return Decoded(rune: Int(b), size: 1) if b < 0x80
  start = i - 1
  first = i - 4 if i > 4 else 0
  while start > first and s[start] & 0xC0 == 0x80
    start -= 1
  d = rune_after(s, start)
  return d if start + d.size == i
  Decoded(rune: REPLACEMENT, size: 1)

# The runes of a `?String`, which `runes` gives, in order:
# `for r in utf8.runes(s)`.
pub obj Runes
  s: ?String
  at: Int

  # The next rune, as `rune_after` reads it, or `none` after the
  # last.
  pub fun next(!self) -> Int?
    return none if self.at == self.s.len
    d = rune_after(self.s, self.at)
    self.at += d.size
    d.rune

# The runes of `s`, read by `rune_after` from its first byte to its
# last: a bad byte is one `REPLACEMENT`. Go's `for _, r := range s`.
pub fun runes(s: ?String) -> Runes
  Runes(s: s, at: 0)

# The size in bytes, 1 to 4, of the valid rune that starts at `i`,
# `0 <= i <= s.len`, or `none` when the bytes there are not valid UTF-8
# or `i` is `s.len`: `i += n` steps over the rune.
pub fun rune_size(s: ?String, i: Int) -> Int?
  return none if i == s.len
  return 1 if s[i] < 0x80
  e = end_multi(s, i)
  return none if e < 0
  e - i

# How many runes `s` holds, each bad byte counted as one, as `runes`
# reads them. Go's `RuneCountInString`.
pub fun rune_count(s: ?String) -> Int
  n = 0
  i = 0
  while i < s.len
    if i + 8 <= s.len and s.read[U64, .little](i) & 0x8080808080808080 == 0
      i += 8
      n += 8
      continue
    if s[i] < 0x80
      i += 1
    else
      e = end_multi(s, i)
      i = e if e > 0 else i + 1
    n += 1
  n

# Whether `s` is well-formed UTF-8: every byte is part of a valid
# sequence. Go's `ValidString`.
pub fun is_valid(s: ?String) -> Bool
  i = 0
  while i < s.len
    if i + 8 <= s.len and s.read[U64, .little](i) & 0x8080808080808080 == 0
      i += 8
      continue
    if s[i] < 0x80
      i += 1
    else
      e = end_multi(s, i)
      return false if e < 0
      i = e
  true

# Whether every byte of `s` is below `RUNE_SELF`, so each byte is a
# whole rune.
pub fun is_ascii(s: ?String) -> Bool
  i = 0
  while i + 8 <= s.len
    return false if s.read[U64, .little](i) & 0x8080808080808080 != 0
    i += 8
  while i < s.len
    return false if s[i] >= 0x80
    i += 1
  true

# The index just past the valid sequence of two to four bytes that
# starts at `at`, `0 <= at < s.len`, or -1 when there is none, as for an
# ASCII byte. One U32 read takes the commonest sequence in CJK text:
# three bytes, 1110xxxx 10xxxxxx 10xxxxxx. A first byte of E0 or ED
# narrows the second byte's range, so those go to `end_any`, with every
# other sequence.
fun end_multi(s: ?String, at: Int) -> Int
  if at + 4 <= s.len
    w = s.read[U32, .little](at)
    lead = w & 0xFF
    if w & 0xC0C0F0 == 0x8080E0 and lead != 0xE0 and lead != 0xED
      return at + 3
  end_any(s, at)

# `end_multi`, one byte at a time.
fun end_any(s: ?String, at: Int) -> Int
  width = 0
  lo: U8 = 0x80
  hi: U8 = 0xBF
  match s[at]
    0xC2..0xE0 => width = 2
    0xE0
      width = 3
      lo = 0xA0
    0xE1..0xED, 0xEE..0xF0 => width = 3
    0xED
      width = 3
      hi = 0x9F
    0xF0
      width = 4
      lo = 0x90
    0xF1..0xF4 => width = 4
    0xF4
      width = 4
      hi = 0x8F
    _ => return -1
  return -1 if at + width > s.len
  second = s[at + 1]
  return -1 if second < lo or second > hi
  for k in 2..width
    return -1 if s[at + k] & 0xC0 != 0x80
  at + width

# ---- Writing ---------------------------------------------------------------

# The size in bytes, 1 to 4, of the UTF-8 encoding of `r`, or `none`
# when `r` is not a rune: a negative, a surrogate, or past 0x10FFFF.
# Go's `RuneLen`.
pub fun size(r: Int) -> Int?
  return none if r < 0
  return 1 if r < 0x80
  return 2 if r < 0x800
  return none if r >= 0xD800 and r <= 0xDFFF
  return 3 if r < 0x10000
  return 4 if r <= 0x10FFFF
  none

# Appends the UTF-8 bytes of `r`, or of `REPLACEMENT` when `r` is not a
# rune: a negative, a surrogate, or past 0x10FFFF. Go's `AppendRune`.
pub sub push_rune(out: !String, r: Int)
  if r >= 0 and r < 0x80
    !out.push(U8(r))
  else if r < 0 or r > 0x10FFFF or (r >= 0xD800 and r <= 0xDFFF)
    push_multi(!out, REPLACEMENT)
  else
    push_multi(!out, r)

# Appends the two to four UTF-8 bytes of the rune `r`, at least 0x80, in
# one write, or two for three bytes, each a big-endian number whose top
# byte comes first.
sub push_multi(out: !String, r: Int)
  if r < 0x800
    !out.push[U16, .big](U16(0xC080 | (r >> 6) << 8 | r & 0x3F))
  else if r < 0x10000
    !out.push[U16, .big](U16(0xE080 | (r >> 12) << 8 | (r >> 6) & 0x3F))
    !out.push(U8(0x80 | r & 0x3F))
  else
    !out.push[U32, .big](U32(0xF0808080 | (r >> 18) << 24 | ((r >> 12) & 0x3F) << 16 | ((r >> 6) & 0x3F) << 8 | r & 0x3F))
