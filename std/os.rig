# std.os: the process's arguments, environment, working directory, what
# its allocations come to, ending it now, and what a closed stdout pipe
# does.

use std.file

# The working directory, as an absolute path, every symbolic link in it
# resolved. Like std.file's calls, it runs on the blocking pool and is a
# fallible waiting point; it fails with `file.FileError.not_found` when
# the directory was removed, and with another `file.FileError` when it
# cannot be read.
pub fun cwd() -> String!
  if file.realpath(".")! as path
    return path
  return file.FileError.not_found

# What the program's allocations come to, as `memory()` reads them.
pub obj Memory
  # The bytes of its live allocations.
  pub ?live: Int
  # The most `live` has been.
  pub ?peak: Int
  # How many allocations it has made.
  pub ?allocs: Int

# What the program's allocations come to now. A debug build counts each
# allocation's own length; a release build counts each block at the size
# the allocator keeps for it, and adds each thread's count to the totals
# every 64 KiB or 1,024 allocations, so with tasks on several threads a
# reading may trail by that much for each (the calling thread's own count
# is always in).
pub fun memory() -> Memory
  Memory(live: memory_live(), peak: memory_peak(), allocs: memory_allocs())

# What a write to stdout does once its reader has closed the pipe
# (`prog | head -1`), as `on_broken_pipe` sets it.
pub enum BrokenPipe
  # End the program quietly, with status 0: the default.
  exit
  # Die by SIGPIPE, as a C program does, so a shell sees status 141.
  die

# What a write to stdout does once its reader has closed the pipe, for
# the rest of the program, from `main` or any task. Either way the
# program ends at once, with no drop, `defer`, or leak check. It covers
# stdout alone: a failed `warn` is still dropped, and a socket whose
# other end closes still fails the write with `net.NetError.closed`.
pub sub on_broken_pipe(how: BrokenPipe)
  match how
    .exit => set_broken_pipe_dies(false)
    .die => set_broken_pipe_dies(true)

extern zig "os.zig"
  # Every argument, the program's name first. The text lives as long as
  # the program, like a literal's.
  pub fun args() -> []Static

  # The value of the environment variable `name`, or `none` when it is
  # not set. The text lives as long as the program: it views the
  # environment the process started with, which nothing in std changes
  # (a `set_env` would have to revisit this `Static`).
  pub fun env(name: ?String) -> Static?

  # End the program now, with exit status `code` (0 to 255; another value
  # panics), from `main` or from any task. What `print` and `warn` wrote
  # is flushed first; then the process ends at once, and nothing else
  # runs: no drop, `defer`, `errdefer`, or leak check, and the program's
  # other tasks end with it, wherever they are.
  pub sub exit(code: Int)

  # `memory()`'s parts.
  fun memory_live() -> Int
  fun memory_peak() -> Int
  fun memory_allocs() -> Int

  # `on_broken_pipe`'s setting.
  sub set_broken_pipe_dies(dies: Bool)
