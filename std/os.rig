# std.os: the process's arguments and environment.

extern zig "os.zig"
  # Every argument, the program's name first. The Strings live as long
  # as the program, like literals.
  pub fun args -> []String

  # The value of the environment variable `name`, or `none` when it is
  # not set. The String lives as long as the program: it views the
  # environment the process started with, which nothing in std changes
  # (a `set_env` would have to revisit this `from static`).
  pub fun env(name: String) -> String? from static
