# std.file: files, and what is at a path. A path is relative to the
# working directory, or absolute. Each call that reaches the file system
# runs on the blocking pool, so it blocks only the task that makes it,
# and is a fallible waiting point: in a canceled task it fails with
# `task.Stop.canceled` (std.task), and past a deadline (`time.within`)
# with `task.Stop.timeout`. A call that looks for something gives `none`
# only when nothing is there (nothing by its name, or a file where a
# directory on the way to it would be); every other failure is an error.

use std.task

# Why a call on a path or a file failed: the system's own reason, one
# member for each, with its words in `reason`.
pub error FileError
  # Nothing is at the path, or at a directory on the way to it (ENOENT).
  not_found
  # Something is at the path already (EEXIST).
  exists
  # The permissions do not allow it (EACCES).
  denied
  # The system does not allow it whatever the permissions: removing a
  # device, a file of another user's in a sticky directory (EPERM).
  not_permitted
  # The file system is read-only (EROFS).
  read_only
  # The path given `read_dir` names a file, or a file stands where a
  # call needs a directory on the way (ENOTDIR).
  not_directory
  # The path names a directory, where a file is wanted (EISDIR).
  is_directory
  # The directory to remove holds entries (ENOTEMPTY).
  not_empty
  # Symbolic links on the path name one another, or too many of them
  # (ELOOP).
  loop
  # The path, or a name in it, is longer than the system takes
  # (ENAMETOOLONG).
  name_too_long
  # What the call needs is in use: a mount point (EBUSY).
  busy
  # `rename` across file systems (EXDEV).
  cross_device
  # No space is left on the device (ENOSPC).
  no_space
  # The system rejects an argument: a directory moved into itself, a
  # path with a 0 byte in it (EINVAL).
  invalid
  # The file is not open for this: a write to a file opened to read, a
  # read of one opened to write, a closed standard stream (EBADF).
  bad_descriptor
  # A write to a pipe or a socket whose reader has closed it (EPIPE).
  broken_pipe
  # The device failed to read or write (EIO).
  io
  # Anything else the system reports: too many open files, a file too
  # large, a quota.
  failed

# What `stat` and `read_dir` find at a path.
pub enum Kind
  file
  directory
  other

# What is at a path (`stat`): its kind, following a symbolic link to what
# it names; whether the path itself is a symbolic link; its size in
# bytes; and when its contents last changed, in nanoseconds since
# 1970-01-01 00:00 UTC.
pub obj Stat
  pub kind: Kind
  pub link: Bool
  pub size: Int
  pub modified: Int

# An entry of a directory (`read_dir`): its name, its kind as `stat`
# gives it, and whether it is a symbolic link.
pub obj Entry
  pub name: String
  pub kind: Kind
  pub link: Bool

# An open file, read and written from where the last read or write
# ended, as a `net.Stream` is: `open` gives one to read, `create` one to
# write, and `io.stdin()`, `io.stdout()`, and `io.stderr()` the standard
# streams. It closes when dropped, but a standard stream stays open. Its
# field is the runtime's.
pub obj File
  fd: Int

  # Read up to `max` bytes onto the end of `into`, into its own buffer:
  # how many it read, or 0 at the end of the file. A buffer with room
  # for `max` more is read into as it is, so a buffer cleared and read
  # into again takes no allocation; one without room grows first, and a
  # String with no buffer at all gets one cut to what came.
  pub fun read(!@, into: !String, max: Int) -> Int!
    read_from(@fd, !into, max)!

  # Write all of `bytes`, with nothing added. On stdout they go through
  # `print`'s buffer; on stderr, after what `print` buffered.
  pub sub write(!@, bytes: ?String)!
    write_to(@fd, bytes)!

  # Write out what `print` has buffered, when this is stdout; nothing
  # for any other file, whose writes are not buffered.
  pub sub flush(!@)!
    flush_fd(@fd)!

  drop(!@)
    close(@fd)

# The system's own words for `e`, as `strerror` gives them: "No such
# file or directory" for `FileError.not_found`. `FileError.failed`,
# which stands for several reasons, is "Unknown error".
pub fun reason(e: FileError) -> Static
  match e
    .not_found => reason_text(0)
    .exists => reason_text(1)
    .denied => reason_text(2)
    .not_permitted => reason_text(3)
    .read_only => reason_text(4)
    .not_directory => reason_text(5)
    .is_directory => reason_text(6)
    .not_empty => reason_text(7)
    .loop => reason_text(8)
    .name_too_long => reason_text(9)
    .busy => reason_text(10)
    .cross_device => reason_text(11)
    .no_space => reason_text(12)
    .invalid => reason_text(13)
    .bad_descriptor => reason_text(14)
    .broken_pipe => reason_text(15)
    .io => reason_text(16)
    .failed => reason_text(17)

# Whether a file, a directory, or anything else is at `path`, following
# symbolic links: a link that names nothing is not. Any failure but
# "nothing there" is an error.
pub fun exists(path: ?String) -> Bool!
  exists_at(path)!

# What is at `path`, or `none` when nothing is. A symbolic link that
# names nothing is a link of kind `other`, so `stat(p)! != none` asks
# whether anything is at `p`, a broken link included.
pub fun stat(path: ?String) -> Stat?!
  info = List[Int](capacity: 4)
  if not stat_into(path, !info)!
    return none
  Stat(kind: kind_of(info[0]), link: info[1] == 1, size: info[2], modified: info[3])

# The entries of the directory at `path`, sorted by name, without `.`
# and `..`; `none` when nothing is at `path`.
pub fun read_dir(path: ?String) -> List[Entry]?!
  names = List[String]()
  codes = List[Int]()
  if not dir_entries(path, !names, !codes)!
    return none
  entries = List[Entry](capacity: names.len)
  while (!names).pop() as name
    c = (!codes).pop() ?? 0
    !entries.push(Entry(name: <name, kind: kind_of(c % 4), link: c / 4 == 1))
  <entries

# The file at `path` to read, or `none` when nothing is there.
pub fun open(path: ?String) -> File?!
  if open_fd(path)! as fd
    return File(fd: fd)
  none

# The file at `path` to write, created, or emptied when it is there.
# With `parents: true` it makes each missing directory on the way to it
# first; without, a missing one fails with `FileError.not_found`.
pub fun create(path: ?String, parents: Bool = false) -> File!
  File(fd: create_fd(path, parents)!)

# Write `data` as the whole file at `path`: create it, or replace what
# it holds. With `parents: true` it makes each missing directory on the
# way to it first; without, a missing one fails with
# `FileError.not_found`.
pub sub write(path: ?String, data: ?String, parents: Bool = false)!
  write_file(path, data, false, parents)!

# Write `data` at the end of the file at `path`, creating it when it is
# not there; `parents:` as for `write`.
pub sub append(path: ?String, data: ?String, parents: Bool = false)!
  write_file(path, data, true, parents)!

# Make the directory `path`; a directory there already is fine. With
# `parents: true` it makes each missing one on the way to it too;
# without, a missing one fails with `FileError.not_found`.
pub sub mkdir(path: ?String, parents: Bool = false)!
  make_dir(path, parents)!

fun kind_of(k: Int) -> Kind
  match k
    0 => Kind.file
    1 => Kind.directory
    _ => Kind.other

extern zig "file.zig"
  # The whole file at `path`, a fresh String of exactly its bytes, or
  # `none` when nothing is there.
  pub fun read(path: ?String) -> String?!

  # Write `data` as the file at `path`, emptied first, or at its end;
  # making the directories on the way to it when `parents`.
  sub write_file(path: ?String, data: ?String, at_end: Bool, parents: Bool)!

  # Move what is at `from` to `to`, replacing a file at `to`.
  pub sub rename(from: ?String, to: ?String)!

  # Make the directory `path`, and the ones on the way when `parents`.
  sub make_dir(path: ?String, parents: Bool)!

  # Whether anything is at `path`, links followed.
  fun exists_at(path: ?String) -> Bool!

  # Remove the file, or the empty directory, at `path`: true, or false
  # when nothing was there.
  pub fun remove(path: ?String) -> Bool!

  # The absolute path `path` names, every symbolic link in it resolved,
  # or `none` when nothing is there.
  pub fun realpath(path: ?String) -> String?!

  # What `stat` gives, onto `info`: its kind (0 a file, 1 a directory, 2
  # other), 1 when the path is a link, its size, and when it changed;
  # false when nothing is at `path`.
  fun stat_into(path: ?String, info: !List[Int]) -> Bool!

  # The entries of a directory, last name first, onto `names`, and each
  # one's kind plus 4 when it is a link onto `codes`; false when nothing
  # is at `path`.
  fun dir_entries(path: ?String, names: !List[String], codes: !List[Int]) -> Bool!

  # A descriptor of the file at `path` open to read, or none.
  fun open_fd(path: ?String) -> Int?!

  # A descriptor of the file at `path`, created or emptied, open to write.
  fun create_fd(path: ?String, parents: Bool) -> Int!

  fun read_from(fd: Int, into: !String, max: Int) -> Int!
  sub write_to(fd: Int, bytes: ?String)!
  sub flush_fd(fd: Int)!
  # Close `fd`, unless it is a standard stream's (0, 1, or 2).
  sub close(fd: Int)

  # `reason`'s words, by the member's place in `FileError`.
  fun reason_text(member: Int) -> Static
