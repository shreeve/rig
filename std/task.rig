# std.task: stopping a task. Canceling a task asks it to stop: it fails
# with `Stop.canceled` at its next fallible waiting point (`check`,
# `time.sleep`, a wait on a task or a set that can fail, a channel's
# send, receive, or select, a call of an actor's method that can fail,
# or a call of std.net or std.file that waits), and at every one after,
# until it ends. Its `defer`s and drops run as for any failure.
# `isolate(f)`, which the checker types, is the boundary a panic stops
# at: it fails with `Stop.panicked`.

pub error Stop
  canceled
  timeout
  panicked

extern zig "task.zig"
  # A waiting point that waits for nothing: fail with `Stop.canceled`
  # when this task is canceled, and otherwise give other tasks a turn.
  # A long computation calls it where stopping is safe.
  pub sub check()!Stop

  # Run tasks on `n` workers (at most 64), in place of one per core or
  # `RIG_WORKERS`: a program sets it from its own arguments, say. Before
  # the program makes its first task, which starts the workers, it sets
  # how many start; after, it can only raise the number, and gives
  # false for fewer than run. It gives whether it took effect. A
  # deterministic run (`rig test`) runs on one thread whatever it asks.
  pub fun workers(n: Int) -> Bool

  # The number of workers tasks run on: one per core, `RIG_WORKERS`, or
  # what `workers(n)` set, before the program's first task starts them or
  # after. One in a deterministic run, and in a program that makes no task.
  pub fun worker_count() -> Int

  # How many fast physical cores the program may run on, at least 1:
  # the threads of one core count once, and slower cores count only when
  # it may run on no fast one. A hint for sizing work; the worker count
  # does not follow it. Worked out at the first call and kept.
  pub fun fast_cores() -> Int
