# std.time: clocks and sleeping. A duration is an `Int` of nanoseconds.

use std.task

pub NS = 1
pub US = 1_000
pub MS = 1_000_000
pub SECOND = 1_000_000_000
pub MINUTE = 60_000_000_000

# A reading of the monotonic clock, which never goes back. Only the
# time between two readings means anything: `since` and `elapsed` give
# it, and nothing mixes a reading with the wall clock.
pub obj Instant
  ns: Int

  # Nanoseconds from `earlier` to this reading; negative when `earlier`
  # is the later one.
  pub fun since(?@, earlier: Instant) -> Int
    @ns - earlier.ns

  # Nanoseconds from this reading to now.
  pub fun elapsed(?@) -> Int
    monotonic() - @ns

# The monotonic clock now.
pub fun now() -> Instant
  Instant(ns: monotonic())

extern zig "time.zig"
  # Nanoseconds on the monotonic clock, since an unspecified moment.
  fun monotonic() -> Int

  # Nanoseconds since 1970-01-01 00:00 UTC on the wall clock, which can
  # be set, so it may jump.
  pub fun unix_ns() -> Int

  # Wait at least `ns` nanoseconds; not at all when `ns` is not
  # positive. A fallible waiting point: in a canceled task it fails with
  # `task.Stop.canceled` (std.task).
  pub sub sleep(ns: Int)!
