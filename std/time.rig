# std.time: clocks and sleeping. A call writes a duration bare in
# seconds, an `Int` or a `Float`, `sleep(2)`, `sleep(0.5)`, or with one
# unit, `sleep(ms: 40)`, `us: 40`, `ns: 40`; what it gives back, as
# `elapsed` does, is an `Int` of nanoseconds, which the constants below
# count.

use std.task

# A parameter `ns: Duration` takes a duration in any of its forms, and
# its body sees the nanoseconds (SPEC §18, "Durations").
type Duration = Int

pub NS = 1
pub US = 1_000
pub MS = 1_000_000
pub SECOND = 1_000_000_000
pub MINUTE = 60_000_000_000

# A reading of the monotonic clock, which never goes back. Only the
# time between two readings means anything: `since` and `elapsed` give
# it, and nothing mixes a reading with the wall clock. Instants order
# by time, so `<` and `math.max` take them.
pub obj Instant: Ord
  ns: Int

  # The instant a duration after the monotonic clock's zero, for a test
  # or code that is handed the time rather than reading it:
  # `Instant.at(0).add(1)`.
  pub fun at(ns: Duration) -> Instant
    Instant(ns: ns)

  # The instant a duration after this one; before it when the duration
  # is negative.
  pub fun add(?@, ns: Duration) -> Instant
    Instant(ns: @ns + ns)

  # Nanoseconds from `earlier` to this reading; negative when `earlier`
  # is the later one.
  pub fun since(?@, earlier: Instant) -> Int
    @ns - earlier.ns

  # Nanoseconds from this reading to now.
  pub fun elapsed(?@) -> Int
    monotonic() - @ns

# The monotonic clock now.
pub fun now() -> Instant
  Instant(ns: monotonic())

# Run `f` with a deadline a duration from now, and give what it
# gives. Every fallible waiting point `f` reaches after the deadline
# fails with `task.Stop.timeout`: `sleep`, `task.check`, and a wait on a
# task or a set that can fail, whose tasks are canceled first. The tasks
# `f` starts keep the deadline. Inside another deadline, the earlier
# one holds, and the outer one is back once `f` returns.
#
# `within` calls `f` once, `f: once`, so a closure written in the call
# may move out what it moved in, `time.within(ms: 50, |<t| >t!)`, and
# drops what it keeps.
pub fun within[R](ns: Duration, f: once ?fun() -> R!) -> R!
  outer = enter_deadline(ns)
  defer restore_deadline(outer)
  f()!

extern zig "time.zig"
  # Nanoseconds on the monotonic clock, since an unspecified moment.
  fun monotonic() -> Int

  # Nanoseconds on the monotonic clock since the program started: a
  # duration, like `t.elapsed()` of a reading taken first, which a
  # function value can read with no `Instant` to hold.
  pub fun since_start() -> Int

  # Nanoseconds since 1970-01-01 00:00 UTC on the wall clock, which can
  # be set, so it may jump.
  pub fun unix_ns() -> Int

  # Wait at least a duration; not at all when it is not positive. A
  # fallible waiting point: in a canceled task it fails with
  # `task.Stop.canceled` (std.task), and past a deadline (`within`) with
  # `task.Stop.timeout`, sleeping only until the deadline.
  pub sub sleep(ns: Duration)!task.Stop

  # The running task's deadline becomes `ns` from now, unless it has an
  # earlier one; gives the one it had, for `restore_deadline`.
  fun enter_deadline(ns: Int) -> Int

  # The running task's deadline is again `outer`.
  sub restore_deadline(outer: Int)
