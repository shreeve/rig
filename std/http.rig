# std.http: an HTTP/1.1 server. `http.serve(<listener, |req| ...)`
# takes connections on a listener (std.net), each a task of its own, and
# answers each request with the `Response` the handler gives for it,
# until the call is canceled or the listener fails. The checker types
# `serve`, as it does `par.map`: the handler is a closure written in the
# call, or a function's name, and every connection's task calls it, so
# each capture must sync and none is a write view. Each request runs
# isolated (`task.isolate`): a panic in the handler answers 500, and the
# server goes on.

use std.net

# A request. `path` is the target before any `?`, and `query` what
# follows it; `head` is the request line and headers as they came.
pub obj Request
  pub method: String
  pub path: String
  pub query: String
  pub head: String
  pub body: String

  # The value of the query parameter `name`, as written, or none.
  pub fun arg(?@, name: ?String) -> String?
    arg_of(?@query, name)

  # The value of the header `name`, any case, or none.
  pub fun header(?@, name: ?String) -> String?
    header_of(?@head, name)

# A response's content type: one the server writes from a table made
# when the program is compiled, or `other`'s text, as written (none
# when it is empty).
pub enum Type
  text            # text/plain; charset=utf-8
  html            # text/html; charset=utf-8
  json            # application/json
  css             # text/css; charset=utf-8
  js              # text/javascript; charset=utf-8
  csv             # text/csv; charset=utf-8
  xml             # application/xml
  svg             # image/svg+xml
  png             # image/png
  jpeg            # image/jpeg
  gif             # image/gif
  webp            # image/webp
  pdf             # application/pdf
  wasm            # application/wasm
  bytes           # application/octet-stream
  other(text: Static)   # any other content type, as written

# A response: its status, its content type, and its body. A 204 or a
# 304 is sent with no type and no body, whatever these hold.
pub obj Response
  pub status: Int
  pub type: Type
  pub body: String

# A 200 response of plain text.
pub fun text(body: ?String) -> Response
  Response(status: 200, type: .text, body: String(body))

# A 200 response of plain text that takes `body`, copying nothing.
pub fun ok(body: String) -> Response
  Response(status: 200, type: .text, body: <body)

# A 200 response of JSON, `body` written as JSON already.
pub fun json(body: ?String) -> Response
  Response(status: 200, type: .json, body: String(body))

# A 200 response of HTML.
pub fun html(body: ?String) -> Response
  Response(status: 200, type: .html, body: String(body))

# A response of status `code` and plain text `body`.
pub fun status(code: Int, body: ?String) -> Response
  Response(status: code, type: .text, body: String(body))

# 404, not found.
pub fun not_found() -> Response
  status(404, "not found\n")

extern zig "http.zig"
  fun arg_of(query: ?String, name: ?String) -> String?
  fun header_of(head: ?String, name: ?String) -> String?
