# std.target: the target a program is compiled for, as compile-time
# facts. Rig knows each one's type, never its value: Zig sets the value
# for the target it compiles for, so `rig check` gives one verdict on
# every machine, and a branch on one is chosen when Zig compiles.

extern zig "target.zig"
  # The target's processor architecture, one of the built-in enum
  # `Arch`'s variants (`.x86_64`, `.aarch64`, `.wasm32`, ...).
  pub arch: Arch
  # The operating system the program is compiled for, one of the built-in
  # enum `Os`'s variants (`.macos`, `.linux`, `.freebsd`, `.windows`, ...).
  pub os: Os
  # Whether this is a debug build, which checks for leaks: what `rig
  # run`, `rig test`, and `rig build` without `--release` make; false in
  # a release build.
  pub debug: Bool
  # Whether the CPU the program is compiled for has feature `f`, one of
  # the built-in enum `Feature`'s variants (`.avx2`, `.bmi2`, `.neon`,
  # `.sha3`, ...); false when its architecture has no feature by that
  # name, as `.avx2` on arm64.
  pub fun has(f: Feature) -> Bool
