# std.slices: linear operations on slices, written in Rig. Every
# function takes a slice: pass an array or a List as `!a` or `?a`.

# Reverse the order of the elements of `xs` in place: the first half
# swapped with the last, each index proven in range.
pub sub reverse[T](xs: ![]T)
  n = xs.len
  for i in 0..n / 2
    !xs.swap(i, n - 1 - i)

# Whether some element of `xs` equals `x`.
pub fun contains[T: Eq](xs: []T, x: T) -> Bool
  index_of(xs, <x) != none

# The index of the first element of `xs` equal to `x`, or `none`.
pub fun index_of[T: Eq](xs: []T, x: T) -> Int?
  for i in 0..xs.len
    if xs[i] == x
      return i
  none
